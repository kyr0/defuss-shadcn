{
  "kind": "endpoint",
  "route": "#/ref/tasks/update",
  "id": "update",
  "resource": "tasks",
  "title": "Update a task",
  "lead": "Changes the fields you send and leaves the rest as they are.",
  "method": "PATCH",
  "url": "https://api.acme.example/v4/tasks/{id}",
  "params": [
    {
      "name": "id",
      "in": "path",
      "type": "string",
      "required": true,
      "example": "t_101",
      "description": "The task's id."
    },
    {
      "name": "title",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "A new title."
    },
    {
      "name": "status",
      "in": "body",
      "type": "enum",
      "required": false,
      "values": [
        "todo",
        "doing",
        "done"
      ],
      "example": "done",
      "description": "A new status."
    },
    {
      "name": "assignee",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "Another member, or none to unassign."
    }
  ],
  "responses": [
    {
      "status": 200,
      "description": "The object, or a page of the list"
    },
    {
      "status": 400,
      "description": "A parameter is missing or wrong"
    },
    {
      "status": 401,
      "description": "No valid API key"
    },
    {
      "status": 404,
      "description": "No object with that id"
    }
  ],
  "markdown": "update.md"
}
