[{"label":"Aiko Tanaka, product designer","html":"<style>\n  #pf-bento {\n    --background: oklch(0.955 0.004 260);\n    --foreground: oklch(0.2 0.01 260);\n    --card: oklch(1 0 0);\n    --card-foreground: var(--foreground);\n    --muted: oklch(0.95 0.004 260);\n    --muted-foreground: oklch(0.5 0.01 260);\n    --border: oklch(0.91 0.005 260);\n    --input: var(--border);\n    --primary: oklch(0.66 0.19 42);\n    --primary-foreground: oklch(0.99 0 0);\n    --secondary: oklch(0.95 0.004 260);\n    --secondary-foreground: var(--foreground);\n    --accent: oklch(0.95 0.03 60);\n    --accent-foreground: var(--foreground);\n    --ring: var(--primary);\n    container: pf-bento / inline-size;\n    box-sizing: border-box;\n    width: 100%;\n    padding: clamp(1rem, 3vw, 2rem);\n    background: var(--background);\n    color: var(--foreground);\n    font-family: var(--font-sans);\n  }\n  .dark #pf-bento {\n    --background: oklch(0.13 0 0);\n    --foreground: oklch(0.96 0 0);\n    --card: oklch(0.19 0.004 260);\n    --muted: oklch(0.24 0.004 260);\n    --secondary: oklch(0.24 0.004 260);\n    --muted-foreground: oklch(0.7 0.01 260);\n    --border: oklch(0.27 0.006 260);\n    --primary: oklch(0.72 0.17 45);\n    --primary-foreground: oklch(0.17 0.02 45);\n    --accent: oklch(0.27 0.03 60);\n  }\n  #pf-bento .pf-grid {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    grid-auto-rows: minmax(11rem, auto);\n    grid-template-areas:\n      'intro intro photo avail'\n      'intro intro photo place'\n      'work work stat tools'\n      'work work quote links'\n      'write write now now';\n    gap: 0.875rem;\n    max-width: 80rem;\n    margin: 0 auto;\n    padding: 0;\n    list-style: none;\n  }\n  #pf-bento .pf-tile {\n    display: flex;\n    flex-direction: column;\n    gap: 0.75rem;\n    min-width: 0;\n    padding: 1.5rem;\n    border: 1px solid var(--border);\n    border-radius: calc(var(--radius) + 1rem);\n    background: var(--card);\n    overflow: hidden;\n  }\n  #pf-bento .pf-intro {\n    grid-area: intro;\n    justify-content: space-between;\n    padding: clamp(1.5rem, 3cqi, 2.5rem);\n  }\n  #pf-bento .pf-photo {\n    grid-area: photo;\n    padding: 0;\n  }\n  #pf-bento .pf-avail {\n    grid-area: avail;\n  }\n  #pf-bento .pf-place {\n    grid-area: place;\n    justify-content: flex-end;\n    --shape-ink: color-mix(in oklch, var(--foreground) 11%, transparent);\n    --shape-pattern: 24px;\n    background-color: color-mix(in oklch, var(--card) 85%, oklch(0.8 0.08 200));\n    position: relative;\n  }\n  #pf-bento .pf-work {\n    grid-area: work;\n  }\n  #pf-bento .pf-stat {\n    grid-area: stat;\n    justify-content: space-between;\n    border-color: transparent;\n    background: var(--primary);\n    color: var(--primary-foreground);\n  }\n  #pf-bento .pf-tools {\n    grid-area: tools;\n  }\n  #pf-bento .pf-quote {\n    grid-area: quote;\n    justify-content: space-between;\n    border-color: transparent;\n    background: var(--foreground);\n    color: var(--background);\n  }\n  #pf-bento .pf-links {\n    grid-area: links;\n    justify-content: space-between;\n    background: var(--accent);\n    border-color: transparent;\n  }\n  #pf-bento .pf-muted {\n    margin: 0;\n    color: var(--muted-foreground);\n  }\n  #pf-bento .pf-label {\n    margin: 0;\n    font-size: 0.75rem;\n    font-weight: 600;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    color: var(--muted-foreground);\n  }\n  #pf-bento .pf-stat .pf-label,\n  #pf-bento .pf-quote .pf-label {\n    color: inherit;\n    opacity: 0.75;\n  }\n  #pf-bento .pf-title {\n    margin: 0;\n    font-size: clamp(2rem, 1rem + 3.2cqi, 3.75rem);\n    font-weight: 700;\n    line-height: 1.02;\n    letter-spacing: -0.045em;\n  }\n  #pf-bento .pf-title .text-rotate {\n    display: block;\n    color: var(--primary);\n  }\n  #pf-bento .pf-photo img {\n    display: block;\n    width: 100%;\n    height: 100%;\n    min-height: 16rem;\n    object-fit: cover;\n  }\n  #pf-bento .pf-big {\n    margin: 0;\n    font-size: clamp(3rem, 2rem + 3cqi, 4.5rem);\n    font-weight: 700;\n    line-height: 0.9;\n    letter-spacing: -0.05em;\n  }\n  #pf-bento .pf-pin {\n    position: absolute;\n    inset-block-start: 1.25rem;\n    inset-inline-end: 1.25rem;\n    display: grid;\n    place-items: center;\n    width: 2.25rem;\n    aspect-ratio: 1;\n    border-radius: 50%;\n    background: var(--card);\n    box-shadow: var(--shadow-md);\n  }\n  #pf-bento .pf-quote blockquote {\n    margin: 0;\n    font-size: 1.0625rem;\n    font-weight: 500;\n    line-height: 1.35;\n    text-wrap: balance;\n  }\n  #pf-bento .pf-links ul {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.5rem;\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n  #pf-bento .pf-work .mk-portfolio-grid {\n    flex: 1;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    grid-auto-rows: minmax(9.5rem, 1fr);\n  }\n  #pf-bento .mk-availability {\n    padding: 0;\n    border: 0;\n    box-shadow: none;\n    background: none;\n  }\n  /* the portrait opens About, the work opens the case viewer: buttons that look like what they hold */\n  #pf-bento .pf-photo button,\n  #pf-bento button.mk-portfolio-grid-link {\n    position: relative;\n    display: block;\n    width: 100%;\n    height: 100%;\n    padding: 0;\n    border: 0;\n    background: none;\n    color: inherit;\n    font: inherit;\n    text-align: inherit;\n    cursor: zoom-in;\n  }\n  #pf-bento .pf-photo button {\n    cursor: pointer;\n  }\n  #pf-bento .pf-photo-tag {\n    position: absolute;\n    inset: auto 0.875rem 0.875rem auto;\n    display: inline-flex;\n    align-items: center;\n    gap: 0.35rem;\n    padding: 0.35rem 0.75rem;\n    border-radius: 999px;\n    background: oklch(0.15 0 0 / 0.6);\n    backdrop-filter: blur(6px);\n    color: #fff;\n    font-size: 0.8125rem;\n    font-weight: 600;\n    transition: background 0.2s;\n  }\n  #pf-bento .pf-photo-tag svg {\n    width: 0.9rem;\n    height: 0.9rem;\n  }\n  #pf-bento .pf-photo button:hover .pf-photo-tag {\n    background: var(--primary);\n    color: var(--primary-foreground);\n  }\n  #pf-bento :is(.pf-photo button, button.mk-portfolio-grid-link):focus-visible {\n    outline: 3px solid var(--ring);\n    outline-offset: -3px;\n  }\n  #pf-bento .pf-photo img {\n    transition: scale 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);\n  }\n  #pf-bento .pf-photo button:hover img {\n    scale: 1.04;\n  }\n  /* availability: how full the next quarter is */\n  #pf-bento .pf-slots {\n    display: grid;\n    gap: 0.4rem;\n    margin-block-start: auto;\n    font-size: 0.8125rem;\n    color: var(--muted-foreground);\n  }\n  #pf-bento .pf-slots p {\n    margin: 0;\n  }\n  /* the clock in Tokyo */\n  #pf-bento .pf-clock {\n    margin: 0;\n    font-size: clamp(2rem, 1.25rem + 2cqi, 2.75rem);\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: -0.04em;\n    font-variant-numeric: tabular-nums;\n  }\n  #pf-bento .pf-clock-note {\n    margin: 0;\n    font-weight: 600;\n  }\n  /* the quote tile: three quotes in one cell, radios pick one (:has()) */\n  #pf-bento .pf-quotes {\n    display: grid;\n    margin-block-start: auto;\n  }\n  #pf-bento .pf-quotes figure {\n    grid-area: 1 / 1;\n    margin: 0;\n    opacity: 0;\n    visibility: hidden;\n    translate: 0 0.5rem;\n    transition:\n      opacity 0.35s,\n      translate 0.35s,\n      visibility 0.35s;\n  }\n  #pf-bento .pf-quote:has([value='0']:checked) .pf-quotes figure:nth-child(1),\n  #pf-bento .pf-quote:has([value='1']:checked) .pf-quotes figure:nth-child(2),\n  #pf-bento .pf-quote:has([value='2']:checked) .pf-quotes figure:nth-child(3) {\n    opacity: 1;\n    visibility: visible;\n    translate: 0 0;\n  }\n  #pf-bento .pf-quotes figcaption {\n    margin-block-start: 0.75rem;\n    font-size: 0.875rem;\n    opacity: 0.75;\n  }\n  #pf-bento .pf-dots {\n    display: flex;\n    gap: 0.4rem;\n    margin: 0;\n    padding: 0;\n    border: 0;\n  }\n  #pf-bento .pf-dots input {\n    appearance: none;\n    width: 0.55rem;\n    height: 0.55rem;\n    margin: 0;\n    border-radius: 999px;\n    background: currentColor;\n    opacity: 0.35;\n    cursor: pointer;\n    transition:\n      width 0.3s,\n      opacity 0.3s;\n  }\n  #pf-bento .pf-dots input:checked {\n    width: 1.5rem;\n    opacity: 1;\n  }\n  #pf-bento .pf-dots input:focus-visible {\n    outline: 2px solid currentColor;\n    outline-offset: 3px;\n  }\n  /* the links: labelled, and the address to copy */\n  #pf-bento .pf-links .btn {\n    background: var(--card);\n  }\n  #pf-bento .pf-mail {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 0.5rem;\n    font-weight: 600;\n    user-select: all;\n  }\n  /* writing and now */\n  #pf-bento .pf-write {\n    grid-area: write;\n  }\n  #pf-bento .pf-write .accordion-trigger span {\n    display: grid;\n    gap: 0.15rem;\n  }\n  #pf-bento .pf-write .accordion-trigger small {\n    color: var(--muted-foreground);\n    font-size: 0.75rem;\n    font-weight: 500;\n  }\n  #pf-bento .pf-write .accordion-content p {\n    margin: 0;\n    color: var(--muted-foreground);\n  }\n  #pf-bento .pf-now {\n    grid-area: now;\n    background: color-mix(in oklch, var(--card) 88%, var(--primary));\n  }\n  #pf-bento .pf-now dl {\n    display: grid;\n    grid-template-columns: auto 1fr;\n    gap: 0.9rem 1rem;\n    margin: 0;\n  }\n  #pf-bento .pf-now dt {\n    display: flex;\n    align-items: center;\n    gap: 0.4rem;\n    color: var(--muted-foreground);\n    font-size: 0.8125rem;\n    font-weight: 600;\n  }\n  #pf-bento .pf-now dt svg {\n    width: 1rem;\n    height: 1rem;\n  }\n  #pf-bento .pf-now dd {\n    margin: 0;\n    font-weight: 600;\n  }\n  /* the dialogs: the case viewer (Media Gallery's), About and Hire me */\n  #pf-bento .pf-viewer .mk-media-gallery-track p {\n    max-width: 42rem;\n    margin-inline: auto;\n    line-height: 1.5;\n  }\n  #pf-bento .pf-viewer::backdrop {\n    background: oklch(0.08 0.01 260 / 0.94);\n    backdrop-filter: blur(10px);\n  }\n  #pf-bento .pf-viewer strong {\n    color: #fff;\n  }\n  #pf-bento .pf-viewer-steps {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 1rem;\n  }\n  #pf-bento .pf-viewer-step {\n    display: grid;\n    place-items: center;\n    width: 2.75rem;\n    height: 2.75rem;\n    border: 0;\n    border-radius: 999px;\n    background: oklch(1 0 0 / 0.15);\n    color: #fff;\n    cursor: pointer;\n  }\n  #pf-bento .pf-viewer-step:hover {\n    background: oklch(1 0 0 / 0.28);\n  }\n  #pf-bento .pf-viewer-step:focus-visible {\n    outline: 2px solid #fff;\n    outline-offset: 2px;\n  }\n  #pf-bento .pf-dialog {\n    width: min(94vw, 34rem);\n    max-height: min(92dvh, 52rem);\n    margin: auto;\n    padding: 0;\n    border: 1px solid var(--border);\n    border-radius: calc(var(--radius) + 1rem);\n    background: var(--card);\n    color: var(--foreground);\n    box-shadow: var(--shadow-2xl);\n  }\n  #pf-bento .pf-dialog::backdrop {\n    background: oklch(0.15 0 0 / 0.5);\n    backdrop-filter: blur(6px);\n  }\n  #pf-bento .pf-dialog-body {\n    display: grid;\n    gap: 1rem;\n    padding: 1.75rem;\n  }\n  #pf-bento .pf-dialog h2 {\n    margin: 0;\n    font-size: 1.5rem;\n    letter-spacing: -0.03em;\n  }\n  #pf-bento .pf-dialog .pf-dialog-x {\n    position: absolute;\n    z-index: 1;\n    background: var(--card);\n    inset: 0.75rem 0.75rem auto auto;\n  }\n  #pf-bento .pf-about {\n    width: min(94vw, 56rem);\n  }\n  #pf-bento .pf-about-grid {\n    display: grid;\n    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);\n  }\n  #pf-bento .pf-about-grid > img {\n    width: 100%;\n    height: 100%;\n    min-height: 18rem;\n    object-fit: cover;\n  }\n  #pf-bento .pf-about p {\n    margin: 0;\n    line-height: 1.6;\n  }\n  #pf-bento .pf-about ol {\n    display: grid;\n    gap: 0.6rem;\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n  #pf-bento .pf-about li {\n    display: grid;\n    grid-template-columns: 6.5rem 1fr;\n    gap: 0.75rem;\n    font-size: 0.9375rem;\n  }\n  #pf-bento .pf-about li span {\n    color: var(--muted-foreground);\n    font-variant-numeric: tabular-nums;\n  }\n  #pf-bento .pf-row {\n    display: grid;\n    gap: 0.4rem;\n  }\n  #pf-bento .pf-pair {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 0.75rem;\n  }\n  #pf-bento .pf-actions {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: flex-end;\n    gap: 0.5rem;\n  }\n  #pf-bento .pf-hire:not([data-sent]) .pf-hire-done,\n  #pf-bento .pf-hire[data-sent] form {\n    display: none;\n  }\n  #pf-bento .pf-hire-done {\n    justify-items: center;\n    text-align: center;\n  }\n  #pf-bento .pf-hire-done > svg {\n    width: 3rem;\n    height: 3rem;\n    padding: 0.6rem;\n    border-radius: 999px;\n    background: var(--primary);\n    color: var(--primary-foreground);\n  }\n  #pf-bento .pf-hire-done p {\n    margin: 0;\n    color: var(--muted-foreground);\n  }\n  @container pf-bento (max-width: 40rem) {\n    #pf-bento .pf-about-grid {\n      grid-template-columns: minmax(0, 1fr);\n    }\n    #pf-bento .pf-about-grid > img {\n      min-height: 0;\n      aspect-ratio: 16 / 10;\n    }\n    #pf-bento .pf-pair {\n      grid-template-columns: minmax(0, 1fr);\n    }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    #pf-bento :is(.pf-quotes figure, .pf-dots input, .pf-photo img, .pf-photo-tag) {\n      transition: none;\n    }\n  }\n  @container pf-bento (max-width: 62rem) {\n    #pf-bento .pf-grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      grid-template-areas:\n        'intro intro'\n        'photo avail'\n        'photo place'\n        'work work'\n        'stat tools'\n        'quote links'\n        'write now';\n    }\n  }\n  @container pf-bento (max-width: 34rem) {\n    #pf-bento .pf-grid {\n      grid-template-columns: minmax(0, 1fr);\n      grid-template-areas: 'intro' 'photo' 'avail' 'place' 'work' 'stat' 'tools' 'quote' 'links' 'write' 'now';\n    }\n  }\n  /* light or dark: the Swap writes the page's dark class - every look has a light and a dark palette */\n  #pf-bento .site-mode {\n    flex: none;\n    border: 1px solid var(--input);\n    border-radius: var(--radius-md);\n    background: var(--background);\n    color: var(--foreground);\n  }\n  #pf-bento .site-mode:hover {\n    background: var(--accent);\n    color: var(--accent-foreground);\n  }\n  #pf-bento {\n    position: relative;\n  }\n  #pf-bento > .site-mode {\n    position: absolute;\n    z-index: 20;\n    inset: var(--site-mode-top, 0.75rem) clamp(0.75rem, 2vw, 1.25rem) auto auto;\n  }\n  /* -- modes: each look in light and dark, derived from the palettes above (the other mode of each look) -- */\n  :root:not(.dark) #pf-bento {\n    --primary-foreground: oklch(0.17 0.03 42);\n    --accent: oklch(0.91 0.03 60);\n  }\n  .dark #pf-bento {\n    --accent: oklch(0.24 0.03 60);\n  }\n  /* -- modes: end -- */\n</style>\n<div id=\"pf-bento\">\n  <label class=\"swap site-mode\" data-variant=\"rotate\" data-size=\"sm\">\n    <input type=\"checkbox\" data-site-mode aria-label=\"Dark mode\" />\n    <span class=\"swap-on\" aria-hidden=\"true\"><i data-lucide=\"moon\"></i></span>\n    <span class=\"swap-off\" aria-hidden=\"true\"><i data-lucide=\"sun\"></i></span>\n  </label>\n  <ul class=\"pf-grid\" data-df-stagger style=\"--df-motion-stagger-step: 70ms\" aria-label=\"Aiko Tanaka\">\n    <li class=\"pf-tile pf-intro\" data-df-entrance=\"zoom\">\n      <p class=\"pf-label\">Product designer · Tokyo</p>\n      <h1 class=\"pf-title\">\n        Aiko Tanaka designs checkouts\n        <span class=\"text-rotate\"\n          ><span><span>people finish.</span><span>that convert.</span><span>that feel calm.</span></span></span\n        >\n      </h1>\n      <p class=\"pf-muted\" style=\"max-width: 34rem\"\n        >Eight years at product companies in Tokyo and Amsterdam - payments, onboarding and the forms nobody else\n        wants.</p\n      >\n    </li>\n    <li class=\"pf-tile pf-photo corner-squircle\" data-df-entrance=\"zoom\">\n      <button type=\"button\" commandfor=\"pf-bento-about\" command=\"show-modal\">\n        <img src=\"https://picsum.photos/id/832/600/900\" alt=\"Aiko Tanaka reading in a pale blue blouse\" />\n        <span class=\"pf-photo-tag\">About me <i data-lucide=\"arrow-up-right\"></i></span>\n      </button>\n    </li>\n    <li class=\"pf-tile pf-avail\" data-df-entrance=\"zoom\">\n      <aside class=\"mk-availability\" aria-labelledby=\"pf-bento-hire\">\n        <p class=\"mk-availability-status\"\n          ><span class=\"indicator-dot\" data-variant=\"success\" data-animate=\"ping\" aria-hidden=\"true\"></span>\n          Available</p\n        >\n        <p class=\"mk-availability-title\" id=\"pf-bento-hire\">Freelance from January</p>\n        <div class=\"mk-availability-actions\">\n          <button class=\"btn\" data-size=\"sm\" type=\"button\" commandfor=\"pf-bento-hire-dialog\" command=\"show-modal\"\n            >Hire me</button\n          >\n        </div>\n      </aside>\n      <div class=\"pf-slots\">\n        <p id=\"pf-bento-slots\">Q1 2027 - 2 of 3 project slots booked</p>\n        <progress class=\"progress\" value=\"2\" max=\"3\" aria-labelledby=\"pf-bento-slots\">2 of 3</progress>\n      </div>\n    </li>\n    <li class=\"pf-tile pf-place pattern-grid\" data-df-entrance=\"zoom\">\n      <span class=\"pf-pin\" aria-hidden=\"true\"\n        ><span class=\"indicator-dot\" data-variant=\"warning\" data-animate=\"ping\"></span\n      ></span>\n      <p class=\"pf-label\">Based in Tokyo · GMT+9</p>\n      <p class=\"pf-clock\"><time data-pf-clock>--:--</time></p>\n      <p class=\"pf-clock-note\" data-pf-clock-note aria-live=\"polite\">Remote friendly</p>\n    </li>\n    <li class=\"pf-tile pf-work\" data-df-entrance=\"zoom\">\n      <p class=\"pf-label\">Selected work</p>\n      <ul class=\"mk-portfolio-grid\">\n        <li class=\"mk-portfolio-grid-item\" data-span=\"wide\">\n          <button\n            class=\"mk-portfolio-grid-link\"\n            type=\"button\"\n            commandfor=\"pf-bento-viewer\"\n            command=\"show-modal\"\n            data-slide=\"0\"\n          >\n            <img\n              class=\"mk-portfolio-grid-media\"\n              src=\"https://picsum.photos/id/1060/900/500\"\n              alt=\"Coffee dripping through a pour-over filter in a café\"\n            />\n            <span class=\"mk-portfolio-grid-caption\">\n              <strong class=\"mk-portfolio-grid-title\">Kumo checkout</strong>\n              <span class=\"mk-portfolio-grid-meta\">+18% completed orders</span>\n            </span>\n          </button>\n        </li>\n        <li class=\"mk-portfolio-grid-item\">\n          <button\n            class=\"mk-portfolio-grid-link\"\n            type=\"button\"\n            commandfor=\"pf-bento-viewer\"\n            command=\"show-modal\"\n            data-slide=\"1\"\n          >\n            <img\n              class=\"mk-portfolio-grid-media\"\n              src=\"https://picsum.photos/id/180/600/600\"\n              alt=\"A laptop beside an open notebook with wireframe sketches\"\n            />\n            <span class=\"mk-portfolio-grid-caption\">\n              <strong class=\"mk-portfolio-grid-title\">Fleet dashboard</strong>\n              <span class=\"mk-portfolio-grid-meta\">B2B · 2024</span>\n            </span>\n          </button>\n        </li>\n        <li class=\"mk-portfolio-grid-item\">\n          <button\n            class=\"mk-portfolio-grid-link\"\n            type=\"button\"\n            commandfor=\"pf-bento-viewer\"\n            command=\"show-modal\"\n            data-slide=\"2\"\n          >\n            <img\n              class=\"mk-portfolio-grid-media\"\n              src=\"https://picsum.photos/id/367/600/600\"\n              alt=\"A hand holding an e-reader outdoors\"\n            />\n            <span class=\"mk-portfolio-grid-caption\">\n              <strong class=\"mk-portfolio-grid-title\">Hana onboarding</strong>\n              <span class=\"mk-portfolio-grid-meta\">App · 2023</span>\n            </span>\n          </button>\n        </li>\n      </ul>\n    </li>\n    <li class=\"pf-tile pf-stat\" data-df-entrance=\"zoom\">\n      <p class=\"pf-label\">Shipped</p>\n      <div>\n        <p class=\"pf-big\">40+</p>\n        <p style=\"margin: 0.5rem 0 0\">products, and 3 design systems built from scratch</p>\n      </div>\n    </li>\n    <li class=\"pf-tile pf-tools\" data-df-entrance=\"zoom\">\n      <div class=\"mk-skill-matrix\" data-variant=\"tags\">\n        <section class=\"mk-skill-matrix-group\" aria-labelledby=\"pf-bento-tools\">\n          <h2 class=\"mk-skill-matrix-title\" id=\"pf-bento-tools\"><i data-lucide=\"wrench\"></i> Tools</h2>\n          <ul class=\"mk-skill-matrix-list\">\n            <li class=\"mk-skill-matrix-skill\"><span class=\"mk-skill-matrix-name\">Figma</span></li>\n            <li class=\"mk-skill-matrix-skill\"><span class=\"mk-skill-matrix-name\">Framer</span></li>\n            <li class=\"mk-skill-matrix-skill\"><span class=\"mk-skill-matrix-name\">Maze</span></li>\n            <li class=\"mk-skill-matrix-skill\"><span class=\"mk-skill-matrix-name\">HTML &amp; CSS</span></li>\n          </ul>\n        </section>\n        <section class=\"mk-skill-matrix-group\" aria-labelledby=\"pf-bento-methods\">\n          <h2 class=\"mk-skill-matrix-title\" id=\"pf-bento-methods\"><i data-lucide=\"flask-conical\"></i> Methods</h2>\n          <ul class=\"mk-skill-matrix-list\">\n            <li class=\"mk-skill-matrix-skill\"><span class=\"mk-skill-matrix-name\">Usability tests</span></li>\n            <li class=\"mk-skill-matrix-skill\"><span class=\"mk-skill-matrix-name\">A/B tests</span></li>\n          </ul>\n        </section>\n      </div>\n    </li>\n    <li class=\"pf-tile pf-quote\" data-df-entrance=\"zoom\">\n      <p class=\"pf-label\">Kind words</p>\n      <div class=\"pf-quotes\">\n  