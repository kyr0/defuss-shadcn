>\n  </dialog>\n  <dialog class=\"pf-dialog pf-about\" id=\"pf-bento-about\" aria-labelledby=\"pf-bento-about-title\">\n    <div class=\"pf-about-grid\">\n      <img src=\"https://picsum.photos/id/832/800/1000\" alt=\"Aiko Tanaka reading in a pale blue blouse\" />\n      <div class=\"pf-dialog-body\">\n        <button\n          class=\"btn pf-dialog-x\"\n          data-variant=\"ghost\"\n          data-size=\"icon\"\n          type=\"button\"\n          commandfor=\"pf-bento-about\"\n          command=\"close\"\n          aria-label=\"Close\"\n          ><i data-lucide=\"x\"></i\n        ></button>\n        <p class=\"pf-label\">About</p>\n        <h2 id=\"pf-bento-about-title\">Hi, I'm Aiko.</h2>\n        <p\n          >I design the parts of a product where people hand over money or their time: checkouts, sign-ups and the forms\n          in between. I test early, write the copy myself and hand over components, not pictures.</p\n        >\n        <ol aria-label=\"Experience\">\n          <li><span>2025 - now</span>Freelance, Tokyo</li>\n          <li><span>2021 - 2025</span>Lead designer, Kumo, Amsterdam</li>\n          <li><span>2019 - 2021</span>Product designer, Hana Books, Tokyo</li>\n          <li><span>2017 - 2019</span>UX designer, Fleetline, Osaka</li>\n        </ol>\n        <p class=\"pf-muted\">Japanese, English, a little Dutch and Korean.</p>\n        <div class=\"pf-actions\">\n          <button class=\"btn\" type=\"button\" commandfor=\"pf-bento-hire-dialog\" command=\"show-modal\">Hire me</button>\n        </div>\n      </div>\n    </div>\n  </dialog>\n  <dialog class=\"pf-dialog pf-hire\" id=\"pf-bento-hire-dialog\" aria-labelledby=\"pf-bento-hire-title\">\n    <form class=\"pf-dialog-body\" data-pf-hire>\n      <button\n        class=\"btn pf-dialog-x\"\n        data-variant=\"ghost\"\n        data-size=\"icon\"\n        type=\"button\"\n        commandfor=\"pf-bento-hire-dialog\"\n        command=\"close\"\n        aria-label=\"Close\"\n        ><i data-lucide=\"x\"></i\n      ></button>\n      <h2 id=\"pf-bento-hire-title\">Start a project</h2>\n      <p class=\"pf-muted\" style=\"margin-top: -0.5rem\">Freelance from January - two slots are left this quarter.</p>\n      <div class=\"pf-pair\">\n        <div class=\"pf-row\">\n          <label class=\"label\" for=\"pf-bento-name\">Name</label>\n          <input class=\"input\" id=\"pf-bento-name\" name=\"name\" autocomplete=\"name\" required />\n        </div>\n        <div class=\"pf-row\">\n          <label class=\"label\" for=\"pf-bento-mail\">Email</label>\n          <input class=\"input\" id=\"pf-bento-mail\" name=\"email\" type=\"email\" autocomplete=\"email\" required />\n        </div>\n      </div>\n      <div class=\"pf-pair\">\n        <div class=\"pf-row\">\n          <label class=\"label\" for=\"pf-bento-kind\">Project</label>\n          <select class=\"select\" id=\"pf-bento-kind\" name=\"kind\">\n            <option>Checkout &amp; payments</option>\n            <option>Onboarding</option>\n            <option>A design system</option>\n            <option>Something else</option>\n          </select>\n        </div>\n        <div class=\"pf-row\">\n          <label class=\"label\" for=\"pf-bento-start\">Start</label>\n          <select class=\"select\" id=\"pf-bento-start\" name=\"start\">\n            <option>January 2027</option>\n            <option>February 2027</option>\n            <option>March 2027</option>\n            <option>Later</option>\n          </select>\n        </div>\n      </div>\n      <div class=\"pf-row\">\n        <label class=\"label\" for=\"pf-bento-text\">What should change?</label>\n        <textarea class=\"textarea\" id=\"pf-bento-text\" name=\"message\" rows=\"4\" required></textarea>\n      </div>\n      <div class=\"pf-actions\">\n        <button class=\"btn\" data-variant=\"ghost\" type=\"button\" commandfor=\"pf-bento-hire-dialog\" command=\"close\"\n          >Cancel</button\n        >\n        <button class=\"btn\" type=\"submit\"><i data-lucide=\"send\"></i> Send</button>\n      </div>\n    </form>\n    <div class=\"pf-dialog-body pf-hire-done\" tabindex=\"-1\">\n      <i data-lucide=\"check\"></i>\n      <h2>Thank you<span data-pf-hire-name></span>!</h2>\n      <p>I answer within a day, Tokyo time - so it may be overnight for you.</p>\n      <button class=\"btn\" type=\"button\" commandfor=\"pf-bento-hire-dialog\" command=\"close\">Close</button>\n    </div>\n  </dialog>\n</div>\n","individual":false}]
