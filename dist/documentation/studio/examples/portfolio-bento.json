get=\"_blank\" rel=\"noopener\"\n            ><i data-lucide=\"file-text\"></i> Read.cv</a\n          ></li\n        >\n        <li\n          ><a class=\"btn\" data-variant=\"outline\" data-size=\"sm\" href=\"mailto:aiko@example.com\"\n            ><i data-lucide=\"mail\"></i> Email</a\n          ></li\n        >\n      </ul>\n    </li>\n    <li class=\"pf-tile pf-write\" data-df-entrance=\"zoom\">\n      <p class=\"pf-label\">Writing</p>\n      <div class=\"accordion\">\n        <details class=\"accordion-item\" name=\"pf-bento-notes\" open>\n          <summary class=\"accordion-trigger\">\n            <span><small>Mar 2026</small>Three fields your checkout does not need</span>\n            <svg\n              class=\"accordion-chevron\"\n              aria-hidden=\"true\"\n              width=\"16\"\n              height=\"16\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n            >\n              <path d=\"m6 9 6 6 6-6\" />\n            </svg>\n          </summary>\n          <div class=\"accordion-content\"\n            ><p\n              >Company name, a second address line and \"confirm email\" - what happened to orders when Kumo dropped each\n              one.</p\n            ></div\n          >\n        </details>\n        <details class=\"accordion-item\" name=\"pf-bento-notes\">\n          <summary class=\"accordion-trigger\">\n            <span><small>Jan 2026</small>Error messages that say what to do</span>\n            <svg\n              class=\"accordion-chevron\"\n              aria-hidden=\"true\"\n              width=\"16\"\n              height=\"16\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n            >\n              <path d=\"m6 9 6 6 6-6\" />\n            </svg>\n          </summary>\n          <div class=\"accordion-content\"\n            ><p\n  