[{"label":"Mondrian Composition","html":"<section\n  class=\"presentation\"\n  id=\"deck-treemap\"\n  data-anim-in=\"wipeIn\"\n  data-anim-in-direction=\"east\"\n  data-anim-out=\"wipeOut\"\n  style=\"\n    --presentation-ink: #111111;\n    --presentation-ink-foreground: #f5f1e8;\n    --presentation-paper: #f5f1e8;\n    --presentation-paper-foreground: #111111;\n    --presentation-accent: #d8261c;\n    font-family: Arial, Helvetica, sans-serif;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"Where the city’s euro goes - a municipal budget as a treemap\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"A city budget of 2,400 million euros as a treemap of six departments and their programmes, social and health the largest at 912 million; then the same hierarchy as a sunburst and the change per department since 2020\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Cover\">\n    <svg\n      aria-hidden=\"true\"\n      width=\"620\"\n      height=\"620\"\n      viewBox=\"0 0 620 620\"\n      style=\"position: absolute; right: 110px; top: 140px\"\n    >\n      <rect x=\"0\" y=\"0\" width=\"620\" height=\"620\" fill=\"#F5F1E8\" stroke=\"#111\" stroke-width=\"14\" />\n      <rect x=\"0\" y=\"0\" width=\"380\" height=\"380\" fill=\"#D8261C\" stroke=\"#111\" stroke-width=\"14\" />\n      <rect x=\"380\" y=\"0\" width=\"240\" height=\"220\" fill=\"#F5F1E8\" stroke=\"#111\" stroke-width=\"14\" />\n      <rect x=\"380\" y=\"220\" width=\"240\" height=\"160\" fill=\"#1555A2\" stroke=\"#111\" stroke-width=\"14\" />\n      <rect x=\"0\" y=\"380\" width=\"200\" height=\"240\" fill=\"#F5F1E8\" stroke=\"#111\" stroke-width=\"14\" />\n      <rect x=\"200\" y=\"380\" width=\"300\" height=\"240\" fill=\"#F4C800\" stroke=\"#111\" stroke-width=\"14\" />\n      <rect x=\"500\" y=\"380\" width=\"120\" height=\"240\" fill=\"#111\" stroke=\"#111\" stroke-width=\"14\" />\n    </svg>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\"\n      >Treemap · Mondrian Composition</p\n    >\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        position: relative;\n        max-width: 1250px;\n        font-family:\n          Arial Black,\n          Arial,\n          sans-serif;\n        font-weight: 900;\n        text-transform: uppercase;\n        letter-spacing: -0.045em;\n        line-height: 0.95;\n        font-size: 6.4rem;\n        max-width: 760px;\n      \"\n      >Where the city’s euro goes</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px; max-width: 700px\"\n      >€2.4 billion, six departments, sixteen programmes - every block is money.</p\n    >\n    <p class=\"presentation-note\">The cover grid is the treemap before it has data.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"blocks\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Budget\"\n  >\n    <header class=\"presentation-header\"><span>Budget 2025</span><span>€ millions</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family:\n          Arial Black,\n          Arial,\n          sans-serif;\n        font-weight: 900;\n        text-transform: uppercase;\n        letter-spacing: -0.045em;\n        line-height: 0.95;\n      \"\n      >Six departments, one rectangle</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Area = money. Nested blocks are the programmes inside each department.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"transport\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Transport\"\n  >\n    <header class=\"presentation-header\"><span>Budget 2025</span><span>Transport highlighted</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family:\n          Arial Black,\n          Arial,\n          sans-serif;\n        font-weight: 900;\n        text-transform: uppercase;\n        letter-spacing: -0.045em;\n        line-height: 0.95;\n      \"\n      >Transport: 14% - most of it for transit</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Everything but transport greys out; its three programmes stay yellow.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"rings\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Rings\"\n  >\n    <header class=\"presentation-header\"><span>Hierarchy</span><span>Same data, radial</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family:\n          Arial Black,\n          Arial,\n          sans-serif;\n        font-weight: 900;\n        text-transform: uppercase;\n        letter-spacing: -0.045em;\n        line-height: 0.95;\n      \"\n      >The same blocks, bent into rings</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The treemap morphs into a sunburst - every node keeps its identity.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Three numbers for the council</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family:\n              Arial Black,\n              Arial,\n              sans-serif;\n            font-weight: 900;\n            text-transform: uppercase;\n            letter-spacing: -0.045em;\n            line-height: 0.95;\n          \"\n          >€<span data-count=\"2400\">2400</span> M</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">the 2025 budget</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #d8261c;\n            font-family:\n              Arial Black,\n              Arial,\n              sans-serif;\n            font-weight: 900;\n            text-transform: uppercase;\n            letter-spacing: -0.045em;\n            line-height: 0.95;\n          \"\n          ><span data-count=\"38\">38</span>%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\"\n          >goes to social & health - the largest block</p\n        >\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family:\n              Arial Black,\n              Arial,\n              sans-serif;\n            font-weight: 900;\n            text-transform: uppercase;\n            letter-spacing: -0.045em;\n            line-height: 0.95;\n          \"\n          >+<span data-count=\"64\">64</span>%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\"\n          >housing since 2020 - the fastest-growing</p\n        >\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >The largest block is not the fastest-growing one. That is the council’s real debate.</p\n    >\n    <p class=\"presentation-note\">Size and change pull in different directions.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"City\">\n    <header class=\"presentation-header\"><span>The city</span><span>412,000 residents</span></header>\n    <div style=\"display: flex; gap: 4.5rem; align-items: center; margin-top: 3.5rem\">\n      <div style=\"flex: 1 1 0; min-width: 0\">\n        <h2\n          class=\"presentation-title\"\n          data-df-entrance=\"up\"\n          style=\"\n            font-size: 3.4rem;\n            font-family:\n              Arial Black,\n              Arial,\n              sans-serif;\n            font-weight: 900;\n            text-transform: uppercase;\n            letter-spacing: -0.045em;\n            line-height: 0.95;\n            font-size: 3.2rem;\n          \"\n          >Every block is a street</h2\n        >\n        <p class=\"presentation-lede\" data-df-entrance=\"fade\" style=\"--df-motion-delay: 300ms; font-size: 1.7rem\"\n          >€2.4 billion for 412,000 residents is about €5,800 per person - €2,200 of it on social and health.</p\n        >\n      </div>\n      <figure\n        class=\"image\"\n        data-ratio=\"4/3\"\n        data-df-entrance=\"zoom-out\"\n        style=\"--df-motion-delay: 150ms; flex: 0 0 700px; margin: 0\"\n      >\n        <img\n          src=\"https://picsum.photos/id/1067/960/720\"\n          alt=\"An aerial view of a city skyline at sunset, towers stretching along a lakeshore\"\n          loading=\"lazy\"\n          width=\"960\"\n          height=\"720\"\n          style=\"width: 100%; height: 100%; object-fit: cover\"\n        />\n        <figcaption class=\"image-caption\" style=\"font-size: 1.25rem\">A city from above (stock photo).</figcaption>\n      </figure>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Bring the rectangles back to people.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"east\"\n    data-anim-in-blocks=\"4\"\n    data-anim-in-color=\"#1555A2\"\n    aria-label=\"Budget table\"\n  >\n    <header class=\"presentation-header\"><span>Departments</span><span>€ millions, 2025</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" style=\"font-size: 1.7rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Municipal budget by department, 2025 vs 2020 (synthetic).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Department</th><th class=\"table-head\" style=\"text-align: right\">€ M</th\n            ><th class=\"table-head\" style=\"text-align: right\">Share</th\n            ><th class=\"table-head\" style=\"text-align: right\">vs 2020</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Social & health</td><td class=\"table-cell\" style=\"text-align: right\">912</td\n            ><td class=\"table-cell\" style=\"text-align: right\">38%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+18%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Education</td><td class=\"table-cell\" style=\"text-align: right\">528</td\n            ><td class=\"table-cell\" style=\"text-align: right\">22%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+12%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Transport</td><td class=\"table-cell\" style=\"text-align: right\">336</td\n            ><td class=\"table-cell\" style=\"text-align: right\">14%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+31%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Administration</td><td class=\"table-cell\" style=\"text-align: right\">288</td\n            ><td class=\"table-cell\" style=\"text-align: right\">12%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+6%</td></tr\n          >\n          <tr class=\"table-row\" style=\"font-weight: 700\"\n            ><td class=\"table-cell\">Housing</td><td class=\"table-cell\" style=\"text-align: right\">216</td\n            ><td class=\"table-cell\" style=\"text-align: right\">9%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+64%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Culture & sport</td><td class=\"table-cell\" style=\"text-align: right\">120</td\n            ><td class=\"table-cell\" style=\"text-align: right\">5%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">−4%</td></tr\n          >\n        </tbody>\n        <tfoot>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Total</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">2,400</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">100%</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">+18%</td></tr\n          >\n        </tfoot>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Housing: the smallest-but-one block, the steepest rise.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"\n          font-size: 3.3rem;\n          line-height: 1.22;\n          font-family:\n            Arial Black,\n            Arial,\n            sans-serif;\n          font-weight: 900;\n          text-transform: uppercase;\n          letter-spacing: -0.045em;\n          line-height: 0.95;\n          font-size: 2.4rem;\n          text-transform: none;\n          letter-spacing: -0.02em;\n          line-height: 1.25;\n        \"\n        >“For ten years we published the budget as a 400-page PDF. One treemap, and the council finally argued about\n        priorities instead of page numbers.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #f4c800; color: #111\"\n        ><span class=\"avatar-fallback\">PV</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Paula Verhoeven<br /><span style=\"opacity: 0.7; font-size: 1.4rem\">City treasurer - fictional</span></p\n      >\n    </div>\n    <p class=\"presentation-note\">Legibility changes the conversation.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"change\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Change\"\n  >\n    <header class=\"presentation-header\"><span>Change</span><span>2025 vs 2020</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family:\n          Arial Black,\n          Arial,\n          sans-serif;\n        font-weight: 900;\n        text-transform: uppercase;\n        letter-spacing: -0.045em;\n        line-height: 0.95;\n      \"\n      >Housing grew fastest - culture shrank</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The rings unroll into one bar per department.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Questions from the council\"\n  >\n    <header class=\"presentation-header\"><span>Q & A</span><span>Budget hearing</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.2rem;\n        margin-block: 5.25rem 1.5rem;\n        font-family:\n          Arial Black,\n          Arial,\n          sans-serif;\n        font-weight: 900;\n        text-transform: uppercase;\n        letter-spacing: -0.045em;\n        line-height: 0.95;\n        font-size: 2.8rem;\n      \"\n      >Questions from the council</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"tm-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Why is administration 12%?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >It includes staff for every department - €190 M of payroll plus €98 M for IT that the others rely on.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"tm-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Is the housing jump permanent?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >About a third of it - €66 M - is a five-year renovation programme that ends in 2029.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"tm-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Where would a 1% cut hurt least?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Spread evenly it is €24 M - more than the entire museum budget of €18 M.</p\n          ></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The cut question makes the scale tangible.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Takeaways</span><span>For the budget debate</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">■</span\n        ><span>Use area when the hierarchy matters - departments contain programmes.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">■</span\n        ><span>Social & health is 38% of every euro.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">■</span\n        ><span>Housing grew 64% in five years; culture shrank.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">■</span\n        ><span>Morph, don’t redraw: the same nodes read as blocks, rings and bars.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Hard edges, short lines.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"west\"\n    data-anim-in-blocks=\"4\"\n    data-anim-in-color=\"#1555A2\"\n    aria-label=\"Closing\"\n  >\n    <svg\n      aria-hidden=\"true\"\n      width=\"620\"\n      height=\"620\"\n      viewBox=\"0 0 620 620\"\n      style=\"position: absolute; right: 110px; top: 140px\"\n    >\n      <rect x=\"0\" y=\"0\" width=\"620\" height=\"620\" fill=\"#F5F1E8\" stroke=\"#111\" stroke-width=\"14\" />\n      <rect x=\"0\" y=\"0\" width=\"380\" height=\"380\" fill=\"#D8261C\" stroke=\"#111\" stroke-width=\"14\" />\n      <rect x=\"380\" y=\"0\" width=\"240\" height=\"220\" fill=\"#F5F1E8\" stroke=\"#111\" stroke-width=\"14\" />\n      <rect x=\"380\" y=\"220\" width=\"240\" height=\"160\" fill=\"#1555A2\" stroke=\"#111\" stroke-width=\"14\" />\n      <rect x=\"0\" y=\"380\" width=\"200\" height=\"240\" fill=\"#F5F1E8\" stroke=\"#111\" stroke-width=\"14\" />\n      <rect x=\"200\" y=\"380\" width=\"300\" height=\"240\" fill=\"#F4C800\" stroke=\"#111\" stroke-width=\"14\" />\n      <rect x=\"500\" y=\"380\" width=\"120\" height=\"240\" fill=\"#111\" stroke=\"#111\" stroke-width=\"14\" />\n    </svg>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        font-family:\n          Arial Black,\n          Arial,\n          sans-serif;\n        font-weight: 900;\n        text-transform: uppercase;\n        letter-spacing: -0.045em;\n        line-height: 0.95;\n        font-size: 5.2rem;\n        max-width: 720px;\n      \"\n      >Every euro, one rectangle</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px; max-width: 700px\"\n      >A synthetic budget for a fictional city - the treemap is the real way to show a hierarchy of money.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">End on the grid.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 12</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"12\" value=\"1\"></progress>\n</section>\n","individual":false}]
