[{"label":"Civic Parchment","html":"<section\n  class=\"presentation\"\n  id=\"deck-hemicycle\"\n  data-anim-in=\"wipeIn\"\n  data-anim-in-direction=\"east\"\n  data-anim-out=\"fadeOut\"\n  style=\"\n    --presentation-ink: #27231d;\n    --presentation-ink-foreground: #f6edd9;\n    --presentation-paper: #ece3cf;\n    --presentation-paper-foreground: #27231d;\n    --presentation-accent: #8a2e2a;\n    font-family: Baskerville, Georgia, serif;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"The new Assembly - 400 seats of the fictional Republic of Veldmark\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Seats in a fictional 400-seat assembly: Civic Union 128, Social Democrats 96, Green Alliance 74, Liberal Forum 41, Rural Party 37, independents 24; a progressive coalition reaches 211 of the 201 needed\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Cover\">\n    <svg\n      aria-hidden=\"true\"\n      width=\"420\"\n      height=\"420\"\n      viewBox=\"0 0 420 420\"\n      style=\"position: absolute; right: 160px; top: 200px; opacity: 0.85\"\n    >\n      <circle cx=\"210\" cy=\"210\" r=\"190\" fill=\"none\" stroke=\"#8A2E2A\" stroke-width=\"6\" />\n      <circle cx=\"210\" cy=\"210\" r=\"160\" fill=\"none\" stroke=\"#8A2E2A\" stroke-width=\"2\" stroke-dasharray=\"4 10\" />\n      <path d=\"M90 250 A120 120 0 0 1 330 250\" fill=\"none\" stroke=\"#27231D\" stroke-width=\"22\" stroke-dasharray=\"6 8\" />\n      <text\n        x=\"210\"\n        y=\"300\"\n        text-anchor=\"middle\"\n        font-family=\"Baskerville, Georgia, serif\"\n        font-size=\"42\"\n        fill=\"#8A2E2A\"\n      >\n        400\n      </text>\n    </svg>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\"\n      >Parliament hemicycle · Civic Parchment</p\n    >\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        position: relative;\n        max-width: 1250px;\n        font-family: Baskerville, Georgia, serif;\n        font-weight: 400;\n        letter-spacing: 0;\n        font-size: 6.5rem;\n        max-width: 850px;\n      \"\n      >The new Assembly</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >400 seats, six groups, 201 needed to govern - the fictional Republic of Veldmark after its election.</p\n    >\n    <p class=\"presentation-note\">The seal sets the civic register.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"chamber\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"The chamber\"\n  >\n    <header class=\"presentation-header\"><span>The chamber</span><span>400 seats · 201 for a majority</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Baskerville, Georgia, serif;\n        font-weight: 400;\n        letter-spacing: 0;\n      \"\n      >No group comes close alone</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Every dot is a seat, left to right across the arc.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"coalition\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"A coalition\"\n  >\n    <header class=\"presentation-header\"\n      ><span>Arithmetic</span><span>Social Democrats + Greens + Liberals</span></header\n    >\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Baskerville, Georgia, serif;\n        font-weight: 400;\n        letter-spacing: 0;\n      \"\n      >A progressive coalition: 211 seats</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Three groups light up; ten seats to spare.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"parties\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Seats by group\"\n  >\n    <header class=\"presentation-header\"><span>Seats</span><span>Seats per group</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Baskerville, Georgia, serif;\n        font-weight: 400;\n        letter-spacing: 0;\n      \"\n      >Civic Union is largest - and in opposition</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The dots merge into one bar per group.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Three numbers from election night</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: Baskerville, Georgia, serif;\n            font-weight: 400;\n            letter-spacing: 0;\n          \"\n          ><span data-count=\"201\">201</span></p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">seats needed to govern</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #8a2e2a;\n            font-family: Baskerville, Georgia, serif;\n            font-weight: 400;\n            letter-spacing: 0;\n          \"\n          ><span data-count=\"211\">211</span></p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">seats for the progressive coalition</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: Baskerville, Georgia, serif;\n            font-weight: 400;\n            letter-spacing: 0;\n          \"\n          ><span data-count=\"3\">3</span></p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">groups in the governing coalition</p>\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >A grand coalition (224) and a centre-right one (206) were possible too - the progressive 211 formed.</p\n    >\n    <p class=\"presentation-note\">Three paths to 201 - the drama of the night.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"The capital\">\n    <header class=\"presentation-header\"><span>The capital</span><span>Election night</span></header>\n    <div style=\"display: flex; gap: 4.5rem; align-items: center; margin-top: 3.5rem\">\n      <figure\n        class=\"image\"\n        data-ratio=\"4/3\"\n        data-df-entrance=\"wipe\"\n        style=\"--df-motion-delay: 150ms; flex: 0 0 700px; margin: 0\"\n      >\n        <img\n          src=\"https://picsum.photos/id/61/960/720\"\n          alt=\"Black-and-white aerial view over the rooftops of an old town\"\n          loading=\"lazy\"\n          width=\"960\"\n          height=\"720\"\n          style=\"width: 100%; height: 100%; object-fit: cover\"\n        />\n        <figcaption class=\"image-caption\" style=\"font-size: 1.25rem\">The old town at dawn (stock photo).</figcaption>\n      </figure>\n      <div style=\"flex: 1 1 0; min-width: 0\">\n        <h2\n          class=\"presentation-title\"\n          data-df-entrance=\"up\"\n          style=\"font-size: 3.4rem; font-family: Baskerville, Georgia, serif; font-weight: 400; letter-spacing: 0\"\n          >The city voted, the arc decides</h2\n        >\n        <p class=\"presentation-lede\" data-df-entrance=\"fade\" style=\"--df-motion-delay: 300ms; font-size: 1.7rem\"\n          >Turnout reached 71%, the highest in twenty years - and every tenth seat changed hands.</p\n        >\n      </div>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Place and people before arithmetic.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"north\"\n    data-anim-in-blocks=\"5\"\n    data-anim-in-color=\"#8A2E2A\"\n    aria-label=\"Seat table\"\n  >\n    <header class=\"presentation-header\"><span>Official result</span><span>Seats and change</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" style=\"font-size: 1.7rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Assembly of Veldmark, seats by group (fictional).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Group</th><th class=\"table-head\" style=\"text-align: right\">Seats</th\n            ><th class=\"table-head\" style=\"text-align: right\">Change</th\n            ><th class=\"table-head\" style=\"text-align: right\">Share</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Civic Union</td><td class=\"table-cell\" style=\"text-align: right\">128</td\n            ><td class=\"table-cell\" style=\"text-align: right\">−14</td\n            ><td class=\"table-cell\" style=\"text-align: right\">32%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Social Democrats</td><td class=\"table-cell\" style=\"text-align: right\">96</td\n            ><td class=\"table-cell\" style=\"text-align: right\">−6</td\n            ><td class=\"table-cell\" style=\"text-align: right\">24%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Green Alliance</td><td class=\"table-cell\" style=\"text-align: right\">74</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+22</td\n            ><td class=\"table-cell\" style=\"text-align: right\">19%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Liberal Forum</td><td class=\"table-cell\" style=\"text-align: right\">41</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+9</td\n            ><td class=\"table-cell\" style=\"text-align: right\">10%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Rural Party</td><td class=\"table-cell\" style=\"text-align: right\">37</td\n            ><td class=\"table-cell\" style=\"text-align: right\">−5</td\n            ><td class=\"table-cell\" style=\"text-align: right\">9%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Independents</td><td class=\"table-cell\" style=\"text-align: right\">24</td\n            ><td class=\"table-cell\" style=\"text-align: right\">−6</td\n            ><td class=\"table-cell\" style=\"text-align: right\">6%</td></tr\n          >\n        </tbody>\n        <tfoot>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Total</td><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">400</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">0</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">100%</td></tr\n          >\n        </tfoot>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The Greens are the story of the night: +22.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"\n          font-size: 3.3rem;\n          line-height: 1.22;\n          font-family: Baskerville, Georgia, serif;\n          font-weight: 400;\n          letter-spacing: 0;\n          font-size: 3.2rem;\n        \"\n        >“We did not win the most seats. We won the seats that make every majority possible.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #8a2e2a; color: #f6edd9\"\n        ><span class=\"avatar-fallback\">MK</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Mira Kaldén<br /><span style=\"opacity: 0.7; font-size: 1.4rem\">Green Alliance leader - fictional</span></p\n      >\n    </div>\n    <p class=\"presentation-note\">The kingmaker quote.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"change\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Seat change\"\n  >\n    <header class=\"presentation-header\"><span>Change</span><span>Seats vs last election</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Baskerville, Georgia, serif;\n        font-weight: 400;\n        letter-spacing: 0;\n      \"\n      >The Greens gained what the Civic Union lost</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The same bars, now as gains and losses around zero.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Questions from the press\"\n  >\n    <header class=\"presentation-header\"><span>Press room</span><span>Morning after</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.2rem;\n        margin-block: 5.25rem 1.5rem;\n        font-family: Baskerville, Georgia, serif;\n        font-weight: 400;\n        letter-spacing: 0;\n      \"\n      >Questions from the press</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"ph-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Why not a grand coalition?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >It had the most seats (224) but the two leaders ruled it out during the campaign.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"ph-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>How stable is 211?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Ten seats of margin - about the size of the Liberal Forum’s rebel wing.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"ph-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Do the independents matter?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Only if the coalition splits: 24 seats cannot make a majority with any single group.</p\n          ></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The stability question is the one to take seriously.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-dg-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"How the Assembly works\"\n  >\n    <header class=\"presentation-header\"><span>Structure</span><span>How the Assembly works</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 4.5rem 1.75rem;\n        max-width: 1300px;\n        font-family: Baskerville, Georgia, serif;\n        font-weight: 400;\n        letter-spacing: 0;\n      \"\n      >Who answers to whom</h2\n    >\n    <div style=\"width: 900px; transform: scale(1.45); transform-origin: 0 0\">\n      <figure\n        class=\"diagram\"\n        id=\"hemi-org\"\n        data-type=\"organigram\"\n        data-steps\n        data-interactive\n        data-autoplay=\"900\"\n        aria-label=\"How the Assembly of Veldmark is organized\"\n      >\n        <div\n          class=\"diagram-canvas\"\n          style=\"--cols: 5; --diagram-col-min: 7.5rem; --diagram-node-w: 9rem; --diagram-gap-x: 2rem\"\n        >\n          <div class=\"diagram-node\" data-node=\"assembly\" data-step=\"1\" style=\"--col: 3; --row: 1\">\n            <span class=\"diagram-node-eyebrow\">Parliament</span>\n            <span class=\"diagram-node-name\">Assembly</span>\n            <span class=\"diagram-node-meta\">400 seats · elects the PM</span>\n          </div>\n          <div class=\"diagram-node\" data-node=\"speaker\" data-step=\"2\" style=\"--col: 1; --row: 2\">\n            <span class=\"diagram-node-eyebrow\">Presides</span>\n            <span class=\"diagram-node-name\">Speaker</span>\n            <span class=\"diagram-node-meta\">order · agenda</span>\n          </div>\n          <div class=\"diagram-node\" data-node=\"gov\" data-tone=\"accent\" data-step=\"2\" style=\"--col: 3; --row: 2\">\n            <span class=\"diagram-node-eyebrow\">Coalition</span>\n            <span class=\"diagram-node-name\">Government</span>\n            <span class=\"diagram-node-meta\">PM · three groups</span>\n          </div>\n          <div class=\"diagram-node\" data-node=\"committees\" data-step=\"2\" style=\"--col: 5; --row: 2\">\n            <span class=\"diagram-node-eyebrow\">Scrutiny</span>\n            <span class=\"diagram-node-name\">Committees</span>\n            <span class=\"diagram-node-meta\">standing · ad hoc</span>\n          </div>\n          <div class=\"diagram-node\" data-node=\"clerk\" data-step=\"3\" style=\"--col: 1; --row: 3\">\n            <span class=\"diagram-node-name\">Clerk’s office</span>\n            <span class=\"diagram-node-meta\">records · procedure</span>\n          </div>\n          <div class=\"diagram-node\" data-node=\"finance\" data-step=\"3\" style=\"--col: 2; --row: 3\">\n            <span class=\"diagram-node-name\">Finance</span>\n            <span class=\"diagram-node-meta\">budget · tax</span>\n          </div>\n          <div class=\"diagram-node\" data-node=\"interior\" data-step=\"3\" style=\"--col: 3; --row: 3\">\n            <span class=\"diagram-node-name\">Interior</span>\n            <span class=\"diagram-node-meta\">police · cities</span>\n          </div>\n          <div class=\"diagram-node\" data-node=\"climate\" data-step=\"3\" style=\"--col: 4; --row: 3\">\n            <span class=\"diagram-node-name\">Climate</span>\n            <span class=\"diagram-node-meta\">energy · transport</span>\n          </div>\n          <div class=\"diagram-node\" data-node=\"budget\" data-step=\"3\" style=\"--col: 5; --row: 3\">\n            <span class=\"diagram-node-name\">Budget committee</span>\n            <span class=\"diagram-node-meta\">checks Finance</span>\n          </div>\n        </div>\n        <ol class=\"diagram-edges\">\n          <li class=\"diagram-edge\" data-from=\"assembly\" data-to=\"speaker\"></li>\n          <li class=\"diagram-edge\" data-from=\"assembly\" data-to=\"gov\"></li>\n          <li class=\"diagram-edge\" data-from=\"assembly\" data-to=\"committees\"></li>\n          <li class=\"diagram-edge\" data-from=\"speaker\" data-to=\"clerk\"></li>\n          <li class=\"diagram-edge\" data-from=\"gov\" data-to=\"finance\"></li>\n          <li class=\"diagram-edge\" data-from=\"gov\" data-to=\"interior\"></li>\n          <li class=\"diagram-edge\" data-from=\"gov\" data-to=\"climate\"></li>\n          <li class=\"diagram-edge\" data-from=\"committees\" data-to=\"budget\"></li>\n        </ol>\n      </figure>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The structure behind the seats, tier by tier - click a box to follow its line.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Findings</span><span>For the record</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">§</span\n        ><span>Seats become spatial on an arc - majorities read at a glance.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: 