[{"label":"Default","html":"<section class=\"mk-locator-search\" aria-labelledby=\"ls-title\">\n  <h2 id=\"ls-title\" class=\"sr-only\">Find a store</h2>\n  <search>\n    <form class=\"mk-locator-search-form\" action=\"#\" method=\"get\">\n      <div class=\"mk-locator-search-row\">\n        <div class=\"mk-locator-search-field\"\n          ><label class=\"label\" for=\"ls-q\">City, address or postcode</label\n          ><div class=\"mk-locator-search-query\"\n            ><i data-lucide=\"search\"></i\n            ><input\n              class=\"input\"\n              id=\"ls-q\"\n              type=\"search\"\n              name=\"near\"\n              placeholder=\"e.g. Lisbon\"\n              autocomplete=\"address-level2\"\n              enterkeyhint=\"search\" /></div\n        ></div>\n        <div class=\"mk-locator-search-field\"\n          ><label class=\"label\" for=\"ls-r\">Within</label\n          ><select class=\"select\" id=\"ls-r\" name=\"radius\"\n            ><option>5 km</option\n            ><option selected>25 km</option\n            ><option>100 km</option></select\n          ></div\n        >\n        <button class=\"btn\" type=\"submit\">Search</button>\n      </div>\n      <button class=\"mk-locator-search-geo\" type=\"button\" data-locate\n        ><i data-lucide=\"locate-fixed\"></i> Use my location</button\n      >\n    </form>\n  </search>\n  <output class=\"mk-locator-search-summary\" aria-live=\"polite\"><strong>2 stores</strong> within 25 km of Lisbon</output>\n  <div class=\"mk-locator-search-results\">\n    <article class=\"mk-location-item\" data-variant=\"compact\">\n      <div class=\"mk-location-item-body\">\n        <div class=\"mk-location-item-head\"\n          ><h3 class=\"mk-location-item-name\">Acme Lisbon</h3><span class=\"mk-location-item-distance\">0.8 km</span></div\n        >\n        <address class=\"mk-location-item-address\">Rua da Prata 120<br />1100-420 Lisboa, Portugal</address>\n        <p class=\"mk-location-item-status\" data-status=\"open\">Open now · until 18:00</p>\n        <div class=\"mk-location-item-actions\">\n          <a\n            class=\"btn\"\n            data-variant=\"outline\"\n            data-size=\"sm\"\n            href=\"https://www.openstreetmap.org/search?query=Rua%20da%20Prata%20120%20Lisboa\"\n            target=\"_blank\"\n            rel=\"noopener\"\n            ><i data-lucide=\"navigation\"></i> Directions<span class=\"sr-only\"> to Acme Lisbon (opens maps)</span></a\n          >\n          <a class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" href=\"tel:+351210001200\"\n            ><i data-lucide=\"phone\"></i> +351 21 000 1200</a\n          >\n        </div>\n      </div>\n    </article>\n    <article class=\"mk-location-item\" data-variant=\"compact\">\n      <div class=\"mk-location-item-body\">\n        <div class=\"mk-location-item-head\"\n          ><h3 class=\"mk-location-item-name\">Acme Belém</h3><span class=\"mk-location-item-distance\">6.2 km</span></div\n        >\n        <address class=\"mk-location-item-address\">Rua de Belém 84<br />1300-085 Lisboa</address>\n        <p class=\"mk-location-item-status\" data-status=\"open\">Open now · until 19:00</p>\n        <div class=\"mk-location-item-actions\">\n          <a\n            class=\"btn\"\n            data-variant=\"outline\"\n            data-size=\"sm\"\n            href=\"https://www.openstreetmap.org/search?query=Rua%20da%20Prata%20120%20Lisboa\"\n            target=\"_blank\"\n            rel=\"noopener\"\n            ><i data-lucide=\"navigation\"></i> Directions<span class=\"sr-only\"> to Acme Belém (opens maps)</span></a\n          >\n          <a class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" href=\"tel:+351210001200\"\n            ><i data-lucide=\"phone\"></i> +351 21 000 1200</a\n          >\n        </div>\n      </div>\n    </article>\n  </div>\n</section>\n","individual":true},{"label":"Inline","html":"<section class=\"mk-locator-search\" data-variant=\"inline\" aria-label=\"Find a store\" style=\"max-width: 40rem\">\n  <search>\n    <form class=\"mk-locator-search-form\" action=\"#\" method=\"get\">\n      <div class=\"mk-locator-search-row\">\n        <div class=\"mk-locator-search-field\"\n          ><label class=\"label\" for=\"ls2-q\">City or postcode</label\n          ><div class=\"mk-locator-search-query\"\n            ><i data-lucide=\"map-pin\"></i\n            ><input class=\"input\" id=\"ls2-q\" type=\"search\" name=\"near\" placeholder=\"City or postcode\" /></div\n        ></div>\n        <div class=\"mk-locator-search-field\"\n          ><label class=\"label\" for=\"ls2-r\">Radius</label\n          ><select class=\"select\" id=\"ls2-r\" name=\"radius\"\n            ><option>10 km</option\n            ><option>50 km</option></select\n          ></div\n        >\n        <button class=\"btn\" type=\"submit\">Find stores</button>\n      </div>\n    </form>\n  </search>\n</section>\n","individual":true}]
