[{"label":"Chat Components","html":"<div class=\"chat-components\" id=\"cc-plan\" data-state-demo>\n  \n</div>\n","individual":true},{"label":"Pick a plan","html":"<div class=\"chat-components\" id=\"cc-quick\">\n  \n</div>\n","individual":true},{"label":"A project brief","html":"<div class=\"chat-components\" id=\"cc-brief\">\n  \n</div>\n","individual":true},{"label":"An order summary","html":"<div class=\"chat-components\" id=\"cc-order\">\n  \n</div>\n","individual":true},{"label":"A table at Oktav","html":"<div class=\"chat-components\" id=\"cc-booking\">\n  \n</div>\n","individual":true},{"label":"Feedback after a support chat","html":"<div class=\"chat-components\" id=\"cc-feedback\">\n  \n</div>\n","individual":true},{"label":"Approve an expense","html":"<div class=\"chat-components\" id=\"cc-expense\">\n  \n</div>\n","individual":true},{"label":"Invalid","html":"<div class=\"chat-components\" id=\"cc-invalid\">\n  \n</div>\n","individual":true},{"label":"A request with every field","html":"<div class=\"chat-components\" id=\"cc-fields\">\n  \n</div>\n<pre class=\"text-xs\" id=\"cc-fields-out\" style=\"white-space: pre-wrap; margin-top: 1rem\"></pre>\n","individual":false},{"label":"Asking for a budget","html":"<section class=\"session\" id=\"cc-chat\" aria-label=\"Chat with Ada\" style=\"height: 32rem\">\n  <div class=\"session-viewport\" aria-label=\"Messages\">\n    <div class=\"session-content\">\n      <div class=\"session-item\">\n        <div class=\"message\">\n          <div class=\"message-avatar\"\n            ><span class=\"avatar\" data-size=\"sm\"><span class=\"avatar-fallback\">AI</span></span></div\n          >\n          <div class=\"message-content\">\n            <div class=\"bubble\" data-variant=\"secondary\"\n              ><div class=\"bubble-content\">I can start the redesign. Two things first:</div></div\n            >\n            <div class=\"chat-components\" id=\"cc-chat-budget\">\n              \n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n","individual":false},{"label":"Answered","html":"<div class=\"flex flex-col gap-4\">\n  <div class=\"chat-components\" id=\"cc-done\">\n    \n    \n  </div>\n  <div class=\"chat-components\" id=\"cc-dropped\">\n    \n    \n  </div>\n</div>\n","individual":false},{"label":"Rendering a model's fence","html":"<div class=\"flex flex-col gap-3\">\n  <textarea class=\"textarea\" id=\"cc-md\" rows=\"9\" aria-label=\"A model's answer\">\nSure - let me know how many seats you need:\n\n```ui::component-schema\n{\"version\": 1, \"id\": \"seats\", \"title\": \"Seats\", \"body\": [{\"type\": \"number\", \"name\": \"seats\", \"label\": \"Seats\", \"min\": 1, \"max\": 500, \"required\": true}, {\"type\": \"select\", \"name\": \"billing\", \"label\": \"Billing\", \"options\": [\"Monthly\", \"Yearly\"]}]}\n```\n\nI will prepare the quote right after.</textarea>\n  <button class=\"btn\" type=\"button\" id=\"cc-md-render\" style=\"justify-self: start\">Render</button>\n  <div class=\"flex flex-col gap-3\" id=\"cc-md-out\"></div>\n</div>\n","individual":false}]
