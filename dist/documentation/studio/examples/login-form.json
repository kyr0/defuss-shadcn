[{"label":"Default","html":"<section class=\"mk-login-form\" aria-labelledby=\"lf-title\">\n  <div class=\"mk-login-form-head\"\n    ><svg\n      viewBox=\"0 0 24 24\"\n      width=\"28\"\n      height=\"28\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n      aria-hidden=\"true\"\n    >\n      <polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\" /></svg\n    ><h1 id=\"lf-title\">Welcome back</h1><p>Sign in to your Acme workspace.</p></div\n  >\n  <form action=\"#\" method=\"post\">\n    <div class=\"mk-auth-field\"\n      ><label class=\"label\" for=\"lf-email\">Email</label\n      ><input class=\"input\" id=\"lf-email\" type=\"email\" name=\"email\" autocomplete=\"username\" required\n    /></div>\n    <div class=\"mk-auth-field\"\n      ><div class=\"mk-login-form-label-row\"\n        ><label class=\"label\" for=\"lf-pass\">Password</label><a href=\"#\">Forgot password?</a></div\n      ><input class=\"input\" id=\"lf-pass\" type=\"password\" name=\"password\" autocomplete=\"current-password\" required\n    /></div>\n    <div class=\"checkbox-item\"\n      ><input class=\"checkbox\" type=\"checkbox\" id=\"lf-remember\" name=\"remember\" /><label for=\"lf-remember\"\n        >Keep me signed in</label\n      ></div\n    >\n    <button class=\"btn\" type=\"submit\">Sign in</button>\n  </form>\n  <p class=\"mk-login-form-foot\">No account yet? <a href=\"#\">Create one</a></p>\n</section>\n","individual":true},{"label":"Split","html":"<section class=\"mk-login-form\" data-variant=\"split\" aria-labelledby=\"lf2-title\">\n  <div class=\"mk-login-form-split\">\n    <div class=\"mk-login-form-panel\">\n      <div class=\"mk-login-form-head\"\n        ><svg\n          viewBox=\"0 0 24 24\"\n          width=\"28\"\n          height=\"28\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"2\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          aria-hidden=\"true\"\n        >\n          <polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\" /></svg\n        ><h1 id=\"lf2-title\">Sign in to Acme</h1></div\n      >\n      <form action=\"#\" method=\"post\">\n        <div class=\"mk-auth-field\"\n          ><label class=\"label\" for=\"lf2-email\">Email</label\n          ><input class=\"input\" id=\"lf2-email\" type=\"email\" name=\"email\" autocomplete=\"username\" required\n        /></div>\n        <div class=\"mk-auth-field\"\n          ><label class=\"label\" for=\"lf2-pass\">Password</label\n          ><input class=\"input\" id=\"lf2-pass\" type=\"password\" name=\"password\" autocomplete=\"current-password\" required\n        /></div>\n        <button class=\"btn\" type=\"submit\">Sign in</button>\n      </form>\n      <p class=\"mk-login-form-foot\"><a href=\"#\">Forgot your password?</a></p>\n    </div>\n    <figure class=\"mk-login-form-aside\" style=\"margin: 0\">\n      <img src=\"https://picsum.photos/seed/login-aside/800/1000\" alt=\"\" />\n      <blockquote>\"Acme gave our team its afternoons back.\"</blockquote>\n      <figcaption>Marco Rossi, COO at Globex</figcaption>\n    </figure>\n  </div>\n</section>\n","individual":true},{"label":"Minimal","html":"<section class=\"mk-login-form\" data-variant=\"minimal\" aria-labelledby=\"lf3-title\">\n  <div class=\"mk-login-form-head\"><h2 id=\"lf3-title\">Sign in</h2></div>\n  <form action=\"#\" method=\"post\">\n    <div class=\"mk-auth-field\"\n      ><label class=\"label\" for=\"lf3-email\">Email</label\n      ><input class=\"input\" id=\"lf3-email\" type=\"email\" name=\"email\" autocomplete=\"username\" required\n    /></div>\n    <div class=\"mk-auth-field\"\n      ><label class=\"label\" for=\"lf3-pass\">Password</label\n      ><input class=\"input\" id=\"lf3-pass\" type=\"password\" name=\"password\" autocomplete=\"current-password\" required\n    /></div>\n    <button class=\"btn\" type=\"submit\">Continue</button>\n  </form>\n</section>\n","individual":true}]
