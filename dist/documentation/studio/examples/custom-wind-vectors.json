[{"label":"Meteorological Radar","html":"<section\n  class=\"presentation\"\n  id=\"deck-wind\"\n  data-anim-in=\"wipeIn\"\n  data-anim-in-direction=\"west\"\n  data-anim-out=\"fadeOut\"\n  style=\"\n    --presentation-ink: #071929;\n    --presentation-ink-foreground: #ecf8ff;\n    --presentation-paper: #ecf8ff;\n    --presentation-paper-foreground: #071929;\n    --presentation-accent: #ffce42;\n    font-family: Arial, Helvetica, sans-serif;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"Storm Ilse - a coastal storm hour by hour\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Wind field of a fictional storm over a coastline at 06:00, 12:00 and 18:00: a rotating low moves east and peaks at midday with gusts of 142 km/h; then gusts at three coastal stations over the day\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Cover\">\n    <svg\n      aria-hidden=\"true\"\n      width=\"640\"\n      height=\"640\"\n      viewBox=\"0 0 640 640\"\n      style=\"position: absolute; right: 110px; top: 140px\"\n    >\n      <circle cx=\"320\" cy=\"320\" r=\"300\" fill=\"none\" stroke=\"#2A5C7A\" stroke-width=\"2\" />\n      <circle cx=\"320\" cy=\"320\" r=\"225\" fill=\"none\" stroke=\"#2A5C7A\" stroke-width=\"2\" />\n      <circle cx=\"320\" cy=\"320\" r=\"150\" fill=\"none\" stroke=\"#2A5C7A\" stroke-width=\"2\" />\n      <circle cx=\"320\" cy=\"320\" r=\"75\" fill=\"none\" stroke=\"#2A5C7A\" stroke-width=\"2\" />\n      <path d=\"M320 20 V620 M20 320 H620\" stroke=\"#2A5C7A\" stroke-width=\"2\" />\n      <path d=\"M320 320 L320 20 A300 300 0 0 1 532 108 Z\" fill=\"rgba(255,206,66,.22)\" />\n      <path\n        d=\"M390 250 q60 -30 90 20 q20 50 -40 70 q-70 20 -90 -30 q-10 -40 40 -60\"\n        fill=\"none\"\n        stroke=\"#FFCE42\"\n        stroke-width=\"10\"\n        stroke-linecap=\"round\"\n      />\n    </svg>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\"\n      >Wind vectors · Meteorological Radar</p\n    >\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        position: relative;\n        max-width: 1250px;\n        font-family: Arial, Helvetica, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n        font-size: 6rem;\n        max-width: 800px;\n      \"\n      >Storm Ilse, hour by hour</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >One autumn day, one coastline, a low that crossed it in twelve hours.</p\n    >\n    <p class=\"presentation-note\">Radar sweep on the cover - the field comes next.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"t06\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"06:00\"\n  >\n    <header class=\"presentation-header\"\n      ><span>06:00</span><span>Wind at 10 m · arrows = direction, length = speed</span></header\n    >\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Arial, Helvetica, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n      \"\n      >Morning: the low sits offshore</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Every arrow is a grid point; the swirl is the low.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"t12\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"12:00\"\n  >\n    <header class=\"presentation-header\"><span>12:00</span><span>Peak</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Arial, Helvetica, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n      \"\n      >Midday: landfall, gusts to 142 km/h</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The arrows turn and lengthen - the same series, re-rendered.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"t18\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"18:00\"\n  >\n    <header class=\"presentation-header\"><span>18:00</span><span>Weakening</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Arial, Helvetica, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n      \"\n      >Evening: inland and weakening</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The swirl moves east and the arrows shorten.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Storm summary</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #ffce42;\n            font-family: Arial, Helvetica, sans-serif;\n            font-weight: 700;\n            letter-spacing: -0.02em;\n          \"\n          ><span data-count=\"142\">142</span> km/h</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">peak gust at the coast, 13:10</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: Arial, Helvetica, sans-serif;\n            font-weight: 700;\n            letter-spacing: -0.02em;\n          \"\n          ><span data-count=\"55\">55</span> km/h</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">forward speed of the low</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: Arial, Helvetica, sans-serif;\n            font-weight: 700;\n            letter-spacing: -0.02em;\n          \"\n          ><span data-count=\"38000\">38000</span></p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">homes briefly without power</p>\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >The warning went out at 05:00 - seven hours before landfall.</p\n    >\n    <p class=\"presentation-note\">Lead time is the success metric.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Radar\" style=\"overflow: hidden\">\n    <video\n      autoplay\n      muted\n      loop\n      playsinline\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n        opacity: 0.55;\n        mix-blend-mode: screen;\n      \"\n    >\n      <source src=\"videos/demo.webm\" type=\"video/webm\" />\n      <source src=\"videos/demo.mp4\" type=\"video/mp4\" />\n    </video>\n    <div\n      aria-hidden=\"true\"\n      style=\"position: absolute; inset: 0; background: linear-gradient(90deg, #071929 38%, rgba(255, 206, 66, 0.16))\"\n    ></div>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\">The warning</p>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"blur\"\n      style=\"\n        position: relative;\n        font-size: 5rem;\n        max-width: 1100px;\n        font-family: Arial, Helvetica, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n      \"\n      >Seven hours of warning</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 400ms; position: relative; max-width: 900px\"\n      >Ferries stopped at 09:00, schools closed at 10:00 - the arrows on the next slides are why.</p\n    >\n    <p class=\"presentation-note\">Ambient loop behind the operational story.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"west\"\n    data-anim-in-blocks=\"6\"\n    data-anim-in-color=\"#FFCE42\"\n    aria-label=\"Station table\"\n  >\n    <header class=\"presentation-header\"><span>Observations</span><span>Peak gusts, km/h</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" data-density=\"spacious\" style=\"font-size: 1.7rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Peak gusts at three coastal stations during Storm Ilse (fictional).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Station</th><th class=\"table-head\" style=\"text-align: right\">Peak gust</th\n            ><th class=\"table-head\" style=\"text-align: right\">Time</th\n            ><th class=\"table-head\" style=\"text-align: right\">Mean wind</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Harbour Mole</td><td class=\"table-cell\" style=\"text-align: right\">142</td\n            ><td class=\"table-cell\" style=\"text-align: right\">13:10</td\n            ><td class=\"table-cell\" style=\"text-align: right\">88</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Dune Point</td><td class=\"table-cell\" style=\"text-align: right\">131</td\n            ><td class=\"table-cell\" style=\"text-align: right\">12:40</td\n            ><td class=\"table-cell\" style=\"text-align: right\">81</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Inland Airfield</td><td class=\"table-cell\" style=\"text-align: right\">104</td\n            ><td class=\"table-cell\" style=\"text-align: right\">15:20</td\n            ><td class=\"table-cell\" style=\"text-align: right\">62</td></tr\n          >\n        </tbody>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The coast took the brunt; inland lost a third of the gust.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"\n          font-size: 3.3rem;\n          line-height: 1.22;\n          font-family: Arial, Helvetica, sans-serif;\n          font-weight: 700;\n          letter-spacing: -0.02em;\n          font-size: 2.9rem;\n        \"\n        >“The arrows made the forecast visible. People saw the swirl on the evening news and stayed home the next\n        morning.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #ffce42; color: #071929\"\n        ><span class=\"avatar-fallback\">SV</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Sanne Visser<br /><span style=\"opacity: 0.7; font-size: 1.4rem\">Duty forecaster - fictional</span></p\n      >\n    </div>\n    <p class=\"presentation-note\">Visualization as public safety.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"gusts\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Gusts\"\n  >\n    <header class=\"presentation-header\"><span>Stations</span><span>Gusts over the day, km/h</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Arial, Helvetica, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n      \"\n      >The coast peaked first - and hardest</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The field gives way to three station curves.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Questions from the press\"\n  >\n    <header class=\"presentation-header\"><span>Briefing</span><span>Press briefing</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.2rem;\n        margin-block: 5.25rem 1.5rem;\n        font-family: Arial, Helvetica, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n      \"\n      >Questions from the briefing</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"wv-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Was it a hurricane?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >No - hurricane force is about 118 km/h sustained; Ilse reached that only in gusts.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"wv-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Why was inland calmer?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Friction over land slows the wind; the same storm lost a third of its gust strength 40 km inland.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"wv-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>How good was the forecast?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Landfall was predicted within 40 minutes and 20 km of where it happened.</p\n          ></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The hurricane question is guaranteed.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Debrief</span><span>For the next storm</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">▲</span\n        ><span>Custom glyphs belong on standard chart infrastructure.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">▲</span\n        ><span>Show the field changing - one frame hides the motion.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">▲</span\n        ><span>Seven hours of lead time closed schools before landfall.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">▲</span\n        ><span>Coastal stations need their own gust thresholds.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Debrief tone.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"east\"\n    data-anim-in-blocks=\"6\"\n    data-anim-in-color=\"#FFCE42\"\n    aria-label=\"Closing\"\n  >\n    <svg\n      aria-hidden=\"true\"\n      width=\"640\"\n      height=\"640\"\n      viewBox=\"0 0 640 640\"\n      style=\"position: absolute; right: 110px; top: 140px\"\n    >\n      <circle cx=\"320\" cy=\"320\" r=\"300\" fill=\"none\" stroke=\"#2A5C7A\" stroke-width=\"2\" />\n      <circle cx=\"320\" cy=\"320\" r=\"225\" fill=\"none\" stroke=\"#2A5C7A\" stroke-width=\"2\" />\n      <circle cx=\"320\" cy=\"320\" r=\"150\" fill=\"none\" stroke=\"#2A5C7A\" stroke-width=\"2\" />\n      <circle cx=\"320\" cy=\"320\" r=\"75\" fill=\"none\" stroke=\"#2A5C7A\" stroke-width=\"2\" />\n      <path d=\"M320 20 V620 M20 320 H620\" stroke=\"#2A5C7A\" stroke-width=\"2\" />\n      <path d=\"M320 320 L320 20 A300 300 0 0 1 532 108 Z\" fill=\"rgba(255,206,66,.22)\" />\n      <path\n        d=\"M390 250 q60 -30 90 20 q20 50 -40 70 q-70 20 -90 -30 q-10 -40 40 -60\"\n        fill=\"none\"\n        stroke=\"#FFCE42\"\n        stroke-width=\"10\"\n        stroke-linecap=\"round\"\n      />\n    </svg>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        font-family: Arial, Helvetica, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n      \"\n      >Custom geometry, standard infrastructure</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px\"\n      >A fictional storm with a synthetic wind field - renderItem on real axes is the pattern.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">End on the technique.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 12</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"12\" value=\"1\"></progress>\n</section>\n","individual":false}]
