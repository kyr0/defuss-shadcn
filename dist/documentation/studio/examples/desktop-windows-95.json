[{"label":"Windows 95 desktop","html":"<div class=\"desktop\" id=\"w95-desktop\" data-variant=\"win95\" style=\"height: var(--scaffold-height, 34rem)\">\n  <div class=\"window-desktop window-manager\" id=\"w95-desk\">\n    <div class=\"desktop-manager\" data-on-wallpaper role=\"listbox\" aria-multiselectable=\"true\" aria-label=\"Desktop\">\n      <div class=\"desktop-icon\" role=\"option\" data-value=\"w95-computer\">\n        <span class=\"desktop-icon-image\"><span class=\"desktop-glyph\" data-glyph=\"computer\"></span></span>\n        <span class=\"desktop-icon-label\">My Computer</span>\n      </div>\n      <div class=\"desktop-icon\" role=\"option\" data-value=\"w95-documents\">\n        <span class=\"desktop-icon-image\"><span class=\"desktop-glyph\" data-glyph=\"documents\"></span></span>\n        <span class=\"desktop-icon-label\">My Documents</span>\n      </div>\n      <div class=\"desktop-icon\" role=\"option\" data-value=\"w95-notepad\">\n        <span class=\"desktop-icon-image\"><span class=\"desktop-glyph\" data-glyph=\"text\"></span></span>\n        <span class=\"desktop-icon-label\">Notepad</span>\n      </div>\n      <div class=\"desktop-icon\" role=\"option\" data-value=\"w95-calculator\">\n        <span class=\"desktop-icon-image\"><span class=\"desktop-glyph\" data-glyph=\"calculator\"></span></span>\n        <span class=\"desktop-icon-label\">Calculator</span>\n      </div>\n      <div class=\"desktop-icon\" role=\"option\" data-value=\"w95-about\">\n        <span class=\"desktop-icon-image\"><span class=\"desktop-glyph\" data-glyph=\"help\"></span></span>\n        <span class=\"desktop-icon-label\">About this look</span>\n      </div>\n      <div class=\"desktop-icon\" role=\"option\" data-value=\"w95-trash\">\n        <span class=\"desktop-icon-image\"><span class=\"desktop-glyph\" data-glyph=\"trash\"></span></span>\n        <span class=\"desktop-icon-label\">Recycle Bin</span>\n      </div>\n    </div>\n    <dialog class=\"window\" id=\"w95-about\" open style=\"--window-x: 8rem; --window-y: 1.5rem; --window-w: 21rem\">\n      <header class=\"window-titlebar\">\n        <span class=\"window-icon desktop-glyph\" data-glyph=\"help\"></span>\n        <h2 class=\"window-title\">About this look</h2>\n        <form method=\"dialog\" class=\"window-controls\">\n          <button type=\"button\" class=\"window-minimize\" aria-label=\"Minimize\"></button>\n          <button class=\"window-close\" aria-label=\"Close\"></button>\n        </form>\n      </header>\n      <div class=\"window-body\">\n        <p class=\"m-0 mb-2\"\n          ><strong>Desktop 95</strong> is the system's Desktop component with <code>data-variant=\"win95\"</code>.</p\n        >\n        <p class=\"m-0 mb-3\"\n          >The windows, the icons, the bar, the start menu and the logon screen are the same components on every look -\n          only the sheet changes.</p\n        >\n        <div class=\"flex justify-end\"><button class=\"btn\" type=\"button\" data-close>OK</button></div>\n      </div>\n    </dialog>\n    <dialog\n      class=\"window\"\n      id=\"w95-notepad\"\n      style=\"--window-x: 12rem; --window-y: 3rem; --window-w: 24rem; --window-h: 15rem\"\n    >\n      <header class=\"window-titlebar\">\n        <span class=\"window-icon desktop-glyph\" data-glyph=\"text\"></span>\n        <h2 class=\"window-title\">Untitled - Notepad</h2>\n        <form method=\"dialog\" class=\"window-controls\">\n          <button type=\"button\" class=\"window-minimize\" aria-label=\"Minimize\"></button>\n          <button type=\"button\" class=\"window-maximize\" aria-label=\"Maximize\"></button>\n          <button class=\"window-close\" aria-label=\"Close\"></button>\n        </form>\n      </header>\n      <div class=\"window-toolbar\">\n        <div class=\"menubar\" role=\"menubar\" aria-label=\"Notepad\">\n          <button class=\"menubar-trigger\" type=\"button\" data-dropdown-trigger=\"w95-np-file\">File</button>\n          <div class=\"dropdown-content\" id=\"w95-np-file\" role=\"menu\" popover aria-label=\"File\">\n            <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\"\n              >New <span class=\"dropdown-shortcut\">Ctrl+N</span></button\n            >\n            <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\"\n              >Open... <span class=\"dropdown-shortcut\">Ctrl+O</span></button\n            >\n            <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\"\n              >Save <span class=\"dropdown-shortcut\">Ctrl+S</span></button\n            >\n            <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\">Save As...</button>\n            <div class=\"dropdown-separator\" role=\"separator\"></div>\n            <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\">Page Setup...</button>\n            <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\"\n              >Print... <span class=\"dropdown-shortcut\">Ctrl+P</span></button\n            >\n            <div class=\"dropdown-separator\" role=\"separator\"></div>\n            <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\">Exit</button>\n          </div>\n          <button class=\"menubar-trigger\" type=\"button\" data-dropdown-trigger=\"w95-np-edit\">Edit</button>\n          <div class=\"dropdown-content\" id=\"w95-np-edit\" role=\"menu\" popover aria-label=\"Edit\">\n            <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\"\n              >Undo <span class=\"dropdown-shortcut\">Ctrl+Z</span></button\n            >\n            <div class=\"dropdown-separator\" role=\"separator\"></div>\n            <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\"\n              >Cut <span class=\"dropdown-shortcut\">Ctrl+X</span></button\n            >\n            <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\"\n              >Copy <span class=\"dropdown-shortcut\">Ctrl+C</span></button\n            >\n            <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\"\n              >Paste <span class=\"dropdown-shortcut\">Ctrl+V</span></button\n            >\n            <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\"\n              >Delete <span class=\"dropdown-shortcut\">Del</span></button\n            >\n            <div class=\"dropdown-separator\" role=\"separator\"></div>\n            <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\"\n              >Select All <span class=\"dropdown-shortcut\">Ctrl+A</span></button\n            >\n            <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\"\n              >Time/Date <span class=\"dropdown-shortcut\">F5</span></button\n            >\n          </div>\n          <button class=\"menubar-trigger\" type=\"button\" data-dropdown-trigger=\"w95-np-help\">Help</button>\n          <div class=\"dropdown-content\" id=\"w95-np-help\" role=\"menu\" popover aria-label=\"Help\">\n            <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\">Help Topics</button>\n            <div class=\"dropdown-separator\" role=\"separator\"></div>\n            <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\">About Notepad</button>\n          </div>\n        </div>\n      </div>\n      <div class=\"window-body\" data-flush>\n        <textarea class=\"textarea\" aria-label=\"Text\">Dear diary,\ntoday the desktop changed its look and nothing else changed.</textarea>\n      </div>\n    </dialog>\n    <dialog\n      class=\"window\"\n      id=\"w95-computer\"\n      style=\"--window-x: 5rem; --window-y: 2rem; --window-w: 22rem; --window-h: 14rem\"\n    >\n      <header class=\"window-titlebar\">\n        <span class=\"window-icon desktop-glyph\" data-glyph=\"computer\"></span>\n        <h2 class=\"window-title\">My Computer</h2>\n        <form method=\"dialog\" class=\"window-controls\">\n          <button type=\"button\" class=\"window-minimize\" aria-label=\"Minimize\"></button>\n          <button type=\"button\" class=\"window-maximize\" aria-label=\"Maximize\"></button>\n          <button class=\"window-close\" aria-label=\"Close\"></button>\n        </form>\n      </header>\n      <div class=\"window-body\" data-flush>\n        <div\n          class=\"desktop-manager\"\n          data-size=\"sm\"\n          role=\"listbox\"\n          aria-multiselectable=\"true\"\n          aria-label=\"Drives and folders\"\n          style=\"min-height: 0; height: 100%\"\n        >\n          <div class=\"desktop-icon\" role=\"option\" data-value=\"floppy\"\n            ><span class=\"desktop-icon-image\"><span class=\"desktop-glyph\" data-glyph=\"folder\"></span></span\n            ><span class=\"desktop-icon-label\">Floppy (A:)</span></div\n          >\n          <div class=\"desktop-icon\" role=\"option\" data-value=\"disk\"\n            ><span class=\"desktop-icon-image\"><span class=\"desktop-glyph\" data-glyph=\"computer\"></span></span\n            ><span class=\"desktop-icon-label\">Local Disk (C:)</span></div\n          >\n          <div class=\"desktop-icon\" role=\"option\" data-value=\"docs\"\n            ><span class=\"desktop-icon-image\"><span class=\"desktop-glyph\" data-glyph=\"documents\"></span></span\n            ><span class=\"desktop-icon-label\">Shared Documents</span></div\n          >\n          <div class=\"desktop-icon\" role=\"option\" data-value=\"net\"\n            ><span class=\"desktop-icon-image\"><span class=\"desktop-glyph\" data-glyph=\"network\"></span></span\n            ><span class=\"desktop-icon-label\">Network</span></div\n          >\n          <div class=\"desktop-icon\" role=\"option\" data-value=\"panel\"\n            ><span class=\"desktop-icon-image\"><span class=\"desktop-glyph\" data-glyph=\"settings\"></span></span\n            ><span class=\"desktop-icon-label\">Control Panel</span></div\n          >\n        </div>\n      </div>\n    </dialog>\n    <dialog\n      class=\"window\"\n      id=\"w95-documents\"\n      style=\"--window-x: 9rem; --window-y: 4rem; --window-w: 20rem; --window-h: 12rem\"\n    >\n      <header class=\"window-titlebar\">\n        <span class=\"window-icon desktop-glyph\" data-glyph=\"documents\"></span>\n        <h2 class=\"window-title\">My Documents</h2>\n        <form method=\"dialog\" class=\"window-controls\">\n          <button type=\"button\" class=\"window-minimize\" aria-label=\"Minimize\"></button>\n          <button type=\"button\" class=\"window-maximize\" aria-label=\"Maximize\"></button>\n          <button class=\"window-close\" aria-label=\"Close\"></button>\n        </form>\n      </header>\n      <div class=\"window-body\" data-flush>\n        <div\n          class=\"desktop-manager\"\n          data-size=\"sm\"\n          role=\"listbox\"\n          aria-multiselectable=\"true\"\n          aria-label=\"Documents\"\n          style=\"min-height: 0; height: 100%\"\n        >\n          <div class=\"desktop-icon\" role=\"option\" data-value=\"letter\"\n            ><span class=\"desktop-icon-image\"><span class=\"desktop-glyph\" data-glyph=\"text\"></span></span\n            ><span class=\"desktop-icon-label\">Letter.txt</span></div\n          >\n          <div class=\"desktop-icon\" role=\"option\" data-value=\"holiday\"\n            ><span class=\"desktop-icon-image\"><span class=\"desktop-glyph\" data-glyph=\"picture\"></span></span\n            ><span class=\"desktop-icon-label\">Holiday.bmp</span></div\n          >\n          <div class=\"desktop-icon\" role=\"option\" data-value=\"song\"\n            ><span class=\"desktop-icon-image\"><span class=\"desktop-glyph\" data-glyph=\"music\"></span></span\n            ><span class=\"desktop-icon-label\">Song.mid</span></div\n          >\n        </div>\n      </div>\n    </dialog>\n    <dialog class=\"window\" id=\"w95-calculator\" style=\"--window-x: 26rem; --window-y: 2rem; --window-w: 13rem\">\n      <header class=\"window-titlebar\">\n        <span class=\"window-icon desktop-glyph\" data-glyph=\"calculator\"></span>\n        <h2 class=\"window-title\">Calculator</h2>\n        <form method=\"dialog\" class=\"window-controls\">\n          <button type=\"button\" class=\"window-minimize\" aria-label=\"Minimize\"></button>\n          <button class=\"window-close\" aria-label=\"Close\"></button>\n        </form>\n      </header>\n      <div class=\"window-body\">\n        <output class=\"input\" data-calc-display style=\"display: block; text-align: end; margin-bottom: 0.5rem\"\n          >0</output\n        >\n        <div class=\"grid gap-1\" style=\"grid-template-columns: repeat(4, 1fr)\">\n          <button class=\"btn\" type=\"button\" data-calc=\"7\" style=\"min-width: 0; padding: 0\">7</button>\n          <button class=\"btn\" type=\"button\" data-calc=\"8\" style=\"min-width: 0; padding: 0\">8</button>\n          <button class=\"btn\" type=\"button\" data-calc=\"9\" style=\"min-width: 0; padding: 0\">9</button>\n          <button class=\"btn\" type=\"button\" data-calc=\"/\" style=\"min-width: 0; padding: 0\">/</button>\n          <button class=\"btn\" type=\"button\" data-calc=\"4\" style=\"min-width: 0; padding: 0\">4</button>\n          <button class=\"btn\" type=\"button\" data-calc=\"5\" style=\"min-width: 0; padding: 0\">5</button>\n          <button class=\"btn\" type=\"button\" data-calc=\"6\" style=\"min-width: 0; padding: 0\">6</button>\n          <button class=\"btn\" type=\"button\" data-calc=\"*\" style=\"min-width: 0; padding: 0\">*</button>\n          <button class=\"btn\" type=\"button\" data-calc=\"1\" style=\"min-width: 0; padding: 0\">1</button>\n          <button class=\"btn\" type=\"button\" data-calc=\"2\" style=\"min-width: 0; padding: 0\">2</button>\n          <button class=\"btn\" type=\"button\" data-calc=\"3\" style=\"min-width: 0; padding: 0\">3</button>\n          <button class=\"btn\" type=\"button\" data-calc=\"-\" style=\"min-width: 0; padding: 0\">-</button>\n          <button class=\"btn\" type=\"button\" data-calc=\"0\" style=\"min-width: 0; padding: 0\">0</button>\n          <button class=\"btn\" type=\"button\" data-calc=\".\" style=\"min-width: 0; padding: 0\">.</button>\n          <button class=\"btn\" type=\"button\" data-calc=\"=\" style=\"min-width: 0; padding: 0\">=</button>\n          <button class=\"btn\" type=\"button\" data-calc=\"+\" style=\"min-width: 0; padding: 0\">+</button>\n        </div>\n      </div>\n    </dialog>\n    <dialog class=\"window\" id=\"w95-trash\" style=\"--window-x: 14rem; --window-y: 5rem; --window-w: 18rem\">\n      <header class=\"window-titlebar\">\n        <span class=\"window-icon desktop-glyph\" data-glyph=\"trash\"></span>\n        <h2 class=\"window-title\">Recycle Bin</h2>\n        <form method=\"dialog\" class=\"window-controls\">\n          <button type=\"button\" class=\"window-minimize\" aria-label=\"Minimize\"></button>\n          <button type=\"button\" class=\"window-maximize\" aria-label=\"Maximize\"></button>\n          <button class=\"window-close\" aria-label=\"Close\"></button>\n        </form>\n      </header>\n      <div class=\"window-body\">\n        <p class=\"m-0\">The Recycle Bin is empty.</p>\n      </div>\n    </dialog>\n  </div>\n  <nav class=\"taskbar\" data-taskbar-for=\"w95-desk\" aria-label=\"Taskbar\">\n    <button class=\"start-button\" type=\"button\" popovertarget=\"w95-start\" aria-haspopup=\"menu\">\n      <span class=\"start-button-icon desktop-glyph\" data-glyph=\"flag\"></span>\n      <span class=\"start-button-label\">Start</span>\n    </button>\n    <div class=\"taskbar-windows\" role=\"group\" aria-label=\"Open windows\"></div>\n    <div class=\"tray\" role=\"group\" aria-label=\"Notification area\">\n      <button class=\"tray-item\" type=\"button\" aria-label=\"Network\"><i data-lucide=\"wifi\"></i></button>\n      <button class=\"tray-item\" type=\"button\" aria-label=\"Volume\"><i data-lucide=\"volume-2\"></i></button>\n      <time class=\"tray-clock\"></time>\n      <button class=\"tray-show-desktop\" type=\"button\" aria-label=\"Show desktop\"></button>\n    </div>\n  </nav>\n  <div class=\"start-menu\" id=\"w95-start\" popover aria-label=\"Start\">\n    <div class=\"start-menu-head\">\n      <span class=\"avatar\"><img class=\"avatar-image\" src=\"images/avatars/12-96.webp\" alt=\"\" /></span>\n      <span>Desktop 95</span>\n    </div>\n    <label class=\"start-menu-search\">\n      <i data-lucide=\"search\"></i>\n      <input type=\"search\" placeholder=\"Search programs\" aria-label=\"Search programs\" />\n    </label>\n    <p class=\"start-menu-heading\">Pinned</p>\n    <div class=\"start-menu-pinned\" role=\"group\" aria-label=\"Pinned\">\n      <button class=\"start-menu-item\" type=\"button\" data-value=\"w95-computer\">\n        <span class=\"start-menu-icon\"><span class=\"desktop-glyph\" data-glyph=\"computer\"></span></span>\n        <span class=\"start-menu-label\">My Computer</span>\n      </button>\n      <button class=\"start-menu-item\" type=\"button\" data-value=\"w95-documents\">\n        <span class=\"start-menu-icon\"><span class=\"desktop-glyph\" data-glyph=\"documents\"></span></span>\n        <span class=\"start-menu-label\">My Documents</span>\n      </button>\n      <button class=\"start-menu-item\" type=\"button\" data-value=\"w95-notepad\">\n        <span class=\"start-menu-icon\"><span class=\"desktop-glyph\" data-glyph=\"text\"></span></span>\n        <span class=\"start-menu-label\">Notepad</span>\n      </button>\n    </div>\n    <p class=\"start-menu-heading\">All programs</p>\n    <div class=\"start-menu-list\" role=\"group\" aria-label=\"All programs\">\n      <button class=\"start-menu-item\" type=\"button\" aria-controls=\"w95-programs\">\n        <span class=\"start-menu-icon\"><span class=\"desktop-glyph\" data-glyph=\"folder\"></span></span>\n        <span class=\"start-menu-label\">Programs</span>\n      </button>\n      <div class=\"start-menu-sub\" id=\"w95-programs\" popover aria-label=\"Programs\">\n        <button class=\"start-menu-item\" type=\"button\" aria-controls=\"w95-accessories\">\n          <span class=\"start-menu-icon\"><span class=\"desktop-glyph\" data-glyph=\"folder\"></span></span>\n          <span class=\"start-menu-label\">Accessories</span>\n        </button>\n        <div class=\"start-menu-sub\" id=\"w95-accessories\" popover aria-label=\"Accessories\">\n          <button class=\"start-menu-item\" type=\"button\" data-value=\"w95-calculator\">\n            <span class=\"start-menu-icon\"><span class=\"desktop-glyph\" data-glyph=\"calculator\"></span></span>\n            <span class=\"start-menu-label\">Calculator</span>\n          </button>\n          <button class=\"start-menu-item\" type=\"button\" data-value=\"w95-notepad\">\n            <span class=\"start-menu-icon\"><span class=\"desktop-glyph\" data-glyph=\"text\"></span></span>\n            <span class=\"start-menu-label\">Notepad</span>\n          </button>\n        </div>\n        <button class=\"start-menu-item\" type=\"button\" data-value=\"w95-trash\">\n          <span class=\"start-menu-icon\"><span class=\"desktop-glyph\" data-glyph=\"trash\"></span></span>\n          <span class=\"start-menu-label\">Recycle Bin</span>\n        </button>\n      </div>\n      <button class=\"start-menu-item\" type=\"button\" data-value=\"w95-about\">\n        <span class=\"start-menu-icon\"><span class=\"desktop-glyph\" data-glyph=\"help\"></span></span>\n        <span class=\"start-menu-label\">Help</span>\n      </button>\n      <button class=\"start-menu-item\" type=\"button\" data-value=\"w95-computer\">\n        <span class=\"start-menu-icon\"><span class=\"desktop-glyph\" data-glyph=\"settings\"></span></span>\n        <span class=\"start-menu-label\">Settings</span>\n      </button>\n    </div>\n    <p class=\"start-menu-empty\" hidden>No programs match</p>\n    <div class=\"start-menu-foot\">\n      <button class=\"start-menu-item\" type=\"button\" data-value=\"logoff\">\n        <span class=\"start-menu-icon\"><span class=\"desktop-glyph\" data-glyph=\"user\"></span></span>\n        <span class=\"start-menu-label\">Log off</span>\n      </button>\n      <button class=\"start-menu-item\" type=\"button\" data-value=\"shutdown\" aria-label=\"Shut down\">\n        <span class=\"start-menu-icon\"><span class=\"desktop-glyph\" data-glyph=\"power\"></span></span>\n      </button>\n    </div>\n  </div>\n  <div class=\"logon\" aria-label=\"Sign in\">\n    <div class=\"logon-main\">\n      <div class=\"logon-brand\">\n        <strong>Desktop 95</strong>\n        <span>To begin, click your user name</span>\n      </div>\n      <ul class=\"logon-users\">\n        <li>\n          <button class=\"logon-user\" type=\"button\" data-user=\"aron\">\n            <span class=\"avatar\"><img class=\"avatar-image\" src=\"images/avatars/12-96.webp\" alt=\"\" /></span>\n            <span class=\"logon-name\">Aron</span>\n          </button>\n        </li>\n        <li>\n          <button class=\"logon-user\" type=\"button\" data-user=\"guest\" data-no-password>\n            <span class=\"avatar\"><span class=\"avatar-fallback\">G</span></span>\n            <span class=\"logon-name\">Guest</span>\n          </button>\n        </li>\n      </ul>\n      <form class=\"logon-form\" hidden>\n        <p class=\"logon-for\"></p>\n        <div class=\"logon-field\">\n          <input class=\"input\" type=\"password\" name=\"password\" aria-label=\"Password\" autocomplete=\"current-password\" />\n          <button class=\"btn\" type=\"submit\" aria-label=\"Sign in\"><i data-lucide=\"arrow-right\"></i></button>\n        </div>\n        <p class=\"logon-error\" role=\"alert\" hidden></p>\n      </form>\n    </div>\n    <div class=\"logon-power\">\n      <button class=\"btn\" data-variant=\"ghost\" type=\"button\" data-logon-power=\"shutdown\"\n        ><i data-lucide=\"power\"></i> Turn off</button\n      >\n    </div>\n  </div>\n</div>\n","individual":true}]
