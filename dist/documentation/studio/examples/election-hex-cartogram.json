[{"label":"Election Night Newspaper","html":"<section\n  class=\"presentation\"\n  id=\"deck-hex\"\n  data-anim-in=\"wipeIn\"\n  data-anim-in-direction=\"north\"\n  data-anim-out=\"fadeOut\"\n  style=\"\n    --presentation-ink: #17202a;\n    --presentation-ink-foreground: #f7f3e8;\n    --presentation-paper: #fffcf4;\n    --presentation-paper-foreground: #17202a;\n    --presentation-accent: #b3182b;\n    font-family: Georgia, 'Times New Roman', serif;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"The rail-link referendum - Kestrel County, 64 districts\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Referendum on a rail link in 64 districts of a fictional county: 40 districts voted yes, overall 53.5 percent; support falls with distance from the planned line, from 64 percent within 10 km to 45 percent beyond 20 km\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Cover\">\n    <div\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        inset-inline: 112px;\n        top: 72px;\n        display: flex;\n        justify-content: space-between;\n        border-block: 4px double currentColor;\n        padding-block: 0.6rem;\n        font:\n          700 1.5rem/1 Georgia,\n          serif;\n        text-transform: uppercase;\n        letter-spacing: 0.12em;\n      \"\n    >\n      <span>The Kestrel Courier</span><span>Referendum special</span><span>Late edition</span>\n    </div>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\"\n      >Hex cartogram · Election Night Newspaper</p\n    >\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        position: relative;\n        max-width: 1250px;\n        font-family: Georgia, 'Times New Roman', serif;\n        font-weight: 700;\n        letter-spacing: -0.01em;\n        font-size: 6rem;\n        max-width: 1150px;\n      \"\n      >Yes to the rail link - narrowly</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >Kestrel County voted 53.5% Yes. Sixty-four districts, one hexagon each, one clear pattern.</p\n    >\n    <p class=\"presentation-note\">Newspaper register: headline, deck, then the map.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"map\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"The map\"\n  >\n    <header class=\"presentation-header\"><span>The result</span><span>64 districts · one hexagon each</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Georgia, 'Times New Roman', serif;\n        font-weight: 700;\n        letter-spacing: -0.01em;\n      \"\n      >40 districts said Yes, 24 said No</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Equal cells: a small town counts as much as a wide valley.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"margin\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Margin\"\n  >\n    <header class=\"presentation-header\"><span>The result</span><span>Shaded by Yes share</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Georgia, 'Times New Roman', serif;\n        font-weight: 700;\n        letter-spacing: -0.01em;\n      \"\n      >The Yes is strongest down the middle</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Same cells, now shaded by how strongly each district voted.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"distance\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Distance\"\n  >\n    <header class=\"presentation-header\"><span>Why</span><span>Distance to the planned line × Yes share</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Georgia, 'Times New Roman', serif;\n        font-weight: 700;\n        letter-spacing: -0.01em;\n      \"\n      >The closer to the line, the bigger the Yes</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The hexagons leave the map and line up by distance.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Three numbers from the count</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #1f6f8b;\n            font-family: Georgia, 'Times New Roman', serif;\n            font-weight: 700;\n            letter-spacing: -0.01em;\n          \"\n          ><span data-count=\"53.5\">53.5</span>%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">Yes across the county</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: Georgia, 'Times New Roman', serif;\n            font-weight: 700;\n            letter-spacing: -0.01em;\n          \"\n          ><span data-count=\"40\">40</span>/64</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">districts voted Yes</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #b3182b;\n            font-family: Georgia, 'Times New Roman', serif;\n            font-weight: 700;\n            letter-spacing: -0.01em;\n          \"\n          ><span data-count=\"19\">19</span> pts</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\"\n          >gap between districts near and far from the line</p\n        >\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >The vote was not town against country. It was near the line against far from it.</p\n    >\n    <p class=\"presentation-note\">Reframe the story - that is the scoop.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"The valley\">\n    <header class=\"presentation-header\"><span>Far from the line</span><span>Western wards</span></header>\n    <div style=\"display: flex; gap: 4.5rem; align-items: center; margin-top: 3.5rem\">\n      <div style=\"flex: 1 1 0; min-width: 0\">\n        <h2\n          class=\"presentation-title\"\n          data-df-entrance=\"up\"\n          style=\"\n            font-size: 3.4rem;\n            font-family: Georgia, 'Times New Roman', serif;\n            font-weight: 700;\n            letter-spacing: -0.01em;\n          \"\n          >Out west, the line runs past - not through</h2\n        >\n        <p class=\"presentation-lede\" data-df-entrance=\"fade\" style=\"--df-motion-delay: 300ms; font-size: 1.7rem\"\n          >Districts more than 20 km from a planned station voted No by an average of ten points.</p\n        >\n      </div>\n      <figure\n        class=\"image\"\n        data-ratio=\"4/3\"\n        data-df-entrance=\"wipe\"\n        style=\"--df-motion-delay: 150ms; flex: 0 0 700px; margin: 0\"\n      >\n        <img\n          src=\"https://picsum.photos/id/67/960/720\"\n          alt=\"Black-and-white view of rolling hills and a wide valley with scattered trees\"\n          loading=\"lazy\"\n          width=\"960\"\n          height=\"720\"\n          style=\"width: 100%; height: 100%; object-fit: cover\"\n        />\n        <figcaption class=\"image-caption\" style=\"font-size: 1.25rem\">The western valley (stock photo).</figcaption>\n      </figure>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Give the No side its landscape.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"north\"\n    data-anim-in-blocks=\"6\"\n    data-anim-in-color=\"#B3182B\"\n    aria-label=\"Band table\"\n  >\n    <header class=\"presentation-header\"><span>The count</span><span>By distance to the line</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" data-density=\"spacious\" style=\"font-size: 1.7rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Yes share by distance band, 64 districts (fictional referendum).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Distance to line</th><th class=\"table-head\" style=\"text-align: right\">Districts</th\n            ><th class=\"table-head\" style=\"text-align: right\">Yes (avg)</th\n            ><th class=\"table-head\" style=\"text-align: right\">Won by</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Up to 10 km</td><td class=\"table-cell\" style=\"text-align: right\">19</td\n            ><td class=\"table-cell\" style=\"text-align: right\">64.1%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">Yes</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">10 – 20 km</td><td class=\"table-cell\" style=\"text-align: right\">23</td\n            ><td class=\"table-cell\" style=\"text-align: right\">53.2%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">Yes</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Over 20 km</td><td class=\"table-cell\" style=\"text-align: right\">22</td\n            ><td class=\"table-cell\" style=\"text-align: right\">44.8%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">No</td></tr\n          >\n        </tbody>\n        <tfoot>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">County</td><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">64</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">53.5%</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">Yes</td></tr\n          >\n        </tfoot>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The whole argument in three rows.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"\n          font-size: 3.3rem;\n          line-height: 1.22;\n          font-family: Georgia, 'Times New Roman', serif;\n          font-weight: 700;\n          letter-spacing: -0.01em;\n          font-size: 3rem;\n        \"\n        >“Nobody in my village is against trains. We are against paying for a station we will never see.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #b3182b; color: #f7f3e8\"\n        ><span class=\"avatar-fallback\">RH</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Rhys Hollins<br /><span style=\"opacity: 0.7; font-size: 1.4rem\"\n          >Parish councillor, western valley - fictional</span\n        ></p\n      >\n    </div>\n    <p class=\"presentation-note\">The No voice, fairly quoted.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"bands\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Bands\"\n  >\n    <header class=\"presentation-header\"><span>Summary</span><span>Average Yes by distance band</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Georgia, 'Times New Roman', serif;\n        font-weight: 700;\n        letter-spacing: -0.01em;\n      \"\n      >Three bands, three answers</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The dots merge into their band averages.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" style=\"justify-content: flex-start\" aria-label=\"Readers ask\">\n    <header class=\"presentation-header\"><span>Readers ask</span><span>Letters desk</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.2rem;\n        margin-block: 5.25rem 1.5rem;\n        font-family: Georgia, 'Times New Roman', serif;\n        font-weight: 700;\n        letter-spacing: -0.01em;\n      \"\n      >Readers ask</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"hx-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Why hexagons instead of a map?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Real districts differ tenfold in area; equal hexagons stop big empty districts dominating the picture.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"hx-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Is the result binding?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\">Yes - above the 40% turnout quorum (turnout was 61%).</p></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"hx-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>What about a western branch?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >The county promised a feasibility study; the far band would need two new stations.</p\n          ></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The hexagon question must be answered.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Analysis</span><span>Page 3</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">¶</span\n        ><span>Equal-area cells keep every district visible.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">¶</span\n        ><span>The pattern was distance, not town versus country.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">¶</span\n        ><span>A narrow county-wide Yes hides a clear local No.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">¶</span\n        ><span>The western branch is the next political fight.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Analysis column tone.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"south\"\n    data-anim-in-blocks=\"6\"\n    data-anim-in-color=\"#B3182B\"\n    aria-label=\"Closing\"\n  >\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        font-family: Georgia, 'Times New Roman', serif;\n        font-weight: 700;\n        letter-spacing: -0.01em;\n      \"\n      >Equal cells, fair picture</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px\"\n      >A fictional county and synthetic votes - the cartogram is the real instrument.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">Close the edition.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 12</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"12\" value=\"1\"></progress>\n</section>\n","individual":false}]
