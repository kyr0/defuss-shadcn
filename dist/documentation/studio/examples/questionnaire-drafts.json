[{"label":"A draft that comes back","html":"<div class=\"flex flex-col gap-3\" style=\"max-width: 32rem\">\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"q-reload\" style=\"align-self: flex-start\"\n    >Simulate a reload</button\n  >\n  <div id=\"q-draft-host\"></div>\n</div>\n<template id=\"q-draft-template\">\n  <form class=\"questionnaire\" id=\"q-draft\" aria-label=\"Moving checklist\">\n    <div class=\"questionnaire-progress\"></div>\n    <fieldset class=\"questionnaire-step\" data-step=\"when\">\n      <legend class=\"questionnaire-title\">When do you move?</legend>\n      <input class=\"input\" name=\"date\" type=\"date\" required aria-label=\"Moving date\" />\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"from\">\n      <legend class=\"questionnaire-title\">Where from?</legend>\n      <input class=\"input\" name=\"from\" required aria-label=\"Current address\" autocomplete=\"street-address\" />\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"to\">\n      <legend class=\"questionnaire-title\">Where to?</legend>\n      <input class=\"input\" name=\"to\" required aria-label=\"New address\" />\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"boxes\">\n      <legend class=\"questionnaire-title\">How many boxes, roughly?</legend>\n      <input class=\"input\" name=\"boxes\" type=\"number\" min=\"1\" required aria-label=\"Boxes\" style=\"max-width: 8rem\" />\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"done\" data-end>\n      <legend class=\"questionnaire-title\">Get the quote?</legend>\n      <div class=\"questionnaire-summary\"></div>\n    </fieldset>\n    <div class=\"questionnaire-actions\">\n      <button class=\"btn\" data-variant=\"ghost\" type=\"button\" data-questionnaire=\"back\">Back</button>\n      <button class=\"btn\" type=\"submit\" data-questionnaire=\"next\">Continue</button>\n      <button class=\"btn\" type=\"submit\" data-questionnaire=\"submit\">Get the quote</button>\n    </div>\n    <div class=\"questionnaire-complete\"\n      ><p\n        >Quote on its way.\n        <button class=\"questionnaire-edit\" type=\"button\" data-questionnaire=\"restart\">Start over</button></p\n      ></div\n    >\n  </form>\n</template>\n","individual":false},{"label":"Trip planner with a trail","html":"<div class=\"flex flex-wrap gap-6\">\n  <form class=\"questionnaire\" id=\"q-trip\" aria-label=\"Trip planner\" data-persist=\"none\" style=\"flex: 1 1 20rem\">\n    <div class=\"questionnaire-progress\"></div>\n    <fieldset class=\"questionnaire-step\" data-step=\"kind\">\n      <legend class=\"questionnaire-title\">What kind of trip?</legend>\n      <div class=\"questionnaire-choices\">\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"kind\" value=\"city\" required data-goto=\"city\" /><span\n            class=\"questionnaire-choice-label\"\n            >City break</span\n          ></label\n        >\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"kind\" value=\"beach\" data-goto=\"beach\" /><span class=\"questionnaire-choice-label\"\n            >Beach holiday</span\n          ></label\n        >\n      </div>\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"city\" data-next=\"nights\">\n      <legend class=\"questionnaire-title\">Which city?</legend>\n      <input class=\"input\" name=\"city\" required aria-label=\"City\" />\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"beach\" data-next=\"nights\">\n      <legend class=\"questionnaire-title\">Warm water or quiet beach?</legend>\n      <div class=\"questionnaire-choices\">\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"beach\" value=\"warm\" required /><span class=\"questionnaire-choice-label\"\n            >Warm water</span\n          ></label\n        >\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"beach\" value=\"quiet\" /><span class=\"questionnaire-choice-label\"\n            >Quiet beach</span\n          ></label\n        >\n      </div>\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"nights\">\n      <legend class=\"questionnaire-title\">How many nights?</legend>\n      <input\n        class=\"input\"\n        name=\"nights\"\n        type=\"number\"\n        min=\"1\"\n        max=\"60\"\n        required\n        aria-label=\"Nights\"\n        style=\"max-width: 8rem\"\n      />\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"plan\" data-end>\n      <legend class=\"questionnaire-title\">Your trip</legend>\n      <div class=\"questionnaire-summary\"></div>\n    </fieldset>\n    <div class=\"questionnaire-actions\">\n      <button class=\"btn\" data-variant=\"ghost\" type=\"button\" data-questionnaire=\"back\">Back</button>\n      <button class=\"btn\" type=\"submit\" data-questionnaire=\"next\">Continue</button>\n      <button class=\"btn\" type=\"submit\" data-questionnaire=\"submit\">Plan it</button>\n    </div>\n    <div class=\"questionnaire-complete\"><p>Bon voyage!</p></div>\n  </form>\n  <nav class=\"questionnaire-trail\" data-for=\"q-trip\" aria-label=\"Steps taken\" style=\"flex: 0 1 14rem\"></nav>\n</div>\n","individual":false}]
