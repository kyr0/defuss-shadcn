[{"label":"Measure between two GPS positions","html":"<div class=\"grid gap-3\">\n  <form class=\"flex flex-wrap items-end gap-3\" id=\"measure\">\n    <div class=\"grid gap-1\">\n      <label class=\"label\" for=\"from\">A - longitude, latitude</label>\n      <input class=\"input\" id=\"from\" value=\"11.582, 48.1351\" spellcheck=\"false\" />\n    </div>\n    <div class=\"grid gap-1\">\n      <label class=\"label\" for=\"to\">B - longitude, latitude</label>\n      <input class=\"input\" id=\"to\" value=\"-74.006, 40.7128\" spellcheck=\"false\" />\n    </div>\n    <button class=\"btn\" type=\"submit\">Measure</button>\n  </form>\n  <output class=\"text-sm\" id=\"distance\" aria-live=\"polite\"></output>\n  <div\n    class=\"geo-map\"\n    id=\"route-map\"\n    aria-label=\"The geodesic from A to B\"\n    data-projection=\"mercator\"\n    data-center=\"-30,48\"\n    data-zoom=\"1.6\"\n    data-palette=\"mono\"\n  ></div>\n</div>\n","individual":false},{"label":"The same lines on a map and a globe","html":"<div class=\"grid gap-3\" style=\"grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); --geo-map-height: 18rem\">\n  <div\n    class=\"geo-map\"\n    aria-label=\"Geodesics on Mercator\"\n    data-projection=\"mercator\"\n    data-center=\"-20,40\"\n    data-zoom=\"1.3\"\n  >\n    \n  </div>\n  <div class=\"geo-map\" aria-label=\"Geodesics on a globe\" data-projection=\"orthographic\" data-center=\"-40,55\">\n    \n  </div>\n</div>\n","individual":false},{"label":"1,500 km in every direction","html":"<div\n  class=\"geo-map\"\n  id=\"ring\"\n  aria-label=\"1,500 km around Reykjavik\"\n  data-projection=\"mercator\"\n  data-center=\"-20,62\"\n  data-zoom=\"2.6\"\n  data-palette=\"ocean\"\n></div>\n","individual":false}]
