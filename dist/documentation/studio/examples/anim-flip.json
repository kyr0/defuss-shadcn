[{"label":"In / out, directions and lifecycle","html":"<style>\n  #anim-flip-target {\n    width: 160px;\n    height: 100px;\n    display: grid;\n    place-items: center;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    background: var(--card);\n    color: var(--card-foreground);\n    font-weight: 600;\n  }\n</style>\n<div style=\"display: flex; flex-direction: column; gap: 0.85rem\">\n  <div id=\"anim-flip-target\">Flip me</div>\n  <div style=\"display: flex; flex-wrap: wrap; gap: 0.4rem\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-flip-in\">In</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-flip-out\">Out</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-flip-dir=\"north\" aria-pressed=\"true\">N</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-flip-dir=\"south\" aria-pressed=\"false\">S</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-flip-dir=\"west\" aria-pressed=\"false\">W</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-flip-dir=\"east\" aria-pressed=\"false\">E</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-flip-op=\"pause\">Pause</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-flip-op=\"resume\">Resume</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-flip-op=\"finish\">Finish</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-flip-op=\"reset\">Reset</button>\n  </div>\n  <div style=\"display: flex; align-items: center; gap: 0.75rem\">\n    <label for=\"anim-flip-duration\" class=\"text-sm\">Duration</label>\n    <input class=\"input\" id=\"anim-flip-duration\" type=\"number\" min=\"50\" step=\"50\" value=\"1500\" style=\"width: 6rem\" />\n    <label for=\"anim-flip-easing\" class=\"text-sm\">Easing</label>\n    <select class=\"select\" id=\"anim-flip-easing\">\n      <option value=\"cubic-bezier(0.16, 1, 0.3, 1)\" selected>ease-out (default)</option>\n      <option value=\"linear\">linear</option>\n      <option value=\"ease-in-out\">ease-in-out</option>\n      <option value=\"cubic-bezier(0.34, 1.56, 0.64, 1)\">overshoot</option>\n    </select>\n  </div>\n</div>\n","individual":false},{"label":"Scroll-bound flip","html":"<div\n  id=\"anim-flip-stage\"\n  style=\"\n    height: 220px;\n    overflow-y: auto;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    padding: 1rem;\n  \"\n>\n  <div style=\"height: 600px; display: flex; align-items: flex-end\">\n    <div\n      id=\"anim-flip-scroll-target\"\n      style=\"\n        width: 160px;\n        height: 100px;\n        display: grid;\n        place-items: center;\n        border: 1px solid var(--border);\n        border-radius: var(--radius-lg);\n        background: var(--card);\n        color: var(--card-foreground);\n        font-weight: 600;\n      \"\n      >Scroll-driven</div\n    >\n  </div>\n</div>\n","individual":false}]
