[{"label":"Sunday Magazine Longform","html":"<section\n  class=\"presentation\"\n  id=\"deck-annotated\"\n  data-anim-in=\"slideIn\"\n  data-anim-in-distance=\"80px\"\n  data-anim-out=\"fadeOut\"\n  style=\"\n    --presentation-ink: #1c1715;\n    --presentation-ink-foreground: #fbf6ef;\n    --presentation-paper: #fbf6ef;\n    --presentation-paper-foreground: #1c1715;\n    --presentation-accent: #c23b22;\n    font-family: Georgia, 'Times New Roman', serif;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"Line T7 - the first year of a new tram\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Weekly average daily ridership of tram line T7 over its first 52 weeks, rising from 8,700 to 21,600, with a strike dip, a festival record and a fare cut, then ridership by weekday\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Cover\">\n    <p\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        left: 112px;\n        top: 80px;\n        margin: 0;\n        font-size: 12rem;\n        line-height: 1;\n        color: #c23b22;\n        opacity: 0.9;\n      \"\n      >T7</p\n    >\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\"\n      >Annotated time series · Sunday Magazine</p\n    >\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        position: relative;\n        max-width: 1250px;\n        font-weight: 400;\n        letter-spacing: -0.015em;\n        font-size: 5.5rem;\n        max-width: 1150px;\n        margin-top: 6rem;\n      \"\n      >The year a tram line found its riders</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >Fifty-two weeks of line T7 - a strike, a festival, a fare cut and one snowstorm.</p\n    >\n    <p class=\"presentation-note\">Longform pace: let the cover breathe.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"line\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"The year\"\n  >\n    <header class=\"presentation-header\"><span>The year</span><span>Riders per day, weekly average</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 400;\n        letter-spacing: -0.015em;\n      \"\n      >From 8,700 to 21,600 riders a day</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The bare line first - the shape before the story.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"events\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Events\"\n  >\n    <header class=\"presentation-header\"><span>The year</span><span>Annotated</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 400;\n        letter-spacing: -0.015em;\n      \"\n      >Every bump has a name</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The annotations arrive - now the line is an argument.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"fare\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Fare cut\"\n  >\n    <header class=\"presentation-header\"><span>Week 36</span><span>Weeks 30–46</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 400;\n        letter-spacing: -0.015em;\n      \"\n      >The fare cut added 14% overnight - and it stayed</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Zoom into the step: before and after the €1 fare.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Three numbers from line T7</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-weight: 400;\n            letter-spacing: -0.015em;\n          \"\n          ><span data-count=\"21.6\">21.6</span>k</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\"\n          >riders per day at the end of year one</p\n        >\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #c23b22;\n            font-weight: 400;\n            letter-spacing: -0.015em;\n          \"\n          ><span data-count=\"26.8\">26.8</span>k</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">the record - festival week 30</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-weight: 400;\n            letter-spacing: -0.015em;\n          \"\n          >+<span data-count=\"14\">14</span>%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">after the fare cut in week 36</p>\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >The forecast said 18,000 by year three. The line passed it in week 25.</p\n    >\n    <p class=\"presentation-note\">The forecast comparison is the headline for the council.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"The road beside it\">\n    <header class=\"presentation-header\"><span>Beside the line</span><span>Ring road</span></header>\n    <div style=\"display: flex; gap: 4.5rem; align-items: center; margin-top: 3.5rem\">\n      <figure\n        class=\"image\"\n        data-ratio=\"4/3\"\n        data-df-entrance=\"wipe\"\n        style=\"--df-motion-delay: 150ms; flex: 0 0 700px; margin: 0\"\n      >\n        <img\n          src=\"https://picsum.photos/id/88/960/720\"\n          alt=\"Aerial view of cars on a multi-lane road with lane markings\"\n          loading=\"lazy\"\n          width=\"960\"\n          height=\"720\"\n          style=\"width: 100%; height: 100%; object-fit: cover\"\n        />\n        <figcaption class=\"image-caption\" style=\"font-size: 1.25rem\"\n          >The ring road at rush hour (stock photo).</figcaption\n        >\n      </figure>\n      <div style=\"flex: 1 1 0; min-width: 0\">\n        <h2\n          class=\"presentation-title\"\n          data-df-entrance=\"up\"\n          style=\"font-size: 3.4rem; font-weight: 400; letter-spacing: -0.015em\"\n          >Every full tram is forty cars off the ring road</h2\n        >\n        <p class=\"presentation-lede\" data-df-entrance=\"fade\" style=\"--df-motion-delay: 300ms; font-size: 1.7rem\"\n          >Traffic counts on the parallel ring road fell 9% in the same year - the quiet second chart of this story.</p\n        >\n      </div>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The photo makes the second effect visible.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"west\"\n    data-anim-in-blocks=\"5\"\n    data-anim-in-color=\"#C23B22\"\n    aria-label=\"Event table\"\n  >\n    <header class=\"presentation-header\"><span>The events</span><span>Riders per day, weekly average</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" style=\"font-size: 1.45rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Line T7, selected weeks of the first year (synthetic).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Week</th><th class=\"table-head\" style=\"text-align: right\">Event</th\n            ><th class=\"table-head\" style=\"text-align: right\">Riders/day</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">1</td><td class=\"table-cell\" style=\"text-align: right\">Opening</td\n            ><td class=\"table-cell\" style=\"text-align: right\">8,700</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">19</td><td class=\"table-cell\" style=\"text-align: right\">Transit strike</td\n            ><td class=\"table-cell\" style=\"text-align: right\">2,100</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">25</td\n            ><td class=\"table-cell\" style=\"text-align: right\">Passes the 3-year forecast</td\n            ><td class=\"table-cell\" style=\"text-align: right\">18,300</td></tr\n          >\n          <tr class=\"table-row\" style=\"font-weight: 700\"\n            ><td class=\"table-cell\">30</td><td class=\"table-cell\" style=\"text-align: right\">Summer festival</td\n            ><td class=\"table-cell\" style=\"text-align: right\">26,800</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">36</td><td class=\"table-cell\" style=\"text-align: right\">€1 fare introduced</td\n            ><td class=\"table-cell\" style=\"text-align: right\">21,800</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">48</td><td class=\"table-cell\" style=\"text-align: right\">Snowstorm</td\n            ><td class=\"table-cell\" style=\"text-align: right\">14,900</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">52</td><td class=\"table-cell\" style=\"text-align: right\">Year one ends</td\n            ><td class=\"table-cell\" style=\"text-align: right\">21,600</td></tr\n          >\n        </tbody>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The table is the caption list of the chart.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"font-size: 3.3rem; line-height: 1.22; font-weight: 400; letter-spacing: -0.015em; font-size: 2.9rem\"\n        >“The strike week was the best advert we ever had. People missed the tram - that is when we knew it had become\n        theirs.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #c23b22; color: #fbf6ef\"\n        ><span class=\"avatar-fallback\">EL</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Elif Lange<br /><span style=\"opacity: 0.7; font-size: 1.4rem\">Line manager, T7 - from the first day</span></p\n      >\n    </div>\n    <p class=\"presentation-note\">The human reading of the dip.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"weekday\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Weekdays\"\n  >\n    <header class=\"presentation-header\"><span>The week</span><span>Average riders per day, weeks 36–52</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 400;\n        letter-spacing: -0.015em;\n      \"\n      >A commuter line: Sunday is less than half of Tuesday</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The year folds into seven bars.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Letters to the editor\"\n  >\n    <header class=\"presentation-header\"><span>Letters</span><span>Readers ask</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"font-size: 3.2rem; margin-block: 5.25rem 1.5rem; font-weight: 400; letter-spacing: -0.015em\"\n      >Letters to the editor</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"at-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Was the festival spike a one-off?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Yes - ridership returned to 16,900 the week after; it is annotated so nobody mistakes it for a trend.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"at-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Did the fare cut pay for itself?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Not yet: revenue per week is 31% lower, the council budgets it as congestion relief.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"at-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Why is winter lower?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\">Mostly the snowstorm week; without it, December averages 22,200.</p></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Readers’ questions, magazine-style.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Coda</span><span>What the year taught</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">❧</span\n        ><span>Annotate the anomalies, or someone will extrapolate them.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">❧</span\n        ><span>Price moved ridership faster than any campaign did.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">❧</span\n        ><span>A commuter line lives and dies on weekday capacity.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">❧</span\n        ><span>Year two starts where the forecast expected year three.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Coda, not a list - read it slowly.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"east\"\n    data-anim-in-blocks=\"5\"\n    data-anim-in-color=\"#C23B22\"\n    aria-label=\"Closing\"\n  >\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        font-weight: 400;\n        letter-spacing: -0.015em;\n      \"\n      >Annotations turn a line into an argument</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px\"\n      >A fictional tram line, synthetic riders - the editorial layer is the real pattern.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">End on the craft.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 12</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"12\" value=\"1\"></progress>\n</section>\n","individual":false}]
