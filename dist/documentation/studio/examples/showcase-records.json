[{"label":"Lowtide Records, Hamburg","html":"<style>\n  @import url('https://fonts.googleapis.com/css2?family=Righteous&family=Karla:wght@400;500;700&family=Overpass+Mono:wght@400;600&display=swap');\n  /* Lowtide Records: a shop by the harbour that presses ten records a year. Layout: the new release as the hero - the\n     record over moving light, its tracklist beside it - then the arrivals as sleeves pinned askew, the booth hours. */\n  #sc-records {\n    --background: oklch(0.93 0.03 70);\n    --foreground: oklch(0.27 0.05 45);\n    --card: oklch(0.96 0.025 75);\n    --card-foreground: var(--foreground);\n    --muted: oklch(0.89 0.04 70);\n    --muted-foreground: oklch(0.45 0.06 45);\n    --border: oklch(0.27 0.05 45 / 0.22);\n    --input: var(--border);\n    --primary: oklch(0.65 0.18 45);\n    --primary-foreground: oklch(0.98 0.015 75);\n    --secondary: oklch(0.89 0.04 70);\n    --secondary-foreground: var(--foreground);\n    --accent: oklch(0.65 0.18 45);\n    --accent-foreground: oklch(0.98 0.015 75);\n    --ring: var(--primary);\n    --radius: 0.375rem;\n    --radius-sm: max(0px, calc(var(--radius) - 4px));\n    --radius-md: max(0px, calc(var(--radius) - 2px));\n    --radius-lg: var(--radius);\n    --radius-xl: calc(var(--radius) + 4px);\n    --lt-label: oklch(0.65 0.18 45);\n    --lt-sticker: oklch(0.88 0.15 95);\n    color-scheme: light;\n    box-sizing: border-box;\n    width: 100%;\n    overflow-x: clip;\n    padding: clamp(1rem, 3vw, 2.5rem);\n    background: var(--background);\n    color: var(--foreground);\n    font-family: 'Karla', var(--font-sans);\n  }\n  #sc-records[data-look='vapor'] {\n    color-scheme: dark;\n    --background: oklch(0.2 0.06 300);\n    --foreground: oklch(0.95 0.03 330);\n    --card: oklch(0.25 0.07 300);\n    --muted: oklch(0.27 0.07 300);\n    --muted-foreground: oklch(0.8 0.06 320);\n    --border: oklch(0.95 0.03 330 / 0.2);\n    --primary: oklch(0.82 0.13 195);\n    --primary-foreground: oklch(0.2 0.06 300);\n    --secondary: oklch(0.28 0.07 300);\n    --secondary-foreground: var(--foreground);\n    --accent: oklch(0.75 0.18 350);\n    --accent-foreground: oklch(0.2 0.06 300);\n    --lt-label: oklch(0.75 0.18 350);\n    --lt-sticker: oklch(0.82 0.13 195);\n  }\n  #sc-records[data-look='mono'] {\n    color-scheme: light;\n    --background: oklch(0.98 0 0);\n    --foreground: oklch(0.12 0 0);\n    --card: oklch(1 0 0);\n    --muted: oklch(0.94 0 0);\n    --muted-foreground: oklch(0.4 0 0);\n    --border: oklch(0.12 0 0);\n    --primary: oklch(0.12 0 0);\n    --primary-foreground: oklch(0.98 0 0);\n    --secondary: oklch(0.94 0 0);\n    --accent: oklch(0.12 0 0);\n    --accent-foreground: oklch(0.98 0 0);\n    --radius: 0rem;\n    --lt-label: oklch(0.98 0 0);\n    --lt-sticker: oklch(0.98 0 0);\n  }\n  #sc-records[data-look='mono'] img {\n    filter: grayscale(1) contrast(1.15);\n  }\n  #sc-records .lt-page {\n    display: flex;\n    flex-direction: column;\n    gap: clamp(3.5rem, 8vw, 6rem);\n    max-width: 72rem;\n    margin-inline: auto;\n  }\n  #sc-records [hidden] {\n    display: none !important;\n  }\n  /* the Site Header: a small record and the name in Righteous, the sections - a price sticker under the one you\n     point at -, the look and the mode */\n  #sc-records .lt-bar {\n    background: none;\n    color: inherit;\n  }\n  #sc-records .mk-header-inner {\n    flex-wrap: wrap;\n    gap: 0.75rem 1.5rem;\n    max-width: none;\n    min-height: 4.5rem;\n    padding: 0;\n  }\n  #sc-records :is(.mk-header-brand, .mk-footer-brand) {\n    gap: 0.55rem;\n    color: inherit;\n  }\n  #sc-records .lt-logo {\n    flex: none;\n    width: 1.6rem;\n    aspect-ratio: 1;\n    border-radius: 50%;\n    background: radial-gradient(circle, var(--background) 0 8%, var(--lt-label) 9% 34%, oklch(0.15 0.01 45) 35%);\n  }\n  #sc-records :is(.mk-header-name, .mk-footer-brand-name) {\n    color: inherit;\n    font:\n      400 1.6rem/1 'Righteous',\n      sans-serif;\n  }\n  #sc-records .mk-header-nav {\n    display: flex;\n    margin-inline-start: auto;\n  }\n  #sc-records .nav-menu-list {\n    flex-wrap: wrap;\n  }\n  #sc-records .nav-menu-link {\n    color: inherit;\n    font-size: 0.9375rem;\n    font-weight: 500;\n    white-space: nowrap;\n  }\n  #sc-records .nav-menu-link:is(:hover, :focus-visible) {\n    background: var(--lt-sticker);\n    color: oklch(0.27 0.05 45);\n  }\n  #sc-records .mk-header-actions {\n    gap: 0.5rem;\n  }\n  /* the release: the record over moving light, the tracklist beside it */\n  #sc-records .lt-release {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n    align-items: center;\n    gap: clamp(2rem, 5vw, 4rem);\n  }\n  #sc-records .lt-stage {\n    position: relative;\n    isolation: isolate;\n    display: grid;\n    place-items: center;\n    aspect-ratio: 1;\n    border-radius: var(--radius-xl);\n    overflow: clip;\n  }\n  #sc-records .lt-stage > .shader {\n    border-radius: inherit;\n    opacity: 0.9;\n  }\n  #sc-records .lt-record {\n    width: 78%;\n    aspect-ratio: 1;\n    border-radius: 50%;\n    background:\n      radial-gradient(\n        circle,\n        oklch(0.12 0 0) 0 3%,\n        var(--lt-label) 3.5% 30%,\n        oklch(0.12 0 0) 30.5% 32%,\n        transparent 32.5%\n      ),\n      repeating-radial-gradient(circle, oklch(0.16 0 0) 0 2px, oklch(0.2 0 0) 2px 3px), oklch(0.15 0 0);\n    box-shadow: 0 1.5rem 3rem -1rem oklch(0 0 0 / 0.6);\n    animation: lt-turn 1.8s linear infinite;\n  }\n  #sc-records .lt-record::after {\n    content: '';\n    position: absolute;\n    inset: 11%;\n    border-radius: 50%;\n    background: conic-gradient(\n      from 30deg,\n      transparent 0 8%,\n      oklch(1 0 0 / 0.12) 12% 16%,\n      transparent 20% 58%,\n      oklch(1 0 0 / 0.1) 62% 66%,\n      transparent 70%\n    );\n    animation: lt-turn 1.8s linear infinite reverse;\n    pointer-events: none;\n  }\n  @keyframes lt-turn {\n    to {\n      rotate: 360deg;\n    }\n  }\n  #sc-records .lt-cat {\n    margin: 0;\n    font:\n      600 0.8125rem/1 'Overpass Mono',\n      monospace;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    color: var(--muted-foreground);\n  }\n  #sc-records .lt-release h1 {\n    margin: 0.5rem 0 0.25rem;\n    font:\n      400 clamp(2.6rem, 6.5vw, 5rem)/0.95 'Righteous',\n      sans-serif;\n    text-wrap: balance;\n  }\n  #sc-records .lt-artist {\n    margin: 0 0 1.25rem;\n    font-size: 1.25rem;\n  }\n  #sc-records .lt-tracks {\n    margin: 0 0 1.5rem;\n    padding: 0;\n    list-style: none;\n    font-family: 'Overpass Mono', monospace;\n    font-size: 0.9rem;\n  }\n  #sc-records .lt-tracks li {\n    display: grid;\n    grid-template-columns: 2.5rem minmax(0, 1fr) auto;\n    gap: 0.75rem;\n    padding: 0.55rem 0;\n    border-block-end: 1px dashed var(--border);\n  }\n  #sc-records .lt-tracks b {\n    color: var(--primary);\n    font-weight: 600;\n  }\n  #sc-records .lt-tracks time {\n    font-variant-numeric: tabular-nums;\n    color: var(--muted-foreground);\n  }\n  #sc-records .lt-actions {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.75rem;\n  }\n  /* the arrivals: sleeves pinned askew with price stickers */\n  #sc-records .lt-head {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: baseline;\n    justify-content: space-between;\n    gap: 0.5rem 2rem;\n    margin-block-end: 1.75rem;\n  }\n  #sc-records .lt-head h2 {\n    margin: 0;\n    font:\n      400 clamp(1.8rem, 4vw, 2.8rem)/1 'Righteous',\n      sans-serif;\n  }\n  #sc-records .lt-head p {\n    margin: 0;\n    color: var(--muted-foreground);\n  }\n  #sc-records .lt-crate {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));\n    gap: 2rem 1.5rem;\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n  #sc-records .lt-sleeve {\n    position: relative;\n    display: grid;\n    gap: 0.6rem;\n  }\n  #sc-records .lt-sleeve img {\n    width: 100%;\n    aspect-ratio: 1;\n    object-fit: cover;\n    box-shadow: 0 1rem 1.5rem -1rem oklch(0 0 0 / 0.55);\n  }\n  #sc-records .lt-sleeve:nth-child(1) img {\n    rotate: -3deg;\n  }\n  #sc-records .lt-sleeve:nth-child(2) img {\n    rotate: 2deg;\n  }\n  #sc-records .lt-sleeve:nth-child(3) img {\n    rotate: -1deg;\n  }\n  #sc-records .lt-sleeve:nth-child(4) img {\n    rotate: 3deg;\n  }\n  #sc-records .lt-sleeve h3 {\n    margin: 0.4rem 0 0;\n    font-size: 1.05rem;\n  }\n  #sc-records .lt-sleeve p {\n    margin: 0;\n    color: var(--muted-foreground);\n    font-size: 0.875rem;\n  }\n  #sc-records .lt-price {\n    position: absolute;\n    top: -0.75rem;\n    right: -0.5rem;\n    display: grid;\n    place-items: center;\n    width: 3.6rem;\n    aspect-ratio: 1;\n    border-radius: 50%;\n    background: var(--lt-sticker);\n    color: oklch(0.15 0 0);\n    font:\n      600 0.85rem/1 'Overpass Mono',\n      monospace;\n    rotate: 12deg;\n    box-shadow: 0 0.3rem 0.5rem -0.2rem oklch(0 0 0 / 0.4);\n  }\n  #sc-records[data-look='mono'] .lt-price {\n    border: 2px solid oklch(0.12 0 0);\n  }\n  #sc-records .lt-booth {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) auto;\n    align-items: center;\n    gap: 1.5rem;\n    padding: 1.5rem 2rem;\n    border: 2px solid var(--foreground);\n    border-radius: var(--radius-xl);\n    box-shadow: 0.4rem 0.4rem 0 var(--primary);\n  }\n  #sc-records .lt-booth p {\n    margin: 0;\n    font-size: 1.1rem;\n  }\n  #sc-records .lt-booth b {\n    font-family: 'Righteous', sans-serif;\n    font-weight: 400;\n    font-size: 1.6rem;\n  }\n  /* the Site Footer: the shop by the fish market, the hours, the records, the post and the legal notes */\n  #sc-records .mk-footer {\n    background: none;\n    color: inherit;\n  }\n  #sc-records .mk-footer-inner {\n    max-width: none;\n    padding: 2rem 0 0;\n    border-block-start: 2px solid var(--foreground);\n  }\n  #sc-records .mk-footer-heading {\n    color: inherit;\n    font:\n      600 0.75rem/1.3 'Overpass Mono',\n      monospace;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n  }\n  #sc-records .mk-footer address {\n    font-style: normal;\n    line-height: 1.5;\n  }\n  #sc-records .lt-note {\n    margin: 0;\n    color: var(--muted-foreground);\n    font-size: 0.875rem;\n    line-height: 1.5;\n  }\n  #sc-records .lt-open {\n    display: grid;\n    grid-template-columns: auto 1fr;\n    gap: 0.35rem 1rem;\n    margin: 0;\n    font-size: 0.9375rem;\n  }\n  #sc-records .lt-open dt {\n    font-family: 'Overpass Mono', monospace;\n    font-size: 0.875rem;\n  }\n  #sc-records .lt-open dd {\n    margin: 0;\n    color: var(--muted-foreground);\n  }\n  #sc-records .mk-footer-list :is(a, button) {\n    padding: 0;\n    border: 0;\n    background: none;\n    color: inherit;\n    font: inherit;\n    text-align: start;\n    cursor: pointer;\n  }\n  #sc-records .mk-footer-list :is(a, button):is(:hover, :focus-visible) {\n    text-decoration: underline;\n    text-decoration-color: var(--primary);\n    text-decoration-thickness: 0.15em;\n    text-underline-offset: 0.25em;\n  }\n  #sc-records .mk-footer-rule {\n    margin: 0;\n    background: var(--border);\n  }\n  #sc-records .mk-footer-copy {\n    color: var(--muted-foreground);\n  }\n  /* the dialogs: the pre-order and the legal notes, on the look's card */\n  #sc-records .sc-dialog {\n    border: 2px solid var(--foreground);\n    background: var(--card);\n    color: var(--card-foreground);\n    box-shadow: 0.4rem 0.4rem 0 var(--primary);\n  }\n  #sc-records .sc-dialog .dialog-title {\n    font:\n      400 1.6rem/1.1 'Righteous',\n      sans-serif;\n  }\n  #sc-records .sc-dialog .dialog-description {\n    color: var(--muted-foreground);\n  }\n  #sc-records :is(.sc-form, .sc-done) {\n    display: grid;\n    gap: 1rem;\n  }\n  #sc-records .sc-row {\n    display: grid;\n    gap: 0.4rem;\n  }\n  #sc-records .sc-choice {\n    display: grid;\n    gap: 0.5rem;\n    margin: 0;\n    padding: 0;\n    border: 0;\n  }\n  #sc-records .sc-choice legend {\n    margin-block-end: 0.5rem;\n  }\n  #sc-records .sc-choice label {\n    display: flex;\n    align-items: center;\n    gap: 0.6rem;\n    padding: 0.6rem 0.8rem;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-md);\n    cursor: pointer;\n  }\n  #sc-records .sc-choice label:has(:checked) {\n    border-color: var(--primary);\n    box-shadow: inset 0 0 0 1px var(--primary);\n  }\n  #sc-records .sc-choice input {\n    accent-color: var(--primary);\n  }\n  #sc-records .sc-dialog:not([data-sent]) .sc-done,\n  #sc-records .sc-dialog[data-sent] .sc-form {\n    display: none;\n  }\n  #sc-records .sc-legal {\n    display: grid;\n    gap: 0.75rem;\n    font-size: 0.9375rem;\n    line-height: 1.55;\n  }\n  #sc-records .sc-legal :is(p, address) {\n    margin: 0;\n    font-style: normal;\n  }\n  #sc-records .sc-legal a {\n    color: inherit;\n  }\n  @media (max-width: 48rem) {\n    #sc-records :is(.lt-release, .lt-booth) {\n      grid-template-columns: 1fr;\n    }\n    #sc-records .mk-header-nav {\n      order: 3;\n      width: 100%;\n      margin-inline-start: -0.75rem;\n    }\n    #sc-records .mk-header-actions {\n      margin-inline-start: auto;\n    }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    #sc-records :is(.lt-record, .lt-record::after) {\n      animation: none;\n    }\n  }\n  /* light or dark: the Swap writes the page's dark class - every look has a light and a dark palette */\n  #sc-records .site-mode {\n    flex: none;\n    border: 1px solid var(--input);\n    border-radius: var(--radius-md);\n    background: var(--background);\n    color: var(--foreground);\n  }\n  #sc-records .site-mode:hover {\n    background: var(--accent);\n    color: var(--accent-foreground);\n  }\n  /* -- modes: each look in light and dark, derived from the palettes above (the other mode of each look) -- */\n  :root:not(.dark) #sc-records[data-look='tape'] {\n    --primary-foreground: oklch(0.17 0.03 45);\n    --accent: oklch(0.885 0.045 45);\n    --accent-foreground: oklch(0.27 0.05 45);\n  }\n  .dark #sc-records[data-look='tape'] {\n    color-scheme: dark;\n    --background: oklch(0.17 0.03 70);\n    --foreground: oklch(0.94 0.03 45);\n    --card: oklch(0.205 0.025 75);\n    --card-foreground: oklch(0.94 0.03 45);\n    --muted: oklch(0.24 0.035 70);\n    --muted-foreground: oklch(0.74 0.03 45);\n    --border: oklch(0.95 0.02 45 / 0.14);\n    --input: oklch(0.95 0.02 45 / 0.14);\n    --primary: oklch(0.65 0.18 45);\n    --primary-foreground: oklch(0.17 0.03 45);\n    --secondary: oklch(0.25 0.035 70);\n    --secondary-foreground: oklch(0.9 0.03 45);\n    --accent: oklch(0.26 0.05 45);\n    --accent-foreground: oklch(0.94 0.03 45);\n    --ring: oklch(0.65 0.18 45);\n    --lt-label: oklch(0.65 0.18 45);\n    --lt-sticker: oklch(0.88 0.15 95);\n    --popover: oklch(0.215 0 0);\n    --popover-foreground: oklch(0.94 0 0);\n  }\n  .dark #sc-records[data-look='vapor'] {\n    --accent: oklch(0.29 0.05 350);\n    --accent-foreground: oklch(0.95 0.03 330);\n  }\n  :root:not(.dark) #sc-records[data-look='vapor'] {\n    color-scheme: light;\n    --background: oklch(0.985 0.025 300);\n    --foreground: oklch(0.2 0.03 330);\n    --card: oklch(0.997 0.025 300);\n    --card-foreground: oklch(0.2 0.03 330);\n    --muted: oklch(0.95 0.025 300);\n    --muted-foreground: oklch(0.46 0.03 320);\n    --border: oklch(0.2 0.02 330 / 0.12);\n    --input: oklch(0.2 0.02 330 / 0.12);\n    --primary: oklch(0.57 0.13 195);\n    --primary-foreground: oklch(0.17 0.03 195);\n    --secondary: oklch(0.955 0.025 300);\n    --secondary-foreground: oklch(0.25 0.03 330);\n    --accent: oklch(0.94 0.025 350);\n    --accent-foreground: oklch(0.2 0.03 330);\n    --ring: oklch(0.57 0.13 195);\n    --lt-label: oklch(0.5 0.18 350);\n    --lt-sticker: oklch(0.57 0.13 195);\n    --popover: oklch(0.997 0 0);\n    --popover-foreground: oklch(0.2 0 0);\n  }\n  :root:not(.dark) #sc-records[data-look='mono'] {\n    --accent: oklch(0.935 0 0);\n    --accent-foreground: oklch(0.12 0 0);\n  }\n  .dark #sc-records[data-look='mono'] {\n    color-scheme: dark;\n    --background: oklch(0.17 0 0);\n    --foreground: oklch(0.94 0 0);\n    --card: oklch(0.205 0 0);\n    --card-foreground: oklch(0.94 0 0);\n    --muted: oklch(0.24 0 0);\n    --muted-foreground: oklch(0.74 0 0);\n    --border: oklch(0.31 0 0);\n    --input: oklch(0.33 0 0);\n    --primary: oklch(0.93 0 0);\n    --primary-foreground: oklch(0.17 0 0);\n    --secondary: oklch(0.25 0 0);\n    --secondary-foreground: oklch(0.9 0 0);\n    --accent: oklch(0.26 0 0);\n    --accent-foreground: oklch(0.94 0 0);\n    --ring: oklch(0.93 0 0);\n    --lt-label: oklch(0.18 0 0);\n    --lt-sticker: oklch(0.18 0 0);\n    --popover: oklch(0.215 0 0);\n    --popover-foreground: oklch(0.94 0 0);\n  }\n  /* -- modes: end -- */\n</style>\n<div id=\"sc-records\" data-look=\"tape\">\n  <div class=\"lt-page\">\n    <header class=\"mk-header lt-bar\">\n      <div class=\"mk-header-inner\">\n        <a class=\"mk-header-brand\" href=\"#sc-records\"\n          ><span class=\"lt-logo\" aria-hidden=\"true\"></span><span class=\"mk-header-name\">Lowtide</span></a\n        >\n        <nav class=\"mk-header-nav\" aria-label=\"Site\">\n          <ul class=\"nav-menu-list\">\n            <li class=\"nav-menu-item\"><a class=\"nav-menu-link\" href=\"#lt-release\">New release</a></li>\n            <li class=\"nav-menu-item\"><a class=\"nav-menu-link\" href=\"#lt-crate\">Arrivals</a></li>\n            <li class=\"nav-menu-item\"><a class=\"nav-menu-link\" href=\"#lt-booth\">Booth</a></li>\n            <li class=\"nav-menu-item\"><a class=\"nav-menu-link\" href=\"#lt-shop\">The shop</a></li>\n          </ul>\n        </nav>\n        <div class=\"mk-header-actions\">\n          <select class=\"select\" data-size=\"sm\" data-site-look aria-label=\"Look\" style=\"width: auto\">\n            <option value=\"tape\">Tape</option>\n            <option value=\"vapor\">Vapor</option>\n            <option value=\"mono\">Mono</option>\n          </select>\n          <label class=\"swap site-mode\" data-variant=\"rotate\" data-size=\"sm\">\n            <input type=\"checkbox\" data-site-mode aria-label=\"Dark mode\" />\n            <span class=\"swap-on\" aria-hidden=\"true\"><i data-lucide=\"moon\"></i></span>\n            <span class=\"swap-off\" aria-hidden=\"true\"><i data-lucide=\"sun\"></i></span>\n          </label>\n        </div>\n      </div>\n    </header>\n    <section id=\"lt-release\" class=\"lt-release\" aria-labelledby=\"lt-title\">\n      <div class=\"lt-stage\">\n        <div\n          class=\"shader\"\n          data-variant=\"background\"\n          data-effect=\"plasma\"\n          data-colors=\"var(--background) var(--primary) var(--lt-label) var(--muted)\"\n          data-speed=\"0.35\"\n          data-fps=\"30\"\n          aria-hidden=\"true\"\n        ></div>\n        <div class=\"lt-record\" role=\"img\" aria-label=\"The record, turning\"></div>\n      </div>\n      <div>\n        <p class=\"lt-cat\">LT-014 · 12\" LP · 33⅓ rpm · out 21 November</p>\n        <h1 id=\"lt-title\">Harbour Lights</h1>\n        <p class=\"lt-artist\">by Mira Halden</p>\n        <ol class=\"lt-tracks\">\n          <li><b>A1</b><span>Ebb</span><time datetime=\"PT4M12S\">4:12</time></li>\n          <li><b>A2</b><span>Cranes at dusk</span><time datetime=\"PT5M38S\">5:38</time></li>\n          <li><b>A3</b><span>Pier 7</span><time datetime=\"PT3M51S\">3:51</time></li>\n          <li><b>B1</b><span>Container blues</span><time datetime=\"PT6M04S\">6:04</time></li>\n          <li><b>B2</b><span>Low tide</span><time datetime=\"PT7M20S\">7:20</time></li>\n        </ol>\n        <div class=\"lt-actions\">\n          <button class=\"btn\" data-size=\"lg\" type=\"button\" commandfor=\"lt-preorder\" command=\"show-modal\"\n            >Pre-order · €24</button\n          >\n          <a class=\"btn\" data-variant=\"outline\" data-size=\"lg\" href=\"#lt-booth\">Listen in the booth</a>\n        </div>\