[{"label":"Section Header (sm)","html":"<header class=\"mk-section-header\" data-size=\"sm\">\n  <div class=\"mk-section-header-copy\">\n    <h2 class=\"mk-section-header-title\">Small - a sub-section</h2>\n    <p class=\"mk-section-header-desc\">For groups inside a longer section.</p>\n  </div>\n</header>\n","individual":true},{"label":"Section Header (lg)","html":"<header class=\"mk-section-header\" data-size=\"lg\">\n  <div class=\"mk-section-header-copy\">\n    <span class=\"mk-section-header-eyebrow\">Large</span>\n    <h2 class=\"mk-section-header-title\">The first section on a page</h2>\n  </div>\n</header>\n","individual":true},{"label":"Default","html":"<header class=\"mk-section-header\">\n  <div class=\"mk-section-header-copy\">\n    <span class=\"mk-section-header-eyebrow\">Features</span>\n    <h2 class=\"mk-section-header-title\">Everything your team needs to ship calmly</h2>\n    <p class=\"mk-section-header-desc\"\n      >Plan, write and review in one place - with the tools you already use, and none of the noise.</p\n    >\n  </div>\n  <div class=\"mk-section-header-actions\">\n    <a class=\"btn\" href=\"#\">Get started</a>\n    <a class=\"btn\" data-variant=\"ghost\" href=\"#\">See all features <i data-lucide=\"arrow-right\"></i></a>\n  </div>\n</header>\n","individual":true},{"label":"Centered","html":"<header class=\"mk-section-header\" data-align=\"center\">\n  <div class=\"mk-section-header-copy\">\n    <span class=\"mk-section-header-eyebrow\">Pricing</span>\n    <h2 class=\"mk-section-header-title\">Simple plans for every stage</h2>\n    <p class=\"mk-section-header-desc\">Start free, upgrade when your team grows. No seat minimums, cancel any time.</p>\n  </div>\n</header>\n","individual":true},{"label":"Split","html":"<header class=\"mk-section-header\" data-variant=\"split\">\n  <div class=\"mk-section-header-copy\">\n    <span class=\"mk-section-header-eyebrow\">From the blog</span>\n    <h2 class=\"mk-section-header-title\">Latest writing</h2>\n    <p class=\"mk-section-header-desc\">Notes on product, engineering and the craft of calm software.</p>\n  </div>\n  <div class=\"mk-section-header-actions\">\n    <a class=\"btn\" data-variant=\"outline\" href=\"#\">All posts</a>\n  </div>\n</header>\n","individual":true},{"label":"Numbered","html":"<header class=\"mk-section-header\" data-variant=\"numbered\" data-index=\"01\">\n  <div class=\"mk-section-header-copy\">\n    <span class=\"mk-section-header-eyebrow\">How it works</span>\n    <h2 class=\"mk-section-header-title\">Write it once, everywhere</h2>\n    <p class=\"mk-section-header-desc\"\n      >Drafts sync to every device the moment you type - online or off. Nothing to save, nothing to merge.</p\n    >\n  </div>\n  <div class=\"mk-section-header-actions\">\n    <a class=\"btn\" data-variant=\"outline\" href=\"#\">Read the sync deep-dive <i data-lucide=\"arrow-right\"></i></a>\n  </div>\n</header>\n","individual":true},{"label":"Divider","html":"<header class=\"mk-section-header\" data-variant=\"divider\" data-size=\"sm\">\n  <div class=\"mk-section-header-copy\">\n    <span class=\"mk-section-header-eyebrow\">Chapter two</span>\n    <h2 class=\"mk-section-header-title\">Integrations</h2>\n  </div>\n</header>\n","individual":true},{"label":"Banner with social proof","html":"<header class=\"mk-section-header\" data-variant=\"banner\" data-align=\"center\" data-size=\"lg\">\n  <div class=\"mk-section-header-copy\">\n    <span class=\"badge\" data-variant=\"outline\"><i data-lucide=\"sparkles\"></i> New in Acme 4.0</span>\n    <h2 class=\"mk-section-header-title\">Your team's calm place to write</h2>\n    <p class=\"mk-section-header-desc\"\n      >Docs, decisions and tasks in one quiet tool - fast enough to keep up, simple enough to forget.</p\n    >\n  </div>\n  <div class=\"mk-section-header-actions\">\n    <a class=\"btn\" data-size=\"lg\" href=\"#\">Start free</a>\n    <a class=\"btn\" data-variant=\"outline\" data-size=\"lg\" href=\"#\"\n      >Open the app <kbd class=\"kbd\">⌘</kbd><kbd class=\"kbd\">K</kbd></a\n    >\n  </div>\n  <div class=\"mk-section-header-proof\">\n    <div class=\"avatar-group\">\n      <span class=\"avatar\" data-size=\"sm\"><img class=\"avatar-image\" src=\"images/mk-portrait.png\" alt=\"\" /></span>\n      <span class=\"avatar\" data-size=\"sm\"><img class=\"avatar-image\" src=\"images/mk-portrait2.png\" alt=\"\" /></span>\n      <span class=\"avatar\" data-size=\"sm\"><img class=\"avatar-image\" src=\"images/mk-portrait.png\" alt=\"\" /></span>\n      <span class=\"avatar\" data-size=\"sm\"><img class=\"avatar-image\" src=\"images/mk-portrait2.png\" alt=\"\" /></span>\n      <span class=\"avatar-group-count\">+2k</span>\n    </div>\n    <span>Loved by <strong>12,000</strong> teams</span>\n  </div>\n</header>\n","individual":true},{"label":"Sizes","html":"<div style=\"display: grid; gap: 2.5rem; width: 100%\">\n  <header class=\"mk-section-header\" data-size=\"sm\">\n    <div class=\"mk-section-header-copy\">\n      <h2 class=\"mk-section-header-title\">Small - a sub-section</h2>\n      <p class=\"mk-section-header-desc\">For groups inside a longer section.</p>\n    </div>\n  </header>\n  <header class=\"mk-section-header\" data-size=\"lg\">\n    <div class=\"mk-section-header-copy\">\n      <span class=\"mk-section-header-eyebrow\">Large</span>\n      <h2 class=\"mk-section-header-title\">The first section on a page</h2>\n    </div>\n  </header>\n</div>\n","individual":false}]
