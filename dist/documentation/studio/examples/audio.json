[{"label":"Audio","html":"<div\n  class=\"audio\"\n  id=\"audio-basic\"\n  role=\"group\"\n  aria-label=\"A day at the harbour\"\n  data-state-demo\n  style=\"max-inline-size: 32rem\"\n>\n  <audio preload=\"metadata\" src=\"videos/harbour.mp3\"></audio>\n  <button\n    class=\"btn\"\n    data-variant=\"ghost\"\n    data-size=\"icon\"\n    data-audio-action=\"toggle\"\n    aria-pressed=\"false\"\n    aria-label=\"Play\"\n  >\n    <i data-lucide=\"play\"></i><i data-lucide=\"pause\"></i>\n  </button>\n  <div class=\"audio-body\">\n    <span class=\"audio-title\">A day at the harbour</span>\n    <div class=\"audio-progress\">\n      <output class=\"audio-time\" data-audio-output=\"time\">0:00</output>\n      <input\n        class=\"slider\"\n        data-size=\"sm\"\n        type=\"range\"\n        min=\"0\"\n        max=\"24\"\n        step=\"0.1\"\n        value=\"0\"\n        data-audio-action=\"seek\"\n        aria-label=\"Seek\"\n      />\n      <output class=\"audio-time\" data-audio-output=\"duration\">0:24</output>\n    </div>\n  </div>\n  <button\n    class=\"btn\"\n    data-variant=\"ghost\"\n    data-size=\"icon-sm\"\n    data-audio-action=\"mute\"\n    aria-pressed=\"false\"\n    aria-label=\"Mute\"\n  >\n    <i data-lucide=\"volume-2\"></i><i data-lucide=\"volume-x\"></i>\n  </button>\n  <input\n    class=\"slider\"\n    data-size=\"xs\"\n    type=\"range\"\n    min=\"0\"\n    max=\"1\"\n    step=\"0.05\"\n    value=\"1\"\n    data-audio-action=\"volume\"\n    aria-label=\"Volume\"\n  />\n</div>\n","individual":true},{"label":"Compact","html":"<div\n  class=\"audio\"\n  id=\"audio-compact\"\n  data-variant=\"compact\"\n  role=\"group\"\n  aria-label=\"Harbour bell\"\n  style=\"max-inline-size: 24rem\"\n>\n  <audio preload=\"metadata\" src=\"videos/harbour.mp3\"></audio>\n  <button\n    class=\"btn\"\n    data-variant=\"ghost\"\n    data-size=\"icon-sm\"\n    data-audio-action=\"toggle\"\n    aria-pressed=\"false\"\n    aria-label=\"Play\"\n  >\n    <i data-lucide=\"play\"></i><i data-lucide=\"pause\"></i>\n  </button>\n  <div class=\"audio-body\">\n    <div class=\"audio-progress\">\n      <input\n        class=\"slider\"\n        data-size=\"sm\"\n        type=\"range\"\n        min=\"0\"\n        max=\"24\"\n        step=\"0.1\"\n        value=\"0\"\n        data-audio-action=\"seek\"\n        aria-label=\"Seek\"\n      />\n      <output class=\"audio-time\" data-audio-output=\"remaining\">-0:24</output>\n    </div>\n  </div>\n  <div class=\"audio-volume\" data-side=\"bottom\">\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"icon-sm\"\n      data-audio-action=\"mute\"\n      aria-pressed=\"false\"\n      aria-label=\"Mute\"\n    >\n      <i data-lucide=\"volume-2\"></i><i data-lucide=\"volume-x\"></i>\n    </button>\n    <div class=\"audio-volume-panel\">\n      <input\n        class=\"slider\"\n        data-orientation=\"vertical\"\n        data-size=\"xs\"\n        type=\"range\"\n        min=\"0\"\n        max=\"1\"\n        step=\"0.05\"\n        value=\"0.8\"\n        data-audio-action=\"volume\"\n        aria-label=\"Volume\"\n      />\n    </div>\n  </div>\n</div>\n","individual":true},{"label":"Rate and skip","html":"<div\n  class=\"audio\"\n  id=\"audio-rate\"\n  role=\"group\"\n  aria-label=\"A day at the harbour, at your speed\"\n  style=\"max-inline-size: 36rem\"\n>\n  <audio preload=\"metadata\" src=\"videos/harbour.mp3\"></audio>\n  <button\n    class=\"btn\"\n    data-variant=\"ghost\"\n    data-size=\"icon-sm\"\n    data-audio-action=\"skip\"\n    data-value=\"-5\"\n    aria-label=\"Back 5 seconds\"\n  >\n    <i data-lucide=\"rotate-ccw\"></i>\n  </button>\n  <button\n    class=\"btn\"\n    data-variant=\"ghost\"\n    data-size=\"icon\"\n    data-audio-action=\"toggle\"\n    aria-pressed=\"false\"\n    aria-label=\"Play\"\n  >\n    <i data-lucide=\"play\"></i><i data-lucide=\"pause\"></i>\n  </button>\n  <button\n    class=\"btn\"\n    data-variant=\"ghost\"\n    data-size=\"icon-sm\"\n    data-audio-action=\"skip\"\n    data-value=\"5\"\n    aria-label=\"Forward 5 seconds\"\n  >\n    <i data-lucide=\"rotate-cw\"></i>\n  </button>\n  <div class=\"audio-body\">\n    <span class=\"audio-title\">A day at the harbour</span>\n    <div class=\"audio-progress\">\n      <output class=\"audio-time\" data-audio-output=\"time\">0:00</output>\n      <input\n        class=\"slider\"\n        data-size=\"sm\"\n        type=\"range\"\n        min=\"0\"\n        max=\"24\"\n        step=\"0.1\"\n        value=\"0\"\n        data-audio-action=\"seek\"\n        aria-label=\"Seek\"\n      />\n      <output class=\"audio-time\" data-audio-output=\"duration\">0:24</output>\n    </div>\n  </div>\n  <select class=\"select\" data-size=\"sm\" data-audio-action=\"rate\" aria-label=\"Speed\">\n    <option value=\"0.75\">0.75×</option>\n    <option value=\"1\" selected>1×</option>\n    <option value=\"1.5\">1.5×</option>\n    <option value=\"2\">2×</option>\n  </select>\n</div>\n","individual":true},{"label":"Controls anywhere on the page","html":"<div class=\"grid gap-3\" style=\"max-inline-size: 32rem\">\n  <div class=\"audio\" id=\"audio-remote\" role=\"group\" aria-label=\"A day at the harbour\">\n    <audio preload=\"metadata\" src=\"videos/harbour.mp3\"></audio>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"icon\"\n      data-audio-action=\"toggle\"\n      aria-pressed=\"false\"\n      aria-label=\"Play\"\n    >\n      <i data-lucide=\"play\"></i><i data-lucide=\"pause\"></i>\n    </button>\n    <div class=\"audio-body\">\n      <span class=\"audio-title\">A day at the harbour</span>\n      <div class=\"audio-progress\">\n        <output class=\"audio-time\" data-audio-output=\"time\">0:00</output>\n        <input\n          class=\"slider\"\n          data-size=\"sm\"\n          type=\"range\"\n          min=\"0\"\n          max=\"24\"\n          step=\"0.1\"\n          value=\"0\"\n          data-audio-action=\"seek\"\n          aria-label=\"Seek\"\n        />\n        <output class=\"audio-time\" data-audio-output=\"duration\">0:24</output>\n      </div>\n    </div>\n  </div>\n  <div class=\"flex flex-wrap items-center gap-2\" data-audio-for=\"audio-remote\">\n    <button\n      class=\"btn\"\n      data-variant=\"outline\"\n      data-size=\"icon-sm\"\n      data-audio-action=\"toggle\"\n      aria-pressed=\"false\"\n      aria-label=\"Play\"\n    >\n      <i data-lucide=\"play\"></i><i data-lucide=\"pause\"></i>\n    </button>\n    <output class=\"audio-time\" data-audio-output=\"remaining\">-0:24</output>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"audio-remote-gulls\">Gulls 0:07</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"audio-remote-bell\">Bell 0:13</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"audio-remote-silence\">Silence 0:21</button>\n  </div>\n</div>\n","individual":false},{"label":"The API and the store","html":"<div class=\"grid gap-3\" style=\"max-inline-size: 32rem\">\n  <div class=\"audio\" id=\"audio-api\" role=\"group\" aria-label=\"A day at the harbour\">\n    <audio preload=\"metadata\" src=\"videos/harbour.mp3\"></audio>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"icon\"\n      data-audio-action=\"toggle\"\n      aria-pressed=\"false\"\n      aria-label=\"Play\"\n    >\n      <i data-lucide=\"play\"></i><i data-lucide=\"pause\"></i>\n    </button>\n    <div class=\"audio-body\">\n      <span class=\"audio-title\">A day at the harbour</span>\n      <div class=\"audio-progress\">\n        <output class=\"audio-time\" data-audio-output=\"time\">0:00</output>\n        <input\n          class=\"slider\"\n          data-size=\"sm\"\n          type=\"range\"\n          min=\"0\"\n          max=\"24\"\n          step=\"0.1\"\n          value=\"0\"\n          data-audio-action=\"seek\"\n          aria-label=\"Seek\"\n        />\n        <output class=\"audio-time\" data-audio-output=\"duration\">0:24</output>\n      </div>\n    </div>\n  </div>\n  <div class=\"flex flex-wrap gap-2\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"audio-api-toggle\">toggle()</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"audio-api-skip\">skip(5)</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"audio-api-mute\">mute()</button>\n  </div>\n  <output class=\"text-sm text-muted-foreground\" id=\"audio-api-state\">default</output>\n</div>\n","individual":false}]
