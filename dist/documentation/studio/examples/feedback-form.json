[{"label":"Default","html":"<section class=\"mk-feedback-form\" aria-labelledby=\"fb-title\">\n  <h2 id=\"fb-title\">How was your first week with Acme?</h2>\n  <form action=\"#\" method=\"post\">\n    <fieldset\n      ><legend class=\"sr-only\">Your rating</legend\n      ><div class=\"mk-feedback-form-faces\"\n        ><label><input type=\"radio\" name=\"rating\" value=\"1\" aria-label=\"Very bad\" required />😞</label\n        ><label><input type=\"radio\" name=\"rating\" value=\"2\" aria-label=\"Bad\" required />🙁</label\n        ><label><input type=\"radio\" name=\"rating\" value=\"3\" aria-label=\"Okay\" required />😐</label\n        ><label><input type=\"radio\" name=\"rating\" value=\"4\" aria-label=\"Good\" checked required />🙂</label\n        ><label><input type=\"radio\" name=\"rating\" value=\"5\" aria-label=\"Great\" required />😍</label></div\n      ></fieldset\n    >\n    <fieldset\n      ><legend>What could be better?</legend\n      ><div class=\"mk-feedback-form-chips\"\n        ><label><input type=\"checkbox\" name=\"topics\" value=\"speed\" />Speed</label\n        ><label><input type=\"checkbox\" name=\"topics\" value=\"search\" checked />Search</label\n        ><label><input type=\"checkbox\" name=\"topics\" value=\"onboarding\" />Onboarding</label\n        ><label><input type=\"checkbox\" name=\"topics\" value=\"mobile app\" />Mobile app</label\n        ><label><input type=\"checkbox\" name=\"topics\" value=\"pricing\" />Pricing</label></div\n      ></fieldset\n    >\n    <div style=\"display: grid; gap: 0.375rem\"\n      ><label class=\"label\" for=\"fb-text\">Anything else?</label><textarea class=\"textarea\" id=\"fb-text\" name=\"comment\" rows=\"3\"></textarea>\n    </div>\n    <button class=\"btn\" type=\"submit\">Send feedback</button>\n  </form>\n</section>\n","individual":true},{"label":"NPS","html":"<section class=\"mk-feedback-form\" data-variant=\"nps\" aria-labelledby=\"fb2-title\">\n  <form action=\"#\" method=\"post\">\n    <fieldset>\n      <legend id=\"fb2-title\">How likely are you to recommend Acme to a colleague?</legend>\n      <div class=\"mk-feedback-form-scale\"\n        ><label><input type=\"radio\" name=\"nps\" value=\"0\" required />0</label\n        ><label><input type=\"radio\" name=\"nps\" value=\"1\" required />1</label\n        ><label><input type=\"radio\" name=\"nps\" value=\"2\" required />2</label\n        ><label><input type=\"radio\" name=\"nps\" value=\"3\" required />3</label\n        ><label><input type=\"radio\" name=\"nps\" value=\"4\" required />4</label\n        ><label><input type=\"radio\" name=\"nps\" value=\"5\" required />5</label\n        ><label><input type=\"radio\" name=\"nps\" value=\"6\" required />6</label\n        ><label><input type=\"radio\" name=\"nps\" value=\"7\" required />7</label\n        ><label><input type=\"radio\" name=\"nps\" value=\"8\" required />8</label\n        ><label><input type=\"radio\" name=\"nps\" value=\"9\" checked required />9</label\n        ><label><input type=\"radio\" name=\"nps\" value=\"10\" required />10</label></div\n      >\n      <div class=\"mk-feedback-form-ends\" aria-hidden=\"true\"\n        ><span>0 · Not at all likely</span><span>10 · Extremely likely</span></div\n      >\n    </fieldset>\n    <button class=\"btn\" type=\"submit\">Submit</button>\n  </form>\n</section>\n","individual":true},{"label":"Was this helpful?","html":"<form class=\"mk-feedback-form\" data-variant=\"inline\" action=\"#\" method=\"post\">\n  <fieldset\n    ><legend>Was this page helpful?</legend\n    ><div class=\"mk-feedback-form-yesno\"\n      ><label><input type=\"radio\" name=\"helpful\" value=\"yes\" /><i data-lucide=\"thumbs-up\"></i> Yes</label\n      ><label><input type=\"radio\" name=\"helpful\" value=\"no\" /><i data-lucide=\"thumbs-down\"></i> No</label></div\n    ></fieldset\n  >\n  <p class=\"mk-feedback-form-thanks\" role=\"status\">Thanks - your answer helps us improve this page.</p>\n</form>\n","individual":true}]
