[{"label":"Rings in the palette","html":"<div\n  class=\"shader\"\n  data-effect=\"custom\"\n  data-rings=\"9\"\n  data-arms=\"3\"\n  data-colors=\"#0f172a #6366f1 #22d3ee #f0abfc\"\n  aria-hidden=\"true\"\n  style=\"--shader-aspect: 21 / 9; border-radius: var(--radius)\"\n>\n  \n</div>\n","individual":false},{"label":"A registered effect","html":"<div class=\"grid gap-3\" style=\"grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr))\">\n  <div class=\"shader\" data-effect=\"plasma\" aria-hidden=\"true\" style=\"border-radius: var(--radius)\"></div>\n  <div\n    class=\"shader\"\n    data-effect=\"plasma\"\n    data-scale=\"7\"\n    data-colors=\"#ff006e #fb5607 #ffbe0b\"\n    aria-hidden=\"true\"\n    style=\"border-radius: var(--radius)\"\n  ></div>\n</div>\n","individual":false},{"label":"Rays over grain","html":"<section style=\"border-radius: var(--radius); padding: 4rem 2rem; color: white; text-align: center; overflow: hidden\">\n  <div\n    class=\"shader\"\n    data-variant=\"background\"\n    data-effect=\"grain-gradient\"\n    data-colors=\"#05030f #2a1466 #7b2cbf #ff9e6d\"\n    aria-hidden=\"true\"\n  ></div>\n  <div\n    class=\"shader\"\n    data-variant=\"background\"\n    data-effect=\"god-rays\"\n    data-background=\"#000\"\n    data-origin-y=\"1.2\"\n    aria-hidden=\"true\"\n    style=\"mix-blend-mode: screen\"\n  ></div>\n  <h2 style=\"margin: 0; font-size: clamp(1.75rem, 5vw, 2.75rem)\">Two shaders, one context</h2>\n  <p style=\"opacity: 0.85\">Composed by the browser, like any two boxes.</p>\n</section>\n","individual":false}]
