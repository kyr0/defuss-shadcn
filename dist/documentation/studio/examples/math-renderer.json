[{"label":"Formula Rendering","html":"<figure class=\"math-renderer\" aria-label=\"The area of a circle\">\n  <code class=\"math-renderer-source\">A = \\pi r^2 = \\int_0^r 2 \\pi t \\, dt</code>\n</figure>\n","individual":true},{"label":"Formula Rendering (inline)","html":"<span class=\"math-renderer\" data-variant=\"inline\"><code class=\"math-renderer-source\">a</code></span>\n","individual":true},{"label":"A display formula","html":"<figure class=\"math-renderer\" data-variant=\"card\" aria-label=\"The quadratic formula\">\n  <code class=\"math-renderer-source\">x = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}</code>\n  <figcaption>The quadratic formula</figcaption>\n</figure>\n","individual":true},{"label":"Inline in a sentence, then on its own line","html":"<p style=\"max-width: 36rem; line-height: 1.7\">\n  A right triangle with legs\n  <span class=\"math-renderer\" data-variant=\"inline\"><code class=\"math-renderer-source\">a</code></span>\n  and\n  <span class=\"math-renderer\" data-variant=\"inline\"><code class=\"math-renderer-source\">b</code></span>\n  has the hypotenuse\n  <span class=\"math-renderer\" data-variant=\"inline\"\n    ><code class=\"math-renderer-source\">c = \\sqrt{a^2 + b^2}</code></span\n  >\n  - and the area of a circle of radius\n  <span class=\"math-renderer\" data-variant=\"inline\"><code class=\"math-renderer-source\">r</code></span>\n  is\n</p>\n<figure class=\"math-renderer\" aria-label=\"The area of a circle\">\n  <code class=\"math-renderer-source\">A = \\pi r^2 = \\int_0^r 2 \\pi t \\, dt</code>\n</figure>\n","individual":false},{"label":"Aligned, matrix, cases","html":"<div style=\"display: grid; gap: 1rem\">\n  <figure class=\"math-renderer\" aria-label=\"Expanding a square\">\n    <code class=\"math-renderer-source\"\n      >\\begin{aligned} (a+b)^2 &amp;= (a+b)(a+b) \\\\ &amp;= a^2 + ab + ba + b^2 \\\\ &amp;= a^2 + 2ab + b^2\n      \\end{aligned}</code\n    >\n  </figure>\n  <figure class=\"math-renderer\" aria-label=\"A rotation matrix\">\n    <code class=\"math-renderer-source\"\n      >R(\\theta) = \\begin{pmatrix} \\cos\\theta &amp; -\\sin\\theta \\\\ \\sin\\theta &amp; \\cos\\theta \\end{pmatrix}</code\n    >\n  </figure>\n  <figure class=\"math-renderer\" aria-label=\"The absolute value\">\n    <code class=\"math-renderer-source\"\n      >|x| = \\begin{cases} x &amp; \\text{if } x \\ge 0 \\\\ -x &amp; \\text{if } x &lt; 0 \\end{cases}</code\n    >\n  </figure>\n</div>\n","individual":false},{"label":"A formula and its symbol table, linked","html":"<figure class=\"math-renderer\" id=\"variance\" aria-label=\"The sample variance\">\n  <code class=\"math-renderer-source\">s^2 = \\frac{\\sum (x_i - m)^2}{n - 1}</code>\n  \n  <figcaption>The sample variance - select a term</figcaption>\n</figure>\n<table class=\"table\" style=\"max-width: 32rem; margin-inline: auto\">\n  <thead\n    ><tr><th scope=\"col\">Symbol</th><th scope=\"col\">Meaning</th></tr></thead\n  >\n  <tbody>\n    <tr data-math-for=\"variance\" data-math-term=\"s2\"><td>s²</td><td>the sample variance</td></tr>\n    <tr data-math-for=\"variance\" data-math-term=\"xi\"><td>xᵢ</td><td>one of the n observations</td></tr>\n    <tr data-math-for=\"variance\" data-math-term=\"m\"><td>m</td><td>their mean</td></tr>\n    <tr data-math-for=\"variance\" data-math-term=\"dof\"><td>n - 1</td><td>the degrees of freedom</td></tr>\n  </tbody>\n</table>\n","individual":false},{"label":"Export a formula","html":"<figure class=\"math-renderer\" id=\"euler\" aria-label=\"Euler's identity\">\n  <code class=\"math-renderer-source\">e^{i\\pi} + 1 = 0</code>\n</figure>\n<div class=\"flex gap-2 justify-center mb-3\">\n  <button class=\"btn\" type=\"button\" data-variant=\"outline\" data-size=\"sm\" data-export=\"latex\">TeX</button>\n  <button class=\"btn\" type=\"button\" data-variant=\"outline\" data-size=\"sm\" data-export=\"mathml\">MathML</button>\n</div>\n<pre id=\"euler-out\" style=\"white-space: pre-wrap; font-size: 0.75rem; max-height: 12rem; overflow: auto\"></pre>\n","individual":false},{"label":"A parse error and an untrusted command","html":"<figure class=\"math-renderer\" aria-label=\"A formula with a missing brace\">\n  <code class=\"math-renderer-source\">\\frac{1}{1 + e^{-x}</code>\n</figure>\n<figure class=\"math-renderer\" aria-label=\"A formula with a link\">\n  <code class=\"math-renderer-source\">\\href{https://example.com}{x} + 1</code>\n</figure>\n","individual":false}]
