[{"label":"Default","html":"<header class=\"mk-event-header\">\n  <div class=\"mk-event-header-inner\">\n    <div class=\"mk-event-header-copy\">\n      <div class=\"mk-event-header-badges\"\n        ><span class=\"badge\" data-variant=\"default\">Conference</span\n        ><span class=\"badge\" data-variant=\"outline\">3rd edition</span></div\n      >\n      <h1 class=\"mk-event-header-title\">Acme Summit 2026</h1>\n      <p class=\"mk-event-header-tagline\"\n        >Two days of talks and workshops on building calm software - for product people, designers and engineers.</p\n      >\n      <ul class=\"mk-event-header-meta\">\n        <li\n          ><i data-lucide=\"calendar\"></i\n          ><span><time datetime=\"2026-11-12\">12</time>–<time datetime=\"2026-11-13\">13 November 2026</time></span></li\n        >\n        <li><i data-lucide=\"map-pin\"></i><address>Lisbon Congress Centre, Portugal</address></li>\n        <li><i data-lucide=\"ticket\"></i>From €290</li>\n      </ul>\n      <div class=\"mk-event-header-actions\">\n        <a class=\"btn\" data-size=\"lg\" href=\"#\">Register now</a>\n        <a class=\"btn\" data-variant=\"outline\" data-size=\"lg\" href=\"#\" download=\"acme-summit-2026.ics\"\n          ><i data-lucide=\"calendar-plus\"></i> Add to calendar</a\n        >\n      </div>\n      <div class=\"mk-event-header-speakers\"\n        ><div class=\"avatar-group\"\n          ><span class=\"avatar\" data-size=\"sm\"><img class=\"avatar-image\" src=\"images/mk-portrait.png\" alt=\"\" /></span\n          ><span class=\"avatar\" data-size=\"sm\"><img class=\"avatar-image\" src=\"images/mk-portrait2.png\" alt=\"\" /></span\n          ><span class=\"avatar\" data-size=\"sm\"\n            ><img class=\"avatar-image\" src=\"images/mk-portrait.png\" alt=\"\" /></span></div\n        >40+ speakers from 12 countries</div\n      >\n    </div>\n  </div>\n</header>\n","individual":true},{"label":"Over a cover","html":"<header class=\"mk-event-header\" data-vari