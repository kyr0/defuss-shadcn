 </div>\n    <figure class=\"mk-event-header-poster\"\n      ><img src=\"https://picsum.photos/seed/ev-poster/600/800\" alt=\"Workshop poster\"\n    /></figure>\n  </div>\n</header>\n","individual":true}]
