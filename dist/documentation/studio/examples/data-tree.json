[{"label":"Custom labels and a kept view","html":"<div\n  class=\"data-tree\"\n  id=\"dt-files\"\n  aria-label=\"Project files\"\n  data-persist=\"local\"\n  data-persist-key=\"docs:project-files\"\n  style=\"height: 16rem; max-width: 26rem; --data-tree-row-height: 30px\"\n></div>\n","individual":true},{"label":"111,110 nodes","html":"<div class=\"flex flex-col gap-2\" style=\"max-width: 26rem\">\n  <input class=\"input\" data-tree-filter=\"dt-geo\" aria-label=\"Filter places\" placeholder=\"Filter places…\" />\n  <div\n    class=\"data-tree\"\n    id=\"dt-geo\"\n    aria-label=\"Places\"\n    data-empty-text=\"No place matches.\"\n    style=\"height: 20rem\"\n  ></div>\n  <p class=\"text-sm text-muted-foreground m-0\" id=\"dt-geo-line\" aria-live=\"polite\"></p>\n</div>\n","individual":false},{"label":"Selection drives a detail pane","html":"<div class=\"flex flex-wrap gap-4\">\n  <div class=\"flex flex-col gap-2\" style=\"flex: 1; min-width: 14rem\">\n    <select class=\"select\" aria-label=\"Sort\" id=\"dt-org-sort\">\n      <option value=\"\">Org chart order</option>\n      <option value=\"name:asc\">Name A–Z</option>\n      <option value=\"reports:desc\">Most reports first</option>\n    </select>\n    <div class=\"data-tree\" id=\"dt-org\" aria-label=\"Organization\" style=\"height: 16rem\"></div>\n  </div>\n  <div class=\"card\" style=\"flex: 1; min-width: 12rem\">\n    <div class=\"card-header\"\n      ><h3 class=\"card-title\" id=\"dt-org-name\">Pick someone</h3\n      ><p class=\"card-description\" id=\"dt-org-role\">Their role shows here.</p></div\n    >\n  </div>\n</div>\n","individual":false},{"label":"Loading and empty","html":"<div class=\"flex flex-wrap gap-4\">\n  <div class=\"data-tree\" aria-label=\"Waiting for data\" style=\"height: 9rem; flex: 1; min-width: 12rem\"></div>\n  <div\n    class=\"data-tree\"\n    id=\"dt-none\"\n    aria-label=\"No matches\"\n    data-empty-text=\"Nothing matches 'zebra'.\"\n    style=\"height: 9rem; flex: 1; min-width: 12rem\"\n  ></div>\n</div>\n","individual":false}]
