[{"label":"place-items-center on the grid","html":"<div class=\"grid grid-cols-3 gap-2 place-items-center demo-outline\" style=\"grid-auto-rows: 4rem\">\n  <div class=\"demo-tile size-8\"></div>\n  <div class=\"demo-tile size-8\"></div>\n  <div class=\"demo-tile size-8\"></div>\n</div>\n","individual":true},{"label":"justify-self-\\* / place-self-\\* per item","html":"<div class=\"grid grid-cols-3 gap-2 demo-outline\" style=\"grid-auto-rows: 4rem\">\n  <div class=\"demo-tile size-8 justify-self-start\" data-variant=\"accent\"></div>\n  <div class=\"demo-tile size-8 place-self-center\" data-variant=\"accent\"></div>\n  <div class=\"demo-tile size-8 justify-self-end\" data-variant=\"accent\"></div>\n</div>\n","individual":true},{"label":"Grid 3","html":"<div class=\"grid grid-cols-auto gap-4\" style=\"--layout-min: 12rem\" data-demo=\"grid\">\n  <div class=\"demo-tile p-4\" data-variant=\"muted\">Research</div>\n  <div class=\"demo-tile p-4\" data-variant=\"muted\">Design</div>\n  <div class=\"demo-tile p-4\" data-variant=\"muted\">Engineering</div>\n</div>\n","individual":false},{"label":"Grid 4","html":"<div class=\"grid grid-cols-3 gap-4\">\n  <header class=\"col-span-full demo-tile p-2\">Dashboard - col-span-full</header>\n  <aside class=\"demo-tile p-2\" data-variant=\"muted\">Filters</aside>\n  <section class=\"col-span-2 demo-tile p-2\" data-variant=\"accent\">Results - col-span-2</section>\n</div>\n","individual":false},{"label":"Grid 5","html":"<div class=\"stack gap-4\">\n  <div>\n    <p class=\"demo-label\">place-items-center on the grid</p>\n    <div class=\"grid grid-cols-3 gap-2 place-items-center demo-outline\" style=\"grid-auto-rows: 4rem\">\n      <div class=\"demo-tile size-8\"></div>\n      <div class=\"demo-tile size-8\"></div>\n      <div class=\"demo-tile size-8\"></div>\n    </div>\n  </div>\n  <div>\n    <p class=\"demo-label\">justify-self-\\* / place-self-\\* per item</p>\n    <div class=\"grid grid-cols-3 gap-2 demo-outline\" style=\"grid-auto-rows: 4rem\">\n      <div class=\"demo-tile size-8 justify-self-start\" data-variant=\"accent\"></div>\n      <div class=\"demo-tile size-8 place-self-center\" data-variant=\"accent\"></div>\n      <div class=\"demo-tile size-8 justify-self-end\" data-variant=\"accent\"></div>\n    </div>\n  </div>\n</div>\n","individual":false},{"label":"Grid 6","html":"<div class=\"grid grid-cols-2 gap-4\" data-demo=\"subgrid\">\n  <div\n    class=\"grid row-span-3 grid-rows-subgrid\"\n    style=\"border: 1px solid var(--border); border-radius: var(--radius-md)\"\n  >\n    <h3 style=\"margin: 0.75rem; font-size: 1rem\">Card A</h3>\n    <p class=\"text-sm text-muted-foreground\" style=\"margin: 0 0.75rem\"\n      >Short body - its footer still aligns with Card B because the row tracks are shared.</p\n    >\n    <button class=\"btn justify-self-start\" type=\"button\" data-variant=\"outline\" data-size=\"sm\" style=\"margin: 0.75rem\"\n      >Open</button\n    >\n  </div>\n  <div\n    class=\"grid row-span-3 grid-rows-subgrid\"\n    style=\"border: 1px solid var(--border); border-radius: var(--radius-md)\"\n  >\n    <h3 style=\"margin: 0.75rem; font-size: 1rem\">Card B</h3>\n    <p class=\"text-sm text-muted-foreground\" style=\"margin: 0 0.75rem\"\n      >A much longer body that would push a naive footer down. Subgrid keeps both footers on one line.</p\n    >\n    <button class=\"btn justify-self-start\" type=\"button\" data-variant=\"outline\" data-size=\"sm\" style=\"margin: 0.75rem\"\n      >Open</button\n    >\n  </div>\n</div>\n","individual":false},{"label":"Grid 7","html":"<div class=\"grid grid-cols-auto gap-4\" style=\"--layout-min: 10rem\">\n  <article class=\"card\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Getting started</h3>\n      <p class=\"card-description\">Install and render your first component in minutes.</p>\n    </div>\n    <div class=\"card-footer\">\n      <span class=\"badge\" data-variant=\"secondary\">Guide</span>\n    </div>\n  </article>\n  <article class=\"card\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Design tokens</h3>\n      <p class=\"card-description\">One source of truth for color, radius and shadow.</p>\n    </div>\n    <div class=\"card-footer\">\n      <span class=\"badge\" data-variant=\"secondary\">Reference</span>\n    </div>\n  </article>\n  <article class=\"card\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Container queries</h3>\n      <p class=\"card-description\">Components that react to the space they get.</p>\n    </div>\n    <div class=\"card-footer\">\n      <span class=\"badge\" data-variant=\"secondary\">Pattern</span>\n    </div>\n  </article>\n  <article class=\"card\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Theming</h3>\n      <p class=\"card-description\">Drop-in palettes from any tweakcn export.</p>\n    </div>\n    <div class=\"card-footer\">\n      <span class=\"badge\" data-variant=\"secondary\">Guide</span>\n    </div>\n  </article>\n  <article class=\"card\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Grid layouts</h3>\n      <p class=\"card-description\">Intrinsic tracks without breakpoint utilities.</p>\n    </div>\n    <div class=\"card-footer\">\n      <span class=\"badge\" data-variant=\"secondary\">Pattern</span>\n    </div>\n  </article>\n  <article class=\"card\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Dark mode</h3>\n      <p class=\"card-description\">One theme, two palettes, zero flash.</p>\n    </div>\n    <div class=\"card-footer\">\n      <span class=\"badge\" data-variant=\"secondary\">Reference</span>\n    </div>\n  </article>\n</div>\n","individual":false},{"label":"Grid 8","html":"<div class=\"grid grid-cols-12 gap-4\">\n  <header class=\"col-span-full demo-tile h-12\" data-variant=\"secondary\">col-span-full - header</header>\n  <nav class=\"col-span-3 demo-tile h-32\" data-variant=\"muted\">col-span-3 - nav</nav>\n  <main class=\"col-span-6 demo-tile h-32\" data-variant=\"accent\">col-span-6 - main</main>\n  <aside class=\"col-span-3 demo-tile h-32\" data-variant=\"muted\">col-span-3 - aside</aside>\n  <footer class=\"col-span-full demo-tile h-10\" data-variant=\"secondary\">col-span-full - footer</footer>\n</div>\n","individual":false}]
