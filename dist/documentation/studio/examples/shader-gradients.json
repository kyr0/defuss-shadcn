[{"label":"Five colors, drifting","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"mesh-gradient-demo\"\n    data-effect=\"mesh-gradient\"\n    data-colors=\"#ff9a8b #ff6a88 #a18cd1 #6ee7f9 #fbc2eb\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"mesh-gradient-demo\"></div>\n</div>\n","individual":false},{"label":"Dusk in grain","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"grain-gradient-demo\"\n    data-effect=\"grain-gradient\"\n    data-colors=\"#120a2a #5b2bd6 #ff6b9a #ffd27a\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"grain-gradient-demo\"></div>\n</div>\n","individual":false},{"label":"Marbled lava","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"warp-demo\"\n    data-effect=\"warp\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"warp-demo\"></div>\n</div>\n","individual":false},{"label":"A rose network","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"neuro-noise-demo\"\n    data-effect=\"neuro-noise\"\n    data-colors=\"#ff2d75 #ffb3c8 #ffffff\"\n    data-background=\"#0d0410\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"neuro-noise-demo\"></div>\n</div>\n","individual":false},{"label":"A scene and a photo, dithered","html":"<div class=\"grid gap-3\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    data-effect=\"dithering\"\n    data-colors=\"#0b132b #3a506b #5bc0be #f6f7eb\"\n    aria-hidden=\"true\"\n    style=\"border-radius: var(--radius)\"\n  ></div>\n  <div\n    class=\"shader\"\n    id=\"dithering-demo\"\n    data-effect=\"dithering\"\n    data-interactive\n    data-pixel=\"2\"\n    data-colors=\"#2b1d0e #ffe8c2\"\n    style=\"border-radius: var(--radius)\"\n  >\n    <img\n      src=\"https://picsum.photos/id/1043/800/500\"\n      alt=\"A rocky coast\"\n      crossorigin=\"anonymous\"\n      width=\"800\"\n      height=\"500\"\n    />\n  </div>\n  <div class=\"shader-controls\" data-shader-for=\"dithering-demo\"></div>\n</div>\n","individual":false},{"label":"Sine waves through a palette","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"plasma-demo\"\n    data-effect=\"plasma\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"plasma-demo\"></div>\n</div>\n","individual":false},{"label":"Folds of silk","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"silk-demo\"\n    data-effect=\"silk\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"silk-demo\"></div>\n</div>\n","individual":false},{"label":"Veined stone","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"marble-demo\"\n    data-effect=\"marble\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"marble-demo\"></div>\n</div>\n","individual":false},{"label":"An oil slick","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"oil-demo\"\n    data-effect=\"oil\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"oil-demo\"></div>\n</div>\n","individual":false}]
