ne\"></li>\n    <li class=\"diagram-edge\" data-from=\"s1\" data-to=\"s2\" data-curve=\"straight\" data-tone=\"accent\" data-head=\"none\"></li>\n    <li class=\"diagram-edge\" data-from=\"s2\" data-to=\"s3\" data-curve=\"straight\" data-tone=\"accent\" data-head=\"none\"></li>\n    <li class=\"diagram-edge\" data-from=\"s3\" data-to=\"s4\" data-curve=\"straight\" data-tone=\"ink\" data-head=\"none\"></li>\n  </ol>\n  <ul class=\"diagram-legend\">\n    <li data-swatch=\"accent-line\">Sentiment</li>\n    <li data-swatch=\"dot\">Stage feeling</li>\n    <li data-swatch=\"warn\">Pain point</li>\n  </ul>\n</figure>\n","individual":false},{"label":"User Journey, inspect and edit","html":"<div class=\"flex items-center gap-2 mb-3\">\n  <button type=\"button\" class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-panel-toggle=\"dg-journey-edit-panel\"\n    ><i data-lucide=\"panel-right\"></i> Inspector</button\n  >\n  <span class=\"text-sm text-muted-foreground\">Click a box or an arrow, then edit it.</span>\n</div>\n<div class=\"flex flex-col gap-3\">\n  <div style=\"flex: 1 1 0; min-width: 0\">\n    <figure\n      class=\"diagram\"\n      id=\"dg-journey-edit\"\n      data-interactive\n      data-type=\"journey\"\n      aria-label=\"User journey of a new analytics customer\"\n    >\n      <figcaption class=\"diagram-caption\">\n        <span class=\"diagram-eyebrow\">User journey</span>\n        <span class=\"diagram-title\">The first month of a new customer</span>\n        <span class=\"diagram-dek\">The dip at onboarding is the finding - two pain points, one stage.</span>\n      </figcaption>\n      <div class=\"diagram-canvas\" style=\"--cols: 5; --band: 8rem\">\n        <div class=\"diagram-cell\" data-role=\"head\" style=\"--col: 2; --row: 1\"\n          ><span class=\"diagram-cell-eyebrow\">Stage 1</span>Discover</div\n        >\n        <div class=\"diagram-cell\" data-role=\"head\" style=\"--col: 3; --row: 1\"\n          ><span class=\"diagram-cell-eyebrow\">Stage 2</span>Sign up</div\n        >\n        <div class=\"diagram-cell\" data-role=\"head\" style=\"--col: 4; --row: 1\"\n          ><span class=\"diagram-cell-eyebrow\">Stage 3</span>Onboard</div\n        >\n        <div class=\"diagram-cell\" data-role=\"head\" style=\"--col: 5; --row: 1\"\n          ><span class=\"diagram-cell-eyebrow\">Stage 4</span>First value</div\n        >\n        <div class=\"diagram-cell\" data-role=\"head\" style=\"--col: 6; --row: 1\"\n          ><span class=\"diagram-cell-eyebrow\">Stage 5</span>Renew</div\n        >\n        <div class=\"diagram-band-labels\" style=\"--col: 1; --row: 2\"\n          ><span>High</span><span>Neutral</span><span>Low</span></div\n        >\n        <div class=\"diagram-band\" style=\"--col: 2; --row: 2; --span: 5\"></div>\n        <div class=\"diagram-node\" data-node=\"s0\" data-shape=\"dot\" style=\"--col: 2; --row: 2; --sentiment: 0.72\"\n          ><span class=\"diagram-node-name\">curious</span></div\n        >\n        <div class=\"diagram-node\" data-node=\"s1\" data-shape=\"dot\" style=\"--col: 3; --row: 2; --sentiment: 0.55\"\n          ><span class=\"diagram-node-name\">hopeful</span></div\n        >\n        <div\n          class=\"diagram-node\"\n          data-node=\"s2\"\n          data-shape=\"dot\"\n          data-tone=\"accent\"\n          style=\"--col: 4; --row: 2; --sentiment: 0.15\"\n          ><span class=\"diagram-node-name\">lost</span></div\n        >\n        <div class=\"diagram-node\" data-node=\"s3\" data-shape=\"dot\" style=\"--col: 5; --row: 2; --sentiment: 0.6\"\n          ><span class=\"diagram-node-name\">relieved</span></div\n        >\n        <div class=\"diagram-node\" data-node=\"s4\" data-shape=\"dot\" style=\"--col: 6; --row: 2; --sentiment: 0.85\"\n          ><span class=\"diagram-node-name\">loyal</span></div\n        >\n        <div class=\"diagram-cell\" data-role=\"label\" style=\"--col: 1; --row: 3\">Actions</div>\n        <div class=\"diagram-cell\" data-role=\"center\" style=\"--col: 2; --row: 3\">Reads a comparison post</div>\n        <div class=\"diagram-cell\" data-role=\"center\" style=\"--col: 3; --row: 3\">Signs up with Google</div>\n        <div class=\"diagram-cell\" data-role=\"center\" style=\"--col: 4; --row: 3\">Imports data, hits errors</div>\n        <div class=\"diagram-cell\" data-role=\"center\" style=\"--col: 5; --row: 3\">Shares the first report</div>\n        <div class=\"diagram-cell\" data-role=\"center\" style=\"--col: 6; --row: 3\">Upgrades to annual</div>\n        <div class=\"diagram-cell\" data-role=\"label\" style=\"--col: 1; --row: 4\">Touchpoints</div>\n        <div class=\"diagram-cell\" data-role=\"mono\" style=\"--col: 2; --row: 4\">blog · search</div>\n        <div class=\"diagram-cell\" data-role=\"mono\" style=\"--col: 3; --row: 4\">web app</div>\n        <div class=\"diagram-cell\" data-role=\"mono\" style=\"--col: 4; --row: 4\">importer · docs</div>\n        <div class=\"diagram-cell\" data-role=\"mono\" style=\"--col: 5; --row: 4\">email · Slack</div>\n        <div class=\"diagram-cell\" data-role=\"mono\" style=\"--col: 6; --row: 4\">billing</div>\n        <div class=\"diagram-cell\" data-role=\"label\" style=\"--col: 1; --row: 5\">Pain</div>\n        <span class=\"diagram-tag\" style=\"--col: 4; --row: 5\">CSV errors unexplained</span>\n        <span class=\"diagram-tag\" style=\"--col: 4; --row: 6\">no sample data</span>\n      </div>\n      <ol class=\"diagram-edges\">\n        <li\n          class=\"diagram-edge\"\n          data-from=\"s0\"\n          data-to=\"s1\"\n          data-curve=\"straight\"\n          data-tone=\"ink\"\n          data-head=\"none\"\n        ></li>\n        <li\n          class=\"diagram-edge\"\n          data-from=\"s1\"\n          data-to=\"s2\"\n          data-curve=\"straight\"\n          data-tone=\"accent\"\n          data-head=\"none\"\n        ></li>\n        <li\n          class=\"diagram-edge\"\n          data-from=\"s2\"\n          data-to=\"s3\"\n          data-curve=\"straight\"\n          data-tone=\"accent\"\n          data-head=\"none\"\n        ></li>\n        <li\n          class=\"diagram-edge\"\n          data-from=\"s3\"\n          data-to=\"s4\"\n          data-curve=\"straight\"\n          data-tone=\"ink\"\n          data-head=\"none\"\n        ></li>\n      </ol>\n      <ul class=\"diagram-legend\">\n        <li data-swatch=\"accent-line\">Sentiment</li>\n        <li data-swatch=\"dot\">Stage feeling</li>\n        <li data-swatch=\"warn\">Pain point</li>\n      </ul>\n    </figure>\n  </div>\n  <section class=\"card panel\" id=\"dg-journey-edit-panel\" aria-labelledby=\"dg-journey-edit-title\" style=\"\">\n    <header class=\"panel-header\">\n      <i data-lucide=\"sliders-horizontal\" class=\"panel-icon\" aria-hidden=\"true\"></i>\n      <h3 class=\"panel-title\" id=\"dg-journey-edit-title\">Inspector</h3>\n      <div class=\"panel-tools\">\n        <button\n          type=\"button\"\n          class=\"btn panel-close\"\n          data-variant=\"ghost\"\n          data-size=\"icon-sm\"\n          aria-label=\"Close Inspector\"\n          ><i data-lucide=\"x\"></i\n        ></button>\n      </div>\n    </header>\n    <div class=\"panel-body\" data-flush>\n      <div\n        class=\"property-grid\"\n        id=\"dg-journey-edit-grid\"\n        data-frame=\"none\"\n        data-empty-text=\"Click a box or an arrow.\"\n        aria-label=\"Selection properties\"\n      ></div>\n    </div>\n  </section>\n</div>\n","individual":false}]
