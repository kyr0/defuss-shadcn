itar\"></div>\n  <div data-fretboard-for=\"fb-guitar\" data-fretboard-outlet=\"chords\"></div>\n</div>\n","individual":false},{"label":"Low G ukulele","html":"<div class=\"grid gap-3\">\n  <div class=\"fretboard\" id=\"fb-low-g\" role=\"group\" aria-label=\"When the Saints Go Marching In\">\n    <div class=\"fretboard-header\">\n      <span class=\"fretboard-title\">When the Saints Go Marching In - low G</span>\n      <button\n        class=\"btn\"\n        data-variant=\"ghost\"\n        data-size=\"icon-sm\"\n        data-fretboard-action=\"toggle\"\n        aria-pressed=\"false\"\n        aria-label=\"Play\"\n        ><i data-lucide=\"play\"></i><i data-lucide=\"pause\"></i\n      ></button>\n      <button class=\"btn\" data-variant=\"ghost\" data-size=\"icon-sm\" data-fretboard-action=\"stop\" aria-label=\"Stop\"\n        ><i data-lucide=\"square\"></i\n      ></button>\n    </div>\n    \n  </div>\n  <div class=\"fretboard-neck\" data-fretboard-for=\"fb-low-g\"></div>\n  <div data-fretboard-for=\"fb-low-g\" data-fretboard-outlet=\"chords\"></div>\n</div>\n","individual":false}]
