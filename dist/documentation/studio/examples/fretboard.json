[{"label":"Fretboard","html":"<div\n  class=\"fretboard\"\n  id=\"fb-twinkle\"\n  role=\"group\"\n  aria-label=\"Twinkle, Twinkle, Little Star\"\n  style=\"--fretboard-height: 17rem\"\n  data-state-demo\n>\n  <div class=\"fretboard-header\">\n    <span class=\"fretboard-title\">Twinkle, Twinkle, Little Star</span>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"icon-sm\"\n      data-fretboard-action=\"toggle\"\n      aria-pressed=\"false\"\n      aria-label=\"Play\"\n      ><i data-lucide=\"play\"></i><i data-lucide=\"pause\"></i\n    ></button>\n    <button class=\"btn\" data-variant=\"ghost\" data-size=\"icon-sm\" data-fretboard-action=\"stop\" aria-label=\"Stop\"\n      ><i data-lucide=\"square\"></i\n    ></button>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"icon-sm\"\n      data-fretboard-action=\"loop\"\n      aria-pressed=\"false\"\n      aria-label=\"Loop\"\n      ><i data-lucide=\"repeat\"></i\n    ></button>\n    <span class=\"fretboard-readout\"\n      ><output data-fretboard-output=\"measure\">1</output> / <output data-fretboard-output=\"measures\">12</output></span\n    >\n    <output class=\"fretboard-readout\" data-fretboard-output=\"time\">0:00</output>\n    <button class=\"btn\" data-variant=\"ghost\" data-size=\"icon-sm\" data-fretboard-action=\"zoom-out\" aria-label=\"Zoom out\"\n      ><i data-lucide=\"zoom-out\"></i\n    ></button>\n    <output class=\"fretboard-readout\" data-fretboard-output=\"zoom\">100%</output>\n    <button class=\"btn\" data-variant=\"ghost\" data-size=\"icon-sm\" data-fretboard-action=\"zoom-in\" aria-label=\"Zoom in\"\n      ><i data-lucide=\"zoom-in\"></i\n    ></button>\n  </div>\n  \n</div>\n","individual":true},{"label":"Lyrics lanes","html":"<div class=\"fretboard\" id=\"fb-jacques\" role=\"group\" aria-label=\"Frère Jacques\">\n  <div class=\"fretboard-header\">\n    <span class=\"fretboard-title\">Frère Jacques</span>\n    <button\n      cla