ace\"\n    id=\"mp-surface\"\n    data-pattern=\"grid\"\n    data-motion=\"drift\"\n    aria-hidden=\"true\"\n    style=\"border-radius: var(--radius)\"\n  ></div>\n</div>\n","individual":false},{"label":"24 shader motions","html":"<div class=\"grid gap-3\" style=\"grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr))\">\n  <figure class=\"m-0 grid gap-1\">\n    <div\n      class=\"shader\"\n      data-effect=\"surface\"\n      data-pattern=\"hex\"\n      data-material=\"bevel\"\n      data-motion=\"drift\"\n      aria-hidden=\"true\"\n      style=\"border-radius: var(--radius)\"\n    ></div>\n    <figcaption class=\"text-xs text-muted-foreground\">drift</figcaption>\n  </figure>\n  <figure class=\"m-0 grid gap-1\">\n    <div\n      class=\"shader\"\n      data-effect=\"surface\"\n      data-pattern=\"checker\"\n      data-material=\"ceramic\"\n      data-motion=\"none\"\n      aria-hidden=\"true\"\n      style=\"border-radius: var(--radius)\"\n    ></div>\n    <figcaption class=\"text-xs text-muted-foreground\">none</figcaption>\n  </figure>\n  <figure class=\"m-0 grid gap-1\">\n    <div\n      class=\"shader\"\n      data-effect=\"surface\"\n      data-pattern=\"dots\"\n      data-material=\"ceramic\"\n      data-motion=\"pulse\"\n      aria-hidden=\"true\"\n      style=\"border-radius: var(--radius)\"\n    ></div>\n    <figcaption class=\"text-xs text-muted-foreground\">pulse</figcaption>\n  </figure>\n  <figure class=\"m-0 grid gap-1\">\n    <div\n      class=\"shader\"\n      data-effect=\"surface\"\n      data-pattern=\"diamonds\"\n      data-material=\"chrome\"\n      data-motion=\"shimmer\"\n      aria-hidden=\"true\"\n      style=\"border-radius: var(--radius)\"\n    ></div>\n    <figcaption class=\"text-xs text-muted-foreground\">shimmer</figcaption>\n  </figure>\n  <figure class=\"m-0 grid gap-1\">\n    <div\n      class=\"shader\"\n      data-effect=\"surface\"\n      data-pattern=\"checker\"\n      data-material=\"glass\"\n      data-motion=\"rip