[{"label":"Swiss International","html":"<section\n  class=\"presentation\"\n  id=\"deck-highlight\"\n  data-anim-in=\"wipeIn\"\n  data-anim-out=\"fadeOut\"\n  style=\"\n    --presentation-ink: #111111;\n    --presentation-ink-foreground: #f4f1e8;\n    --presentation-paper: #f4f1e8;\n    --presentation-paper-foreground: #111111;\n    --presentation-accent: #e6392f;\n    font-family: Arial, Helvetica, sans-serif;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"The commute shift - metro region mobility 2021 to 2026\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Commute modes ranked by growth from 2021 to 2026, e-bike trips up 142 percent, re-ranked by daily volume and shown as a mode-share donut\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Cover\">\n    <svg aria-hidden=\"true\" width=\"520\" height=\"900\" viewBox=\"0 0 520 900\" style=\"position: absolute; right: 0; top: 0\">\n      <rect x=\"170\" y=\"0\" width=\"350\" height=\"350\" fill=\"#E6392F\" />\n      <rect x=\"170\" y=\"380\" width=\"350\" height=\"2\" fill=\"currentColor\" opacity=\"0.35\" />\n      <rect x=\"170\" y=\"420\" width=\"220\" height=\"2\" fill=\"currentColor\" opacity=\"0.35\" />\n    </svg>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\"\n      >Highlight bars · Swiss International</p\n    >\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        position: relative;\n        max-width: 1250px;\n        letter-spacing: -0.035em;\n        font-weight: 700;\n        font-size: 6.5rem;\n        max-width: 1000px;\n      \"\n      >The commute shift, 2021–2026</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >Seven ways to cross the metro region every weekday - one of them more than doubled.</p\n    >\n    <p class=\"presentation-note\">One red block, one red bar: the whole deck spends its color once per slide.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"growth\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Growth ranking\"\n  >\n    <header class=\"presentation-header\"><span>Growth</span><span>Trips per weekday · 2021 → 2026</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        letter-spacing: -0.035em;\n        font-weight: 700;\n      \"\n      >E-bike trips grew +142% - nothing else came close</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">One highlighted bar, six in context. Let the red do the talking.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"decline\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Declines\"\n  >\n    <header class=\"presentation-header\"><span>Growth</span><span>The other end</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        letter-spacing: -0.035em;\n        font-weight: 700;\n      \"\n      >Two modes shrank: cars −9%, taxis −17%</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Same bars, the highlight moves - the story is now the bottom of the list.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"volume\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Volume ranking\"\n  >\n    <header class=\"presentation-header\"><span>Volume</span><span>Trips per weekday, thousands · 2026</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        letter-spacing: -0.035em;\n        font-weight: 700;\n      \"\n      >Growth is not volume: e-bikes still rank fifth</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The bars re-rank in place. Cars still carry four times more trips.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Three numbers for the transport board</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #e6392f;\n            letter-spacing: -0.035em;\n            font-weight: 700;\n          \"\n          >+<span data-count=\"142\">142</span>%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">e-bike trips since 2021</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            letter-spacing: -0.035em;\n            font-weight: 700;\n          \"\n          ><span data-count=\"97\">97</span>k</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">e-bike trips on an average weekday</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            letter-spacing: -0.035em;\n            font-weight: 700;\n          \"\n          >−<span data-count=\"41\">41</span>k</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\"\n          >fewer car trips per weekday than in 2021</p\n        >\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >The shift is real - and still small enough to lose if the lanes stop growing.</p\n    >\n    <p class=\"presentation-note\">Three numbers, then stop talking.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"On the ground\">\n    <header class=\"presentation-header\"><span>On the ground</span><span>Protected lanes since 2023</span></header>\n    <div style=\"display: flex; gap: 4.5rem; align-items: center; margin-top: 3.5rem\">\n      <figure\n        class=\"image\"\n        data-ratio=\"4/3\"\n        data-df-entrance=\"wipe\"\n        style=\"--df-motion-delay: 150ms; flex: 0 0 700px; margin: 0\"\n      >\n        <img\n          src=\"https://picsum.photos/id/76/960/720\"\n          alt=\"A green bicycle leaning against a weathered wooden wall\"\n          loading=\"lazy\"\n          width=\"960\"\n          height=\"720\"\n          style=\"width: 100%; height: 100%; object-fit: cover\"\n        />\n        <figcaption class=\"image-caption\" style=\"font-size: 1.25rem\">Parked for the day (stock photo).</figcaption>\n      </figure>\n      <div style=\"flex: 1 1 0; min-width: 0\">\n        <h2\n          class=\"presentation-title\"\n          data-df-entrance=\"up\"\n          style=\"font-size: 3.4rem; letter-spacing: -0.035em; font-weight: 700\"\n          >Where the lanes went, the bikes followed</h2\n        >\n        <p class=\"presentation-lede\" data-df-entrance=\"fade\" style=\"--df-motion-delay: 300ms; font-size: 1.7rem\"\n          >38 km of kerb-protected lanes opened in 2023. E-bike counts on those corridors tripled within eighteen\n          months.</p\n        >\n      </div>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Infrastructure is the cause; the chart is the effect.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"west\"\n    data-anim-in-blocks=\"5\"\n    data-anim-in-color=\"#E6392F\"\n    aria-label=\"Trips by mode\"\n  >\n    <header class=\"presentation-header\"><span>The data</span><span>Thousands of trips per weekday</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" style=\"font-size: 1.45rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Metro region weekday trips by main mode (synthetic).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Mode</th><th class=\"table-head\" style=\"text-align: right\">2021</th\n            ><th class=\"table-head\" style=\"text-align: right\">2026</th\n            ><th class=\"table-head\" style=\"text-align: right\">Change</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Car</td><td class=\"table-cell\" style=\"text-align: right\">453</td\n            ><td class=\"table-cell\" style=\"text-align: right\">412</td\n            ><td class=\"table-cell\" style=\"text-align: right\">−9%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Tram</td><td class=\"table-cell\" style=\"text-align: right\">176</td\n            ><td class=\"table-cell\" style=\"text-align: right\">236</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+34%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Walking</td><td class=\"table-cell\" style=\"text-align: right\">155</td\n            ><td class=\"table-cell\" style=\"text-align: right\">188</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+21%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Bus</td><td class=\"table-cell\" style=\"text-align: right\">126</td\n            ><td class=\"table-cell\" style=\"text-align: right\">141</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+12%</td></tr\n          >\n          <tr class=\"table-row\" style=\"font-weight: 700\"\n            ><td class=\"table-cell\">E-bike</td><td class=\"table-cell\" style=\"text-align: right\">40</td\n            ><td class=\"table-cell\" style=\"text-align: right\">97</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+142%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Taxi & ride-hail</td><td class=\"table-cell\" style=\"text-align: right\">37</td\n            ><td class=\"table-cell\" style=\"text-align: right\">31</td\n            ><td class=\"table-cell\" style=\"text-align: right\">−17%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Cargo bike</td><td class=\"table-cell\" style=\"text-align: right\">10</td\n            ><td class=\"table-cell\" style=\"text-align: right\">18</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+88%</td></tr\n          >\n        </tbody>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The table is for the follow-up email; the chart is for the room.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"font-size: 3.3rem; line-height: 1.22; letter-spacing: -0.035em; font-weight: 700\"\n        >“The e-bike line went vertical the year the protected lanes opened. Paint did nothing; kerbs did\n        everything.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #e6392f; color: #f4f1e8\"\n        ><span class=\"avatar-fallback\">LB</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Lena Brandt<br /><span style=\"opacity: 0.7; font-size: 1.4rem\"\n          >Head of mobility planning - 14 years on the network</span\n        ></p\n      >\n    </div>\n    <p class=\"presentation-note\">Let the quote land before the donut.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"share\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Mode share\"\n  >\n    <header class=\"presentation-header\"><span>Mode share</span><span>1.12 M trips per weekday · 2026</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        letter-spacing: -0.035em;\n        font-weight: 700;\n      \"\n      >Cars still take 37% of all trips</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The same seven names, now as shares of the whole weekday.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Questions from the council\"\n  >\n    <header class=\"presentation-header\"><span>Q & A</span><span>Transport committee</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"font-size: 3.2rem; margin-block: 5.25rem 1.5rem; letter-spacing: -0.035em; font-weight: 700\"\n      >Questions from the council</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"hb-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Did cars shrink because people moved away?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >No - the region grew 3% over the period; car trips fell while total trips rose from 997k to 1.12 M.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"hb-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Is cargo-bike growth just delivery firms?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >About half: 9k of the 18k daily trips are commercial deliveries, the rest are families.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"hb-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>What would another 40 km of lanes buy?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >On the 2023 pattern, roughly 50k more e-bike trips per weekday by 2030.</p\n          ></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">One answer open at a time keeps the room on one question.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Takeaways</span><span>For the 2027 plan</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">■</span\n        ><span>Build lanes where the e-bike growth already is - the demand is proven.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">■</span\n        ><span>Tram capacity is next: +60k trips in five years is a full line.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">■</span\n        ><span>Car trips fell 9% without a single restriction.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">■</span\n        ><span>Measure volume and growth together - either alone misleads.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Read them once, then open the discussion.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"north\"\n    data-anim-in-blocks=\"4\"\n    data-anim-in-color=\"#E6392F\"\n    aria-label=\"Closing\"\n  >\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        letter-spacing: -0.035em;\n        font-weight: 700;\n      \"\n      >One red bar. One decision.</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px\"\n      >Synthetic data for a fictional metro region - the pattern is real: highlight the answer, mute the context.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">End on the design rule, not the data.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 12</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"12\" value=\"1\"></progress>\n</section>\n","individual":false}]
