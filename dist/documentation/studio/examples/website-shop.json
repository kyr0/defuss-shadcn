[{"label":"A store and its checkout","html":"<div style=\"display: flex; flex-direction: column; gap: 4rem; width: 100%\">\n  <article class=\"mk-collection-item\" data-variant=\"banner\">\n    <img class=\"mk-collection-item-media\" src=\"https://picsum.photos/seed/col-banner/1600/690\" alt=\"\" />\n    <div class=\"mk-collection-item-body\">\n      <h3 class=\"mk-collection-item-title\"><a href=\"#\">The autumn edit</a></h3>\n      <p class=\"mk-collection-item-count\">Warm layers, soft colors - 56 pieces</p>\n      <span class=\"mk-collection-item-more\" aria-hidden=\"true\">Discover <i data-lucide=\"arrow-right\"></i></span>\n    </div>\n  </article>\n  <div\n    style=\"display: grid; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); gap: 2rem 1.25rem; width: 100%\"\n  >\n    <article class=\"mk-product-item\">\n      <div class=\"mk-product-item-media\">\n        <img class=\"mk-product-item-image\" src=\"https://picsum.photos/seed/prod-shirt/600/750\" alt=\"\" />\n        <img class=\"mk-product-item-image\" data-hover src=\"https://picsum.photos/seed/prod-shirt-b/600/750\" alt=\"\" />\n        <span class=\"badge mk-product-item-badge\" data-variant=\"default\" data-sale>−20%</span>\n        <label class=\"mk-product-item-wish\"\n          ><input type=\"checkbox\" name=\"wish\" value=\"p1\" /><i data-lucide=\"heart\"></i\n          ><span class=\"sr-only\">Save Linen shirt to your wishlist</span></label\n        >\n      </div>\n      <div class=\"mk-product-item-body\">\n        <h3 class=\"mk-product-item-name\"><a href=\"#\">Linen shirt</a></h3>\n        <p class=\"mk-product-item-desc\">Relaxed fit · Sand</p>\n        <p class=\"mk-product-item-rating\"\n          ><span class=\"mk-product-item-stars\" style=\"--mk-rating: 4.5\" role=\"img\" aria-label=\"4.5 out of 5 stars\"\n            >★★★★★</span\n          >(128)</p\n        >\n        <p class=\"mk-product-item-price\"\n          ><strong>€64</strong> <del><span class=\"sr-only\">was </span>€80</del></p\n        >\n        <ul class=\"mk-product-item-swatches\" aria-label=\"Colors\"\n          ><li style=\"--mk-swatch: #d8c9a9\" aria-current=\"true\"><span class=\"sr-only\">Sand</span></li\n          ><li style=\"--mk-swatch: #2f3b4a\"><span class=\"sr-only\">Navy</span></li\n          ><li style=\"--mk-swatch: #f2efe8\"><span class=\"sr-only\">Off-white</span></li></ul\n        >\n      </div>\n      <button class=\"btn mk-product-item-add\" type=\"button\" data-size=\"sm\" aria-label=\"Add Linen shirt to cart\"\n        ><i data-lucide=\"shopping-bag\"></i> Add to cart</button\n      >\n    </article>\n    <article class=\"mk-product-item\">\n      <div class=\"mk-product-item-media\">\n        <img class=\"mk-product-item-image\" src=\"https://picsum.photos/seed/prod-mug/600/750\" alt=\"\" />\n        <img class=\"mk-product-item-image\" data-hover src=\"https://picsum.photos/seed/prod-mug-b/600/750\" alt=\"\" />\n        <span class=\"badge mk-product-item-badge\" data-variant=\"default\">New</span>\n        <label class=\"mk-product-item-wish\"\n          ><input type=\"checkbox\" name=\"wish\" value=\"p2\" /><i data-lucide=\"heart\"></i\n          ><span class=\"sr-only\">Save Stoneware mug to your wishlist</span></label\n        >\n      </div>\n      <div class=\"mk-product-item-body\">\n        <h3 class=\"mk-product-item-name\"><a href=\"#\">Stoneware mug</a></h3>\n        <p class=\"mk-product-item-desc\">Handmade · 350 ml</p>\n        <p class=\"mk-product-item-rating\"\n          ><span class=\"mk-product-item-stars\" style=\"--mk-rating: 4.9\" role=\"img\" aria-label=\"4.9 out of 5 stars\"\n            >★★★★★</span\n          >(412)</p\n        >\n        <p class=\"mk-product-item-price\"><strong>€22</strong></p>\n        <ul class=\"mk-product-item-swatches\" aria-label=\"Colors\"\n          ><li style=\"--mk-swatch: #c9b49a\" aria-current=\"true\"><span class=\"sr-only\">Oat</span></li\n          ><li style=\"--mk-swatch: #5a6b5d\"><span class=\"sr-only\">Moss</span></li></ul\n        >\n      </div>\n      <button class=\"btn mk-product-item-add\" type=\"button\" data-size=\"sm\" aria-label=\"Add Stoneware mug to cart\"\n        ><i data-lucide=\"shopping-bag\"></i> Add to cart</button\n      >\n    </article>\n    <article class=\"mk-product-item\">\n      <div class=\"mk-product-item-media\">\n        <img class=\"mk-product-item-image\" src=\"https://picsum.photos/seed/prod-bag/600/750\" alt=\"\" />\n        <img class=\"mk-product-item-image\" data-hover src=\"https://picsum.photos/seed/prod-bag-b/600/750\" alt=\"\" />\n        <label class=\"mk-product-item-wish\"\n          ><input type=\"checkbox\" name=\"wish\" value=\"p3\" /><i data-lucide=\"heart\"></i\n          ><span class=\"sr-only\">Save Canvas tote to your wishlist</span></label\n        >\n      </div>\n      <div class=\"mk-product-item-body\">\n        <h3 class=\"mk-product-item-name\"><a href=\"#\">Canvas tote</a></h3>\n        <p class=\"mk-product-item-desc\">Organic cotton</p>\n        <p class=\"mk-product-item-rating\"\n          ><span class=\"mk-product-item-stars\" style=\"--mk-rating: 4.2\" role=\"img\" aria-label=\"4.2 out of 5 stars\"\n            >★★★★★</span\n          >(57)</p\n        >\n        <p class=\"mk-product-item-price\"><strong>€38</strong></p>\n      </div>\n      <button class=\"btn mk-product-item-add\" type=\"button\" data-size=\"sm\" aria-label=\"Add Canvas tote to cart\"\n        ><i data-lucide=\"shopping-bag\"></i> Add to cart</button\n      >\n    </article>\n  </div>\n  <div\n    style=\"\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));\n      gap: 2rem;\n      align-items: start;\n    \"\n  >\n    <ul class=\"mk-cart-list\" aria-label=\"Cart, 2 items\">\n      <li class=\"mk-cart-item\">\n        <img class=\"mk-cart-item-image\" src=\"https://picsum.photos/seed/prod-shirt/240/300\" alt=\"\" />\n        <div class=\"mk-cart-item-info\">\n          <h3 class=\"mk-cart-item-name\"><a href=\"#\">Linen shirt</a></h3>\n          <p class=\"mk-cart-item-options\">Sand · Size M</p>\n          <p class=\"mk-cart-item-unit\">€64.00 each</p>\n        </div>\n        <div class=\"mk-cart-item-qty\">\n          <label class=\"sr-only\" for=\"ci-1-qty\">Quantity of Linen shirt</label>\n          <div class=\"number-input\"\n            ><button type=\"button\" data-action=\"decrement\" aria-label=\"Decrease quantity of Linen shirt\">−</button\n            ><input type=\"number\" id=\"ci-1-qty\" name=\"qty\" min=\"0\" max=\"10\" value=\"1\" inputmode=\"numeric\" /><button\n              type=\"button\"\n              data-action=\"increment\"\n              aria-label=\"Increase quantity of Linen shirt\"\n              >+</button\n            ></div\n          >\n        </div>\n        <output class=\"mk-cart-item-total\" for=\"ci-1-qty\">€64.00</output>\n        <button class=\"mk-cart-item-remove\" type=\"button\" aria-label=\"Remove Linen shirt from cart\"\n          ><i data-lucide=\"x\"></i\n        ></button>\n      </li>\n      <li class=\"mk-cart-item\">\n        <img class=\"mk-cart-item-image\" src=\"https://picsum.photos/seed/prod-mug/240/300\" alt=\"\" />\n        <div class=\"mk-cart-item-info\">\n          <h3 class=\"mk-cart-item-name\"><a href=\"#\">Stoneware mug</a></h3>\n          <p class=\"mk-cart-item-options\">Oat · 350 ml</p>\n          <p class=\"mk-cart-item-unit\">€22.00 each</p>\n        </div>\n        <div class=\"mk-cart-item-qty\">\n          <label class=\"sr-only\" for=\"ci-2-qty\">Quantity of Stoneware mug</label>\n          <div class=\"number-input\"\n            ><button type=\"button\" data-action=\"decrement\" aria-label=\"Decrease quantity of Stoneware mug\">−</button\n            ><input type=\"number\" id=\"ci-2-qty\" name=\"qty\" min=\"0\" max=\"10\" value=\"2\" inputmode=\"numeric\" /><button\n              type=\"button\"\n              data-action=\"increment\"\n              aria-label=\"Increase quantity of Stoneware mug\"\n              >+</button\n            ></div\n          >\n        </div>\n        <output class=\"mk-cart-item-total\" for=\"ci-2-qty\">€44.00</output>\n        <button class=\"mk-cart-item-remove\" type=\"button\" aria-label=\"Remove Stoneware mug from cart\"\n          ><i data-lucide=\"x\"></i\n        ></button>\n      </li>\n    </ul>\n    <aside class=\"mk-cart-summary\" aria-labelledby=\"cs-title\" style=\"max-width: 24rem\">\n      <h2 class=\"mk-cart-summary-title\" id=\"cs-title\">Order summary</h2>\n      <div class=\"mk-cart-summary-shipping\"\n        ><label for=\"cs-free\">Add <strong>€16.00</strong> more for free shipping</label\n        ><progress class=\"progress\" id=\"cs-free\" value=\"84\" max=\"100\">84%</progress></div\n      >\n      <dl class=\"mk-cart-summary-lines\">\n        <div><dt>Subtotal (3 items)</dt><dd>€108.00</dd></div>\n        <div data-discount><dt>Discount · AUTUMN30</dt><dd>−€24.00</dd></div>\n        <div><dt>Shipping</dt><dd>€4.90</dd></div>\n        <div><dt>VAT (included)</dt><dd>€16.62</dd></div>\n      </dl>\n      <div class=\"mk-cart-summary-total\"\n        ><span>Total<small>incl. VAT</small></span\n        ><output aria-live=\"polite\">€88.90</output></div\n      >\n      <a class=\"btn mk-cart-summary-checkout\" data-size=\"lg\" href=\"#\">Checkout <i data-lucide=\"arrow-right\"></i></a>\n      <ul class=\"mk-cart-summary-pay\" aria-label=\"We accept\"\n        ><li>VISA</li\n        ><li>MASTERCARD</li\n        ><li>PAYPAL</li\n        ><li>APPLE PAY</li\n        ><li>KLARNA</li></ul\n      >\n      <p class=\"mk-cart-summary-note\"><i data-lucide=\"lock\"></i> Secure checkout · 30-day returns</p>\n    </aside>\n  </div>\n  <div\n    style=\"\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));\n      gap: 2rem;\n      align-items: start;\n    \"\n  >\n    <div style=\"display: grid; gap: 2rem\">\n      <fieldset class=\"mk-address-form\">\n        <legend>Shipping address</legend>\n        <div class=\"mk-address-form-grid\">\n          <div class=\"mk-address-form-field\"\n            ><label class=\"label\" for=\"ad-country\">Country / region</label\n            ><select class=\"select\" id=\"ad-country\" name=\"country\" autocomplete=\"country\"\n              ><option value=\"PT\">Portugal</option\n              ><option value=\"DE\">Germany</option\n              ><option value=\"FR\">France</option></select\n            ></div\n          >\n          <div class=\"mk-address-form-field\" data-span=\"4\"\n            ><label class=\"label\" for=\"ad-name\">Full name</label\n            ><input class=\"input\" id=\"ad-name\" name=\"name\" autocomplete=\"shipping name\" required\n          /></div>\n          <div class=\"mk-address-form-field\" data-span=\"2\"\n            ><label class=\"label\" for=\"ad-org\">Company <small>(optional)</small></label\n            ><input class=\"input\" id=\"ad-org\" name=\"organization\" autocomplete=\"shipping organization\"\n          /></div>\n          <div class=\"mk-address-form-field\"\n            ><label class=\"label\" for=\"ad-l1\">Street and number</label\n            ><input class=\"input\" id=\"ad-l1\" name=\"address1\" autocomplete=\"shipping address-line1\" required\n          /></div>\n          <div class=\"mk-address-form-field\"\n            ><label class=\"label\" for=\"ad-l2\">Apartment, floor <small>(optional)</small></label\n            ><input class=\"input\" id=\"ad-l2\" name=\"address2\" autocomplete=\"shipping address-line2\"\n          /></div>\n          <div class=\"mk-address-form-field\" data-span=\"2\"\n            ><label class=\"label\" for=\"ad-zip\">Postal code</label\n            ><input class=\"input\" id=\"ad-zip\" name=\"postal\" autocomplete=\"shipping postal-code\" required\n          /></div>\n          <div class=\"mk-address-form-field\" data-span=\"4\"\n            ><label class=\"label\" for=\"ad-city\">City</label\n            ><input class=\"input\" id=\"ad-city\" name=\"city\" autocomplete=\"shipping address-level2\" required\n          /></div>\n          <div class=\"mk-address-form-field\" data-span=\"3\"\n            ><label class=\"label\" for=\"ad-tel\">Phone <small>(for the courier)</small></label\n            ><input class=\"input\" id=\"ad-tel\" type=\"tel\" name=\"tel\" autocomplete=\"shipping tel\" inputmode=\"tel\"\n          /></div>\n          <div class=\"mk-address-form-field\" data-span=\"3\"\n            ><label class=\"label\" for=\"ad-mail\">Email</label\n            ><input class=\"input\" id=\"ad-mail\" type=\"email\" name=\"email\" autocomplete=\"email\" required\n          /></div>\n        </div>\n        <div class=\"mk-address-form-same\"\n          ><input class=\"checkbox\" type=\"checkbox\" id=\"ad-same\" name=\"billing-same\" checked /><label for=\"ad-same\"\n            >Billing address is the same</label\n          ></div\n        >\n      </fieldset>\n      <fieldset class=\"mk-delivery-options\" style=\"max-width: 34rem\">\n        <legend>Delivery</legend>\n        <label class=\"mk-delivery-options-option\" for=\"dl-std\">\n          <input class=\"radio\" type=\"radio\" name=\"delivery\" id=\"dl-std\" value=\"dl-std\" checked required />\n          <span class=\"mk-delivery-options-icon\" aria-hidden=\"true\"><i data-lucide=\"truck\"></i></span>\n          <span class=\"mk-delivery-options-text\"\n            ><strong>Standard</strong><small>Arrives <time datetime=\"2026-10-07\">Tue 7 – Thu 9 Oct</time></small></span\n          >\n          <b class=\"mk-delivery-options-price\">Free</b>\n        </label>\n        <label class=\"mk-delivery-options-option\" for=\"dl-exp\">\n          <input class=\"radio\" type=\"radio\" name=\"delivery\" id=\"dl-exp\" value=\"dl-exp\" required />\n          <span class=\"mk-delivery-options-icon\" aria-hidden=\"true\"><i data-lucide=\"zap\"></i></span>\n          <span class=\"mk-delivery-options-text\"\n            ><strong>Express</strong><small>Arrives <time datetime=\"2026-10-03\">tomorrow, Fri 3 Oct</time></small></span\n          >\n          <b class=\"mk-delivery-options-price\">€9.90</b>\n        </label>\n        <label class=\"mk-delivery-options-option\" for=\"dl-pick\">\n          <input class=\"radio\" type=\"radio\" name=\"delivery\" id=\"dl-pick\" value=\"dl-pick\" required />\n          <span class=\"mk-delivery-options-icon\" aria-hidden=\"true\"><i data-lucide=\"store\"></i></span>\n          <span class=\"mk-delivery-options-text\"\n            ><strong>Pick up in store</strong><small>Arrives <time datetime=\"2026-10-02\">today after 16:00</time></small\n            ><small>Acme Lisbon · Rua da Prata 120</small></span\n          >\n          <b class=\"mk-delivery-options-price\">Free</b>\n        </label>\n      </fieldset>\n      <form action=\"#\" method=\"post\">\n        <fieldset class=\"mk-payment-form\">\n          <legend>Payment</legend>\n          <div class=\"mk-payment-form-methods\">\n            <label\n              ><input type=\"radio\" name=\"method\" value=\"card\" checked /><i data-lucide=\"credit-card\"></i>Card</label\n            >\n            <label><input type=\"radio\" name=\"method\" value=\"paypal\" /><i data-lucide=\"wallet\"></i>PayPal</label>\n            <label><input type=\"radio\" name=\"method\" value=\"bank\" /><i data-lucide=\"landmark\"></i>Bank transfer</label>\n          </div>\n          <div class=\"mk-payment-form-panel\" data-method=\"card\">\n            <div class=\"mk-payment-form-fields\">\n              <div class=\"mk-payment-form-field mk-payment-form-number\" data-span=\"full\"\n                ><label class=\"label\" for=\"pf-num\">Card number</label\n                ><div class=\"mk-payment-form-number\"\n                  ><input\n                    class=\"input\"\n                    id=\"pf-num\"\n                    name=\"cc-number\"\n                    autocomplete=\"cc-number\"\n                    inputmode=\"numeric\"\n                    pattern=\"[0-9 ]{13,23}\"\n                    placeholder=\"1234 1234 1234 1234\"\n                  /><ul aria-hidden=\"true\"\n                    ><li>VISA</li\n                    ><li>MC</li\n                    ><li>AMEX</li></ul\n                  ></div\n                ></div\n              >\n              <div class=\"mk-payment-form-field\"\n                ><label class=\"label\" for=\"pf-exp\">Expiry</label\n                ><input\n                  class=\"input\"\n                  id=\"pf-exp\"\n                  name=\"cc-exp\"\n                  autocomplete=\"cc-exp\"\n                  inputmode=\"numeric\"\n                  placeholder=\"MM / YY\"\n              /></div>\n              <div class=\"mk-payment-form-field\"\n                ><label class=\"label\" for=\"pf-cvc\">Security code</label\n                ><input\n                  class=\"input\"\n                  id=\"pf-cvc\"\n                  name=\"cc-csc\"\n                  autocomplete=\"cc-csc\"\n                  inputmode=\"numeric\"\n                  maxlength=\"4\"\n                  placeholder=\"CVC\"\n              /></div>\n              <div class=\"mk-payment-form-field\" data-span=\"full\"\n                ><label class=\"label\" for=\"pf-name\">Name on card</label\n                ><input class=\"input\" id=\"pf-name\" name=\"cc-name\" autocomplete=\"cc-name\"\n              /></div>\n            </div>\n            <div class=\"checkbox-item\"\n              ><input class=\"checkbox\" type=\"checkbox\" id=\"pf-save\" name=\"save\" /><label for=\"pf-save\"\n                >Save this card for next time</label\n              ></div\n            >\n          </div>\n          <div class=\"mk-payment-form-panel\" data-method=\"paypal\"\n            ><p>You will be sent to PayPal to approve the payment, then back here to confirm.</p></div\n          >\n          <div class=\"mk-payment-form-panel\" data-method=\"bank\">\n            <p>Transfer the total within 7 days. Your order ships when the money arrives.</p>\n            <dl\n              ><div><dt>IBAN</dt><dd>PT50 0002 0123 1234 5678 9015 4</dd></div\n              ><div><dt>Reference</dt><dd>A-20481</dd></div></dl\n            >\n          </div>\n          <button class=\"btn\" data-size=\"lg\" type=\"submit\">Pay €88.90</button>\n          <p class=\"mk-payment-form-note\"\n            ><i data-lucide=\"lock\"></i> Payments are encrypted and processed by our payment provider.</p\n          >\n        </fieldset>\n      </form>\n    </div>\n    <aside class=\"mk-order-summary\" aria-labelledby=\"os-title\">\n      <h2 class=\"mk-order-summary-title\" id=\"os-title\">Your order</h2>\n      <ul class=\"mk-order-summary-items\">\n        <li\n          ><span class=\"mk-order-summary-thumb\"\n            ><img src=\"https://picsum.photos/seed/prod-shirt/160/200\" alt=\"\" /><b aria-label=\"Quantity 1\">1</b></span\n          ><span class=\"mk-order-summary-name\">Linen shirt<small>Sand · M</small></span\n          ><span class=\"mk-order-summary-price\">€64.00</span></li\n        >\n        <li\n          ><span class=\"mk-order-summary-thumb\"\n            ><img src=\"https://picsum.photos/seed/prod-mug/160/200\" alt=\"\" /><b aria-label=\"Quantity 2\">2</b></span\n          ><span class=\"mk-order-summary-name\">Stoneware mug<small>Oat</small></span\n          ><span class=\"mk-order-summary-price\">€44.00</span></li\n        >\n      </ul>\n      <dl class=\"mk-order-summary-totals\">\n        <div><dt>Subtotal</dt><dd>€108.00</dd></div>\n        <div data-discount><dt>Discount (AUTUMN30)</dt><dd>−€24.00</dd></div>\n        <div><dt>Shipping · Standard</dt><dd>€4.90</dd></div>\n        <div data-total\n          ><dt>Total <small>incl. €16.62 VAT</small></dt\n          ><dd>€88.90</dd></div\n        >\n      </dl>\n    </aside>\n  </div>\n  <section class=\"mk-order-confirmation\" role=\"status\" aria-labelledby=\"oc-title\">\n    <svg class=\"mk-order-confirmation-check\" viewBox=\"0 0 48 48\" aria-hidden=\"true\">\n      <circle cx=\"24\" cy=\"24\" r=\"22\" />\n      <path d=\"m14 25 7 7 13-15\" />\n    </svg>\n    <h1 class=\"mk-order-confirmation-title\" id=\"oc-title\">Thank you, Anna!</h1>\n    <p class=\"mk-order-confirmation-lead\"\n      >Your order <code>A-20481</code> is confirmed. We sent the details to anna@example.com.</p\n    >\n    <dl class=\"mk-order-confirmation-details\">\n      <div\n        ><dt>Order date</dt><dd><time datetime=\"2026-10-01T14:32\">1 October 2026, 14:32</time></dd></div\n      >\n      <div><dt>Payment</dt><dd>Visa •••• 4242 · €88.90</dd></div>\n      <div\n        ><dt>Delivery to</dt\n        ><dd\n          ><address>Anna Silva<br />Rua da Prata 120, 2º<br />1100-420 Lisboa</address></dd\n        ></div\n      >\n      <div\n        ><dt>Estimated delivery</dt\n        ><dd><time datetime=\"2026-10-07\">Tue 7</time> – <time datetime=\"2026-10-09\">Thu 9 October</time></dd></div\n      >\n    </dl>\n    <ol class=\"mk-order-confirmation-steps\" aria-label=\"What happens next\">\n      <li\n        ><div>We pack your order <span>- usually within a day.</span></div></li\n      >\n      <li\n        ><div>You get a tracking link <span>by email when it ships.</span></div></li\n      >\n      <li\n        ><div>Not right? <span>Returns are free for 30 days.</span></div></li\n      >\n    </ol>\n    <div class=\"mk-order-confirmation-actions\">\n      <a class=\"btn\" href=\"#\">Track your order</a>\n      <a class=\"btn\" data-variant=\"outline\" href=\"#\">Continue shopping</a>\n    </div>\n  </section>\n  <section class=\"mk-tracking-status\" aria-labelledby=\"ts-title\">\n    <div class=\"mk-tracking-status-head\">\n      <div\n        ><h2 id=\"ts-title\">Estimated arrival</h2><p><time datetime=\"2026-10-02\">Thursday, 2 October</time></p></div\n      >\n      <div class=\"mk-tracking-status-carrier\"\n        ><span>DHL Express</span\n        ><a href=\"#\" target=\"_blank\" rel=\"noopener\"\n          >JD0146 0012 3456<span class=\"sr-only\"> (opens the carrier site)</span></a\n        ></div\n      >\n    </div>\n    <ol class=\"mk-tracking-status-steps\" style=\"--mk-tracking-progress: 66%\">\n      <li data-done\n        ><span class=\"mk-tracking-status-dot\" aria-hidden=\"true\"><i data-lucide=\"check\"></i></span\n        ><strong>Ordered</strong><small>1 Oct, 14:32</small></li\n      >\n      <li data-done\n        ><span class=\"mk-tracking-status-dot\" aria-hidden=\"true\"><i data-lucide=\"check\"></i></span\n        ><strong>Shipped</strong><small>1 Oct, 18:05</small></li\n      >\n      <li aria-current=\"step\"\n        ><span class=\"mk-tracking-status-dot\" aria-hidden=\"true\"></span><strong>Out for delivery</strong\n        ><small>Today, 07:40</small></li\n      >\n      <li\n        ><span class=\"mk-tracking-status-dot\" aria-hidden=\"true\"></span><strong>Delivered</strong\n        ><small>Expected by 18:00</small></li\n      >\n    </ol>\n    <details class=\"mk-tracking-status-log\">\n      <summary>Shipment history</summary>\n      <ol>\n        <li\n          ><time datetime=\"2026-10-02T07:40\">2 Oct, 07:40</time><div>Out for delivery <span>· Lisbon</span></div></li\n        >\n        <li\n          ><time datetime=\"2026-10-02T02:10\">2 Oct, 02:10</time\n          ><div>Arrived at delivery centre <span>· Lisbon</span></div></li\n        >\n        <li\n          ><time datetime=\"2026-10-01T18:05\">1 Oct, 18:05</time><div>Picked up by DHL <span>· Porto</span></div></li\n        >\n      </ol>\n    </details>\n  </section>\n</div>\n","individual":false}]
