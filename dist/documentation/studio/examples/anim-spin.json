[{"label":"In / out and lifecycle","html":"<style>\n  #anim-spin-target {\n    width: 160px;\n    height: 100px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-weight: 600;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    background: var(--card);\n    color: var(--card-foreground);\n  }\n</style>\n<div style=\"display: flex; flex-direction: column; align-items: flex-start; gap: 0.75rem\">\n  <div id=\"anim-spin-target\">Spin me</div>\n  <div id=\"anim-spin-controls\" style=\"display: flex; flex-wrap: wrap; gap: 0.4rem\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-anim=\"in\">In</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-anim=\"out\">Out</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-anim=\"pause\">Pause</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-anim=\"resume\">Resume</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-anim=\"finish\">Finish</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-anim=\"reset\">Reset</button>\n  </div>\n  <div style=\"display: flex; align-items: center; gap: 0.5rem\">\n    <label class=\"label\" for=\"anim-spin-duration\">Duration</label>\n    <input class=\"input\" id=\"anim-spin-duration\" type=\"number\" min=\"50\" step=\"50\" value=\"1500\" style=\"width: 6rem\" />\n    <label class=\"label\" for=\"anim-spin-easing\">Easing</label>\n    <select class=\"select\" id=\"anim-spin-easing\">\n      <option value=\"cubic-bezier(0.16, 1, 0.3, 1)\" selected>default (out-expo)</option>\n      <option value=\"linear\">linear</option>\n      <option value=\"ease-in-out\">ease-in-out</option>\n      <option value=\"cubic-bezier(.34, 1.56, .64, 1)\">spring (overshoot)</option>\n    </select>\n    <span class=\"badge\" data-variant=\"secondary\" id=\"anim-spin-status\">idle</span>\n  </div>\n</div>\n","individual":false},{"label":"Scroll-bound spin","html":"<div\n  id=\"anim-spin-scroller\"\n  style=\"height: 220px; overflow-y: auto; border: 1px solid var(--border); border-radius: var(--radius-lg)\"\n>\n  <div style=\"height: 600px; display: flex; align-items: center; justify-content: center\">\n    <div\n      id=\"anim-spin-scroll-target\"\n      style=\"\n        width: 160px;\n        height: 100px;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        font-weight: 600;\n        border: 1px solid var(--border);\n        border-radius: var(--radius-lg);\n        background: var(--card);\n        color: var(--card-foreground);\n      \"\n    >\n      Scroll to spin\n    </div>\n  </div>\n</div>\n","individual":false}]
