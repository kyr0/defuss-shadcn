[{"label":"Default","html":"<header class=\"mk-comment-header\">\n  <h2 class=\"mk-comment-header-title\">Comments <span class=\"badge\" data-variant=\"secondary\">128</span></h2>\n  <div class=\"mk-comment-header-actions\">\n    <label class=\"mk-comment-header-sort\"\n      >Sort by\n      <select class=\"select\" data-size=\"sm\" name=\"sort\">\n        <option>Top</option>\n        <option>Newest</option>\n        <option>Oldest</option>\n      </select>\n    </label>\n    <button type=\"button\" class=\"btn\" data-variant=\"outline\" data-size=\"sm\"><i data-lucide=\"bell\"></i> Follow</button>\n  </div>\n</header>\n","individual":true},{"label":"Sort links","html":"<header class=\"mk-comment-header\" data-variant=\"plain\">\n  <h2 class=\"mk-comment-header-title\">Discussion <span class=\"badge\" data-variant=\"secondary\">42</span></h2>\n  <nav class=\"mk-comment-header-tabs\" aria-label=\"Sort comments\">\n    <a href=\"#\" aria-current=\"page\">Top</a>\n    <a href=\"#\">Newest</a>\n    <a href=\"#\">Oldest</a>\n  </nav>\n</header>\n","individual":true},{"label":"Toggle sort and participants","html":"<header class=\"mk-comment-header\">\n  <h2 class=\"mk-comment-header-title\">Discussion <span class=\"badge\" data-variant=\"secondary\">86</span></h2>\n  <div class=\"toggle-group\" role=\"group\" aria-label=\"Sort comments\" data-type=\"single\" data-size=\"sm\">\n    <button class=\"toggle\" aria-pressed=\"true\" value=\"top\"><i data-lucide=\"flame\"></i> Top</button>\n    <button class=\"toggle\" aria-pressed=\"false\" value=\"new\"><i data-lucide=\"clock\"></i> New</button>\n    <button class=\"toggle\" aria-pressed=\"false\" value=\"old\">Oldest</button>\n  </div>\n  <div class=\"mk-comment-header-people\">\n    <div class=\"avatar-group\">\n      <span class=\"avatar\" data-size=\"sm\"><img class=\"avatar-image\" src=\"images/mk-portrait.png\" alt=\"\" /></span>\n      <span class=\"avatar\" data-size=\"sm\"><img class=\"avatar-image\" src=\"images/mk-