[{"label":"Rio Vega, creative technologist","html":"<style>\n  @import url('https://fonts.googleapis.com/css2?family=Unbounded:wght@400;600;800&display=swap');\n  #pf-neon {\n    --background: oklch(0.15 0.035 285);\n    --foreground: oklch(0.97 0.01 285);\n    --card: oklch(1 0 0 / 0.06);\n    --card-foreground: var(--foreground);\n    --popover: oklch(0.2 0.04 285);\n    --popover-foreground: var(--foreground);\n    --muted: oklch(1 0 0 / 0.08);\n    --muted-foreground: oklch(0.78 0.03 285);\n    --border: oklch(1 0 0 / 0.14);\n    --input: var(--border);\n    --primary: oklch(0.72 0.22 335);\n    --primary-foreground: oklch(0.15 0.035 285);\n    --secondary: oklch(1 0 0 / 0.1);\n    --secondary-foreground: var(--foreground);\n    --accent: oklch(1 0 0 / 0.1);\n    --accent-foreground: var(--foreground);\n    --ring: oklch(0.85 0.13 200);\n    --chart-1: oklch(0.85 0.13 200);\n    --chart-2: oklch(0.72 0.22 335);\n    --chart-3: oklch(0.9 0.19 128);\n    --chart-4: oklch(0.66 0.22 295);\n    --chart-5: oklch(0.8 0.16 60);\n    --radius: 1rem;\n    --radius-sm: max(0px, calc(var(--radius) - 4px));\n    --radius-md: max(0px, calc(var(--radius) - 2px));\n    --radius-lg: var(--radius);\n    --radius-xl: calc(var(--radius) + 4px);\n    --pf-glow: linear-gradient(100deg, var(--chart-1), var(--chart-4) 45%, var(--chart-2));\n    color-scheme: dark;\n    container: pf-neon / inline-size;\n    position: relative;\n    box-sizing: border-box;\n    width: 100%;\n    overflow: clip;\n    isolation: isolate;\n    background: var(--background);\n    color: var(--foreground);\n    font-family: var(--font-sans);\n  }\n  #pf-neon .pf-aurora {\n    position: absolute;\n    inset: 0;\n    z-index: -1;\n    pointer-events: none;\n  }\n  #pf-neon .pf-aurora span {\n    position: absolute;\n    width: 46rem;\n    aspect-ratio: 1;\n    border-radius: 50%;\n    filter: blur(90px);\n    opacity: 0.45;\n    animation: pf-neon-drift 18s ease-in-out infinite alternate;\n  }\n  #pf-neon .pf-aurora span:nth-child(1) {\n    inset: -12rem auto auto -10rem;\n    background: var(--chart-4);\n  }\n  #pf-neon .pf-aurora span:nth-child(2) {\n    inset: 10rem -14rem auto auto;\n    background: var(--chart-2);\n    animation-delay: -6s;\n  }\n  #pf-neon .pf-aurora span:nth-child(3) {\n    inset: auto auto 10% 20%;\n    background: var(--chart-1);\n    opacity: 0.25;\n    animation-delay: -12s;\n  }\n  @keyframes pf-neon-drift {\n    to {\n      translate: 8rem 5rem;\n      scale: 1.2;\n    }\n  }\n  #pf-neon .pf-page {\n    display: flex;\n    flex-direction: column;\n    gap: clamp(3.5rem, 8vw, 6rem);\n    max-width: 72rem;\n    margin-inline: auto;\n    padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 4vw, 2.5rem) 3rem;\n  }\n  #pf-neon [hidden] {\n    display: none !important;\n  }\n  /* the views: the home page and a page per piece share the page's column and its rhythm */\n  #pf-neon .pf-home {\n    display: flex;\n    flex-direction: column;\n    gap: clamp(3.5rem, 8vw, 6rem);\n  }\n  /* the Site Header: the handle with a glowing dot, the sections in Unbounded, the mode */\n  #pf-neon .mk-header {\n    background: none;\n    color: inherit;\n  }\n  #pf-neon .mk-header-inner {\n    flex-wrap: wrap;\n    max-width: none;\n    min-height: 4.5rem;\n    padding: 0;\n  }\n  #pf-neon .mk-header-brand {\n    gap: 0.6rem;\n    color: var(--foreground);\n  }\n  #pf-neon .mk-header-name,\n  #pf-neon .mk-footer-brand-name {\n    color: inherit;\n    font-family: 'Unbounded', var(--font-sans);\n    font-size: 1rem;\n    font-weight: 600;\n  }\n  #pf-neon .pf-brand-dot {\n    width: 0.7rem;\n    aspect-ratio: 1;\n    border-radius: 50%;\n    background: var(--pf-glow);\n    box-shadow: 0 0 14px color-mix(in oklch, var(--chart-2) 70%, transparent);\n  }\n  #pf-neon .mk-header-nav {\n    display: flex;\n    margin-inline-start: auto;\n  }\n  #pf-neon .nav-menu-list {\n    gap: 0.25rem;\n  }\n  #pf-neon .nav-menu-link {\n    padding: 0.5rem 0.9rem;\n    border-radius: 999px;\n    color: var(--foreground);\n    font-family: 'Unbounded', var(--font-sans);\n    font-size: 0.875rem;\n  }\n  #pf-neon .nav-menu-link:is(:hover, :focus-visible) {\n    background: var(--muted);\n    color: var(--foreground);\n  }\n  #pf-neon .nav-menu-link[aria-current] {\n    background: var(--card);\n    color: var(--foreground);\n    box-shadow: inset 0 0 0 1px var(--border);\n  }\n  #pf-neon .mk-header-actions {\n    margin-inline-start: 0.5rem;\n  }\n  /* a piece's page: the title in the glow, the cover with its halo, the facts and the story in glass */\n  #pf-neon .pf-case {\n    display: flex;\n    flex-direction: column;\n    gap: clamp(2rem, 5vw, 3.5rem);\n  }\n  #pf-neon .pf-case-back {\n    display: flex;\n    justify-content: space-between;\n    gap: 1rem;\n    margin: 0;\n    color: var(--muted-foreground);\n    font-family: 'Unbounded', var(--font-sans);\n    font-size: 0.875rem;\n  }\n  #pf-neon .pf-case-back a {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.4rem;\n    color: var(--foreground);\n    text-decoration: none;\n  }\n  #pf-neon .pf-case-back a:is(:hover, :focus-visible) {\n    color: var(--chart-1);\n  }\n  #pf-neon .pf-case-back svg,\n  #pf-neon .pf-case-pager svg {\n    width: 1rem;\n    height: 1rem;\n  }\n  #pf-neon .pf-case-title {\n    margin: 0;\n    background: var(--pf-glow);\n    background-clip: text;\n    color: transparent;\n    font-family: 'Unbounded', var(--font-sans);\n    font-size: clamp(2.75rem, 1rem + 7cqi, 6rem);\n    font-weight: 800;\n    letter-spacing: -0.04em;\n    line-height: 0.95;\n  }\n  #pf-neon .pf-case-lede {\n    max-width: 46rem;\n    margin: 1.5rem 0 0;\n    font-size: clamp(1.15rem, 1rem + 0.8cqi, 1.5rem);\n    line-height: 1.45;\n    text-wrap: pretty;\n  }\n  #pf-neon .pf-case-cover {\n    width: 100%;\n    aspect-ratio: 16 / 9;\n    border-radius: calc(var(--radius) * 1.75);\n    object-fit: cover;\n    box-shadow: 0 0 80px color-mix(in oklch, var(--chart-4) 45%, transparent);\n  }\n  #pf-neon .pf-case-grid {\n    display: grid;\n    grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);\n    align-items: start;\n    gap: clamp(1.5rem, 4vw, 3rem);\n  }\n  #pf-neon .pf-case-facts {\n    display: grid;\n    gap: 0.25rem;\n    margin: 0;\n    padding: 1.5rem;\n  }\n  #pf-neon .pf-case-facts dt {\n    margin-block-start: 0.75rem;\n    color: var(--chart-1);\n    font-size: 0.75rem;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n  }\n  #pf-neon .pf-case-facts dt:first-child {\n    margin-block-start: 0;\n  }\n  #pf-neon .pf-case-facts dd {\n    margin: 0;\n  }\n  #pf-neon .pf-case-text {\n    display: grid;\n    gap: 2rem;\n  }\n  #pf-neon .pf-case-text h2 {\n    margin: 0 0 0.75rem;\n    font-size: clamp(1.15rem, 1rem + 0.8cqi, 1.5rem);\n  }\n  #pf-neon .pf-case-text p {\n    max-width: 42rem;\n    margin: 0;\n    color: var(--muted-foreground);\n    font-size: 1.0625rem;\n    line-height: 1.65;\n    text-wrap: pretty;\n  }\n  #pf-neon .pf-case-pair {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 1.5rem;\n  }\n  #pf-neon .pf-case-pair img {\n    width: 100%;\n    aspect-ratio: 9 / 7;\n    border: 1px solid var(--border);\n    border-radius: calc(var(--radius) * 1.5);\n    object-fit: cover;\n  }\n  #pf-neon .pf-case-pager {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 1.5rem;\n  }\n  #pf-neon .pf-case-pager a {\n    display: grid;\n    gap: 0.5rem;\n    padding: 1.25rem 1.5rem;\n    color: inherit;\n    text-decoration: none;\n    transition: box-shadow 0.2s;\n  }\n  #pf-neon .pf-case-pager a + a {\n    text-align: end;\n  }\n  #pf-neon .pf-case-pager a:is(:hover, :focus-visible) {\n    box-shadow: 0 0 32px color-mix(in oklch, var(--chart-2) 45%, transparent);\n  }\n  #pf-neon .pf-case-pager small {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.4rem;\n    color: var(--chart-1);\n    font-size: 0.75rem;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n  }\n  #pf-neon .pf-case-pager a + a small {\n    justify-content: end;\n  }\n  #pf-neon .pf-case-pager strong {\n    font-family: 'Unbounded', var(--font-sans);\n    font-size: clamp(1.1rem, 1rem + 1cqi, 1.6rem);\n    font-weight: 600;\n  }\n  /* the Site Footer: a glass band - the pieces, the site, where to listen, the bookings */\n  #pf-neon .mk-footer {\n    color: var(--foreground);\n  }\n  #pf-neon .mk-footer-inner {\n    max-width: none;\n    padding: clamp(1.5rem, 4vw, 2.5rem);\n  }\n  #pf-neon .mk-footer-heading {\n    color: var(--chart-1);\n    font-size: 0.75rem;\n    font-weight: 500;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n  }\n  #pf-neon .mk-footer-list {\n    gap: 0.5rem;\n    font-size: 0.9375rem;\n  }\n  #pf-neon .mk-footer-list a:is(:hover, :focus-visible) {\n    color: var(--chart-2);\n    text-decoration: none;\n  }\n  #pf-neon .pf-foot-note {\n    margin: 0;\n    color: var(--muted-foreground);\n    font-size: 0.875rem;\n    line-height: 1.5;\n  }\n  #pf-neon .mk-footer-rule {\n    margin: 0;\n    border: 0;\n    height: 1px;\n    background: var(--border);\n  }\n  #pf-neon .mk-footer-brand {\n    gap: 0.6rem;\n    color: var(--foreground);\n  }\n  #pf-neon .mk-footer-copy {\n    color: var(--muted-foreground);\n  }\n  #pf-neon .pf-glass {\n    border: 1px solid var(--border);\n    border-radius: calc(var(--radius) * 1.75);\n    background: var(--card);\n    backdrop-filter: blur(14px) saturate(1.4);\n  }\n  #pf-neon .pf-hero {\n    display: grid;\n    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);\n    align-items: center;\n    gap: clamp(2rem, 5vw, 4rem);\n  }\n  #pf-neon .pf-kicker {\n    margin: 0 0 1rem;\n    font-size: 0.875rem;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n    color: var(--chart-1);\n  }\n  /* on the light ground the small kicker takes a deeper teal (the chart colour read faintly over the glow) */\n  :root:not(.dark) #pf-neon .pf-kicker {\n    color: oklch(from var(--chart-1) min(l, 0.44) c h);\n  }\n  #pf-neon .pf-name {\n    margin: 0;\n    background: var(--pf-glow);\n    background-clip: text;\n    color: transparent;\n    font-family: 'Unbounded', var(--font-sans);\n    font-size: clamp(3rem, 1rem + 8cqi, 7rem);\n    font-weight: 800;\n    letter-spacing: -0.04em;\n    line-height: 0.95;\n  }\n  #pf-neon .pf-makes {\n    min-height: 2.6em;\n    margin: 1.5rem 0 2rem;\n    font-size: clamp(1.25rem, 1rem + 1.2cqi, 1.75rem);\n    line-height: 1.3;\n  }\n  #pf-neon .btn {\n    border-radius: 999px;\n  }\n  #pf-neon .pf-cta {\n    border: 0;\n    background: var(--pf-glow);\n    color: var(--primary-foreground);\n    font-weight: 600;\n    box-shadow: 0 0 28px color-mix(in oklch, var(--chart-2) 55%, transparent);\n  }\n  #pf-neon .pf-portrait {\n    justify-self: center;\n    width: min(100%, 22rem);\n    aspect-ratio: 1;\n    border-width: 4px;\n    box-shadow: 0 0 60px color-mix(in oklch, var(--chart-4) 55%, transparent);\n  }\n  #pf-neon .pf-portrait img {\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n  }\n  #pf-neon .frame-conic {\n    background:\n      linear-gradient(var(--background), var(--background)) padding-box,\n      conic-gradient(var(--chart-1), var(--chart-4), var(--chart-2), var(--chart-5), var(--chart-1)) border-box;\n  }\n  #pf-neon h2 {\n    margin: 0 0 1.5rem;\n    font-family: 'Unbounded', var(--font-sans);\n    font-size: clamp(1.5rem, 1rem + 2cqi, 2.5rem);\n    font-weight: 600;\n    letter-spacing: -0.02em;\n  }\n  #pf-neon .mk-portfolio-grid-link {\n    border: 1px solid var(--border);\n    border-radius: calc(var(--radius) * 1.5);\n    background: var(--card);\n    overflow: clip;\n  }\n  #pf-neon .mk-portfolio-grid-caption {\n    padding: 0.85rem 1rem 1rem;\n  }\n  #pf-neon .mk-portfolio-grid-meta {\n    color: var(--chart-1);\n  }\n  #pf-neon .pf-two {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));\n    gap: 1.5rem;\n    align-items: stretch;\n  }\n  #pf-neon .pf-two > * {\n    padding: clamp(1.25rem, 3vw, 2rem);\n  }\n  #pf-neon .mk-audio-player {\n    padding: 0;\n    border: 0;\n    background: none;\n    box-shadow: none;\n  }\n  #pf-neon .mk-audio-player-cover {\n    border-radius: var(--radius);\n  }\n  #pf-neon .mk-stats-band {\n    border: 1px solid var(--border);\n    border-radius: calc(var(--radius) * 1.75);\n    background: var(--card);\n    color: var(--foreground);\n    backdrop-filter: blur(14px);\n  }\n  #pf-neon .mk-stat-value {\n    background: var(--pf-glow);\n    background-clip: text;\n    color: transparent;\n    font-family: 'Unbounded', var(--font-sans);\n  }\n  #pf-neon .mk-stat-label {\n    color: var(--muted-foreground);\n  }\n  #pf-neon .mk-skill-matrix-level::-webkit-meter-optimum-value {\n    background: var(--pf-glow);\n  }\n  #pf-neon .mk-skill-matrix-level::-moz-meter-bar {\n    background: var(--pf-glow);\n  }\n  #pf-neon .mk-availability[data-variant='spotlight'] {\n    border: 0;\n    border-radius: calc(var(--radius) * 2);\n    background: var(--pf-glow);\n    color: var(--primary-foreground);\n  }\n  #pf-neon .mk-availability[data-variant='spotlight'] .mk-availability-title {\n    font-family: 'Unbounded', var(--font-sans);\n    font-weight: 800;\n  }\n  #pf-neon .mk-availability[data-variant='spotlight'] .btn {\n    background: var(--background);\n    color: var(--foreground);\n  }\n  @container pf-neon (max-width: 46rem) {\n    #pf-neon .pf-hero {\n      grid-template-columns: minmax(0, 1fr);\n    }\n    #pf-neon .pf-portrait {\n      grid-row: 1;\n      width: min(70%, 16rem);\n    }\n    #pf-neon .mk-header-nav {\n      order: 3;\n      width: 100%;\n      margin-inline-start: -0.9rem;\n    }\n    #pf-neon .mk-header-actions {\n      margin-inline-start: auto;\n    }\n    #pf-neon :is(.pf-case-grid, .pf-case-pager) {\n      grid-template-columns: minmax(0, 1fr);\n    }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    #pf-neon .pf-aurora span {\n      animation: none;\n    }\n  }\n  /* light or dark: the Swap writes the page's dark class - every look has a light and a dark palette */\n  #pf-neon .site-mode {\n    flex: none;\n    border: 1px solid var(--input);\n    border-radius: var(--radius-md);\n    background: var(--background);\n    color: var(--foreground);\n  }\n  #pf-neon .site-mode:hover {\n    background: var(--accent);\n    color: var(--accent-foreground);\n  }\n  /* -- modes: each look in light and dark, derived from the palettes above (the other mode of each look) -- */\n  .dark #pf-neon {\n    --accent: oklch(0.24 0 285);\n  }\n  :root:not(.dark) #pf-neon {\n    color-scheme: light;\n    --background: oklch(0.985 0.025 285);\n    --foreground: oklch(0.2 0.01 285);\n    --card: oklch(0.2 0 0 / 0.06);\n    --card-foreground: oklch(0.2 0.01 285);\n    --popover: oklch(0.997 0.025 285);\n    --popover-foreground: oklch(0.2 0.01 285);\n    --muted: oklch(0.2 0 0 / 0.08);\n    --muted-foreground: oklch(0.46 0.03 285);\n    --border: oklch(0.2 0 0 / 0.12);\n    --input: oklch(0.2 0 0 / 0.12);\n    --primary: oklch(0.47 0.22 335);\n    --primary-foreground: oklch(0.985 0.005 335);\n    --secondary: oklch(0.2 0 0 / 0.1);\n    --secondary-foreground: oklch(0.25 0.01 285);\n    --accent: oklch(0.94 0 285);\n    --accent-foreground: oklch(0.2 0.01 285);\n    --ring: oklch(0.58 0.13 200);\n    --chart-1: oklch(0.58 0.13 200);\n    --chart-2: oklch(0.47 0.22 335);\n    --chart-3: oklch(0.58 0.19 128);\n    --chart-4: oklch(0.42 0.22 295);\n    --chart-5: oklch(0.55 0.16 60);\n  }\n  /* -- modes: end -- */\n</style>\n<div id=\"pf-neon\">\n  <div class=\"pf-aurora\" aria-hidden=\"true\"><span></span><span></span><span></span></div>\n  <div class=\"pf-page\">\n    <header class=\"mk-header\">\n      <div class=\"mk-header-inner\">\n        <a class=\"mk-header-brand\" href=\"#/\" data-router-link\n          ><span class=\"pf-brand-dot\" aria-hidden=\"true\"></span><span class=\"mk-header-name\">rio/vega</span></a\n        >\n        <nav class=\"mk-header-nav\" aria-label=\"Main\">\n          <ul class=\"nav-menu-list\">\n            <li class=\"nav-menu-item\"><a class=\"nav-menu-link\" href=\"#/work\" data-router-link>Work</a></li>\n            <li class=\"nav-menu-item\"><a class=\"nav-menu-link\" href=\"#/live\" data-router-link>Live</a></li>\n            <li class=\"nav-menu-item\"><a class=\"nav-menu-link\" href=\"#/contact\" data-router-link>Contact</a></li>\n          </ul>\n        </nav>\n        <div class=\"mk-header-actions\">\n          <label class=\"swap site-mode\" data-variant=\"rotate\" data-size=\"sm\">\n            <input type=\"checkbox\" data-site-mode aria-label=\"Dark mode\" />\n            <span class=\"swap-on\" aria-hidden=\"true\"><i data-lucide=\"moon\"></i></span>\n            <span class=\"swap-off\" aria-hidden=\"true\"><i data-lucide=\"sun\"></i></span>\n          </label>\n        </div>\n      </div>\n    </header>\n    <div class=\"pf-home\" data-pf-view=\"home\">\n      <section class=\"pf-hero\" aria-labelledby=\"pf-neon-name\">\n        <div>\n          <p class=\"pf-kicker\" data-df-entrance=\"fade\">Creative technologist · Mexico City / Berlin</p>\n          <h1 class=\"pf-name\" id=\"pf-neon-name\" data-df-entrance=\"blur\">Rio Vega</h1>\n          <p class=\"pf-makes\" data-df-entrance=\"up\" style=\"--df-motion-delay: 200ms\">\n            I build\n            <span class=\"typewriter\" data-loop\n              ><span style=\"color: var(--chart-1)\">generative visuals.</span\n              ><span style=\"color: var(--chart-2)\">sound toys for the browser.</span\n              ><span style=\"color: var(--chart-3)\">light for live shows.</span></span\n            >\n          </p>\n          <div class=\"flex flex-wrap gap-3\" data-df-entrance=\"up\" style=\"--df-motion-delay: 300ms\">\n            <a class=\"btn pf-cta\" data-size=\"lg\" href=\"#/work\" data-router-link>See the work</a>\n            <a class=\"btn\" data-size=\"lg\" data-variant=\"outline\" href=\"mailto:rio@example.com\">Book a show</a>\n          </div>\n        </div>\n        <div class=\"pf-portrait shape-circle frame-conic\" data-df-entrance=\"zoom\" style=\"--df-motion-delay: 150ms\">\n          <img src=\"images/photos/660-700x700.webp\" alt=\"Rio Vega holding a sparkler\" />\n        </div>\n      </section>\n      <section id=\"pf-neon-work\" data-pf-section=\"work\" aria-labelledby=\"pf-neon-work-title\">\n        <h2 id=\"pf-neon-work-title\">Recent pieces</h2>\n        <ul class=\"mk-portfolio-grid\" data-variant=\"strip\">\n          <li class=\"mk-portfolio-grid-item\">\n            <a class=\"mk-portfolio-grid-link\" href=\"#/work/halo\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"images/photos/1079-640x800.webp\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Halo</strong>\n                <span class=\"mk-portfolio-grid-meta\">Light installation · 2026</span>\n              </span>\n            </a>\n          </li>\n          <li class=\"mk-portfolio-grid-item\">\n            <a class=\"mk-portfolio-grid-link\" href=\"#/work/long-exposure\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"images/photos/1042-640x800.webp\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Long Exposure</strong>\n                <span class=\"mk-portfolio-grid-meta\">WebGL · 2025</span>\n              </span>\n            </a>\n          </li>\n          <li class=\"mk-portfolio-grid-item\">\n            <a class=\"mk-portfolio-grid-link\" href=\"#/work/fiesta-engine\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"images/photos/959-640x800.webp\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Fiesta Engine</strong>\n                <span class=\"mk-portfolio-grid-meta\">Live visuals · 2025</span>\n              </span>\n            </a>\n          </li>\n          <li class=\"mk-portfolio-grid-item\">\n            <a class=\"mk-portfolio-grid-link\" href=\"#/work/aurora-synth\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"images/photos/1022-640x800.webp\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Aurora Synth</strong>\n                <span class=\"mk-portfolio-grid-meta\">Web Audio · 2024</span>\n              </span>\n            </a>\n          </li>\n        </ul>\n      </section>\n      <div class=\"pf-two\">\n        <section class=\"pf-glass\" aria-labelledby=\"pf-neon-release\">\n          <h2 id=\"pf-neon-release\">Latest release</h2>\n          <article class=\"mk-audio-player\" data-variant=\"compact\" aria-labelledby=\"pf-neon-track\">\n            <img class=\"mk-audio-player-cover\" src=\"images/photos/974-300x300.webp\" alt=\"\" />\n            <div class=\"mk-audio-player-body\">\n              <span class=\"mk-audio-player-show\">Rio Vega · Single</span>\n              <h3 class=\"mk-audio-player-title\" id=\"pf-neon-track\">Night Bus to Coyoacán</h3>\n              <span class=\"mk-audio-player-meta\">14 sec preview · <time datetime=\"2026-10-02\">2 Oct 2026</time></span>\n            </div>\n            <div class=\"mk-audio-player-controls\">\n              <audio controls preload=\"none\" src=\"videos/demo-audio.mp3\">Your browser does not support audio.</audio>\n            </div>\n          </article>\n        </section>\n        <section class=\"pf-glass\" aria-labelledby=\"pf-neon-skills\">\n          <h2 id=\"pf-neon-skills\">Toolbox</h2>\n          <div class=\"mk-skill-matrix\">\n            <section class=\"mk-skill-matrix-group\" aria-label=\"Tools\">\n              <ul class=\"mk-skill-matrix-list\">\n                <li class=\"mk-skill-matrix-skill\">\n                  <label class=\"mk-skill-matrix-name\" for=\"pf-neon-td\">TouchDesigner</label>\n                  <meter class=\"mk-skill-matrix-level\" id=\"pf-neon-td\" min=\"0\" max=\"5\" value=\"5\">5 of 5</meter>\n                </li>\n                <li class=\"mk-skill-matrix-skill\">\n                  <label class=\"mk-skill-matrix-name\" for=\"pf-neon-glsl\">GLSL</label>\n                  <meter class=\"mk-skill-matrix-level\" id=\"pf-neon-glsl\" min=\"0\" max=\"5\" value=\"4\">4 of 5</meter>\n                </li>\n                <li class=\"mk-skill-matrix-skill\">\n                  <label class=\"mk-skill-matrix-name\" for=\"pf-neon-able\">Ableton Live</label>\n                  <meter class=\"mk-skill-matrix-level\" id=\"pf-neon-able\" min=\"0\" max=\"5\" value=\"4\">4 of 5</meter>\n                </li>\n                <li class=\"mk-skill-matrix-skill\">\n                  <label class=\"mk-skill-matrix-name\" for=\"pf-neon-dmx\">DMX lighting</label>\n                  <meter class=\"mk-skill-matrix-level\" id=\"pf-neon-dmx\" min=\"0\" max=\"5\" value=\"3\">3 of 5</meter>\n                </li>\n              </ul>\n            </section>\n          </div>\n        </section>\n      </div>\n      <section id=\"pf-neon-live\" data-pf-section=\"live\" class=\"mk-stats\" aria-label=\"Live\">\n        <div class=\"mk-stats-band\">\n          <div class=\"mk-stat\"><span class=\"mk-stat-value\">86</span><span class=\"mk-stat-label\">live shows</span></div>\n          <div class=\"mk-stat\"><span class=\"mk-stat-value\">14</span><span class=\"mk-stat-label\">countries</span></div>\n          <div class=\"mk-stat\"\n            ><span class=\"mk-stat-value\">9</span><span class=\"mk-stat-label\">installations</span></div\n          >\n          <div class=\"mk-stat\"><span class=\"mk-stat-value\">1</span><span class=\"mk-stat-label\">fog machine</span></div>\n        </div>\n      </section>\n      <aside\n        id=\"pf-neon-contact\"\n        data-pf-section=\"contact\"\n        class=\"mk-availability\"\n        data-variant=\"spotlight\"\n        aria-labelledby=\"pf-neon-hire\"\n      >\n        <p class=\"mk-availability-status\"\n          ><span class=\"indicator-dot\" data-variant=\"success\" data-animate=\"ping\" aria-hidden=\"true\"></span> Touring\n          spring 2027</p\n        >\n        <h2 class=\"mk-availability-title\" id=\"pf-neon-hire\">Your stage needs more light</h2>\n        <div class=\"mk-availability-actions\">\n          <a class=\"btn\" data-size=\"lg\" href=\"mailto:rio@example.com\">rio@example.com</a>\n        </div>\n      </aside>\n    </div>\n    <article class=\"pf-case\" data-pf-view=\"work\" aria-labelledby=\"pf-neon-case-title\" hidden>\n      <p class=\"pf-case-back\">\n        <a href=\"#/work\" data-router-link><i data-lucide=\"arrow-left\"></i> All pieces</a>\n        <span><span data-case=\"no\">01</span> / 04</span>\n      </p>\n      <header class=\"pf-case-head\">\n        <p class=\"pf-kicker\"><span data-case=\"kind\">Light installation</span> · <span data-case=\"year\">2026</span></p>\n        <h1 class=\"pf-case-title\" id=\"pf-neon-case-title\" data-case=\"title\">Halo</h1>\n        <p class=\"pf-case-lede\" data-case=\"summary\"\n          >A ring of 240 light bars that breathes with the crowd below it - the louder the square, the faster it\n          turns.</p\n        >\n      </header>\n      <img\n        class=\"pf-case-cover\"\n        data-case-img=\"0\"\n        data-w=\"1600\"\n        data-h=\"900\"\n        src=\"images/photos/1079-1600x900.webp\"\n        alt=\"A ring of sparks from light painting at night\"\n      />\n      <div class=\"pf-case-grid\">\n        <dl class=\"pf-glass pf-case-facts\">\n          <dt>Client</dt>\n          <dd data-case=\"client\">Festival Luz Norte, Monterrey</dd>\n          <dt>Role</dt>\n          <dd data-case=\"role\">Concept, light design, code</dd>\n          <dt>Tools</dt>\n          <dd data-case=\"tools\">TouchDesigner, DMX, 240 LED bars</dd>\n        </dl>\n        <div class=\"pf-case-text\">\n          <section aria-labelledby=\"pf-neon-brief\">\n            <h2 id=\"pf-neon-brief\">The brief</h2>\n            <p data-case=\"brief\"\n              >The festival wanted one piece for its main square that people would walk towards from three streets away\n              - and that would not look like a stage when no band was playing.</p\n            >\n          </section>\n          <section aria-labelledby=\"pf-neon-build\">\n            <h2 id=\"pf-neon-build\">The build</h2>\n            <p data-case=\"work\"\n              >Eight microphones around the square feed a TouchDesigner patch that turns the noise of the crowd into\n              speed, colour and breath. The ring hangs twelve metres up on two cranes; every bar is addressed on its\n              own, so a wave can run once around it in exactly one bar of the music.</p\n            >\n          </section>\n          <section aria-labelledby=\"pf-neon-result\">\n            <h2 id=\"pf-neon-result\">What happened</h2>\n            <p data-case=\"result\"\n              >Ninety thousand visitors over four nights, and a square that kept filling after the last concert. The\n              festival bought the ring and brings it back every year.</p\n            >\n          </section>\n        </div>\n      </div>\n      <div class=\"pf-case-pair\">\n        <img\n          data-case-img=\"1\"\n          data-w=\"900\"\n          data-h=\"700\"\n          src=\"images/photos/117-900x700.webp\"\n          alt=\"Raised hands in front of a lit stage in a dark hall\"\n        />\n        <img\n          data-case-img=\"2\"\n          data-w=\"900\"\n          data-h=\"700\"\n          src=\"images/photos/195-900x700.webp\"\n          alt=\"An alley strung with lights at night\"\n        />\n      </div>\n      <nav class=\"pf-case-pager\" aria-label=\"More pieces\">\n        <a class=\"pf-glass\" href=\"#/work/aurora-synth\" data-router-link data-case-link=\"prev\"\n          ><small><i data-lucide=\"arrow-left\"></i> Previous</small\n          ><strong data-case-title=\"prev\">Aurora Synth</strong></a\n        >\n        <a class=\"pf-glass\" href=\"#/work/long-exposure\" data-router-link data-case-link=\"next\"\n          ><small>Next <i data-lucide=\"arrow-right\"></i></small><strong data-case-title=\"next\">Long Exposure</strong></a\n        >\n      </nav>\n    </article>\n    <footer class=\"mk-footer pf-glass\">\n      <div class=\"mk-footer-inner\">\n        <nav class=\"mk-footer-nav\" aria-label=\"Footer\">\n          <div class=\"mk-footer-col\">\n            <h3 class=\"mk-footer-heading\">Pieces</h3>\n            <ul class=\"mk-footer-list\">\n              <li><a href=\"#/work/halo\" data-router-link>Halo</a></li>\n              <li><a href=\"#/work/long-exposure\" data-router-link>Long Exposure</a></li>\n              <li><a href=\"#/work/fiesta-engine\" data-router-link>Fiesta Engine</a></li>\n              <li><a href=\"#/work/aurora-synth\" data-router-link>Aurora Synth</a></li>\n            </ul>\n          </div>\n          <div class=\"mk-footer-col\">\n            <h3 class=\"mk-footer-heading\">Site</h3>\n            <ul class=\"mk-footer-list\">\n              <li><a href=\"#/work\" data-router-link>Recent pieces</a></li>\n              <li><a href=\"#/live\" data-router-link>Live in numbers</a></li>\n              <li><a href=\"#/contact\" data-router-link>Book a show</a></li>\n            </ul>\n          </div>\n          <div class=\"mk-footer-col\">\n            <h3 class=\"mk-footer-heading\">Listen &amp; watch</h3>\n            <ul class=\"mk-footer-list\">\n              <li><a href=\"https://soundcloud.com/\" target=\"_blank\" rel=\"noopener\">SoundCloud</a></li>\n              <li><a href=\"https://vimeo.com/\" target=\"_blank\" rel=\"noopener\">Vimeo</a></li>\n              <li><a href=\"https://www.instagram.com/\" target=\"_blank\" rel=\"noopener\">Instagram</a></li>\n            </ul>\n          </div>\n          <div class=\"mk-footer-col\">\n            <h3 class=\"mk-footer-heading\">Bookings</h3>\n            <ul class=\"mk-footer-list\">\n              <li><a href=\"mailto:rio@example.com\">rio@example.com</a></li>\n            </ul>\n            <p class=\"pf-foot-note\">Mexico City until March, Berlin from April. Rider and stage plan on request.</p>\n          </div>\n        </nav>\n        <hr class=\"separator mk-footer-rule\" />\n        <div class=\"mk-footer-bottom\">\n          <a class=\"mk-footer-brand\" href=\"#/\" data-router-link\n            ><span class=\"pf-brand-dot\" aria-hidden=\"true\"></span><span class=\"mk-footer-brand-name\">rio/vega</span></a\n          >\n          <div class=\"mk-footer-meta\">\n            <p class=\"mk-footer-copy\">© 2026 Rio Vega · Light, sound and code</p>\n          </div>\n        </div>\n      </div>\n    </footer>\n  </div>\n  <!-- the pieces the routes name, in order -->\n  \n</div>\n","individual":false}]
