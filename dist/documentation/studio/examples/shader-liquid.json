[{"label":"Drops on violet","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"metaballs-demo\"\n    data-effect=\"metaballs\"\n    data-interactive\n    data-colors=\"#ff7a59 #ffc75f #f9f871 #ff5e78\"\n    data-background=\"#2b1055\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"metaballs-demo\"></div>\n</div>\n","individual":false},{"label":"A ring and a word in metal","html":"<div class=\"grid gap-6 items-center\" style=\"grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); padding: 1rem\">\n  <div class=\"shader\" id=\"liquid-metal-demo\" data-effect=\"liquid-metal\" style=\"max-width: 12rem; margin: auto\">\n    <svg viewBox=\"0 0 200 200\" role=\"img\" aria-label=\"A ring logo\">\n      <path\n        fill-rule=\"evenodd\"\n        fill=\"currentColor\"\n        d=\"M100 12a88 88 0 1 1 0 176 88 88 0 0 1 0-176zm0 48a40 40 0 1 0 0 80 40 40 0 0 0 0-80z\"\n      />\n    </svg>\n  </div>\n  <div\n    class=\"shader\"\n    data-effect=\"liquid-metal\"\n    data-colors=\"#fff4d6 #f2b84b #7a4a12 #ffe7a3 #b5761f\"\n    style=\"max-width: 16rem; margin: auto\"\n  >\n    <svg viewBox=\"0 0 320 120\" role=\"img\" aria-label=\"GOLD\">\n      <text\n        x=\"160\"\n        y=\"96\"\n        text-anchor=\"middle\"\n        font-family=\"system-ui, sans-serif\"\n        font-weight=\"900\"\n        font-size=\"104\"\n        fill=\"currentColor\"\n      >\n        GOLD\n      </text>\n    </svg>\n  </div>\n  <div class=\"shader-controls\" data-shader-for=\"liquid-metal-demo\"></div>\n</div>\n","individual":false},{"label":"A pool and a photo","html":"<div class=\"grid gap-3\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div class=\"shader\" data-effect=\"water\" aria-hidden=\"true\" style=\"border-radius: var(--radius)\"></div>\n  <div\n    class=\"shader\"\n    id=\"water-demo\"\n    data-effect=\"water\"\n    data-refraction=\"1.2\"\n    data-caustics=\"0.6\"\n    style=\"border-radius: var(--radius)\"\n  >\n    <img src=\"images/photos/429-800x500.webp\" alt=\"Raspberries\" crossorigin=\"anonymous\" width=\"800\" height=\"500\" />\n  </div>\n  <div class=\"shader-controls\" data-shader-for=\"water-demo\"></div>\n</div>\n","individual":false},{"label":"Reeded glass over color and a photo","html":"<div class=\"grid gap-3\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div class=\"shader\" data-effect=\"fluted-glass\" aria-hidden=\"true\" style=\"border-radius: var(--radius)\"></div>\n  <div\n    class=\"shader\"\n    id=\"fluted-glass-demo\"\n    data-effect=\"fluted-glass\"\n    data-flutes=\"22\"\n    data-angle=\"12\"\n    style=\"border-radius: var(--radius)\"\n  >\n    <img\n      src=\"images/photos/1025-800x500.webp\"\n      alt=\"A dog in a blanket\"\n      crossorigin=\"anonymous\"\n      width=\"800\"\n      height=\"500\"\n    />\n  </div>\n  <div class=\"shader-controls\" data-shader-for=\"fluted-glass-demo\"></div>\n</div>\n","individual":false},{"label":"Ink to stir","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"fluid-demo\"\n    data-effect=\"fluid\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"fluid-demo\"></div>\n</div>\n","individual":false},{"label":"Press the water","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div class=\"shader\" id=\"ripple-demo\" data-effect=\"ripple\" data-drops=\"0.4\" style=\"border-radius: var(--radius)\">\n    <img\n      src=\"images/photos/1011-800x500.webp\"\n      alt=\"A boat on a lake\"\n      crossorigin=\"anonymous\"\n      width=\"800\"\n      height=\"500\"\n    />\n  </div>\n  <div class=\"shader-controls\" data-shader-for=\"ripple-demo\"></div>\n</div>\n","individual":false},{"label":"Light on a pool floor","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"caustics-demo\"\n    data-effect=\"caustics\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"caustics-demo\"></div>\n</div>\n","individual":false}]
