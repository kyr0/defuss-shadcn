[{"label":"Horizontal","html":"<div class=\"btn-group\" role=\"group\" aria-label=\"Actions\">\n  <button class=\"btn\" data-variant=\"outline\">Save</button>\n  <button class=\"btn\" data-variant=\"outline\">Edit</button>\n  <button class=\"btn\" data-variant=\"outline\">Delete</button>\n</div>\n","individual":true},{"label":"With icons","html":"<div class=\"btn-group\" role=\"group\" aria-label=\"Formatting\">\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"icon\" aria-label=\"Bold\">\n    <i data-lucide=\"bold\"></i>\n  </button>\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"icon\" aria-label=\"Italic\">\n    <i data-lucide=\"italic\"></i>\n  </button>\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"icon\" aria-label=\"Underline\">\n    <i data-lucide=\"underline\"></i>\n  </button>\n</div>\n","individual":true},{"label":"Vertical","html":"<div class=\"btn-group\" data-orientation=\"vertical\" role=\"group\" aria-label=\"Nav\">\n  <button class=\"btn\" data-variant=\"outline\">Top</button>\n  <button class=\"btn\" data-variant=\"outline\">Middle</button>\n  <button class=\"btn\" data-variant=\"outline\">Bottom</button>\n</div>\n","individual":true},{"label":"Sizes","html":"<div style=\"display: flex; flex-direction: column; gap: 1rem; align-items: center\">\n  <div class=\"btn-group\" role=\"group\" aria-label=\"Extra small actions\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"xs\">Save</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"xs\">Edit</button>\n  </div>\n  <div class=\"btn-group\" role=\"group\" aria-label=\"Small actions\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\">Save</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\">Edit</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"icon-sm\" aria-label=\"More\">\n      <i data-lucide=\"ellipsis\"></i>\n    </button>\n  </div>\n  <div class=\"btn-group\" role=\"group\" aria-label=\"Medium actions\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"md\">Save</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"md\">Edit</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"icon\" aria-label=\"More\">\n      <i data-lucide=\"ellipsis\"></i>\n    </button>\n  </div>\n  <div class=\"btn-group\" role=\"group\" aria-label=\"Large actions\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"lg\">Save</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"lg\">Edit</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"icon-lg\" aria-label=\"More\">\n      <i data-lucide=\"ellipsis\"></i>\n    </button>\n  </div>\n  <div class=\"btn-group\" role=\"group\" aria-label=\"Extra large actions\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"xl\">Save</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"xl\">Edit</button>\n  </div>\n</div>\n","individual":false},{"label":"Split button","html":"<div class=\"btn-group\" role=\"group\" aria-label=\"Split action\">\n  <button class=\"btn\" data-variant=\"outline\" id=\"split-save\">Save</button>\n  <hr role=\"separator\" />\n  <button\n    class=\"btn\"\n    data-variant=\"outline\"\n    data-size=\"icon\"\n    aria-label=\"More save options\"\n    aria-haspopup=\"menu\"\n    aria-expanded=\"false\"\n    aria-controls=\"split-menu\"\n    data-dropdown-trigger=\"split-menu\"\n  >\n    <svg\n      aria-hidden=\"true\"\n      width=\"16\"\n      height=\"16\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n    >\n      <path d=\"m6 9 6 6 6-6\" />\n    </svg>\n  </button>\n</div>\n<div id=\"split-menu\" role=\"menu\" popover class=\"dropdown-content\" data-align=\"end\" aria-label=\"Save options\">\n  <button role=\"menuitem\" class=\"dropdown-item\" tabindex=\"-1\">Save as draft</button>\n  <button role=\"menuitem\" class=\"dropdown-item\" tabindex=\"-1\">Save a copy</button>\n  <button role=\"menuitem\" class=\"dropdown-item\" tabindex=\"-1\">Save and close</button>\n  <div class=\"dropdown-separator\" role=\"separator\"></div>\n  <button role=\"menuitem\" class=\"dropdown-item\" tabindex=\"-1\">Schedule…</button>\n</div>\n<p class=\"text-sm text-muted-foreground\" style=\"margin: 0.75rem 0 0\"\n  >Last action: <output id=\"split-out\">none</output></p\n>\n","individual":false}]
