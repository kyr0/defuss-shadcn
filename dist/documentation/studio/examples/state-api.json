[{"label":"Drive the dialog by name","html":"<div class=\"flex flex-wrap items-center gap-2\">\n  <button class=\"btn\" type=\"button\" id=\"sa-open\">api.setState('open')</button>\n  <button class=\"btn\" data-variant=\"outline\" type=\"button\" id=\"sa-default\">api.setState('default')</button>\n  <output class=\"badge\" data-variant=\"secondary\" id=\"sa-out\" aria-live=\"polite\">default</output>\n</div>\n<dialog id=\"sa-dialog\" class=\"dialog\" aria-labelledby=\"sa-title\">\n  <div class=\"dialog-content\">\n    <div class=\"dialog-header\">\n      <h2 class=\"dialog-title\" id=\"sa-title\">Named state</h2>\n      <p class=\"dialog-description\"\n        >Opened via api.setState('open') - close it and watch the badge flip back to default.</p\n      >\n    </div>\n    <div class=\"dialog-footer\">\n      <button class=\"btn\" data-variant=\"outline\" data-dialog-close>Close</button>\n    </div>\n  </div>\n</dialog>\n","individual":false},{"label":"Subscribe and write","html":"<div class=\"flex flex-col gap-3\" style=\"max-width: 28rem\">\n  <div class=\"flex flex-wrap items-center gap-2\">\n    <button class=\"toggle\" type=\"button\" aria-pressed=\"false\" id=\"sa-toggle\">Bold</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"sa-write\"\n      >el.store.set({ name: 'pressed' })</button\n    >\n  </div>\n  <pre\n    class=\"text-xs m-0\"\n    id=\"sa-log\"\n    style=\"padding: 0.75rem; border-radius: var(--radius-md); background: var(--muted); min-height: 4rem\"\n  ></pre>\n</div>\n","individual":false}]
