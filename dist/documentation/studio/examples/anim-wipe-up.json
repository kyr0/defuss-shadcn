[{"label":"In / out, directions and lifecycle","html":"<style>\n  #anim-wipe-up-target {\n    width: 160px;\n    height: 100px;\n    display: grid;\n    place-items: center;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    background: var(--card);\n    color: var(--card-foreground);\n    font-size: 0.85rem;\n  }\n</style>\n<div style=\"display: flex; flex-direction: column; gap: 0.75rem\">\n  <div id=\"anim-wipe-up-target\">wipe up</div>\n  <div style=\"display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-wipe-up-in\">In</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-wipe-up-out\">Out</button>\n    <span style=\"width: 1px; height: 1.4rem; background: var(--border)\"></span>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-dir=\"north\">N</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-dir=\"south\" aria-pressed=\"true\">S</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-dir=\"west\">W</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-dir=\"east\">E</button>\n    <span style=\"width: 1px; height: 1.4rem; background: var(--border)\"></span>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-wipe-up-pause\">Pause</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-wipe-up-resume\">Resume</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-wipe-up-finish\">Finish</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-wipe-up-reset\">Reset</button>\n  </div>\n  <div style=\"display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; font-size: 0.85rem\">\n    <label style=\"display: flex; align-items: center; gap: 0.4rem\">\n      Duration\n      <input\n        class=\"input\"\n        id=\"anim-wipe-up-duration\"\n        type=\"number\"\n        min=\"50\"\n        step=\"50\"\n        value=\"1500\"\n        style=\"width: 6rem\"\n      />\n    </label>\n    <label style=\"display: flex; align-items: center; gap: 0.4rem\">\n      Easing\n      <select class=\"select\" id=\"anim-wipe-up-easing\">\n        <option value=\"cubic-bezier(0.16, 1, 0.3, 1)\" selected>default (ease-out-expo)</option>\n        <option value=\"linear\">linear</option>\n        <option value=\"ease-in-out\">ease-in-out</option>\n        <option value=\"cubic-bezier(0.34, 1.56, 0.64, 1)\">overshoot</option>\n      </select>\n    </label>\n  </div>\n</div>\n","individual":false},{"label":"Scroll binding","html":"<div\n  id=\"anim-wipe-up-scroller\"\n  style=\"\n    height: 220px;\n    overflow-y: auto;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    padding: 1rem;\n  \"\n>\n  <div style=\"height: 600px; display: flex; flex-direction: column; justify-content: flex-end; align-items: center\">\n    <div\n      id=\"anim-wipe-up-scroll-target\"\n      style=\"\n        width: 160px;\n        height: 100px;\n        display: grid;\n        place-items: center;\n        border: 1px solid var(--border);\n        border-radius: var(--radius-lg);\n        background: var(--card);\n        color: var(--card-foreground);\n        font-size: 0.85rem;\n      \"\n      >scroll me</div\n    >\n  </div>\n</div>\n","individual":false}]
