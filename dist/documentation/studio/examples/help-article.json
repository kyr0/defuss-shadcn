[{"label":"Default","html":"<article class=\"mk-help-article\" aria-labelledby=\"ha-title\">\n  <nav class=\"breadcrumb\" aria-label=\"Breadcrumb\"\n    ><ol class=\"breadcrumb-list\"\n      ><li class=\"breadcrumb-item\"><a class=\"breadcrumb-link\" href=\"#\">Help</a></li\n      ><li class=\"breadcrumb-separator\" aria-hidden=\"true\">/</li\n      ><li class=\"breadcrumb-item\"><a class=\"breadcrumb-link\" href=\"#\">Billing</a></li\n      ><li class=\"breadcrumb-separator\" aria-hidden=\"true\">/</li\n      ><li class=\"breadcrumb-item\"\n        ><span class=\"breadcrumb-page\" aria-current=\"page\">Change your billing email</span></li\n      ></ol\n    ></nav\n  >\n  <h1 class=\"mk-help-article-title\" id=\"ha-title\">Change your billing email</h1>\n  <p class=\"mk-help-article-meta\">Updated <time datetime=\"2026-09-12\">12 Sep 2026</time> · 2 min read</p>\n  <p class=\"mk-help-article-lead\"\n    >Invoices and payment reminders go to the billing email. Only workspace owners can change it.</p\n  >\n  <ol class=\"mk-help-article-steps\">\n    <li\n      ><div\n        ><strong>Open Settings</strong\n        ><p>Press <kbd>⌘</kbd> <kbd>,</kbd> or choose Settings from your avatar menu.</p></div\n      ></li\n    >\n    <li\n      ><div\n        ><strong>Go to Billing → Details</strong><p>You'll see the current billing email under \"Invoices\".</p\n        ><img src=\"images/mk-wide.png\" alt=\"The Billing details screen with the billing email field highlighted\" /></div\n    ></li>\n    <li\n      ><div\n        ><strong>Enter the new address and save</strong\n        ><p>We send a confirmation link to the new address. The change applies once it is confirmed.</p></div\n      ></li\n    >\n  </ol>\n  <div class=\"mk-help-article-tip\"\n    ><i data-lucide=\"lightbulb\"></i\n    ><p>Use a shared address like billing@yourcompany.com so invoices don't depend on one person.</p></div\n  >\n  <details class=\"mk-help-article-stuck\"\n    ><summary>Still stuck?</summary\n    ><p\n      >If you can't see Billing, you're not an owner of this workspace. Ask an owner, or\n      <a href=\"#\">contact support</a>.</p\n    ></details\n  >\n  <form class=\"mk-feedback-form\" data-variant=\"inline\" action=\"#\" method=\"post\">\n    <fieldset\n      ><legend>Was this article helpful?</legend\n      ><div class=\"mk-feedback-form-yesno\"\n        ><label><input type=\"radio\" name=\"ha-helpful\" value=\"yes\" /><i data-lucide=\"thumbs-up\"></i> Yes</label\n        ><label><input type=\"radio\" name=\"ha-helpful\" value=\"no\" /><i data-lucide=\"thumbs-down\"></i> No</label></div\n      ></fieldset\n    >\n    <p class=\"mk-feedback-form-thanks\" role=\"status\">Thanks for letting us know.</p>\n  </form>\n  <ul class=\"mk-help-article-related\"\n    ><li><h2>Related articles</h2></li\n    ><li\n      ><a href=\"#\"><i data-lucide=\"file-text\"></i>Download an invoice</a></li\n    ><li\n      ><a href=\"#\"><i data-lucide=\"file-text\"></i>Add a VAT number</a></li\n    ></ul\n  >\n</article>\n","individual":true}]
