[{"label":"Dialog","html":"<dialog id=\"density-comfortable-dialog\" class=\"dialog\" aria-labelledby=\"density-comfortable-dialog-title\">\n  <div class=\"dialog-content\">\n    <div class=\"dialog-header\">\n      <h3 class=\"dialog-title\" id=\"density-comfortable-dialog-title\">Comfortable</h3>\n      <p class=\"dialog-description\">Content padding 1.5rem - matches the unsized default.</p>\n    </div>\n    <button class=\"btn\" data-variant=\"outline\" data-dialog-close=\"\">Close</button>\n  </div>\n</dialog>\n","individual":true},{"label":"Dialog (lg)","html":"<dialog class=\"dialog\" id=\"q-dialog\" data-size=\"lg\" aria-labelledby=\"q-dialog-title\">\n  <div class=\"dialog-content\">\n    <div class=\"dialog-header\">\n      <h2 class=\"dialog-title\" id=\"q-dialog-title\">Report a problem</h2>\n    </div>\n    <form class=\"questionnaire\" id=\"q-report\" aria-labelledby=\"q-dialog-title\">\n      <div class=\"questionnaire-progress\"></div>\n      <fieldset class=\"questionnaire-step\" data-step=\"area\">\n        <legend class=\"questionnaire-title\">Where did it happen?</legend>\n        <div class=\"questionnaire-choices\">\n          <label class=\"questionnaire-choice\"\n            ><input type=\"radio\" name=\"area\" value=\"web\" required /><span class=\"questionnaire-choice-label\"\n              >The website</span\n            ></label\n          >\n          <label class=\"questionnaire-choice\"\n            ><input type=\"radio\" name=\"area\" value=\"app\" /><span class=\"questionnaire-choice-label\"\n              >The mobile app</span\n            ></label\n          >\n        </div>\n      </fieldset>\n      <fieldset class=\"questionnaire-step\" data-step=\"what\">\n        <legend class=\"questionnaire-title\">What went wrong?</legend>\n        <textarea class=\"textarea\" name=\"what\" rows=\"3\" required aria-label=\"What went wrong\"></textarea>\n      </fieldset>\n      <fieldset class=\"questionnaire-step\" data-step=\"send\" data-end=\"\">\n        <legend class=\"questionnaire-title\">Send this report?</legend>\n        <div class=\"questionnaire-summary\"></div>\n      </fieldset>\n      <div class=\"questionnaire-actions\">\n        <button class=\"btn\" data-variant=\"ghost\" type=\"button\" data-questionnaire=\"back\">Back</button>\n        <button class=\"btn\" type=\"submit\" data-questionnaire=\"next\">Next</button>\n        <button class=\"btn\" type=\"submit\" data-questionnaire=\"submit\">Send report</button>\n      </div>\n    </form>\n  </div>\n</dialog>\n","individual":true},{"label":"Form Dialog","html":"<button class=\"btn\" data-variant=\"default\" data-dialog-trigger=\"edit-dialog\" aria-haspopup=\"dialog\">\n  Edit Profile\n</button>\n\n<dialog id=\"edit-dialog\" class=\"dialog\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"edit-title\">\n  <div class=\"dialog-content\">\n    <div class=\"dialog-header\">\n      <h2 class=\"dialog-title\" id=\"edit-title\">Edit Profile</h2>\n      <p class=\"dialog-description\">Make changes to your profile here.</p>\n    </div>\n    <div class=\"dialog-body\">\n      <div style=\"display: flex; flex-direction: column; gap: 1rem\">\n        <div>\n          <label class=\"label\" for=\"name\">Name</label>\n          <input class=\"input\" id=\"name\" type=\"text\" value=\"Aron Homberg\" />\n        </div>\n        <div>\n          <label class=\"label\" for=\"username\">Username</label>\n          <input class=\"input\" id=\"username\" type=\"text\" value=\"@kyr0\" />\n        </div>\n      </div>\n    </div>\n    <div class=\"dialog-footer\">\n      <button class=\"btn\" data-variant=\"outline\" data-dialog-close>Cancel</button>\n      <button class=\"btn\" data-variant=\"default\" data-dialog-close>Save changes</button>\n    </div>\n  </div>\n</dialog>\n","individual":false},{"label":"Confirmation","html":"<button class=\"btn\" data-variant=\"outline\" data-dialog-trigger=\"confirm-dialog\" aria-haspopup=\"dialog\">\n  Confirm Delete\n</button>\n\n<dialog id=\"confirm-dialog\" class=\"dialog\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"confirm-title\">\n  <div class=\"dialog-content\">\n    <div class=\"dialog-header\">\n      <h2 class=\"dialog-title\" id=\"confirm-title\">Delete account?</h2>\n      <p class=\"dialog-description\">This action cannot be undone. This will permanently delete your account.</p>\n    </div>\n    <div class=\"dialog-footer\">\n      <button class=\"btn\" data-variant=\"outline\" data-dialog-close>Cancel</button>\n      <button class=\"btn\" data-variant=\"destructive\" data-dialog-close>Delete account</button>\n    </div>\n  </div>\n</dialog>\n","individual":false},{"label":"Density","html":"<div style=\"display: flex; gap: 0.5rem; flex-wrap: wrap\">\n  <button class=\"btn\" data-variant=\"outline\" data-dialog-trigger=\"density-compact-dialog\" aria-haspopup=\"dialog\"\n    >Compact</button\n  >\n  <button class=\"btn\" data-variant=\"outline\" data-dialog-trigger=\"density-comfortable-dialog\" aria-haspopup=\"dialog\"\n    >Comfortable</button\n  >\n  <button class=\"btn\" data-variant=\"outline\" data-dialog-trigger=\"density-spacious-dialog\" aria-haspopup=\"dialog\"\n    >Spacious</button\n  >\n</div>\n\n<dialog\n  id=\"density-compact-dialog\"\n  class=\"dialog\"\n  data-density=\"compact\"\n  aria-labelledby=\"density-compact-dialog-title\"\n>\n  <div class=\"dialog-content\">\n    <div class=\"dialog-header\">\n      <h3 class=\"dialog-title\" id=\"density-compact-dialog-title\">Compact</h3>\n      <p class=\"dialog-description\">Content padding 1rem (ratio 0.75).</p>\n    </div>\n    <button class=\"btn\" data-variant=\"outline\" data-dialog-close>Close</button>\n  </div>\n</dialog>\n\n<dialog id=\"density-comfortable-dialog\" class=\"dialog\" aria-labelledby=\"density-comfortable-dialog-title\">\n  <div class=\"dialog-content\">\n    <div class=\"dialog-header\">\n      <h3 class=\"dialog-title\" id=\"density-comfortable-dialog-title\">Comfortable</h3>\n      <p class=\"dialog-description\">Content padding 1.5rem - matches the unsized default.</p>\n    </div>\n    <button class=\"btn\" data-variant=\"outline\" data-dialog-close>Close</button>\n  </div>\n</dialog>\n\n<dialog id=\"density-spacious-dialog\" class=\"dialog\" aria-labelledby=\"density-spacious-dialog-title\">\n  <div class=\"dialog-content\">\n    <div class=\"dialog-header\">\n      <h3 class=\"dialog-title\" id=\"density-spacious-dialog-title\">Spacious</h3>\n      <p class=\"dialog-description\">Content padding 2rem (ratio 1.25).</p>\n    </div>\n    <button class=\"btn\" data-variant=\"outline\" data-dialog-close>Close</button>\n  </div>\n</dialog>\n\n<!-- density scales ONLY the content padding - typography and the data-size width ladder stay identical -->\n","individual":false}]
