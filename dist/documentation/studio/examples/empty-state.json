[{"label":"Default","html":"<section class=\"mk-empty-state\" aria-labelledby=\"es-1\">\n  <span class=\"mk-empty-state-icon\" aria-hidden=\"true\"><i data-lucide=\"folder-open\"></i></span>\n  <h2 class=\"mk-empty-state-title\" id=\"es-1\">No projects yet</h2>\n  <p class=\"mk-empty-state-text\">Projects keep plans, docs and tasks together. Create one, or start from a template.</p>\n  <div class=\"mk-empty-state-actions\"\n    ><a class=\"btn\" href=\"#\"><i data-lucide=\"plus\"></i> New project</a\n    ><a class=\"btn\" data-variant=\"outline\" href=\"#\">Browse templates</a></div\n  >\n</section>\n","individual":true},{"label":"Dashed","html":"<section class=\"mk-empty-state\" data-variant=\"dashed\" aria-labelledby=\"es-2\">\n  <span class=\"mk-empty-state-icon\" aria-hidden=\"true\"><i data-lucide=\"upload-cloud\"></i></span>\n  <h2 class=\"mk-empty-state-title\" id=\"es-2\">Drop files to attach them</h2>\n  <p class=\"mk-empty-state-text\">PDF, images or docs up to 50 MB.</p>\n  <div class=\"mk-empty-state-actions\"><a class=\"btn\" data-variant=\"outline\" href=\"#\">Choose files</a></div>\n</section>\n","individual":true},{"label":"Compact","html":"<div style=\"border: 1px solid var(--border); border-radius: var(--radius-lg); width: 100%\">\n  <section class=\"mk-empty-state\" data-variant=\"compact\" aria-labelledby=\"es-3\">\n    <span class=\"mk-empty-state-icon\" aria-hidden=\"true\"><i data-lucide=\"search-x\"></i></span>\n    <h2 class=\"mk-empty-state-title\" id=\"es-3\">No tasks match \"launch\"</h2>\n    <p class=\"mk-empty-state-text\">Try another word or clear the filters.</p>\n    <div class=\"mk-empty-state-actions\"\n      ><a class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" href=\"#\">Clear filters</a></div\n    >\n  </section>\n</div>\n","individual":true}]
