[{"label":"Default","html":"<section\n  class=\"presentation\"\n  id=\"qbr-deck\"\n  data-anim-in=\"slideIn\"\n  data-anim-out=\"slideOut\"\n  tabindex=\"-1\"\n  aria-label=\"Quarterly business review\"\n>\n  <!-- the cover stays static: it is the deck's resting face (and the docs\n       screenshot) - entrances belong to the slides that follow -->\n  <section class=\"slide\" data-slide id=\"cover\" data-theme=\"ink\" aria-label=\"Cover\">\n    <p class=\"presentation-eyebrow\">Q3 · Quarterly Business Review</p>\n    <h1 class=\"presentation-title\">Momentum, measured</h1>\n    <p class=\"presentation-lede\">Results, adoption and the road to 2027</p>\n    <p class=\"presentation-note\">One number to remember: 77. Everything else supports it.</p>\n  </section>\n  <section class=\"slide\" data-slide id=\"agenda\" data-theme=\"paper\" aria-label=\"Agenda\">\n    <header class=\"presentation-header\"><span>Agenda</span><span>4 topics</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 170ms;\n        margin: 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.7;\n      \"\n    >\n      <li data-df-entrance=\"up\">Where we landed - the quarter in numbers</li>\n      <li data-df-entrance=\"up\">Adoption - the product-market signal</li>\n      <li data-df-entrance=\"up\">Efficiency - what the platform saved</li>\n      <li data-df-entrance=\"up\">The road to 2027 - three bets</li>\n    </ul>\n    <p class=\"presentation-note\">Thirty seconds - do not walk the list.</p>\n  </section>\n  <section class=\"slide\" data-slide id=\"metrics\" data-theme=\"ink\" aria-label=\"Key metrics\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Where we landed</p>\n    <div data-df-stagger style=\"--df-motion-stagger-step: 240ms; display: flex; gap: 5rem\">\n      <div data-df-entrance=\"up\">\n        <h2 class=\"presentation-title\" style=\"font-size: 4.5rem; margin-block-end: 0.5rem\"\n          ><span data-count=\"77\">77</span>%</h2\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem\">customer optimism</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <h2 class=\"presentation-title\" style=\"font-size: 4.5rem; margin-block-end: 0.5rem\"\n          ><span data-count=\"124\" data-count-duration=\"1100\">124</span>k</h2\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem\">weekly activations</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <h2 class=\"presentation-title\" style=\"font-size: 4.5rem; margin-block-end: 0.5rem\"\n          ><span data-count=\"2.4\" data-count-decimals=\"1\">2.4</span>×</h2\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem\">throughput per pod</p>\n      </div>\n    </div>\n    <p class=\"presentation-note\">Let the counters run - narrate the 2.4×.</p>\n  </section>\n  <section class=\"slide\" data-slide id=\"trend\" data-theme=\"paper\" aria-label=\"Adoption trend\">\n    <header class=\"presentation-header\"><span>Adoption</span><span>6 quarters</span></header>\n    <h2 class=\"presentation-title\" data-df-entrance=\"left\" style=\"font-size: 3.5rem\">Adoption is compounding</h2>\n    <svg\n      width=\"1100\"\n      height=\"300\"\n      viewBox=\"0 0 1100 300\"\n      fill=\"none\"\n      aria-hidden=\"true\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms\"\n    >\n      <g stroke=\"color-mix(in oklch, currentColor 20%, transparent)\" stroke-width=\"2\">\n        <line x1=\"20\" y1=\"75\" x2=\"1080\" y2=\"75\" />\n        <line x1=\"20\" y1=\"150\" x2=\"1080\" y2=\"150\" />\n        <line x1=\"20\" y1=\"225\" x2=\"1080\" y2=\"225\" />\n      </g>\n      <path\n        data-df-draw\n        pathLength=\"1\"\n        stroke=\"var(--presentation-accent)\"\n        stroke-width=\"7\"\n        stroke-linecap=\"round\"\n        d=\"M20 260 C 260 250, 480 190, 640 120 S 950 30, 1080 18\"\n      />\n    </svg>\n    <p class=\"presentation-lede\" data-df-entrance=\"fade\" style=\"--df-motion-delay: 900ms; font-size: 1.6rem\"\n      >Weekly active teams - no plateau in sight.</p\n    >\n    <p class=\"presentation-note\">Point at the inflection, not the axis.</p>\n  </section>\n  <section class=\"slide\" data-slide id=\"revenue\" data-theme=\"ink\" aria-label=\"Revenue chart\">\n    <header class=\"presentation-header\"><span>Where we landed</span><span>Revenue · FY 2026</span></header>\n    <h2 class=\"presentation-title\" data-df-entrance=\"left\" style=\"font-size: 3.5rem\">Revenue follows adoption</h2>\n    <div\n      class=\"chart\"\n      id=\"qbr-revenue-chart\"\n      role=\"img\"\n      aria-label=\"Bar chart of quarterly revenue: 4.2, 5.1, 6.3 and a forecast 7.4 million dollars\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 250ms; width: 100%; height: 520px\"\n    ></div>\n    <p class=\"presentation-note\">Q4 is the forecast - say it out loud.</p>\n  </section>\n  <section class=\"slide\" data-slide id=\"numbers\" data-theme=\"paper\" aria-label=\"Quarterly numbers\">\n    <header class=\"presentation-header\"><span>Where we landed</span><span>The numbers</span></header>\n    <h2 class=\"presentation-title\" data-df-entrance=\"up\" style=\"font-size: 3.5rem\">The quarter, in rows</h2>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"--df-motion-delay: 250ms\">\n      <table class=\"table\" data-density=\"spacious\" style=\"font-size: 1.9rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.4rem\">FY 2026 quarterly results - synthetic data.</caption>\n        <thead>\n          <tr class=\"table-row\">\n            <th class=\"table-head\" scope=\"col\">Quarter</th>\n            <th class=\"table-head\" scope=\"col\" style=\"text-align: right\">Revenue</th>\n            <th class=\"table-head\" scope=\"col\" style=\"text-align: right\">Weekly activations</th>\n            <th class=\"table-head\" scope=\"col\" style=\"text-align: right\">Customer optimism</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr class=\"table-row\">\n            <td class=\"table-cell\">Q1</td>\n            <td class=\"table-cell\" style=\"text-align: right\">$4.2M</td>\n            <td class=\"table-cell\" style=\"text-align: right\">96k</td>\n            <td class=\"table-cell\" style=\"text-align: right\">71%</td>\n          </tr>\n          <tr class=\"table-row\">\n            <td class=\"table-cell\">Q2</td>\n            <td class=\"table-cell\" style=\"text-align: right\">$5.1M</td>\n            <td class=\"table-cell\" style=\"text-align: right\">104k</td>\n            <td class=\"table-cell\" style=\"text-align: right\">73%</td>\n          </tr>\n          <tr class=\"table-row\">\n            <td class=\"table-cell\">Q3</td>\n            <td class=\"table-cell\" style=\"text-align: right\">$6.3M</td>\n            <td class=\"table-cell\" style=\"text-align: right\">124k</td>\n            <td class=\"table-cell\" style=\"text-align: right\">77%</td>\n          </tr>\n          <tr class=\"table-row\">\n            <td class=\"table-cell\">Q4 · forecast</td>\n            <td class=\"table-cell\" style=\"text-align: right\">$7.4M</td>\n            <td class=\"table-cell\" style=\"text-align: right\">139k</td>\n            <td class=\"table-cell\" style=\"text-align: right\">79%</td>\n          </tr>\n        </tbody>\n        <tfoot>\n          <tr class=\"table-row\">\n            <td class=\"table-cell\">FY total</td>\n            <td class=\"table-cell\" style=\"text-align: right; font-weight: 600\">$23.0M</td>\n            <td class=\"table-cell\" style=\"text-align: right\">—</td>\n            <td class=\"table-cell\" style=\"text-align: right\">—</td>\n          </tr>\n        </tfoot>\n      </table>\n    </div>\n    <p class=\"presentation-note\">Q3 is the quarter under review - the rest is trajectory.</p>\n  </section>\n  <section class=\"slide\" data-slide id=\"demo\" data-theme=\"ink\" aria-label=\"Product demo\">\n    <header class=\"presentation-header\"><span>Adoption</span><span>Product demo</span></header>\n    <h2 class=\"presentation-title\" data-df-entrance=\"up\" style=\"font-size: 3.5rem\">See the platform move</h2>\n    <figure\n      class=\"mk-showcase\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 250ms; max-width: 1040px; aspect-ratio: 16/9\"\n    >\n      <img class=\"mk-showcase-poster\" alt=\"Product showcase\" src=\"images/mk-wide2.png\" />\n      <video src=\"videos/demo.webm\" muted loop playsinline>Your browser does not support embedded video.</video>\n      <button type=\"button\" class=\"mk-showcase-play\" aria-label=\"Play video\">\n        <svg\n          viewBox=\"0 0 24 24\"\n          width=\"24\"\n          height=\"24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"2\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          aria-hidden=\"true\"\n        >\n          <polygon points=\"6 3 20 12 6 21 6 3\"></polygon>\n        </svg>\n      </button>\n    </figure>\n    <p class=\"presentation-note\">The loop starts on activation and stops when you move on - watch the poster return.</p>\n  </section>\n  <section class=\"slide\" data-slide id=\"quote\" data-theme=\"ink\" aria-label=\"Customer quote\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0\">\n      <p class=\"presentation-title\" style=\"font-size: 3.2rem; line-height: 1.25\"\n        >\"We stopped debating the roadmap - the platform just tells us.\"</p\n      >\n    </blockquote>\n    <footer data-df-entrance=\"fade\" style=\"--df-motion-delay: 700ms; display: flex; align-items: center; gap: 1.5rem\">\n      <span class=\"avatar\" data-size=\"xl\" style=\"width: 6rem; height: 6rem\">\n        <span class=\"avatar-fallback\" style=\"font-size: 2.2rem\">MK</span>\n      </span>\n      <p class=\"presentation-lede\" style=\"font-family: var(--font-mono); font-size: 1.4rem\"\n        >Mara Kessler - VP Platform (n = <span data-count=\"118\">118</span> interviews)</p\n      >\n    </footer>\n    <p class=\"presentation-note\">Pause two beats after the quote.</p>\n  </section>\n  <section class=\"slide\" data-slide id=\"takeaways\" data-theme=\"paper\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>The road to 2027</span><span>Takeaways</span></header>\n    <h2 class=\"presentation-title\" data-df-entrance=\"up\" style=\"font-size: 3.5rem\">What we do with this</h2>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 200ms;\n        margin: 2rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.7;\n      \"\n    >\n      <li data-df-entrance=\"up\">Double the pods behind the 2.4× throughput play</li>\n      <li data-df-entrance=\"up\">Fund the adoption loop - it compounds</li>\n      <li data-df-entrance=\"up\">Hold the Q4 forecast to the 7.4 it just promised</li>\n    </ul>\n    <p class=\"presentation-note\">Three commitments, one slide - land each with a name.</p>\n  </section>\n  <section class=\"slide\" data-slide id=\"close\" data-theme=\"ink\" aria-label=\"Closing\">\n    <h2 class=\"presentation-title\" data-df-entrance=\"pop\" style=\"--df-motion-ease: var(--presentation-spring)\"\n      >Three bets, one number</h2\n    >\n    <p class=\"presentation-lede\" data-df-entrance=\"up\" style=\"--df-motion-delay: 300ms\"\n      >Questions - <span data-count=\"4.5\" data-count-decimals=\"1\">4.5</span> minutes on the clock.</p\n    >\n    <p class=\"presentation-note\">Keep close under two minutes.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 10</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"10\" value=\"1\"></progress>\n</section>\n","individual":true},{"label":"Slide chrome + Art direction","html":"<style>\n  #kestrel .k-list {\n    margin: 2.5rem 0 0;\n    padding: 0;\n    list-style: none;\n    display: grid;\n    gap: 1.1rem;\n    font-size: 2.1rem;\n  }\n  #kestrel .k-list li {\n    display: flex;\n    align-items: baseline;\n    gap: 1.4rem;\n  }\n  #kestrel .k-list b {\n    font: 700 1.3rem/1 var(--font-mono);\n    color: var(--presentation-accent);\n  }\n  #kestrel .k-swatches {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 1.5rem;\n    margin-top: 2.5rem;\n  }\n  #kestrel .k-swatch {\n    height: 17rem;\n    border-radius: 1.5rem;\n    padding: 1.5rem;\n    display: flex;\n    flex-direction: column;\n    justify-content: flex-end;\n    font: 600 1.35rem/1.4 var(--font-mono);\n    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.18) inset;\n  }\n  #kestrel .k-swatch span {\n    display: block;\n    font: 700 2rem/1.1 var(--font-sans);\n    margin-bottom: 0.35rem;\n  }\n  #kestrel .k-type {\n    display: grid;\n    grid-template-columns: 17rem 1fr;\n    gap: 3rem;\n    align-items: center;\n    margin-top: 2rem;\n  }\n  #kestrel .k-aa {\n    font: 800 15rem/0.85 var(--font-serif);\n    letter-spacing: -0.04em;\n    color: var(--presentation-accent);\n  }\n  #kestrel .k-scale {\n    display: grid;\n    gap: 1.1rem;\n  }\n  #kestrel .k-scale p {\n    margin: 0;\n    display: flex;\n    align-items: baseline;\n    gap: 1.2rem;\n  }\n  #kestrel .k-scale small {\n    font: 600 1.1rem var(--font-mono);\n    opacity: 0.6;\n    min-width: 6rem;\n  }\n  #kestrel .k-chips {\n    display: flex;\n    gap: 1.5rem;\n    margin-top: 3rem;\n  }\n  #kestrel .k-chip {\n    flex: 1;\n    padding: 2rem 1.5rem;\n    border-radius: 1.5rem;\n    background: rgba(244, 114, 182, 0.14);\n    border: 2px solid rgba(244, 114, 182, 0.5);\n    text-align: center;\n    font: 700 1.8rem/1.2 var(--font-sans);\n  }\n  #kestrel .k-chip code {\n    display: block;\n    margin-top: 0.6rem;\n    font: 600 1.1rem var(--font-mono);\n    opacity: 0.75;\n  }\n</style>\n<section\n  class=\"presentation\"\n  id=\"kestrel\"\n  tabindex=\"-1\"\n  aria-label=\"Kestrel - brand kickoff\"\n  data-anim-in=\"slideIn\"\n  data-anim-in-distance=\"120px\"\n  data-anim-out=\"fadeOut\"\n  style=\"\n    --presentation-width: 1024;\n    --presentation-height: 768;\n    --presentation-ink: #0a1e4a;\n    --presentation-ink-foreground: #f5f7ff;\n    --presentation-paper: #fff7ed;\n    --presentation-paper-foreground: #1c1917;\n    --presentation-accent: #f472b6;\n    --df-motion-duration: 900ms;\n    --df-motion-distance: 3rem;\n  \"\n>\n  <!-- 1 · cover -->\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Cover\">\n    <header class=\"presentation-header\"><span>Design</span><span>Kickoff</span></header>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Kestrel · brand refresh</p>\n    <h1 class=\"presentation-title\" data-df-entrance=\"wipe\" style=\"font-size: 6.5rem\">A new<br />identity</h1>\n    <p class=\"presentation-lede\" data-df-entrance=\"up\" style=\"--df-motion-delay: 250ms\"\n      >One artboard, two palettes, ownable everywhere.</p\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Lead with the palette story.</p>\n  </section>\n  <!-- 2 · agenda: a staggered list -->\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Agenda\">\n    <header class=\"presentation-header\"><span>Design</span><span>Agenda</span></header>\n    <h2 class=\"presentation-title\" data-df-entrance=\"up\">Four decisions today</h2>\n    <ol class=\"k-list\" data-df-stagger style=\"--df-motion-stagger-step: 160ms\">\n      <li data-df-entrance=\"left\"><b>01</b>Palette - ink, paper, one accent</li>\n      <li data-df-entrance=\"left\"><b>02</b>Type - a serif display, a sans for work</li>\n      <li data-df-entrance=\"left\"><b>03</b>Motion - everything enters, nothing jumps</li>\n      <li data-df-entrance=\"left\"><b>04</b>Voice - short, warm, specific</li>\n    </ol>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Time-box each decision to ten minutes.</p>\n  </section>\n  <!-- 3 · palette: the deck's own surface values, shown as swatches -->\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Palette\">\n    <header class=\"presentation-header\"><span>01 · Palette</span><span>Two surfaces, one accent</span></header>\n    <h2 class=\"presentation-title\" data-df-entrance=\"up\" style=\"font-size: 4.2rem\">The palette is the brand</h2>\n    <div class=\"k-swatches\" data-df-stagger style=\"--df-motion-stagger-step: 180ms\">\n      <div class=\"k-swatch\" data-df-entrance=\"pop\" style=\"background: #0a1e4a; color: #f5f7ff\"\n        ><span>Ink</span>#0A1E4A</div\n      >\n      <div class=\"k-swatch\" data-df-entrance=\"pop\" style=\"background: #fff7ed; color: #1c1917\"\n        ><span>Paper</span>#FFF7ED</div\n      >\n      <div class=\"k-swatch\" data-df-entrance=\"pop\" style=\"background: #f472b6; color: #1c1917\"\n        ><span>Accent</span>#F472B6</div\n      >\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">These are the deck's --presentation-* values - the site theme never changes.</p>\n  </section>\n  <!-- 4 · type: specimen + scale -->\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Type\">\n    <header class=\"presentation-header\"><span>02 · Type</span><span>Serif display, sans for work</span></header>\n    <h2 class=\"presentation-title\" data-df-entrance=\"up\" style=\"font-size: 4.2rem\">A voice you can read</h2>\n    <div class=\"k-type\">\n      <div class=\"k-aa\" data-df-entrance=\"zoom\" aria-hidden=\"true\">Aa</div>\n      <div class=\"k-scale\" data-df-stagger style=\"--df-motion-stagger-step: 140ms\">\n        <p data-df-entrance=\"up\" style=\"font: 700 3.2rem/1 var(--font-serif)\"><small>Display</small>Kestrel</p>\n        <p data-df-entrance=\"up\" style=\"font: 700 2.2rem/1.1 var(--font-sans)\"><small>Title</small>Brand refresh</p>\n        <p data-df-entrance=\"up\" style=\"font: 400 1.5rem/1.4 var(--font-sans)\"\n          ><small>Body</small>Short, warm and specific.</p\n        >\n      </div>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The specimen zooms in; the scale steps in underneath.</p>\n  </section>\n  <!-- 5 · motion: three entrances, one timing -->\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Motion\">\n    <header class=\"presentation-header\"><span>03 · Motion</span><span>900 ms, 3rem drift</span></header>\n    <h2 class=\"presentation-title\" data-df-entrance=\"up\" style=\"font-size: 4.2rem\"\n      >Everything enters,<br />nothing jumps</h2\n    >\n    <div class=\"k-chips\" data-df-stagger style=\"--df-motion-stagger-step: 220ms\">\n      <div class=\"k-chip\" data-df-entrance=\"spin\">Spin<code>spin</code></div>\n      <div class=\"k-chip\" data-df-entrance=\"pop\">Pop<code>pop</code></div>\n      <div class=\"k-chip\" data-df-entrance=\"blur\">Focus<code>blur</code></div>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">One --df-motion-duration on the deck times every entrance.</p>\n  </section>\n  <!-- 6 · closing -->\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Closing\">\n    <header class=\"presentation-header\"><span>04 · Voice</span><span>Next</span></header>\n    <h2 class=\"presentation-title\" data-df-entrance=\"flip\" style=\"font-size: 7rem\">Ship it</h2>\n    <p class=\"presentation-lede\" data-df-entrance=\"up\" style=\"--df-motion-delay: 250ms\"\n      >Palette, type and motion locked - voice guide by Friday.</p\n    >\n    <p data-df-entrance=\"up\" style=\"--df-motion-delay: 450ms; display: flex; gap: 1rem; margin: 2.5rem 0 0\">\n      <button type=\"button\" class=\"btn\" data-size=\"lg\" style=\"font-size: 1.4rem; height: 3.6rem; padding-inline: 1.9rem\"\n        >Approve</button\n      >\n      <button\n        type=\"button\"\n        class=\"btn\"\n        data-variant=\"outline\"\n        data-size=\"lg\"\n        style=\"font-size: 1.4rem; height: 3.6rem; padding-inline: 1.9rem\"\n        >Request changes</button\n      >\n    </p>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">End on the ask.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 6</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"6\" value=\"1\"></progress>\n</section>\n","individual":true},{"label":"Chart story deck","html":"<section\n  class=\"presentation\"\n  id=\"story-deck\"\n  data-anim-in=\"slideIn\"\n  data-anim-in-distance=\"120px\"\n  data-anim-out=\"fadeOut\"\n  tabindex=\"-1\"\n  aria-label=\"Chart story\"\n>\n  <!-- ONE chart for the whole deck: every data-chart-state below is a state\n       of this instance, so moving between chart slides MORPHS the chart -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Adoption by product line, morphing from baseline bars to a comparison with last year and to a composition donut\"\n  ></div>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"baseline\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Baseline\"\n  >\n    <header class=\"presentation-header\"><span>Chart story</span><span>1 · Baseline</span></header>\n    <h2 class=\"presentation-title\" data-df-entrance=\"up\" style=\"font-size: 3.4rem; margin-block-start: 5.25rem\"\n      >Alpha leads adoption</h2\n    >\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"compare\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Comparison\"\n  >\n    <header class=\"presentation-header\"><span>Chart story</span><span>2 · Comparison</span></header>\n    <h2 class=\"presentation-title\" data-df-entrance=\"up\" style=\"font-size: 3.4rem; margin-block-start: 5.25rem\"\n      >Every line grew on last year</h2\n    >\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"share\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Composition\"\n  >\n    <header class=\"presentation-header\"><span>Chart story</span><span>3 · Composition</span></header>\n    <h2 class=\"presentation-title\" data-df-entrance=\"up\" style=\"font-size: 3.4rem; margin-block-start: 5.25rem\"\n      >Alpha is a third of the total</h2\n    >\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-blocks=\"6\"\n    aria-label=\"Closing\"\n  >\n    <h2 class=\"presentation-title\" data-df-entrance=\"pop\">Three claims, one chart</h2>\n    <p class=\"presentation-lede\" data-df-entrance=\"up\" style=\"--df-motion-delay: 300ms\"\n      >The curtain colour is picked to contrast with both slides.</p\n    >\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 4</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"4\" value=\"1\"></progress>\n</section>\n","individual":true},{"label":"Live data slide","html":"<section class=\"presentation\" id=\"live-deck\" tabindex=\"-1\" aria-label=\"Live data deck\">\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Intro\">\n    <header class=\"presentation-header\"><span>Regionals</span><span>Live data</span></header>\n    <h1 class=\"presentation-title\" data-df-entrance=\"up\">Rankings, live</h1>\n    <p class=\"presentation-lede\" data-df-entrance=\"up\" style=\"--df-motion-delay: 250ms\"\n      >Next slide starts the race - leaving the slide stops it.</p\n    >\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Bar race\" id=\"race-slide\">\n    <header class=\"presentation-header\"><span>Regionals</span><span>Animated ranking</span></header>\n    <div\n      class=\"chart\"\n      id=\"race-chart\"\n      role=\"img\"\n      aria-label=\"Animated bar race of six regions over six time steps\"\n      style=\"height: 30rem\"\n    ></div>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Closing\">\n    <h2 class=\"presentation-title\" data-df-entrance=\"pop\">North keeps the lead</h2>\n    <p class=\"presentation-lede\" data-df-entrance=\"up\" style=\"--df-motion-delay: 300ms\"\n      >Six steps, one overtaking - the rank change is the story.</p\n    >\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 3</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"3\" value=\"1\"></progress>\n</section>\n","individual":true},{"label":"Imperative control","html":"<div id=\"deck-host\"></div>\n<section class=\"presentation\" id=\"api-deck\" aria-label=\"API deck\" style=\"--df-motion-duration: 500ms\">\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"One\">\n    <h2 class=\"presentation-title\" data-df-entrance=\"up\">Slide one</h2>\n    <p class=\"presentation-lede\" data-df-entrance=\"up\" style=\"--df-motion-delay: 200ms\"\n      >api.setState('default', { index: 1 })</p\n    >\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Two\">\n    <h2 class=\"presentation-title\" data-df-entrance=\"iris\">Slide two</h2>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Three\">\n    <h2 class=\"presentation-title\" data-df-entrance=\"wipe\">Slide three</h2>\n  </section>\n</section>\n<div style=\"display: flex; gap: 0.5rem\">\n  <button class=\"btn\" data-size=\"sm\" onclick=\"ddf$.presentation(document.getElementById('api-deck')).next()\"\n    >ddf$.presentation(deck).next()</button\n  >\n  <button\n    class=\"btn\"\n    data-size=\"sm\"\n    data-variant=\"outline\"\n    onclick=\"document.getElementById('api-deck').api.setState('default', { index: 0 })\"\n    >back to start</button\n  >\n</div>\n","individual":false}]
