[{"label":"Kiln & Bean, coffee roasters","html":"<style>\n  @import url('https://fonts.googleapis.com/css2?family=Abril+Fatface&family=Work+Sans:wght@400;500;700&family=DM+Mono:wght@400;500&display=swap');\n  /* Kiln & Bean: a roaster that roasts once a week. Layout: a hero split around the cup, a band of green coffees as\n     tickets, a subscription in a speech bubble, the roast days as a calendar strip. */\n  #sc-roastery {\n    --background: oklch(0.2 0.025 45);\n    --foreground: oklch(0.94 0.025 80);\n    --card: oklch(0.25 0.03 45);\n    --card-foreground: var(--foreground);\n    --muted: oklch(0.28 0.03 45);\n    --muted-foreground: oklch(0.76 0.04 70);\n    --border: oklch(0.38 0.04 50);\n    --input: var(--border);\n    --primary: oklch(0.8 0.11 75);\n    --primary-foreground: oklch(0.2 0.025 45);\n    --secondary: oklch(0.3 0.035 45);\n    --secondary-foreground: var(--foreground);\n    --accent: oklch(0.8 0.11 75);\n    --accent-foreground: oklch(0.2 0.025 45);\n    --ring: var(--primary);\n    --radius: 0.5rem;\n    --radius-sm: max(0px, calc(var(--radius) - 4px));\n    --radius-md: max(0px, calc(var(--radius) - 2px));\n    --radius-lg: var(--radius);\n    --radius-xl: calc(var(--radius) + 4px);\n    --kb-ticket: oklch(0.9 0.04 80);\n    --kb-ticket-ink: oklch(0.22 0.03 45);\n    --kb-bubble: oklch(0.8 0.11 75);\n    --kb-bubble-ink: oklch(0.2 0.025 45);\n    color-scheme: dark;\n    box-sizing: border-box;\n    width: 100%;\n    overflow-x: clip;\n    padding: clamp(1rem, 3vw, 2.5rem);\n    background: var(--background);\n    color: var(--foreground);\n    font-family: 'Work Sans', var(--font-sans);\n  }\n  #sc-roastery[data-look='blond'] {\n    color-scheme: light;\n    --background: oklch(0.955 0.025 225);\n    --foreground: oklch(0.27 0.06 250);\n    --card: oklch(0.985 0.012 225);\n    --muted: oklch(0.92 0.03 225);\n    --muted-foreground: oklch(0.45 0.05 245);\n    --border: oklch(0.27 0.06 250 / 0.22);\n    --primary: oklch(0.45 0.13 250);\n    --primary-foreground: oklch(0.985 0.012 225);\n    --secondary: oklch(0.92 0.03 225);\n    --secondary-foreground: oklch(0.27 0.06 250);\n    --accent: oklch(0.86 0.1 75);\n    --accent-foreground: oklch(0.27 0.06 250);\n    --kb-ticket: oklch(0.86 0.1 75);\n    --kb-ticket-ink: oklch(0.27 0.06 250);\n    --kb-bubble: oklch(0.45 0.13 250);\n    --kb-bubble-ink: oklch(0.985 0.012 225);\n  }\n  #sc-roastery[data-look='cherry'] {\n    color-scheme: light;\n    --background: oklch(0.6 0.2 25);\n    --foreground: oklch(0.98 0.02 60);\n    --card: oklch(0.55 0.19 25);\n    --muted: oklch(0.53 0.18 25);\n    --muted-foreground: oklch(0.92 0.04 50);\n    --border: oklch(0.98 0.02 60 / 0.35);\n    --primary: oklch(0.35 0.08 150);\n    --primary-foreground: oklch(0.98 0.02 60);\n    --secondary: oklch(0.53 0.18 25);\n    --secondary-foreground: var(--foreground);\n    --accent: oklch(0.35 0.08 150);\n    --accent-foreground: oklch(0.98 0.02 60);\n    --kb-ticket: oklch(0.98 0.02 60);\n    --kb-ticket-ink: oklch(0.45 0.17 25);\n    --kb-bubble: oklch(0.35 0.08 150);\n    --kb-bubble-ink: oklch(0.98 0.02 60);\n  }\n  #sc-roastery .kb-page {\n    display: flex;\n    flex-direction: column;\n    gap: clamp(3.5rem, 8vw, 6rem);\n    max-width: 72rem;\n    margin-inline: auto;\n  }\n  #sc-roastery [hidden] {\n    display: none !important;\n  }\n  /* the Site Header: the name in Abril, the sections, the look and the mode */\n  #sc-roastery .mk-header {\n    background: none;\n    color: inherit;\n  }\n  #sc-roastery .mk-header-inner {\n    flex-wrap: wrap;\n    gap: 0.75rem 1.5rem;\n    max-width: none;\n    min-height: 4.5rem;\n    padding: 0;\n  }\n  #sc-roastery .mk-header-brand {\n    color: inherit;\n  }\n  #sc-roastery :is(.mk-header-name, .mk-footer-brand-name) {\n    color: inherit;\n    font:\n      400 1.6rem/1 'Abril Fatface',\n      Georgia,\n      serif;\n  }\n  #sc-roastery .mk-header-nav {\n    display: flex;\n    margin-inline-start: auto;\n  }\n  #sc-roastery .nav-menu-link {\n    color: inherit;\n    font-size: 0.9375rem;\n  }\n  #sc-roastery .mk-header-actions {\n    gap: 0.5rem;\n  }\n  /* the hero: the promise, the cup with its steam, the turning stamp */\n  #sc-roastery .kb-hero {\n    display: grid;\n    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);\n    align-items: center;\n    gap: clamp(2rem, 5vw, 4rem);\n  }\n  #sc-roastery .kb-hero h1 {\n    margin: 0;\n    font:\n      400 clamp(3rem, 8vw, 6.25rem)/0.95 'Abril Fatface',\n      Georgia,\n      serif;\n    letter-spacing: -0.01em;\n    text-wrap: balance;\n  }\n  #sc-roastery .kb-hero h1 em {\n    font-style: normal;\n    color: var(--primary);\n  }\n  #sc-roastery .kb-hero p {\n    max-width: 34rem;\n    font-size: 1.125rem;\n    line-height: 1.6;\n    color: var(--muted-foreground);\n  }\n  #sc-roastery .kb-actions {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.75rem;\n  }\n  #sc-roastery .kb-cup {\n    position: relative;\n    isolation: isolate;\n    aspect-ratio: 4 / 5;\n  }\n  #sc-roastery .kb-cup img {\n    position: absolute;\n    inset: 22% 0 0;\n    width: 100%;\n    height: 78%;\n    object-fit: cover;\n    border-radius: 50% 50% var(--radius-xl) var(--radius-xl) / 18% 18% var(--radius-xl) var(--radius-xl);\n  }\n  #sc-roastery .kb-steam {\n    position: absolute;\n    z-index: 1;\n    inset: -6% 8% 46%;\n    width: 84%;\n    height: 60%;\n    mask-image: radial-gradient(45% 55% at 50% 62%, #000 25%, transparent 72%);\n    pointer-events: none;\n  }\n  #sc-roastery .kb-stamp {\n    position: absolute;\n    z-index: 2;\n    left: -2.5rem;\n    bottom: 1.5rem;\n    width: 8.5rem;\n    aspect-ratio: 1;\n    color: var(--primary);\n    animation: kb-turn 22s linear infinite;\n  }\n  #sc-roastery .kb-stamp text {\n    font:\n      500 9.4px/1 'DM Mono',\n      monospace;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    fill: currentColor;\n  }\n  #sc-roastery .kb-stamp circle {\n    fill: none;\n    stroke: currentColor;\n  }\n  @keyframes kb-turn {\n    to {\n      rotate: 360deg;\n    }\n  }\n  /* the green coffees as tickets: origin, altitude, process, the notes the cupping table found */\n  #sc-roastery .kb-section-head {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: baseline;\n    justify-content: space-between;\n    gap: 0.5rem 2rem;\n    margin-block-end: 1.5rem;\n  }\n  #sc-roastery .kb-section-head h2 {\n    margin: 0;\n    font:\n      400 clamp(2rem, 4vw, 3rem)/1 'Abril Fatface',\n      Georgia,\n      serif;\n  }\n  #sc-roastery .kb-section-head p {\n    margin: 0;\n    color: var(--muted-foreground);\n  }\n  #sc-roastery .kb-coffees {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));\n    gap: 1.75rem;\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n  #sc-roastery .kb-coffee {\n    --shape-cut: 0.85rem;\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) auto;\n    gap: 0.5rem 1rem;\n    padding: 1.4rem 1.75rem;\n    background: var(--kb-ticket);\n    color: var(--kb-ticket-ink);\n    font-family: 'DM Mono', monospace;\n    font-size: 0.8125rem;\n  }\n  #sc-roastery .kb-coffee:nth-child(1) {\n    rotate: -1.5deg;\n  }\n  #sc-roastery .kb-coffee:nth-child(2) {\n    rotate: 1deg;\n    translate: 0 0.6rem;\n  }\n  #sc-roastery .kb-coffee:nth-child(3) {\n    rotate: -0.6deg;\n  }\n  #sc-roastery .kb-coffee h3 {\n    grid-column: 1 / -1;\n    margin: 0;\n    font:\n      400 1.75rem/1.05 'Abril Fatface',\n      Georgia,\n      serif;\n  }\n  #sc-roastery .kb-coffee dl {\n    display: grid;\n    grid-template-columns: auto 1fr;\n    gap: 0.2rem 0.75rem;\n    margin: 0;\n  }\n  #sc-roastery .kb-coffee dt {\n    opacity: 0.7;\n    text-transform: uppercase;\n    letter-spacing: 0.08em;\n    font-size: 0.6875rem;\n    padding-block-start: 0.1rem;\n  }\n  #sc-roastery .kb-coffee dd {\n    margin: 0;\n  }\n  #sc-roastery .kb-score {\n    align-self: start;\n    display: grid;\n    place-items: center;\n    width: 3.6rem;\n    aspect-ratio: 1;\n    border: 2px dashed currentColor;\n    border-radius: 50%;\n    font-weight: 500;\n    font-size: 1rem;\n    rotate: 8deg;\n  }\n  #sc-roastery .kb-notes {\n    grid-column: 1 / -1;\n    margin: 0.4rem 0 0;\n    padding-block-start: 0.6rem;\n    border-block-start: 1.5px dashed currentColor;\n    font-family: 'Work Sans', sans-serif;\n    font-size: 0.9375rem;\n  }\n  /* the subscription, said */\n  #sc-roastery .kb-subscribe {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n    align-items: center;\n    gap: clamp(2rem, 5vw, 4rem);\n  }\n  #sc-roastery .kb-bubble {\n    position: relative;\n    margin: 0;\n    padding: clamp(1.5rem, 4vw, 2.5rem);\n    border-radius: 2rem;\n    background: var(--kb-bubble);\n    color: var(--kb-bubble-ink);\n    font:\n      400 clamp(1.6rem, 3.5vw, 2.4rem)/1.15 'Abril Fatface',\n      Georgia,\n      serif;\n    rotate: -2deg;\n  }\n  #sc-roastery .kb-bubble::after {\n    content: '';\n    position: absolute;\n    right: 3rem;\n    bottom: -1.4rem;\n    width: 2.2rem;\n    height: 1.5rem;\n    background: inherit;\n    clip-path: polygon(0 0, 100% 0, 85% 100%);\n  }\n  #sc-roastery .kb-plan {\n    display: grid;\n    gap: 1rem;\n  }\n  #sc-roastery .kb-plan ol {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 0.5rem;\n    margin: 0;\n    padding: 0;\n    list-style: none;\n    font-family: 'DM Mono', monospace;\n    font-size: 0.8125rem;\n  }\n  #sc-roastery .kb-plan li {\n    display: grid;\n    gap: 0.25rem;\n    padding: 0.75rem;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-md);\n  }\n  #sc-roastery .kb-plan li b {\n    font:\n      400 1.5rem/1 'Abril Fatface',\n      Georgia,\n      serif;\n  }\n  #sc-roastery .kb-plan meter {\n    width: 100%;\n    accent-color: var(--primary);\n  }\n  /* the Site Footer: the bar's address and hours, the coffee, how to reach us, the legal notes in dialogs */\n  #sc-roastery .mk-footer {\n    background: none;\n    color: inherit;\n  }\n  #sc-roastery .mk-footer-inner {\n    max-width: none;\n    padding: 2rem 0 0;\n    border-block-start: 1px solid var(--border);\n  }\n  #sc-roastery .mk-footer-heading {\n    color: inherit;\n    font:\n      500 0.75rem/1.3 'DM Mono',\n      monospace;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n  }\n  #sc-roastery .mk-footer address {\n    font-style: normal;\n    line-height: 1.5;\n  }\n  #sc-roastery .kb-hours {\n    display: grid;\n    grid-template-columns: auto 1fr;\n    gap: 0.2rem 1rem;\n    margin: 0;\n    color: var(--muted-foreground);\n    font-size: 0.9375rem;\n  }\n  #sc-roastery .kb-hours dd {\n    margin: 0;\n  }\n  #sc-roastery .mk-footer-list :is(a, button) {\n    padding: 0;\n    border: 0;\n    background: none;\n    color: inherit;\n    font: inherit;\n    text-align: start;\n    cursor: pointer;\n  }\n  #sc-roastery .mk-footer-list :is(a, button):is(:hover, :focus-visible) {\n    text-decoration: underline;\n    text-underline-offset: 0.3em;\n  }\n  #sc-roastery .mk-footer-rule {\n    margin: 0;\n    background: var(--border);\n  }\n  #sc-roastery .mk-footer-brand {\n    color: inherit;\n  }\n  #sc-roastery .mk-footer-copy {\n    color: var(--muted-foreground);\n  }\n  /* the dialogs: the subscription and the legal notes, on the look's card */\n  #sc-roastery .sc-dialog {\n    border: 1px solid var(--border);\n    background: var(--card);\n    color: var(--card-foreground);\n  }\n  #sc-roastery .sc-dialog .dialog-title {\n    font:\n      400 1.75rem/1.1 'Abril Fatface',\n      Georgia,\n      serif;\n  }\n  #sc-roastery .sc-dialog .dialog-description {\n    color: var(--muted-foreground);\n  }\n  #sc-roastery :is(.sc-form, .sc-done) {\n    display: grid;\n    gap: 1rem;\n  }\n  #sc-roastery .sc-row {\n    display: grid;\n    gap: 0.4rem;\n  }\n  #sc-roastery .sc-choice {\n    display: grid;\n    gap: 0.5rem;\n    margin: 0;\n    padding: 0;\n    border: 0;\n  }\n  #sc-roastery .sc-choice label {\n    display: flex;\n    align-items: center;\n    gap: 0.6rem;\n    padding: 0.6rem 0.8rem;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-md);\n    font-family: 'DM Mono', monospace;\n    font-size: 0.875rem;\n    cursor: pointer;\n  }\n  #sc-roastery .sc-choice label:has(:checked) {\n    border-color: var(--primary);\n    box-shadow: inset 0 0 0 1px var(--primary);\n  }\n  #sc-roastery .sc-choice input {\n    accent-color: var(--primary);\n  }\n  #sc-roastery .sc-dialog:not([data-sent]) .sc-done,\n  #sc-roastery .sc-dialog[data-sent] .sc-form {\n    display: none;\n  }\n  #sc-roastery .sc-legal {\n    display: grid;\n    gap: 0.75rem;\n    font-size: 0.9375rem;\n    line-height: 1.55;\n  }\n  #sc-roastery .sc-legal :is(p, address) {\n    margin: 0;\n    font-style: normal;\n  }\n  #sc-roastery .sc-legal a {\n    color: inherit;\n  }\n  @media (max-width: 48rem) {\n    #sc-roastery :is(.kb-hero, .kb-subscribe) {\n      grid-template-columns: 1fr;\n    }\n    #sc-roastery .kb-stamp {\n      left: 0;\n      width: 6.5rem;\n    }\n    #sc-roastery .mk-header-nav {\n      order: 3;\n      width: 100%;\n      margin-inline-start: -0.75rem;\n    }\n    #sc-roastery .mk-header-actions {\n      margin-inline-start: auto;\n    }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    #sc-roastery .kb-stamp {\n      animation: none;\n    }\n  }\n  /* light or dark: the Swap writes the page's dark class - every look has a light and a dark palette */\n  #sc-roastery .site-mode {\n    flex: none;\n    border: 1px solid var(--input);\n    border-radius: var(--radius-md);\n    background: var(--background);\n    color: var(--foreground);\n  }\n  #sc-roastery .site-mode:hover {\n    background: var(--accent);\n    color: var(--accent-foreground);\n  }\n  /* -- modes: each look in light and dark, derived from the palettes above (the other mode of each look) -- */\n  .dark #sc-roastery[data-look='espresso'] {\n    --accent: oklch(0.29 0.05 75);\n    --accent-foreground: oklch(0.94 0.025 80);\n  }\n  :root:not(.dark) #sc-roastery[data-look='espresso'] {\n    color-scheme: light;\n    --background: oklch(0.985 0.025 45);\n    --foreground: oklch(0.2 0.025 80);\n    --card: oklch(0.997 0.025 45);\n    --card-foreground: oklch(0.2 0.025 80);\n    --muted: oklch(0.95 0.025 45);\n    --muted-foreground: oklch(0.46 0.03 70);\n    --border: oklch(0.9 0.025 50);\n    --input: oklch(0.88 0.025 50);\n    --primary: oklch(0.55 0.11 75);\n    --primary-foreground: oklch(0.985 0.005 75);\n    --secondary: oklch(0.955 0.025 45);\n    --secondary-foreground: oklch(0.25 0.025 80);\n    --accent: oklch(0.94 0.025 75);\n    --accent-foreground: oklch(0.2 0.025 80);\n    --ring: oklch(0.55 0.11 75);\n    --kb-ticket: oklch(0.267 0.04 80);\n    --kb-ticket-ink: oklch(0.951 0.03 45);\n    --kb-bubble: oklch(0.55 0.11 75);\n    --kb-bubble-ink: oklch(0.962 0.025 45);\n    --popover: oklch(0.997 0 0);\n    --popover-foreground: oklch(0.2 0 0);\n  }\n  :root:not(.dark) #sc-roastery[data-look='blond'] {\n    --accent: oklch(0.91 0.045 75);\n  }\n  .dark #sc-roastery[data-look='blond'] {\n    color-scheme: dark;\n    --background: oklch(0.17 0.025 225);\n    --foreground: oklch(0.94 0.03 250);\n    --card: oklch(0.205 0.012 225);\n    --card-foreground: oklch(0.94 0.03 250);\n    --muted: oklch(0.24 0.03 225);\n    --muted-foreground: oklch(0.74 0.03 245);\n    --border: oklch(0.95 0.02 250 / 0.14);\n    --input: oklch(0.95 0.02 250 / 0.14);\n    --primary: oklch(0.69 0.13 250);\n    --primary-foreground: oklch(0.17 0.03 250);\n    --secondary: oklch(0.25 0.03 225);\n    --secondary-foreground: oklch(0.9 0.03 250);\n    --accent: oklch(0.26 0.035 75);\n    --accent-foreground: oklch(0.94 0.03 250);\n    --ring: oklch(0.69 0.13 250);\n    --kb-ticket: oklch(0.36 0.035 75);\n    --kb-ticket-ink: oklch(0.87 0.03 250);\n    --kb-bubble: oklch(0.69 0.13 250);\n    --kb-bubble-ink: oklch(0.173 0.012 225);\n    --popover: oklch(0.215 0 0);\n    --popover-foreground: oklch(0.94 0 0);\n  }\n  .dark #sc-roastery[data-look='cherry'] {\n    --background: oklch(0.57 0.2 25);\n    --foreground: oklch(1 0.02 60);\n    --muted-foreground: oklch(1 0.04 50);\n    --accent: oklch(0.5 0.2 25);\n  }\n  :root:not(.dark) #sc-roastery[data-look='cherry'] {\n    color-scheme: light;\n    --background: oklch(0.985 0.025 25);\n    --foreground: oklch(0.2 0.02 60);\n    --card: oklch(0.997 0.025 25);\n    --card-foreground: oklch(0.2 0.02 60);\n    --muted: oklch(0.95 0.025 25);\n    --muted-foreground: oklch(0.46 0.03 50);\n    --border: oklch(0.2 0.02 60 / 0.12);\n    --input: oklch(0.2 0.02 60 / 0.12);\n    --primary: oklch(0.35 0.08 150);\n    --primary-foreground: oklch(0.985 0.005 150);\n    --secondary: oklch(0.955 0.025 25);\n    --secondary-foreground: oklch(0.25 0.02 60);\n    --accent: oklch(0.94 0.025 150);\n    --accent-foreground: oklch(0.2 0.02 60);\n    --ring: oklch(0.35 0.08 150);\n    --kb-ticket: oklch(0.167 0.02 60);\n    --kb-ticket-ink: oklch(0.45 0.17 25);\n    --kb-bubble: oklch(0.879 0.03 150);\n    --kb-bubble-ink: oklch(0.167 0.02 60);\n    --popover: oklch(0.997 0 0);\n    --popover-foreground: oklch(0.2 0 0);\n  }\n  /* -- modes: end -- */\n</style>\n<div id=\"sc-roastery\" data-look=\"espresso\">\n  <div class=\"kb-page\">\n    <header class=\"mk-header\">\n      <div class=\"mk-header-inner\">\n        <a class=\"mk-header-brand\" href=\"#sc-roastery\"><span class=\"mk-header-name\">Kiln &amp; Bean</span></a>\n        <nav class=\"mk-header-nav\" aria-label=\"Site\">\n          <ul class=\"nav-menu-list\">\n            <li class=\"nav-menu-item\"><a class=\"nav-menu-link\" href=\"#kb-coffees\">Coffees</a></li>\n            <li class=\"nav-menu-item\"><a class=\"nav-menu-link\" href=\"#kb-subscribe\">Subscription</a></li>\n            <li class=\"nav-menu-item\"><a class=\"nav-menu-link\" href=\"#kb-visit\">Visit</a></li>\n          </ul>\n        </nav>\n        <div class=\"mk-header-actions\">\n          <select class=\"select\" data-size=\"sm\" data-site-look aria-label=\"Look\" style=\"width: auto\">\n            <option value=\"espresso\">Espresso</option>\n            <option value=\"blond\">Blond roast</option>\n            <option value=\"cherry\">Cherry</option>\n          </select>\n          <label class=\"swap site-mode\" data-variant=\"rotate\" data-size=\"sm\">\n            <input type=\"checkbox\" data-site-mode aria-label=\"Dark mode\" />\n            <span class=\"swap-on\" aria-hidden=\"true\"><i data-lucide=\"moon\"></i></span>\n            <span class=\"swap-off\" aria-hidden=\"true\"><i data-lucide=\"sun\"></i></span>\n          </label>\n        </div>\n      </div>\n    </header>\n    <section class=\"kb-hero\" aria-labelledby=\"kb-title\">\n      <div>\n        <h1 id=\"kb-title\">Roasted on Tuesday. <em>In your cup</em> by Friday.</h1>\n        <p\n          >We roast three coffees a week in a 15 kg drum in Leipzig, rest them two days and post them the morning after.\n          Nothing sits on a shelf.</p\n        >\n        <div class=\"kb-actions\">\n          <a class=\"btn\" data-size=\"lg\" href=\"#kb-coffees\">This week's coffees</a>\n          <a class=\"btn\" data-variant=\"outline\" data-size=\"lg\" href=\"#kb-subscribe\">Subscribe</a>\n        </div>\n      </div>\n      <div class=\"kb-cup\">\n        <img src=\"https://picsum.photos/id/30/800/900\" alt=\"A red mug of coffee on a wooden table\" />\n        <div\n          class=\"shader kb-steam\"\n          data-effect=\"smoke\"\n          data-background=\"transparent\"\n          data-look-set='{\"default\": {\"data-colors\": \"oklch(0.95 0.02 80) oklch(0.8 0.03 70)\"}, \"blond\": {\"data-colors\": \"oklch(1 0 0) oklch(0.85 0.03 225)\"}, \"cherry\": {\"data-colors\": \"oklch(0.98 0.02 60) oklch(0.85 0.06 30)\"}}'\n          data-colors=\"oklch(0.95 0.02 80) oklch(0.8 0.03 70)\"\n          data-speed=\"0.7\"\n          data-fps=\