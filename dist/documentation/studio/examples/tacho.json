[{"label":"Tacho","html":"<div class=\"tacho\" data-color=\"chart-4\" data-sweep=\"270\" data-ticks=\"1\">\n  <meter class=\"tacho-meter\" min=\"0\" max=\"10\" value=\"7\" aria-label=\"Drive\">7</meter>\n  <output class=\"tacho-value\"></output>\n</div>\n","individual":true},{"label":"Tacho (sm)","html":"<div class=\"tacho\" data-size=\"sm\">\n  <span class=\"tacho-caption\">Mix</span>\n  <meter class=\"tacho-meter\" min=\"0\" max=\"100\" value=\"40\" aria-label=\"Mix\">40</meter>\n  <output class=\"tacho-value\"></output>\n</div>\n","individual":true},{"label":"Tacho (lg)","html":"<div class=\"tacho\" data-size=\"lg\" data-format=\"signed\" data-sweep=\"100\" data-ticks=\"25\" data-minor=\"4\">\n  <span class=\"tacho-label\">E</span>\n  <meter class=\"tacho-meter\" min=\"-50\" max=\"50\" low=\"-5\" high=\"5\" optimum=\"0\" value=\"-8\" aria-label=\"Tuning in cents\">\n    -8 cents\n  </meter>\n  <output class=\"tacho-value\">81.9 Hz</output>\n  <span class=\"tacho-caption\">E2 · -8 ct</span>\n</div>\n","individual":true},{"label":"Tuner","html":"<div class=\"flex flex-wrap items-center gap-8\">\n  <div\n    class=\"tacho\"\n    id=\"tc-tuner\"\n    data-size=\"lg\"\n    data-format=\"signed\"\n    data-sweep=\"100\"\n    data-ticks=\"25\"\n    data-minor=\"4\"\n    data-state-demo\n  >\n    <span class=\"tacho-label\">A</span>\n    <meter class=\"tacho-meter\" min=\"-50\" max=\"50\" low=\"-5\" high=\"5\" optimum=\"0\" value=\"0\" aria-label=\"Tuning in cents\">\n      0 cents\n    </meter>\n    <output class=\"tacho-value\">440.0 Hz</output>\n    <span class=\"tacho-caption\">A4 · 0 ct</span>\n  </div>\n  <div class=\"grid gap-4 justify-items-start\">\n    <div class=\"knob\" data-scale=\"exponential\" data-format=\"si\" data-unit=\"Hz\">\n      <input class=\"knob-input\" type=\"range\" id=\"tc-string\" min=\"40\" max=\"1000\" step=\"any\" value=\"443\" />\n      <label class=\"knob-label\" for=\"tc-string\">String</label>\n      <output class=\"knob-value\" for=\"tc-string\">443 Hz</output>\n    </div>\n    <select class=\"select\" data-size=\"sm\" id=\"tc-mode\" aria-label=\"Tune to\">\n      <option value=\"chromatic\">Chromatic</option>\n      <option value=\"guitar\">Guitar (E A D G B E)</option>\n      <option value=\"bass\">Bass (E A D G)</option>\n      <option value=\"ukulele\">Ukulele (G C E A)</option>\n    </select>\n    <div class=\"flex gap-2\">\n      <button class=\"btn\" type=\"button\" data-size=\"sm\" id=\"tc-play\" aria-pressed=\"false\">Play</button>\n      <button class=\"btn\" type=\"button\" data-size=\"sm\" data-variant=\"outline\" id=\"tc-pluck\">Pluck</button>\n    </div>\n  </div>\n</div>\n","individual":false},{"label":"Panning","html":"<div class=\"grid gap-3 justify-items-center\">\n  <div class=\"tacho\" id=\"tc-pan\" data-format=\"pan\" data-sweep=\"90\" data-ticks=\"25\" data-minor=\"4\">\n    <span class=\"tacho-label\">Pan</span>\n    <meter class=\"tacho-meter\" min=\"-50\" max=\"50\" value=\"-20\" aria-label=\"Pan\">L20</meter>\n    <output class=\"tacho-value\"></output>\n  </div>\n  <input class=\"slider\" type=\"range\" min=\"-50\" max=\"50\" value=\"-20\" data-tacho-for=\"tc-pan\" aria-label=\"Pan\" />\n</div>\n","individual":false},{"label":"Needles","html":"<div class=\"grid gap-4 justify-items-center\">\n  <div class=\"flex flex-wrap justify-center gap-6\">\n    <div class=\"tacho\" data-size=\"sm\" id=\"tc-spring\">\n      <span class=\"tacho-caption\">spring</span>\n      <meter class=\"tacho-meter\" min=\"0\" max=\"100\" value=\"20\" aria-label=\"Spring\">20</meter>\n      <output class=\"tacho-value\"></output>\n    </div>\n    <div class=\"tacho\" data-size=\"sm\" id=\"tc-smooth\" data-needle=\"smooth\">\n      <span class=\"tacho-caption\">smooth</span>\n      <meter class=\"tacho-meter\" min=\"0\" max=\"100\" value=\"20\" aria-label=\"Smooth\">20</meter>\n      <output class=\"tacho-value\"></output>\n    </div>\n    <div class=\"tacho\" data-size=\"sm\" id=\"tc-instant\" data-needle=\"instant\">\n      <span class=\"tacho-caption\">instant</span>\n      <meter class=\"tacho-meter\" min=\"0\" max=\"100\" value=\"20\" aria-label=\"Instant\">20</meter>\n      <output class=\"tacho-value\"></output>\n    </div>\n  </div>\n  <button class=\"btn\" type=\"button\" data-size=\"sm\" id=\"tc-kick\">Kick</button>\n</div>\n","individual":false},{"label":"Rev counter","html":"<div class=\"grid gap-3 justify-items-center\">\n  <div class=\"tacho\" id=\"tc-rev\" data-sweep=\"240\" data-ticks=\"1000\" data-minor=\"4\" data-format=\"rpm\">\n    <meter\n      class=\"tacho-meter\"\n      min=\"0\"\n      max=\"8000\"\n      low=\"5500\"\n      high=\"6500\"\n      optimum=\"0\"\n      value=\"800\"\n      aria-label=\"Engine speed\"\n    >\n      800 rpm\n    </meter>\n    <output class=\"tacho-value\"></output>\n    <span class=\"tacho-caption\">× 1000 rpm</span>\n  </div>\n  <button class=\"btn\" type=\"button\" data-size=\"sm\" id=\"tc-rev-go\">Rev</button>\n</div>\n","individual":false},{"label":"VU meter","html":"<div class=\"grid gap-3 justify-items-center\">\n  <div\n    class=\"tacho\"\n    id=\"tc-vu\"\n    data-sweep=\"90\"\n    data-ticks=\"5\"\n    data-format=\"signed\"\n    data-unit=\"dB\"\n    data-decimals=\"1\"\n    data-rest=\"-20\"\n    data-needle=\"smooth\"\n    data-idle\n  >\n    <span class=\"tacho-label\">VU</span>\n    <meter class=\"tacho-meter\" min=\"-20\" max=\"3\" low=\"-6\" high=\"0\" optimum=\"-20\" value=\"-20\" aria-label=\"Level\">\n      -20 dB\n    </meter>\n    <output class=\"tacho-value\"></output>\n  </div>\n  <button class=\"btn\" type=\"button\" data-size=\"sm\" id=\"tc-vu-run\" aria-pressed=\"false\">Run</button>\n</div>\n","individual":false},{"label":"Sizes, colours and idle","html":"<div class=\"flex flex-wrap items-end justify-center gap-6\">\n  <div class=\"tacho\" data-size=\"sm\" data-color=\"chart-2\" data-labels=\"ends\" data-decimals=\"2\">\n    <meter class=\"tacho-meter\" min=\"0\" max=\"1\" value=\"0.65\" aria-label=\"Mix\">0.65</meter>\n    <output class=\"tacho-value\"></output>\n  </div>\n  <div class=\"tacho\" data-color=\"chart-4\" data-sweep=\"270\" data-ticks=\"1\">\n    <meter class=\"tacho-meter\" min=\"0\" max=\"10\" value=\"7\" aria-label=\"Drive\">7</meter>\n    <output class=\"tacho-value\"></output>\n  </div>\n  <div class=\"tacho\" data-idle data-format=\"signed\" data-ticks=\"25\" data-minor=\"4\" data-labels=\"ends\">\n    <span class=\"tacho-label\">–</span>\n    <meter class=\"tacho-meter\" min=\"-50\" max=\"50\" low=\"-5\" high=\"5\" optimum=\"0\" value=\"0\" aria-label=\"Tuning in cents\">\n      0 cents\n    </meter>\n    <output class=\"tacho-value\">– Hz</output>\n  </div>\n</div>\n","individual":false}]
