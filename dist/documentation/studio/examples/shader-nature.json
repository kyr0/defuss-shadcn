[{"label":"A summer sky","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"clouds-demo\"\n    data-effect=\"clouds\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"clouds-demo\"></div>\n</div>\n","individual":false},{"label":"A dusk with heavier cover","html":"<div\n  class=\"shader\"\n  data-effect=\"clouds\"\n  data-cover=\"0.68\"\n  data-colors=\"#3b2c5e #f4a261 #ffe8d6 #6d597a\"\n  aria-hidden=\"true\"\n  style=\"--shader-aspect: 21 / 9; border-radius: var(--radius)\"\n></div>\n","individual":false},{"label":"Flames along the foot of a section","html":"<section\n  style=\"border-radius: var(--radius); padding: 3rem 2rem 6rem; color: #fff3c4; background: #0a0505; overflow: hidden\"\n>\n  <div class=\"shader\" data-variant=\"background\" data-effect=\"fire\" data-height=\"0.55\" aria-hidden=\"true\"></div>\n  <h3 style=\"margin: 0 0 0.5rem; font-size: 1.5rem\">Hot deals until midnight</h3>\n  <p style=\"margin: 0; opacity: 0.8\">Everything in the forge, 40% off.</p>\n</section>\n","individual":false},{"label":"A gas flame","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"fire-demo\"\n    data-effect=\"fire\"\n    data-colors=\"#02030a #0b2a8c #1f7bff #8fd3ff #f2fbff\"\n    data-background=\"#02030a\"\n    data-height=\"0.6\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"fire-demo\"></div>\n</div>\n","individual":false},{"label":"Into warp","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"starfield-demo\"\n    data-effect=\"starfield\"\n    data-warp=\"0.9\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"starfield-demo\"></div>\n</div>\n","individual":false},{"label":"A quiet night sky","html":"<div\n  class=\"shader\"\n  data-effect=\"starfield\"\n  data-warp=\"0\"\n  data-speed=\"0.3\"\n  data-density=\"0.8\"\n  aria-hidden=\"true\"\n  style=\"--shader-aspect: 21 / 9; border-radius: var(--radius)\"\n></div>\n","individual":false},{"label":"A star-forming cloud","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"nebula-demo\"\n    data-effect=\"nebula\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"nebula-demo\"></div>\n</div>\n","individual":false},{"label":"Falling snow","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"snow-demo\"\n    data-effect=\"snow\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"snow-demo\"></div>\n</div>\n","individual":false},{"label":"Rising smoke","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"smoke-demo\"\n    data-effect=\"smoke\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"smoke-demo\"></div>\n</div>\n","individual":false}]
