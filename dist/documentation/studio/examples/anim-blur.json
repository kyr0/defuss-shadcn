[{"label":"In / out and lifecycle","html":"<style>\n  #anim-blur-target {\n    display: grid;\n    place-items: center;\n    width: 160px;\n    height: 100px;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    background: var(--card);\n    color: var(--card-foreground);\n    font-size: 0.875rem;\n    font-weight: 500;\n  }\n</style>\n<div id=\"anim-blur-target\">Blur me</div>\n<div style=\"display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem\">\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-blur-in\">In</button>\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-blur-out\">Out</button>\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-blur-pause\">Pause</button>\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-blur-resume\">Resume</button>\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-blur-finish\">Finish</button>\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-blur-reset\">Reset</button>\n</div>\n<div\n  style=\"display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-top: 0.75rem; font-size: 0.875rem\"\n>\n  <label for=\"anim-blur-duration\">Duration (ms)</label>\n  <input class=\"input\" style=\"width: 6rem\" type=\"number\" id=\"anim-blur-duration\" min=\"0\" step=\"50\" value=\"1500\" />\n  <label for=\"anim-blur-easing\">Easing</label>\n  <select class=\"select\" id=\"anim-blur-easing\">\n    <option value=\"cubic-bezier(0.16, 1, 0.3, 1)\" selected>default</option>\n    <option value=\"linear\">linear</option>\n    <option value=\"ease\">ease</option>\n    <option value=\"ease-in-out\">ease-in-out</option>\n    <option value=\"cubic-bezier(0.34, 1.56, 0.64, 1)\">spring</option>\n  </select>\n</div>\n","individual":false},{"label":"Scroll binding","html":"<div\n  id=\"anim-blur-scroller\"\n  style=\"height: 220px; overflow-y: auto; border: 1px solid var(--border); border-radius: var(--radius-lg)\"\n>\n  <div style=\"height: 600px; display: grid; place-items: center\">\n    <div\n      id=\"anim-blur-scroll-target\"\n      style=\"\n        display: grid;\n        place-items: center;\n        width: 160px;\n        height: 100px;\n        border: 1px solid var(--border);\n        border-radius: var(--radius-lg);\n        background: var(--card);\n        color: var(--card-foreground);\n        font-size: 0.875rem;\n        font-weight: 500;\n      \"\n      >Scroll-driven</div\n    >\n  </div>\n</div>\n","individual":false}]
