  ><th scope=\"row\">Trino · raw catalog</th><td data-perm=\"full\"><span>RW</span></td\n          ><td data-perm=\"read\"><span>R</span></td\n          ><td data-perm=\"none\"><span>—</span></td\n          ><td data-perm=\"none\"><span>—</span></td></tr\n        >\n        <tr data-node=\"trino-aggregated\"\n          ><th scope=\"row\">Trino · aggregated</th><td data-perm=\"full\"><span>RW</span></td\n          ><td data-perm=\"full\"><span>RW</span></td\n          ><td data-perm=\"full\"><span>RW</span></td\n          ><td data-perm=\"read\"><span>R</span></td></tr\n        >\n        <tr data-node=\"jupyterhub\"\n          ><th scope=\"row\">JupyterHub</th><td data-perm=\"full\"><span>ADMIN</span></td\n          ><td data-perm=\"full\"><span>RW</span></td\n          ><td data-perm=\"full\"><span>RW</span></td\n          ><td data-perm=\"none\"><span>—</span></td></tr\n        >\n        <tr data-node=\"superset\"\n          ><th scope=\"row\">Superset<small>dashboards</small></th\n          ><td data-perm=\"full\"><span>ADMIN</span></td\n          ><td data-perm=\"read\"><span>R</span></td\n          ><td data-perm=\"full\"><span>RW</span></td\n          ><td data-perm=\"write\" data-tone=\"accent\"><span>W</span></td></tr\n        >\n      </tbody>\n    </table>\n  </div>\n  <ul class=\"diagram-legend\">\n    <li data-swatch=\"muted\">RW / ADMIN · full</li>\n    <li data-swatch=\"line\">W · write</li>\n    <li data-swatch=\"external\">— · none</li>\n    <li data-swatch=\"accent\">Finding</li>\n  </ul>\n</figure>\n","individual":true},{"label":"Which coin is it?","html":"<figure class=\"diagram\" id=\"dg-matrix-bayes\" data-type=\"matrix\" aria-label=\"Bayesian update over three coin hypotheses\">\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Bayesian matrix</span>\n    <span class=\"diagram-title\">8 heads in 10 flips - which coin is it?</span>\n    <span class=\"diagram-dek\"\n      >Prior × likelihood, normalized: the evidence moves most of the belief to the 0.7 coin. Heat is the share of the\n      column maximum.</span\n    >\n  </figcaption>\n  <div class=\"diagram-canvas\">\n    <table class=\"diagram-matrix\">\n      <thead>\n        <tr\n          ><th scope=\"col\">Hypothesis</th><th scope=\"col\">Prior<small>P(H)</small></th\n          ><th scope=\"col\">Likelihood<small>P(8 of 10 | H)</small></th\n          ><th scope=\"col\">Prior × likelihood</th><th scope=\"col\">Posterior<small>P(H | data)</small></th></tr\n        >\n      </thead>\n      <tbody>\n        <tr\n          ><th scope=\"row\">Fair coin<small>p = 0.5</small></th\n          ><td style=\"--v: 0.6\">0.60</td><td style=\"--v: 0.19\">0.0439</td><td style=\"--v: 0.23\">0.0264</td\n          ><td style=\"--v: 0.23\">0.228</td></tr\n        >\n        <tr\n          ><th scope=\"row\">Biased<small>p = 0.7</small></th\n          ><td style=\"--v: 0.3\">0.30</td><td style=\"--v: 1\">0.2335</td><td style=\"--v: 0.6\">0.0700</td\n          ><td style=\"--v: 0.61\" data-tone=\"accent\">0.605</td></tr\n        >\n        <tr\n          ><th scope=\"row\">Very biased<small>p = 0.9</small></th\n          ><td style=\"--v: 0.1\">0.10</td><td style=\"--v: 0.83\">0.1937</td><td style=\"--v: 0.17\">0.0194</td\n          ><td style=\"--v: 0.17\">0.167</td></tr\n        >\n      </tbody>\n      <tfoot>\n        <tr><th scope=\"row\">Sum</th><td>1.00</td><td>-</td><td>0.1158</td><td>1.000</td></tr>\n      </tfoot>\n    </table>\n  </div>\n</figure>\n","individual":true},{"label":"Base rates and a positive test","html":"<figure class=\"diagram\" id=\"dg-matrix-test\" data-type=\"matrix\" aria-label=\"Diagnostic test joint probability matrix\">\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Bayesian matrix · base rates</span>\n    <span class=\"diagram-title\">A 95% sensitive test, a 1% base rate</span>\n    <span class=\"diagram-dek\"\n      >Joint probabilities per 1,000 people. Of everyone who tests positive, only 9.5 / 108.5 = 8.8% are ill.</span\n    >\n  </figcaption>\n  <div class=\"diagram-canvas\">\n    <table class=\"diagram-matrix\">\n      <thead>\n        <tr\n          ><th scope=\"col\">Per 1,000</th><th scope=\"col\">Test positive</th><th scope=\"col\">Test negative</th\n          ><th scope=\"col\">Total</th></tr\n        >\n      </thead>\n      <tbody>\n        <tr\n          ><th scope=\"row\">Ill<small>prior 1%</small></th\n          ><td style=\"--v: 0.3\">9.5<small> true +</small></td\n          ><td style=\"--v: 0.05\">0.5<small> false −</small></td\n          ><td>10</td></tr\n        >\n        <tr\n          ><th scope=\"row\">Healthy<small>99%</small></th\n          ><td style=\"--v: 0.55\">99<small> false +</small></td\n          ><td style=\"--v: 1\">891<small> true −</small></td\n          ><td>990</td></tr\n        >\n      </tbody>\n      <tfoot>\n        <tr><th scope=\"row\">Total</th><td>108.5</td><td>891.5</td><td>1,000</td></tr>\n        <tr><th scope=\"row\">P(ill | +)</th><td data-tone=\"accent\">8.8%</td><td>P(ill | −) 0.06%</td><td></td></tr>\n      </tfoot>\n    </table>\n  </div>\n</figure>\n","individual":true},{"label":"A Bayesian update, column by column","html":"<figure\n  class=\"diagram\"\n  id=\"dg-matrix-bayes-steps\"\n  data-type=\"matrix\"\n  data-steps\n  data-autoplay\n  aria-label=\"Bayesian update over three coin hypotheses\"\n>\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Bayesian matrix</span>\n    <span class=\"diagram-title\">8 heads in 10 flips - which coin is it?</span>\n    <span class=\"diagram-dek\"\n      >Prior × likelihood, normalized: the evidence moves most of the belief to the 0.7 coin. Heat is the share of the\n      column maximum.</span\n    >\n  </figcaption>\n  <div class=\"diagram-canvas\">\n    <table class=\"diagram-matrix\">\n      <thead>\n        <tr\n          ><th scope=\"col\">Hypothesis</th><th scope=\"col\" data-step=\"1\">Prior<small>P(H)</small></th\n          ><th scope=\"col\" data-step=\"2\">Likelihood<small>P(8 of 10 | H)</small></th\n          ><th scope=\"col\" data-step=\"3\">Prior × likelihood</th\n          ><th scope=\"col\" data-step=\"4\">Posterior<small>P(H | data)</small></th></tr\n        >\n      </thead>\n      <tbody>\n        <tr\n          ><th scope=\"row\">Fair coin<small>p = 0.5</small></th\n          ><td style=\"--v: 0.6\" data-step=\"1\">0.60</td><td style=\"--v: 0.19\" data-step=\"2\">0.0439</td\n          ><td style=\"--v: 0.23\" data-step=\"3\">0.0264</td><td style=\"--v: 0.23\" data-step=\"4\">0.228</td></tr\n        >\n        <tr\n          ><th scope=\"row\">Biased<small>p = 0.7</small></th\n          ><td style=\"--v: 0.3\" data-step=\"1\">0.30</td><td style=\"--v: 1\" data-step=\"2\">0.2335</td\n          ><td style=\"--v: 0.6\" data-step=\"3\">0.0700</td\n          ><td style=\"--v: 0.61\" data-tone=\"accent\" data-step=\"4\">0.605</td></tr\n        >\n        <tr\n          ><th scope=\"row\">Very biased<small>p = 0.9</small></th\n          ><td style=\"--v: 0.1\" data-step=\"1\">0.10</td><td style=\"--v: 0.83\" data-step=\"2\">0.1937</td\n          ><td style=\"--v: 0.17\" data-step=\"3\">0.0194</td><td style=\"--v: 0.17\" data-step=\"4\">0.167</td></tr\n        >\n      </tbody>\n      <tfoot>\n        <tr\n          ><th scope=\"row\">Sum</th><td data-step=\"1\">1.00</td><td data-step=\"2\">-</td><td data-step=\"3\">0.1158</td\n          ><td data-step=\"4\">1.000</td></tr\n        >\n      </tfoot>\n    </table>\n  </div>\n</figure>\n","individual":true},{"label":"RACI","html":"<figure class=\"diagram\" id=\"dg-matrix-raci\" data-type=\"matrix\" aria-label=\"RACI matrix for a release\">\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">RACI</span>\n    <span class=\"diagram-title\">Who does what in a release</span>\n    <span class=\"diagram-dek\">Responsible, Accountable, Consulted, Informed - exactly one A per row.</span>\n  </figcap