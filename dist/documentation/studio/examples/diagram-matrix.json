most certain</th><td style=\"--v: 0.2\"></td><td style=\"--v: 0.4\">R7</td\n          ><td style=\"--v: 0.6\"></td><td style=\"--v: 0.8\"></td><td style=\"--v: 1\"></td\n        ></tr>\n        <tr\n          ><th scope=\"row\">Likely</th><td style=\"--v: 0.16\"></td><td style=\"--v: 0.32\"></td\n          ><td style=\"--v: 0.48\">R2 · R5</td><td style=\"--v: 0.64\" data-tone=\"accent\">R1</td><td style=\"--v: 0.8\"></td\n        ></tr>\n        <tr\n          ><th scope=\"row\">Possible</th><td style=\"--v: 0.12\">R9</td><td style=\"--v: 0.24\"></td\n          ><td style=\"--v: 0.36\"></td><td style=\"--v: 0.48\">R3</td><td style=\"--v: 0.6\"></td\n        ></tr>\n        <tr\n          ><th scope=\"row\">Unlikely</th><td style=\"--v: 0.08\"></td><td style=\"--v: 0.16\">R6</td\n          ><td style=\"--v: 0.24\"></td><td style=\"--v: 0.32\"></td><td style=\"--v: 0.4\">R4</td></tr\n        >\n        <tr\n          ><th scope=\"row\">Rare</th><td style=\"--v: 0.04\"></td><td style=\"--v: 0.08\"></td><td style=\"--v: 0.12\">R8</td\n          ><td style=\"--v: 0.16\"></td><td style=\"--v: 0.2\"></td\n        ></tr>\n      </tbody>\n    </table>\n  </div>\n</figure>\n","individual":true},{"label":"Weighted decision matrix","html":"<figure\n  class=\"diagram\"\n  id=\"dg-matrix-decision\"\n  data-type=\"matrix\"\n  aria-label=\"Weighted decision matrix for a message queue\"\n>\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Decision matrix</span>\n    <span class=\"diagram-title\">Choosing a message queue</span>\n    <span class=\"diagram-dek\">Scores 1-5, multiplied by the criterion weight; the row total decides.</span>\n  </figcaption>\n  <div class=\"diagram-canvas\">\n    <table class=\"diagram-matrix\">\n      <thead>\n        <tr\n          ><th scope=\"col\">Criterion</th><th scope=\"col\">Weight</th><th scope=\"col\">Kafka</th\n          ><th scope=\"col\">RabbitMQ</th><th scope=\"col\">SQS</th></tr\n        >\n      </thead>\n      <tbody>\n        <tr\n          ><th scope=\"row\">Throughput</th><td>30%</td><td style=\"--v: 1\">5</td><td style=\"--v: 0.6\">3</td\n          ><td style=\"--v: 0.8\">4</td></tr\n        >\n        <tr\n          ><th scope=\"row\">Operations effort</th><td>25%</td><td style=\"--v: 0.4\">2</td><td style=\"--v: 0.6\">3</td\n          ><td style=\"--v: 1\">5</td></tr\n        >\n        <tr\n          ><th scope=\"row\">Replay / retention</th><td>20%</td><td style=\"--v: 1\">5</td><td style=\"--v: 0.4\">2</td\n          ><td style=\"--v: 0.4\">2</td></tr\n        >\n        <tr\n          ><th scope=\"row\">Team experience</th><td>15%</td><td style=\"--v: 0.6\">3</td><td style=\"--v: 1\">5</td\n          ><td style=\"--v: 0.8\">4</td></tr\n        >\n        <tr\n          ><th scope=\"row\">Cost at our scale</th><td>10%</td><td style=\"--v: 0.6\">3</td><td style=\"--v: 0.8\">4</td\n          ><td style=\"--v: 0.8\">4</td></tr\n        >\n      </tbody>\n      <tfoot>\n        <tr\n          ><th scope=\"row\">Weighted total</th><td>100%</td><td data-tone=\"accent\">3.95</td><td>3.25</td\n          ><td>3.75</td></tr\n        >\n      </tfoot>\n    </table>\n  </div>\n</figure>\n","individual":true},{"label":"Traceability matrix","html":"<figure class=\"diagram\" id=\"dg-matrix-trace\" data-type=\"matrix\" aria-label=\"Requirements traceability matrix\">\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Traceability matrix</span>\n    <span class=\"diagram-title\">Requirements × tests</span>\n    <span class=\"diagram-dek\">Every requirement needs at least one test; the empty row is the gap.</span>\n  </figcaption>\n  <div class=\"diagram-canvas\">\n    <table class=\"diagram-matrix\">\n      <thead>\n        <tr\n          ><th scope=\"col\">Requirement</th><th scope=\"col\">T-01 unit</th><th scope=\"col\">T-02 API</th\n          ><th scope=\"col\">T-03 e2e</th><th scope=\"col\">T-04 load</th><th scope=\"col\">Covered</th></tr\n        >\n      </thead>\n      <tbody>\n        <tr\n          ><th scope=\"row\">REQ-1 login<small>SSO</small></th\n          ><td>●</td><td>●</td><td>●</td><td>—</td><td>3</td></tr\n        >\n        <tr><th scope=\"row\">REQ-2 checkout</th><td>●</td><td>●</td><td>●</td><td>●</td><td>4</td></tr>\n        <tr><th scope=\"row\">REQ-3 refunds</th><td>●</td><td>—</td><td>—</td><td>—</td><td>1</td></tr>\n        <tr\n          ><th scope=\"row\">REQ-4 GDPR export</th><td>—</td><td>—</td><td>—</td><td>—</td\n          ><td data-tone=\"accent\">0</td></tr\n        >\n      </tbody>\n    </table>\n  </div>\n</figure>\n","individual":true},{"label":"Q3 access review","html":"<figure\n  class=\"diagram\"\n  id=\"dg-matrix-delta\"\n  data-type=\"matrix\"\n  data-delta=\"rows\"\n  aria-label=\"Access review, before and after\"\n>\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Access review</span>\n    <span class=\"diagram-title\">Q3 access review</span>\n    <span class=\"diagram-dek\"\n      >Cells carry data-change and their old value in data-before; the ledger names row and column.</span\n    >\n  </figcaption>\n  <div class=\"diagram-canvas\">\n    <table class=\"diagram-matrix\">\n      <thead>\n        <tr\n          ><th scope=\"col\">Component</th><th scope=\"col\">Engineers</th><th scope=\"col\">Scientists</th\n          ><th scope=\"col\">Consumers</th></tr\n        >\n      </thead>\n      <tbody>\n        <tr\n          ><th scope=\"row\">MinIO · raw bucket</th\n          ><td data-perm=\"read\" data-change=\"changed\" data-change-label=\"Engineers · raw bucket\"\n            ><span data-before=\"W\">R</span></td\n          ><td data-perm=\"none\"><span>—</span></td\n          ><td data-perm=\"none\"><span>—</span></td></tr\n        >\n        <tr\n          ><th scope=\"row\">Trino · aggregated</th><td data-perm=\"full\"><span>RW</span></td\n          ><td data-perm=\"full\"><span>RW</span></td\n          ><td data-perm=\"read\"><spa