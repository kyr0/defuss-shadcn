[{"label":"Auto-advancing gallery","html":"<section\n  class=\"image-gallery\"\n  id=\"igal\"\n  aria-label=\"Auto-advancing image gallery\"\n  style=\"max-width: 44rem; margin-inline: auto\"\n>\n  <div class=\"igal-viewport\">\n    <div class=\"image-gallery-track\">\n      <figure class=\"image igal-slide\" data-duration=\"3000\" data-active>\n        <img src=\"https://picsum.photos/id/1015/960/540\" alt=\"River winding through a mountain valley\" />\n        <figcaption class=\"image-caption igal-caption\">River valley - dwell 3000ms (data-duration)</figcaption>\n      </figure>\n      <figure class=\"image igal-slide\" data-duration=\"6000\">\n        <img src=\"https://picsum.photos/id/1016/960/540\" alt=\"Sunlit canyon walls\" />\n        <figcaption class=\"image-caption igal-caption\">Canyon - dwell 6000ms (data-duration)</figcaption>\n      </figure>\n      <figure class=\"image igal-slide\" data-duration=\"4000\">\n        <img src=\"https://picsum.photos/id/1018/960/540\" alt=\"Mountain lake under a clear sky\" />\n        <figcaption class=\"image-caption igal-caption\">Mountain lake - dwell 4000ms (data-duration)</figcaption>\n      </figure>\n      <figure class=\"image igal-slide\" data-duration=\"5000\">\n        <img src=\"https://picsum.photos/id/1025/960/540\" alt=\"Pug wrapped in a knitted blanket\" />\n        <figcaption class=\"image-caption igal-caption\">Studio pug - dwell 5000ms (data-duration)</figcaption>\n      </figure>\n      <figure class=\"image igal-slide\">\n        <img src=\"https://picsum.photos/id/1035/960/540\" alt=\"Dark mountain ridge in fog\" />\n        <figcaption class=\"image-caption igal-caption\"\n          >Foggy ridge - no data-duration, uses the default dwell below</figcaption\n        >\n      </figure>\n    </div>\n  </div>\n  <div class=\"igal-controls\">\n    <button type=\"button\" class=\"btn\" data-variant=\"outline\" id=\"igal-prev\">← Prev</button>\n    <button type=\"button\" class=\"btn\" data-variant=\"outline\" id=\"igal-play\" aria-pressed=\"true\">Pause</button>\n    <button type=\"button\" class=\"btn\" data-variant=\"outline\" id=\"igal-next\">Next →</button>\n    <output class=\"igal-counter\" id=\"igal-counter\" for=\"igal-prev igal-next igal-play\" aria-live=\"polite\">1 / 5</output>\n  </div>\n  <div class=\"igal-config\">\n    <label class=\"label\" for=\"igal-dwell\">Default dwell (ms)</label>\n    <input\n      class=\"input\"\n      type=\"number\"\n      id=\"igal-dwell\"\n      value=\"4000\"\n      min=\"500\"\n      max=\"20000\"\n      step=\"500\"\n      aria-describedby=\"igal-dwell-hint\"\n    />\n    <p class=\"field-description\" id=\"igal-dwell-hint\"\n      >Fallback for slides without their own data-duration - here: the foggy ridge.</p\n    >\n  </div>\n</section>\n<style>\n  /* demo-scoped styles - the gallery is a docs pattern, not a shipped component;\n     .image already supplies position/overflow/radius/object-fit, the data-active\n     crossfade and the demo chrome are all that is left */\n  .igal-viewport {\n    position: relative;\n    aspect-ratio: 16 / 9;\n    border-radius: var(--radius-lg);\n    background: var(--muted);\n  }\n  .igal-slide {\n    position: absolute;\n    inset: 0;\n    opacity: 0;\n    transform: scale(1.03);\n    transition:\n      opacity 480ms ease,\n      transform 480ms ease;\n    pointer-events: none;\n  }\n  .igal-slide[data-active] {\n    opacity: 1;\n    transform: none;\n    pointer-events: auto;\n  }\n  .igal-caption {\n    position: absolute;\n    inset-inline: 0;\n    bottom: 0;\n    padding: 0.6rem 0.9rem;\n    background: color-mix(in oklch, #000 55%, transparent);\n    color: #fff;\n  }\n  .igal-controls {\n    display: flex;\n    align-items: center;\n    gap: 0.5rem;\n    margin-block-start: 0.75rem;\n  }\n  .igal-counter {\n    margin-inline-start: auto;\n    font-variant-numeric: tabular-nums;\n    font-size: 0.875rem;\n    color: var(--muted-foreground);\n  }\n  .igal-config {\n    display: grid;\n    gap: 0.375rem;\n    margin-block-start: 1rem;\n    max-width: 16rem;\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .igal-slide {\n      transition: none;\n    }\n  }\n</style>\n","individual":false},{"label":"Hover gallery","html":"<figure class=\"hover-gallery\" style=\"max-width: 24rem; margin: 0\">\n  <img src=\"https://picsum.photos/id/1015/800/600\" alt=\"A fjord between steep cliffs\" />\n  <img src=\"https://picsum.photos/id/1016/800/600\" alt=\"A red canyon at sunset\" />\n  <img src=\"https://picsum.photos/id/1018/800/600\" alt=\"Green hills under clouds\" />\n  <img src=\"https://picsum.photos/id/1050/800/600\" alt=\"Sea stacks off a rocky coast\" />\n</figure>\n","individual":false},{"label":"Product card","html":"<a class=\"card\" href=\"#product\" style=\"max-width: 18rem\">\n  <figure class=\"hover-gallery\" data-indicator data-ratio=\"1/1\" style=\"margin: 0; border-radius: 0\">\n    <img src=\"https://picsum.photos/id/0/600/600\" alt=\"The notebook open on a wooden desk\" />\n    <img src=\"https://picsum.photos/id/2/600/600\" alt=\"The notebook next to a coffee cup\" />\n    <img src=\"https://picsum.photos/id/48/600/600\" alt=\"The notebook lid, closed\" />\n    <img src=\"https://picsum.photos/id/201/600/600\" alt=\"The notebook with glasses and a mouse\" />\n  </figure>\n  <div class=\"card-header\">\n    <h3 class=\"card-title\">Notebook Air 13″</h3>\n    <p class=\"card-description\">Silver · 3 colors</p>\n  </div>\n  <div class=\"card-footer\"><strong>€1,199</strong></div>\n</a>\n","individual":false},{"label":"Position bar","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(2, minmax(0, 18rem))\">\n  <figure class=\"hover-gallery\" data-indicator style=\"margin: 0\">\n    <img src=\"https://picsum.photos/id/30/800/600\" alt=\"A patterned red mug\" />\n    <img src=\"https://picsum.photos/id/42/800/600\" alt=\"A café table by the window\" />\n    <img src=\"https://picsum.photos/id/431/800/600\" alt=\"A cappuccino with latte art\" />\n    <img src=\"https://picsum.photos/id/1/800/600\" alt=\"Coffee beside a laptop at work\" />\n  </figure>\n  <figure class=\"hover-gallery\" data-indicator=\"always\" style=\"margin: 0\">\n    <img src=\"https://picsum.photos/id/1025/800/600\" alt=\"A pug wrapped in a blanket\" />\n    <img src=\"https://picsum.photos/id/1062/800/600\" alt=\"A pug under a blanket on a bed\" />\n    <img src=\"https://picsum.photos/id/1074/800/600\" alt=\"A lioness looking into the camera\" />\n    <img src=\"https://picsum.photos/id/1084/800/600\" alt=\"Walruses resting on a beach\" />\n  </figure>\n</div>\n","individual":false},{"label":"Zoom","html":"<figure class=\"hover-gallery\" data-effect=\"zoom\" data-indicator style=\"max-width: 24rem; margin: 0\">\n  <img src=\"https://picsum.photos/id/1035/800/600\" alt=\"A waterfall with a rainbow\" />\n  <img src=\"https://picsum.photos/id/1039/800/600\" alt=\"A waterfall in a green forest\" />\n  <img src=\"https://picsum.photos/id/1043/800/600\" alt=\"Pines below granite cliffs\" />\n  <img src=\"https://picsum.photos/id/1036/800/600\" alt=\"Snowy mountains in winter\" />\n</figure>\n","individual":false},{"label":"Vertical zones","html":"<figure class=\"hover-gallery\" data-direction=\"vertical\" data-ratio=\"3/4\" style=\"max-width: 14rem; margin: 0\">\n  <img src=\"https://picsum.photos/id/64/600/800\" alt=\"A woman with sunglasses in a field\" />\n  <img src=\"https://picsum.photos/id/65/600/800\" alt=\"Hair lit by the evening sun\" />\n  <img src=\"https://picsum.photos/id/823/600/800\" alt=\"A photographer in a red beanie\" />\n  <img src=\"https://picsum.photos/id/338/600/800\" alt=\"A hooded figure at the shore\" />\n</figure>\n","individual":false},{"label":"Up to ten images","html":"<figure class=\"hover-gallery\" data-indicator=\"always\" data-ratio=\"16/9\" style=\"max-width: 32rem; margin: 0\">\n  <img src=\"https://picsum.photos/id/20/960/540\" alt=\"A desk with notebooks and a phone\" />\n  <img src=\"https://picsum.photos/id/26/960/540\" alt=\"Travel gear laid out on grey\" />\n  <img src=\"https://picsum.photos/id/30/960/540\" alt=\"A patterned red mug\" />\n  <img src=\"https://picsum.photos/id/96/960/540\" alt=\"A game controller on a table\" />\n  <img src=\"https://picsum.photos/id/160/960/540\" alt=\"A phone on a desk, close up\" />\n  <img src=\"https://picsum.photos/id/250/960/540\" alt=\"A vintage camera on piano keys\" />\n  <img src=\"https://picsum.photos/id/367/960/540\" alt=\"An e-reader held in the grass\" />\n  <img src=\"https://picsum.photos/id/403/960/540\" alt=\"The keys of an old typewriter\" />\n  <img src=\"https://picsum.photos/id/431/960/540\" alt=\"A cappuccino with latte art\" />\n  <img src=\"https://picsum.photos/id/91/960/540\" alt=\"A man holding a twin-lens camera\" />\n</figure>\n","individual":false}]
