[{"label":"Default","html":"<form class=\"mk-comment-form\" aria-label=\"Add a comment\" style=\"max-width: 42rem\">\n  <span class=\"avatar\"><img class=\"avatar-image\" src=\"images/mk-portrait.png\" alt=\"\" /></span>\n  <div class=\"mk-comment-form-main\">\n    <textarea\n      class=\"textarea\"\n      name=\"comment\"\n      rows=\"3\"\n      required\n      minlength=\"2\"\n      placeholder=\"Join the discussion…\"\n      aria-label=\"Comment\"\n      aria-describedby=\"comment-hint\"\n    ></textarea>\n    <div class=\"mk-comment-form-footer\">\n      <p class=\"mk-comment-form-hint\" id=\"comment-hint\">Markdown works. Be kind.</p>\n      <button type=\"submit\" class=\"btn\">Post comment</button>\n    </div>\n  </div>\n</form>\n","individual":true},{"label":"Guest","html":"<form class=\"mk-comment-form\" aria-label=\"Leave a reply\" style=\"max-width: 42rem\">\n  <div class=\"mk-comment-form-main\">\n    <div class=\"mk-comment-form-fields\">\n      <div\n        ><label class=\"label\" for=\"guest-name\">Name</label\n        ><input class=\"input\" id=\"guest-name\" name=\"name\" autocomplete=\"name\" required\n      /></div>\n      <div\n        ><label class=\"label\" for=\"guest-email\">Email</label\n        ><input\n          class=\"input\"\n          id=\"guest-email\"\n          name=\"email\"\n          type=\"email\"\n          autocomplete=\"email\"\n          required\n          aria-describedby=\"guest-hint\"\n      /></div>\n    </div>\n    <textarea class=\"textarea\" name=\"comment\" rows=\"3\" required placeholder=\"Your reply…\" aria-label=\"Reply\"></textarea>\n    <div class=\"mk-comment-form-footer\">\n      <p class=\"mk-comment-form-hint\" id=\"guest-hint\">Your email is never shown.</p>\n      <button type=\"submit\" class=\"btn\">Post reply</button>\n    </div>\n  </div>\n</form>\n","individual":true},{"label":"Reply","html":"<form class=\"mk-comment-form\" data-variant=\"reply\" aria-label=\"Reply to Hannah Lee\" style=\"max-width: 36rem\">\n  <span class=\"avatar\" data-size=\"sm\"><img class=\"avatar-image\" src=\"images/mk-portrait.png\" alt=\"\" /></span>\n  <div class=\"mk-comment-form-main\">\n    <textarea\n      class=\"textarea\"\n      name=\"reply\"\n      rows=\"2\"\n      required\n      placeholder=\"Reply to Hannah…\"\n      aria-label=\"Reply to Hannah Lee\"\n    ></textarea>\n    <div class=\"mk-comment-form-footer\">\n      <button type=\"reset\" class=\"btn\" data-variant=\"ghost\" data-size=\"sm\">Cancel</button>\n      <button type=\"submit\" class=\"btn\" data-size=\"sm\">Reply</button>\n    </div>\n  </div>\n</form>\n","individual":true},{"label":"Write and preview","html":"<form class=\"mk-comment-form\" data-variant=\"framed\" aria-label=\"Add a comment\" style=\"max-width: 44rem\">\n  <span class=\"avatar\"><img class=\"avatar-image\" src=\"images/mk-portrait.png\" alt=\"\" /></span>\n  <div class=\"mk-comment-form-main\">\n    <div class=\"tabs\">\n      <div class=\"mk-comment-form-toolbar\">\n        <div class=\"tab-list\" role=\"tablist\" aria-label=\"Editor\">\n          <button\n            class=\"tab-trigger\"\n            role=\"tab\"\n            type=\"button\"\n            aria-selected=\"true\"\n            aria-controls=\"cf-write\"\n            id=\"cf-tab-write\"\n            >Write</button\n          >\n          <button\n            class=\"tab-trigger\"\n            role=\"tab\"\n            type=\"button\"\n            aria-selected=\"false\"\n            aria-controls=\"cf-preview\"\n            id=\"cf-tab-preview\"\n            tabindex=\"-1\"\n            >Preview</button\n          >\n        </div>\n        <div\n          class=\"separator\"\n          data-orientation=\"vertical\"\n          role=\"separator\"\n          style=\"height: 1.25rem; margin-inline: 0.25rem\"\n        ></div>\n        <div class=\"toggle-group\" role=\"group\" aria-label=\"Formatting\" data-type=\"multiple\" data-size=\"sm\">\n          <button class=\"toggle\" type=\"button\" aria-pressed=\"false\" aria-label=\"Bold\"\n            ><i data-lucide=\"bold\"></i\n          ></button>\n          <button class=\"toggle\" type=\"button\" aria-pressed=\"false\" aria-label=\"Italic\"\n            ><i data-lucide=\"italic\"></i\n          ></button>\n          <button class=\"toggle\" type=\"button\" aria-pressed=\"false\" aria-label=\"Code\"\n            ><i data-lucide=\"code\"></i\n          ></button>\n        </div>\n        <button class=\"btn\" data-variant=\"ghost\" data-size=\"icon-sm\" type=\"button\" aria-label=\"Insert link\"\n          ><i data-lucide=\"link\"></i\n        ></button>\n      </div>\n      <div class=\"tab-content\" role=\"tabpanel\" id=\"cf-write\" aria-labelledby=\"cf-tab-write\">\n        <textarea\n          class=\"textarea\"\n          name=\"comment\"\n          rows=\"3\"\n          required\n          minlength=\"2\"\n          placeholder=\"Join the discussion… Markdown works.\"\n          aria-label=\"Comment\"\n        ></textarea>\n      </div>\n      <div class=\"tab-content\" role=\"tabpanel\" id=\"cf-preview\" aria-labelledby=\"cf-tab-preview\" hidden>\n        <p style=\"margin: 0; padding: 0.75rem; font-size: 0.875rem\"\n          >The preview renders your <strong>Markdown</strong> here.</p\n        >\n      </div>\n    </div>\n    <div class=\"mk-comment-form-footer\">\n      <p class=\"mk-comment-form-hint\"><kbd class=\"kbd\">⌘</kbd> <kbd class=\"kbd\">Enter</kbd> to post</p>\n      <button type=\"submit\" class=\"btn\" data-size=\"sm\">Post comment</button>\n    </div>\n  </div>\n</form>\n","individual":true},{"label":"Review with a rating","html":"<form class=\"mk-comment-form\" aria-label=\"Write a review\" style=\"max-width: 40rem\">\n  <span class=\"avatar\"><img class=\"avatar-image\" src=\"images/mk-portrait2.png\" alt=\"\" /></span>\n  <div class=\"mk-comment-form-main\">\n    <fieldset class=\"rating\" aria-label=\"Your rating\">\n      <label class=\"rating-item\"\n        ><input class=\"rating-input\" type=\"radio\" name=\"stars\" value=\"1\" aria-label=\"1 star\" required\n      /></label>\n      <label class=\"rating-item\"\n        ><input class=\"rating-input\" type=\"radio\" name=\"stars\" value=\"2\" aria-label=\"2 stars\"\n      /></label>\n      <label class=\"rating-item\"\n        ><input class=\"rating-input\" type=\"radio\" name=\"stars\" value=\"3\" aria-label=\"3 stars\"\n      /></label>\n      <label class=\"rating-item\"\n        ><input class=\"rating-input\" type=\"radio\" name=\"stars\" value=\"4\" aria-label=\"4 stars\"\n      /></label>\n      <label class=\"rating-item\"\n        ><input class=\"rating-input\" type=\"radio\" name=\"stars\" value=\"5\" aria-label=\"5 stars\"\n      /></label>\n    </fieldset>\n    <textarea\n      class=\"textarea\"\n      name=\"review\"\n      rows=\"3\"\n      required\n      placeholder=\"What did you like? What should change?\"\n      aria-label=\"Review\"\n    ></textarea>\n    <div class=\"mk-comment-form-footer\">\n      <button type=\"submit\" class=\"btn\">Post review</button>\n    </div>\n  </div>\n</form>\n","individual":true},{"label":"Signed out","html":"<div class=\"alert\" role=\"note\" style=\"max-width: 44rem\">\n  <svg\n    class=\"alert-icon\"\n    xmlns=\"http://www.w3.org/2000/svg\"\n    width=\"16\"\n    height=\"16\"\n    viewBox=\"0 0 24 24\"\n    fill=\"none\"\n    stroke=\"currentColor\"\n    stroke-width=\"2\"\n    stroke-linecap=\"round\"\n    stroke-linejoin=\"round\"\n    aria-hidden=\"true\"\n  >\n    <path d=\"M7.9 20A9 9 0 1 0 4 16.1L2 22Z\" />\n  </svg>\n  <div class=\"alert-content\">\n    <h5 class=\"alert-title\">Join the discussion</h5>\n    <p class=\"alert-description\">Sign in to comment - it takes ten seconds with a passkey.</p>\n  </div>\n  <div class=\"alert-action\"><a class=\"btn\" data-size=\"sm\" href=\"#\">Sign in</a></div>\n</div>\n","individual":false}]
