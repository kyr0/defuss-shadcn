[{"label":"Checkout latency post-mortem","html":"<figure class=\"diagram\" id=\"dg-fish\" data-type=\"fishbone\" aria-label=\"Root causes of checkout latency\">\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Fishbone · post-mortem</span>\n    <span class=\"diagram-title\">Why checkout p95 went past 2 seconds</span>\n    <span class=\"diagram-dek\">Six categories investigated; the confirmed root cause is the accent bone.</span>\n  </figcaption>\n  <div class=\"diagram-canvas\" style=\"--cols: 4; --diagram-node-w: 10rem\">\n    <div class=\"diagram-node\" data-node=\"people\" data-bone style=\"--col: 1; --row: 1\">\n      <span class=\"diagram-node-name\">People</span>\n      <ul class=\"diagram-node-fields\">\n        <li>on-call handover gap</li>\n        <li>no perf owner</li>\n      </ul>\n    </div>\n    <div class=\"diagram-node\" data-node=\"process\" data-bone style=\"--col: 2; --row: 1\">\n      <span class=\"diagram-node-name\">Process</span>\n      <ul class=\"diagram-node-fields\">\n        <li>no load test in CI</li>\n        <li>big-bang release</li>\n      </ul>\n    </div>\n    <div class=\"diagram-node\" data-node=\"tools\" data-bone style=\"--col: 3; --row: 1\">\n      <span class=\"diagram-node-name\">Tools</span>\n      <ul class=\"diagram-node-fields\">\n        <li>APM sampling 1%</li>\n      </ul>\n    </div>\n    <div\n      class=\"diagram-node\"\n      data-node=\"data\"\n      data-tone=\"accent\"\n      data-side=\"below\"\n      data-step-label=\"Root cause\"\n      data-bone\n      style=\"--col: 1; --row: 3\"\n    >\n      <span class=\"diagram-node-name\">Data</span>\n      <ul class=\"diagram-node-fields\">\n        <li>N+1 query on cart</li>\n        <li>missing index</li>\n      </ul>\n    </div>\n    <div class=\"diagram-node\" data-node=\"env\" data-side=\"below\" data-bone style=\"--col: 2; --row: 3\">\n      <span class=\"diagram-node-name\">Environment</span>\n      <ul class=\"diagram-node-fields\">\n        <li>Black Friday traffic</li>\n        <li>noisy neighbour</li>\n      </ul>\n    </div>\n    <div class=\"diagram-node\" data-node=\"vendors\" data-side=\"below\" data-bone style=\"--col: 3; --row: 3\">\n      <span class=\"diagram-node-name\">Vendors</span>\n      <ul class=\"diagram-node-fields\">\n        <li>tax API slow</li>\n        <li>CDN purge storm</li>\n      </ul>\n    </div>\n    <div\n      class=\"diagram-node\"\n      data-node=\"effect\"\n      data-tone=\"accent\"\n      data-step-label=\"The effect\"\n      data-effect\n      style=\"--col: 4; --row: 1; --rspan: 3\"\n    >\n      <span class=\"diagram-node-eyebrow\">Effect</span>\n      <span class=\"diagram-node-name\">Checkout p95 > 2s for 3h</span>\n      <span class=\"diagram-node-meta\">18% cart abandonment</span>\n    </div>\n  </div>\n</figure>\n","individual":true},{"label":"The investigation, bone by bone","html":"<figure\n  class=\"diagram\"\n  id=\"dg-fish-steps\"\n  data-type=\"fishbone\"\n  data-steps\n  data-autoplay\n  aria-label=\"Root causes of checkout latency\"\n>\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Fishbone · post-mortem</span>\n    <span class=\"diagram-title\">Why checkout p95 went past 2 seconds</span>\n    <span class=\"diagram-dek\">Six categories investigated; the confirmed root cause is the accent bone.</span>\n  </figcaption>\n  <div class=\"diagram-canvas\" style=\"--cols: 4; --diagram-node-w: 10rem\">\n    <div class=\"diagram-node\" data-node=\"people\" data-step=\"2\" data-bone style=\"--col: 1; --row: 1\">\n      <span class=\"diagram-node-name\">People</span>\n      <ul class=\"diagram-node-fields\">\n        <li>on-call handover gap</li>\n        <li>no perf owner</li>\n      </ul>\n    </div>\n    <div class=\"diagram-node\" data-node=\"process\" data-step=\"3\" data-bone style=\"--col: 2; --row: 1\">\n      <span class=\"diagram-node-name\">Process</span>\n      <ul class=\"diagram-node-fields\">\n        <li>no load test in CI</li>\n        <li>big-bang release</li>\n      </ul>\n    </div>\n    <div class=\"diagram-node\" data-node=\"tools\" data-step=\"4\" data-bone style=\"--col: 3; --row: 1\">\n      <span class=\"diagram-node-name\">Tools</span>\n      <ul class=\"diagram-node-fields\">\n        <li>APM sampling 1%</li>\n      </ul>\n    </div>\n    <div\n      class=\"diagram-node\"\n      data-node=\"data\"\n      data-tone=\"accent\"\n      data-side=\"below\"\n      data-step=\"5\"\n      data-step-label=\"Root cause\"\n      data-bone\n      style=\"--col: 1; --row: 3\"\n    >\n      <span class=\"diagram-node-name\">Data</span>\n      <ul class=\"diagram-node-fields\">\n        <li>N+1 query on cart</li>\n        <li>missing index</li>\n      </ul>\n    </div>\n    <div class=\"diagram-node\" data-node=\"env\" data-side=\"below\" data-step=\"6\" data-bone style=\"--col: 2; --row: 3\">\n      <span class=\"diagram-node-name\">Environment</span>\n      <ul class=\"diagram-node-fields\">\n        <li>Black Friday traffic</li>\n        <li>noisy neighbour</li>\n      </ul>\n    </div>\n    <div class=\"diagram-node\" data-node=\"vendors\" data-side=\"below\" data-step=\"7\" data-bone style=\"--col: 3; --row: 3\">\n      <span class=\"diagram-node-name\">Vendors</span>\n      <ul class=\"diagram-node-fields\">\n        <li>tax API slow</li>\n        <li>CDN purge storm</li>\n      </ul>\n    </div>\n    <div\n      class=\"diagram-node\"\n      data-node=\"effect\"\n      data-tone=\"accent\"\n      data-step=\"1\"\n      data-step-label=\"The effect\"\n      data-effect\n      style=\"--col: 4; --row: 1; --rspan: 3\"\n    >\n      <span class=\"diagram-node-eyebrow\">Effect</span>\n      <span class=\"diagram-node-name\">Checkout p95 > 2s for 3h</span>\n      <span class=\"diagram-node-meta\">18% cart abandonment</span>\n    </div>\n  </div>\n</figure>\n","individual":true},{"label":"Day 1 → day 3","html":"<figure\n  class=\"diagram\"\n  id=\"dg-fish-delta\"