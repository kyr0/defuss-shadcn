[{"label":"Between nine cities","html":"<div class=\"grid gap-3\">\n  <div class=\"flex flex-wrap items-end gap-3\">\n    <div class=\"grid gap-1\">\n      <label class=\"label\" for=\"r-from\">From</label>\n      <select class=\"select\" id=\"r-from\"></select>\n    </div>\n    <div class=\"grid gap-1\">\n      <label class=\"label\" for=\"r-to\">To</label>\n      <select class=\"select\" id=\"r-to\"></select>\n    </div>\n    <output class=\"text-sm\" id=\"r-result\"></output>\n  </div>\n  <div\n    class=\"geo-map\"\n    id=\"network\"\n    aria-label=\"A city network\"\n    data-projection=\"mercator\"\n    data-center=\"10.5,51\"\n    data-zoom=\"11\"\n    data-palette=\"mono\"\n    data-graticule=\"false\"\n  ></div>\n</div>\n","individual":false},{"label":"From 30 % along one segment to 60 % along another","html":"<div class=\"grid gap-2\">\n  <output class=\"text-sm\" id=\"at-result\"></output>\n  <div\n    class=\"geo-map\"\n    id=\"at-map\"\n    aria-label=\"A route between positions inside segments\"\n    data-projection=\"mercator\"\n    data-center=\"10,50.5\"\n    data-zoom=\"14\"\n    data-palette=\"mono\"\n    data-graticule=\"false\"\n  ></div>\n</div>\n","individual":false},{"label":"Click the map: nodes in a box, the nearest one","html":"<div class=\"grid gap-2\">\n  <output class=\"text-sm\" id=\"mo-result\">Click the map.</output>\n  <div\n    class=\"geo-map\"\n    id=\"mo-map\"\n    aria-label=\"Random nodes\"\n    data-select=\"none\"\n    data-projection=\"mercator\"\n    data-center=\"10,50\"\n    data-zoom=\"4\"\n    data-palette=\"mono\"\n    data-graticule=\"false\"\n  ></div>\n</div>\n","individual":false}]
