[{"label":"111,110 nodes","html":"<div class=\"flex flex-col gap-3\">\n  <div class=\"flex flex-wrap gap-2\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"tg-open\">Expand all</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"tg-close\">Collapse all</button>\n  </div>\n  <div\n    class=\"data-grid\"\n    id=\"tg-geo\"\n    aria-label=\"Regions\"\n    data-parent-field=\"parentId\"\n    data-select=\"single\"\n    data-empty-text=\"No place matches.\"\n    style=\"height: 26rem\"\n  >\n    <div class=\"data-grid-viewport\">\n      <div class=\"data-grid-head\">\n        <div class=\"data-grid-row\">\n          <div class=\"data-grid-header\" data-field=\"name\" data-width=\"18rem\" data-filter=\"text\" data-locked>Name</div>\n          <div\n            class=\"data-grid-header\"\n            data-field=\"kind\"\n            data-width=\"7rem\"\n            data-filter=\"select\"\n            data-options=\"region,country,city,district\"\n            >Kind</div\n          >\n          <div\n            class=\"data-grid-header\"\n            data-field=\"population\"\n            data-type=\"number\"\n            data-width=\"9rem\"\n            data-filter=\"number\"\n            >Population</div\n          >\n          <div class=\"data-grid-header\" data-field=\"area\" data-type=\"number\" data-width=\"8rem\">Area km²</div>\n          <div class=\"data-grid-header\" data-field=\"growth\" data-type=\"number\" data-format=\"percent\" data-width=\"7rem\"\n            >Growth</div\n          >\n        </div>\n      </div>\n      <div class=\"data-grid-body\"></div>\n    </div>\n  </div>\n</div>\n","individual":false},{"label":"Paged tree","html":"<div\n  class=\"data-grid\"\n  id=\"tg-pages\"\n  aria-label=\"Departments\"\n  data-parent-field=\"parentId\"\n  data-paging=\"pages\"\n  data-page-size=\"15\"\n  style=\"height: 24rem; max-width: 40rem\"\n>\n  <div class=\"data-grid-viewport\">\n    <div class=\"data-grid-head\">\n      <div class=\"data-grid-row\">\n        <div class=\"data-grid-header\" data-field=\"name\" data-width=\"minmax(14rem, 1fr)\" data-filter=\"text\">Team</div>\n        <div class=\"data-grid-header\" data-field=\"headcount\" data-type=\"number\" data-width=\"7rem\">People</div>\n        <div\n          class=\"data-grid-header\"\n          data-field=\"budget\"\n          data-type=\"number\"\n          data-format=\"currency:EUR\"\n          data-width=\"9rem\"\n          >Budget</div\n        >\n      </div>\n    </div>\n    <div class=\"data-grid-body\"></div>\n  </div>\n</div>\n","individual":false},{"label":"Driven through the store","html":"<div class=\"flex flex-col gap-3\" style=\"max-width: 36rem\">\n  <div class=\"flex flex-wrap gap-2\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" data-open=\"src\">Open src</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" data-open=\"src,src/components\"\n      >Open src/components</button\n    >\n    <button class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" type=\"button\" data-open=\"\">Close all</button>\n  </div>\n  <div class=\"data-grid\" id=\"tg-files\" aria-label=\"Repository\" data-parent-field=\"parentId\" style=\"height: 16rem\">\n    <div class=\"data-grid-viewport\">\n      <div class=\"data-grid-head\">\n        <div class=\"data-grid-row\">\n          <div class=\"data-grid-header\" data-field=\"name\" data-width=\"minmax(12rem, 1fr)\">Path</div>\n          <div class=\"data-grid-header\" data-field=\"size\" data-type=\"number\" data-width=\"7rem\">Bytes</div>\n        </div>\n      </div>\n      <div class=\"data-grid-body\"></div>\n    </div>\n  </div>\n  <p class=\"text-sm text-muted-foreground m-0\" id=\"tg-files-open\" aria-live=\"polite\"></p>\n</div>\n","individual":false}]
