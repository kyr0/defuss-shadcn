[{"label":"Property Grid (comfortable)","html":"<div\n  class=\"property-grid\"\n  id=\"pg-comfortable\"\n  data-variant=\"comfortable\"\n  data-sort=\"asc\"\n  aria-label=\"Sorted, comfortable\"\n  style=\"flex: 1 1 16rem\"\n>\n</div>\n","individual":true},{"label":"A service's settings","html":"<div class=\"property-grid\" id=\"pg-service\" aria-label=\"Service settings\" style=\"max-width: 28rem\" data-state-demo>\n  \n  \n</div>\n","individual":true},{"label":"Badges, units, icons","html":"<div class=\"property-grid\" id=\"pg-render\" aria-label=\"Endpoint health\" style=\"max-width: 28rem\"></div>\n","individual":true},{"label":"Rules and a cross-field check","html":"<div class=\"property-grid\" id=\"pg-valid\" aria-label=\"Deployment\" style=\"max-width: 30rem\">\n  \n  \n</div>\n","individual":true},{"label":"A slider, a tag combobox, a guarded value","html":"<div class=\"property-grid\" id=\"pg-editors\" aria-label=\"Widget\" style=\"max-width: 30rem\"></div>\n<template id=\"pg-tags-editor\">\n  <div class=\"combobox\" data-multiple data-tags data-creatable style=\"width: 100%\">\n    <div class=\"combobox-field\">\n      <input\n        class=\"combobox-field-input\"\n        id=\"pg-tags-input\"\n        type=\"text\"\n        role=\"combobox\"\n        autocomplete=\"off\"\n        aria-label=\"Tags\"\n        aria-expanded=\"false\"\n        aria-controls=\"pg-tags-list\"\n        aria-autocomplete=\"list\"\n        placeholder=\"Add a tag…\"\n      />\n    </div>\n    <div id=\"pg-tags-pop\" class=\"combobox-content\" popover=\"manual\">\n      <div id=\"pg-tags-list\" role=\"listbox\" class=\"combobox-listbox\" aria-label=\"Tags\">\n        <div class=\"combobox-empty\" hidden>No tag like that.</div>\n        <div role=\"option\" id=\"pg-tag-finance\" class=\"combobox-item\" data-value=\"finance\" aria-selected=\"false\"\n          >finance</div\n        >\n        <div role=\"option\" id=\"pg-tag-weekly\" class=\"combobox-item\" data-value=\"weekly\" aria-selected=\"false\"\n          >weekly</div\n        >\n        <div role=\"option\" id=\"pg-tag-board\" class=\"combobox-item\" data-value=\"board\" aria-selected=\"false\">board</div>\n        <div role=\"option\" id=\"pg-tag-public\" class=\"combobox-item\" data-value=\"public\" aria-selected=\"false\"\n          >public</div\n        >\n      </div>\n    </div>\n  </div>\n</template>\n<p class=\"text-sm text-muted-foreground mt-2\" id=\"pg-editors-log\">No change yet.</p>\n","individual":false},{"label":"Read, write, follow","html":"<div class=\"flex flex-wrap gap-2 mb-3\">\n  <button type=\"button\" class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"pg-data-read\">Read replicas</button>\n  <button type=\"button\" class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"pg-data-scale\">Set replicas = 6</button>\n  <button type=\"button\" class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"pg-data-flip\">Toggle public</button>\n  <button type=\"button\" class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" id=\"pg-data-reset\">Reset</button>\n  <output class=\"text-sm text-muted-foreground self-center\" id=\"pg-data-out\">Nothing read yet.</output>\n</div>\n<div class=\"grid gap-3\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div class=\"property-grid\" id=\"pg-data\" aria-label=\"Service\">\n    \n  </div>\n  <div class=\"mockup-code\" data-numbers data-title=\"source.json\" id=\"pg-data-json\" aria-live=\"polite\"></div>\n</div>\n<div class=\"flex flex-col gap-2 mt-3\">\n  <label class=\"label\" for=\"pg-data-text\">Set the whole object from JSON</label>\n  <textarea class=\"textarea\" id=\"pg-data-text\" rows=\"4\" style=\"font-family: var(--font-mono); font-size: 0.8125rem\">\n{ \"name\": \"search\", \"replicas\": 4, \"public\": true, \"region\": \"us-east-1\", \"limits\": { \"rps\": 900, \"burst\": 120 } }</textarea>\n  <div class=\"flex items-center gap-2\">\n    <button type=\"button\" class=\"btn\" data-size=\"sm\" id=\"pg-data-apply\">Apply JSON</button>\n    <output class=\"text-sm\" id=\"pg-data-error\" style=\"color: var(--destructive)\"></output>\n  </div>\n</div>\n","individual":false},{"label":"Select, inspect, edit","html":"<div class=\"flex items-center gap-2 mb-3\">\n  <button type=\"button\" class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-panel-toggle=\"pg-inspector\"\n    ><i data-lucide=\"panel-right\"></i> Inspector</button\n  >\n  <span class=\"text-sm text-muted-foreground\">Click a box or an arrow.</span>\n</div>\n<div class=\"border-layout\" style=\"height: 24rem\">\n  <main class=\"border-layout-center\" style=\"overflow: auto; padding: 0.75rem\">\n    <figure\n      class=\"diagram\"\n      id=\"pg-diagram\"\n      data-type=\"architecture\"\n      data-interactive\n      data-frame=\"none\"\n      aria-label=\"Checkout service\"\n    >\n      <div class=\"diagram-canvas\" style=\"--cols: 3; --diagram-col-min: 6.5rem; --diagram-node-w: 8.5rem\">\n        <div class=\"diagram-node\" data-node=\"web\" style=\"--col: 1; --row: 1\"\n          ><span class=\"diagram-node-name\">Web app</span><span class=\"diagram-node-meta\">Next.js</span></div\n        >\n        <div class=\"diagram-node\" data-node=\"api\" data-tone=\"accent\" style=\"--col: 2; --row: 1\"\n          ><span class=\"diagram-node-name\">API</span><span class=\"diagram-node-meta\">gateway</span></div\n        >\n        <div class=\"diagram-node\" data-node=\"db\" data-shape=\"store\" style=\"--col: 3; --row: 1\"\n          ><span class=\"diagram-node-name\">Orders</span><span class=\"diagram-node-meta\">Postgres</span></div\n        >\n        <div class=\"diagram-node\" data-node=\"mail\" data-tone=\"external\" style=\"--col: 2; --row: 2\"\n          ><span class=\"diagram-node-name\">Mailer</span><span class=\"diagram-node-meta\">external</span></div\n        >\n      </div>\n      <ol class=\"diagram-edges\">\n        <li class=\"diagram-edge\" data-from=\"web\" data-to=\"api\">HTTPS</li>\n        <li class=\"diagram-edge\" data-from=\"api\" data-to=\"db\">SQL</li>\n        <li class=\"diagram-edge\" data-from=\"api\" data-to=\"mail\" data-line=\"dashed\">notify</li>\n      </ol>\n    </figure>\n  </main>\n  <div class=\"resizer border-layout-east\">\n    <section class=\"card panel\" id=\"pg-inspector\" style=\"width: 17rem\" aria-labelledby=\"pg-inspector-title\">\n      <header class=\"panel-header\">\n        <i data-lucide=\"sliders-horizontal\" class=\"panel-icon\" aria-hidden=\"true\"></i>\n        <h3 class=\"panel-title\" id=\"pg-inspector-title\">Inspector</h3>\n        <div class=\"panel-tools\">\n          <button\n            type=\"button\"\n            class=\"btn panel-close\"\n            data-variant=\"ghost\"\n            data-size=\"icon-sm\"\n            aria-label=\"Close Inspector\"\n            ><i data-lucide=\"x\"></i\n          ></button>\n        </div>\n      </header>\n      <div class=\"panel-body\" data-flush>\n        <div\n          class=\"property-grid\"\n          id=\"pg-selection\"\n          data-frame=\"none\"\n          data-empty-text=\"Select a box or an arrow.\"\n          aria-label=\"Selection properties\"\n        ></div>\n      </div>\n    </section>\n  </div>\n</div>\n","individual":false},{"label":"Comfortable, sorted, read-only","html":"<div class=\"flex flex-wrap gap-4\">\n  <div\n    class=\"property-grid\"\n    id=\"pg-comfortable\"\n    data-variant=\"comfortable\"\n    data-sort=\"asc\"\n    aria-label=\"Sorted, comfortable\"\n    style=\"flex: 1 1 16rem\"\n  >\n    \n  </div>\n  <div\n    class=\"property-grid\"\n    id=\"pg-readonly\"\n    data-readonly\n    data-key-label=\"Field\"\n    data-value-label=\"Reading\"\n    aria-label=\"Read-only\"\n    style=\"flex: 1 1 16rem\"\n  >\n    \n  </div>\n</div>\n","individual":false}]
