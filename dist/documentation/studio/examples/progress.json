ize=\"lg\" value=\"40\" max=\"100\" aria-label=\"تحميل\"></progress>\n  <output class=\"progress-value\" for=\"rtl-p\"></output>\n</div>\n","individual":true},{"label":"Values","html":"<div class=\"flex flex-col gap-3 w-full\" style=\"max-width: 24rem\">\n  <progress class=\"progress\" value=\"10\" max=\"100\">10%</progress>\n  <progress class=\"progress\" value=\"40\" max=\"100\">40%</progress>\n  <progress class=\"progress\" value=\"75\" max=\"100\">75%</progress>\n</div>\n","individual":false},{"label":"Colors","html":"<div class=\"flex flex-col gap-4 w-full\" style=\"max-width: 24rem\">\n  <div class=\"progress-field\">\n    <div class=\"progress-header\"\n      ><span class=\"progress-label\">Tests passing</span><output class=\"progress-value\" for=\"c-ok\"></output\n    ></div>\n    <progress class=\"progress\" id=\"c-ok\" data-tone=\"success\" value=\"92\" max=\"100\"></progress>\n  </div>\n  <div class=\"progress-field\">\n    <div class=\"progress-header\"\n      ><span class=\"progress-label\">Disk space</span><output class=\"progress-value\" for=\"c-warn\"></output\n    ></div>\n    <progress class=\"progress\" id=\"c-warn\" data-tone=\"warning\" value=\"78\" max=\"100\"></progress>\n  </div>\n  <div class=\"progress-field\">\n    <div class=\"progress-header\"\n      ><span class=\"progress-label\">Sync</span><output class=\"progress-value\" for=\"c-info\"></output\n    ></div>\n    <progress class=\"progress\" id=\"c-info\" data-tone=\"info\" value=\"45\" max=\"100\"></progress>\n  </div>\n  <div class=\"progress-field\">\n    <div class=\"progress-header\"\n      ><span class=\"progress-label\">Quota</span><output class=\"progress-value\" for=\"c-bad\"></output\n    ></div>\n    <progress class=\"progress\" id=\"c-bad\" data-tone=\"destructive\" value=\"97\" max=\"100\"></progress>\n  </div>\n  <div class=\"progress-field\">\n    <div class=\"progress-header\"\n      ><span class=\"progress-label\">Brand color</span><output class=\"progress-value\" for=\"c-custom\"></output\n    ></div>\n    <progress\n      class=\"progress\"\n      id=\"c-custom\"\n      value=\"60\"\n      max=\"100\"\n      style=\"--progress-color: oklch(0.62 0.2 300)\"\n    ></progress>\n  </div>\n  <div class=\"flex flex-col gap-2\">\n    <span class=\"progress-label\">Auto: 20 · 50 · 85</span>\n    <progress class=\"progress\" data-tone=\"auto\" value=\"20\" max=\"100\" aria-label=\"Auto tone, 20%\"></progress>\n    <progress class=\"progress\" data-tone=\"auto\" value=\"50\" max=\"100\" aria-label=\"Auto tone, 50%\"></progress>\n    <progress class=\"progress\" data-tone=\"auto\" value=\"85\" max=\"100\" aria-label=\"Auto tone, 85%\"></progress>\n  </div>\n</div>\n","individual":false},{"label":"Labels","html":"<div class=\"flex flex-col gap-4 w-full\" style=\"max-width: 24rem\">\n  <div class=\"progress-field\">\n    <div class=\"progress-header\"\n      ><span class=\"progress-label\">Percent</span><output class=\"progress-value\" for=\"l-pct\"></output\n    ></div>\n    <progress class=\"progress\" id=\"l-pct\" value=\"38\" max=\"100\"></progress>\n  </div>\n  <div class=\"progress-field\">\n    <div class=\"progress-header\"\n      ><span class=\"progress-label\">Lessons</span\n      ><output class=\"progress-value\" for=\"l-frac\" data-format=\"fraction\"></output\n    ></div>\n    <progress class=\"progress\" id=\"l-frac\" value=\"3\" max=\"8\"></progress>\n  </div>\n  <div class=\"progress-field\">\n    <div class=\"progress-header\"\n      ><span class=\"progress-label\">Upload</span\n      ><output class=\"progress-value\" for=\"l-tpl\" data-template=\"{value} of {max} files · {percent}\"></output\n    ></div>\n    <progress class=\"progress\" id=\"l-tpl\" value=\"12\" max=\"40\"></progress>\n    <span class=\"progress-hint\">About 2 minutes left</span>\n  </div>\n</div>\n","individual":false},{"label":"Label inside the bar","html":"<div class=\"flex flex-col gap-4 w-full\" style=\"max-width: 24rem\">\n  <div class=\"progress-field\" data-label=\"inside\">\n    <progress class=\"progress\" id=\"in-1\" value=\"45\" max=\"100\" aria-label=\"Import\"></progress>\n    <output class=\"progress-value\" for=\"in-1\"></output>\n  </div>\n  <div class=\"progress-field\" data-label=\"inside\">\n    <progress\n      class=\"progress\"\n      id=\"in-2\"\n      data-tone=\"success\"\n      data-size=\"lg\"\n      value=\"7\"\n      max=\"10\"\n      aria-label=\"Steps\"\n    ></progress>\n    <output class=\"progress-value\" for=\"in-2\" data-format=\"fraction\"></output>\n  </div>\n  <div class=\"progress-field\" data-label=\"inside\">\n    <progress\n      class=\"progress\"\n      id=\"in-3\"\n      data-tone=\"warning\"\n      data-size=\"xl\"\n      data-striped\n      value=\"62\"\n      max=\"100\"\n      aria-label=\"Backup\"\n    ></progress>\n    <output class=\"progress-value\" for=\"in-3\" data-template=\"Backup {percent}\"></output>\n  </div>\n</div>\n","individual":false},{"label":"Step by step","html":"<div class=\"flex flex-col gap-4 w-full\" style=\"max-width: 24rem\">\n  <div class=\"progress-field\">\n    <div class=\"progress-header\"\n      ><span class=\"progress-label\">Installing packages</span><output class=\"progress-value\" for=\"st\"></output\n    ></div>\n    <progress class=\"progress\" id=\"st\" value=\"30\" max=\"100\" data-step=\"10\" aria-label=\"Installing packages\"></progress>\n  </div>\n  <div class=\"flex flex-wrap gap-2\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" commandfor=\"st\" command=\"--decrement\"\n      >− 10%</button\n    >\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" commandfor=\"st\" command=\"--increment\"\n      >+ 10%</button\n    >\n    <button class=\"btn\" data-variant=\"secondary\" data-size=\"sm\" type=\"button\" onclick=\"runSteps()\">Run</button>\n    <button class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" type=\"button\" commandfor=\"st\" command=\"--reset\"\n      >Reset</button\n    >\n  </div>\n</div>\n","individual":false},{"label":"Linear (interpolated)","html":"<div class=\"flex flex-col gap-4 w-full\" style=\"max-width: 24rem\">\n  <div class=\"progress-field\" data-label=\"inside\">\n    <progress\n      class=\"progress\"\n      id=\"lin\"\n      data-size=\"lg\"\n      data-duration=\"4000\"\n      value=\"0\"\n      max=\"100\"\n      aria-label=\"Rendering video\"\n    ></progress>\n    <output class=\"progress-value\" for=\"lin\"></output>\n  </div>\n  <div class=\"flex flex-wrap gap-2\">\n    <button class=\"btn\" data-size=\"sm\" type=\"button\" commandfor=\"lin\" command=\"--play\">Play</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" commandfor=\"lin\" command=\"--pause\"\n      >Pause</button\n    >\n    <button\n      class=\"btn\"\n      data-variant=\"outline\"\n      data-size=\"sm\"\n      type=\"button\"\n      onclick=\"document.getElementById('lin').api.setState('default', { value: 75, duration: 1200 })\"\n      >Glide to 75%</button\n    >\n    <button class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" type=\"button\" commandfor=\"lin\" command=\"--reset\"\n      >Reset</button\n    >\n  </div>\n</div>\n","individual":false},{"label":"Striped","html":"<div class=\"flex flex-col gap-3 w-full\" style=\"max-width: 24rem\">\n  <progress class=\"progress\" data-size=\"lg\" data-striped value=\"55\" max=\"100\" aria-label=\"Striped\"></progress>\n  <progress\n    class=\"progress\"\n    data-size=\"lg\"\n    data-striped=\"animated\"\n    data-tone=\"info\"\n    value=\"70\"\n    max=\"100\"\n    aria-label=\"Striped, animated\"\n  ></progress>\n</div>\n","individual":false},{"label":"In cards","html":"<div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 1rem; max-width: 42rem\">\n  <article class=\"card\">\n    <div class=\"card-content progress-field\" style=\"padding: 1.5rem\">\n      <div class=\"progress-header\"\n        ><span class=\"progress-label\">Storage</span\n        ><output class=\"progress-value\" for=\"k-1\" data-template=\"{value} / {max} GB\"></output\n      ></div>\n      <progress class=\"progress\" id=\"k-1\" data-tone=\"auto\" value=\"75\" max=\"100\" aria-label=\"Storage\"></progress>\n    </div>\n  </article>\n  <article class=\"card\">\n    <div class=\"card-content progress-field\" style=\"padding: 1.5rem\">\n      <div class=\"progress-header\"\n        ><span class=\"progress-label\">Bandwidth</span><output class=\"progress-value\" for=\"k-2\"></output\n      ></div>\n      <progress class=\"progress\" id=\"k-2\" data-tone=\"auto\" value=\"42\" max=\"100\" aria-label=\"Bandwidth\"></progress>\n    </div>\n  </article>\n  <article class=\"card\">\n    <div class=\"card-content progress-field\" style=\"padding: 1.5rem\">\n      <div class=\"progress-header\"\n        ><span class=\"progress-label\">Onboarding</span\n        ><output class=\"progress-value\" for=\"k-3\" data-format=\"fraction\"></output\n      ></div>\n      <progress class=\"progress\" id=\"k-3\" data-tone=\"success\" value=\"5\" max=\"6\" aria-label=\"Onboarding\"></progress>\n    </div>\n  </article>\n</div>\n","individual":false},{"label":"Sizes","html":"<div class=\"flex items-center gap-4 mb-3\">\n  <span class=\"demo-label demo-label-w5\">Extra small</span>\n  <progress class=\"progress flex-1\" value=\"65\" max=\"100\" data-size=\"xs\" style=\"max-width: 16rem\"></progress>\n</div>\n<div class=\"flex items-center gap-4 mb-3\">\n  <span class=\"demo-label demo-label-w5\">Small</span>\n  <progress class=\"progress flex-1\" value=\"65\" max=\"100\" data-size=\"sm\" style=\"max-width: 16rem\"></progress>\n</div>\n<div class=\"flex items-center gap-4 mb-3\">\n  <span class=\"demo-label demo-label-w5\">Medium</span>\n  <progress class=\"progress flex-1\" value=\"65\" max=\"100\" data-size=\"md\" style=\"max-width: 16rem\"></progress>\n</div>\n<div class=\"flex items-center gap-4 mb-3\">\n  <span class=\"demo-label demo-label-w5\">Large</span>\n  <progress class=\"progress flex-1\" value=\"65\" max=\"100\" data-size=\"lg\" style=\"max-width: 16rem\"></progress>\n</div>\n<div class=\"flex items-center gap-4 mb-3\">\n  <span class=\"demo-label demo-label-w5\">Extra large</span>\n  <progress class=\"progress flex-1\" value=\"65\" max=\"100\" data-size=\"xl\" style=\"max-width: 16rem\"></progress>\n</div>\n","individual":false}]
