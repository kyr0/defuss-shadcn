[{"label":"Graph Explorer","html":"<div\n  class=\"graph-explorer\"\n  id=\"graph\"\n  data-nodes=\"100000\"\n  data-frame\n  aria-label=\"A service graph\"\n  style=\"block-size: 28rem\"\n  data-state-demo\n></div>\n","individual":true},{"label":"Breadcrumb, search, outline and details","html":"<div class=\"grid gap-2\">\n  <div class=\"flex flex-wrap items-center gap-2\">\n    <div class=\"flex-1 min-w-0\" data-graph-explorer-for=\"outlets\" data-graph-explorer-outlet=\"breadcrumb\"></div>\n    <div class=\"w-full max-w-64\" data-graph-explorer-for=\"outlets\" data-graph-explorer-outlet=\"search\"></div>\n    <button\n      class=\"btn\"\n      data-variant=\"outline\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-graph-explorer-for=\"outlets\"\n      data-graph-explorer-action=\"up\"\n    >\n      Up\n    </button>\n  </div>\n  <div class=\"grid gap-2\" style=\"grid-template-columns: 12rem minmax(0, 1fr) 16rem; block-size: 26rem\">\n    <div class=\"card overflow-hidden\" data-graph-explorer-for=\"outlets\" data-graph-explorer-outlet=\"outline\"></div>\n    <div\n      class=\"graph-explorer\"\n      id=\"outlets\"\n      data-nodes=\"100000\"\n      data-seed=\"11\"\n      data-frame\n      aria-label=\"A service graph\"\n    ></div>\n    <div class=\"card p-3 overflow-auto\" data-graph-explorer-for=\"outlets\" data-graph-explorer-outlet=\"details\"></div>\n  </div>\n  <p class=\"text-sm text-muted-foreground m-0\">\n    <output data-graph-explorer-for=\"outlets\" data-graph-explorer-output=\"status\"></output>\n  </p>\n</div>\n","individual":false},{"label":"Icon sizes and tones","html":"<p class=\"flex items-center gap-3\">\n  <i class=\"graph-explorer-icon\" data-icon=\"database\" data-size=\"xs\" aria-hidden=\"true\"></i>\n  <i class=\"graph-explorer-icon\" data-icon=\"database\" data-size=\"sm\" aria-hidden=\"true\"></i>\n  <i class=\"graph-explorer-icon\" data-icon=\"database\" aria-hidden=\"true\"></i>\n  <i class=\"graph-explorer-icon\" data-icon=\"database\" data-size=\"lg\" aria-hidden=\"true\"></i>\n  <i class=\"graph-explorer-icon\" data-icon=\"database\" data-size=\"xl\" aria-hidden=\"true\"></i>\n  <i\n    class=\"graph-explorer-icon\"\n    data-icon=\"zap-off\"\n    data-size=\"xl\"\n    data-tone=\"danger\"\n    role=\"img\"\n    aria-label=\"Breaker open\"\n  ></i>\n  <i\n    class=\"graph-explorer-icon\"\n    data-icon=\"shield-check\"\n    data-size=\"xl\"\n    data-tone=\"ok\"\n    role=\"img\"\n    aria-label=\"Breaker closed\"\n  ></i>\n</p>\n","individual":false}]
