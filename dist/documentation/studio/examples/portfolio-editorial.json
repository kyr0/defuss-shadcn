[{"label":"Clara Moreau, art director","html":"<style>\n  #pf-editorial {\n    --background: oklch(0.972 0.012 80);\n    --foreground: oklch(0.23 0.02 45);\n    --card: oklch(0.985 0.008 80);\n    --card-foreground: var(--foreground);\n    --muted: oklch(0.93 0.016 75);\n    --muted-foreground: oklch(0.47 0.025 50);\n    --border: oklch(0.85 0.02 70);\n    --input: var(--border);\n    --primary: oklch(0.52 0.14 38);\n    --primary-foreground: oklch(0.98 0.01 80);\n    --secondary: var(--muted);\n    --secondary-foreground: var(--foreground);\n    --accent: oklch(0.92 0.035 60);\n    --accent-foreground: var(--foreground);\n    --ring: var(--primary);\n    container: pf-editorial / inline-size;\n    box-sizing: border-box;\n    width: 100%;\n    padding: 1.5rem clamp(1rem, 4vw, 3rem) 3rem;\n    background: var(--background);\n    color: var(--foreground);\n    font-family: var(--font-serif);\n  }\n  .dark #pf-editorial {\n    --background: oklch(0.19 0.012 55);\n    --foreground: oklch(0.93 0.015 80);\n    --card: oklch(0.22 0.012 55);\n    --muted: oklch(0.26 0.014 55);\n    --muted-foreground: oklch(0.72 0.02 70);\n    --border: oklch(0.34 0.016 60);\n    --primary: oklch(0.74 0.12 45);\n    --primary-foreground: oklch(0.18 0.02 40);\n    --accent: oklch(0.28 0.03 50);\n  }\n  /* one view at a time: the home view or a case study */\n  #pf-editorial [hidden] {\n    display: none !important;\n  }\n  /* every type size a quarter larger: the page is zoomed by 1.25 and its measure divided by it, so the\n     columns keep their width while the type, the rules and the spacing grow together */\n  #pf-editorial .pf-page,\n  #pf-editorial .pf-view {\n    display: flex;\n    flex-direction: column;\n    gap: clamp(3rem, 7vw, 5.5rem);\n  }\n  #pf-editorial .pf-page {\n    max-width: calc(72rem / 1.25);\n    margin-inline: auto;\n    zoom: 1.25;\n  }\n  #pf-editorial .pf-label {\n    margin: 0;\n    font-family: var(--font-sans);\n    font-size: 0.6875rem;\n    font-weight: 600;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n    color: var(--muted-foreground);\n  }\n  /* the masthead: the Site Header set like a magazine's - issue, name, sections over a double rule */\n  #pf-editorial .pf-masthead {\n    background: none;\n    color: inherit;\n  }\n  #pf-editorial .pf-masthead .mk-header-inner {\n    display: grid;\n    grid-template-columns: 1fr auto 1fr;\n    align-items: end;\n    gap: 1rem;\n    max-width: none;\n    min-height: 0;\n    padding: 0 0 0.75rem;\n    border-block-end: 3px double var(--foreground);\n  }\n  #pf-editorial .mk-header-brand {\n    justify-self: center;\n    color: inherit;\n  }\n  #pf-editorial .mk-header-name {\n    color: var(--foreground);\n    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);\n    font-style: italic;\n    font-weight: 400;\n    letter-spacing: -0.01em;\n  }\n  #pf-editorial .pf-masthead-end {\n    display: flex;\n    align-items: center;\n    justify-content: flex-end;\n    gap: 1.25rem;\n  }\n  #pf-editorial .mk-header-nav {\n    display: flex;\n    gap: 1.25rem;\n  }\n  #pf-editorial .mk-header-nav a {\n    color: inherit;\n    text-decoration: none;\n  }\n  #pf-editorial .mk-header-nav a:is(:hover, :focus-visible, [aria-current]) {\n    color: var(--primary);\n  }\n  #pf-editorial .mk-resume-header-name {\n    font-family: var(--font-serif);\n    font-style: italic;\n    font-weight: 400;\n    letter-spacing: -0.035em;\n  }\n  #pf-editorial .mk-portfolio-grid-title {\n    font-family: var(--font-serif);\n    font-style: italic;\n    font-weight: 400;\n    letter-spacing: -0.02em;\n  }\n  #pf-editorial .pf-about .pf-label {\n    margin-block-end: 1rem;\n  }\n  #pf-editorial .mk-resume-header-photo {\n    filter: grayscale(1) sepia(0.15) contrast(1.05);\n  }\n  #pf-editorial .pf-quote {\n    max-width: 52rem;\n    margin: 0 auto;\n    text-align: center;\n  }\n  #pf-editorial .pf-quote blockquote {\n    margin: 0 0 1.25rem;\n    font-size: clamp(1.75rem, 1rem + 3vw, 3.25rem);\n    font-style: italic;\n    font-weight: 300;\n    line-height: 1.15;\n    text-wrap: balance;\n  }\n  #pf-editorial .pf-quote blockquote::before {\n    content: '“';\n    display: block;\n    color: var(--primary);\n    font-size: 2em;\n    line-height: 0.5;\n  }\n  #pf-editorial .pf-head {\n    display: flex;\n    align-items: baseline;\n    justify-content: space-between;\n    gap: 1rem;\n    margin-block-end: 1rem;\n  }\n  #pf-editorial .pf-feature {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));\n    gap: 2rem clamp(2rem, 5vw, 4rem);\n    align-items: center;\n  }\n  #pf-editorial .pf-feature figure {\n    margin: 0;\n  }\n  #pf-editorial .pf-feature img {\n    display: block;\n    width: 100%;\n    aspect-ratio: 4 / 3;\n    object-fit: cover;\n  }\n  #pf-editorial :is(.pf-feature, .pf-case) figcaption {\n    margin-block-start: 0.5rem;\n    font-family: var(--font-sans);\n    font-size: 0.75rem;\n    color: var(--muted-foreground);\n  }\n  #pf-editorial .pf-feature h2 {\n    margin: 0.5rem 0 1rem;\n    font-size: clamp(1.75rem, 1.25rem + 1.5vw, 2.5rem);\n    font-weight: 400;\n    line-height: 1.1;\n  }\n  #pf-editorial .pf-feature p {\n    margin: 0 0 1rem;\n    font-size: 1.0625rem;\n    line-height: 1.65;\n    text-wrap: pretty;\n  }\n  #pf-editorial .pf-feature .btn {\n    margin-block-start: 1.25rem;\n  }\n  #pf-editorial .pf-dropcap::first-letter {\n    float: inline-start;\n    margin: 0.35rem 0.6rem 0 0;\n    color: var(--primary);\n    font-size: 4.25rem;\n    font-weight: 500;\n    line-height: 0.8;\n  }\n  #pf-editorial .pf-facts {\n    display: grid;\n    grid-template-columns: repeat(3, auto);\n    justify-content: start;\n    gap: 0.25rem 2.5rem;\n    margin: 1.5rem 0 0;\n    padding-block-start: 1rem;\n    border-block-start: 1px solid var(--border);\n    font-family: var(--font-sans);\n    font-size: 0.8125rem;\n  }\n  #pf-editorial .pf-facts dt {\n    color: var(--muted-foreground);\n  }\n  #pf-editorial .pf-facts dd {\n    grid-row: 2;\n    margin: 0;\n    font-weight: 500;\n  }\n  #pf-editorial .pf-about {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));\n    gap: 2.5rem 4rem;\n    align-items: start;\n  }\n  #pf-editorial .pf-awards {\n    margin: 1rem 0 0;\n    padding: 0;\n    list-style: none;\n  }\n  #pf-editorial .pf-awards li {\n    display: flex;\n    justify-content: space-between;\n    gap: 1rem;\n    padding-block: 0.65rem;\n    border-block-end: 1px solid var(--border);\n  }\n  #pf-editorial .pf-awards span {\n    font-family: var(--font-sans);\n    font-size: 0.8125rem;\n    color: var(--muted-foreground);\n  }\n  /* a case study: the Project Details block set as a feature - serif italics, square pictures, a drop cap */\n  #pf-editorial .pf-case-top {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    justify-content: space-between;\n    gap: 0.5rem 1rem;\n    margin-block-end: -1.5rem;\n  }\n  #pf-editorial .pf-case-top a {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.4rem;\n    color: inherit;\n    text-decoration: none;\n  }\n  #pf-editorial .pf-case-top a:is(:hover, :focus-visible) {\n    color: var(--primary);\n  }\n  #pf-editorial .pf-case-top svg {\n    width: 0.9rem;\n    height: 0.9rem;\n  }\n  #pf-editorial .mk-project-details-title {\n    font-family: var(--font-serif);\n    font-size: clamp(2.25rem, 1.25rem + 4cqi, 4rem);\n    font-style: italic;\n    font-weight: 400;\n    letter-spacing: -0.03em;\n    text-wrap: balance;\n  }\n  #pf-editorial .mk-project-details-summary {\n    font-size: 1.25rem;\n    font-style: italic;\n    line-height: 1.5;\n  }\n  #pf-editorial .mk-project-details-cover {\n    border-radius: 0;\n  }\n  #pf-editorial .mk-project-details-cover img {\n    filter: sepia(0.12);\n  }\n  #pf-editorial .mk-project-details-facts {\n    grid-template-columns: repeat(auto-fit, minmax(min(100%, 7rem), 1fr));\n    border-block: 3px double var(--foreground);\n    font-family: var(--font-sans);\n  }\n  #pf-editorial .mk-project-details-brief h2,\n  #pf-editorial .pf-case-result h2 {\n    margin: 0 0 0.75rem;\n    font-family: var(--font-sans);\n    font-size: 0.6875rem;\n    font-weight: 600;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n    color: var(--muted-foreground);\n  }\n  #pf-editorial .mk-project-details-brief p,\n  #pf-editorial .pf-case-result p {\n    margin: 0;\n    color: inherit;\n    font-size: 1.0625rem;\n    line-height: 1.7;\n    text-wrap: pretty;\n  }\n  #pf-editorial .pf-case-result {\n    max-width: 40rem;\n  }\n  #pf-editorial .pf-case-shots {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));\n    gap: 1.5rem;\n  }\n  #pf-editorial .pf-case-shots figure {\n    margin: 0;\n  }\n  #pf-editorial .pf-case-shots img {\n    display: block;\n    width: 100%;\n    aspect-ratio: 4 / 3;\n    object-fit: cover;\n  }\n  #pf-editorial .mk-article-nav-link {\n    border-radius: 0;\n  }\n  #pf-editorial .mk-article-nav-dir {\n    font-family: var(--font-sans);\n    font-size: 0.6875rem;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n  }\n  #pf-editorial .mk-article-nav-title {\n    font-size: 1.25rem;\n    font-style: italic;\n    font-weight: 400;\n  }\n  /* the colophon: the Site Footer under a double rule, the index again in italics */\n  #pf-editorial .pf-colophon {\n    background: none;\n    color: inherit;\n  }\n  #pf-editorial .pf-colophon .mk-footer-inner {\n    max-width: none;\n    padding: 1.25rem 0 0;\n    border-block-start: 3px double var(--foreground);\n  }\n  #pf-editorial .pf-colophon .mk-footer-nav {\n    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));\n    gap: 2rem;\n  }\n  #pf-editorial .mk-footer-heading {\n    font-family: var(--font-sans);\n    font-size: 0.6875rem;\n    font-weight: 600;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n  }\n  #pf-editorial .mk-footer-list {\n    gap: 0.5rem;\n    font-style: italic;\n  }\n  #pf-editorial .mk-footer-list a:is(:hover, :focus-visible) {\n    color: var(--primary);\n  }\n  #pf-editorial .mk-footer-brand {\n    color: inherit;\n  }\n  #pf-editorial .mk-footer-brand-name {\n    font-size: 1.125rem;\n    font-style: italic;\n    font-weight: 400;\n  }\n  #pf-editorial .mk-footer-copy {\n    font-family: var(--font-sans);\n    font-size: 0.6875rem;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n  }\n  @container pf-editorial (max-width: 40rem) {\n    #pf-editorial .pf-masthead .mk-header-inner {\n      grid-template-columns: minmax(0, 1fr);\n      justify-items: center;\n    }\n    #pf-editorial .pf-masthead-end {\n      flex-wrap: wrap;\n      justify-content: center;\n    }\n  }\n  /* light or dark: the Swap writes the page's dark class - every look has a light and a dark palette */\n  #pf-editorial .site-mode {\n    flex: none;\n    border: 1px solid var(--input);\n    border-radius: var(--radius-md);\n    background: var(--background);\n    color: var(--foreground);\n  }\n  #pf-editorial .site-mode:hover {\n    background: var(--accent);\n    color: var(--accent-foreground);\n  }\n  /* -- modes: each look in light and dark, derived from the palettes above (the other mode of each look) -- */\n  :root:not(.dark) #pf-editorial {\n    --accent: oklch(0.927 0.035 60);\n  }\n  /* -- modes: end -- */\n</style>\n<div id=\"pf-editorial\">\n  <div class=\"pf-page\">\n    <header class=\"mk-header pf-masthead\">\n      <div class=\"mk-header-inner\">\n        <p class=\"pf-label\">No. 15 · Autumn 2026</p>\n        <a class=\"mk-header-brand\" href=\"#/\" data-router-link><span class=\"mk-header-name\">Clara Moreau</span></a>\n        <div class=\"pf-masthead-end\">\n          <nav class=\"mk-header-nav pf-label\" aria-label=\"Sections\">\n            <a href=\"#pf-ed-work\">Work</a>\n            <a href=\"#pf-ed-about\">About</a>\n            <a href=\"#pf-ed-contact\">Contact</a>\n          </nav>\n          <div class=\"mk-header-actions\">\n            <label class=\"swap site-mode\" data-variant=\"rotate\" data-size=\"sm\">\n              <input type=\"checkbox\" data-site-mode aria-label=\"Dark mode\" />\n              <span class=\"swap-on\" aria-hidden=\"true\"><i data-lucide=\"moon\"></i></span>\n              <span class=\"swap-off\" aria-hidden=\"true\"><i data-lucide=\"sun\"></i></span>\n            </label>\n          </div>\n        </div>\n      </div>\n    </header>\n\n    <!-- the home view: the whole portfolio -->\n    <div class=\"pf-view\" data-pf-view=\"home\">\n      <header class=\"mk-resume-header\" data-variant=\"split\">\n        <img\n          class=\"mk-resume-header-photo corner-arch\"\n          src=\"https://picsum.photos/id/1027/800/1000\"\n          alt=\"Clara Moreau\"\n          data-df-entrance=\"wipe-up\"\n        />\n        <div class=\"mk-resume-header-body\">\n          <p class=\"pf-label\" data-df-entrance=\"fade\">Art direction · Paris and Berlin</p>\n          <h1 class=\"mk-resume-header-name\" data-df-entrance=\"up\">Clara Moreau</h1>\n          <p class=\"mk-resume-header-role\" data-df-entrance=\"up\" style=\"--df-motion-delay: 150ms\"\n            >Art director for magazines, books and the brands that read them</p\n          >\n          <p class=\"mk-resume-header-summary\" data-df-entrance=\"up\" style=\"--df-motion-delay: 300ms\"\n            >Fifteen years of covers, grids and typefaces chosen with care. I believe a page should breathe before it\n            speaks.</p\n          >\n          <div class=\"mk-resume-header-actions\" data-df-entrance=\"up\" style=\"--df-motion-delay: 450ms\">\n            <a class=\"btn\" href=\"#pf-ed-work\">Selected work</a>\n            <a class=\"btn\" data-variant=\"ghost\" href=\"mailto:clara@example.com\">clara@example.com</a>\n          </div>\n        </div>\n      </header>\n      <figure class=\"pf-quote parallax-reveal\">\n        <blockquote>Clara treats white space like a co-author - it gets the best lines.</blockquote>\n        <figcaption class=\"pf-label\">Hélène Marchand, editor in chief, Revue Lumière</figcaption>\n      </figure>\n      <section id=\"pf-ed-work\" aria-labelledby=\"pf-ed-work-title\">\n        <div class=\"pf-head\">\n          <h2 class=\"pf-label\" id=\"pf-ed-work-title\">Selected work</h2>\n          <p class=\"pf-label\">2016 - 2026</p>\n        </div>\n        <ul class=\"mk-portfolio-grid\" data-variant=\"index\">\n          <li class=\"mk-portfolio-grid-item\">\n            <a class=\"mk-portfolio-grid-link\" href=\"#/work/revue-lumiere\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/1073/800/600\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Revue Lumière, a redesign</strong>\n                <span class=\"mk-portfolio-grid-meta\">Magazine · 2026</span>\n              </span>\n            </a>\n          </li>\n          <li class=\"mk-portfolio-grid-item\">\n            <a class=\"mk-portfolio-grid-link\" href=\"#/work/the-quiet-atlas\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/24/800/600\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">The Quiet Atlas</strong>\n                <span class=\"mk-portfolio-grid-meta\">Book · 2024</span>\n              </span>\n            </a>\n          </li>\n          <li class=\"mk-portfolio-grid-item\">\n            <a class=\"mk-portfolio-grid-link\" href=\"#/work/maison-verre\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/1068/800/600\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Maison Verre</strong>\n                <span class=\"mk-portfolio-grid-meta\">Identity · 2023</span>\n              </span>\n            </a>\n          </li>\n          <li class=\"mk-portfolio-grid-item\">\n            <a class=\"mk-portfolio-grid-link\" href=\"#/work/festival-du-livre\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/951/800/600\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Festival du Livre</strong>\n                <span class=\"mk-portfolio-grid-meta\">Campaign · 2021</span>\n              </span>\n            </a>\n          </li>\n          <li class=\"mk-portfolio-grid-item\">\n            <a class=\"mk-portfolio-grid-link\" href=\"#/work/eleven-gardens\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/82/800/600\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Eleven Gardens</strong>\n                <span class=\"mk-portfolio-grid-meta\">Exhibition · 2019</span>\n              </span>\n            </a>\n          </li>\n        </ul>\n      </section>\n      <article class=\"pf-feature\" aria-labelledby=\"pf-ed-feature\">\n        <figure class=\"parallax-reveal\">\n          <img src=\"https://picsum.photos/id/1073/1200/900\" alt=\"Book pages laid out edge to edge on a table\" />\n          <figcaption>Revue Lumière, issue 212 - the flat plan of the first issue on the new grid.</figcaption>\n        </figure>\n        <div>\n          <p class=\"pf-label\">Feature</p>\n          <h2 id=\"pf-ed-feature\">A monthly that reads slower on purpose</h2>\n          <p class=\"pf-dropcap\"\n            >Revue Lumière had grown loud: six typefaces, a cover line on every inch. We cut it to two faces, one cover\n            image and a grid of nine columns that lets long reads run wide and short ones sit quietly in the margin.</p\n          >\n          <p\n            >Newsstand sales rose for the first time in a decade; the letters page asked us to never change it again.</p\n          >\n          <dl class=\"pf-facts\">\n            <dt>Client</dt>\n            <dd>Revue Lumière</dd>\n            <dt>Role</dt>\n            <dd>Art direction</dd>\n            <dt>Year</dt>\n            <dd>2026</dd>\n          </dl>\n          <a class=\"btn\" data-variant=\"outline\" href=\"#/work/revue-lumiere\" data-router-link>Read the case study</a>\n        </div>\n      </article>\n      <section id=\"pf-ed-about\" class=\"pf-about\" aria-labelledby=\"pf-ed-about-title\">\n        <div>\n          <h2 class=\"pf-label\" id=\"pf-ed-about-title\">Recognition</h2>\n          <ul class=\"pf-awards\">\n            <li>Type Directors Club, certificate <span>2025</span></li>\n            <li>Art Directors Club, silver <span>2023</span></li>\n            <li>European Design Awards, gold <span>2021</span></li>\n          </ul>\n        </div>\n        <div>\n          <h2 class=\"pf-label\">Career</h2>\n          <ol class=\"mk-resume-entries\" data-variant=\"columns\">\n            <li class=\"mk-resume-entry\">\n              <div class=\"mk-resume-entry-body\">\n                <div class=\"mk-resume-entry-head\">\n                  <h3 class=\"mk-resume-entry-title\">Art director, own studio</h3>\n                  <p class=\"mk-resume-entry-org\"><span>Paris and Berlin</span></p>\n                  <p class=\"mk-resume-entry-when\"><time datetime=\"2018\">2018</time> - today</p>\n                </div>\n              </div>\n            </li>\n            <li class=\"mk-resume-entry\">\n              <div class=\"mk-resume-entry-body\">\n                <div class=\"mk-resume-entry-head\">\n                  <h3 class=\"mk-resume-entry-title\">Design director</h3>\n                  <p class=\"mk-resume-entry-org\"><a href=\"#/work/revue-lumiere\" data-router-link>Revue Lumière</a></p>\n                  <p class=\"mk-resume-entry-when\"\n                    ><time datetime=\"2013\">2013</time> - <time datetime=\"2018\">2018</time></p\n                  >\n                </div>\n              </div>\n            </li>\n            <li class=\"mk-resume-entry\">\n              <div class=\"mk-resume-entry-body\">\n                <div class=\"mk-resume-entry-head\">\n                  <h3 class=\"mk-resume-entry-title\">Graphic design, MA</h3>\n                  <p class=\"mk-resume-entry-org\"><span>École Estienne, Paris</span></p>\n                  <p class=\"mk-resume-entry-when\"\n                    ><time datetime=\"2009\">2009</time> - <time datetime=\"2011\">2011</time></p\n                  >\n                </div>\n              </div>\n            </li>\n          </ol>\n        </div>\n      </section>\n      <aside id=\"pf-ed-contact\" class=\"mk-availability\" data-variant=\"banner\" aria-labelledby=\"pf-ed-contact-title\">\n        <p class=\"mk-availability-status\"\n          ><span class=\"indicator-dot\" data-variant=\"warning\" aria-hidden=\"true\"></span> Limited</p\n        >\n        <p class=\"mk-availability-title\" id=\"pf-ed-contact-title\">Taking two book projects for autumn 2027</p>\n        <div class=\"mk-availability-actions\">\n          <a class=\"btn\" data-variant=\"outline\" href=\"mailto:clara@example.com\">Write to the studio</a>\n        </div>\n      </aside>\n    </div>\n\n    <!-- a case study: the route's slug picks it from the data block below -->\n    <article class=\"pf-view pf-case\" data-pf-view=\"case\" aria-labelledby=\"pf-ed-case-title\" hidden>\n      <nav class=\"pf-case-top pf-label\" aria-label=\"Case study\">\n        <a href=\"#pf-ed-work\"><i data-lucide=\"arrow-left\"></i> Back to the index</a>\n        <span data-case-count>Case 1 of 5</span>\n      </nav>\n      <div class=\"mk-project-details\">\n        <header class=\"mk-project-details-head\">\n          <p class=\"pf-label\" data-case=\"kicker\">Magazine · 2026</p>\n          <h1 class=\"mk-project-details-title\" id=\"pf-ed-case-title\" data-case=\"title\">Revue Lumière, a redesign</h1>\n          <p class=\"mk-project-details-summary\" data-case=\"summary\"\n            >A cultural monthly that had grown loud, set again on nine columns and two typefaces - so that long reads\n            run wide and short ones sit quietly in the margin.</p\n          >\n        </header>\n        <figure class=\"mk-project-details-cover\" data-case-shot=\"0\" data-case-size=\"1600/800\">\n          <img src=\"https://picsum.photos/id/1073/1600/800\" alt=\"Book pages laid out edge to edge on a table\" />\n          <figcaption>The flat plan of issue 212, laid out page by page</figcaption>\n        </figure>\n        <dl class=\"mk-project-details-facts\">\n          <div><dt>Client</dt><dd data-case=\"client\">Revue Lumière</dd></div>\n          <div><dt>Role</dt><dd data-case=\"role\">Art direction, typography</dd></div>\n          <div><dt>Year</dt><dd data-case=\"year\">2026</dd></div>\n          <div><dt>Format</dt><dd data-case=\"format\">Monthly, 148 pages</dd></div>\n        </dl>\n        <div class=\"mk-project-details-brief\">\n          <section aria-labelledby=\"pf-ed-case-brief\">\n            <h2 id=\"pf-ed-case-brief\">The brief</h2>\n            <p class=\"pf-dropcap\" data-case=\"brief\"\n              >Revue Lumière had grown loud: six typefaces, a cover line on every inch and a new section every season.\n              The editors wanted readers to stay longer with each piece - without losing the newsstand.</p\n            >\n          </section>\n          <section aria-labelledby=\"pf-ed-case-part\">\n            <h2 id=\"pf-ed-case-part\">My part</h2>\n            <p data-case=\"part\"\n              >I led two designers and the photo desk for nine months. We cut the magazine to two faces and one cover\n              image, drew a nine-column grid and wrote the style sheet the editors now use without us.</p\n            >\n          </section>\n        </div>\n        <figure class=\"pf-quote\">\n          <blockquote data-case=\"quote\">Clara treats white space like a co-author - it gets the best lines.</blockquote>\n          <figcaption class=\"pf-label\" data-case=\"by\">Hélène Marchand, editor in chief</figcaption>\n        </figure>\n        <section class=\"pf-case-result\" aria-labelledby=\"pf-ed-case-result\">\n          <h2 id=\"pf-ed-case-result\">The result</h2>\n          <p data-case=\"result\"\n            >Newsstand sales rose for the first time in a decade, and the time readers spend with an issue doubled in\n            the reader survey. The letters page asked us to never change it again.</p\n          >\n        </section>\n        <div class=\"pf-case-shots\">\n          <figure data-case-shot=\"1\" data-case-size=\"900/675\">\n            <img\n              src=\"https://picsum.photos/id/20/900/675\"\n              alt=\"A desk with a notebook, a pencil, a phone and printed logos\"\n              loading=\"lazy\"\n            />\n            <figcaption>The grid, first drawn by hand</figcaption>\n          </figure>\n          <figure data-case-shot=\"2\" data-case-size=\"900/675\">\n            <img\n              src=\"https://picsum.photos/id/403/900/675\"\n              alt=\"The keys of an old typewriter, close up\"\n              loading=\"lazy\"\n            />\n            <figcaption>One cover line instead of nine</figcaption>\n          </figure>\n        </div>\n        <nav class=\"mk-article-nav\" aria-label=\"More work\">\n          <a class=\"mk-article-nav-link\" href=\"#/work/eleven-gardens\" rel=\"prev\" data-router-link\n            ><span class=\"mk-article-nav-dir\"><i data-lucide=\"arrow-left\" aria-hidden=\"true\"></i> Previous</span\n            ><span class=\"mk-article-nav-title\" data-case-prev>Eleven Gardens</span></a\n          >\n          <a class=\"mk-article-nav-link\" href=\"#/work/the-quiet-atlas\" rel=\"next\" data-router-link\n            ><span class=\"mk-article-nav-dir\">Next <i data-lucide=\"arrow-right\" aria-hidden=\"true\"></i></span\n            ><span class=\"mk-article-nav-title\" data-case-next>The Quiet Atlas</span></a\n          >\n        </nav>\n      </div>\n    </article>\n\n    <footer class=\"mk-footer pf-colophon\">\n      <div class=\"mk-footer-inner\">\n        <nav class=\"mk-footer-nav\" aria-label=\"Colophon\">\n          <div class=\"mk-footer-col\">\n            <h2 class=\"mk-footer-heading\">The index</h2>\n            <ul class=\"mk-footer-list\">\n              <li><a href=\"#/work/revue-lumiere\" data-router-link>Revue Lumière</a></li>\n              <li><a href=\"#/work/the-quiet-atlas\" data-router-link>The Quiet Atlas</a></li>\n              <li><a href=\"#/work/maison-verre\" data-router-link>Maison Verre</a></li>\n              <li><a href=\"#/work/festival-du-livre\" data-router-link>Festival du Livre</a></li>\n              <li><a href=\"#/work/eleven-gardens\" data-router-link>Eleven Gardens</a></li>\n            </ul>\n          </div>\n          <div class=\"mk-footer-col\">\n            <h2 class=\"mk-footer-heading\">The studio</h2>\n            <ul class=\"mk-footer-list\">\n              <li><a href=\"#pf-ed-about\">Recognition and career</a></li>\n              <li><a href=\"#pf-ed-contact\">Availability</a></li>\n              <li><a href=\"mailto:clara@example.com\">clara@example.com</a></li>\n            </ul>\n          </div>\n          <div class=\"mk-footer-col\">\n            <h2 class=\"mk-footer-heading\">Elsewhere</h2>\n            <ul class=\"mk-footer-list\">\n              <li><a href=\"https://www.instagram.com/\" target=\"_blank\" rel=\"noopener\">Instagram</a></li>\n              <li><a href=\"https://www.are.na/\" target=\"_blank\" rel=\"noopener\">Are.na</a></li>\n              <li><a href=\"https://www.linkedin.com/\" target=\"_blank\" rel=\"noopener\">LinkedIn</a></li>\n            </ul>\n          </div>\n        </nav>\n        <hr class=\"separator mk-footer-rule\" />\n        <div class=\"mk-footer-bottom\">\n          <a class=\"mk-footer-brand\" href=\"#/\" data-router-link\n            ><span class=\"mk-footer-brand-name\">Clara Moreau Studio</span></a\n          >\n          <div class=\"mk-footer-meta\">\n            <p class=\"mk-footer-copy\">Set in Fraunces · Paris and Berlin · © 2026</p>\n          </div>\n        </div>\n      </div>\n    </footer>\n  </div>\n\n  <!-- the case studies the routes name, in the order of the index -->\n  \n</div>\n","individual":false}]
