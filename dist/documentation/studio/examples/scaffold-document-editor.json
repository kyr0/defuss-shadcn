[{"label":"Document editor","html":"<style>\n  /* Margin: the scaffold's own glue - the three-column layout and the page\n     look. Every control is a shipped component (Sidebar, Menubar, Toolbar,\n     Toggle Group, Button, Badge, Avatar, Input, Kbd, Dialog, Textarea,\n     Toast, Editor.js, Document Comments) */\n  .de {\n    container: de / inline-size;\n    position: relative;\n    display: flex;\n    width: 100%;\n    height: var(--scaffold-height, 50rem);\n    overflow: hidden;\n    background: var(--background);\n    color: var(--foreground);\n    font-size: 0.875rem;\n  }\n  /* files dragged over the editor: the drop target (the Chat Session's look), its label says what a drop does */\n  .de[data-drop-active]::after {\n    content: attr(data-drop-label);\n    position: absolute;\n    inset: 0.75rem;\n    z-index: 3;\n    display: grid;\n    place-items: center;\n    padding: 1rem;\n    border: 2px dashed var(--ring);\n    border-radius: var(--radius-lg);\n    background: color-mix(in oklch, var(--background) 92%, transparent);\n    color: var(--foreground);\n    font-size: 1.125rem;\n    font-weight: 600;\n    text-align: center;\n    text-wrap: balance;\n    pointer-events: none;\n  }\n  @media (forced-colors: active) {\n    .de[data-drop-active]::after {\n      border-color: Highlight;\n      forced-color-adjust: none;\n    }\n  }\n  /* the document list is open or closed, never an icon rail, and sits in the flow (the page\n     narrows, nothing overlays it) - the trigger in the header stays visible either way */\n  .de .app-sidebar {\n    position: relative;\n    flex: none;\n    height: 100%;\n    display: flex;\n  }\n  .de .app-sidebar[data-state='collapsed'] {\n    display: none;\n  }\n  .de-locale {\n    flex: none;\n    width: auto;\n  }\n  .de .sidebar-link[data-de-doc] .badge {\n    margin-inline-start: auto;\n  }\n  .de-search {\n    padding: 0.5rem 0.75rem 0.25rem;\n  }\n  .de-main {\n    display: flex;\n    flex: 1;\n    flex-direction: column;\n    min-width: 0;\n    min-height: 0;\n  }\n  .de-top {\n    display: flex;\n    flex: none;\n    align-items: center;\n    gap: 0.5rem;\n    height: 4rem;\n    padding-inline: 0.75rem;\n    border-block-end: 1px solid var(--border);\n  }\n  /* the title above the menubar, as in Google Docs */\n  .de-heading {\n    display: flex;\n    flex: 1;\n    flex-direction: column;\n    align-items: flex-start;\n    min-width: 0;\n  }\n  .de-title {\n    max-width: 100%;\n    margin: 0;\n    padding: 0.0625rem 0.375rem;\n    border: 1px solid transparent;\n    border-radius: var(--radius-md);\n    background: none;\n    color: inherit;\n    font: inherit;\n    font-size: 1.0625rem;\n    font-weight: 600;\n    overflow: hidden;\n    white-space: nowrap;\n    text-overflow: ellipsis;\n    &:hover {\n      border-color: var(--border);\n    }\n    &:focus-visible {\n      outline: 2px solid var(--ring);\n      outline-offset: 1px;\n    }\n  }\n  .de-saved {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.25rem;\n    color: var(--muted-foreground);\n    font-size: 0.75rem;\n    white-space: nowrap;\n    & svg {\n      width: 0.875rem;\n      height: 0.875rem;\n    }\n  }\n  .de-saved[data-state='editing'] {\n    color: var(--foreground);\n  }\n  .de .toolbar {\n    flex: none;\n    flex-wrap: wrap;\n    margin: 0.5rem 0.75rem 0;\n  }\n  .de-body {\n    display: flex;\n    flex: 1;\n    min-height: 0;\n  }\n  .de-page {\n    flex: 1;\n    min-width: 0;\n    overflow: auto;\n    overscroll-behavior: contain;\n    padding: 2rem clamp(1rem, 6cqi, 4rem) 6rem;\n    background: color-mix(in oklch, var(--muted) 40%, var(--background));\n  }\n  .de-sheet {\n    max-width: 46rem;\n    min-height: 100%;\n    margin-inline: auto;\n    padding: 3rem clamp(1.5rem, 5cqi, 4rem) 4rem;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    background: var(--card);\n    box-shadow: var(--shadow-sm);\n  }\n  .de .editorjs {\n    --editorjs-measure: 100%;\n    --editorjs-min-height: 24rem;\n  }\n  .de .doc-comments {\n    flex: none;\n    border-inline-start: 1px solid var(--border);\n    background: var(--background);\n  }\n  .de-status {\n    display: flex;\n    flex: none;\n    align-items: center;\n    gap: 0.75rem;\n    height: 2rem;\n    padding-inline: 0.75rem;\n    border-block-start: 1px solid var(--border);\n    color: var(--muted-foreground);\n    font-size: 0.75rem;\n    & .badge {\n      font-size: 0.6875rem;\n    }\n  }\n  .de-status-spacer {\n    flex: 1;\n  }\n  /* the annotation layers fit the status bar */\n  .de-status .toggle {\n    height: 1.5rem;\n    padding-inline: 0.5rem;\n    font-size: 0.75rem;\n    & span {\n      color: var(--muted-foreground);\n    }\n  }\n  .de-quote {\n    margin: 0 0 0.75rem;\n    padding: 0.5rem 0.75rem;\n    border-inline-start: 3px solid var(--primary);\n    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;\n    background: var(--muted);\n    color: var(--muted-foreground);\n    font-style: italic;\n  }\n  .de-colors .toggle {\n    width: 2rem;\n    padding: 0;\n  }\n  .de-colors .toggle::before {\n    content: '';\n    display: block;\n    width: 0.875rem;\n    height: 0.875rem;\n    border-radius: 50%;\n    background: var(--de-c);\n  }\n  .de-colors .toggle[aria-pressed='true'] {\n    outline: 2px solid var(--de-c);\n    outline-offset: -2px;\n  }\n  .de-share-link {\n    display: flex;\n    gap: 0.5rem;\n  }\n  .de [hidden] {\n    display: none !important;\n  }\n  .de-comments-toggle {\n    display: none;\n  }\n  @container de (width < 56rem) {\n    .de-comments-toggle {\n      display: inline-flex;\n    }\n    .de .doc-comments {\n      display: none;\n    }\n    .de[data-comments] .doc-comments {\n      display: flex;\n      position: absolute;\n      inset-block: 4rem 2rem;\n      inset-inline-end: 0;\n      z-index: 2;\n      box-shadow: var(--shadow-lg);\n    }\n    .de-page {\n      padding-inline: 1rem;\n    }\n    .de-sheet {\n      padding: 2rem 1.25rem 3rem;\n    }\n  }\n</style>\n<div class=\"de sidebar-layout\" id=\"de\" data-i18n-component>\n  <aside\n    class=\"app-sidebar\"\n    id=\"de-sidebar\"\n    data-state=\"collapsed\"\n    aria-label=\"Documents\"\n    data-i18n-aria-label-en=\"Documents\"\n    data-i18n-aria-label-de=\"Dokumente\"\n  >\n    <div class=\"sidebar-header\">\n      <a class=\"sidebar-logo\" href=\"#\"\n        ><i data-lucide=\"file-pen-line\"></i><span class=\"sidebar-logo-text\">Margin</span></a\n      >\n    </div>\n    <div class=\"de-search\"\n      ><input\n        class=\"input\"\n        type=\"search\"\n        placeholder=\"Search documents\"\n        aria-label=\"Search documents\"\n        data-i18n-placeholder-en=\"Search documents\"\n        data-i18n-placeholder-de=\"Dokumente durchsuchen\"\n        data-i18n-aria-label-en=\"Search documents\"\n        data-i18n-aria-label-de=\"Dokumente durchsuchen\"\n        data-size=\"sm\"\n    /></div>\n    <div class=\"sidebar-content\">\n      <details class=\"sidebar-group\" open>\n        <summary><span data-i18n-target=\"nav-mine\">My documents</span><i data-lucide=\"chevron-right\"></i></summary>\n        <nav class=\"sidebar-nav\" id=\"de-doc-nav\">\n          <a class=\"sidebar-link\" href=\"#/docs/launch\" data-router-link data-de-doc=\"launch\" aria-current=\"page\"\n            ><i data-lucide=\"file-text\"></i> <span>Q4 launch plan</span\n            ><span class=\"badge\" data-variant=\"secondary\" data-de-count=\"launch\">5</span></a\n          >\n          <a class=\"sidebar-link\" href=\"#/docs/brief\" data-router-link data-de-doc=\"brief\"\n            ><i data-lucide=\"file-text\"></i> <span>Design brief</span\n            ><span class=\"badge\" data-variant=\"secondary\" data-de-count=\"brief\">2</span></a\n          >\n          <a class=\"sidebar-link\" href=\"#/docs/notes\" data-router-link data-de-doc=\"notes\"\n            ><i data-lucide=\"file-text\"></i> <span>Meeting notes</span\n            ><span class=\"badge\" data-variant=\"secondary\" data-de-count=\"notes\" hidden>0</span></a\n          >\n          <a class=\"sidebar-link\" href=\"#/docs/pruefung\" data-router-link data-de-doc=\"pruefung\"\n            ><i data-lucide=\"file-search\"></i> <span>Importprüfung</span\n            ><span class=\"badge\" data-variant=\"secondary\" data-de-count=\"pruefung\" hidden>0</span></a\n          >\n        </nav>\n      </details>\n      <details class=\"sidebar-group\" open>\n        <summary><span data-i18n-target=\"nav-shared\">Shared with me</span><i data-lucide=\"chevron-right\"></i></summary>\n        <nav class=\"sidebar-nav\">\n          <a class=\"sidebar-link\" href=\"#\" aria-disabled=\"true\"><i data-lucide=\"users\"></i> <span>Hiring loop</span></a>\n          <a class=\"sidebar-link\" href=\"#\" aria-disabled=\"true\"><i data-lucide=\"users\"></i> <span>Brand voice</span></a>\n        </nav>\n      </details>\n    </div>\n    <div class=\"sidebar-footer\"\n      ><span class=\"avatar\" data-size=\"sm\"><span class=\"avatar-fallback\">YO</span></span>\n      <span data-i18n-target=\"nav-you\">You</span></div\n    >\n  </aside>\n\n  <div class=\"de-main\">\n    <header class=\"de-top\">\n      <button\n        class=\"sidebar-trigger\"\n        data-sidebar-trigger=\"de-sidebar\"\n        aria-label=\"Toggle documents\"\n        data-i18n-aria-label-en=\"Toggle documents\"\n        data-i18n-aria-label-de=\"Dokumentliste umschalten\"\n        ><i data-lucide=\"panel-left\"></i\n      ></button>\n      <div class=\"de-heading\">\n        <h1 class=\"de-title\" id=\"de-title\">Q4 launch plan</h1>\n        <div\n          class=\"menubar\"\n          role=\"menubar\"\n          aria-label=\"Document\"\n          data-i18n-aria-label-en=\"Document\"\n          data-i18n-aria-label-de=\"Dokument\"\n          data-variant=\"ghost\"\n          data-size=\"sm\"\n          id=\"de-menu\"\n        >\n          <button class=\"menubar-trigger\" data-dropdown-trigger=\"de-m-file\"\n            ><span data-i18n-target=\"m-file\">File</span></button\n          >\n          <div\n            class=\"dropdown-content\"\n            id=\"de-m-file\"\n            role=\"menu\"\n            popover\n            aria-label=\"File\"\n            data-i18n-aria-label-en=\"File\"\n            data-i18n-aria-label-de=\"Datei\"\n          >\n            <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\" data-de-action=\"new\"\n              ><i data-lucide=\"file-plus\"></i> <span data-i18n-target=\"mi-1\">New document</span></button\n            >\n            <div class=\"dropdown-sub\">\n              <button class=\"dropdown-item dropdown-sub-trigger\" role=\"menuitem\" tabindex=\"-1\"\n                ><i data-lucide=\"folder-open\"></i> <span data-i18n-target=\"mi-2\">Open</span></button\n              >\n              <div\n                class=\"dropdown-content dropdown-sub-content\"\n                role=\"menu\"\n                popover\n                aria-label=\"Open\"\n                data-i18n-aria-label-en=\"Open\"\n                data-i18n-aria-label-de=\"Öffnen\"\n              >\n                <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\" data-de-action=\"open-markdown\"\n                  ><i data-lucide=\"file-text\"></i> Markdown...</button\n                >\n                <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\" data-de-action=\"open-annotations\"\n                  ><i data-lucide=\"message-square-text\"></i>\n                  <span data-i18n-target=\"mi-3\">Comment annotations...</span></button\n                >\n              </div>\n            </div>\n            <div class=\"dropdown-separator\" role=\"separator\"></div>\n            <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\" data-de-action=\"save\"\n              ><i data-lucide=\"save\"></i> <span data-i18n-target=\"mi-4\">Save</span>\n              <span class=\"dropdown-shortcut\">⌘S</span></button\n            >\n            <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\" data-de-action=\"save-as\"\n              ><i data-lucide=\"download\"></i> <span data-i18n-target=\"mi-5\">Save as...</span>\n              <span class=\"dropdown-shortcut\">⇧⌘S</span></button\n            >\n            <div class=\"dropdown-sub\">\n              <button class=\"dropdown-item dropdown-sub-trigger\" role=\"menuitem\" tabindex=\"-1\"\n                ><i data-lucide=\"file-output\"></i> <span data-i18n-target=\"mi-6\">Export</span></button\n              >\n              <div\n                class=\"dropdown-content dropdown-sub-content\"\n                role=\"menu\"\n                popover\n                aria-label=\"Export\"\n                data-i18n-aria-label-en=\"Export\"\n                data-i18n-aria-label-de=\"Exportieren\"\n              >\n                <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\" data-de-action=\"export-annotations\"\n                  ><i data-lucide=\"file-json\"></i>\n                  <span data-i18n-target=\"mi-7\">Comment annotations (JSON)</span></button\n                >\n              </div>\n            </div>\n            <div class=\"dropdown-separator\" role=\"separator\"></div>\n            <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\" data-de-action=\"share\"\n              ><i data-lucide=\"share-2\"></i> <span data-i18n-target=\"mi-8\">Share...</span></button\n            >\n          </div>\n          <button class=\"menubar-trigger\" data-dropdown-trigger=\"de-m-edit\"\n            ><span data-i18n-target=\"m-edit\">Edit</span></button\n          >\n          <div\n            class=\"dropdown-content\"\n            id=\"de-m-edit\"\n            role=\"menu\"\n            popover\n            aria-label=\"Edit\"\n            data-i18n-aria-label-en=\"Edit\"\n            data-i18n-aria-label-de=\"Bearbeiten\"\n          >\n            <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\" data-de-action=\"comment\"\n              ><i data-lucide=\"message-square-plus\"></i> <span data-i18n-target=\"mi-9\">Comment</span>\n              <span class=\"dropdown-shortcut\">⌘K</span></button\n            >\n            <div class=\"dropdown-separator\" role=\"separator\"></div>\n            <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\" data-de-action=\"prev-comment\"\n              ><i data-lucide=\"chevron-up\"></i> <span data-i18n-target=\"mi-10\">Previous comment</span></button\n            >\n            <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\" data-de-action=\"next-comment\"\n              ><i data-lucide=\"chevron-down\"></i> <span data-i18n-target=\"mi-11\">Next comment</span></button\n            >\n          </div>\n          <button class=\"menubar-trigger\" data-dropdown-trigger=\"de-m-insert\"\n            ><span data-i18n-target=\"m-insert\">Insert</span></button\n          >\n          <div\n            class=\"dropdown-content\"\n            id=\"de-m-insert\"\n            role=\"menu\"\n            popover\n            aria-label=\"Insert\"\n            data-i18n-aria-label-en=\"Insert\"\n            data-i18n-aria-label-de=\"Einfügen\"\n          >\n            <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\" data-de-command=\"table\"\n              ><i data-lucide=\"table\"></i> <span data-i18n-target=\"mi-12\">Table</span></button\n            >\n            <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\" data-de-command=\"delimiter\"\n              ><i data-lucide=\"minus\"></i> <span data-i18n-target=\"mi-13\">Divider</span></button\n            >\n          </div>\n          <button class=\"menubar-trigger\" data-dropdown-trigger=\"de-m-format\">Format</button>\n          <div class=\"dropdown-content\" id=\"de-m-format\" role=\"menu\" popover aria-label=\"Format\">\n            <div class=\"dropdown-sub\">\n              <button class=\"dropdown-item dropdown-sub-trigger\" role=\"menuitem\" tabindex=\"-1\"\n                ><i data-lucide=\"bold\"></i> Text</button\n              >\n              <div\n                class=\"dropdown-content dropdown-sub-content\"\n                role=\"menu\"\n                popover\n                aria-label=\"Text\"\n                data-i18n-aria-label-en=\"Text\"\n                data-i18n-aria-label-de=\"Text\"\n              >\n                <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\" data-de-command=\"bold\"\n                  ><i data-lucide=\"bold\"></i> <span data-i18n-target=\"mi-14\">Bold</span>\n                  <span class=\"dropdown-shortcut\">⌘B</span></button\n                >\n                <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\" data-de-command=\"italic\"\n                  ><i data-lucide=\"italic\"></i> <span data-i18n-target=\"mi-15\">Italic</span>\n                  <span class=\"dropdown-shortcut\">⌘I</span></button\n                >\n                <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\" data-de-command=\"underline\"\n                  ><i data-lucide=\"underline\"></i> <span data-i18n-target=\"mi-16\">Underline</span>\n                  <span class=\"dropdown-shortcut\">⌘U</span></button\n                >\n                <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\" data-de-command=\"marker\"\n                  ><i data-lucide=\"highlighter\"></i> <span data-i18n-target=\"mi-17\">Highlight</span></button\n                >\n                <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\" data-de-command=\"inline-code\"\n                  ><i data-lucide=\"code\"></i> <span data-i18n-target=\"mi-18\">Inline code</span></button\n                >\n              </div>\n            </div>\n            <div class=\"dropdown-sub\">\n              <button class=\"dropdown-item dropdown-sub-trigger\" role=\"menuitem\" tabindex=\"-1\"\n                ><i data-lucide=\"heading\"></i> <span data-i18n-target=\"mi-19\">Paragraph styles</span></button\n              >\n              <div\n                class=\"dropdown-content dropdown-sub-content\"\n                role=\"menu\"\n                popover\n                aria-label=\"Paragraph styles\"\n                data-i18n-aria-label-en=\"Paragraph styles\"\n                data-i18n-aria-label-de=\"Absatzformate\"\n              >\n                <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\" data-de-command=\"paragraph\"\n                  ><i data-lucide=\"pilcrow\"></i> <span data-i18n-target=\"mi-20\">Normal text</span></button\n                >\n                <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\" data-de-command=\"header:1\"\n                  ><i data-lucide=\"heading-1\"></i> <span data-i18n-target=\"mi-21\">Heading 1</span></button\n                >\n                <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\" data-de-command=\"header:2\"\n                  ><i data-lucide=\"heading-2\"></i> <span data-i18n-target=\"mi-22\">Heading 2</span></button\n                >\n                <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\" data-de-command=\"header:3\"\n                  ><i data-lucide=\"heading-3\"></i> <span data-i18n-target=\"mi-23\">Heading 3</span></button\n                >\n              </div>\n            </div>\n            <div class=\"dropdown-sub\">\n              <button class=\"dropdown-item dropdown-sub-trigger\" role=\"menuitem\" tabindex=\"-1\"\n                ><i data-lucide=\"list\"></i> <span data-i18n-target=\"mi-24\">Bullets &amp; numbering</span></button\n              >\n              <div\n                class=\"dropdown-content dropdown-sub-content\"\n                role=\"menu\"\n                popover\n                aria-label=\"Bullets and numbering\"\n                data-i18n-aria-label-en=\"Bullets and numbering\"\n                data-i18n-aria-label-de=\"Aufzählung und Nummerierung\"\n              >\n                <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\" data-de-command=\"list:unordered\"\n                  ><i data-lucide=\"list\"></i> <span data-i18n-target=\"mi-25\">Bulleted list</span></button\n                >\n                <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\" data-de-command=\"list:ordered\"\n                  ><i data-lucide=\"list-ordered\"></i> <span data-i18n-target=\"mi-26\">Numbered list</span></button\n                >\n                <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\" data-de-command=\"list:checklist\"\n                  ><i data-lucide=\"list-checks\"></i> <span data-i18n-target=\"mi-27\">Checklist</span></button\n                >\n              </div>\n            </div>\n            <div class=\"dropdown-separator\" role=\"separator\"></div>\n            <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\" data-de-command=\"quote\"\n              ><i data-lucide=\"quote\"></i> <span data-i18n-target=\"mi-28\">Quote</span></button\n            >\n            <button class=\"dropdown-item\" role=\"menuitem\" tabindex=\"-1\" data-de-command=\"code\"\n              ><i data-lucide=\"square-code\"></i> <span data-i18n-target=\"mi-29\">Code block</span></button\n            >\n          </div>\n          <button class=\"menubar-trigger\" data-dropdown-trigger=\"de-m-view\"\n            ><span data-i18n-target=\"m-view\">View</span></button\n          >\n          <div\n            class=\"dropdown-content\"\n            id=\"de-m-view\"\n            role=\"menu\"\n            popover\n            aria-label=\"View\"\n            data-i18n-aria-label-en=\"View\"\n            data-i18n-aria-label-de=\"Ansicht\"\n          >\n            <button\n              class=\"dropdown-item dropdown-check\"\n              role=\"menuitemcheckbox\"\n              aria-checked=\"false\"\n              tabindex=\"-1\"\n              data-de-view=\"sidebar\"\n              ><span data-i18n-target=\"view-sidebar\">Document list</span></button\n            >\n            <div class=\"dropdown-separator\" role=\"separator\"></div>\n            <div\n              role=\"group\"\n              aria-label=\"Annotation layers\"\n              data-i18n-aria-label-en=\"Annotation layers\"\n              data-i18n-aria-label-de=\"Annotationsebenen\"\n            >\n              <div class=\"dropdown-label\" data-inset data-i18n-target=\"view-layers\">Annotation layers</div>\n              <button\n                class=\"dropdown-item dropdown-check\"\n                role=\"menuitemcheckbox\"\n                aria-checked=\"true\"\n                tabindex=\"-1\"\n                data-de-view=\"findings\"\n                ><span data-i18n-target=\"view-findings\">Findings</span></button\n              >\n              <button\n                class=\"dropdown-item dropdown-check\"\n                role=\"menuitemcheckbox\"\n                aria-checked=\"true\"\n                tabindex=\"-1\"\n                data-de-view=\"summary\"\n                ><span data-i18n-target=\"view-summary\">Summary</span></button\n              >\n            </div>\n          </div>\n        </div>\n      </div>\n      <span class=\"de-saved\" id=\"de-saved\" data-state=\"saved\"><i data-lucide=\"cloud\"></i> <span>Saved</span></span>\n      <div\n        class=\"avatar-group\"\n        aria-label=\"Editing now\"\n        data-i18n-aria-label-en=\"Editing now\"\n        data-i18n-aria-label-de=\"Bearbeiten gerade\"\n      >\n        <span class=\"avatar\" data-size=\"sm\"><span class=\"avatar-fallback\">MC</span></span>\n        <span class=\"avatar\" data-size=\"sm\"><span class=\"avatar-fallback\">JP</span></span>\n        <span class=\"avatar\" data-size=\"sm\"><span c