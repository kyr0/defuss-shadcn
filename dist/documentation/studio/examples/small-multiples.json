[{"label":"1960s Modernist Grid","html":"<section\n  class=\"presentation\"\n  id=\"deck-multiples\"\n  data-anim-in=\"flipIn\"\n  data-anim-out=\"fadeOut\"\n  style=\"\n    --presentation-ink: #151515;\n    --presentation-ink-foreground: #f9f9f5;\n    --presentation-paper: #e8e8e3;\n    --presentation-paper-foreground: #151515;\n    --presentation-accent: #ff4b32;\n    font-family: 'Helvetica Neue', Arial, sans-serif;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"Six roofs, one sun - solar yield by orientation\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Monthly solar yield per kilowatt-peak for six roof orientations, south 974 kWh per year down to east 769, as small multiples, an overlay, annual bars and a summer-day profile\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Cover\">\n    <svg aria-hidden=\"true\" width=\"560\" height=\"900\" viewBox=\"0 0 560 900\" style=\"position: absolute; right: 0; top: 0\">\n      <rect x=\"0\" y=\"0\" width=\"560\" height=\"900\" fill=\"#E8E8E3\" />\n      <rect x=\"40\" y=\"60\" width=\"240\" height=\"240\" fill=\"#FF4B32\" />\n      <rect x=\"300\" y=\"60\" width=\"200\" height=\"120\" fill=\"#151515\" />\n      <rect x=\"300\" y=\"200\" width=\"200\" height=\"100\" fill=\"#F2C12E\" />\n      <rect x=\"40\" y=\"320\" width=\"460\" height=\"10\" fill=\"#151515\" />\n      <rect x=\"40\" y=\"350\" width=\"140\" height=\"490\" fill=\"#1F4E9D\" />\n      <rect x=\"200\" y=\"350\" width=\"300\" height=\"490\" fill=\"none\" stroke=\"#151515\" stroke-width=\"10\" />\n    </svg>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\"\n      >Small multiples · 1960s Modernist Grid</p\n    >\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        position: relative;\n        max-width: 1250px;\n        font-family: 'Helvetica Neue', Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.03em;\n        font-size: 6.75rem;\n        max-width: 900px;\n      \"\n      >Six roofs, one sun</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >What a rooftop solar system yields, month by month, depending on where the roof faces.</p\n    >\n    <p class=\"presentation-note\">The grid on the right is the whole visual idea: repeat the frame.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"grid\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Six panels\"\n  >\n    <header class=\"presentation-header\"><span>Monthly yield</span><span>kWh per kWp · one scale</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Helvetica Neue', Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.03em;\n      \"\n      >Same axes, six roofs</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Repeat the frame, vary only the data - the eye compares shapes.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"overlay\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Overlay\"\n  >\n    <header class=\"presentation-header\"><span>Monthly yield</span><span>All six on one axis</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Helvetica Neue', Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.03em;\n      \"\n      >Overlaid, the differences disappear</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The panels collapse into one chart - and now it is spaghetti.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"annual\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Annual\"\n  >\n    <header class=\"presentation-header\"><span>Per year</span><span>kWh per kWp per year</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Helvetica Neue', Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.03em;\n      \"\n      >East still makes 79% of south</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Each panel sums into one bar.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Three numbers for your roof</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #ff4b32;\n            font-family: 'Helvetica Neue', Arial, sans-serif;\n            font-weight: 700;\n            letter-spacing: -0.03em;\n          \"\n          ><span data-count=\"974\">974</span></p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">kWh per kWp per year, facing south</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: 'Helvetica Neue', Arial, sans-serif;\n            font-weight: 700;\n            letter-spacing: -0.03em;\n          \"\n          ><span data-count=\"79\">79</span>%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\"\n          >of that, facing east - still worth it</p\n        >\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: 'Helvetica Neue', Arial, sans-serif;\n            font-weight: 700;\n            letter-spacing: -0.03em;\n          \"\n          ><span data-count=\"6\">6</span>×</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">more yield in July than in December</p>\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >Orientation changes the yield by a fifth. The season changes it sixfold.</p\n    >\n    <p class=\"presentation-note\">Season beats orientation - say it clearly.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"The sky\">\n    <header class=\"presentation-header\"><span>Weather</span><span>Clouds, not angles</span></header>\n    <div style=\"display: flex; gap: 4.5rem; align-items: center; margin-top: 3.5rem\">\n      <div style=\"flex: 1 1 0; min-width: 0\">\n        <h2\n          class=\"presentation-title\"\n          data-df-entrance=\"up\"\n          style=\"\n            font-size: 3.4rem;\n            font-family: 'Helvetica Neue', Arial, sans-serif;\n            font-weight: 700;\n            letter-spacing: -0.03em;\n          \"\n          >Clouds matter more than angles</h2\n        >\n        <p class=\"presentation-lede\" data-df-entrance=\"fade\" style=\"--df-motion-delay: 300ms; font-size: 1.7rem\"\n          >A cloudy June still beats a clear December. Orientation fine-tunes; latitude and weather decide.</p\n        >\n      </div>\n      <figure\n        class=\"image\"\n        data-ratio=\"4/3\"\n        data-df-entrance=\"flip\"\n        style=\"--df-motion-delay: 150ms; flex: 0 0 700px; margin: 0\"\n      >\n        <img\n          src=\"https://picsum.photos/id/54/960/720\"\n          alt=\"White clouds drifting over a green mountain summit under a blue sky\"\n          loading=\"lazy\"\n          width=\"960\"\n          height=\"720\"\n          style=\"width: 100%; height: 100%; object-fit: cover\"\n        />\n        <figcaption class=\"image-caption\" style=\"font-size: 1.25rem\">Summer sky (stock photo).</figcaption>\n      </figure>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The photo is the other variable.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"west\"\n    data-anim-in-blocks=\"4\"\n    data-anim-in-color=\"#1F4E9D\"\n    aria-label=\"Yield table\"\n  >\n    <header class=\"presentation-header\"><span>The data</span><span>kWh per kWp</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" style=\"font-size: 1.7rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Modelled yield by roof orientation, mid-European location (synthetic).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Orientation</th><th class=\"table-head\" style=\"text-align: right\">Jan</th\n            ><th class=\"table-head\" style=\"text-align: right\">Jul</th\n            ><th class=\"table-head\" style=\"text-align: right\">Year</th\n            ><th class=\"table-head\" style=\"text-align: right\">vs south</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\" style=\"font-weight: 700\"\n            ><td class=\"table-cell\">South</td><td class=\"table-cell\" style=\"text-align: right\">28</td\n            ><td class=\"table-cell\" style=\"text-align: right\">135</td\n            ><td class=\"table-cell\" style=\"text-align: right\">974</td\n            ><td class=\"table-cell\" style=\"text-align: right\">100%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">South-west</td><td class=\"table-cell\" style=\"text-align: right\">24</td\n            ><td class=\"table-cell\" style=\"text-align: right\">130</td\n            ><td class=\"table-cell\" style=\"text-align: right\">924</td\n            ><td class=\"table-cell\" style=\"text-align: right\">95%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">South-east</td><td class=\"table-cell\" style=\"text-align: right\">24</td\n            ><td class=\"table-cell\" style=\"text-align: right\">128</td\n            ><td class=\"table-cell\" style=\"text-align: right\">914</td\n            ><td class=\"table-cell\" style=\"text-align: right\">94%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Flat (10°)</td><td class=\"table-cell\" style=\"text-align: right\">20</td\n            ><td class=\"table-cell\" style=\"text-align: right\">122</td\n            ><td class=\"table-cell\" style=\"text-align: right\">852</td\n            ><td class=\"table-cell\" style=\"text-align: right\">87%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">West</td><td class=\"table-cell\" style=\"text-align: right\">16</td\n            ><td class=\"table-cell\" style=\"text-align: right\">112</td\n            ><td class=\"table-cell\" style=\"text-align: right\">776</td\n            ><td class=\"table-cell\" style=\"text-align: right\">80%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">East</td><td class=\"table-cell\" style=\"text-align: right\">16</td\n            ><td class=\"table-cell\" style=\"text-align: right\">111</td\n            ><td class=\"table-cell\" style=\"text-align: right\">769</td\n            ><td class=\"table-cell\" style=\"text-align: right\">79%</td></tr\n          >\n        </tbody>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The whole grid in six rows.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"\n          font-size: 3.3rem;\n          line-height: 1.22;\n          font-family: 'Helvetica Neue', Arial, sans-serif;\n          font-weight: 700;\n          letter-spacing: -0.03em;\n          font-size: 2.9rem;\n        \"\n        >“Customers ask for south. Then they see the east-west curve and realise it matches when they are actually\n        home.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #f2c12e; color: #151515\"\n        ><span class=\"avatar-fallback\">PB</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Pieter Bakker<br /><span style=\"opacity: 0.7; font-size: 1.4rem\">Solar installer - 740 roofs fitted</span></p\n      >\n    </div>\n    <p class=\"presentation-note\">The quote sets up the last chart.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"day\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Summer day\"\n  >\n    <header class=\"presentation-header\"><span>A day in June</span><span>kW per kWp by hour</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Helvetica Neue', Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.03em;\n      \"\n      >East-west makes less - but earlier and later</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Morning and evening are when households use power.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Questions from homeowners\"\n  >\n    <header class=\"presentation-header\"><span>Q & A</span><span>Homeowners ask</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.2rem;\n        margin-block: 5.25rem 1.5rem;\n        font-family: 'Helvetica Neue', Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.03em;\n      \"\n      >Questions from homeowners</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"sm-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Is a north roof worth it?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Rarely: about 55% of south in this model - only with a very shallow pitch.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"sm-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>East-west or south?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >South for export, east-west for self-use: it covered 39% of household demand versus 31% for south.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"sm-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Does a flat roof need tilting?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >A 10° tilt keeps panels self-cleaning and yields 87% of south - enough for most roofs.</p\n          ></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The north question always comes.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Takeaways</span><span>Four rules</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">■</span\n        ><span>Repeat the frame when you compare shapes - small multiples beat overlays.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">■</span\n        ><span>East and west roofs still deliver four fifths of south.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">■</span\n        ><span>Match the curve to when you use power, not to the maximum.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">■</span\n        ><span>Season is the dominant variable - plan storage for winter.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Grid discipline, four lines.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"north\"\n    data-anim-in-blocks=\"4\"\n    data-anim-in-color=\"#FF4B32\"\n    aria-label=\"Closing\"\n  >\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        font-family: 'Helvetica Neue', Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.03em;\n      \"\n      >Repeat the frame. Vary the data.</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px\"\n      >Modelled yields, synthetic households - the small-multiple principle is the real takeaway.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">End on the principle.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 12</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"12\" value=\"1\"></progress>\n</section>\n","individual":false}]
