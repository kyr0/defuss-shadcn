[{"label":"Sizing 1","html":"<div class=\"flex items-end gap-8\" data-demo=\"sizing-scale\">\n  <div class=\"flex flex-col items-center gap-2\">\n    <div class=\"demo-tile\" style=\"inline-size: var(--size-xs); block-size: var(--size-xs)\"></div>\n    <span class=\"demo-label demo-label-inline\">xs</span>\n  </div>\n  <div class=\"flex flex-col items-center gap-2\">\n    <div class=\"demo-tile\" style=\"inline-size: var(--size-sm); block-size: var(--size-sm)\"></div>\n    <span class=\"demo-label demo-label-inline\">sm</span>\n  </div>\n  <div class=\"flex flex-col items-center gap-2\">\n    <div class=\"demo-tile\" style=\"inline-size: var(--size-md); block-size: var(--size-md)\"></div>\n    <span class=\"demo-label demo-label-inline\">md</span>\n  </div>\n  <div class=\"flex flex-col items-center gap-2\">\n    <div class=\"demo-tile\" style=\"inline-size: var(--size-lg); block-size: var(--size-lg)\"></div>\n    <span class=\"demo-label demo-label-inline\">lg</span>\n  </div>\n  <div class=\"flex flex-col items-center gap-2\">\n    <div class=\"demo-tile\" style=\"inline-size: var(--size-xl); block-size: var(--size-xl)\"></div>\n    <span class=\"demo-label demo-label-inline\">xl</span>\n  </div>\n</div>\n","individual":false},{"label":"Sizing 2","html":"<div class=\"stack gap-6\" data-demo=\"sizing-toolbox\">\n  <div class=\"flex items-center gap-3\">\n    <div\n      class=\"size-10 shrink-0\"\n      style=\"\n        border-radius: 9999px;\n        background: var(--primary);\n        color: var(--primary-foreground);\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        font-size: 0.8125rem;\n      \"\n      >AL</div\n    >\n    <div class=\"flex-1 min-w-0\" style=\"overflow-wrap: anywhere\">\n      <p style=\"margin: 0; font-size: 0.875rem; font-weight: 500\">Ada Lovelace</p>\n      <p style=\"margin: 0; font-size: 0.8125rem; color: var(--muted-foreground)\"\n        >ada.lovelace@analytical-engines.example</p\n      >\n    </div>\n    <button class=\"btn shrink-0\" type=\"button\" data-variant=\"outline\" data-size=\"sm\">Follow</button>\n  </div>\n  <div class=\"flex flex-wrap gap-2\">\n    <button class=\"btn\" type=\"button\"\n      ><svg\n        class=\"size-4\"\n        viewBox=\"0 0 16 16\"\n        aria-hidden=\"true\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"1.5\"\n        stroke-linecap=\"round\"\n      >\n        <path d=\"M8 2v12M2 8h12\" />\n      </svg>\n      New project\n    </button>\n    <button class=\"btn\" type=\"button\" data-variant=\"outline\"\n      ><svg\n        class=\"size-4\"\n        viewBox=\"0 0 16 16\"\n        aria-hidden=\"true\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"1.5\"\n        stroke-linecap=\"round\"\n      >\n        <circle cx=\"7\" cy=\"7\" r=\"4.5\" />\n        <path d=\"m10.5 10.5 3.5 3.5\" />\n      </svg>\n      Search\n    </button>\n  </div>\n</div>\n","individual":false}]
