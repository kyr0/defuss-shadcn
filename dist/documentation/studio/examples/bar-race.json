[{"label":"Sports Broadcast","html":"<section\n  class=\"presentation\"\n  id=\"deck-race\"\n  data-anim-in=\"slideIn\"\n  data-anim-in-distance=\"400px\"\n  data-anim-out=\"slideOut\"\n  data-anim-out-distance=\"400px\"\n  style=\"\n    --presentation-ink: #0c0e12;\n    --presentation-ink-foreground: #ffffff;\n    --presentation-paper: #181d27;\n    --presentation-paper-foreground: #dde2eb;\n    --presentation-accent: #ff4d00;\n    font-family: 'Arial Narrow', Arial, sans-serif;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"The golden-boot race - a broadcast deck\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Cumulative goals of six top scorers in a fictional league over 34 matchdays: Okoye overtakes Brandt at matchday 20 and finishes with 28\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Cover\">\n    <div\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        top: 70px;\n        right: 112px;\n        display: flex;\n        gap: 0;\n        font:\n          800 1.6rem/1 'Arial Narrow',\n          Arial,\n          sans-serif;\n        text-transform: uppercase;\n      \"\n    >\n      <span style=\"background: #ff4d00; color: #0c0e12; padding: 0.7rem 1.2rem\">Live</span>\n      <span style=\"background: #ffffff; color: #0c0e12; padding: 0.7rem 1.2rem\">Matchday 34</span>\n    </div>\n    <div\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        left: 0;\n        bottom: 0;\n        width: 100%;\n        height: 18px;\n        background: repeating-linear-gradient(-45deg, #ff4d00 0 24px, transparent 24px 48px);\n        opacity: 0.8;\n      \"\n    ></div>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\">Bar race · Sports Broadcast</p>\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        position: relative;\n        max-width: 1250px;\n        font-family: 'Arial Narrow', Arial, sans-serif;\n        text-transform: uppercase;\n        font-weight: 800;\n        letter-spacing: 0.01em;\n        font-size: 7rem;\n      \"\n      >The golden-boot race</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >Six strikers, 34 matchdays, one lead change - replayed live.</p\n    >\n    <p class=\"presentation-note\">Broadcast energy: the bug and the stripe say “on air”.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"race\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"The race\"\n  >\n    <header class=\"presentation-header\"><span>Replay</span><span>Cumulative goals · live</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Arial Narrow', Arial, sans-serif;\n        text-transform: uppercase;\n        font-weight: 800;\n        letter-spacing: 0.01em;\n      \"\n      >Replay: 34 matchdays in 10 seconds</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The race runs only while this slide is on air - leave and it stops.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"final\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Final tally\"\n  >\n    <header class=\"presentation-header\"><span>Full time</span><span>Goals · season total</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Arial Narrow', Arial, sans-serif;\n        text-transform: uppercase;\n        font-weight: 800;\n        letter-spacing: 0.01em;\n      \"\n      >Okoye wins it with 28</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The race freezes into the final table.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"per90\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Goals per 90\"\n  >\n    <header class=\"presentation-header\"><span>Efficiency</span><span>Goals per 90 minutes</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Arial Narrow', Arial, sans-serif;\n        text-transform: uppercase;\n        font-weight: 800;\n        letter-spacing: 0.01em;\n      \"\n      >Per minute played, Varga was deadlier</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Same bars, new measure - the order shuffles.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Three numbers from the season</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #ff4d00;\n            font-family: 'Arial Narrow', Arial, sans-serif;\n            text-transform: uppercase;\n            font-weight: 800;\n            letter-spacing: 0.01em;\n          \"\n          ><span data-count=\"28\">28</span></p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">goals for M. Okoye - golden boot</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: 'Arial Narrow', Arial, sans-serif;\n            text-transform: uppercase;\n            font-weight: 800;\n            letter-spacing: 0.01em;\n          \"\n          ><span data-count=\"20\">20</span></p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\"\n          >the matchday Okoye took the lead for good</p\n        >\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: 'Arial Narrow', Arial, sans-serif;\n            text-transform: uppercase;\n            font-weight: 800;\n            letter-spacing: 0.01em;\n          \"\n          ><span data-count=\"0.84\">0.84</span></p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\"\n          >goals per 90 for T. Varga - the best rate</p\n        >\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >Brandt led for 19 matchdays and still finished second.</p\n    >\n    <p class=\"presentation-note\">Leads do not win races; finishes do.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Atmosphere\" style=\"overflow: hidden\">\n    <video\n      autoplay\n      muted\n      loop\n      playsinline\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n        opacity: 0.55;\n        mix-blend-mode: screen;\n      \"\n    >\n      <source src=\"videos/demo.webm\" type=\"video/webm\" />\n      <source src=\"videos/demo.mp4\" type=\"video/mp4\" />\n    </video>\n    <div\n      aria-hidden=\"true\"\n      style=\"position: absolute; inset: 0; background: linear-gradient(90deg, #0c0e12 35%, rgba(255, 77, 0, 0.25))\"\n    ></div>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\">Matchday 34</p>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"blur\"\n      style=\"\n        position: relative;\n        font-size: 5rem;\n        max-width: 1100px;\n        font-family: 'Arial Narrow', Arial, sans-serif;\n        text-transform: uppercase;\n        font-weight: 800;\n        letter-spacing: 0.01em;\n        font-size: 4.25rem;\n      \"\n      >The last day decided nothing - the second half of the season did</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 400ms; position: relative; max-width: 900px\"\n      >Okoye scored 13 after the winter break; Brandt scored 12. The gap opened slowly, then stayed.</p\n    >\n    <p class=\"presentation-note\">An ambient loop - let the headline carry it.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"east\"\n    data-anim-in-blocks=\"5\"\n    data-anim-in-color=\"#FF4D00\"\n    aria-label=\"Scorers table\"\n  >\n    <header class=\"presentation-header\"><span>The table</span><span>Season totals</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" style=\"font-size: 1.7rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Top scorers of a fictional league season (synthetic).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Player</th><th class=\"table-head\" style=\"text-align: right\">Club</th\n            ><th class=\"table-head\" style=\"text-align: right\">Goals</th\n            ><th class=\"table-head\" style=\"text-align: right\">Minutes</th\n            ><th class=\"table-head\" style=\"text-align: right\">Per 90</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\" style=\"font-weight: 700\"\n            ><td class=\"table-cell\">M. Okoye</td><td class=\"table-cell\" style=\"text-align: right\">Harbor City</td\n            ><td class=\"table-cell\" style=\"text-align: right\">28</td\n            ><td class=\"table-cell\" style=\"text-align: right\">3,073</td\n            ><td class=\"table-cell\" style=\"text-align: right\">0.82</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">L. Brandt</td><td class=\"table-cell\" style=\"text-align: right\">FC Nordtal</td\n            ><td class=\"table-cell\" style=\"text-align: right\">26</td\n            ><td class=\"table-cell\" style=\"text-align: right\">2,962</td\n            ><td class=\"table-cell\" style=\"text-align: right\">0.79</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">T. Varga</td><td class=\"table-cell\" style=\"text-align: right\">Rovers</td\n            ><td class=\"table-cell\" style=\"text-align: right\">23</td\n            ><td class=\"table-cell\" style=\"text-align: right\">2,464</td\n            ><td class=\"table-cell\" style=\"text-align: right\">0.84</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">J. Silva</td><td class=\"table-cell\" style=\"text-align: right\">Athletic</td\n            ><td class=\"table-cell\" style=\"text-align: right\">22</td\n            ><td class=\"table-cell\" style=\"text-align: right\">2,789</td\n            ><td class=\"table-cell\" style=\"text-align: right\">0.71</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">K. Mensah</td><td class=\"table-cell\" style=\"text-align: right\">United</td\n            ><td class=\"table-cell\" style=\"text-align: right\">21</td\n            ><td class=\"table-cell\" style=\"text-align: right\">2,739</td\n            ><td class=\"table-cell\" style=\"text-align: right\">0.69</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">R. Ito</td><td class=\"table-cell\" style=\"text-align: right\">Wanderers</td\n            ><td class=\"table-cell\" style=\"text-align: right\">17</td\n            ><td class=\"table-cell\" style=\"text-align: right\">2,782</td\n            ><td class=\"table-cell\" style=\"text-align: right\">0.55</td></tr\n          >\n        </tbody>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Minutes explain the per-90 flip.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"\n          font-size: 3.3rem;\n          line-height: 1.22;\n          font-family: 'Arial Narrow', Arial, sans-serif;\n          text-transform: uppercase;\n          font-weight: 800;\n          letter-spacing: 0.01em;\n          font-size: 3.2rem;\n        \"\n        >“I stopped looking at the table after matchday twenty. I only looked at the next chance.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #ff4d00; color: #0c0e12\"\n        ><span class=\"avatar-fallback\">MO</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Musa Okoye<br /><span style=\"opacity: 0.7; font-size: 1.4rem\"\n          >Striker, Harbor City - 28 goals in 34 matchdays</span\n        ></p\n      >\n    </div>\n    <p class=\"presentation-note\">Fictional player, fictional quote - the pattern is real.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"season\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Season lines\"\n  >\n    <header class=\"presentation-header\"><span>The season</span><span>Cumulative goals by matchday</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Arial Narrow', Arial, sans-serif;\n        text-transform: uppercase;\n        font-weight: 800;\n        letter-spacing: 0.01em;\n      \"\n      >The crossing at matchday 20</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The bars unfold into the season: lines show when the lead changed.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Questions from the studio\"\n  >\n    <header class=\"presentation-header\"><span>Studio Q & A</span><span>Post-match</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.2rem;\n        margin-block: 5.25rem 1.5rem;\n        font-family: 'Arial Narrow', Arial, sans-serif;\n        text-transform: uppercase;\n        font-weight: 800;\n        letter-spacing: 0.01em;\n      \"\n      >Questions from the studio</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"br-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Why not give the boot to Varga?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >The award counts goals, not rates - Varga missed seven matches injured.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"br-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>How many penalties were in Okoye’s 28?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\">Five - 23 of his 28 came from open play.</p></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"br-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Who is the one to watch next year?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\">Mensah: 10 goals in the last 14 matchdays - his best run yet.</p></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The penalty question always comes.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Full-time analysis</span><span>Four points</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">▶</span\n        ><span>Races are about the second half of the season.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">▶</span\n        ><span>Rates and totals tell different stories - show both.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">▶</span\n        ><span>A bar race shows who led; a line shows when it changed.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">▶</span\n        ><span>Animate the ranking, not just the values.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Pundit-length: thirty seconds.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"west\"\n    data-anim-in-blocks=\"5\"\n    data-anim-in-color=\"#FF4D00\"\n    aria-label=\"Closing\"\n  >\n    <div\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        top: 70px;\n        right: 112px;\n        display: flex;\n        gap: 0;\n        font:\n          800 1.6rem/1 'Arial Narrow',\n          Arial,\n          sans-serif;\n        text-transform: uppercase;\n      \"\n    >\n      <span style=\"background: #ff4d00; color: #0c0e12; padding: 0.7rem 1.2rem\">Live</span>\n      <span style=\"background: #ffffff; color: #0c0e12; padding: 0.7rem 1.2rem\">Matchday 34</span>\n    </div>\n    <div\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        left: 0;\n        bottom: 0;\n        width: 100%;\n        height: 18px;\n        background: repeating-linear-gradient(-45deg, #ff4d00 0 24px, transparent 24px 48px);\n        opacity: 0.8;\n      \"\n    ></div>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        font-family: 'Arial Narrow', Arial, sans-serif;\n        text-transform: uppercase;\n        font-weight: 800;\n        letter-spacing: 0.01em;\n      \"\n      >That’s full time</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px\"\n      >A fictional league and synthetic goals - the race, the re-rank and the crossing are the pattern.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">Sign off like a broadcast.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 12</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"12\" value=\"1\"></progress>\n</section>\n","individual":false}]
