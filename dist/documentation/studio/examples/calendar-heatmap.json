[{"label":"Pastel Stationery","html":"<section\n  class=\"presentation\"\n  id=\"deck-calendar\"\n  data-anim-in=\"wipeIn\"\n  data-anim-in-direction=\"south\"\n  data-anim-out=\"fadeOut\"\n  style=\"\n    --presentation-ink: #43333b;\n    --presentation-ink-foreground: #fff9fa;\n    --presentation-paper: #fff9fa;\n    --presentation-paper-foreground: #43333b;\n    --presentation-accent: #e26c8d;\n    font-family: Verdana, Arial, sans-serif;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"A year of running - 2,104 km in 365 squares\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Daily running distance for 2025 as a calendar heatmap: 2,104 km over 201 running days, a two-week break in August and a marathon on 12 October; then monthly totals, weekday totals and the marathon build\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Cover\">\n    <svg\n      aria-hidden=\"true\"\n      width=\"600\"\n      height=\"700\"\n      viewBox=\"0 0 600 700\"\n      style=\"position: absolute; right: 90px; top: 120px\"\n    >\n      <rect x=\"60\" y=\"40\" width=\"440\" height=\"520\" rx=\"28\" fill=\"#FFFFFF\" stroke=\"#F3C6D3\" stroke-width=\"6\" />\n      <g transform=\"translate(110 110)\">\n        <rect x=\"0\" y=\"0\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#FCE4EC\" />\n        <rect x=\"50\" y=\"0\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#E26C8D\" />\n        <rect x=\"100\" y=\"0\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#F48FB1\" />\n        <rect x=\"150\" y=\"0\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#F8BBD0\" />\n        <rect x=\"200\" y=\"0\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#FCE4EC\" />\n        <rect x=\"250\" y=\"0\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#FCE4EC\" />\n        <rect x=\"300\" y=\"0\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#E26C8D\" />\n        <rect x=\"0\" y=\"50\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#F48FB1\" />\n        <rect x=\"50\" y=\"50\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#F8BBD0\" />\n        <rect x=\"100\" y=\"50\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#FCE4EC\" />\n        <rect x=\"150\" y=\"50\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#FCE4EC\" />\n        <rect x=\"200\" y=\"50\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#E26C8D\" />\n        <rect x=\"250\" y=\"50\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#F48FB1\" />\n        <rect x=\"300\" y=\"50\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#F8BBD0\" />\n        <rect x=\"0\" y=\"100\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#FCE4EC\" />\n        <rect x=\"50\" y=\"100\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#FCE4EC\" />\n        <rect x=\"100\" y=\"100\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#E26C8D\" />\n        <rect x=\"150\" y=\"100\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#F48FB1\" />\n        <rect x=\"200\" y=\"100\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#F8BBD0\" />\n        <rect x=\"250\" y=\"100\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#FCE4EC\" />\n        <rect x=\"300\" y=\"100\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#FCE4EC\" />\n        <rect x=\"0\" y=\"150\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#E26C8D\" />\n        <rect x=\"50\" y=\"150\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#F48FB1\" />\n        <rect x=\"100\" y=\"150\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#F8BBD0\" />\n        <rect x=\"150\" y=\"150\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#FCE4EC\" />\n        <rect x=\"200\" y=\"150\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#FCE4EC\" />\n        <rect x=\"250\" y=\"150\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#E26C8D\" />\n        <rect x=\"300\" y=\"150\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#F48FB1\" />\n        <rect x=\"0\" y=\"200\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#F8BBD0\" />\n        <rect x=\"50\" y=\"200\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#FCE4EC\" />\n        <rect x=\"100\" y=\"200\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#FCE4EC\" />\n        <rect x=\"150\" y=\"200\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#E26C8D\" />\n        <rect x=\"200\" y=\"200\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#F48FB1\" />\n        <rect x=\"250\" y=\"200\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#F8BBD0\" />\n        <rect x=\"300\" y=\"200\" width=\"40\" height=\"40\" rx=\"8\" fill=\"#FCE4EC\" />\n      </g>\n      <circle cx=\"470\" cy=\"600\" r=\"70\" fill=\"#C9E4DE\" />\n      <circle cx=\"120\" cy=\"620\" r=\"44\" fill=\"#F6E7A9\" />\n    </svg>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\"\n      >Calendar heatmap · Pastel Stationery</p\n    >\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        position: relative;\n        max-width: 1250px;\n        font-family: Verdana, Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n        font-size: 6rem;\n        max-width: 800px;\n      \"\n      >A year of running</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >365 squares, 201 runs, one marathon - a training diary in a single glance.</p\n    >\n    <p class=\"presentation-note\">Stationery warmth - this is a personal story.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"year\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"The year\"\n  >\n    <header class=\"presentation-header\"><span>The diary</span><span>km per day · 2025</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Verdana, Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n      \"\n      >Every square is a day</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Darker = further. Find the Sundays, the August gap and the marathon.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"months\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Months\"\n  >\n    <header class=\"presentation-header\"><span>By month</span><span>km per month</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Verdana, Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n      \"\n      >Steady all year - except August</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The calendar folds into twelve bars.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"weekday\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Weekdays\"\n  >\n    <header class=\"presentation-header\"><span>By weekday</span><span>km per weekday, whole year</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Verdana, Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n      \"\n      >Sunday carries 44% of the year</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The long run is the backbone.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Three numbers from the diary</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: Verdana, Arial, sans-serif;\n            font-weight: 700;\n            letter-spacing: -0.02em;\n          \"\n          ><span data-count=\"2104\">2104</span> km</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">run in 2025</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: Verdana, Arial, sans-serif;\n            font-weight: 700;\n            letter-spacing: -0.02em;\n          \"\n          ><span data-count=\"201\">201</span></p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">running days out of 365</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #e26c8d;\n            font-family: Verdana, Arial, sans-serif;\n            font-weight: 700;\n            letter-spacing: -0.02em;\n          \"\n          ><span data-count=\"42.2\">42.2</span> km</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">the marathon, 12 October</p>\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >The longest training run was 22.1 km. The race asked for almost twice that - and got it.</p\n    >\n    <p class=\"presentation-note\">The race-day gap is the emotional beat.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"The route\">\n    <header class=\"presentation-header\"><span>The route</span><span>Sunday long run</span></header>\n    <div style=\"display: flex; gap: 4.5rem; align-items: center; margin-top: 3.5rem\">\n      <figure\n        class=\"image\"\n        data-ratio=\"4/3\"\n        data-df-entrance=\"zoom\"\n        style=\"--df-motion-delay: 150ms; flex: 0 0 700px; margin: 0\"\n      >\n        <img\n          src=\"https://picsum.photos/id/17/960/720\"\n          alt=\"A gravel path winding through a green meadow toward a line of trees\"\n          loading=\"lazy\"\n          width=\"960\"\n          height=\"720\"\n          style=\"width: 100%; height: 100%; object-fit: cover\"\n        />\n        <figcaption class=\"image-caption\" style=\"font-size: 1.25rem\">The Sunday loop (stock photo).</figcaption>\n      </figure>\n      <div style=\"flex: 1 1 0; min-width: 0\">\n        <h2\n          class=\"presentation-title\"\n          data-df-entrance=\"up\"\n          style=\"font-size: 3.4rem; font-family: Verdana, Arial, sans-serif; font-weight: 700; letter-spacing: -0.02em\"\n          >Same path, every Sunday</h2\n        >\n        <p class=\"presentation-lede\" data-df-entrance=\"fade\" style=\"--df-motion-delay: 300ms; font-size: 1.7rem\"\n          >Forty-eight Sunday long runs on one loop through the meadows - the darkest column of the calendar.</p\n        >\n      </div>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The photo is the Sunday column.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"west\"\n    data-anim-in-blocks=\"6\"\n    data-anim-in-color=\"#E26C8D\"\n    aria-label=\"Month table\"\n  >\n    <header class=\"presentation-header\"><span>The log</span><span>km per month</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" style=\"font-size: 1.7rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Monthly running distance, 2025 (synthetic diary).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Month</th><th class=\"table-head\" style=\"text-align: right\">km</th\n            ><th class=\"table-head\">Month</th><th class=\"table-head\" style=\"text-align: right\">km</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">January</td><td class=\"table-cell\" style=\"text-align: right\">190</td\n            ><td class=\"table-cell\">July</td><td class=\"table-cell\" style=\"text-align: right\">175</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">February</td><td class=\"table-cell\" style=\"text-align: right\">184</td\n            ><td class=\"table-cell\">August</td><td class=\"table-cell\" style=\"text-align: right\">96</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">March</td><td class=\"table-cell\" style=\"text-align: right\">216</td\n            ><td class=\"table-cell\">September</td><td class=\"table-cell\" style=\"text-align: right\">152</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">April</td><td class=\"table-cell\" style=\"text-align: right\">194</td\n            ><td class=\"table-cell\">October</td><td class=\"table-cell\" style=\"text-align: right\">158</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">May</td><td class=\"table-cell\" style=\"text-align: right\">186</td\n            ><td class=\"table-cell\">November</td><td class=\"table-cell\" style=\"text-align: right\">182</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">June</td><td class=\"table-cell\" style=\"text-align: right\">181</td\n            ><td class=\"table-cell\">December</td><td class=\"table-cell\" style=\"text-align: right\">191</td></tr\n          >\n        </tbody>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">March was the biggest month; August the smallest.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"\n          font-size: 3.3rem;\n          line-height: 1.22;\n          font-family: Verdana, Arial, sans-serif;\n          font-weight: 700;\n          letter-spacing: -0.02em;\n          font-size: 3rem;\n        \"\n        >“I never looked at a single run. I looked at the squares - and did not want a white week.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #e26c8d; color: #fff9fa\"\n        ><span class=\"avatar-fallback\">LW</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Lotte Weber<br /><span style=\"opacity: 0.7; font-size: 1.4rem\">Hobby runner - first marathon, 3:52</span></p\n      >\n    </div>\n    <p class=\"presentation-note\">The heatmap as motivation - a lovely closing thought for the data part.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"build\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Marathon build\"\n  >\n    <header class=\"presentation-header\"><span>The build</span><span>km per week · 16 weeks to race day</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Verdana, Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n      \"\n      >Sixteen weeks: steady volume, a summer gap, then race week</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The weeks before 12 October, as a line.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Questions from the running club\"\n  >\n    <header class=\"presentation-header\"><span>Q & A</span><span>Running club</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.2rem;\n        margin-block: 5.25rem 1.5rem;\n        font-family: Verdana, Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n      \"\n      >Questions from the running club</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"ch-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Why no Monday or Friday runs?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\">Rest days by design: two fixed rest days kept 201 runs injury-free.</p></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"ch-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>What happened in August?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\">Two weeks of holiday, zero runs - the white strip in the calendar.</p></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"ch-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Was 22 km enough for a marathon?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >For a first finish, yes: the plan built weekly volume, not single long runs.</p\n          ></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The rest-day question is the useful one.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Takeaways</span><span>From the diary</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">♥</span\n        ><span>A calendar heatmap shows habits that averages hide.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">♥</span\n        ><span>Rest days are visible structure, not missing data.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">♥</span\n        ><span>One long run a week did almost half of the work.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">♥</span\n        ><span>Streaks motivate - design for the white squares too.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Soft, friendly, done.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"east\"\n    data-anim-in-blocks=\"6\"\n    data-anim-in-color=\"#F8BBD0\"\n    aria-label=\"Closing\"\n  >\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        font-family: Verdana, Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n      \"\n      >A year fits into one glance</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px\"\n      >A synthetic diary of 365 days - the calendar is the real pattern.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">End on the glance.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 12</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"12\" value=\"1\"></progress>\n</section>\n","individual":false}]
