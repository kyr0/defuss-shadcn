[{"label":"A subset of tools, an empty document","html":"<div\n  class=\"editorjs\"\n  id=\"ed-notes\"\n  data-tools=\"header list\"\n  data-placeholder=\"Meeting notes - press / for a heading or a list\"\n  style=\"max-inline-size: 44rem; --editorjs-min-height: 8rem\"\n></div>\n","individual":true},{"label":"Markdown in, Markdown out","html":"<div class=\"stack gap-3\" style=\"max-inline-size: 44rem\">\n  <div class=\"editorjs\" id=\"ed-brief\" data-state-demo data-placeholder=\"Write the brief...\">\n    \n  </div>\n  <div class=\"flex items-center gap-2\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"ed-brief-read\"\n      ><i data-lucide=\"file-text\"></i> Read as Markdown</button\n    >\n    <span class=\"text-sm text-muted-foreground\" id=\"ed-brief-count\"></span>\n  </div>\n  <textarea\n    class=\"textarea\"\n    id=\"ed-brief-out\"\n    rows=\"8\"\n    readonly\n    aria-label=\"The document as Markdown\"\n    placeholder=\"Click Read as Markdown\"\n  ></textarea>\n</div>\n","individual":false},{"label":"Formatting from a Toolbar","html":"<div class=\"stack gap-3\" style=\"max-inline-size: 44rem\">\n  <div class=\"toolbar\" role=\"toolbar\" aria-label=\"Formatting\" id=\"ed-bar\" data-size=\"sm\">\n    <div class=\"toggle-group\" role=\"group\" aria-label=\"Text style\" data-type=\"multiple\">\n      <button class=\"toggle\" aria-pressed=\"false\" data-editor-command=\"bold\" aria-label=\"Bold\" type=\"button\"\n        ><i data-lucide=\"bold\"></i\n      ></button>\n      <button class=\"toggle\" aria-pressed=\"false\" data-editor-command=\"italic\" aria-label=\"Italic\" type=\"button\"\n        ><i data-lucide=\"italic\"></i\n      ></button>\n      <button class=\"toggle\" aria-pressed=\"false\" data-editor-command=\"underline\" aria-label=\"Underline\" type=\"button\"\n        ><i data-lucide=\"underline\"></i\n      ></button>\n    </div>\n    <div class=\"separator\" data-orientation=\"vertical\" role=\"separator\"></div>\n    <div class=\"toggle-group\" role=\"group\" aria-label=\"Block\" data-type=\"single\">\n      <button class=\"toggle\" aria-pressed=\"false\" data-editor-command=\"paragraph\" aria-label=\"Paragraph\" type=\"button\"\n        ><i data-lucide=\"pilcrow\"></i\n      ></button>\n      <button class=\"toggle\" aria-pressed=\"false\" data-editor-command=\"header:1\" aria-label=\"Heading 1\" type=\"button\"\n        ><i data-lucide=\"heading-1\"></i\n      ></button>\n      <button class=\"toggle\" aria-pressed=\"false\" data-editor-command=\"header:2\" aria-label=\"Heading 2\" type=\"button\"\n        ><i data-lucide=\"heading-2\"></i\n      ></button>\n      <button class=\"toggle\" aria-pressed=\"false\" data-editor-command=\"header:3\" aria-label=\"Heading 3\" type=\"button\"\n        ><i data-lucide=\"heading-3\"></i\n      ></button>\n      <button\n        class=\"toggle\"\n        aria-pressed=\"false\"\n        data-editor-command=\"list:unordered\"\n        aria-label=\"Bulleted list\"\n        type=\"button\"\n        ><i data-lucide=\"list\"></i\n      ></button>\n      <button\n        class=\"toggle\"\n        aria-pressed=\"false\"\n        data-editor-command=\"list:ordered\"\n        aria-label=\"Numbered list\"\n        type=\"button\"\n        ><i data-lucide=\"list-ordered\"></i\n      ></button>\n      <button\n        class=\"toggle\"\n        aria-pressed=\"false\"\n        data-editor-command=\"list:checklist\"\n        aria-label=\"Checklist\"\n        type=\"button\"\n        ><i data-lucide=\"list-checks\"></i\n      ></button>\n      <button class=\"toggle\" aria-pressed=\"false\" data-editor-command=\"quote\" aria-label=\"Quote\" type=\"button\"\n        ><i data-lucide=\"quote\"></i\n      ></button>\n      <button class=\"toggle\" aria-pressed=\"false\" data-editor-command=\"code\" aria-label=\"Code block\" type=\"button\"\n        ><i data-lucide=\"square-code\"></i\n      ></button>\n    </div>\n    <div class=\"separator\" data-orientation=\"vertical\" role=\"separator\"></div>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"icon-sm\"\n      data-editor-command=\"marker\"\n      aria-label=\"Highlight\"\n      type=\"button\"\n      ><i data-lucide=\"highlighter\"></i\n    ></button>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"icon-sm\"\n      data-editor-command=\"inline-code\"\n      aria-label=\"Inline code\"\n      type=\"button\"\n      ><i data-lucide=\"code\"></i\n    ></button>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"icon-sm\"\n      data-editor-command=\"delimiter\"\n      aria-label=\"Divider\"\n      type=\"button\"\n      ><i data-lucide=\"minus\"></i\n    ></button>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"icon-sm\"\n      data-editor-command=\"table\"\n      aria-label=\"Table\"\n      type=\"button\"\n      ><i data-lucide=\"table\"></i\n    ></button>\n  </div>\n  <div class=\"editorjs\" id=\"ed-toolbar\" data-toolbar=\"ed-bar\">\n    \n  </div>\n</div>\n","individual":false},{"label":"Editor.js JSON, read only","html":"<div class=\"stack gap-3\" style=\"max-inline-size: 44rem\">\n  <div class=\"editorjs\" id=\"ed-json\" data-readonly>\n    \n  </div>\n  <div class=\"flex items-center gap-2\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"ed-json-toggle\">Make editable</button>\n    <span class=\"badge\" data-variant=\"secondary\" id=\"ed-json-state\">readonly</span>\n  </div>\n</div>\n","individual":false},{"label":"Save and restore","html":"<div class=\"stack gap-3\" style=\"max-inline-size: 44rem\">\n  <div class=\"editorjs\" id=\"ed-store\">\n    \n  </div>\n  <div class=\"flex flex-wrap items-center gap-2\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"ed-store-save\"\n      ><i data-lucide=\"save\"></i> Save</button\n    >\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"ed-store-restore\" disabled\n      ><i data-lucide=\"history\"></i> Restore</button\n    >\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"ed-store-load\"\n      ><i data-lucide=\"file-input\"></i> Load Markdown</button\n    >\n    <span class=\"text-sm text-muted-foreground\" id=\"ed-store-info\"></span>\n  </div>\n  <textarea class=\"textarea\" id=\"ed-store-md\" rows=\"4\" aria-label=\"Markdown to load\">\n## From Markdown\n\nA document loaded from the textarea above - with a list:\n\n1. first\n2. second</textarea>\n</div>\n","individual":false}]
