[{"label":"Sam Lindqvist, infrastructure engineer","html":"<style>\n  #pf-developer {\n    --background: oklch(0.16 0.012 250);\n    --foreground: oklch(0.93 0.01 250);\n    --card: oklch(0.195 0.014 250);\n    --card-foreground: var(--foreground);\n    --popover: var(--card);\n    --popover-foreground: var(--foreground);\n    --muted: oklch(0.235 0.016 250);\n    --muted-foreground: oklch(0.7 0.02 250);\n    --border: oklch(0.31 0.016 250);\n    --input: var(--border);\n    --primary: oklch(0.82 0.17 152);\n    --primary-foreground: oklch(0.2 0.04 152);\n    --secondary: var(--muted);\n    --secondary-foreground: var(--foreground);\n    --accent: oklch(0.27 0.04 152);\n    --accent-foreground: var(--foreground);\n    --ring: var(--primary);\n    --chart-1: oklch(0.82 0.17 152);\n    --chart-2: oklch(0.78 0.13 220);\n    color-scheme: dark;\n    container: pf-developer / inline-size;\n    box-sizing: border-box;\n    width: 100%;\n    padding: 0 0 3rem;\n    background: var(--background);\n    color: var(--foreground);\n    font-family: var(--font-sans);\n  }\n  #pf-developer .pf-status {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: space-between;\n    gap: 0.25rem 1rem;\n    margin: 0;\n    padding: 0.5rem clamp(1rem, 4vw, 2.5rem);\n    padding-inline-end: 4rem;\n    background: var(--primary);\n    color: var(--primary-foreground);\n    font-family: var(--font-mono);\n    font-size: 0.8125rem;\n  }\n  #pf-developer .pf-status span:first-child::before {\n    content: '[0] ';\n    opacity: 0.6;\n  }\n  /* everything below the hero reads 15 % larger: zoom scales the blocks' rem sizes too, the width is compensated */\n  #pf-developer .pf-page {\n    display: flex;\n    flex-direction: column;\n    gap: clamp(3rem, 6vw, 4.5rem);\n    max-width: calc(72rem / 1.15);\n    margin-inline: auto;\n    padding: clamp(2.5rem, 5vw, 3.5rem) clamp(1rem, 4vw, 2.5rem) 0;\n    zoom: 1.15;\n  }\n  #pf-developer {\n    --site-mode-top: 2.75rem;\n  }\n  /* the hero: a