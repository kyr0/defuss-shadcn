e pre {\n    white-space: pre-wrap;\n  }\n  #pf-developer .mk-resume-header {\n    flex-direction: column;\n    align-items: flex-start;\n  }\n  #pf-developer .mk-resume-header-body {\n    flex: none;\n  }\n  #pf-developer .mk-resume-header-photo {\n    width: 6rem;\n    height: auto;\n    aspect-ratio: 1;\n    filter: grayscale(1) contrast(1.1);\n  }\n  #pf-developer .mk-resume-header-name {\n    font-family: var(--font-mono);\n    font-weight: 500;\n    letter-spacing: -0.02em;\n  }\n  #pf-developer .mk-resume-header-facts {\n    flex-direction: column;\n    gap: 0.4rem;\n    font-family: var(--font-mono);\n    font-size: 0.8125rem;\n  }\n  #pf-developer .mk-repository-item-name,\n  #pf-developer .mk-resume-entry-when,\n  #pf-developer .mk-skill-matrix-note {\n    font-family: var(--font-mono);\n  }\n  #pf-developer .pf-activity {\n    display: grid;\n    gap: 1.5rem;\n    padding: 1.5rem;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-xl);\n    background: var(--card);\n  }\n  #pf-developer .pf-activity svg {\n    display: block;\n    width: 100%;\n    height: 7rem;\n    overflow: visible;\n  }\n  #pf-developer .pf-activity-axis {\n    display: flex;\n    justify-content: space-between;\n    font-family: var(--font-mono);\n    font-size: 0.6875rem;\n    color: var(--muted-foreground);\n  }\n  #pf-developer .mk-stat-value {\n    font-family: var(--font-mono);\n    color: var(--primary);\n  }\n  #pf-developer .pf-two {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));\n    gap: 2.5rem 3.5rem;\n    align-items: start;\n  }\n  #pf-developer .pf-posts {\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n  #pf-developer .pf-posts li {\n    display: grid;\n    grid-template-columns: 7.5rem minmax(0, 1fr);\n    gap: 0 1rem;\n    padding-block: 0.75rem;\n    border-block-end: 1px dashed var(--border);\n  }\n  #pf-developer .pf-posts time {\n    font-family: var(--font-mono);\n    font-size: 0.8125rem;\n    color: var(--muted-foreground);\n  }\n  #pf-developer .pf-posts a {\n    color: inherit;\n    font-weight: 500;\n    text-decoration: none;\n  }\n  #pf-developer .pf-posts a:is(:hover, :focus-visible) {\n    color: var(--primary);\n    text-decoration: underline;\n  }\n  #pf-developer .pf-posts p {\n    grid-column: 2;\n    margin: 0.15rem 0 0;\n    font-size: 0.9375rem;\n    color: var(--muted-foreground);\n  }\n  /* light or dark: the Swap writes the page's dark class - every look has a light and a dark palette */\n  #pf-developer .site-mode {\n    flex: none;\n    border: 1px solid var(--input);\n    border-radius: var(--radius-md);\n    background: var(--background);\n    color: var(--foreground);\n  }\n  #pf-developer .site-mode:hover {\n    background: var(--accent);\n    color: var(--accent-foreground);\n  }\n  #pf-developer {\n    position: relative;\n  }\n  #pf-developer > .site-mode {\n    position: absolute;\n    z-index: 20;\n    inset: var(--site-mode-top, 0.75rem) clamp(0.75rem, 2vw, 1.25rem) auto auto;\n  }\n  /* -- modes: each look in light and dark, derived from the palettes above (the other mode of each look) -- */\n  .dark #pf-developer {\n    --accent: oklch(0.25 0.04 152);\n  }\n  :root:not(.dark) #pf-developer {\n    color-scheme: light;\n    --background: oklch(0.985 0.012 250);\n    --foreground: oklch(0.2 0.01 250);\n    --card: oklch(0.997 0.014 250);\n    --card-foreground: oklch(0.2 0.01 250);\n    --popover: oklch(0.997 0.014 250);\n    --popover-foreground: oklch(0.2 0.01 250);\n    --muted: oklch(0.95 0.016 250);\n    --muted-foreground: oklch(0.46 0.02 250);\n    --border: oklch(0.9 0.016 250);\n    --input: oklch(0.88 0.016 250);\n    --primary: oklch(0.57 0.17 152);\n    --primary-foreground: oklch(0.17 0.03 152);\n    --secondary: oklch(0.955 0.016 250);\n    --secondary-foreground: oklch(0.25 0.01 250);\n    --accent: oklch(0.94 0.025 152);\n    --accent-foreground: oklch(0.2 0.01 250);\n    --ring: oklch(0.57 0.17 152);\n    --chart-1: oklch(0.57 0.17 152);\n    --chart-2: oklch(0.53 0.13 220);\n  }\n  /* -- modes: end -- */\n</style>\n<div id=\"pf-developer\">\n  <label class=\"swap site-mode\" data-variant=\"rotate\" data-size=\"sm\">\n    <input type=\"checkbox\" data-site-mode aria-label=\"Dark mode\" />\n    <span class=\"swap-on\" aria-hidden=\"true\"><i data-lucide=\"moon\"></i></span>\n    <span class=\"swap-off\" aria-hidden=\"true\"><i data-lucide=\"sun\"></i></span>\n  </label>\n  <p class=\"pf-status\" aria-hidden=\"true\">\n    <span>sam@stockholm: ~/portfolio</span>\n    <span>main ✓ · utf-8 · 14:02</span>\n  </p>\n  <section class=\"pf-hero\" aria-label=\"Introduction\">\n    <div\n      class=\"shader pf-rain\"\n      data-variant=\"background\"\n      data-effect=\"matrix\"\n      data-size=\"18\"\n      data-rain=\"0.7\"\n      data-trail=\"0.7\"\n      data-speed=\"0.5\"\n      data-fps=\"30\"\n      aria-hidden=\"true\"\n    ></div>\n    <div class=\"pf-boot\">\n      <div class=\"mockup-code\" data-chrome=\"mac\" data-title=\"~/sam - zsh\" data-df-entrance=\"wipe\">\n        <pre data-prefix=\"$\"><code><span class=\"typewriter\"><span>whoami</span></span></code></pre>\n        <pre data-prefix=\">\" data-tone=\"success\"><code>Sam Lindqvist - infrastructure engineer, Stockholm</code></pre>\n        <pre data-prefix=\"$\"><code>cat now.txt</code></pre>\n        <pre data-prefix=\">\"><code>Making build pipelines boring at Globex. Maintaining tidewater and sqlite-cdc.</code></pre>\n        <pre data-prefix=\"$\"><code>uptime --career</code></pre>\n        <pre data-prefix=\">\" data-tone=\"warning\"><code>9 years, 0 pages at 3 a.m. this quarter</code></pre>\n      </div>\n      <header class=\"mk-resume-header\" data-variant=\"compact\">\n        <img\n          class=\"mk-resume-header-photo shape-hexagon\"\n          src=\"https://picsum.photos/id/1005/400/400\"\n          alt=\"Sam Lindqvist\"\n          data-df-entrance=\"spin\"\n        />\n        <div class=\"mk-resume-header-body\">\n          <h1 class=\"mk-resume-header-name\">sam.lindqvist</h1>\n          <p class=\"mk-resume-header-role\">Infrastructure engineer. I make deploys dull.</p>\n          <ul class=\"mk-resume-header-facts\">\n            <li><i data-lucide=\"map-pin\"></i> Stockholm, UTC+1</li>\n            <li\n              ><i data-lucide=\"code-xml\"></i>\n              <a href=\"https://github.com/\" target=\"_blank\" rel=\"noopener\">github.com/samlq</a></li\n            >\n            <li><i data-lucide=\"mail\"></i> <a href=\"mailto:sam@example.com\">sam@example.com</a></li>\n          </ul>\n        </div>\n      </header>\n    </div>\n  </section>\n  <div class=\"pf-page\">\n    <section aria-labelledby=\"pf-dev-repos\">\n      <h2 id=\"pf-dev-repos\">pinned</h2>\n      <div class=\"grid grid-cols-auto gap-4\">\n        <article class=\"mk-repository-item parallax-reveal\">\n          <div class=\"mk-repository-item-head\">\n            <i data-lucide=\"book-marked\"></i>\n            <h3 class=\"mk-repository-item-name\"\n              ><a href=\"#\"><span class=\"mk-repository-item-owner\">samlq/</span>tidewater</a></h3\n            >\n            <span class=\"badge\" data-variant=\"outline\">Public</span>\n          </div>\n          <p class=\"mk-repository-item-description\"\n            >Back-pressure for job queues - a queue that says no before the database does.</p\n          >\n          <ul class=\"mk-repository-item-topics\" aria-label=\"Topics\">\n            <li>queues</li>\n            <li>postgres</li>\n          </ul>\n          <ul class=\"mk-repository-item-stats\">\n            <li><span class=\"mk-repository-item-language\" data-language=\"go\"></span> Go</li>\n            <li><i data-lucide=\"star\"></i> 5.1k<span class=\"sr-only\"> stars</span></li>\n            <li><i data-lucide=\"git-fork\"></i> 290<span class=\"sr-only\"> forks</span></li>\n          </ul>\n        </article>\n        <article class=\"mk-repository-item parallax-reveal\">\n          <div class=\"mk-repository-item-head\">\n            <i data-lucide=\"book-marked\"></i>\n            <h3 class=\"mk-repository-item-name\"\n              ><a href=\"#\"><span class=\"mk-repository-item-owner\">samlq/</span>sqlite-cdc</a></h3\n            >\n            <span class=\"badge\" data-variant=\"outline\">Public</span>\n          </div>\n          <p class=\"mk-repository-item-description\"\n            >Change data capture for SQLite - stream every write to Kafka, NATS or a file.</p\n          >\n          <ul class=\"mk-repository-item-topics\" aria-label=\"Topics\">\n            <li>sqlite</li>\n            <li>cdc</li>\n          </ul>\n          <ul class=\"mk-repository-item-stats\">\n            <li><span class=\"mk-repository-item-language\" data-language=\"rust\"></span> Rust</li>\n            <li><i data-lucide=\"star\"></i> 1.9k<span class=\"sr-only\"> stars</span></li>\n            <li><i data-lucide=\"git-fork\"></i> 77<span class=\"sr-only\"> forks</span></li>\n          </ul>\n        </article>\n        <article class=\"mk-repository-item parallax-reveal\">\n          <div class=\"mk-repository-item-head\">\n            <i data-lucide=\"book-marked\"></i>\n            <h3 class=\"mk-repository-item-name\"\n              ><a href=\"#\"><span class=\"mk-repository-item-owner\">samlq/</span>dotfiles</a></h3\n            >\n            <span class=\"badge\" data-variant=\"outline\">Public</span>\n          </div>\n          <p class=\"mk-repository-item-description\">zsh, tmux and neovim - set up in one command on a fresh machine.</p>\n          <ul class=\"mk-repository-item-topics\" aria-label=\"Topics\">\n            <li>neovim</li>\n            <li>tmux</li>\n          </ul>\n          <ul class=\"mk-repository-item-stats\">\n            <li><span class=\"mk-repository-item-language\" data-language=\"shell\"></span> Shell</li>\n            <li><i data-lucide=\"star\"></i> 412<span class=\"sr-only\"> stars</span></li>\n          </ul>\n        </article>\n      </div>\n    </section>\n    <section aria-labelledby=\"pf-dev-activity\">\n      <h2 id=\"pf-dev-activity\">activity --last 12 months</h2>\n      <div class=\"pf-activity\">\n        <svg\n          viewBox=\"0 0 520 100\"\n          preserveAspectRatio=\"none\"\n          role=\"img\"\n          aria-label=\"Commits per month, rising from 40 to 140 over the year\"\n        >\n          <defs>\n            <linearGradient id=\"pf-dev-fill\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\">\n              <stop offset=\"0\" style=\"stop-color: var(--chart-1); stop-opacity: 0.35\" />\n              <stop offset=\"1\" style=\"stop-color: var(--chart-1); stop-opacity: 0\" />\n            </linearGradient>\n          </defs>\n          <path\n            d=\"M0 80 L47 72 L94 76 L141 60 L188 64 L235 48 L282 52 L329 38 L376 42 L423 26 L470 30 L520 12 L520 100 L0 100 Z\"\n            fill=\"url(#pf-dev-fill)\"\n          />\n          <path\n            d=\"M0 80 L47 72 L94 76 L141 60 L188 64 L235 48 L282 52 L329 38 L376 42 L423 26 L470 30 L520 12\"\n            fill=\"none\"\n            style=\"stroke: var(--chart-1)\"\n            stroke-width=\"2\"\n            vector-effect=\"non-scaling-stroke\"\n            stroke-linejoin=\"round\"\n          />\n        </svg>\n        <div class=\"pf-activity-axis\" aria-hidden=\"true\"\n          ><span>Nov 2025</span><span>May 2026</span><span>Oct 2026</span></div\n        >\n        <section class=\"mk-stats\" style=\"padding: 0\">\n          <div class=\"mk-stats-grid\" data-variant=\"cards\">\n            <div class=\"mk-stat\"\n              ><span class=\"mk-stat-value\">1,284</span><span class=\"mk-stat-label\">commits</span></div\n            >\n            <div class=\"mk-stat\"\n              ><span class=\"mk-stat-value\">312</span><span class=\"mk-stat-label\">pull requests merged</span></div\n            >\n            <div class=\"mk-stat\"\n              ><span class=\"mk-stat-value\">7.4k</span><span class=\"mk-stat-label\">stars across repos</span></div\n            >\n          </div>\n        </section>\n      </div>\n    </section>\n    <div class=\"pf-two\">\n      <section aria-labelledby=\"pf-dev-stack\">\n        <h2 id=\"pf-dev-stack\">stack</h2>\n        <div class=\"mk-skill-matrix\" data-variant=\"dots\">\n          <section class=\"mk-skill-matrix-group\" aria-label=\"Languages and systems\">\n            <ul class=\"mk-skill-matrix-list\">\n              <li class=\"mk-skill-matrix-skill\">\n                <label class=\"mk-skill-matrix-name\" for=\"pf-dev-go\">Go</label>\n                <meter class=\"mk-skill-matrix-level\" id=\"pf-dev-go\" min=\"0\" max=\"5\" value=\"5\">5 of 5</meter>\n                <span class=\"mk-skill-matrix-note\">8 yrs</span>\n              </li>\n              <li class=\"mk-skill-matrix-skill\">\n                <label class=\"mk-skill-matrix-name\" for=\"pf-dev-pg\">PostgreSQL</label>\n                <meter class=\"mk-skill-matrix-level\" id=\"pf-dev-pg\" min=\"0\" max=\"5\" value=\"5\">5 of 5</meter>\n                <span class=\"mk-skill-matrix-note\">9 yrs</span>\n              </li>\n              <li class=\"mk-skill-matrix-skill\">\n                <label class=\"mk-skill-matrix-name\" for=\"pf-dev-k8s\">Kubernetes</label>\n                <meter class=\"mk-skill-matrix-level\" id=\"pf-dev-k8s\" min=\"0\" max=\"5\" value=\"4\">4 of 5</meter>\n                <span class=\"mk-skill-matrix-note\">6 yrs</span>\n              </li>\n              <li class=\"mk-skill-matrix-skill\">\n                <label class=\"mk-skill-matrix-name\" for=\"pf-dev-rust\">Rust</label>\n                <meter class=\"mk-skill-matrix-level\" id=\"pf-dev-rust\" min=\"0\" max=\"5\" value=\"3\">3 of 5</meter>\n                <span class=\"mk-skill-matrix-note\">3 yrs</span>\n              </li>\n              <li class=\"mk-skill-matrix-skill\">\n                <label class=\"mk-skill-matrix-name\" for=\"pf-dev-nix\">Nix</label>\n                <meter class=\"mk-skill-matrix-level\" id=\"pf-dev-nix\" min=\"0\" max=\"5\" value=\"2\">2 of 5</meter>\n                <span class=\"mk-skill-matrix-note\">1 yr</span>\n              </li>\n            </ul>\n          </section>\n        </div>\n      </section>\n      <section aria-labelledby=\"pf-dev-log\">\n        <h2 id=\"pf-dev-log\">git log --career</h2>\n        <ol class=\"mk-resume-entries\" data-variant=\"timeline\">\n          <li class=\"mk-resume-entry\">\n            <span class=\"mk-resume-entry-mark\" aria-hidden=\"true\"></span>\n            <div class=\"mk-resume-entry-body\">\n              <div class=\"mk-resume-entry-head\">\n                <h3 class=\"mk-resume-entry-title\">Staff engineer, build and release</h3>\n                <p class=\"mk-resume-entry-org\"><a href=\"#\">Globex</a></p>\n                <p class=\"mk-resume-entry-when\"><time datetime=\"2022-01\">2022</time> - today</p>\n              </div>\n            </div>\n          </li>\n          <li class=\"mk-resume-entry\">\n            <span class=\"mk-resume-entry-mark\" aria-hidden=\"true\"></span>\n            <div class=\"mk-resume-entry-body\">\n              <div class=\"mk-resume-entry-head\">\n                <h3 class=\"mk-resume-entry-title\">Site reliability engineer</h3>\n                <p class=\"mk-resume-entry-org\"><a href=\"#\">Initech</a></p>\n                <p class=\"mk-resume-entry-when\"\n                  ><time datetime=\"2017-03\">2017</time> - <time datetime=\"2021-12\">2021</time></p\n                >\n              </div>\n            </div>\n          </li>\n          <li class=\"mk-resume-entry\">\n            <span class=\"mk-resume-entry-mark\" aria-hidden=\"true\"></span>\n            <div class=\"mk-resume-entry-body\">\n              <div class=\"mk-resume-entry-head\">\n                <h3 class=\"mk-resume-entry-title\">B.Sc. Computer Science</h3>\n                <p class=\"mk