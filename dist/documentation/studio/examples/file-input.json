olite\"></ul>\n</div>\n","individual":false},{"label":"Several images, nothing else","html":"<div class=\"file-drop\" data-max-files=\"4\" style=\"max-width: 32rem\">\n  <label class=\"file-drop-zone\">\n    <input class=\"file-drop-input\" type=\"file\" name=\"photos\" multiple accept=\"image/*\" />\n    <span class=\"file-drop-icon\" aria-hidden=\"true\">🖼️</span>\n    <span class=\"file-drop-title\">Add up to 4 photos</span>\n    <span class=\"file-drop-hint\">Any image format - drag several at once</span>\n  </label>\n  <p class=\"file-drop-error\"></p>\n  <ul class=\"file-drop-list\" aria-live=\"polite\"></ul>\n</div>\n","individual":false},{"label":"One document","html":"<div class=\"file-drop\" data-max-size=\"5000000\" style=\"max-width: 32rem\">\n  <label class=\"file-drop-zone\">\n    <input class=\"file-drop-input\" type=\"file\" name=\"cv\" accept=\".pdf,.doc,.docx,application/pdf\" />\n    <span class=\"file-drop-icon\" aria-hidden=\"true\"><i data-lucide=\"file-text\"></i></span>\n    <span class=\"file-drop-title\">Upload your CV</span>\n    <span class=\"file-drop-hint\">PDF or Word · max. 5 MB</span>\n  </label>\n  <p class=\"file-drop-error\"></p>\n  <ul class=\"file-drop-list\" aria-live=\"polite\"></ul>\n</div>\n","individual":false},{"label":"Compact drop zone","html":"<div class=\"file-drop\" data-size=\"sm\" style=\"max-width: 32rem\">\n  <label class=\"file-drop-zone\">\n    <input class=\"file-drop-input\" type=\"file\" name=\"attachments\" multiple />\n    <span class=\"file-drop-icon\" aria-hidden=\"true\"><i data-lucide=\"paperclip\"></i></span>\n    <span class=\"file-drop-title\">Attach files</span>\n    <span class=\"file-drop-hint\">Drop them here or click to choose</span>\n  </label>\n  <ul class=\"file-drop-list\" aria-live=\"polite\"></ul>\n</div>\n","individual":false},{"label":"Sizes","html":"<div class=\"flex items-center gap-4 mb-3\">\n  <span class=\"demo-label demo-label-w5\">Extra small</span>\n  <input class=\"file-input flex-1\" type=\"file\" data-size=\"xs\" aria-label=\"Upload xs\" style=\"max-width: 40rem\" />\n</div>\n<div class=\"flex items-center gap-4 mb-3\">\n  <span class=\"demo-label demo-label-w5\">Small</span>\n  <input class=\"file-input flex-1\" type=\"file\" data-size=\"sm\" aria-label=\"Upload sm\" style=\"max-width: 40rem\" />\n</div>\n<div class=\"flex items-center gap-4 mb-3\">\n  <span class=\"demo-label demo-label-w5\">Medium</span>\n  <input class=\"file-input flex-1\" type=\"file\" data-size=\"md\" aria-label=\"Upload md\" style=\"max-width: 40rem\" />\n</div>\n<div class=\"flex items-center gap-4 mb-3\">\n  <span class=\"demo-label demo-label-w5\">Large</span>\n  <input class=\"file-input flex-1\" type=\"file\" data-size=\"lg\" aria-label=\"Upload lg\" style=\"max-width: 40rem\" />\n</div>\n<div class=\"flex items-center gap-4 mb-3\">\n  <span class=\"demo-label demo-label-w5\">Extra large</span>\n  <input class=\"file-input flex-1\" type=\"file\" data-size=\"xl\" aria-label=\"Upload xl\" style=\"max-width: 40rem\" />\n</div>\n","individual":false}]
