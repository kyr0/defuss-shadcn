[{"label":"Fields","html":"<div class=\"workflow\" id=\"fields\" aria-label=\"Every field kind\" style=\"--workflow-height: 30rem\">\n  \n  \n</div>\n","individual":false},{"label":"Typed ports","html":"<div class=\"workflow\" id=\"ports\" aria-label=\"Typed ports\" style=\"--workflow-height: 22rem\">\n  \n</div>\n","individual":false},{"label":"Labels that follow the value","html":"<div class=\"grid gap-2\">\n  <div class=\"workflow\" id=\"alerts\" aria-label=\"Alert rules\" style=\"--workflow-height: 24rem\"></div>\n  <ol class=\"text-sm text-muted-foreground m-0 ps-5\" id=\"alerts-log\" aria-live=\"polite\">\n    <li>Change a field - each change lands here.</li>\n  </ol>\n</div>\n","individual":false},{"label":"Lines and labels by type","html":"<div class=\"grid gap-2\">\n  <div class=\"toolbar flex-wrap\" role=\"toolbar\" aria-label=\"Connections\">\n    <button class=\"btn\" data-size=\"sm\" type=\"button\" data-workflow-for=\"links\" data-workflow-action=\"run\">Run</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"links-flag\"\n      >Flag the selected connection</button\n    >\n    <span class=\"text-sm text-muted-foreground\" id=\"links-said\" aria-live=\"polite\">Click a label.</span>\n  </div>\n  <div class=\"grid gap-2\" style=\"grid-template-columns: minmax(0, 1fr) minmax(12rem, 16rem)\">\n    <div class=\"workflow\" id=\"links\" aria-label=\"Connection types\" style=\"--workflow-height: 22rem\"></div>\n    <div class=\"card\">\n      <div\n        class=\"card-content\"\n        style=\"max-block-size: 22rem; overflow: auto\"\n        data-workflow-for=\"links\"\n        data-workflow-outlet=\"inspector\"\n      ></div>\n    </div>\n  </div>\n</div>\n","individual":false},{"label":"A color swatch body","html":"<div class=\"workflow\" id=\"custom\" aria-label=\"A custom card body\" style=\"--workflow-height: 18rem\"></div>\n","individual":false}]
