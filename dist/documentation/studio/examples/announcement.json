[{"label":"Announcement (floating, open)","html":"<dialog class=\"mk-announcement\" data-variant=\"floating\" open aria-labelledby=\"ann-4\">\n  <div class=\"mk-announcement-inner\">\n    <i data-lucide=\"sparkles\"></i>\n    <p id=\"ann-4\">You can now share spaces with guests.</p>\n    <a href=\"#\">Try it</a>\n    <form method=\"dialog\"\n      ><button class=\"mk-announcement-close\" aria-label=\"Dismiss tip\"><i data-lucide=\"x\"></i></button\n    ></form>\n  </div>\n</dialog>\n","individual":true},{"label":"Bar","html":"<dialog class=\"mk-announcement\" open aria-labelledby=\"ann-1\">\n  <div class=\"mk-announcement-inner\">\n    <span class=\"mk-announcement-tag\">New</span>\n    <p id=\"ann-1\">Acme 4.0 is here - offline sync for every workspace.</p>\n    <a href=\"#\">Read the release notes <i data-lucide=\"arrow-right\"></i></a>\n    <form method=\"dialog\"\n      ><button class=\"mk-announcement-close\" aria-label=\"Dismiss announcement\"><i data-lucide=\"x\"></i></button\n    ></form>\n  </div>\n</dialog>\n","individual":true},{"label":"Primary","html":"<dialog class=\"mk-announcement\" data-variant=\"primary\" open aria-labelledby=\"ann-2\">\n  <div class=\"mk-announcement-inner\">\n    <i data-lucide=\"calendar\"></i>\n    <p id=\"ann-2\">Acme Summit · 12–13 November, Lisbon. Early-bird ends Friday.</p>\n    <a href=\"#\">Get tickets <i data-lucide=\"arrow-right\"></i></a>\n    <form method=\"dialog\"\n      ><button class=\"mk-announcement-close\" aria-label=\"Dismiss summit announcement\"><i data-lucide=\"x\"></i></button\n    ></form>\n  </div>\n</dialog>\n","individual":true},{"label":"Inline","html":"<dialog class=\"mk-announcement\" data-variant=\"inline\" open aria-labelledby=\"ann-3\">\n  <div class=\"mk-announcement-inner\">\n    <i data-lucide=\"info\"></i>\n    <p id=\"ann-3\"\n      ><strong>Scheduled maintenance</strong> on Sunday 5 Oct, 02:00–03:00 UTC. Sync pauses for up to ten minutes.</p\n    >\n    <a href=\"#\">Status page</a>\n    <form method=\"dialog\"\n      ><button class=\"mk-announcement-close\" aria-label=\"Dismiss maintenance notice\"><i data-lucide=\"x\"></i></button\n    ></form>\n  </div>\n</dialog>\n","individual":true},{"label":"Floating","html":"<div\n  style=\"\n    position: relative;\n    height: 12rem;\n    width: 100%;\n    overflow: hidden;\n    border: 1px dashed var(--border);\n    border-radius: var(--radius-lg);\n    transform: translateZ(0);\n  \"\n>\n  <p style=\"margin: 1rem; color: var(--muted-foreground)\">Page content…</p>\n  <dialog class=\"mk-announcement\" data-variant=\"floating\" open aria-labelledby=\"ann-4\">\n    <div class=\"mk-announcement-inner\">\n      <i data-lucide=\"sparkles\"></i>\n      <p id=\"ann-4\">You can now share spaces with guests.</p>\n      <a href=\"#\">Try it</a>\n      <form method=\"dialog\"\n        ><button class=\"mk-announcement-close\" aria-label=\"Dismiss tip\"><i data-lucide=\"x\"></i></button\n      ></form>\n    </div>\n  </dialog>\n</div>\n","individual":false}]
