[{"label":"Ines Duarte, photographer","html":"<style>\n  #pf-photographer {\n    --background: oklch(0.12 0 0);\n    --foreground: oklch(0.95 0 0);\n    --card: oklch(0.17 0 0);\n    --card-foreground: var(--foreground);\n    --muted: oklch(0.2 0 0);\n    --muted-foreground: oklch(0.68 0 0);\n    --border: oklch(0.28 0 0);\n    --input: var(--border);\n    --primary: oklch(0.95 0 0);\n    --primary-foreground: oklch(0.12 0 0);\n    --secondary: oklch(0.22 0 0);\n    --secondary-foreground: var(--foreground);\n    --accent: oklch(0.22 0 0);\n    --accent-foreground: var(--foreground);\n    --ring: oklch(0.8 0.1 70);\n    color-scheme: dark;\n    display: flex;\n    flex-direction: column;\n    gap: clamp(3.5rem, 8vw, 6rem);\n    box-sizing: border-box;\n    width: 100%;\n    background: var(--background);\n    color: var(--foreground);\n    font-family: var(--font-sans);\n  }\n  #pf-photographer .pf-inner {\n    display: flex;\n    flex-direction: column;\n    gap: clamp(3.5rem, 8vw, 6rem);\n    box-sizing: border-box;\n    width: 100%;\n    max-width: 78rem;\n    margin-inline: auto;\n    padding-inline: clamp(1rem, 4vw, 2.5rem);\n  }\n  #pf-photographer .pf-opening {\n    height: min(88dvh, 44rem);\n    color: #fff;\n  }\n  #pf-photographer .pf-opening img {\n    filter: brightness(0.72) contrast(1.05);\n  }\n  #pf-photographer .pf-opening h1 {\n    margin: 0;\n    font-family: var(--font-serif);\n    font-size: clamp(3rem, 1rem + 10vw, 9rem);\n    font-weight: 300;\n    letter-spacing: 0.04em;\n    line-height: 0.95;\n    text-align: center;\n    text-shadow: 0 4px 40px rgb(0 0 0 / 0.5);\n  }\n  #pf-photographer .pf-opening p {\n    margin: 1.25rem 0 0;\n    font-size: 0.8125rem;\n    letter-spacing: 0.35em;\n    text-align: center;\n    text-transform: uppercase;\n    text-shadow: 0 2px 12px rgb(0 0 0 / 0.6);\n  }\n  #pf-photographer .pf-label {\n    margin: 0 0 1.5rem;\n    font-size: 0.75rem;\n    font-weight: 600;\n    letter-spacing: 0.28em;\n    text-transform: uppercase;\n    color: var(--muted-foreground);\n  }\n  #pf-photographer .mk-resume-header {\n    align-items: center;\n  }\n  #pf-photographer .mk-resume-header-photo {\n    width: clamp(7rem, 18vw, 11rem);\n    height: auto;\n    aspect-ratio: 1;\n    border-radius: 50%;\n  }\n  #pf-photographer .mk-resume-header-role {\n    max-width: 40rem;\n    font-family: var(--font-serif);\n    font-size: clamp(1.375rem, 1rem + 1.5vw, 2rem);\n    font-weight: 300;\n    line-height: 1.3;\n  }\n  #pf-photographer .mk-portfolio-grid-title {\n    font-family: var(--font-serif);\n    font-weight: 400;\n  }\n  #pf-photographer .pf-edit {\n    display: grid;\n    gap: 0.75rem;\n    margin: 0;\n  }\n  #pf-photographer .pf-edit figcaption {\n    color: var(--muted-foreground);\n  }\n  #pf-photographer .pf-clients {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: center;\n    gap: 1rem 2.5rem;\n    margin: 0;\n    padding: 0;\n    list-style: none;\n    font-family: var(--font-serif);\n    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);\n    font-style: italic;\n    color: var(--muted-foreground);\n  }\n  #pf-photographer .pf-contact {\n    padding: 5rem 0 3rem;\n    background: var(--card);\n    --shape-edge: 2rem;\n  }\n  /* light or dark: the Swap writes the page's dark class - every look has a light and a dark palette */\n  #pf-photographer .site-mode {\n    flex: none;\n    border: 1px solid var(--input);\n    border-radius: var(--radius-md);\n    background: var(--background);\n    color: var(--foreground);\n  }\n  #pf-photographer .site-mode:hover {\n    background: var(--accent);\n    color: var(--accent-foreground);\n  }\n  #pf-photographer {\n    position: relative;\n  }\n  #pf-photographer > .site-mode {\n    position: absolute;\n    z-index: 20;\n    inset: var(--site-mode-top, 0.75rem) clamp(0.75rem, 2vw, 1.25rem) auto auto;\n  }\n  /* -- modes: each look in light and dark, derived from the palettes above (the other mode of each look) -- */\n  .dark #pf-photographer {\n    --accent: oklch(0.24 0 0);\n  }\n  :root:not(.dark) #pf-photographer {\n    color-scheme: light;\n    --background: oklch(0.985 0 0);\n    --foreground: oklch(0.2 0 0);\n    --card: oklch(0.997 0 0);\n    --card-foreground: oklch(0.2 0 0);\n    --muted: oklch(0.95 0 0);\n    --muted-foreground: oklch(0.46 0 0);\n    --border: oklch(0.9 0 0);\n    --input: oklch(0.88 0 0);\n    --primary: oklch(0.2 0 0);\n    --primary-foreground: oklch(0.985 0.005 0);\n    --secondary: oklch(0.955 0 0);\n    --secondary-foreground: oklch(0.25 0 0);\n    --accent: oklch(0.94 0 0);\n    --accent-foreground: oklch(0.2 0 0);\n    --ring: oklch(0.55 0.1 70);\n    --popover: oklch(0.997 0 0);\n    --popover-foreground: oklch(0.2 0 0);\n  }\n  /* -- modes: end -- */\n</style>\n<div id=\"pf-photographer\">\n  <label class=\"swap site-mode\" data-variant=\"rotate\" data-size=\"sm\">\n    <input type=\"checkbox\" data-site-mode aria-label=\"Dark mode\" />\n    <span class=\"swap-on\" aria-hidden=\"true\"><i data-lucide=\"moon\"></i></span>\n    <span class=\"swap-off\" aria-hidden=\"true\"><i data-lucide=\"sun\"></i></span>\n  </label>\n  <section class=\"parallax pf-opening\" aria-label=\"Ines Duarte, photographer\">\n    <div class=\"parallax-layer\" data-depth=\"far\"><img src=\"https://picsum.photos/id/1036/1800/1200\" alt=\"\" /></div>\n    <div class=\"parallax-layer\" style=\"--parallax-speed: -12%; z-index: 0\">\n      <div>\n        <h1 data-df-entrance=\"blur\">Ines Duarte</h1>\n        <p data-df-entrance=\"fade\" style=\"--df-motion-delay: 400ms\">Landscape &amp; architecture · Lisbon</p>\n      </div>\n    </div>\n  </section>\n  <div class=\"pf-inner\">\n    <header class=\"mk-resume-header\">\n      <img\n        class=\"mk-resume-header-photo\"\n        src=\"https://picsum.photos/id/823/500/500\"\n        alt=\"Ines Duarte\"\n        data-df-entrance=\"iris\"\n      />\n      <div class=\"mk-resume-header-body\">\n        <p class=\"mk-resume-header-role\"\n          >I photograph places at the hour nobody is there - and the buildings that wait for people.</p\n        >\n        <ul class=\"mk-resume-header-facts\">\n          <li><i data-lucide=\"camera\"></i> Hasselblad X2D, Leica Q3</li>\n          <li><i data-lucide=\"award\"></i> Sony World Photography Awards, shortlist 2025</li>\n          <li><i data-lucide=\"mail\"></i> <a href=\"mailto:ines@example.com\">ines@example.com</a></li>\n        </ul>\n      </div>\n    </header>\n    <section aria-labelledby=\"pf-photo-recent\">\n      <h2 class=\"pf-label\" id=\"pf-photo-recent\">Recent</h2>\n      <ul class=\"mk-portfolio-grid\" data-variant=\"masonry\">\n        <li class=\"mk-portfolio-grid-item parallax-reveal\" data-reveal=\"zoom\">\n          <a class=\"mk-portfolio-grid-link\" href=\"#\">\n            <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/1031/600/840\" alt=\"\" />\n            <span class=\"mk-portfolio-grid-caption\">\n              <strong class=\"mk-portfolio-grid-title\">Glass and fog</strong>\n              <span class=\"mk-portfolio-grid-meta\">Porto, 2026</span>\n            </span>\n          </a>\n        </li>\n        <li class=\"mk-portfolio-grid-item parallax-reveal\" data-reveal=\"zoom\">\n          <a class=\"mk-portfolio-grid-link\" href=\"#\">\n            <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/1015/600/420\" alt=\"\" />\n            <span class=\"mk-portfolio-grid-caption\">\n              <strong class=\"mk-portfolio-grid-title\">Above the fjord</strong>\n              <span class=\"mk-portfolio-grid-meta\">Lysefjord, 2026</span>\n            </span>\n          </a>\n        </li>\n        <li class=\"mk-portfolio-grid-item parallax-reveal\" data-reveal=\"zoom\">\n          <a class=\"mk-portfolio-grid-link\" href=\"#\">\n            <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/949/600/600\" alt=\"\" />\n            <span class=\"mk-portfolio-grid-caption\">\n              <strong class=\"mk-portfolio-grid-title\">White spiral</strong>\n              <span class=\"mk-portfolio-grid-meta\">New York, 2025</span>\n            </span>\n          </a>\n        </li>\n        <li class=\"mk-portfolio-grid-item parallax-reveal\" data-reveal=\"zoom\">\n          <a class=\"mk-portfolio-grid-link\" href=\"#\">\n            <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/1050/600/440\" alt=\"\" />\n            <span class=\"mk-portfolio-grid-caption\">\n              <strong class=\"mk-portfolio-grid-title\">Before the tide</strong>\n              <span class=\"mk-portfolio-grid-meta\">Algarve, 2025</span>\n            </span>\n          </a>\n        </li>\n        <li class=\"mk-portfolio-grid-item parallax-reveal\" data-reveal=\"zoom\">\n          <a class=\"mk-portfolio-grid-link\" href=\"#\">\n            <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/1081/600/780\" alt=\"\" />\n            <span class=\"mk-portfolio-grid-caption\">\n              <strong class=\"mk-portfolio-grid-title\">Steps of light</strong>\n              <span class=\"mk-portfolio-grid-meta\">Siza, 2024</span>\n            </span>\n          </a>\n        </li>\n        <li class=\"mk-portfolio-grid-item parallax-reveal\" data-reveal=\"zoom\">\n          <a class=\"mk-portfolio-grid-link\" href=\"#\">\n            <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/1018/600/400\" alt=\"\" />\n            <span class=\"mk-portfolio-grid-caption\">\n              <strong class=\"mk-portfolio-grid-title\">The green road</strong>\n              <span class=\"mk-portfolio-grid-meta\">Skye, 2024</span>\n            </span>\n          </a>\n        </li>\n      </ul>\n    </section>\n    <section aria-labelledby=\"pf-photo-edit\">\n      <h2 class=\"pf-label\" id=\"pf-photo-edit\">The edit</h2>\n      <figure class=\"pf-edit\">\n        <div class=\"diff\" data-ratio=\"7/4\">\n          <div class=\"diff-item-1\">\n            <img src=\"https://picsum.photos/id/1048/1400/800\" alt=\"After: the graded frame, glass and sky in colour\" />\n            <span class=\"diff-label\">Graded</span>\n          </div>\n          <div class=\"diff-item-2\">\n            <img src=\"https://picsum.photos/id/1048/1400/800?grayscale\" alt=\"Before: the raw frame, flat and grey\" />\n            <span class=\"diff-label\">Raw</span>\n          </div>\n          <input\n            class=\"diff-range\"\n            type=\"range\"\n            min=\"0\"\n            max=\"100\"\n            value=\"50\"\n            step=\"0.1\"\n            aria-label=\"Divider position: drag to compare the graded and the raw frame\"\n          />\n        </div>\n        <figcaption>Towers, Lisbon - the print and the raw frame, side by side.</figcaption>\n      </figure>\n    </section>\n    <section aria-labelledby=\"pf-photo-series\">\n      <h2 class=\"pf-label\" id=\"pf-photo-series\">Series</h2>\n      <ul class=\"mk-portfolio-grid\" data-variant=\"strip\">\n        <li class=\"mk-portfolio-grid-item\">\n          <a class=\"mk-portfolio-grid-link\" href=\"#\">\n            <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/954/640/800\" alt=\"\" />\n            <span class=\"mk-portfolio-grid-caption\">\n              <strong class=\"mk-portfolio-grid-title\">Empty Rooms</strong>\n              <span class=\"mk-portfolio-grid-meta\">24 photographs</span>\n            </span>\n          </a>\n        </li>\n        <li class=\"mk-portfolio-grid-item\">\n          <a class=\"mk-portfolio-grid-link\" href=\"#\">\n            <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/1016/640/800\" alt=\"\" />\n            <span class=\"mk-portfolio-grid-caption\">\n              <strong class=\"mk-portfolio-grid-title\">Red Earth</strong>\n              <span class=\"mk-portfolio-grid-meta\">31 photographs</span>\n            </span>\n          </a>\n        </li>\n        <li class=\"mk-portfolio-grid-item\">\n          <a class=\"mk-portfolio-grid-link\" href=\"#\">\n            <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/983/640/800\" alt=\"\" />\n            <span class=\"mk-portfolio-grid-caption\">\n              <strong class=\"mk-portfolio-grid-title\">Brutal Lisbon</strong>\n              <span class=\"mk-portfolio-grid-meta\">18 photographs</span>\n            </span>\n          </a>\n        </li>\n        <li class=\"mk-portfolio-grid-item\">\n          <a class=\"mk-portfolio-grid-link\" href=\"#\">\n            <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/1078/640/800\" alt=\"\" />\n            <span class=\"mk-portfolio-grid-caption\">\n              <strong class=\"mk-portfolio-grid-title\">Night Shift</strong>\n              <span class=\"mk-portfolio-grid-meta\">40 photographs</span>\n            </span>\n          </a>\n        </li>\n      </ul>\n    </section>\n    <section aria-label=\"Published in\">\n      <ul class=\"pf-clients\">\n        <li>Monocle</li>\n        <li>Wallpaper*</li>\n        <li>The New York Times</li>\n        <li>Dezeen</li>\n        <li>Público</li>\n      </ul>\n    </section>\n  </div>\n  <section class=\"pf-contact edge-wave-top\" aria-label=\"Contact\">\n    <div class=\"pf-inner\">\n      <aside class=\"mk-availability\" data-variant=\"banner\" aria-labelledby=\"pf-photo-hire\">\n        <p class=\"mk-availability-status\"\n          ><span class=\"indicator-dot\" data-variant=\"success\" aria-hidden=\"true\"></span> Booking 2027</p\n        >\n        <p class=\"mk-availability-title\" id=\"pf-photo-hire\">Commissions, licensing and prints</p>\n        <div class=\"mk-availability-actions\">\n          <a class=\"btn\" data-size=\"sm\" href=\"mailto:ines@example.com\">Request a quote</a>\n        </div>\n      </aside>\n    </div>\n  </section>\n</div>\n","individual":false}]
