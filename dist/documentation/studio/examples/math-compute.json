[{"label":"Simplify, and what it holds under","html":"<section class=\"math-compute\" aria-label=\"Simplify a rational expression\">\n  <label class=\"label\" for=\"cancel-source\">Expression</label>\n  <textarea class=\"math-compute-source\" id=\"cancel-source\">\\frac{x^2-1}{x-1}</textarea>\n  <div class=\"math-compute-tools\">\n    <select class=\"select\" data-math-operation aria-label=\"Operation\">\n      <option value=\"simplify\" selected>Simplify</option>\n      <option value=\"evaluate\">Evaluate</option>\n      <option value=\"approximate\">Approximate</option>\n      <option value=\"solve\">Solve for x</option>\n      <option value=\"differentiate\">Differentiate</option>\n      <option value=\"canonicalize\">Canonical form</option>\n      <option value=\"inspect\">Inspect</option>\n    </select>\n    <button class=\"btn\" type=\"button\" data-math-run>Compute</button>\n    <button class=\"btn\" type=\"button\" data-variant=\"outline\" data-math-cancel>Cancel</button>\n  </div>\n</section>\n","individual":true},{"label":"An extraneous root","html":"<section class=\"math-compute\" aria-label=\"Solve a radical equation\">\n  <label class=\"label\" for=\"radical-source\">Equation</label>\n  <textarea class=\"math-compute-source\" id=\"radical-source\">\\sqrt{x+1}=x-1</textarea>\n  <div class=\"math-compute-tools\">\n    <button class=\"btn\" type=\"button\" data-math-run>Solve for x</button>\n  </div>\n  \n</section>\n","individual":true},{"label":"√(x²) where x > 0","html":"<section class=\"math-compute\" aria-label=\"Simplify under an assumption\">\n  <label class=\"label\" for=\"assume-source\">Expression</label>\n  <textarea class=\"math-compute-source\" id=\"assume-source\">\\sqrt{x^2}</textarea>\n  <div class=\"math-compute-tools\"\n    ><button class=\"btn\" type=\"button\" data-math-run>Simplify, assuming x &gt; 0</button></div\n  >\n  \n</section>\n","individual":true},{"label":"Differentiated once, shown without the engine","html":"<section class=\"math-compute\" aria-label=\"A recorded derivative\">\n  <label class=\"label\" for=\"recorded-source\">Expression</label>\n  <textarea class=\"math-compute-source\" id=\"recorded-source\">x^3\\sin(x)</textarea>\n  <div class=\"math-compute-tools\"><button class=\"btn\" type=\"button\" data-math-run>Differentiate again</button></div>\n  \n</section>\n","individual":true},{"label":"Stopped after half a second","html":"<section class=\"math-compute\" aria-label=\"A computation past its deadline\" data-timeout=\"500\">\n  <label class=\"label\" for=\"slow-source\">Expression</label>\n  <textarea class=\"math-compute-source\" id=\"slow-source\">200000!</textarea>\n  <div class=\"math-compute-tools\">\n    <button class=\"btn\" type=\"button\" data-math-run>Evaluate</button>\n    <button class=\"btn\" type=\"button\" data-variant=\"outline\" data-math-cancel>Cancel</button>\n  </div>\n  \n</section>\n","individual":true},{"label":"Proven, and undecided","html":"<div style=\"display: grid; gap: 1rem\">\n  <section class=\"math-compute\" aria-label=\"Compare as an identity\">\n    <label class=\"label\" for=\"id-left\">Left</label>\n    <textarea class=\"math-compute-source\" id=\"id-left\">(x+1)^2</textarea>\n    <label class=\"label\" for=\"id-right\">Right</label>\n    <input class=\"input\" id=\"id-right\" data-math-right value=\"x^2+2x+1\" />\n    <div class=\"math-compute-tools\"\n      ><button class=\"btn\" type=\"button\" data-math-run>Compare as an identity</button></div\n    >\n    \n  </section>\n  <section class=\"math-compute\" aria-label=\"Compare by value\">\n    <label class=\"label\" for=\"value-left\">Left</label>\n    <textarea class=\"math-compute-source\" id=\"value-left\">\\sin(x)^2+\\cos(x)^2</textarea>\n    <label class=\"label\" for=\"value-right\">Right</label>\n    <input class=\"input\" id=\"value-right\" data-math-right value=\"1\" />\n    <div class=\"math-compute-tools\"><button class=\"btn\" type=\"button\" data-math-run>Compare by value</button></div>\n    \n  </section>\n</div>\n","individual":false}]
