[{"label":"Europe, labelled","html":"<div\n  class=\"geo-map\"\n  aria-label=\"The countries of Europe\"\n  data-focus=\"continent:Europe\"\n  data-callouts=\"true\"\n  data-highlight=\"lift\"\n  style=\"--geo-map-height: 36rem\"\n></div>\n","individual":false},{"label":"Germany, labelled","html":"<div\n  class=\"geo-map\"\n  aria-label=\"The states of Germany\"\n  data-focus=\"country:DEU\"\n  data-callouts=\"true\"\n  data-highlight=\"outline\"\n  data-palette=\"forest\"\n  style=\"--geo-map-height: 30rem\"\n></div>\n","individual":false},{"label":"Large callouts","html":"<div\n  class=\"geo-map\"\n  aria-label=\"The states of Austria\"\n  data-focus=\"country:AUT\"\n  data-callouts=\"true\"\n  data-palette=\"ocean\"\n  style=\"--geo-map-height: 26rem; --geo-map-callout-size: 1.125rem; --geo-map-callout-width: 13rem\"\n></div>\n","individual":false},{"label":"Callouts on and off","html":"<div class=\"grid gap-3\">\n  <div class=\"switch-item flex items-center gap-2\">\n    <input\n      class=\"switch\"\n      type=\"checkbox\"\n      role=\"switch\"\n      id=\"labels-on\"\n      checked\n      data-geo-for=\"labelled\"\n      data-geo-param=\"callouts\"\n    />\n    <label for=\"labels-on\">Callouts</label>\n  </div>\n  <div\n    class=\"geo-map\"\n    id=\"labelled\"\n    aria-label=\"South America\"\n    data-callouts=\"true\"\n    data-center=\"-60,-20\"\n    data-zoom=\"2.6\"\n    data-palette=\"sunset\"\n  ></div>\n</div>\n","individual":false}]
