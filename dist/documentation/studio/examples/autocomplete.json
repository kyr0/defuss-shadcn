[{"label":"Local records","html":"<div\n  class=\"autocomplete\"\n  id=\"ac-langs\"\n  data-label-field=\"name\"\n  data-match=\"startsWith\"\n  data-sort=\"name:asc\"\n  data-debounce=\"0\"\n  data-page-size=\"12\"\n  style=\"max-width: 22rem\"\n>\n  <label class=\"label\" for=\"ac-langs-input\">Language</label>\n  <input class=\"input autocomplete-input\" id=\"ac-langs-input\" type=\"text\" placeholder=\"Type a letter…\" />\n</div>\n","individual":true},{"label":"A live API","html":"<div\n  class=\"autocomplete\"\n  id=\"ac-geo\"\n  data-label-field=\"name\"\n  data-debounce=\"300\"\n  data-min-chars=\"2\"\n  style=\"max-width: 26rem\"\n>\n  <label class=\"label\" for=\"ac-geo-input\">City (live)</label>\n  <input class=\"input autocomplete-input\" id=\"ac-geo-input\" type=\"text\" placeholder=\"Try 'Lisb'…\" />\n</div>\n","individual":true},{"label":"A remote source - debounced, cancelled, paged","html":"<div class=\"flex flex-col gap-2\" style=\"max-width: 26rem\">\n  <div\n    class=\"autocomplete\"\n    id=\"ac-places\"\n    data-label-field=\"name\"\n    data-debounce=\"250\"\n    data-page-size=\"20\"\n    data-empty-text=\"No place like that.\"\n  >\n    <label class=\"label\" for=\"ac-places-input\">Place</label>\n    <input\n      class=\"input autocomplete-input\"\n      id=\"ac-places-input\"\n      type=\"text\"\n      value=\"new\"\n      placeholder=\"Search 96,000 places…\"\n    />\n  </div>\n  <p class=\"text-sm text-muted-foreground m-0\" id=\"ac-places-log\" aria-live=\"polite\">No request yet.</p>\n</div>\n","individual":false},{"label":"Your own network client","html":"<div class=\"flex flex-col gap-2\" style=\"max-width: 26rem\">\n  <div\n    class=\"autocomplete\"\n    id=\"ac-users\"\n    data-url=\"/api/users\"\n    data-label-field=\"name\"\n    data-sort=\"name:asc\"\n    data-debounce=\"200\"\n    data-page-size=\"15\"\n  >\n    <label class=\"label\" for=\"ac-users-input\">Teammate</label>\n    <input class=\"input autocomplete-input\" id=\"ac-users-input\" type=\"text\" placeholder=\"Search 5,000 teammates…\" />\n  </div>\n  <p\n    class=\"text-sm text-muted-foreground m-0\"\n    id=\"ac-users-url\"\n    aria-live=\"polite\"\n    style=\"font-family: var(--font-mono)\"\n  ></p>\n</div>\n","individual":false},{"label":"In a form","html":"<form class=\"flex flex-col gap-3\" id=\"ac-form\" style=\"max-width: 24rem\">\n  <div\n    class=\"autocomplete\"\n    id=\"ac-country\"\n    data-label-field=\"name\"\n    data-value-field=\"code\"\n    data-sort=\"name:asc\"\n    data-debounce=\"0\"\n  >\n    <label class=\"label\" for=\"ac-country-input\">Country</label>\n    <input class=\"input autocomplete-input\" id=\"ac-country-input\" type=\"text\" placeholder=\"Search countries…\" />\n    <input type=\"hidden\" name=\"country\" class=\"autocomplete-value\" />\n  </div>\n  <button class=\"btn\" type=\"submit\" style=\"align-self: flex-start\">Submit</button>\n  <output class=\"text-sm text-muted-foreground\" id=\"ac-form-out\">country = (none)</output>\n</form>\n","individual":false},{"label":"Empty and error","html":"<div class=\"flex flex-wrap gap-4\">\n  <div\n    class=\"autocomplete\"\n    id=\"ac-none\"\n    data-debounce=\"0\"\n    data-empty-text=\"Nothing in this list.\"\n    style=\"flex: 1; min-width: 12rem\"\n  >\n    <label class=\"label\" for=\"ac-none-input\">Empty list</label>\n    <input class=\"input autocomplete-input\" id=\"ac-none-input\" type=\"text\" placeholder=\"Type anything…\" />\n  </div>\n  <div class=\"autocomplete\" id=\"ac-down\" data-debounce=\"0\" style=\"flex: 1; min-width: 12rem\">\n    <label class=\"label\" for=\"ac-down-input\">Broken source</label>\n    <input class=\"input autocomplete-input\" id=\"ac-down-input\" type=\"text\" placeholder=\"Type anything…\" />\n  </div>\n</div>\n","individual":false}]
