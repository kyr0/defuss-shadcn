[{"label":"A blog front","html":"<div id=\"site-blog\" data-i18n-component style=\"display: flex; flex-direction: column; gap: 2.5rem; width: 100%\">\n  <div class=\"flex justify-end\">\n    <select\n      class=\"select\"\n      data-size=\"sm\"\n      data-app-locale\n      aria-label=\"Language\"\n      data-i18n-aria-label-en=\"Language\"\n      data-i18n-aria-label-de=\"Sprache\"\n      style=\"width: auto\"\n    >\n      <option value=\"en\" lang=\"en\">English</option>\n      <option value=\"de\" lang=\"de\">Deutsch</option>\n    </select>\n  </div>\n  <header class=\"mk-blog-header\">\n    <div class=\"mk-blog-header-copy\">\n      <span class=\"mk-blog-header-eyebrow\" data-i18n-target=\"eyebrow\">The Acme Blog</span>\n      <h1 class=\"mk-blog-header-title\" data-i18n-target=\"title\">Notes on building calm software</h1>\n      <p class=\"mk-blog-header-desc\" data-i18n-target=\"desc\"\n        >Essays on product, engineering and design - one post a week, no hot takes.</p\n      >\n    </div>\n    <nav\n      class=\"mk-blog-header-categories\"\n      aria-label=\"Categories\"\n      data-i18n-aria-label-en=\"Categories\"\n      data-i18n-aria-label-de=\"Kategorien\"\n    >\n      <a href=\"#/\" data-router-link aria-current=\"page\"><span data-i18n-target=\"cat-all\">All posts</span></a>\n      <a href=\"#/category/engineering\" data-router-link><span data-i18n-target=\"cat-engineering\">Engineering</span></a>\n      <a href=\"#/category/design\" data-router-link>Design</a>\n      <a href=\"#/category/company\" data-router-link><span data-i18n-target=\"cat-company\">Company</span></a>\n    </nav>\n  </header>\n  <div style=\"display: flex; flex-wrap: wrap; gap: 2.5rem; align-items: flex-start\">\n    <div style=\"flex: 999 1 30rem; display: flex; flex-direction: column; gap: 2rem; min-width: 0\">\n      <article class=\"mk-blog-item\" data-category=\"company\" data-month=\"2026-10\" data-variant=\"featured\">\n        <figure class=\"mk-blog-item-media\"\n          ><img src=\"images/mk-wide3.png\" alt=\"The Acme team at their offsite\"\n        /></figure>\n        <div class=\"mk-blog-item-body\">\n          <div class=\"mk-blog-item-meta\"\n            ><span class=\"badge\" data-variant=\"secondary\" data-i18n-target=\"post-0-cat\">Company</span\n            ><span data-i18n-target=\"post-0-read\">12 min read</span></div\n          >\n          <h3 class=\"mk-blog-item-title\"><a href=\"#\">Ten years of Acme: what we got right</a></h3>\n          <p class=\"mk-blog-item-excerpt\">A long look back at a decade of building calm software.</p>\n          <div class=\"mk-blog-item-byline\">\n            <span class=\"avatar\" data-size=\"sm\"><img class=\"avatar-image\" src=\"images/mk-portrait.png\" alt=\"\" /></span>\n            <span class=\"mk-blog-item-author\">Aron Homberg</span>\n            <time data-i18n-target=\"date-1\" class=\"mk-blog-item-date\" datetime=\"2026-10-01\"\n              ><span data-i18n-value=\"d1001\">1 Oct 2026</span></time\n            >\n          </div>\n        </div>\n      </article>\n      <p class=\"text-sm text-muted-foreground\" data-blog-empty data-i18n-target=\"empty\" hidden\n        >No posts of this demo match.</p\n      >\n      <div style=\"display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 2rem\">\n        <article class=\"mk-blog-item\" data-category=\"engineering\" data-month=\"2026-10\">\n          <figure class=\"mk-blog-item-media\"\n            ><img src=\"images/mk-wide.png\" alt=\"A whiteboard full of sketches\"\n          /></figure>\n          <div class=\"mk-blog-item-body\">\n            <div class=\"mk-blog-item-meta\"\n              ><span class=\"badge\" data-variant=\"secondary\" data-i18n-target=\"post-1-cat\">Engineering</span\n              ><span data-i18n-target=\"post-1-read\">8 min read</span></div\n            >\n            <h3 class=\"mk-blog-item-title\"><a href=\"#\">How offline sync works in Acme 4.0</a></h3>\n            <p class=\"mk-blog-item-excerpt\">CRDTs, a write-ahead log and a lot of patience.</p>\n            <div class=\"mk-blog-item-byline\">\n              <span class=\"avatar\" data-size=\"sm\"\n                ><img class=\"avatar-image\" src=\"images/mk-portrait.png\" alt=\"\"\n              /></span>\n              <span class=\"mk-blog-item-author\">Sophie Tan</span>\n              <time data-i18n-target=\"date-2\" class=\"mk-blog-item-date\" datetime=\"2026-10-01\"\n                ><span data-i18n-value=\"d1001\">1 Oct 2026</span></time\n              >\n            </div>\n          </div>\n        </article>\n        <article class=\"mk-blog-item\" data-category=\"design\" data-month=\"2026-09\">\n          <figure class=\"mk-blog-item-media\"\n            ><img src=\"images/mk-wide2.png\" alt=\"Two designers reviewing a layout\"\n          /></figure>\n          <div class=\"mk-blog-item-body\">\n            <div class=\"mk-blog-item-meta\"\n              ><span class=\"badge\" data-variant=\"secondary\" data-i18n-target=\"post-2-cat\">Design</span\n              ><span data-i18n-target=\"post-2-read\">5 min read</span></div\n            >\n            <h3 class=\"mk-blog-item-title\"><a href=\"#\">Designing for calm</a></h3>\n            <p class=\"mk-blog-item-excerpt\">Fewer badges, quieter colors, one primary action per screen.</p>\n            <div class=\"mk-blog-item-byline\">\n              <span class=\"avatar\" data-size=\"sm\"\n                ><img class=\"avatar-image\" src=\"images/mk-portrait2.png\" alt=\"\"\n              /></span>\n              <span class=\"mk-blog-item-author\">Hannah Lee</span>\n              <time data-i18n-target=\"date-3\" class=\"mk-blog-item-date\" datetime=\"2026-09-24\"\n                ><span data-i18n-value=\"d0924\">24 Sep 2026</span></time\n              >\n            </div>\n          </div>\n        </article>\n      </div>\n    </div>\n    <nav class=\"mk-archive-index\" aria-labelledby=\"blog-archive-title\" data-blog-archive style=\"flex: 1 1 13rem\">\n      <h2 class=\"mk-archive-index-title\" id=\"blog-archive-title\" data-i18n-target=\"archive\">Archive</h2>\n      <details class=\"mk-archive-index-year\" name=\"archive\" open>\n        <summary>2026 <span class=\"mk-archive-index-count\">31</span></summary>\n        <ul>\n          <li\n            ><a href=\"#/archive/2026/10\" data-router-link><span data-i18n-target=\"month-2026-10\">October</span></a\n            ><span class=\"mk-archive-index-count\">3</span></li\n          >\n          <li\n            ><a href=\"#/archive/2026/09\" data-router-link>September</a><span class=\"mk-archive-index-count\">6</span></li\n          >\n          <li><a href=\"#/archive/2026/08\" data-router-link>August</a><span class=\"mk-archive-index-count\">4</span></li>\n        </ul>\n      </details>\n      <details class=\"mk-archive-index-year\" name=\"archive\">\n        <summary>2025 <span class=\"mk-archive-index-count\">48</span></summary>\n        <ul>\n          <li\n            ><a href=\"#/archive/2025/12\" data-router-link><span data-i18n-target=\"month-2025-12\">December</span></a\n            ><span class=\"mk-archive-index-count\">5</span></li\n          >\n          <li\n            ><a href=\"#/archive/2025/11\" data-router-link>November</a><span class=\"mk-archive-index-count\">4</span></li\n          >\n        </ul>\n      </details>\n    </nav>\n  </div>\n  <!-- the translations: one template per target and language (defuss-i18n) -->\n  <template data-i18n-for=\"eyebrow\" data-i18n-locale=\"en\">The Acme Blog</template>\n  <template data-i18n-for=\"eyebrow\" data-i18n-locale=\"de\">Der Acme-Blog</template>\n  <template data-i18n-for=\"title\" data-i18n-locale=\"en\">Notes on building calm software</template>\n  <template data-i18n-for=\"title\" data-i18n-locale=\"de\">Notizen über ruhige Software</template>\n  <template data-i18n-for=\"desc\" data-i18n-locale=\"en\"\n    >Essays on product, engineering and design - one post a week, no hot takes.</template\n  >\n  <template data-i18n-for=\"desc\" data-i18n-locale=\"de\"\n    >Essays über Produkt, Technik und Design - ein Beitrag pro Woche, ohne Aufregung.</template\n  >\n  <template data-i18n-for=\"cat-all\" data-i18n-locale=\"en\">All posts</template>\n  <template data-i18n-for=\"cat-all\" data-i18n-locale=\"de\">Alle Beiträge</template>\n  <template data-i18n-for=\"cat-engineering\" data-i18n-locale=\"en\">Engineering</template>\n  <template data-i18n-for=\"cat-engineering\" data-i18n-locale=\"de\">Technik</template>\n  <template data-i18n-for=\"cat-company\" data-i18n-locale=\"en\">Company</template>\n  <template data-i18n-for=\"cat-company\" data-i18n-locale=\"de\">Unternehmen</template>\n  <template data-i18n-for=\"post-0-cat\" data-i18n-locale=\"en\">Company</template>\n  <template data-i18n-for=\"post-0-cat\" data-i18n-locale=\"de\">Unternehmen</template>\n  <template data-i18n-for=\"post-0-read\" data-i18n-locale=\"en\">12 min read</template>\n  <template data-i18n-for=\"post-0-read\" data-i18n-locale=\"de\">12 Min. Lesezeit</template>\n  <template data-i18n-for=\"post-1-cat\" data-i18n-locale=\"en\">Engineering</template>\n  <template data-i18n-for=\"post-1-cat\" data-i18n-locale=\"de\">Technik</template>\n  <template data-i18n-for=\"post-1-read\" data-i18n-locale=\"en\">8 min read</template>\n  <template data-i18n-for=\"post-1-read\" data-i18n-locale=\"de\">8 Min. Lesezeit</template>\n  <template data-i18n-for=\"post-2-cat\" data-i18n-locale=\"en\">Design</template>\n  <template data-i18n-for=\"post-2-cat\" data-i18n-locale=\"de\">Design</template>\n  <template data-i18n-for=\"post-2-read\" data-i18n-locale=\"en\">5 min read</template>\n  <template data-i18n-for=\"post-2-read\" data-i18n-locale=\"de\">5 Min. Lesezeit</template>\n  <template data-i18n-for=\"date-1\" data-i18n-locale=\"en\"><span data-i18n-value=\"d1001\"></span></template>\n  <template data-i18n-for=\"date-1\" data-i18n-locale=\"de\"><span data-i18n-value=\"d1001\"></span></template>\n  <template data-i18n-for=\"date-2\" data-i18n-locale=\"en\"><span data-i18n-value=\"d1001\"></span></template>\n  <template data-i18n-for=\"date-2\" data-i18n-locale=\"de\"><span data-i18n-value=\"d1001\"></span></template>\n  <template data-i18n-for=\"date-3\" data-i18n-locale=\"en\"><span data-i18n-value=\"d0924\"></span></template>\n  <template data-i18n-for=\"date-3\" data-i18n-locale=\"de\"><span data-i18n-value=\"d0924\"></span></template>\n  <template data-i18n-for=\"archive\" data-i18n-locale=\"en\">Archive</template>\n  <template data-i18n-for=\"archive\" data-i18n-locale=\"de\">Archiv</template>\n  <template data-i18n-for=\"month-2026-10\" data-i18n-locale=\"en\">October</template>\n  <template data-i18n-for=\"month-2026-10\" data-i18n-locale=\"de\">Oktober</template>\n  <template data-i18n-for=\"month-2025-12\" data-i18n-locale=\"en\">December</template>\n  <template data-i18n-for=\"month-2025-12\" data-i18n-locale=\"de\">Dezember</template>\n  <template data-i18n-for=\"empty\" data-i18n-locale=\"en\">No posts of this demo match.</template>\n  <template data-i18n-for=\"empty\" data-i18n-locale=\"de\">Keine Beiträge dieser Demo passen.</template>\n</div>\n","individual":false}]
