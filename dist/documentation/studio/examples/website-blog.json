[{"label":"A blog front","html":"<div style=\"display: flex; flex-direction: column; gap: 2.5rem; width: 100%\">\n  <header class=\"mk-blog-header\">\n    <div class=\"mk-blog-header-copy\">\n      <span class=\"mk-blog-header-eyebrow\">The Acme Blog</span>\n      <h1 class=\"mk-blog-header-title\">Notes on building calm software</h1>\n      <p class=\"mk-blog-header-desc\">Essays on product, engineering and design - one post a week, no hot takes.</p>\n    </div>\n    <nav class=\"mk-blog-header-categories\" aria-label=\"Categories\">\n      <a href=\"#\" aria-current=\"page\">All posts</a>\n      <a href=\"#\">Engineering</a>\n      <a href=\"#\">Design</a>\n      <a href=\"#\">Company</a>\n    </nav>\n  </header>\n  <div style=\"display: flex; flex-wrap: wrap; gap: 2.5rem; align-items: flex-start\">\n    <div style=\"flex: 999 1 30rem; display: flex; flex-direction: column; gap: 2rem; min-width: 0\">\n      <article class=\"mk-blog-item\" data-variant=\"featured\">\n        <figure class=\"mk-blog-item-media\"\n          ><img src=\"images/mk-wide3.png\" alt=\"The Acme team at their offsite\"\n        /></figure>\n        <div class=\"mk-blog-item-body\">\n          <div class=\"mk-blog-item-meta\"\n            ><span class=\"badge\" data-variant=\"secondary\">Company</span><span>12 min read</span></div\n          >\n          <h3 class=\"mk-blog-item-title\"><a href=\"#\">Ten years of Acme: what we got right</a></h3>\n          <p class=\"mk-blog-item-excerpt\">A long look back at a decade of building calm software.</p>\n          <div class=\"mk-blog-item-byline\">\n            <span class=\"avatar\" data-size=\"sm\"><img class=\"avatar-image\" src=\"images/mk-portrait.png\" alt=\"\" /></span>\n            <span class=\"mk-blog-item-author\">Aron Homberg</span>\n            <time class=\"mk-blog-item-date\" datetime=\"2026-10-01\">1 Oct 2026</time>\n          </div>\n        </div>\n      </article>\n      <div style=\"display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 2rem\">\n        <article class=\"mk-blog-item\">\n          <figure class=\"mk-blog-item-media\"\n            ><img src=\"images/mk-wide.png\" alt=\"A whiteboard full of sketches\"\n          /></figure>\n          <div class=\"mk-blog-item-body\">\n            <div class=\"mk-blog-item-meta\"\n              ><span class=\"badge\" data-variant=\"secondary\">Engineering</span><span>8 min read</span></div\n            >\n            <h3 class=\"mk-blog-item-title\"><a href=\"#\">How offline sync works in Acme 4.0</a></h3>\n            <p class=\"mk-blog-item-excerpt\">CRDTs, a write-ahead log and a lot of patience.</p>\n            <div class=\"mk-blog-item-byline\">\n              <span class=\"avatar\" data-size=\"sm\"\n                ><img class=\"avatar-image\" src=\"images/mk-portrait.png\" alt=\"\"\n              /></span>\n              <span class=\"mk-blog-item-author\">Sophie Tan</span>\n              <time class=\"mk-blog-item-date\" datetime=\"2026-10-01\">1 Oct 2026</time>\n            </div>\n          </div>\n        </article>\n        <article class=\"mk-blog-item\">\n          <figure class=\"mk-blog-item-media\"\n            ><img src=\"images/mk-wide2.png\" alt=\"Two designers reviewing a layout\"\n          /></figure>\n          <div class=\"mk-blog-item-body\">\n            <div class=\"mk-blog-item-meta\"\n              ><span class=\"badge\" data-variant=\"secondary\">Design</span><span>5 min read</span></div\n            >\n            <h3 class=\"mk-blog-item-title\"><a href=\"#\">Designing for calm</a></h3>\n            <p class=\"mk-blog-item-excerpt\">Fewer badges, quieter colors, one primary action per screen.</p>\n            <div class=\"mk-blog-item-byline\">\n              <span class=\"avatar\" data-size=\"sm\"\n                ><img class=\"avatar-image\" src=\"images/mk-portrait2.png\" alt=\"\"\n              /></span>\n              <span class=\"mk-blog-item-author\">Hannah Lee</span>\n              <time class=\"mk-blog-item-date\" datetime=\"2026-09-24\">24 Sep 2026</time>\n            </div>\n          </div>\n        </article>\n      </div>\n    </div>\n    <nav class=\"mk-archive-index\" aria-labelledby=\"blog-archive-title\" style=\"flex: 1 1 13rem\">\n      <h2 class=\"mk-archive-index-title\" id=\"blog-archive-title\">Archive</h2>\n      <details class=\"mk-archive-index-year\" name=\"archive\" open>\n        <summary>2026 <span class=\"mk-archive-index-count\">31</span></summary>\n        <ul>\n          <li><a href=\"#\" aria-current=\"page\">October</a><span class=\"mk-archive-index-count\">3</span></li>\n          <li><a href=\"#\">September</a><span class=\"mk-archive-index-count\">6</span></li>\n          <li><a href=\"#\">August</a><span class=\"mk-archive-index-count\">4</span></li>\n        </ul>\n      </details>\n      <details class=\"mk-archive-index-year\" name=\"archive\">\n        <summary>2025 <span class=\"mk-archive-index-count\">48</span></summary>\n        <ul>\n          <li><a href=\"#\">December</a><span class=\"mk-archive-index-count\">5</span></li>\n          <li><a href=\"#\">November</a><span class=\"mk-archive-index-count\">4</span></li>\n        </ul>\n      </details>\n    </nav>\n  </div>\n</div>\n","individual":false}]
