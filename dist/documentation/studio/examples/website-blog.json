[{"label":"A blog front","html":"<style>\n  @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400;1,9..144,600&family=Figtree:wght@400;500;600;700&family=Inter+Tight:wght@500;700;800&display=swap');\n  /* An essay blog on a 74rem page: a quiet site bar, the masthead on a band with a texture under it, the editor's pick\n     as a wide story (photo beside the copy), then the posts as cards with the archive beside them. Serif headlines\n     (Fraunces) over a humanist sans (Figtree); one accent for links and the word that matters. Looks: Journal (ivory\n     and forest green, follows light / dark), Night shift (ink blue and amber, a grain gradient behind the masthead)\n     and Ink (paper white, black and vermilion, grotesque headlines over a halftone of dots). */\n  #site-blog {\n    --background: oklch(0.982 0.005 85);\n    --foreground: oklch(0.22 0.012 70);\n    --card: oklch(0.995 0.003 85);\n    --card-foreground: var(--foreground);\n    --muted: oklch(0.95 0.008 85);\n    --muted-foreground: oklch(0.47 0.015 70);\n    --border: oklch(0.22 0.012 70 / 0.12);\n    --input: oklch(0.22 0.012 70 / 0.22);\n    --primary: oklch(0.42 0.075 165);\n    --primary-foreground: oklch(0.985 0.005 85);\n    --secondary: oklch(0.95 0.008 85);\n    --secondary-foreground: var(--foreground);\n    --accent: oklch(0.93 0.025 165);\n    --accent-foreground: oklch(0.3 0.06 165);\n    --ring: var(--primary);\n    --radius: 0.5rem;\n    --radius-sm: max(0px, calc(var(--radius) - 4px));\n    --radius-md: max(0px, calc(var(--radius) - 2px));\n    --radius-lg: var(--radius);\n    --radius-xl: calc(var(--radius) + 4px);\n    --blog-head: 'Fraunces', Georgia, serif;\n    --blog-band: oklch(0.955 0.012 120);\n    --blog-letter: oklch(0.27 0.04 165);\n    --blog-letter-ink: oklch(0.97 0.01 120);\n    color-scheme: light;\n    container-type: inline-size;\n    box-sizing: border-box;\n    display: flex;\n    flex-direction: column;\n    width: 100%;\n    background: var(--background);\n    color: var(--foreground);\n    font:\n      400 1rem/1.55 'Figtree',\n      var(--font-sans);\n  }\n  #site-blog > * {\n    box-sizing: border-box;\n    width: 100%;\n    padding-inline: clamp(1rem, 4vw, 2.5rem);\n  }\n  #site-blog > * > :not(.shader, .surface) {\n    max-width: 74rem;\n    margin-inline: auto;\n  }\n  .dark #site-blog[data-look='journal'] {\n    color-scheme: dark;\n    --background: oklch(0.19 0.01 160);\n    --foreground: oklch(0.94 0.008 85);\n    --card: oklch(0.225 0.012 160);\n    --muted: oklch(0.25 0.012 160);\n    --muted-foreground: oklch(0.74 0.015 100);\n    --border: oklch(0.94 0.008 85 / 0.12);\n    --input: oklch(0.94 0.008 85 / 0.22);\n    --primary: oklch(0.78 0.09 165);\n    --primary-foreground: oklch(0.19 0.01 160);\n    --secondary: oklch(0.25 0.012 160);\n    --accent: oklch(0.3 0.04 165);\n    --accent-foreground: oklch(0.88 0.06 165);\n    --blog-band: oklch(0.22 0.014 160);\n    --blog-letter: oklch(0.82 0.08 165);\n    --blog-letter-ink: oklch(0.2 0.03 165);\n  }\n  #site-blog[data-look='night'] {\n    color-scheme: dark;\n    --background: oklch(0.18 0.022 255);\n    --foreground: oklch(0.94 0.012 85);\n    --card: oklch(0.215 0.025 255);\n    --muted: oklch(0.25 0.028 255);\n    --muted-foreground: oklch(0.76 0.02 250);\n    --border: oklch(0.94 0.012 85 / 0.12);\n    --input: oklch(0.94 0.012 85 / 0.22);\n    --primary: oklch(0.82 0.12 75);\n    --primary-foreground: oklch(0.18 0.022 255);\n    --secondary: oklch(0.25 0.028 255);\n    --accent: oklch(0.3 0.04 75);\n    --accent-foreground: oklch(0.88 0.1 80);\n    --blog-band: oklch(0.15 0.025 255);\n    --blog-letter: oklch(0.82 0.12 75);\n    --blog-letter-ink: oklch(0.18 0.022 255);\n  }\n  #site-blog[data-look='ink'] {\n    color-scheme: light;\n    --background: oklch(0.995 0 0);\n    --foreground: oklch(0.14 0 0);\n    --card: oklch(1 0 0);\n    --muted: oklch(0.955 0 0);\n    --muted-foreground: oklch(0.42 0 0);\n    --border: oklch(0.14 0 0 / 0.14);\n    --input: oklch(0.14 0 0 / 0.3);\n    --primary: oklch(0.58 0.2 32);\n    --primary-foreground: oklch(0.995 0 0);\n    --accent: oklch(0.95 0.03 32);\n    --accent-foreground: oklch(0.45 0.17 32);\n    --radius: 0rem;\n    --blog-head: 'Inter Tight', var(--font-sans);\n    --blog-band: oklch(0.955 0 0);\n    --blog-letter: oklch(0.14 0 0);\n    --blog-letter-ink: oklch(0.995 0 0);\n  }\n  #site-blog .blog-look-only {\n    display: none;\n  }\n  #site-blog[data-look='journal'] .blog-look-only[data-for='journal'],\n  #site-blog[data-look='night'] .blog-look-only[data-for='night'],\n  #site-blog[data-look='ink'] .blog-look-only[data-for='ink'] {\n    display: block;\n  }\n  /* the site bar: the name, then the look and the language */\n  #site-blog .blog-bar {\n    border-block-end: 1px solid var(--border);\n  }\n  #site-blog .blog-bar-inner {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    justify-content: space-between;\n    gap: 0.75rem 1.5rem;\n    min-height: 4.5rem;\n  }\n  #site-blog .blog-brand {\n    color: var(--foreground);\n    text-decoration: none;\n    font: 600 1.375rem/1 var(--blog-head);\n    letter-spacing: -0.02em;\n  }\n  #site-blog .blog-brand i {\n    color: var(--primary);\n    font-weight: 400;\n  }\n  #site-blog .blog-bar-controls {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.5rem;\n  }\n  #site-blog .blog-bar .select {\n    min-width: 8.5rem;\n  }\n  /* the masthead band: a texture under the title, the categories as tabs along its foot */\n  #site-blog .blog-band {\n    position: relative;\n    isolation: isolate;\n    overflow: clip;\n    background: var(--blog-band);\n  }\n  #site-blog .mk-blog-header {\n    position: static;\n    gap: 2.25rem;\n    padding-block: clamp(3rem, 7vw, 5.5rem) 0;\n  }\n  #site-blog .blog-grain {\n    --surface-size: 180px;\n    --surface-ink: oklch(0.3 0.02 90 / 0.035);\n    --surface-bg: transparent;\n  }\n  #site-blog .blog-dots {\n    --surface-size: 14px;\n    --surface-ink: oklch(0.14 0 0 / 0.08);\n    --surface-bg: transparent;\n    mask-image: linear-gradient(100deg, transparent 35%, #000 85%);\n  }\n  #site-blog .blog-glow {\n    opacity: 0.75;\n  }\n  #site-blog .mk-blog-header-copy {\n    gap: 1rem;\n    max-width: 48rem;\n  }\n  #site-blog .mk-blog-header-eyebrow {\n    color: var(--primary);\n    font-size: 0.8125rem;\n    font-weight: 700;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n  }\n  #site-blog .mk-blog-header-title {\n    font: 600 clamp(2.5rem, 6.5vw, 4.75rem)/1.02 var(--blog-head);\n    letter-spacing: -0.03em;\n  }\n  #site-blog[data-look='ink'] .mk-blog-header-title {\n    font-weight: 800;\n    letter-spacing: -0.045em;\n  }\n  /* the word that matters: italic, in the accent */\n  #site-blog .blog-marker {\n    background: none;\n    color: var(--primary);\n    font-style: italic;\n    font-weight: 400;\n  }\n  #site-blog[data-look='ink'] .blog-marker {\n    font-style: normal;\n    font-weight: 800;\n    text-decoration: underline 0.09em;\n    text-underline-offset: 0.1em;\n  }\n  #site-blog .mk-blog-header-desc {\n    max-width: 36rem;\n    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);\n  }\n  #site-blog .mk-blog-header-categories {\n    gap: 0 1.75rem;\n    width: 100%;\n    border-block-start: 1px solid var(--border);\n  }\n  #site-blog .mk-blog-header-categories a {\n    height: auto;\n    padding: 1rem 0;\n    border: 0;\n    border-radius: 0;\n    background: none;\n    color: var(--muted-foreground);\n    font-size: 0.9375rem;\n    font-weight: 600;\n    box-shadow: inset 0 0 0 transparent;\n  }\n  #site-blog .mk-blog-header-categories a:hover {\n    color: var(--foreground);\n  }\n  #site-blog .mk-blog-header-categories a[aria-current] {\n    background: none;\n    color: var(--foreground);\n    box-shadow: inset 0 -2px 0 var(--primary);\n  }\n  /* the posts and the archive */\n  #site-blog .blog-main {\n    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(3rem, 7vw, 5.5rem);\n  }\n  #site-blog .blog-columns {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr);\n    gap: 3rem;\n    align-items: start;\n  }\n  @container (width > 62rem) {\n    #site-blog .blog-columns {\n      grid-template-columns: minmax(0, 1fr) 15rem;\n      gap: 4rem;\n    }\n  }\n  #site-blog .blog-stream {\n    display: flex;\n    flex-direction: column;\n    gap: 3rem;\n    min-width: 0;\n  }\n  #site-blog .mk-blog-item-title {\n    font-family: var(--blog-head);\n    font-weight: 600;\n    letter-spacing: -0.015em;\n    text-wrap: balance;\n  }\n  #site-blog[data-look='ink'] .mk-blog-item-title {\n    font-weight: 700;\n    letter-spacing: -0.03em;\n  }\n  #site-blog .mk-blog-item-title a {\n    color: inherit;\n  }\n  #site-blog .mk-blog-item-meta {\n    gap: 0.75rem;\n    font-size: 0.8125rem;\n    color: var(--muted-foreground);\n  }\n  #site-blog .mk-blog-item-meta .badge {\n    height: auto;\n    padding: 0;\n    border: 0;\n    background: none;\n    color: var(--primary);\n    font-size: 0.75rem;\n    font-weight: 700;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n  }\n  #site-blog .mk-blog-item-excerpt {\n    color: var(--muted-foreground);\n    line-height: 1.55;\n  }\n  #site-blog .mk-blog-item-byline {\n    font-size: 0.8125rem;\n  }\n  #site-blog .mk-blog-item-media {\n    border-radius: var(--radius-lg);\n  }\n  /* the editor's pick: the photo beside the copy, a label on the photo */\n  #site-blog .blog-lead {\n    position: relative;\n  }\n  #site-blog .blog-lead .mk-blog-item {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr);\n    gap: 1.5rem;\n  }\n  @container (width > 46rem) {\n    #site-blog .blog-lead .mk-blog-item {\n      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);\n      align-items: center;\n      gap: 2.5rem;\n    }\n  }\n  #site-blog .blog-lead .mk-blog-item-media {\n    width: 100%;\n    aspect-ratio: 4 / 3;\n    border-radius: var(--radius-xl);\n  }\n  #site-blog .blog-lead .mk-blog-item-body {\n    gap: 1rem;\n  }\n  #site-blog .blog-lead .mk-blog-item-title {\n    font-size: clamp(1.875rem, 3.4vw, 2.75rem);\n    line-height: 1.08;\n  }\n  #site-blog .blog-lead .mk-blog-item-excerpt {\n    font-size: 1.125rem;\n  }\n  #site-blog .blog-note {\n    position: absolute;\n    top: 1rem;\n    left: 1rem;\n    z-index: 1;\n    margin: 0;\n    padding: 0.375rem 0.75rem;\n    border-radius: 999px;\n    background: var(--card);\n    color: var(--foreground);\n    font-size: 0.75rem;\n    font-weight: 700;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n    box-shadow: 0 6px 20px -8px oklch(0 0 0 / 0.35);\n  }\n  #site-blog[data-look='ink'] .blog-note {\n    border-radius: 0;\n    background: var(--primary);\n    color: var(--primary-foreground);\n    box-shadow: none;\n  }\n  /* the cards: photo, label, title, excerpt, byline - a hairline above the grid */\n  #site-blog .blog-posts {\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));\n    gap: 2.75rem 2rem;\n    padding-block-start: 2.75rem;\n    border-block-start: 1px solid var(--border);\n  }\n  #site-blog .blog-posts .mk-blog-item-title {\n    font-size: 1.3125rem;\n    line-height: 1.2;\n  }\n  #site-blog .blog-posts .mk-blog-item-media {\n    transition: opacity 0.2s;\n  }\n  #site-blog .blog-posts .mk-blog-item:hover .mk-blog-item-media {\n    opacity: 0.88;\n  }\n  #site-blog[data-look='ink'] .blog-posts .mk-blog-item-media img {\n    filter: grayscale(1) contrast(1.08);\n  }\n  /* the Sunday letter: the one solid block among the cards */\n  #site-blog .blog-letter {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    gap: 0.75rem;\n    padding: 2rem;\n    border-radius: var(--radius-xl);\n    background: var(--blog-letter);\n    color: var(--blog-letter-ink);\n  }\n  #site-blog .blog-letter h3 {\n    margin: 0;\n    font: 600 1.625rem/1.15 var(--blog-head);\n    letter-spacing: -0.02em;\n  }\n  #site-blog .blog-letter p {\n    margin: 0;\n    color: color-mix(in oklch, currentColor 78%, transparent);\n  }\n  #site-blog .blog-letter form {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.5rem;\n    margin-block-start: 0.5rem;\n  }\n  #site-blog .blog-letter .input {\n    flex: 1 1 10rem;\n    border-color: color-mix(in oklch, currentColor 30%, transparent);\n    background: color-mix(in oklch, currentColor 8%, transparent);\n    color: inherit;\n  }\n  #site-blog .blog-letter .input::placeholder {\n    color: color-mix(in oklch, currentColor 60%, transparent);\n  }\n  #site-blog .blog-letter .btn {\n    background: var(--blog-letter-ink);\n    color: var(--blog-letter);\n  }\n  /* the archive: a quiet column */\n  #site-blog .mk-archive-index-title {\n    margin: 0 0 0.5rem;\n    font:\n      700 0.75rem/1.2 'Figtree',\n      sans-serif;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    color: var(--muted-foreground);\n  }\n  #site-blog .mk-archive-index a[aria-current] {\n    color: var(--primary);\n    font-weight: 600;\n  }\n  @media (prefers-reduced-motion: reduce) {\n    #site-blog .blog-posts .mk-blog-item-media {\n      transition: none;\n    }\n  }\n  /* light or dark: the Swap writes the page's dark class - every look has a light and a dark palette */\n  #site-blog .site-mode {\n    flex: none;\n    border: 1px solid var(--input);\n    border-radius: var(--radius-md);\n    background: var(--background);\n    color: var(--foreground);\n  }\n  #site-blog .site-mode:hover {\n    background: var(--accent);\n    color: var(--accent-foreground);\n  }\n  /* -- modes: each look in light and dark, derived from the palettes above (the other mode of each look) -- */\n  :root:not(.dark) #site-blog[data-look='journal'] {\n    --accent: oklch(0.937 0.025 165);\n    --accent-foreground: oklch(0.22 0.012 70);\n  }\n  .dark #site-blog[data-look='journal'] {\n    --accent: oklch(0.28 0.04 165);\n    --accent-foreground: oklch(0.94 0.008 85);\n  }\n  .dark #site-blog[data-look='night'] {\n    --accent: oklch(0.27 0.04 75);\n    --accent-foreground: oklch(0.94 0.012 85);\n  }\n  :root:not(.dark) #site-blog[data-look='night'] {\n    color-scheme: light;\n    --background: oklch(0.985 0.022 255);\n    --foreground: oklch(0.2 0.012 85);\n    --card: oklch(0.997 0.025 255);\n    --card-foreground: oklch(0.2 0.012 85);\n    --muted: oklch(0.95 0.025 255);\n    --muted-foreground: oklch(0.46 0.02 250);\n    --border: oklch(0.2 0.012 85 / 0.12);\n    --input: oklch(0.2 0.012 85 / 0.12);\n    --primary: oklch(0.55 0.12 75);\n    --primary-foreground: oklch(0.985 0.005 75);\n    --secondary: oklch(0.955 0.025 255);\n    --secondary-foreground: oklch(0.25 0.012 85);\n    --accent: oklch(0.94 0.025 75);\n    --accent-foreground: oklch(0.2 0.012 85);\n    --ring: oklch(0.57 0.12 75);\n    --blog-band: oklch(0.989 0.025 255);\n    --blog-letter: oklch(0.57 0.12 75);\n    --blog-letter-ink: oklch(0.973 0.022 255);\n    --popover: oklch(0.997 0 0);\n    --popover-foreground: oklch(0.2 0 0);\n  }\n  :root:not(.dark) #site-blog[data-look='ink'] {\n    --accent-foreground: oklch(0.14 0 0);\n  }\n  .dark #site-blog[data-look='ink'] {\n    color-scheme: dark;\n    --background: oklch(0.17 0 0);\n    --foreground: oklch(0.94 0 0);\n    --card: oklch(0.205 0 0);\n    --card-foreground: oklch(0.94 0 0);\n    --muted: oklch(0.24 0 0);\n    --muted-foreground: oklch(0.74 0 0);\n    --border: oklch(0.95 0 0 / 0.14);\n    --input: oklch(0.95 0 0 / 0.14);\n    --primary: oklch(0.82 0.18 32);\n    --primary-foreground: oklch(0.17 0.03 32);\n    --secondary: oklch(0.25 0.008 85);\n    --secondary-foreground: oklch(0.9 0 0);\n    --accent: oklch(0.26 0.03 32);\n    --accent-foreground: oklch(0.94 0 0);\n    --ring: oklch(0.82 0.18 32);\n    --blog-band: oklch(0.218 0 0);\n    --blog-letter: oklch(0.967 0 0);\n    --blog-letter-ink: oklch(0.158 0 0);\n    --popover: oklch(0.215 0 0);\n    --popover-foreground: oklch(0.94 0 0);\n  }\n  /* -- modes: end -- */\n</style>\n<div id=\"site-blog\" data-look=\"journal\" data-i18n-component>\n  <div class=\"blog-bar\">\n    <div class=\"blog-bar-inner\">\n      <a class=\"blog-brand\" href=\"#/\">Acme <i>Journal</i></a>\n      <div class=\"blog-bar-controls\">\n        <select\n          class=\"select\"\n          data-size=\"sm\"\n          data-site-look\n          aria-label=\"Look\"\n          data-i18n-aria-label-en=\"Look\"\n          data-i18n-aria-label-de=\"Stil\"\n          style=\"width: auto\"\n        >\n          <option value=\"journal\" data-i18n-target=\"look-journal\">Journal</option>\n          <option value=\"night\" data-i18n-target=\"look-night\">Night shift</option>\n          <option value=\"ink\" data-i18n-target=\"look-ink\">Ink</option>\n        </select>\n        <select\n          class=\"select\"\n          data-size=\"sm\"\n          data-app-locale\n          aria-label=\"Language\"\n          data-i18n-aria-label-en=\"Language\"\n          data-i18n-aria-label-de=\"Sprache\"\n          style=\"width: auto\"\n        >\n          <option value=\"en\" lang=\"en\">English</option>\n          <option value=\"de\" lang=\"de\">Deutsch</option>\n        </select>\n        <label class=\"swap site-mode\" data-variant=\"rotate\" data-size=\"sm\">\n          <input\n            type=\"checkbox\"\n            data-site-mode\n            aria-label=\"Dark mode\"\n            data-i18n-aria-label-en=\"Dark mode\"\n            data-i18n-aria-label-de=\"Dunkler Modus\"\n          />\n          <span class=\"swap-on\" aria-hidden=\"true\"><i data-lucide=\"moon\"></i></span>\n          <span class=\"swap-off\" aria-hidden=\"true\"><i data-lucide=\"sun\"></i></span>\n        </label>\n      </div>\n    </div>\n  </div>\n  <div class=\"blog-band\">\n    <div\n      class=\"surface blog-grain blog-look-only\"\n      data-for=\"journal\"\n      data-variant=\"background\"\n      data-pattern=\"grain\"\n      aria-hidden=\"true\"\n    ></div>\n    <div\n      class=\"shader blog-glow blog-look-only\"\n      data-for=\"night\"\n      data-variant=\"background\"\n      data-effect=\"grain-gradient\"\n      data-colors=\"oklch(0.2 0.03 255) oklch(0.3 0.06 250) oklch(0.42 0.09 70)\"\n      data-background=\"transparent\"\n      data-speed=\"0.4\"\n      data-fps=\"30\"\n      aria-hidden=\"true\"\n    ></div>\n    <div\n      class=\"surface blog-dots blog-look-only\"\n      data-for=\"ink\"\n      data-variant=\"background\"\n      data-pattern=\"dots\"\n      aria-hidden=\"true\"\n    ></div>\n    <header class=\"mk-blog-header\">\n      <div class=\"mk-blog-header-copy\">\n        <span class=\"mk-blog-header-eyebrow\" data-i18n-target=\"eyebrow\">The Acme Blog</span>\n        <h1 class=\"mk-blog-header-title\" data-i18n-target=\"title\"\n          >Notes on building <mark class=\"blog-marker\">calm</mark> software</h1\n        >\n        <p class=\"mk-blog-header-desc\" data-i18n-target=\"desc\"\n          >Essays on product, engineering and design - one post a week, no hot takes.</p\n        >\n      </div>\n      <nav\n        class=\"mk-blog-header-categories\"\n        aria-label=\"Categories\"\n        data-i18n-aria-label-en=\"Categories\"\n        data-i18n-aria-label-de=\"Kategorien\"\n      >\n        <a href=\"#/\" data-router-link aria-current=\"page\"><span data-i18n-target=\"cat-all\">All posts</span></a>\n        <a href=\"#/category/engineering\" data-router-link\n          ><span data-i18n-target=\"cat-engineering\">Engineering</span></a\n        >\n        <a href=\"#/category/design\" data-router-link>Design</a>\n        <a href=\"#/category/company\" data-router-link><span data-i18n-target=\"cat-company\">Company</span></a>\n      </nav>\n    </header>\n  </div>\n  <div class=\"blog-main\">\n    <div class=\"blog-columns\">\n      <div class=\"blog-stream\">\n        <div class=\"blog-lead\">\n          <article class=\"mk-blog-item\" data-category=\"company\" data-month=\"2026-10\" data-variant=\"horizontal\">\n            <figure class=\"mk-blog-item-media\"\n              ><img\n                src=\"https://picsum.photos/id/2/1600/900\"\n                alt=\"A laptop, a notebook and a cup of coffee on a wooden desk\"\n            /></figure>\n            <div class=\"mk-blog-item-body\">\n              <div class=\"mk-blog-item-meta\"\n                ><span class=\"badge\" data-variant=\"secondary\" data-i18n-target=\"post-0-cat\">Company</span\n                ><span data-i18n-target=\"post-0-read\">12 min read</span></div\n              >\n              <h3 class=\"mk-blog-item-title\"><a href=\"#\">Ten years of Acme: what we got right</a></h3>\n              <p class=\"mk-blog-item-excerpt\">A long look back at a decade of building calm software.</p>\n              <div class=\"mk-blog-item-byline\">\n                <span class=\"avatar\" data-size=\"sm\"><span class=\"avatar-fallback\">AH</span></span>\n                <span class=\"mk-blog-item-author\">Aron Homberg</span>\n                <time data-i18n-target=\"date-1\" class=\"mk-blog-item-date\" datetime=\"2026-10-01\"\n                  ><span data-i18n-value=\"d1001\">1 Oct 2026</span></time\n                >\n              </div>\n            </div>\n          </article>\n          <p class=\"blog-note\"><span data-i18n-target=\"note\">Editor's pick</span></p>\n        </div>\n        <p class=\"text-sm text-muted-foreground\" data-blog-empty data-i18n-target=\"empty\" hidden\n          >No posts of this demo match.</p\n        >\n        <div class=\"blog-posts\">\n          <article class=\"mk-blog-item\" data-category=\"engineering\" data-month=\"2026-10\">\n            <figure class=\"mk-blog-item-media\"\n              ><img\n                src=\"https://picsum.photos/id/26/900/600\"\n                alt=\"A phone, a watch, headphones and a notebook laid out on a desk\"\n            /></figure>\n            <div class=\"mk-blog-item-body\">\n              <div class=\"mk-blog-item-meta\"\n                ><span class=\"badge\" data-variant=\"secondary\" data-i18n-target=\"post-1-cat\">Engineering</span\n                ><span data-i18n-target=\"post-1-read\">8 min read</span></div\n              >\n              <h3 class=\"mk-blog-item-title\"><a href=\"#\">How offline sync works in Acme 4.0</a></h3>\n              <p class=\"mk-blog-item-excerpt\">CRDTs, a write-ahead log and a lot of patience.</p>\n              <div class=\"mk-blog-item-byline\">\n                <span class=\"avatar\" data-size=\"sm\"\n                  ><img class=\"avatar-image\" src=\"https://i.pravatar.cc/96?img=47\" alt=\"\"\n                /></span>\n                <span class=\"mk-blog-item-author\">Sophie Tan</span>\n                <time data-i18n-target=\"date-2\" class=\"mk-blog-item-date\" datetime=\"2026-10-01\"\n                  ><span data-i18n-value=\"d1001\">1 Oct 2026</span></time\n                >\n              </div>\n            </div>\n          </article>\n          <article class=\"mk-blog-item\" data-category=\"design\" data-month=\"2026-09\">\n            <figure class=\"mk-blog-item-media\"\n              ><img src=\"https://picsum.photos/id/225/900/600\" alt=\"A glass teapot and cups on a quiet table\"\n            /></figure>\n            <div class=\"mk-blog-item-body\">\n              <div class=\"mk-blog-item-meta\"\n                ><span class=\"badge\" data-variant=\"secondary\" data-i18n-target=\"post-2-cat\">Design</span\n                ><span data-i18n-target=\"post-2-read\">5 min read</span></div\n              >\n              <h3 class=\"mk-blog-item-title\"><a href=\"#\">Designing for calm</a></h3>\n              <p class=\"mk-blog-item-excerpt\">Fewer badges, quieter colors, one primary action per screen.</p>\n              <div class=\"mk-blog-item-byline\">\n                <span class=\"avatar\" data-size=\"sm\"\n                  ><img class=\"avatar-image\" src=\"https://i.pravatar.c