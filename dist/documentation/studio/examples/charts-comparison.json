[{"label":"Highlight bars","html":"<figure class=\"chart-frame\" style=\"margin: 0\">\n  <h3 class=\"chart-title\">Time saved per task, by activity</h3>\n  <p class=\"chart-dek\">Research leads at 83% - one highlighted bar against muted context.</p>\n  <div\n    id=\"cmp-highlight\"\n    class=\"chart\"\n    role=\"img\"\n    aria-label=\"Horizontal bar ranking of time saved per task; Research leads at 83 percent, Video lowest at 36 percent\"\n  ></div>\n  <figcaption class=\"chart-source\">Synthetic data · adapted from echarts-feat 01-editorial-highlight-bars</figcaption>\n</figure>\n","individual":false},{"label":"Lollipop ranking","html":"<figure class=\"chart-frame\" style=\"margin: 0\">\n  <h3 class=\"chart-title\">Regional adoption score</h3>\n  <p class=\"chart-dek\">A compact ranking for many categories - stems and dots instead of filled bars.</p>\n  <div\n    id=\"cmp-lollipop\"\n    class=\"chart\"\n    role=\"img\"\n    aria-label=\"Lollipop ranking of regional adoption score; North leads at 64, South lowest at 31\"\n  ></div>\n  <figcaption class=\"chart-source\">Synthetic data · adapted from echarts-feat 02-lollipop-ranking</figcaption>\n</figure>\n","individual":false},{"label":"Dumbbell: before/after","html":"<figure class=\"chart-frame\" style=\"margin: 0\">\n  <h3 class=\"chart-title\">Confidence score, before vs after</h3>\n  <p class=\"chart-dek\">Freelance dropped 64 points - the connector length is the story.</p>\n  <div\n    id=\"cmp-dumbbell\"\n    class=\"chart\"\n    role=\"img\"\n    aria-label=\"Dumbbell chart of confidence before and after; Freelance shows the largest drop from 82 to 18 percent\"\n  ></div>\n  <figcaption class=\"chart-source\">Synthetic data · adapted from echarts-feat 03-dumbbell-before-after</figcaption>\n</figure>\n","individual":false},{"label":"Slopegraph","html":"<figure class=\"chart-frame\" style=\"margin: 0\">\n  <h3 class=\"chart-title\">Score movement, 2022 → 2026</h3>\n  <p class=\"chart-dek\">Alpha and Delta climb, Beta and Epsilon slide - crossings are readable at a glance.</p>\n  <div\n    id=\"cmp-slope\"\n    class=\"chart\"\n    data-size=\"lg\"\n    role=\"img\"\n    aria-label=\"Slopegraph of five teams from 2022 to 2026; Alpha rises from 38 to 51, Beta falls from 44 to 39\"\n  ></div>\n  <figcaption class=\"chart-source\">Synthetic data · adapted from echarts-feat 04-slopegraph</figcaption>\n</figure>\n","individual":false},{"label":"Diverging bars","html":"<figure class=\"chart-frame\" style=\"margin: 0\">\n  <h3 class=\"chart-title\">Year-over-year swing by region</h3>\n  <p class=\"chart-dek\">North gained 12 points while South lost 11 - deviation around a zero baseline.</p>\n  <div\n    id=\"cmp-diverging\"\n    class=\"chart\"\n    role=\"img\"\n    aria-label=\"Diverging bar chart of year-over-year swing in percentage points; North plus 12, South minus 11\"\n  ></div>\n  <figcaption class=\"chart-source\">Synthetic data · adapted from echarts-feat 05-diverging-bars</figcaption>\n</figure>\n","individual":false}]
