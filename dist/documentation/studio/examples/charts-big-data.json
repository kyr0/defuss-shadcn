[{"label":"A million orders","html":"<figure class=\"chart-frame\" style=\"margin: 0\">\n  <h3 class=\"chart-title\">A million orders</h3>\n  <p class=\"chart-dek\">Every order of a year, grouped in the browser - the chart draws the groups, never the rows.</p>\n  <div class=\"flex flex-wrap items-end gap-3 mb-3\">\n    <label class=\"grid gap-1 text-sm\"\n      >Group by\n      <select class=\"select\" data-size=\"sm\" id=\"million-group\">\n        <option value=\"region\">Region</option>\n        <option value=\"channel\">Channel</option>\n      </select>\n    </label>\n    <label class=\"grid gap-1 text-sm\"\n      >Measure\n      <select class=\"select\" data-size=\"sm\" id=\"million-measure\">\n        <option value=\"count\">Orders</option>\n        <option value=\"sum\">Revenue</option>\n        <option value=\"avg\">Average order</option>\n      </select>\n    </label>\n  </div>\n  <div\n    class=\"chart\"\n    id=\"million\"\n    role=\"img\"\n    aria-label=\"Orders of a year grouped by region\"\n    style=\"height: 15rem\"\n  ></div>\n  <figcaption class=\"chart-source\"><output id=\"million-info\">Generating 1,000,000 orders...</output></figcaption>\n</figure>\n","individual":false},{"label":"Time and number buckets","html":"<figure class=\"chart-frame\" style=\"margin: 0\">\n  <h3 class=\"chart-title\">When orders arrive, and how large they are</h3>\n  <div class=\"flex flex-wrap items-end gap-3 mb-3\">\n    <label class=\"grid gap-1 text-sm\"\n      >Bucket\n      <select class=\"select\" data-size=\"sm\" id=\"buckets-unit\">\n        <option value=\"day\">Day</option>\n        <option value=\"week\">Week</option>\n        <option value=\"month\" selected>Month</option>\n      </select>\n    </label>\n  </div>\n  <div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n    <div\n      class=\"chart\"\n      id=\"buckets-time\"\n      role=\"img\"\n      aria-label=\"Orders per month of the year, rising\"\n      style=\"height: 13rem\"\n    ></div>\n    <div\n      class=\"chart\"\n      id=\"buckets-size\"\n      role=\"img\"\n      aria-label=\"Histogram of order amounts in bins of 10 EUR\"\n      style=\"height: 13rem\"\n    ></div>\n  </div>\n  <figcaption class=\"chart-source\">250,000 synthetic orders · grouped with df$.dataview</figcaption>\n</figure>\n","individual":false},{"label":"Cross-filtering a grid","html":"<div class=\"grid gap-3\">\n  <p class=\"text-sm\" style=\"margin: 0\"><output id=\"cross-info\">Generating 200,000 orders...</output></p>\n  <div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n    <div\n      class=\"chart\"\n      id=\"cross-region\"\n      role=\"img\"\n      aria-label=\"Revenue by region of the orders the grid shows\"\n      style=\"height: 11rem\"\n    ></div>\n    <div\n      class=\"chart\"\n      id=\"cross-channel\"\n      role=\"img\"\n      aria-label=\"Orders by channel of the orders the grid shows\"\n      style=\"height: 11rem\"\n    ></div>\n  </div>\n  <div\n    class=\"data-grid\"\n    id=\"cross-grid\"\n    aria-label=\"Orders\"\n    data-persist=\"none\"\n    data-empty-text=\"No order matches.\"\n    style=\"height: 18rem\"\n  >\n    <div class=\"data-grid-viewport\">\n      <div class=\"data-grid-head\">\n        <div class=\"data-grid-row\">\n          <div class=\"data-grid-header\" data-field=\"id\" data-type=\"number\" data-format=\"\" data-width=\"6rem\">Id</div>\n          <div class=\"data-grid-header\" data-field=\"region\" data-width=\"8rem\" data-filter=\"select\">Region</div>\n          <div class=\"data-grid-header\" data-field=\"channel\" data-width=\"8rem\" data-filter=\"select\">Channel</div>\n          <div\n            class=\"data-grid-header\"\n            data-field=\"amount\"\n            data-type=\"number\"\n            data-format=\"currency:EUR\"\n            data-width=\"8rem\"\n            data-filter=\"number\"\n            >Amount</div\n          >\n          <div class=\"data-grid-header\" data-field=\"customer\" data-width=\"9rem\" data-filter=\"text\">Customer</div>\n        </div>\n      </div>\n      <div class=\"data-grid-body\"></div>\n    </div>\n  </div>\n</div>\n","individual":false},{"label":"Top countries and the rest","html":"<figure class=\"chart-frame\" style=\"margin: 0\">\n  <h3 class=\"chart-title\">Orders by country</h3>\n  <div\n    class=\"chart\"\n    id=\"top-countries\"\n    role=\"img\"\n    aria-label=\"Donut of orders by country: the six largest and the other eighteen as one slice\"\n    style=\"height: 15rem\"\n  ></div>\n  <figcaption class=\"chart-source\">250,000 synthetic orders · limit 6, other: 'the other 18'</figcaption>\n</figure>\n","individual":false}]
