[{"label":"Neo-Brutalist Zine","html":"<section\n  class=\"presentation\"\n  id=\"deck-diverging\"\n  data-anim-in=\"popIn\"\n  data-anim-out=\"skewOut\"\n  style=\"\n    --presentation-ink: #111111;\n    --presentation-ink-foreground: #fffdf4;\n    --presentation-paper: #ffe550;\n    --presentation-paper-foreground: #111111;\n    --presentation-accent: #ff3b30;\n    font-family: Arial, Helvetica, sans-serif;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"The four-day week - who is for it\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Net support for a four-day week by industry, from plus 48 in tech to minus 27 in finance, split into support and opposition, plotted against remote-work share, and pilot results\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Cover\">\n    <div\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        right: 140px;\n        top: 130px;\n        rotate: 9deg;\n        background: #ff3b30;\n        color: #fffdf4;\n        border: 6px solid #111;\n        box-shadow: 14px 14px 0 #111;\n        padding: 1.5rem 2.5rem;\n        font:\n          900 3rem/1 'Arial Black',\n          Arial,\n          sans-serif;\n      \"\n      >4 DAYS?</div\n    >\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\"\n      >Diverging bars · Neo-Brutalist Zine</p\n    >\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        position: relative;\n        max-width: 1250px;\n        font-family: 'Arial Black', Arial, sans-serif;\n        text-transform: uppercase;\n        letter-spacing: -0.02em;\n        font-size: 6rem;\n        max-width: 1050px;\n      \"\n      >Who wants a four-day week?</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >8 industries, 12,400 workers asked - and a zero line that splits the room.</p\n    >\n    <p class=\"presentation-note\">Loud on purpose: the sticker is the question.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"net\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Net support\"\n  >\n    <header class=\"presentation-header\"><span>Net support</span><span>support − oppose, % points</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Arial Black', Arial, sans-serif;\n        text-transform: uppercase;\n        letter-spacing: -0.02em;\n      \"\n      >Tech says yes. Finance says no.</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Everything right of zero wants it; everything left does not.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"split\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Support vs oppose\"\n  >\n    <header class=\"presentation-header\"><span>The split</span><span>% of workers</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Arial Black', Arial, sans-serif;\n        text-transform: uppercase;\n        letter-spacing: -0.02em;\n      \"\n      >Nowhere is it unanimous</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The net bars split into their two halves - even tech has 16% against.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"remote\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Remote work\"\n  >\n    <header class=\"presentation-header\"><span>Why</span><span>net support × remote-capable jobs</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Arial Black', Arial, sans-serif;\n        text-transform: uppercase;\n        letter-spacing: -0.02em;\n      \"\n      >Flexibility predicts support - except in finance</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The bars become dots: x is how many jobs can be done remotely.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Three numbers</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: 'Arial Black', Arial, sans-serif;\n            text-transform: uppercase;\n            letter-spacing: -0.02em;\n          \"\n          >+<span data-count=\"48\">48</span></p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">net support in tech</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #ff3b30;\n            font-family: 'Arial Black', Arial, sans-serif;\n            text-transform: uppercase;\n            letter-spacing: -0.02em;\n          \"\n          >−<span data-count=\"27\">27</span></p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">net support in finance</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: 'Arial Black', Arial, sans-serif;\n            text-transform: uppercase;\n            letter-spacing: -0.02em;\n          \"\n          ><span data-count=\"56\">56</span>/61</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">pilot firms kept the four-day week</p>\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >The people who tried it mostly kept it. The people who did not try it mostly fear it.</p\n    >\n    <p class=\"presentation-note\">The pilot number is the pivot of the talk.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Time\">\n    <header class=\"presentation-header\"><span>The real question</span><span>32 hours, same pay</span></header>\n    <div style=\"display: flex; gap: 4.5rem; align-items: center; margin-top: 3.5rem\">\n      <div style=\"flex: 1 1 0; min-width: 0\">\n        <h2\n          class=\"presentation-title\"\n          data-df-entrance=\"up\"\n          style=\"\n            font-size: 3.4rem;\n            font-family: 'Arial Black', Arial, sans-serif;\n            text-transform: uppercase;\n            letter-spacing: -0.02em;\n          \"\n          >It is not about Fridays. It is about hours.</h2\n        >\n        <p class=\"presentation-lede\" data-df-entrance=\"fade\" style=\"--df-motion-delay: 300ms; font-size: 1.7rem\"\n          >Every pilot kept pay flat and cut hours to 32. The hard part was meetings, not Fridays.</p\n        >\n      </div>\n      <figure\n        class=\"image\"\n        data-ratio=\"4/3\"\n        data-df-entrance=\"skew\"\n        style=\"--df-motion-delay: 150ms; flex: 0 0 700px; margin: 0\"\n      >\n        <img\n          src=\"https://picsum.photos/id/4/960/720\"\n          alt=\"A person with a wristwatch writing in a notebook beside a laptop\"\n          loading=\"lazy\"\n          width=\"960\"\n          height=\"720\"\n          style=\"width: 100%; height: 100%; object-fit: cover\"\n        />\n        <figcaption class=\"image-caption\" style=\"font-size: 1.25rem\">Planning a shorter week (stock photo).</figcaption>\n      </figure>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Hours, not days - say it twice.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"east\"\n    data-anim-in-blocks=\"4\"\n    data-anim-in-color=\"#FF3B30\"\n    aria-label=\"Survey table\"\n  >\n    <header class=\"presentation-header\"><span>The survey</span><span>12,400 workers</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" style=\"font-size: 1.45rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Would you want a 32-hour, four-day week at the same pay? (synthetic survey).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Industry</th><th class=\"table-head\" style=\"text-align: right\">Support</th\n            ><th class=\"table-head\" style=\"text-align: right\">Neutral</th\n            ><th class=\"table-head\" style=\"text-align: right\">Oppose</th\n            ><th class=\"table-head\" style=\"text-align: right\">Net</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Tech</td><td class=\"table-cell\" style=\"text-align: right\">64%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">20%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">16%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+48</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Design & media</td><td class=\"table-cell\" style=\"text-align: right\">60%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">21%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">19%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+41</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Education</td><td class=\"table-cell\" style=\"text-align: right\">51%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">20%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">29%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+22</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Healthcare</td><td class=\"table-cell\" style=\"text-align: right\">44%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">21%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">35%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+9</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Retail</td><td class=\"table-cell\" style=\"text-align: right\">38%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">18%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">44%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">−6</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Logistics</td><td class=\"table-cell\" style=\"text-align: right\">34%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">18%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">48%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">−14</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Manufacturing</td><td class=\"table-cell\" style=\"text-align: right\">30%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">19%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">51%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">−21</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Finance</td><td class=\"table-cell\" style=\"text-align: right\">28%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">17%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">55%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">−27</td></tr\n          >\n        </tbody>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Neutral is not nothing - a fifth of every industry is undecided.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"\n          font-size: 3.3rem;\n          line-height: 1.22;\n          font-family: 'Arial Black', Arial, sans-serif;\n          text-transform: uppercase;\n          letter-spacing: -0.02em;\n          font-size: 2.8rem;\n        \"\n        >“Our shifts cannot shrink. A four-day week for the office means a five-day week for the warehouse.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"\n          width: 6.5rem;\n          height: 6.5rem;\n          font-size: 2.25rem;\n          background: #ffe550;\n          color: #111;\n          border: 4px solid #111;\n        \"\n        ><span class=\"avatar-fallback\">DK</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Dana Kowalczyk<br /><span style=\"opacity: 0.7; font-size: 1.4rem\"\n          >Logistics shift lead - 140 people on rota</span\n        ></p\n      >\n    </div>\n    <p class=\"presentation-note\">The opposition has a real argument - give it the stage.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"pilot\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Pilot results\"\n  >\n    <header class=\"presentation-header\"><span>The pilot</span><span>61 firms · 12 months · vs prior year</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Arial Black', Arial, sans-serif;\n        text-transform: uppercase;\n        letter-spacing: -0.02em;\n      \"\n      >What changed in the pilot firms</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The dots regroup as pilot outcomes: less of the bad, revenue flat to up.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Questions from the floor\"\n  >\n    <header class=\"presentation-header\"><span>Q & A</span><span>Union meeting</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.2rem;\n        margin-block: 5.25rem 1.5rem;\n        font-family: 'Arial Black', Arial, sans-serif;\n        text-transform: uppercase;\n        letter-spacing: -0.02em;\n      \"\n      >Questions from the floor</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"dv-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Did productivity drop?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\">Revenue per firm rose 2% on average - within noise, but not down.</p></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"dv-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>What about shift work?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Pilots used rotating fourth days; 9 of the 61 firms ran 24/7 operations.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"dv-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Why did 5 firms stop?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\">Client coverage: all five were small agencies with one client each.</p></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Take the productivity question head-on.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Takeaways</span><span>No fluff</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">■</span\n        ><span>Support tracks flexibility - start where the work can move.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">■</span\n        ><span>Finance is the outlier: remote-capable, still opposed. Ask why.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">■</span\n        ><span>Design shift work first, or the warehouse pays for the office.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">■</span\n        ><span>Pilot, measure, keep what works - 56 of 61 did.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Short, loud, done.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"west\"\n    data-anim-in-blocks=\"4\"\n    data-anim-in-color=\"#FF3B30\"\n    aria-label=\"Closing\"\n  >\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        font-family: 'Arial Black', Arial, sans-serif;\n        text-transform: uppercase;\n        letter-spacing: -0.02em;\n      \"\n      >Zero is a line, not an answer</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px\"\n      >Synthetic survey, real debate - every bar left of zero is a conversation to have.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">End loud.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 12</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"12\" value=\"1\"></progress>\n</section>\n","individual":false}]
