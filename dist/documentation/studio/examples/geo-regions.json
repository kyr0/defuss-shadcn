[{"label":"Pick countries","html":"<div class=\"grid gap-3\">\n  <div\n    class=\"geo-map\"\n    id=\"picker\"\n    aria-label=\"Pick countries\"\n    data-select=\"multiple\"\n    data-center=\"10,48\"\n    data-zoom=\"3.5\"\n  ></div>\n  <div class=\"flex flex-wrap items-center gap-3\">\n    <button\n      class=\"btn\"\n      data-variant=\"outline\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-geo-for=\"picker\"\n      data-geo-action=\"clear\"\n      >Clear</button\n    >\n    <span class=\"text-sm\">Picked: <output data-geo-for=\"picker\" data-geo-output=\"selection\"></output></span>\n  </div>\n</div>\n","individual":false},{"label":"Four ways to show a selection","html":"<div class=\"grid gap-3\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); --geo-map-height: 15rem\">\n  <div\n    class=\"geo-map\"\n    aria-label=\"Fill\"\n    data-selected=\"country:ESP country:SWE\"\n    data-center=\"12,52\"\n    data-zoom=\"3.6\"\n  ></div>\n  <div\n    class=\"geo-map\"\n    aria-label=\"Outline\"\n    data-highlight=\"outline\"\n    data-selected=\"country:ESP country:SWE\"\n    data-center=\"12,52\"\n    data-zoom=\"3.6\"\n  ></div>\n  <div\n    class=\"geo-map\"\n    aria-label=\"Pulse\"\n    data-highlight=\"pulse\"\n    data-selected=\"country:ESP country:SWE\"\n    data-center=\"12,52\"\n    data-zoom=\"3.6\"\n  ></div>\n  <div\n    class=\"geo-map\"\n    aria-label=\"Lift\"\n    data-highlight=\"lift\"\n    data-selected=\"country:ESP country:SWE\"\n    data-center=\"12,52\"\n    data-zoom=\"3.6\"\n  ></div>\n</div>\n","individual":false},{"label":"One region after another","html":"<div class=\"grid gap-3\">\n  <div\n    class=\"geo-map\"\n    id=\"tour\"\n    aria-label=\"The Nordic countries\"\n    data-highlight=\"lift\"\n    data-palette=\"ocean\"\n    data-center=\"15,62\"\n    data-zoom=\"4.2\"\n  ></div>\n  <div class=\"flex items-center gap-3\">\n    <button class=\"btn\" data-size=\"sm\" type=\"button\" id=\"tour-play\">Play</button>\n    <span class=\"text-sm\">Now: <output data-geo-for=\"tour\" data-geo-output=\"selection\"></output></span>\n  </div>\n</div>\n","individual":false},{"label":"A choropleth","html":"<div\n  class=\"geo-map\"\n  id=\"share\"\n  aria-label=\"Share by country (illustrative)\"\n  data-palette=\"mono\"\n  data-center=\"10,50\"\n  data-zoom=\"5.5\"\n  data-projection=\"mercator\"\n></div>\n","individual":false}]
