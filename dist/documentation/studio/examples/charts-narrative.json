[{"label":"Story: claims sequence","html":"<figure class=\"chart-frame\" style=\"margin: 0\">\n  <h3 class=\"chart-title\">Adoption by product line, told in three claims</h3>\n  <p class=\"chart-dek\">1 · establish the baseline - 2 · add the comparison - 3 · reframe as composition.</p>\n  <div style=\"display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"story-prev\">← Prev</button>\n    <button class=\"btn\" data-size=\"sm\" id=\"story-next\">Next story step →</button>\n    <span class=\"badge\" data-variant=\"secondary\" id=\"story-step\">1 / 3</span>\n  </div>\n  <div\n    class=\"chart\"\n    data-size=\"lg\"\n    id=\"story-chart\"\n    role=\"img\"\n    aria-label=\"Bar chart of adoption by product line, morphing through baseline, comparison and composition states\"\n  ></div>\n  <figcaption class=\"chart-source\">Synthetic data · adapted from echarts-feat 32-story-state-machine</figcaption>\n</figure>\n","individual":false},{"label":"Morph: bar → donut → scatter","html":"<figure class=\"chart-frame\" style=\"margin: 0\">\n  <h3 class=\"chart-title\">One dataset, three geometries</h3>\n  <p class=\"chart-dek\">Identity is carried by a stable series id plus named data points - the form is just a lens.</p>\n  <div style=\"display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-morph=\"bar\">Bars</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-morph=\"pie\">Donut</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-morph=\"scatter\">Dots</button>\n    <button class=\"btn\" data-size=\"sm\" id=\"morph-cycle\">Pause cycler</button>\n  </div>\n  <div\n    class=\"chart\"\n    id=\"morph-chart\"\n    role=\"img\"\n    aria-label=\"Five data points morphing between bar, donut and scatter charts\"\n  ></div>\n  <figcaption class=\"chart-source\">Synthetic data · adapted from echarts-feat 27-universal-transition</figcaption>\n</figure>\n","individual":false},{"label":"Bar race","html":"<figure class=\"chart-frame\" style=\"margin: 0\">\n  <h3 class=\"chart-title\">Regional share over five quarters</h3>\n  <p class=\"chart-dek\"\n    >The leader keeps the accent color as ranks change hands - identity follows the data, not the slot.</p\n  >\n  <div style=\"display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem\">\n    <button class=\"btn\" data-size=\"sm\" id=\"race-toggle\">Run race</button>\n    <span class=\"badge\" data-variant=\"secondary\" id=\"race-frame\">Q1 / 5</span>\n  </div>\n  <div\n    class=\"chart\"\n    id=\"race-chart\"\n    role=\"img\"\n    aria-label=\"Animated bar race of regional share over five quarters\"\n  ></div>\n  <figcaption class=\"chart-source\">Synthetic data · adapted from echarts-feat 09-bar-race</figcaption>\n</figure>\n","individual":false},{"label":"Custom series boundary","html":"<figure class=\"chart-frame\" style=\"margin: 0\">\n  <h3 class=\"chart-title\">Vector field over a 15 × 9 grid</h3>\n  <p class=\"chart-dek\"\n    >Speed is encoded through visualMap; direction is pure renderItem geometry on standard value axes.</p\n  >\n  <div\n    class=\"chart\"\n    data-size=\"lg\"\n    id=\"wind-chart\"\n    role=\"img\"\n    aria-label=\"Custom-series field of wind-vector glyphs, color-mapped by speed\"\n  ></div>\n  <figcaption class=\"chart-source\">Synthetic data · adapted from echarts-feat 31-custom-wind-vectors</figcaption>\n</figure>\n","individual":false}]
