[{"label":"Search & Filter (sm)","html":"<div class=\"search-box\" data-size=\"sm\">\n  <i data-lucide=\"search\"></i>\n  <input type=\"search\" value=\"small\" aria-label=\"Small search\" />\n  <button type=\"button\" class=\"search-box-clear\" aria-label=\"Clear search\"></button>\n</div>\n","individual":true},{"label":"Search & Filter (lg)","html":"<div class=\"search-box\" data-size=\"lg\">\n  <i data-lucide=\"search\"></i>\n  <input type=\"search\" value=\"large\" aria-label=\"Large search\" />\n  <button type=\"button\" class=\"search-box-clear\" aria-label=\"Clear search\"></button>\n</div>\n","individual":true},{"label":"Search & Filter (muted)","html":"<div class=\"search-box\" data-variant=\"muted\">\n  <i data-lucide=\"search\"></i>\n  <input type=\"search\" placeholder=\"Search messages\" aria-label=\"Search messages\" />\n  <span class=\"search-box-hint\">in #general</span>\n  <button type=\"button\" class=\"search-box-clear\" aria-label=\"Clear search\"></button>\n</div>\n","individual":true},{"label":"Search box","html":"<search style=\"max-width: 22rem\">\n  <div class=\"search-box\">\n    <i data-lucide=\"search\"></i>\n    <input type=\"search\" name=\"q\" placeholder=\"Search…\" aria-label=\"Search\" />\n    <button type=\"button\" class=\"search-box-clear\" aria-label=\"Clear search\"></button>\n  </div>\n</search>\n","individual":true},{"label":"Live results","html":"<div class=\"flex flex-col gap-3\" style=\"max-width: 22rem\">\n  <div class=\"search-box\">\n    <i data-lucide=\"search\"></i>\n    <input type=\"search\" id=\"people-q\" placeholder=\"Filter people\" aria-label=\"Filter people\" aria-controls=\"people\" />\n    <button type=\"button\" class=\"search-box-clear\" aria-label=\"Clear search\"></button>\n  </div>\n  <output for=\"people-q\" class=\"text-sm text-muted-foreground\" id=\"people-count\">6 people</output>\n  <ul id=\"people\" class=\"text-sm m-0 ps-5 flex flex-col gap-1\">\n    <li>Ada Lovelace</li>\n    <li>Alan Turing</li>\n    <li>Grace Hopper</li>\n    <li>Katherine Johnson</li>\n    <li>Linus Torvalds</li>\n    <li>Margaret Hamilton</li>\n  </ul>\n</div>\n","individual":false},{"label":"Searching","html":"<div class=\"flex flex-col gap-3\" style=\"max-width: 22rem\">\n  <div class=\"search-box\" id=\"remote-search\">\n    <i data-lucide=\"search\"></i>\n    <input type=\"search\" placeholder=\"Search the archive\" aria-label=\"Search the archive\" />\n    <button type=\"button\" class=\"search-box-clear\" aria-label=\"Clear search\"></button>\n  </div>\n  <output class=\"text-sm text-muted-foreground\" id=\"remote-result\">Type to search 2,400 reports.</output>\n</div>\n","individual":false},{"label":"Shortcut hint, pill and muted","html":"<div class=\"flex flex-col gap-4\" style=\"max-width: 22rem\">\n  <div class=\"search-box\" data-shape=\"pill\">\n    <i data-lucide=\"search\"></i>\n    <input type=\"search\" placeholder=\"Search docs\" aria-label=\"Search docs\" />\n    <kbd class=\"kbd\" data-size=\"sm\">⌘K</kbd>\n    <button type=\"button\" class=\"search-box-clear\" aria-label=\"Clear search\"></button>\n  </div>\n  <div class=\"search-box\" data-variant=\"muted\">\n    <i data-lucide=\"search\"></i>\n    <input type=\"search\" placeholder=\"Search messages\" aria-label=\"Search messages\" />\n    <span class=\"search-box-hint\">in #general</span>\n    <button type=\"button\" class=\"search-box-clear\" aria-label=\"Clear search\"></button>\n  </div>\n</div>\n","individual":false},{"label":"Search box sizes","html":"<div class=\"flex flex-col gap-3\" style=\"max-width: 22rem\">\n  <div class=\"search-box\" data-size=\"sm\">\n    <i data-lucide=\"search\"></i>\n    <input type=\"search\" value=\"small\" aria-label=\"Small search\" />\n    <button type=\"button\" class=\"search-box-clear\" aria-label=\"Clear search\"></button>\n  </div>\n  <div class=\"search-box\">\n    <i data-lucide=\"search\"></i>\n    <input type=\"search\" value=\"default\" aria-label=\"Default search\" />\n    <button type=\"button\" class=\"search-box-clear\" aria-label=\"Clear search\"></button>\n  </div>\n  <div class=\"search-box\" data-size=\"lg\">\n    <i data-lucide=\"search\"></i>\n    <input type=\"search\" value=\"large\" aria-label=\"Large search\" />\n    <button type=\"button\" class=\"search-box-clear\" aria-label=\"Clear search\"></button>\n  </div>\n</div>\n","individual":false},{"label":"Disabled and invalid","html":"<div class=\"flex flex-col gap-3\" style=\"max-width: 22rem\">\n  <div class=\"search-box\">\n    <i data-lucide=\"search\"></i>\n    <input type=\"search\" placeholder=\"Search is offline\" aria-label=\"Search\" disabled />\n    <button type=\"button\" class=\"search-box-clear\" aria-label=\"Clear search\"></button>\n  </div>\n  <div class=\"search-box\">\n    <i data-lucide=\"search\"></i>\n    <input type=\"search\" value=\"a\" aria-label=\"Search\" aria-invalid=\"true\" aria-describedby=\"short-q\" />\n    <button type=\"button\" class=\"search-box-clear\" aria-label=\"Clear search\"></button>\n  </div>\n  <p class=\"field-error\" id=\"short-q\">Type at least 2 characters.</p>\n</div>\n","individual":false},{"label":"Filter","html":"<form class=\"filter\" aria-label=\"Framework\">\n  <input type=\"radio\" name=\"framework\" value=\"svelte\" aria-label=\"Svelte\" />\n  <input type=\"radio\" name=\"framework\" value=\"vue\" aria-label=\"Vue\" />\n  <input type=\"radio\" name=\"framework\" value=\"react\" aria-label=\"React\" />\n  <input type=\"reset\" value=\"×\" aria-label=\"Clear filter\" />\n</form>\n","individual":false},{"label":"Without a form","html":"<div class=\"filter\" role=\"radiogroup\" aria-label=\"Meta framework\">\n  <input type=\"radio\" name=\"meta\" value=\"sveltekit\" aria-label=\"SvelteKit\" />\n  <input type=\"radio\" name=\"meta\" value=\"nuxt\" aria-label=\"Nuxt\" />\n  <input type=\"radio\" name=\"meta\" value=\"next\" aria-label=\"Next.js\" />\n  <input type=\"radio\" name=\"meta\" class=\"filter-reset\" aria-label=\"All\" />\n</div>\n","individual":false},{"label":"Checkboxes","html":"<form class=\"filter\" aria-label=\"Frameworks\">\n  <input type=\"checkbox\" name=\"frameworks\" value=\"svelte\" aria-label=\"Svelte\" />\n  <input type=\"checkbox\" name=\"frameworks\" value=\"vue\" aria-label=\"Vue\" />\n  <input type=\"checkbox\" name=\"frameworks\" value=\"react\" aria-label=\"React\" />\n  <input type=\"reset\" value=\"×\" aria-label=\"Clear filters\" />\n</form>\n","individual":false},{"label":"Several at once","html":"<form class=\"filter\" data-multiple data-shape=\"pill\" aria-label=\"Categories\">\n  <input type=\"checkbox\" name=\"cat\" value=\"design\" aria-label=\"Design\" />\n  <input type=\"checkbox\" name=\"cat\" value=\"code\" aria-label=\"Code\" />\n  <input type=\"checkbox\" name=\"cat\" value=\"writing\" aria-label=\"Writing\" />\n  <input type=\"checkbox\" name=\"cat\" value=\"video\" aria-label=\"Video\" />\n  <input type=\"checkbox\" name=\"cat\" value=\"audio\" aria-label=\"Audio\" />\n  <input type=\"reset\" value=\"×\" aria-label=\"Clear filters\" />\n</form>\n","individual":false},{"label":"Filtering content with :has()","html":"<style>\n  .catalog:has([value='design']:checked) .catalog-item:not([data-cat='design']),\n  .catalog:has([value='code']:checked) .catalog-item:not([data-cat='code']),\n  .catalog:has([value='writing']:checked) .catalog-item:not([data-cat='writing']) {\n    display: none;\n  }\n</style>\n<div class=\"catalog flex flex-col gap-3\">\n  <div class=\"filter\" role=\"radiogroup\" aria-label=\"Category\" data-size=\"sm\">\n    <input type=\"radio\" name=\"catalog\" value=\"design\" aria-label=\"Design\" />\n    <input type=\"radio\" name=\"catalog\" value=\"code\" aria-label=\"Code\" />\n    <input type=\"radio\" name=\"catalog\" value=\"writing\" aria-label=\"Writing\" />\n    <input type=\"radio\" name=\"catalog\" class=\"filter-reset\" aria-label=\"All\" />\n  </div>\n  <ul class=\"m-0 p-0 flex flex-wrap gap-2\" style=\"list-style: none\">\n    <li class=\"catalog-item badge\" data-variant=\"outline\" data-cat=\"design\">Color systems</li>\n    <li class=\"catalog-item badge\" data-variant=\"outline\" data-cat=\"code\">CSS nesting</li>\n    <li class=\"catalog-item badge\" data-variant=\"outline\" data-cat=\"writing\">Microcopy</li>\n    <li class=\"catalog-item badge\" data-variant=\"outline\" data-cat=\"design\">Type scales</li>\n    <li class=\"catalog-item badge\" data-variant=\"outline\" data-cat=\"code\">Popover API</li>\n    <li class=\"catalog-item badge\" data-variant=\"outline\" data-cat=\"writing\">Release notes</li>\n  </ul>\n</div>\n","individual":false},{"label":"Search and filter together","html":"<div class=\"flex flex-col gap-3\" style=\"max-width: 26rem\">\n  <div class=\"search-box\">\n    <i data-lucide=\"search\"></i>\n    <input type=\"search\" id=\"lib-q\" placeholder=\"Search articles\" aria-label=\"Search articles\" aria-controls=\"lib\" />\n    <button type=\"button\" class=\"search-box-clear\" aria-label=\"Clear search\"></button>\n  </div>\n  <form class=\"filter\" id=\"lib-filter\" data-size=\"sm\" aria-label=\"Category\">\n    <input type=\"radio\" name=\"cat\" value=\"guide\" aria-label=\"Guides\" />\n    <input type=\"radio\" name=\"cat\" value=\"api\" aria-label=\"API\" />\n    <input type=\"radio\" name=\"cat\" value=\"news\" aria-label=\"News\" />\n    <input type=\"reset\" value=\"×\" aria-label=\"Clear filter\" />\n  </form>\n  <output class=\"text-sm text-muted-foreground\" id=\"lib-count\">6 articles</output>\n  <ul id=\"lib\" class=\"text-sm m-0 ps-5 flex flex-col gap-1\">\n    <li data-cat=\"guide\">Getting started with themes</li>\n    <li data-cat=\"guide\">Dark mode in one attribute</li>\n    <li data-cat=\"api\">The State API</li>\n    <li data-cat=\"api\">Schema contracts</li>\n    <li data-cat=\"news\">Release 0.9: chat and mockups</li>\n    <li data-cat=\"news\">Search & Filter lands</li>\n  </ul>\n</div>\n","individual":false},{"label":"Filter variants and sizes","html":"<div class=\"flex flex-col gap-3\">\n  <div class=\"filter\" data-variant=\"secondary\" role=\"radiogroup\" aria-label=\"Plan\">\n    <input type=\"radio\" name=\"plan\" aria-label=\"Free\" checked />\n    <input type=\"radio\" name=\"plan\" aria-label=\"Pro\" />\n    <input type=\"radio\" name=\"plan\" class=\"filter-reset\" aria-label=\"All plans\" />\n  </div>\n  <div class=\"filter\" data-variant=\"outline\" data-shape=\"pill\" data-multiple role=\"group\" aria-label=\"Status\">\n    <input type=\"checkbox\" aria-label=\"Open\" checked />\n    <input type=\"checkbox\" aria-label=\"In review\" />\n    <input type=\"checkbox\" aria-label=\"Closed\" disabled />\n  </div>\n  <div class=\"filter\" data-size=\"sm\" data-multiple role=\"group\" aria-label=\"Small\">\n    <input type=\"checkbox\" aria-label=\"Small\" />\n    <input type=\"checkbox\" aria-label=\"Chips\" />\n  </div>\n  <div class=\"filter\" data-size=\"lg\" data-multiple role=\"group\" aria-label=\"Large\">\n    <input type=\"checkbox\" aria-label=\"Large\" />\n    <input type=\"checkbox\" aria-label=\"Chips\" />\n  </div>\n</div>\n","individual":false}]
