[{"label":"Europe, framed, two countries picked","html":"<div\n  class=\"geo-map\"\n  aria-label=\"Europe with France and Germany picked\"\n  data-focus=\"continent:Europe\"\n  data-selected=\"country:FRA country:DEU\"\n></div>\n","individual":true},{"label":"Munich to Berlin","html":"<div\n  class=\"geo-map\"\n  aria-label=\"Munich to Berlin\"\n  data-projection=\"mercator\"\n  data-center=\"11.5,50.3\"\n  data-zoom=\"9\"\n  data-palette=\"mono\"\n>\n  \n</div>\n","individual":true},{"label":"Five projections","html":"<div class=\"grid gap-3\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); --geo-map-height: 15rem\">\n  <div class=\"geo-map\" aria-label=\"Equal Earth\" data-palette=\"ocean\"></div>\n  <div\n    class=\"geo-map\"\n    aria-label=\"Equal area\"\n    data-projection=\"equalArea\"\n    data-center=\"15,50\"\n    data-palette=\"chart\"\n  ></div>\n  <div class=\"geo-map\" aria-label=\"Mercator\" data-projection=\"mercator\" data-palette=\"forest\"></div>\n  <div class=\"geo-map\" aria-label=\"Equirectangular\" data-projection=\"equirectangular\" data-palette=\"sunset\"></div>\n  <div class=\"geo-map\" aria-label=\"Globe\" data-projection=\"orthographic\" data-center=\"10,30\" data-palette=\"heat\"></div>\n</div>\n","individual":false},{"label":"Real sizes: Greenland and the DR Congo","html":"<div class=\"grid gap-3\" style=\"grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); --geo-map-height: 18rem\">\n  <div\n    class=\"geo-map\"\n    aria-label=\"Mercator: Greenland drawn larger than the DR Congo\"\n    data-projection=\"mercator\"\n    data-center=\"-10,30\"\n    data-zoom=\"1.3\"\n    data-selected=\"country:GRL country:COD\"\n    data-palette=\"mono\"\n  ></div>\n  <div\n    class=\"geo-map\"\n    aria-label=\"Equal area: Greenland and the DR Congo at their real sizes\"\n    data-projection=\"equalArea\"\n    data-center=\"-10,35\"\n    data-zoom=\"1.3\"\n    data-selected=\"country:GRL country:COD\"\n    data-palette=\"mono\"\n  ></div>\n</div>\n","individual":false},{"label":"Continents, and the states of the Alps","html":"<div class=\"grid gap-3\" style=\"grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); --geo-map-height: 18rem\">\n  <div class=\"geo-map\" aria-label=\"Continents\" data-level=\"continent\" data-palette=\"chart\"></div>\n  <div\n    class=\"geo-map\"\n    aria-label=\"States around the Alps\"\n    data-level=\"state\"\n    data-center=\"10.5,46.5\"\n    data-zoom=\"22\"\n    data-projection=\"mercator\"\n  ></div>\n</div>\n","individual":false},{"label":"Mono, chart and heat","html":"<div class=\"grid gap-3\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); --geo-map-height: 14rem\">\n  <div\n    class=\"geo-map\"\n    aria-label=\"Mono, cased\"\n    data-palette=\"mono\"\n    data-border=\"cased\"\n    data-center=\"15,50\"\n    data-zoom=\"4\"\n  ></div>\n  <div\n    class=\"geo-map\"\n    aria-label=\"Chart, dashed\"\n    data-palette=\"chart\"\n    data-border=\"dashed\"\n    data-center=\"15,50\"\n    data-zoom=\"4\"\n  ></div>\n  <div\n    class=\"geo-map\"\n    aria-label=\"Heat, no borders\"\n    data-palette=\"heat\"\n    data-border=\"none\"\n    data-graticule=\"false\"\n    data-center=\"15,50\"\n    data-zoom=\"4\"\n  ></div>\n</div>\n","individual":false}]
