[{"label":"Default","html":"<fieldset class=\"radio-group\">\n  <legend class=\"label\">Choose a plan</legend>\n  <div class=\"radio-item\">\n    <input class=\"radio\" type=\"radio\" name=\"plan\" id=\"free\" value=\"free\" checked />\n    <label for=\"free\">Free</label>\n  </div>\n  <div class=\"radio-item\">\n    <input class=\"radio\" type=\"radio\" name=\"plan\" id=\"pro\" value=\"pro\" />\n    <label for=\"pro\">Pro</label>\n  </div>\n  <div class=\"radio-item\">\n    <input class=\"radio\" type=\"radio\" name=\"plan\" id=\"ent\" value=\"enterprise\" />\n    <label for=\"ent\">Enterprise</label>\n  </div>\n</fieldset>\n","individual":true},{"label":"With Description","html":"<fieldset class=\"radio-group\">\n  <legend class=\"label\">Spacing</legend>\n  <div class=\"radio-item-block\">\n    <input class=\"radio\" type=\"radio\" name=\"spacing\" id=\"sp-default\" value=\"default\" checked />\n    <label for=\"sp-default\">Default</label>\n    <span class=\"radio-description\">Standard spacing for most use cases.</span>\n  </div>\n  <div class=\"radio-item-block\">\n    <input class=\"radio\" type=\"radio\" name=\"spacing\" id=\"sp-comfortable\" value=\"comfortable\" />\n    <label for=\"sp-comfortable\">Comfortable</label>\n    <span class=\"radio-description\">More space between elements.</span>\n  </div>\n</fieldset>\n","individual":true},{"label":"Choice Card","html":"<fieldset class=\"radio-group\">\n  <legend class=\"label\">Select a plan</legend>\n  <label class=\"radio-card\" for=\"c-plus\">\n    <input class=\"radio\" type=\"radio\" name=\"card\" id=\"c-plus\" value=\"plus\" />\n    <label for=\"c-plus\">Plus</label>\n    <span class=\"radio-description\">For individuals and small teams.</span>\n  </label>\n  <label class=\"radio-card\" for=\"c-pro\">\n    <input class=\"radio\" type=\"radio\" name=\"card\" id=\"c-pro\" value=\"pro\" checked />\n    <label for=\"c-pro\">Pro</label>\n    <span class=\"radio-description\">For growing businesses.</span>\n  </label>\n</fieldset>\n","individual":true},{"label":"Horizontal","html":"<fieldset class=\"radio-group\" data-orientation=\"horizontal\">\n  <legend class=\"label\">Alignment</legend>\n  <div class=\"radio-item\">\n    <input class=\"radio\" type=\"radio\" name=\"align\" id=\"left\" value=\"left\" checked />\n    <label for=\"left\">Left</label>\n  </div>\n  <div class=\"radio-item\">\n    <input class=\"radio\" type=\"radio\" name=\"align\" id=\"center\" value=\"center\" />\n    <label for=\"center\">Center</label>\n  </div>\n  <div class=\"radio-item\">\n    <input class=\"radio\" type=\"radio\" name=\"align\" id=\"right\" value=\"right\" />\n    <label for=\"right\">Right</label>\n  </div>\n</fieldset>\n","individual":true},{"label":"Disabled","html":"<fieldset class=\"radio-group\">\n  <legend class=\"label\">Disabled group</legend>\n  <div class=\"radio-item\">\n    <input class=\"radio\" type=\"radio\" name=\"dis\" id=\"d1\" disabled checked />\n    <label for=\"d1\">Option A</label>\n  </div>\n  <div class=\"radio-item\">\n    <input class=\"radio\" type=\"radio\" name=\"dis\" id=\"d2\" disabled />\n    <label for=\"d2\">Option B</label>\n  </div>\n</fieldset>\n","individual":true},{"label":"Invalid","html":"<fieldset class=\"radio-group\">\n  <legend class=\"label\">Notification Preferences</legend>\n  <p class=\"radio-group-description\">Choose how you want to receive notifications.</p>\n  <div class=\"radio-item\">\n    <input class=\"radio\" type=\"radio\" name=\"notif\" id=\"inv1\" value=\"email\" aria-invalid=\"true\" />\n    <label for=\"inv1\">Email only</label>\n  </div>\n  <div class=\"radio-item\">\n    <input class=\"radio\" type=\"radio\" name=\"notif\" id=\"inv2\" value=\"sms\" aria-invalid=\"true\" />\n    <label for=\"inv2\">SMS only</label>\n  </div>\n</fieldset>\n","individual":true},{"label":"The name makes the set","html":"<form class=\"flex flex-wrap gap-8\" onsubmit=\"event.preventDefault()\">\n  <fieldset class=\"radio-group\">\n    <legend class=\"label\">Shared name - one set</legend>\n    <div class=\"radio-item\">\n      <input class=\"radio\" type=\"radio\" name=\"size\" id=\"sz-s\" value=\"s\" checked />\n      <label for=\"sz-s\">Small</label>\n    </div>\n    <div class=\"radio-item\">\n      <input class=\"radio\" type=\"radio\" name=\"size\" id=\"sz-m\" value=\"m\" />\n      <label for=\"sz-m\">Medium</label>\n    </div>\n    <div class=\"radio-item\">\n      <input class=\"radio\" type=\"radio\" name=\"size\" id=\"sz-l\" value=\"l\" />\n      <label for=\"sz-l\">Large</label>\n    </div>\n  </fieldset>\n  <fieldset class=\"radio-group\">\n    <legend class=\"label\">Different names - broken</legend>\n    <div class=\"radio-item\">\n      <input class=\"radio\" type=\"radio\" name=\"size-small\" id=\"bad-s\" value=\"s\" />\n      <label for=\"bad-s\">Small</label>\n    </div>\n    <div class=\"radio-item\">\n      <input class=\"radio\" type=\"radio\" name=\"size-medium\" id=\"bad-m\" value=\"m\" />\n      <label for=\"bad-m\">Medium</label>\n    </div>\n    <div class=\"radio-item\">\n      <input class=\"radio\" type=\"radio\" name=\"size-large\" id=\"bad-l\" value=\"l\" />\n      <label for=\"bad-l\">Large</label>\n    </div>\n  </fieldset>\n  <p class=\"text-sm text-muted-foreground w-full m-0\">Form submits: <output id=\"size-out\">size=s</output></p>\n</form>\n","individual":false},{"label":"Density","html":"<div class=\"flex flex-wrap gap-8\">\n  <fieldset class=\"radio-group\" data-density=\"compact\">\n    <legend class=\"label\">Compact</legend>\n    <div class=\"radio-item\"\n      ><input class=\"radio\" type=\"radio\" name=\"den-a\" id=\"den-a1\" checked /><label for=\"den-a1\">Free</label></div\n    >\n    <div class=\"radio-item\"\n      ><input class=\"radio\" type=\"radio\" name=\"den-a\" id=\"den-a2\" /><label for=\"den-a2\">Pro</label></div\n    >\n  </fieldset>\n  <fieldset class=\"radio-group\" data-density=\"comfortable\">\n    <legend class=\"label\">Comfortable</legend>\n    <div class=\"radio-item\"\n      ><input class=\"radio\" type=\"radio\" name=\"den-b\" id=\"den-b1\" checked /><label for=\"den-b1\">Free</label></div\n    >\n    <div class=\"radio-item\"\n      ><input class=\"radio\" type=\"radio\" name=\"den-b\" id=\"den-b2\" /><label for=\"den-b2\">Pro</label></div\n    >\n  </fieldset>\n  <fieldset class=\"radio-group\" data-density=\"spacious\">\n    <legend class=\"label\">Spacious</legend>\n    <div class=\"radio-item\"\n      ><input class=\"radio\" type=\"radio\" name=\"den-c\" id=\"den-c1\" checked /><label for=\"den-c1\">Free</label></div\n    >\n    <div class=\"radio-item\"\n      ><input class=\"radio\" type=\"radio\" name=\"den-c\" id=\"den-c2\" /><label for=\"den-c2\">Pro</label></div\n    >\n  </fieldset>\n</div>\n","individual":false}]
