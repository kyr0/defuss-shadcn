[{"label":"Help on ?, search on /","html":"<div class=\"flex flex-col gap-3\" style=\"max-width: 24rem; outline: none\" tabindex=\"-1\" id=\"keys-demo\">\n  <p class=\"text-sm m-0\">Press <kbd>?</kbd> for help or <kbd>/</kbd> to search.</p>\n  <input class=\"input\" type=\"search\" id=\"keys-search\" placeholder=\"Search… (Esc to leave)\" aria-label=\"Search\" />\n  <p class=\"text-sm text-muted-foreground m-0\">Last shortcut: <output id=\"keys-last\">none</output></p>\n</div>\n<dialog class=\"dialog\" id=\"keys-help\" aria-labelledby=\"keys-help-title\">\n  <div class=\"dialog-content\">\n    <div class=\"dialog-header\">\n      <h2 class=\"dialog-title\" id=\"keys-help-title\">Keyboard shortcuts</h2>\n      <p class=\"dialog-description\"\n        ><kbd>?</kbd> this help · <kbd>/</kbd> focus search · <kbd>Esc</kbd> leave the field / close</p\n      >\n    </div>\n    <div class=\"dialog-footer\">\n      <button class=\"btn\" data-variant=\"default\" data-dialog-close>Got it</button>\n    </div>\n  </div>\n</dialog>\n","individual":false}]
