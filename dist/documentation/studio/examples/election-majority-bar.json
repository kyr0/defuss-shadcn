[{"label":"Live News Election Desk","html":"<section\n  class=\"presentation\"\n  id=\"deck-majority\"\n  data-anim-in=\"wipeIn\"\n  data-anim-in-direction=\"west\"\n  data-anim-out=\"wipeOut\"\n  style=\"\n    --presentation-ink: #101319;\n    --presentation-ink-foreground: #f5f6f8;\n    --presentation-paper: #f5f6f8;\n    --presentation-paper-foreground: #101319;\n    --presentation-accent: #d71920;\n    font-family: Arial, Helvetica, sans-serif;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"Election night in Port Aldwin - 71 seats, 36 to govern\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Seats in the fictional Port Aldwin council, 71 seats with 36 for a majority: City First 24, Harbour Greens 17, Social City 14, Liberal Voice 8, neighbourhood lists 5, others 3; three coalition options and votes versus seats\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Cover\">\n    <div\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        left: 0;\n        right: 0;\n        bottom: 0;\n        height: 70px;\n        display: flex;\n        align-items: center;\n        gap: 3rem;\n        padding-inline: 112px;\n        background: #d71920;\n        color: #ffffff;\n        font:\n          800 1.5rem/1 Arial,\n          sans-serif;\n        text-transform: uppercase;\n        letter-spacing: 0.04em;\n      \"\n    >\n      <span>● Live</span><span>Port Aldwin council · 71 seats</span><span>36 for a majority</span\n      ><span>100% counted</span>\n    </div>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\"\n      >Majority bar · Live News Election Desk</p\n    >\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"position: relative; max-width: 1250px; font-weight: 800; letter-spacing: -0.02em; font-size: 6rem\"\n      >Election night: who gets to 36?</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >Port Aldwin elects its 71-seat council. The only number that matters is the majority line.</p\n    >\n    <p class=\"presentation-note\">Studio tone: short sentences, one number.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"early\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Projection\"\n  >\n    <header class=\"presentation-header\"><span>20:15 · 20% counted</span><span>Projected seats</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 800;\n        letter-spacing: -0.02em;\n      \"\n      >Early projection: City First at 27</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">One bar, every seat - the red line is the majority.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"final\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Result\"\n  >\n    <header class=\"presentation-header\"><span>23:40 · 100% counted</span><span>Final seats</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 800;\n        letter-spacing: -0.02em;\n      \"\n      >Final result: City First 24 - twelve short</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Watch three seats move from City First to the Greens.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"coalitions\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Coalitions\"\n  >\n    <header class=\"presentation-header\"><span>The arithmetic</span><span>Options past 36</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 800;\n        letter-spacing: -0.02em;\n      \"\n      >Three ways past the line</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The single bar splits into the three coalitions that reach 36.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Three numbers from the night</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-weight: 800;\n            letter-spacing: -0.02em;\n          \"\n          ><span data-count=\"36\">36</span></p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">seats needed for a majority</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #d71920;\n            font-weight: 800;\n            letter-spacing: -0.02em;\n          \"\n          ><span data-count=\"24\">24</span></p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\"\n          >seats for City First - largest, not governing</p\n        >\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-weight: 800;\n            letter-spacing: -0.02em;\n          \"\n          >+<span data-count=\"7\">7</span></p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\"\n          >seats for the Harbour Greens vs last election</p\n        >\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >Turnout 58.4% - up six points on the last council vote.</p\n    >\n    <p class=\"presentation-note\">Read them like a presenter.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"The city\">\n    <header class=\"presentation-header\"><span>Port Aldwin</span><span>On the ground</span></header>\n    <div style=\"display: flex; gap: 4.5rem; align-items: center; margin-top: 3.5rem\">\n      <figure\n        class=\"image\"\n        data-ratio=\"4/3\"\n        data-df-entrance=\"right\"\n        style=\"--df-motion-delay: 150ms; flex: 0 0 700px; margin: 0\"\n      >\n        <img\n          src=\"https://picsum.photos/id/49/960/720\"\n          alt=\"White houses with blue accents on a hillside above the sea\"\n          loading=\"lazy\"\n          width=\"960\"\n          height=\"720\"\n          style=\"width: 100%; height: 100%; object-fit: cover\"\n        />\n        <figcaption class=\"image-caption\" style=\"font-size: 1.25rem\">The waterfront wards (stock photo).</figcaption>\n      </figure>\n      <div style=\"flex: 1 1 0; min-width: 0\">\n        <h2\n          class=\"presentation-title\"\n          data-df-entrance=\"up\"\n          style=\"font-size: 3.4rem; font-weight: 800; letter-spacing: -0.02em\"\n          >A harbour town decided on its waterfront</h2\n        >\n        <p class=\"presentation-lede\" data-df-entrance=\"fade\" style=\"--df-motion-delay: 300ms; font-size: 1.7rem\"\n          >The Greens won 7 of the 9 waterfront wards - on one issue: the new ferry terminal.</p\n        >\n      </div>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Local issue, local map.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"west\"\n    data-anim-in-blocks=\"6\"\n    data-anim-in-color=\"#D71920\"\n    aria-label=\"Result table\"\n  >\n    <header class=\"presentation-header\"><span>Official result</span><span>71 seats</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" style=\"font-size: 1.7rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Port Aldwin council election, final result (fictional).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Party</th><th class=\"table-head\" style=\"text-align: right\">Votes</th\n            ><th class=\"table-head\" style=\"text-align: right\">Seats</th\n            ><th class=\"table-head\" style=\"text-align: right\">Change</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">City First</td><td class=\"table-cell\" style=\"text-align: right\">32.1%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">24</td\n            ><td class=\"table-cell\" style=\"text-align: right\">−4</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Harbour Greens</td><td class=\"table-cell\" style=\"text-align: right\">23.4%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">17</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+7</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Social City</td><td class=\"table-cell\" style=\"text-align: right\">19.8%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">14</td\n            ><td class=\"table-cell\" style=\"text-align: right\">−2</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Liberal Voice</td><td class=\"table-cell\" style=\"text-align: right\">11.2%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">8</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+1</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Neighbourhood lists</td><td class=\"table-cell\" style=\"text-align: right\">7.4%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">5</td\n            ><td class=\"table-cell\" style=\"text-align: right\">0</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Others</td><td class=\"table-cell\" style=\"text-align: right\">6.1%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">3</td\n            ><td class=\"table-cell\" style=\"text-align: right\">−2</td></tr\n          >\n        </tbody>\n        <tfoot>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Total</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">100%</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">71</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\"></td\n          ></tr>\n        </tfoot>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Seat changes sum to zero.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"font-size: 3.3rem; line-height: 1.22; font-weight: 800; letter-spacing: -0.02em; font-size: 3rem\"\n        >“We won the most votes and lost the evening. In a council, you count to 36, not to first place.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #d71920; color: #f5f6f8\"\n        ><span class=\"avatar-fallback\">OB</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Owen Brandt<br /><span style=\"opacity: 0.7; font-size: 1.4rem\">City First lead candidate - fictional</span></p\n      >\n    </div>\n    <p class=\"presentation-note\">The loser’s honesty is the best quote of the night.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"votes\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Votes vs seats\"\n  >\n    <header class=\"presentation-header\"><span>Fairness check</span><span>% of votes vs % of seats</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 800;\n        letter-spacing: -0.02em;\n      \"\n      >Seats follow votes closely - small lists lose most</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Vote share and seat share side by side per party.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Viewer questions\"\n  >\n    <header class=\"presentation-header\"><span>Your questions</span><span>From the live chat</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"font-size: 3.2rem; margin-block: 5.25rem 1.5rem; font-weight: 800; letter-spacing: -0.02em\"\n      >Viewer questions</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"em-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Which coalition will form?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Greens + Social City + Liberal Voice (39) is the only option all three have not ruled out.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"em-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Why do “Others” lose seats with 6% of votes?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Their votes are spread over four lists; each falls short of the seat threshold.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"em-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>When is the council sworn in?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\">In three weeks - coalition talks start on Monday.</p></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Studio Q&A, one answer at a time.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Analysis</span><span>The night in four lines</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">■</span\n        ><span>One stacked bar and one line show the whole result.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">■</span\n        ><span>Largest party ≠ governing party.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">■</span\n        ><span>The Greens’ waterfront gains decided the night.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">■</span\n        ><span>Show votes next to seats to explain the maths.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Wrap-up, studio style.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"east\"\n    data-anim-in-blocks=\"6\"\n    data-anim-in-color=\"#D71920\"\n    aria-label=\"Closing\"\n  >\n    <div\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        left: 0;\n        right: 0;\n        bottom: 0;\n        height: 70px;\n        display: flex;\n        align-items: center;\n        gap: 3rem;\n        padding-inline: 112px;\n        background: #d71920;\n        color: #ffffff;\n        font:\n          800 1.5rem/1 Arial,\n          sans-serif;\n        text-transform: uppercase;\n        letter-spacing: 0.04em;\n      \"\n    >\n      <span>● Live</span><span>Port Aldwin council · 71 seats</span><span>36 for a majority</span\n      ><span>100% counted</span>\n    </div>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        font-weight: 800;\n        letter-spacing: -0.02em;\n        font-size: 7rem;\n      \"\n      >Count to 36</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px\"\n      >A fictional city, synthetic votes - the majority bar is the real format.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">Sign off.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 12</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"12\" value=\"1\"></progress>\n</section>\n","individual":false}]
