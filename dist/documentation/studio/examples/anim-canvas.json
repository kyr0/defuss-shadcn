[{"label":"A 3×2 story board","html":"<style>\n  #ac-demo {\n    --anim-canvas-gap: 96;\n    background: #020617;\n  }\n  .ac-s {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    padding: 72px 96px;\n    font-family: Inter, system-ui, sans-serif;\n    color: #e2f3ff;\n  }\n  .ac-eyebrow {\n    margin: 0 0 18px;\n    font:\n      600 18px/1 ui-monospace,\n      monospace;\n    letter-spacing: 0.28em;\n    text-transform: uppercase;\n    color: #5af2c8;\n  }\n  .ac-title {\n    margin: 0;\n    font-size: 92px;\n    line-height: 0.95;\n    letter-spacing: -0.045em;\n    font-weight: 800;\n  }\n  .ac-lede {\n    margin: 26px 0 0;\n    max-width: 640px;\n    font-size: 26px;\n    line-height: 1.4;\n    color: #b7cde0;\n  }\n  .ac-grad {\n    background: linear-gradient(90deg, #5af2c8, #7cc4ff 45%, #c79bff);\n    -webkit-background-clip: text;\n    background-clip: text;\n    color: transparent;\n  }\n  .ac-hint {\n    position: absolute;\n    left: 96px;\n    bottom: 56px;\n    margin: 0;\n    font:\n      600 16px ui-monospace,\n      monospace;\n    letter-spacing: 0.12em;\n    color: #7aa4c4;\n  }\n  #ac-1 {\n    background:\n      radial-gradient(ellipse at 70% 110%, #0f3b5c 0, transparent 55%), linear-gradient(180deg, #030712, #0a1a33);\n  }\n  #ac-2 {\n    background: linear-gradient(135deg, #04201f, #06343a);\n  }\n  #ac-3 {\n    background: linear-gradient(160deg, #0b1330, #151a45);\n  }\n  #ac-4 {\n    background: linear-gradient(180deg, #120a2a, #1f1147);\n  }\n  #ac-5 {\n    background: radial-gradient(circle at 50% 0, #0d4f45 0, transparent 60%), #031512;\n  }\n  #ac-6 {\n    background: linear-gradient(135deg, #1a0b2e, #0a1f3d 55%, #04312b);\n    align-items: center;\n    text-align: center;\n  }\n  .ac-nums {\n    display: flex;\n    gap: 72px;\n    margin-top: 40px;\n  }\n  .ac-num b {\n    display: block;\n    font-size: 112px;\n    line-height: 1;\n    letter-spacing: -0.04em;\n    font-variant-numeric: tabular-nums;\n    color: #5af2c8;\n  }\n  .ac-num > span {\n    display: block;\n    margin-top: 12px;\n    max-width: 260px;\n    font-size: 22px;\n    line-height: 1.35;\n    color: #a8c7c4;\n  }\n  .ac-cards {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 28px;\n    margin-top: 40px;\n  }\n  .ac-card {\n    padding: 30px 28px;\n    border: 1px solid rgba(199, 155, 255, 0.28);\n    border-radius: 22px;\n    background: rgba(255, 255, 255, 0.04);\n  }\n  .ac-card i {\n    display: block;\n    width: 44px;\n    height: 44px;\n    margin-bottom: 18px;\n    border-radius: 50%;\n  }\n  .ac-card h3 {\n    margin: 0 0 10px;\n    font-size: 28px;\n  }\n  .ac-card p {\n    margin: 0;\n    font-size: 20px;\n    line-height: 1.45;\n    color: #c9bde3;\n  }\n  .ac-bars {\n    display: flex;\n    align-items: flex-end;\n    gap: 22px;\n    height: 300px;\n    margin-top: 36px;\n    padding-bottom: 14px;\n    border-bottom: 2px solid rgba(90, 242, 200, 0.35);\n  }\n  .ac-bar {\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    justify-content: flex-end;\n    align-items: center;\n    gap: 10px;\n    height: 100%;\n    font:\n      600 18px ui-monospace,\n      monospace;\n    color: #8fb9b1;\n  }\n  .ac-bar i {\n    display: block;\n    width: 100%;\n    border-radius: 12px 12px 4px 4px;\n    background: linear-gradient(180deg, #5af2c8, #1a8f7a);\n  }\n  .ac-bar.is-peak i {\n    background: linear-gradient(180deg, #c79bff, #5af2c8);\n    box-shadow: 0 0 40px rgba(199, 155, 255, 0.55);\n  }\n  .ac-bar.is-peak {\n    color: #e9dcff;\n  }\n  .ac-cta {\n    display: flex;\n    gap: 18px;\n    justify-content: center;\n    margin-top: 40px;\n  }\n  .ac-key {\n    display: inline-grid;\n    place-items: center;\n    min-width: 64px;\n    height: 64px;\n    padding: 0 18px;\n    border: 2px solid rgba(226, 243, 255, 0.5);\n    border-radius: 14px;\n    font:\n      700 26px ui-monospace,\n      monospace;\n  }\n</style>\n<div class=\"anim-canvas\" id=\"ac-demo\" aria-label=\"Chasing the aurora - a story board\">\n  <!-- 1 · cover: the aurora draws itself across the sky -->\n  <section\n    class=\"anim-canvas-slide ac-s\"\n    id=\"ac-1\"\n    data-active\n    aria-label=\"Cover\"\n    data-east=\"ac-2\"\n    data-south=\"ac-4\"\n    data-anim-in=\"zoomIn\"\n  >\n    <svg aria-hidden=\"true\" width=\"1280\" height=\"720\" viewBox=\"0 0 1280 720\" style=\"position: absolute; inset: 0\">\n      <defs>\n        <linearGradient id=\"ac-sky\" x1=\"0\" x2=\"1\">\n          <stop offset=\"0\" stop-color=\"#5af2c8\" />\n          <stop offset=\".55\" stop-color=\"#7cc4ff\" />\n          <stop offset=\"1\" stop-color=\"#c79bff\" />\n        </linearGradient>\n      </defs>\n      <path\n        data-df-draw\n        pathLength=\"1\"\n        d=\"M-20 260 C 220 120, 420 330, 640 200 S 1040 90, 1300 210\"\n        fill=\"none\"\n        stroke=\"url(#ac-sky)\"\n        stroke-width=\"46\"\n        stroke-linecap=\"round\"\n        opacity=\".32\"\n        style=\"--df-motion-duration: 2200ms\"\n      />\n      <path\n        data-df-draw\n        pathLength=\"1\"\n        d=\"M-20 330 C 260 210, 460 390, 700 280 S 1080 180, 1300 300\"\n        fill=\"none\"\n        stroke=\"url(#ac-sky)\"\n        stroke-width=\"18\"\n        stroke-linecap=\"round\"\n        opacity=\".55\"\n        style=\"--df-motion-delay: 300ms; --df-motion-duration: 2200ms\"\n      />\n      <g fill=\"#e2f3ff\">\n        <circle cx=\"140\" cy=\"90\" r=\"2.2\" />\n        <circle cx=\"380\" cy=\"60\" r=\"1.6\" />\n        <circle cx=\"610\" cy=\"110\" r=\"2\" />\n        <circle cx=\"860\" cy=\"50\" r=\"1.8\" />\n        <circle cx=\"1040\" cy=\"120\" r=\"2.4\" />\n        <circle cx=\"1180\" cy=\"70\" r=\"1.6\" />\n        <circle cx=\"250\" cy=\"170\" r=\"1.4\" />\n        <circle cx=\"960\" cy=\"200\" r=\"1.4\" />\n      </g>\n      <path\n        d=\"M0 720 L 0 610 L 150 520 L 260 590 L 420 470 L 560 580 L 700 500 L 860 600 L 1010 480 L 1140 560 L 1280 500 L 1280 720 Z\"\n        fill=\"#020617\"\n      />\n    </svg>\n    <p class=\"ac-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\">A story board · anim-canvas</p>\n    <h2 class=\"ac-title\" data-df-entrance=\"up\" style=\"position: relative; --df-motion-delay: 150ms\"\n      >Chasing<br /><span class=\"ac-grad\">the aurora</span></h2\n    >\n    <p class=\"ac-lede\" data-df-entrance=\"up\" style=\"position: relative; --df-motion-delay: 350ms\"\n      >Fourteen nights above the Arctic Circle, laid out as one board. Move with the arrow keys - press O to see it\n      all.</p\n    >\n    <p class=\"ac-hint\" data-df-entrance=\"fade\" style=\"--df-motion-delay: 700ms\">→ east · ↓ south · O overview</p>\n  </section>\n\n  <!-- 2 · the numbers: the slide arrives under an aurora-green curtain -->\n  <section\n    class=\"anim-canvas-slide ac-s\"\n    id=\"ac-2\"\n    aria-label=\"The numbers\"\n    data-west=\"ac-1\"\n    data-east=\"ac-3\"\n    data-south=\"ac-5\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"north\"\n    data-anim-in-blocks=\"7\"\n    data-anim-in-stagger=\"60\"\n    data-anim-in-color=\"#5af2c8\"\n  >\n    <p class=\"ac-eyebrow\" data-df-entrance=\"fade\">The expedition in numbers</p>\n    <h2 class=\"ac-title\" data-df-entrance=\"up\" style=\"font-size: 72px; --df-motion-delay: 100ms\"\n      >Cold, dark, <span class=\"ac-grad\">worth it</span></h2\n    >\n    <div class=\"ac-nums\" data-df-stagger style=\"--df-motion-stagger-step: 160ms\">\n      <div class=\"ac-num\" data-df-entrance=\"up\"\n        ><b><span data-count=\"69.6\" data-count-decimals=\"1\">69.6</span>°N</b\n        ><span>latitude of Tromsø, where the trip starts</span></div\n      >\n      <div class=\"ac-num\" data-df-entrance=\"up\"\n        ><b><span data-count=\"14\">14</span></b\n        ><span>nights with the aurora overhead</span></div\n      >\n      <div class=\"ac-num\" data-df-entrance=\"up\"\n        ><b>−<span data-count=\"27\">27</span>°C</b><span>the coldest night, on the Finnmark plateau</span></div\n      >\n    </div>\n  </section>\n\n  <!-- 3 · the route draws itself; the towns pop in along it -->\n  <section\n    class=\"anim-canvas-slide ac-s\"\n    id=\"ac-3\"\n    aria-label=\"The route\"\n    data-west=\"ac-2\"\n    data-south=\"ac-6\"\n    data-anim-in=\"wipeIn\"\n    data-anim-in-direction=\"east\"\n  >\n    <p class=\"ac-eyebrow\" data-df-entrance=\"fade\">The route</p>\n    <h2 class=\"ac-title\" data-df-entrance=\"up\" style=\"font-size: 72px; --df-motion-delay: 100ms\"\n      >Along the coast,<br />then inland</h2\n    >\n    <svg aria-hidden=\"true\" width=\"1088\" height=\"330\" viewBox=\"0 0 1088 330\" style=\"margin-top: 28px\">\n      <path\n        d=\"M20 250 C 160 140, 260 300, 400 210 S 640 70, 780 150 S 980 240, 1060 110\"\n        fill=\"none\"\n        stroke=\"rgba(124,196,255,.18)\"\n        stroke-width=\"30\"\n        stroke-linecap=\"round\"\n      />\n      <path\n        data-df-draw\n        pathLength=\"1\"\n        d=\"M20 250 C 160 140, 260 300, 400 210 S 640 70, 780 150 S 980 240, 1060 110\"\n        fill=\"none\"\n        stroke=\"#7cc4ff\"\n        stroke-width=\"6\"\n        stroke-linecap=\"round\"\n        style=\"--df-motion-delay: 200ms; --df-motion-duration: 1800ms\"\n      />\n      <g font-family=\"Inter, system-ui, sans-serif\" font-size=\"24\" font-weight=\"700\" fill=\"#e2f3ff\">\n        <g data-df-entrance=\"pop\" style=\"--df-motion-delay: 200ms\">\n          <circle cx=\"20\" cy=\"250\" r=\"14\" fill=\"#5af2c8\" />\n          <text x=\"44\" y=\"296\">Tromsø</text>\n        </g>\n        <g data-df-entrance=\"pop\" style=\"--df-motion-delay: 600ms\">\n          <circle cx=\"400\" cy=\"210\" r=\"14\" fill=\"#5af2c8\" />\n          <text x=\"380\" y=\"262\">Alta</text>\n        </g>\n        <g data-df-entrance=\"pop\" style=\"--df-motion-delay: 1000ms\">\n          <circle cx=\"780\" cy=\"150\" r=\"14\" fill=\"#5af2c8\" />\n          <text x=\"740\" y=\"112\">Karasjok</text>\n        </g>\n        <g data-df-entrance=\"pop\" style=\"--df-motion-delay: 1400ms\">\n          <circle cx=\"1060\" cy=\"110\" r=\"18\" fill=\"#c79bff\" />\n          <text x=\"1076\" y=\"72\" text-anchor=\"end\">Kirkenes</text>\n        </g>\n      </g>\n    </svg>\n  </section>\n\n  <!-- 4 · why it glows: three cards flip in, one after another -->\n  <section\n    class=\"anim-canvas-slide ac-s\"\n    id=\"ac-4\"\n    aria-label=\"Why it glows\"\n    data-north=\"ac-1\"\n    data-east=\"ac-5\"\n    data-anim-in=\"slideIn\"\n  >\n    <p class=\"ac-eyebrow\" data-df-entrance=\"fade\" style=\"color: #c79bff\">Why the sky glows</p>\n    <h2 class=\"ac-title\" data-df-entrance=\"up\" style=\"font-size: 72px; --df-motion-delay: 100ms\"\n      >Sun, field, <span class=\"ac-grad\">oxygen</span></h2\n    >\n    <div class=\"ac-cards\" data-df-stagger style=\"--df-motion-stagger-step: 220ms\">\n      <div class=\"ac-card\" data-df-entrance=\"flip\"\n        ><i style=\"background: #ffb45a\"></i><h3>Solar wind</h3\n        ><p>Charged particles stream away from the Sun at hundreds of kilometres per second.</p></div\n      >\n      <div class=\"ac-card\" data-df-entrance=\"flip\"\n        ><i style=\"background: #7cc4ff\"></i><h3>Magnetic field</h3\n        ><p>Earth's field funnels them down towards the polar regions.</p></div\n      >\n      <div class=\"ac-card\" data-df-entrance=\"flip\"\n        ><i style=\"background: #5af2c8\"></i><h3>Green light</h3\n        ><p>Excited oxygen glows at 557.7 nm - the classic green curtain.</p></div\n      >\n    </div>\n  </section>\n\n  <!-- 5 · the forecast: the bars rise, the best night glows -->\n  <section\n    class=\"anim-canvas-slide ac-s\"\n    id=\"ac-5\"\n    aria-label=\"The forecast\"\n    data-north=\"ac-2\"\n    data-west=\"ac-4\"\n    data-east=\"ac-6\"\n    data-anim-in=\"irisIn\"\n    data-anim-in-origin=\"50% 50%\"\n  >\n    <p class=\"ac-eyebrow\" data-df-entrance=\"fade\">Kp index · 0 to 9</p>\n    <h2 class=\"ac-title\" data-df-entrance=\"up\" style=\"font-size: 72px; --df-motion-delay: 100ms\"\n      >Night six: <span class=\"ac-grad\">Kp 7</span></h2\n    >\n    <div class=\"ac-bars\" data-df-stagger style=\"--df-motion-stagger-step: 110ms\">\n      <div class=\"ac-bar\" data-df-entrance=\"wipe-up\"><i style=\"height: 22%\"></i>2</div>\n      <div class=\"ac-bar\" data-df-entrance=\"wipe-up\"><i style=\"height: 33%\"></i>3</div>\n      <div class=\"ac-bar\" data-df-entrance=\"wipe-up\"><i style=\"height: 44%\"></i>4</div>\n      <div class=\"ac-bar\" data-df-entrance=\"wipe-up\"><i style=\"height: 33%\"></i>3</div>\n      <div class=\"ac-bar\" data-df-entrance=\"wipe-up\"><i style=\"height: 56%\"></i>5</div>\n      <div class=\"ac-bar is-peak\" data-df-entrance=\"wipe-up\"><i style=\"height: 78%\"></i>7</div>\n      <div class=\"ac-bar\" data-df-entrance=\"wipe-up\"><i style=\"height: 44%\"></i>4</div>\n    </div>\n  </section>\n\n  <!-- 6 · closing: the call to zoom out -->\n  <section\n    class=\"anim-canvas-slide ac-s\"\n    id=\"ac-6\"\n    aria-label=\"Closing\"\n    data-north=\"ac-3\"\n    data-west=\"ac-5\"\n    data-anim-in=\"blurIn\"\n  >\n    <p class=\"ac-eyebrow\" data-df-entrance=\"fade\">End of the board</p>\n    <h2 class=\"ac-title\" data-df-entrance=\"zoom\" style=\"--df-motion-delay: 100ms\"\n      >Now see<br /><span class=\"ac-grad\">the whole trip</span></h2\n    >\n    <div class=\"ac-cta\" data-df-entrance=\"pop\" style=\"--df-motion-delay: 500ms\"\n      ><span class=\"ac-key\">O</span><span class=\"ac-key\">Esc</span><span class=\"ac-key\">⛶</span></div\n    >\n  </section>\n\n  <div class=\"anim-canvas-controls\">\n    <button type=\"button\" class=\"anim-canvas-control\" data-anim-canvas-go=\"west\" aria-label=\"West slide\">←</button>\n    <button type=\"button\" class=\"anim-canvas-control\" data-anim-canvas-go=\"north\" aria-label=\"North slide\">↑</button>\n    <button type=\"button\" class=\"anim-canvas-control\" data-anim-canvas-go=\"south\" aria-label=\"South slide\">↓</button>\n    <button type=\"button\" class=\"anim-canvas-control\" data-anim-canvas-go=\"east\" aria-label=\"East slide\">→</button>\n    <button type=\"button\" class=\"anim-canvas-control\" data-anim-canvas-go=\"overview\" aria-label=\"Toggle overview\"\n      >⛶</button\n    >\n  </div>\n</div>\n","individual":true},{"label":"Curtain color (blend-over)","html":"<style>\n  #ac-curtain-target {\n    width: 220px;\n    height: 120px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    background: var(--card);\n    color: var(--card-foreground);\n    font-weight: 600;\n  }\n</style>\n<div style=\"display: flex; flex-direction: column; gap: 0.75rem; align-items: flex-start\">\n  <div id=\"ac-curtain-target\">Cover me</div>\n  <div style=\"display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center\">\n    <select class=\"select\" id=\"ac-curtain-color\" aria-label=\"Curtain color\">\n      <option value=\"var(--primary)\" selected>primary</option>\n      <option value=\"var(--secondary)\">secondary</option>\n      <option value=\"var(--destructive)\">destructive</option>\n      <option value=\"#111827\">#111827</option>\n    </select>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"ac-curtain-in\">blocksIn (cover)</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"ac-curtain-out\">blocksOut (reveal)</button>\n    <button class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" id=\"ac-curtain-reset\">Reset</button>\n  </div>\n</div>\n","individual":false}]
