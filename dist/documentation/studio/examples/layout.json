[{"label":"Layout 1","html":"<div class=\"stack gap-6\" data-demo=\"layout-composition\">\n  <div class=\"flex flex-wrap items-center justify-between gap-3\">\n    <h3>Projects</h3>\n    <button class=\"btn\" type=\"button\">New project</button>\n  </div>\n  <div class=\"grid grid-cols-auto gap-4\" style=\"--layout-min: 12rem\">\n    <div class=\"demo-box\">Research</div>\n    <div class=\"demo-box\">Design</div>\n    <div class=\"demo-box\">Engineering</div>\n  </div>\n</div>\n","individual":false},{"label":"Layout 2","html":"<div class=\"stack gap-4\" data-demo=\"layout-overflow\">\n  <div class=\"overflow-x-auto h-8 demo-tile\" data-variant=\"muted\" style=\"justify-content: flex-start\"\n    ><span class=\"w-64 shrink-0\" style=\"padding-inline: 0.5rem\"\n      >overflow-x-auto - the tile scrolls instead of widening the page when the stage gets narrower →</span\n    ></div\n  >\n  <div\n    class=\"truncate h-8 demo-tile\"\n    data-variant=\"outline\"\n    style=\"display: block; line-height: 2rem; padding-inline: 0.5rem\"\n    >truncate - a single line that must not widen its container collapses to an ellipsis exactly like a UI list row</div\n  >\n  <div class=\"h-auto p-2 demo-tile wrap-anywhere\" data-variant=\"secondary\" style=\"justify-content: flex-start\"\n    >wrap-anywhere - PneumonoultramicroscopicsilicovolcanoconiosisLongIdentifiers break here instead of pushing the\n    track open</div\n  >\n</div>\n","individual":false}]
