[{"label":"Default","html":"<section class=\"mk-newsletter\" style=\"width: 100%\">\n  <div class=\"mk-newsletter-layout\">\n    <div class=\"mk-newsletter-copy\">\n      <h2 class=\"mk-newsletter-title\">Stay in the loop</h2>\n      <p class=\"mk-newsletter-desc\">Get insights, product updates, and productivity tips straight to your inbox.</p>\n    </div>\n    <div class=\"mk-newsletter-form-col\">\n      <form class=\"mk-newsletter-form\" action=\"#\" method=\"post\">\n        <label class=\"sr-only\" for=\"mk-nl-email\">Email address</label>\n        <input\n          class=\"input\"\n          id=\"mk-nl-email\"\n          type=\"email\"\n          name=\"email\"\n          placeholder=\"email@example.com\"\n          aria-describedby=\"mk-nl-note\"\n          required\n          autocomplete=\"email\"\n          enterkeyhint=\"send\"\n        />\n        <button class=\"btn\" type=\"submit\" aria-label=\"Subscribe to newsletter\"\n          ><svg\n            viewBox=\"0 0 24 24\"\n            width=\"24\"\n            height=\"24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            aria-hidden=\"true\"\n          >\n            <rect width=\"20\" height=\"16\" x=\"2\" y=\"4\" rx=\"2\"></rect>\n            <path d=\"m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7\"></path></svg\n          >Subscribe</button\n        >\n      </form>\n      <span class=\"mk-newsletter-note\" id=\"mk-nl-note\">We respect your privacy - unsubscribe any time.</span>\n      <span class=\"mk-newsletter-error\" aria-hidden=\"true\"\n        ><svg\n          viewBox=\"0 0 24 24\"\n          width=\"14\"\n          height=\"14\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"2\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          aria-hidden=\"true\"\n        >\n          <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n          <line x1=\"12\" x2=\"12\" y1=\"8\" y2=\"12\"></line>\n          <line x1=\"12\" x2=\"12.01\" y1=\"16\" y2=\"16\"></line></svg\n        >Please enter a valid email address.</span\n      >\n    </div>\n  </div>\n</section>\n","individual":true},{"label":"Card with social proof","html":"<section class=\"mk-newsletter\" data-variant=\"card\" style=\"width: 100%\">\n  <div class=\"mk-newsletter-layout\">\n    <span class=\"mk-newsletter-icon\"\n      ><svg\n        viewBox=\"0 0 24 24\"\n        width=\"24\"\n        height=\"24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        aria-hidden=\"true\"\n      >\n        <rect width=\"20\" height=\"16\" x=\"2\" y=\"4\" rx=\"2\"></rect>\n        <path d=\"m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7\"></path></svg\n    ></span>\n    <div class=\"mk-newsletter-copy\">\n      <h2 class=\"mk-newsletter-title\">The Calm Letter</h2>\n      <p class=\"mk-newsletter-desc\">One essay a week on building software people enjoy. No noise.</p>\n    </div>\n    <div class=\"mk-newsletter-form-col\">\n      <form class=\"mk-newsletter-form\" action=\"#\" method=\"post\">\n        <label class=\"sr-only\" for=\"nl-card\">Email address</label>\n        <input\n          class=\"input\"\n          id=\"nl-card\"\n          type=\"email\"\n          name=\"email\"\n          placeholder=\"email@example.com\"\n          required\n          autocomplete=\"email\"\n          enterkeyhint=\"send\"\n          aria-describedby=\"nl-card-note\"\n        />\n        <button class=\"btn\" type=\"submit\">Join</button>\n      </form>\n      <span class=\"mk-newsletter-note\" id=\"nl-card-note\">One email a week. Unsubscribe any time.</span>\n    </div>\n    <div class=\"mk-newsletter-proof\"\n      ><div class=\"avatar-group\"\n        ><span class=\"avatar\" data-size=\"sm\"><img class=\"avatar-image\" src=\"images/mk-portrait.png\" alt=\"\" /></span\n        ><span class=\"avatar\" data-size=\"sm\"><img class=\"avatar-image\" src=\"images/mk-portrait2.png\" alt=\"\" /></span\n        ><span class=\"avatar\" data-size=\"sm\"\n          ><img class=\"avatar-image\" src=\"images/mk-portrait.png\" alt=\"\" /></span></div\n      ><span>Join <strong>12,000</strong> readers</span></div\n    >\n  </div>\n</section>\n","individual":true},{"label":"Gradient banner","html":"<section class=\"mk-newsletter\" data-variant=\"banner\" style=\"width: 100%\">\n  <div class=\"mk-newsletter-layout\">\n    <div class=\"mk-newsletter-copy\">\n      <h2 class=\"mk-newsletter-title\">Get the release notes first</h2>\n      <p class=\"mk-newsletter-desc\">A short email on every release - what changed and why.</p>\n    </div>\n    <div class=\"mk-newsletter-form-col\">\n      <form class=\"mk-newsletter-form\" action=\"#\" method=\"post\">\n        <label class=\"sr-only\" for=\"nl-banner\">Email address</label>\n        <input\n          class=\"input\"\n          id=\"nl-banner\"\n          type=\"email\"\n          name=\"email\"\n          placeholder=\"email@example.com\"\n          required\n          autocomplete=\"email\"\n          enterkeyhint=\"send\"\n          aria-describedby=\"nl-banner-note\"\n        />\n        <button class=\"btn\" type=\"submit\">Subscribe</button>\n      </form>\n      <span class=\"mk-newsletter-note\" id=\"nl-banner-note\">One email a week. Unsubscribe any time.</span>\n    </div>\n  </div>\n</section>\n","individual":true},{"label":"Split with topics","html":"<section class=\"mk-newsletter\" style=\"width: 100%\">\n  <div class=\"mk-newsletter-split\">\n    <img src=\"images/mk-portrait2.png\" alt=\"\" />\n    <form action=\"#\" method=\"post\">\n      <div class=\"mk-newsletter-copy\"\n        ><h2 class=\"mk-newsletter-title\">Pick what you read</h2\n        ><p class=\"mk-newsletter-desc\">Choose your lists - change them in every email.</p></div\n      >\n      <fieldset class=\"mk-newsletter-topics\">\n        <legend>Lists</legend>\n        <div class=\"checkbox-item\"\n          ><input class=\"checkbox\" type=\"checkbox\" id=\"nl-product\" name=\"lists\" value=\"product\" checked /><label\n            for=\"nl-product\"\n            >Product updates</label\n          ></div\n        >\n        <div class=\"checkbox-item\"\n          ><input class=\"checkbox\" type=\"checkbox\" id=\"nl-eng\" name=\"lists\" value=\"eng\" checked /><label for=\"nl-eng\"\n            >Engineering essays</label\n          ></div\n        >\n        <div class=\"checkbox-item\"\n          ><input class=\"checkbox\" type=\"checkbox\" id=\"nl-events\" name=\"lists\" value=\"events\" /><label for=\"nl-events\"\n            >Events &amp; webinars</label\n          ></div\n        >\n      </fieldset>\n      <label class=\"label\" for=\"nl-split\">Email</label>\n      <input\n        class=\"input\"\n        id=\"nl-split\"\n        type=\"email\"\n        name=\"email\"\n        placeholder=\"email@example.com\"\n        required\n        autocomplete=\"email\"\n      />\n      <button class=\"btn\" type=\"submit\">Subscribe</button>\n    </form>\n  </div>\n</section>\n","individual":true}]
