[{"label":"A configuration","html":"<div\n  class=\"property-tree\"\n  id=\"pt-config\"\n  aria-label=\"Service configuration\"\n  style=\"block-size: 22rem; max-width: 36rem\"\n  data-state-demo\n>\n  \n</div>\n","individual":true},{"label":"Custom editors","html":"<div class=\"property-tree\" id=\"pt-custom\" aria-label=\"Project\" style=\"block-size: 22rem; max-width: 38rem\">\n  \n</div>\n","individual":true},{"label":"Comfortable rows","html":"<div\n  class=\"property-tree\"\n  id=\"pt-comfortable\"\n  aria-label=\"Profile\"\n  data-variant=\"comfortable\"\n  style=\"block-size: 14rem; max-width: 30rem; --property-tree-key-width: 30%\"\n>\n  \n</div>\n","individual":true},{"label":"A session with references","html":"<div class=\"property-tree\" id=\"pt-session\" aria-label=\"Session\" style=\"block-size: 20rem; max-width: 36rem\">\n  \n</div>\n<pre class=\"text-xs\" style=\"margin-block-start: 0.5rem; white-space: pre-wrap; word-break: break-all; max-height: 7rem; overflow: auto\"><code id=\"pt-session-out\">Edit a value to see the DSON.</code></pre>\n","individual":false},{"label":"Any value from script","html":"<div\n  class=\"property-tree\"\n  id=\"pt-graph\"\n  aria-label=\"Service graph\"\n  data-root-label=\"services\"\n  style=\"block-size: 18rem; max-width: 36rem\"\n></div>\n<pre class=\"text-xs\" style=\"margin-block-start: 0.5rem; max-height: 8rem; overflow: auto\"><code id=\"pt-graph-out\"></code></pre>\n","individual":false},{"label":"100,000 nodes","html":"<div class=\"flex gap-2 mb-2\">\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"pt-big-open\">Expand everything</button>\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"pt-big-close\">Collapse</button>\n  <output class=\"text-sm text-muted-foreground\" id=\"pt-big-count\" style=\"align-self: center\"></output>\n</div>\n<div class=\"property-tree\" id=\"pt-big\" aria-label=\"Catalog\" style=\"block-size: 20rem\"></div>\n","individual":false},{"label