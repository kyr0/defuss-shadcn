[{"label":"An about page","html":"<div id=\"site-company\" data-i18n-component style=\"display: flex; flex-direction: column; gap: 4rem; width: 100%\">\n  <div class=\"flex flex-wrap items-center gap-2\" style=\"margin-block-end: -2rem\">\n    <nav\n      class=\"flex flex-wrap gap-1\"\n      data-company-nav=\"site\"\n      aria-label=\"Company\"\n      data-i18n-aria-label-en=\"Company\"\n      data-i18n-aria-label-de=\"Unternehmen\"\n    >\n      <a class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" href=\"#/\" data-router-link aria-current=\"page\"\n        ><span data-i18n-target=\"nav-0\">About</span></a\n      >\n      <a class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" href=\"#/team\" data-router-link>Team</a>\n      <a class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" href=\"#/jobs\" data-router-link>Jobs</a>\n      <a class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" href=\"#/press\" data-router-link\n        ><span data-i18n-target=\"nav-3\">Press</span></a\n      >\n    </nav>\n    <span style=\"flex: 1\"></span>\n    <select\n      class=\"select\"\n      data-size=\"sm\"\n      data-app-locale\n      aria-label=\"Language\"\n      data-i18n-aria-label-en=\"Language\"\n      data-i18n-aria-label-de=\"Sprache\"\n      style=\"width: auto\"\n    >\n      <option value=\"en\" lang=\"en\">English</option>\n      <option value=\"de\" lang=\"de\">Deutsch</option>\n    </select>\n  </div>\n  <section class=\"mk-about-intro\" aria-labelledby=\"about-title\" data-company-view=\"about\">\n    <div class=\"mk-about-intro-layout\">\n      <div class=\"mk-about-intro-copy\">\n        <span class=\"mk-about-intro-eyebrow\" data-i18n-target=\"co-1-1\">About Acme</span>\n        <h2 class=\"mk-about-intro-title\" id=\"about-title\" data-i18n-target=\"co-2-1\"\n          >We build calm software for teams that ship</h2\n        >\n        <p class=\"mk-about-intro-lead\"\n          >Acme started in a Lisbon flat in 2016 with one question: why does work software make people anxious? Ten\n          years later, forty of us answer it every day.</p\n        >\n        <dl class=\"mk-about-intro-facts\">\n          <div><dt data-i18n-target=\"co-3-1\">Founded</dt><dd>2016</dd></div>\n          <div><dt data-i18n-target=\"co-4-1\">People</dt><dd>40</dd></div>\n          <div><dt data-i18n-target=\"co-5-1\">Offices</dt><dd>3</dd></div>\n          <div><dt data-i18n-target=\"co-6-1\">Teams using Acme</dt><dd>12k</dd></div>\n        </dl>\n      </div>\n      <figure class=\"mk-about-intro-media\">\n        <img src=\"https://picsum.photos/seed/about-office/600/800\" alt=\"\" />\n        <img src=\"https://picsum.photos/seed/about-team/600/800\" alt=\"\" />\n      </figure>\n    </div>\n  </section>\n  <section class=\"mk-about-intro\" aria-labelledby=\"values-title\" data-company-view=\"about\">\n    <div class=\"mk-about-intro-copy\">\n      <span class=\"mk-about-intro-eyebrow\" data-i18n-target=\"co-7-1\">What we value</span>\n      <h2 class=\"mk-about-intro-title\" id=\"values-title\" data-i18n-target=\"co-8-1\">Four promises we keep</h2>\n      <ul class=\"mk-about-intro-values\">\n        <li\n          ><i data-lucide=\"feather\"></i><h3 data-i18n-target=\"co-9-1\">Calm by default</h3\n          ><p>No red badges, no dark patterns - attention is our users' to give.</p></li\n        >\n        <li\n          ><i data-lucide=\"lock\"></i><h3 data-i18n-target=\"co-10-1\">Private first</h3\n          ><p>Your data is yours. We never sell it and never train on it.</p></li\n        >\n        <li\n          ><i data-lucide=\"hand-heart\"></i><h3 data-i18n-target=\"co-11-1\">Kind and direct</h3\n          ><p>We say what we mean, and we mean well.</p></li\n        >\n        <li\n          ><i data-lucide=\"leaf\"></i><h3 data-i18n-target=\"co-12-1\">Built to last</h3\n          ><p>Profitable, independent and here for the next decade.</p></li\n        >\n      </ul>\n    </div>\n  </section>\n  <ol class=\"mk-process-steps\" data-variant=\"horizontal\" data-company-view=\"about\">\n    <li class=\"mk-process-step\">\n      <span class=\"mk-process-step-number\" aria-hidden=\"true\">01</span>\n      <div class=\"mk-process-step-body\">\n        <h3 class=\"mk-process-step-title\" data-i18n-target=\"co-13-1\">Discover</h3>\n        <p class=\"mk-process-step-desc\">Two workshops to map goals, users and constraints.</p>\n      </div>\n    </li>\n    <li class=\"mk-process-step\">\n      <span class=\"mk-process-step-number\" aria-hidden=\"true\">02</span>\n      <div class=\"mk-process-step-body\">\n        <h3 class=\"mk-process-step-title\">Design</h3>\n        <p class=\"mk-process-step-desc\">Prototypes tested with real customers every week.</p>\n      </div>\n    </li>\n    <li class=\"mk-process-step\">\n      <span class=\"mk-process-step-number\" aria-hidden=\"true\">03</span>\n      <div class=\"mk-process-step-body\">\n        <h3 class=\"mk-process-step-title\" data-i18n-target=\"co-14-1\">Build</h3>\n        <p class=\"mk-process-step-desc\">Small releases behind flags - nothing big-bang.</p>\n      </div>\n    </li>\n    <li class=\"mk-process-step\">\n      <span class=\"mk-process-step-number\" aria-hidden=\"true\">04</span>\n      <div class=\"mk-process-step-body\">\n        <h3 class=\"mk-process-step-title\" data-i18n-target=\"co-15-1\">Grow</h3>\n        <p class=\"mk-process-step-desc\">We measure, learn and hand over a team that can run it.</p>\n      </div>\n    </li>\n  </ol>\n  <div\n    data-company-view=\"team\"\n    hidden\n    style=\"\n      display: grid;\n      grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));\n      gap: 2rem 1.25rem;\n      width: 100%;\n    \"\n  >\n    <article class=\"mk-team-member\" aria-labelledby=\"tm-0\">\n      <div class=\"mk-team-member-portrait\">\n        <img class=\"mk-team-member-photo\" src=\"https://i.pravatar.cc/480?img=25\" alt=\"Portrait of Sophie Tan\" />\n        <span class=\"mk-team-member-tag\"><i data-lucide=\"map-pin\"></i>Lisbon</span>\n        <ul class=\"mk-team-member-links\">\n          <li\n            ><a\n              href=\"#\"\n              aria-label=\"Sophie Tan on LinkedIn\"\n              data-i18n-aria-label-en=\"Sophie Tan on LinkedIn\"\n              data-i18n-aria-label-de=\"Sophie Tan auf LinkedIn\"\n              ><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\">\n                <path\n                  d=\"M5 3.5A2.5 2.5 0 1 1 5 8.5 2.5 2.5 0 0 1 5 3.5ZM3 10h4v11H3V10Zm7 0h3.8v1.6h.1c.5-1 1.8-1.9 3.6-1.9 3.9 0 4.5 2.5 4.5 5.8V21h-4v-4.9c0-1.2 0-2.7-1.7-2.7s-2 1.3-2 2.6v5h-4V10Z\"\n                /></svg></a\n          ></li>\n          <li\n            ><a\n              href=\"#\"\n              aria-label=\"Sophie Tan on GitHub\"\n              data-i18n-aria-label-en=\"Sophie Tan on GitHub\"\n              data-i18n-aria-label-de=\"Sophie Tan auf GitHub\"\n              ><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\">\n                <path\n                  d=\"M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2.1c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5Z\"\n                /></svg></a\n          ></li>\n          <li\n            ><a\n              href=\"#\"\n              aria-label=\"Sophie Tan on X\"\n              data-i18n-aria-label-en=\"Sophie Tan on X\"\n              data-i18n-aria-label-de=\"Sophie Tan auf X\"\n              ><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\">\n                <path\n                  d=\"M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-6.4L6.4 22H3.3l7.3-8.3L.8 2h6.4l4.4 5.9L18.9 2Zm-1.1 18h1.7L6.3 3.9H4.5L17.8 20Z\"\n                /></svg></a\n          ></li>\n          <li\n            ><a\n              href=\"#\"\n              aria-label=\"Email Sophie Tan\"\n              data-i18n-aria-label-en=\"Email Sophie Tan\"\n              data-i18n-aria-label-de=\"Sophie Tan eine E-Mail schreiben\"\n              ><i data-lucide=\"mail\"></i></a\n          ></li>\n        </ul>\n      </div>\n      <div class=\"mk-team-member-body\">\n        <h3 class=\"mk-team-member-name\" id=\"tm-0\">Sophie Tan</h3>\n        <p class=\"mk-team-member-role\" data-i18n-target=\"co-16-1\">Head of Engineering</p>\n        <p class=\"mk-team-member-bio\">Builds the sync engine. Previously at a database company you have heard of.</p>\n      </div>\n    </article>\n    <article class=\"mk-team-member\" aria-labelledby=\"tm-1\">\n      <div class=\"mk-team-member-portrait\">\n        <img class=\"mk-team-member-photo\" src=\"https://i.pravatar.cc/480?img=32\" alt=\"Portrait of Hannah Lee\" />\n        <span class=\"mk-team-member-tag\"><i data-lucide=\"map-pin\"></i>Berlin</span>\n        <ul class=\"mk-team-member-links\">\n          <li\n            ><a\n              href=\"#\"\n              aria-label=\"Hannah Lee on LinkedIn\"\n              data-i18n-aria-label-en=\"Hannah Lee on LinkedIn\"\n              data-i18n-aria-label-de=\"Hannah Lee auf LinkedIn\"\n              ><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\">\n                <path\n                  d=\"M5 3.5A2.5 2.5 0 1 1 5 8.5 2.5 2.5 0 0 1 5 3.5ZM3 10h4v11H3V10Zm7 0h3.8v1.6h.1c.5-1 1.8-1.9 3.6-1.9 3.9 0 4.5 2.5 4.5 5.8V21h-4v-4.9c0-1.2 0-2.7-1.7-2.7s-2 1.3-2 2.6v5h-4V10Z\"\n                /></svg></a\n          ></li>\n          <li\n            ><a\n              href=\"#\"\n              aria-label=\"Hannah Lee on GitHub\"\n              data-i18n-aria-label-en=\"Hannah Lee on GitHub\"\n              data-i18n-aria-label-de=\"Hannah Lee auf GitHub\"\n              ><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\">\n                <path\n                  d=\"M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2.1c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5Z\"\n                /></svg></a\n          ></li>\n          <li\n            ><a\n              href=\"#\"\n              aria-label=\"Hannah Lee on X\"\n              data-i18n-aria-label-en=\"Hannah Lee on X\"\n              data-i18n-aria-label-de=\"Hannah Lee auf X\"\n              ><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\">\n                <path\n                  d=\"M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-6.4L6.4 22H3.3l7.3-8.3L.8 2h6.4l4.4 5.9L18.9 2Zm-1.1 18h1.7L6.3 3.9H4.5L17.8 20Z\"\n                /></svg></a\n          ></li>\n          <li\n            ><a\n              href=\"#\"\n              aria-label=\"Email Hannah Lee\"\n              data-i18n-aria-label-en=\"Email Hannah Lee\"\n              data-i18n-aria-label-de=\"Hannah Lee eine E-Mail schreiben\"\n              ><i data-lucide=\"mail\"></i></a\n          ></li>\n        </ul>\n      </div>\n      <div class=\"mk-team-member-body\">\n        <h3 class=\"mk-team-member-name\" id=\"tm-1\">Hannah Lee</h3>\n        <p class=\"mk-team-member-role\">Design Lead</p>\n        <p class=\"mk-team-member-bio\">Makes Acme quiet. Believes every badge has to earn its place.</p>\n      </div>\n    </article>\n    <article class=\"mk-team-member\" aria-labelledby=\"tm-2\">\n      <div class=\"mk-team-member-portrait\">\n        <img class=\"mk-team-member-photo\" src=\"https://i.pravatar.cc/480?img=12\" alt=\"Portrait of Aron Homberg\" />\n        <span class=\"mk-team-member-tag\"><i data-lucide=\"map-pin\"></i>Lisbon</span>\n        <ul class=\"mk-team-member-links\">\n          <li\n            ><a\n              href=\"#\"\n              aria-label=\"Aron Homberg on LinkedIn\"\n              data-i18n-aria-label-en=\"Aron Homberg on LinkedIn\"\n              data-i18n-aria-label-de=\"Aron Homberg auf LinkedIn\"\n              ><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\">\n                <path\n                  d=\"M5 3.5A2.5 2.5 0 1 1 5 8.5 2.5 2.5 0 0 1 5 3.5ZM3 10h4v11H3V10Zm7 0h3.8v1.6h.1c.5-1 1.8-1.9 3.6-1.9 3.9 0 4.5 2.5 4.5 5.8V21h-4v-4.9c0-1.2 0-2.7-1.7-2.7s-2 1.3-2 2.6v5h-4V10Z\"\n                /></svg></a\n          ></li>\n          <li\n            ><a\n              href=\"#\"\n              aria-label=\"Aron Homberg on GitHub\"\n              data-i18n-aria-label-en=\"Aron Homberg on GitHub\"\n              data-i18n-aria-label-de=\"Aron Homberg auf GitHub\"\n              ><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\">\n                <path\n                  d=\"M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2.1c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5Z\"\n                /></svg></a\n          ></li>\n          <li\n            ><a\n              href=\"#\"\n              aria-label=\"Aron Homberg on X\"\n              data-i18n-aria-label-en=\"Aron Homberg on X\"\n              data-i18n-aria-label-de=\"Aron Homberg auf X\"\n              ><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\">\n                <path\n                  d=\"M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-6.4L6.4 22H3.3l7.3-8.3L.8 2h6.4l4.4 5.9L18.9 2Zm-1.1 18h1.7L6.3 3.9H4.5L17.8 20Z\"\n                /></svg></a\n          ></li>\n          <li\n            ><a\n              href=\"#\"\n              aria-label=\"Email Aron Homberg\"\n              data-i18n-aria-label-en=\"Email Aron Homberg\"\n              data-i18n-aria-label-de=\"Aron Homberg eine E-Mail schreiben\"\n              ><i data-lucide=\"mail\"></i></a\n          ></li>\n        </ul>\n      </div>\n      <div class=\"mk-team-member-body\">\n        <h3 class=\"mk-team-member-name\" id=\"tm-2\">Aron Homberg</h3>\n        <p class=\"mk-team-member-role\" data-i18n-target=\"co-18-1\">Co-founder & CEO</p>\n        <p class=\"mk-team-member-bio\">Writes the weekly letter and still answers support on Fridays.</p>\n      </div>\n    </article>\n    <article class=\"mk-team-member\" aria-labelledby=\"tm-3\">\n      <div class=\"mk-team-member-portrait\">\n        <img class=\"mk-team-member-photo\" src=\"https://i.pravatar.cc/480?img=16\" alt=\"Portrait of Priya Natarajan\" />\n        <span class=\"mk-team-member-tag\"><i data-lucide=\"map-pin\"></i>Remote</span>\n        <ul class=\"mk-team-member-links\">\n          <li\n            ><a\n              href=\"#\"\n              aria-label=\"Priya Natarajan on LinkedIn\"\n              data-i18n-aria-label-en=\"Priya Natarajan on LinkedIn\"\n              data-i18n-aria-label-de=\"Priya Natarajan auf LinkedIn\"\n              ><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\">\n                <path\n                  d=\"M5 3.5A2.5 2.5 0 1 1 5 8.5 2.5 2.5 0 0 1 5 3.5ZM3 10h4v11H3V10Zm7 0h3.8v1.6h.1c.5-1 1.8-1.9 3.6-1.9 3.9 0 4.5 2.5 4.5 5.8V21h-4v-4.9c0-1.2 0-2.7-1.7-2.7s-2 1.3-2 2.6v5h-4V10Z\"\n                /></svg></a\n          ></li>\n       