[{"label":"An about page","html":"<div style=\"display: flex; flex-direction: column; gap: 4rem; width: 100%\">\n  <section class=\"mk-about-intro\" aria-labelledby=\"about-title\">\n    <div class=\"mk-about-intro-layout\">\n      <div class=\"mk-about-intro-copy\">\n        <span class=\"mk-about-intro-eyebrow\">About Acme</span>\n        <h2 class=\"mk-about-intro-title\" id=\"about-title\">We build calm software for teams that ship</h2>\n        <p class=\"mk-about-intro-lead\"\n          >Acme started in a Lisbon flat in 2016 with one question: why does work software make people anxious? Ten\n          years later, forty of us answer it every day.</p\n        >\n        <dl class=\"mk-about-intro-facts\">\n          <div><dt>Founded</dt><dd>2016</dd></div>\n          <div><dt>People</dt><dd>40</dd></div>\n          <div><dt>Offices</dt><dd>3</dd></div>\n          <div><dt>Teams using Acme</dt><dd>12k</dd></div>\n        </dl>\n      </div>\n      <figure class=\"mk-about-intro-media\">\n        <img src=\"https://picsum.photos/seed/about-office/600/800\" alt=\"\" />\n        <img src=\"https://picsum.photos/seed/about-team/600/800\" alt=\"\" />\n      </figure>\n    </div>\n  </section>\n  <section class=\"mk-about-intro\" aria-labelledby=\"values-title\">\n    <div class=\"mk-about-intro-copy\">\n      <span class=\"mk-about-intro-eyebrow\">What we value</span>\n      <h2 class=\"mk-about-intro-title\" id=\"values-title\">Four promises we keep</h2>\n      <ul class=\"mk-about-intro-values\">\n        <li\n          ><i data-lucide=\"feather\"></i><h3>Calm by default</h3\n          ><p>No red badges, no dark patterns - attention is our users' to give.</p></li\n        >\n        <li\n          ><i data-lucide=\"lock\"></i><h3>Private first</h3\n          ><p>Your data is yours. We never sell it and never train on it.</p></li\n        >\n        <li><i data-lucide=\"hand-heart\"></i><h3>Kind and direct</h3><p>We say what we mean, and we mean well.</p></li>\n        <li\n          ><i data-lucide=\"leaf\"></i><h3>Built to last</h3\n          ><p>Profitable, independent and here for the next decade.</p></li\n        >\n      </ul>\n    </div>\n  </section>\n  <ol class=\"mk-process-steps\" data-variant=\"horizontal\">\n    <li class=\"mk-process-step\">\n      <span class=\"mk-process-step-number\" aria-hidden=\"true\">01</span>\n      <div class=\"mk-process-step-body\">\n        <h3 class=\"mk-process-step-title\">Discover</h3>\n        <p class=\"mk-process-step-desc\">Two workshops to map goals, users and constraints.</p>\n      </div>\n    </li>\n    <li class=\"mk-process-step\">\n      <span class=\"mk-process-step-number\" aria-hidden=\"true\">02</span>\n      <div class=\"mk-process-step-body\">\n        <h3 class=\"mk-process-step-title\">Design</h3>\n        <p class=\"mk-process-step-desc\">Prototypes tested with real customers every week.</p>\n      </div>\n    </li>\n    <li class=\"mk-process-step\">\n      <span class=\"mk-process-step-number\" aria-hidden=\"true\">03</span>\n      <div class=\"mk-process-step-body\">\n        <h3 class=\"mk-process-step-title\">Build</h3>\n        <p class=\"mk-process-step-desc\">Small releases behind flags - nothing big-bang.</p>\n      </div>\n    </li>\n    <li class=\"mk-process-step\">\n      <span class=\"mk-process-step-number\" aria-hidden=\"true\">04</span>\n      <div class=\"mk-process-step-body\">\n        <h3 class=\"mk-process-step-title\">Grow</h3>\n        <p class=\"mk-process-step-desc\">We measure, learn and hand over a team that can run it.</p>\n      </div>\n    </li>\n  </ol>\n  <div\n    style=\"\n      display: grid;\n      grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));\n      gap: 2rem 1.25rem;\n      width: 100%;\n    \"\n  >\n    <article class=\"mk-team-member\" aria-labelledby=\"tm-0\">\n      <div class=\"mk-team-member-portrait\">\n        <img class=\"mk-team-member-photo\" src=\"https://i.pravatar.cc/480?img=25\" alt=\"Portrait of Sophie Tan\" />\n        <span class=\"mk-team-member-tag\"><i data-lucide=\"map-pin\"></i>Lisbon</span>\n        <ul class=\"mk-team-member-links\">\n          <li\n            ><a href=\"#\" aria-label=\"Sophie Tan on LinkedIn\"\n              ><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\">\n                <path\n                  d=\"M5 3.5A2.5 2.5 0 1 1 5 8.5 2.5 2.5 0 0 1 5 3.5ZM3 10h4v11H3V10Zm7 0h3.8v1.6h.1c.5-1 1.8-1.9 3.6-1.9 3.9 0 4.5 2.5 4.5 5.8V21h-4v-4.9c0-1.2 0-2.7-1.7-2.7s-2 1.3-2 2.6v5h-4V10Z\"\n                /></svg></a\n          ></li>\n          <li\n            ><a href=\"#\" aria-label=\"Sophie Tan on GitHub\"\n              ><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\">\n                <path\n                  d=\"M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2.1c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5Z\"\n                /></svg></a\n          ></li>\n          <li\n            ><a href=\"#\" aria-label=\"Sophie Tan on X\"\n              ><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\">\n                <path\n                  d=\"M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-6.4L6.4 22H3.3l7.3-8.3L.8 2h6.4l4.4 5.9L18.9 2Zm-1.1 18h1.7L6.3 3.9H4.5L17.8 20Z\"\n                /></svg></a\n          ></li>\n          <li\n            ><a href=\"#\" aria-label=\"Email Sophie Tan\"><i data-lucide=\"mail\"></i></a\n          ></li>\n        </ul>\n      </div>\n      <div class=\"mk-team-member-body\">\n        <h3 class=\"mk-team-member-name\" id=\"tm-0\">Sophie Tan</h3>\n        <p class=\"mk-team-member-role\">Head of Engineering</p>\n        <p class=\"mk-team-member-bio\">Builds the sync engine. Previously at a database company you have heard of.</p>\n      </div>\n    </article>\n    <article class=\"mk-team-member\" aria-labelledby=\"tm-1\">\n      <div class=\"mk-team-member-portrait\">\n        <img class=\"mk-team-member-photo\" src=\"https://i.pravatar.cc/480?img=32\" alt=\"Portrait of Hannah Lee\" />\n        <span class=\"mk-team-member-tag\"><i data-lucide=\"map-pin\"></i>Berlin</span>\n        <ul class=\"mk-team-member-links\">\n          <li\n            ><a href=\"#\" aria-label=\"Hannah Lee on LinkedIn\"\n              ><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\">\n                <path\n                  d=\"M5 3.5A2.5 2.5 0 1 1 5 8.5 2.5 2.5 0 0 1 5 3.5ZM3 10h4v11H3V10Zm7 0h3.8v1.6h.1c.5-1 1.8-1.9 3.6-1.9 3.9 0 4.5 2.5 4.5 5.8V21h-4v-4.9c0-1.2 0-2.7-1.7-2.7s-2 1.3-2 2.6v5h-4V10Z\"\n                /></svg></a\n          ></li>\n          <li\n            ><a href=\"#\" aria-label=\"Hannah Lee on GitHub\"\n              ><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\">\n                <path\n                  d=\"M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2.1c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5Z\"\n                /></svg></a\n          ></li>\n          <li\n            ><a href=\"#\" aria-label=\"Hannah Lee on X\"\n              ><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\">\n                <path\n                  d=\"M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-6.4L6.4 22H3.3l7.3-8.3L.8 2h6.4l4.4 5.9L18.9 2Zm-1.1 18h1.7L6.3 3.9H4.5L17.8 20Z\"\n                /></svg></a\n          ></li>\n          <li\n            ><a href=\"#\" aria-label=\"Email Hannah Lee\"><i data-lucide=\"mail\"></i></a\n          ></li>\n        </ul>\n      </div>\n      <div class=\"mk-team-member-body\">\n        <h3 class=\"mk-team-member-name\" id=\"tm-1\">Hannah Lee</h3>\n        <p class=\"mk-team-member-role\">Design Lead</p>\n        <p class=\"mk-team-member-bio\">Makes Acme quiet. Believes every badge has to earn its place.</p>\n      </div>\n    </article>\n    <article class=\"mk-team-member\" aria-labelledby=\"tm-2\">\n      <div class=\"mk-team-member-portrait\">\n        <img class=\"mk-team-member-photo\" src=\"https://i.pravatar.cc/480?img=12\" alt=\"Portrait of Aron Homberg\" />\n        <span class=\"mk-team-member-tag\"><i data-lucide=\"map-pin\"></i>Lisbon</span>\n        <ul class=\"mk-team-member-links\">\n          <li\n            ><a href=\"#\" aria-label=\"Aron Homberg on LinkedIn\"\n              ><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\">\n                <path\n                  d=\"M5 3.5A2.5 2.5 0 1 1 5 8.5 2.5 2.5 0 0 1 5 3.5ZM3 10h4v11H3V10Zm7 0h3.8v1.6h.1c.5-1 1.8-1.9 3.6-1.9 3.9 0 4.5 2.5 4.5 5.8V21h-4v-4.9c0-1.2 0-2.7-1.7-2.7s-2 1.3-2 2.6v5h-4V10Z\"\n                /></svg></a\n          ></li>\n          <li\n            ><a href=\"#\" aria-label=\"Aron Homberg on GitHub\"\n              ><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\">\n                <path\n                  d=\"M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2.1c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5Z\"\n                /></svg></a\n          ></li>\n          <li\n            ><a href=\"#\" aria-label=\"Aron Homberg on X\"\n              ><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\">\n                <path\n                  d=\"M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-6.4L6.4 22H3.3l7.3-8.3L.8 2h6.4l4.4 5.9L18.9 2Zm-1.1 18h1.7L6.3 3.9H4.5L17.8 20Z\"\n                /></svg></a\n          ></li>\n          <li\n            ><a href=\"#\" aria-label=\"Email Aron Homberg\"><i data-lucide=\"mail\"></i></a\n          ></li>\n        </ul>\n      </div>\n      <div class=\"mk-team-member-body\">\n        <h3 class=\"mk-team-member-name\" id=\"tm-2\">Aron Homberg</h3>\n        <p class=\"mk-team-member-role\">Co-founder & CEO</p>\n        <p class=\"mk-team-member-bio\">Writes the weekly letter and still answers support on Fridays.</p>\n      </div>\n    </article>\n    <article class=\"mk-team-member\" aria-labelledby=\"tm-3\">\n      <div class=\"mk-team-member-portrait\">\n        <img class=\"mk-team-member-photo\" src=\"https://i.pravatar.cc/480?img=16\" alt=\"Portrait of Priya Natarajan\" />\n        <span class=\"mk-team-member-tag\"><i data-lucide=\"map-pin\"></i>Remote</span>\n        <ul class=\"mk-team-member-links\">\n          <li\n            ><a href=\"#\" aria-label=\"Priya Natarajan on LinkedIn\"\n              ><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\">\n                <path\n                  d=\"M5 3.5A2.5 2.5 0 1 1 5 8.5 2.5 2.5 0 0 1 5 3.5ZM3 10h4v11H3V10Zm7 0h3.8v1.6h.1c.5-1 1.8-1.9 3.6-1.9 3.9 0 4.5 2.5 4.5 5.8V21h-4v-4.9c0-1.2 0-2.7-1.7-2.7s-2 1.3-2 2.6v5h-4V10Z\"\n                /></svg></a\n          ></li>\n          <li\n            ><a href=\"#\" aria-label=\"Priya Natarajan on GitHub\"\n              ><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\">\n                <path\n                  d=\"M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2.1c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5Z\"\n                /></svg></a\n          ></li>\n          <li\n            ><a href=\"#\" aria-label=\"Priya Natarajan on X\"\n              ><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\">\n                <path\n                  d=\"M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-6.4L6.4 22H3.3l7.3-8.3L.8 2h6.4l4.4 5.9L18.9 2Zm-1.1 18h1.7L6.3 3.9H4.5L17.8 20Z\"\n                /></svg></a\n          ></li>\n          <li\n            ><a href=\"#\" aria-label=\"Email Priya Natarajan\"><i data-lucide=\"mail\"></i></a\n          ></li>\n        </ul>\n      </div>\n      <div class=\"mk-team-member-body\">\n        <h3 class=\"mk-team-member-name\" id=\"tm-3\">Priya Natarajan</h3>\n        <p class=\"mk-team-member-role\">Chief Product Officer</p>\n        <p class=\"mk-team-member-bio\">Leads product and research after eight years building tools for hospitals.</p>\n      </div>\n    </article>\n  </div>\n  <ol class=\"mk-timeline-list\">\n    <li class=\"mk-timeline-item\">\n      <time class=\"mk-timeline-item-date\" datetime=\"2016\">2016</time>\n      <div class=\"mk-timeline-item-body\">\n        <h3 class=\"mk-timeline-item-title\">A flat in Lisbon</h3>\n        <p class=\"mk-timeline-item-text\"\n          >Alex and Sophie quit their jobs and build the first prototype on a kitchen table.</p\n        >\n      </div>\n    </li>\n    <li class=\"mk-timeline-item\">\n      <time class=\"mk-timeline-item-date\" datetime=\"2018\">2018</time>\n      <div class=\"mk-timeline-item-body\">\n        <h3 class=\"mk-timeline-item-title\">The first thousand teams</h3>\n        <p class=\"mk-timeline-item-text\">Word of mouth only - we still have no marketing budget.</p>\n      </div>\n    </li>\n    <li class=\"mk-timeline-item\" data-variant=\"milestone\">\n      <time class=\"mk-timeline-item-date\" datetime=\"2021-03\">March 2021</time>\n      <div class=\"mk-timeline-item-body\">\n        <h3 class=\"mk-timeline-item-title\">Acme 2.0 and offline sync</h3>\n        <p class=\"mk-timeline-item-text\">A two-year rewrite ships: Acme works on a plane, in a tunnel, anywhere.</p>\n        <img class=\"mk-timeline-item-media\" src=\"https://picsum.photos/seed/tl-launch/900/506\" alt=\"\" />\n      </div>\n    </li>\n    <li class=\"mk-timeline-item\">\n      <time class=\"mk-timeline-item-date\" datetime=\"2024\">2024</time>\n      <div class=\"mk-timeline-item-body\">\n        <h3 class=\"mk-timeline-item-title\">Berlin and Montreal</h3>\n        <p class=\"mk-timeline-item-text\">Two new offices, forty people, still profitable.</p>\n      </div>\n    </li>\n    <li class=\"mk-timeline-item\">\n      <time class=\"mk-timeline-item-date\" datetime=\"2026\">2026</time>\n      <div class=\"mk-timeline-item-body\">\n        <h3 class=\"mk-timeline-item-title\">Twelve thousand teams</h3>\n        <p class=\"mk-timeline-item-text\">And the calmest release we have ever shipped.</p>\n      </div>\n    </li>\n  </ol>\n  <div style=\"display: grid; grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr)); gap: 1rem; width: 100%\">\n    <article class=\"mk-credential-item\">\n      <span class=\"mk-credential-item-seal\" aria-hidden=\"true\"><i data-lucide=\"shield-check\"></i></span>\n      <div class=\"mk-credential-item-body\">\n        <h3 class=\"mk-credential-item-name\">ISO/IEC 27001:2022</h3>\n        <p class=\"mk-credential-item-issuer\">Issued by TÜV Rheinland</p>\n        <dl class=\"mk-cre