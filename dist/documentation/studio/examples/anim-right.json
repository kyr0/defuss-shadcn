[{"label":"In / out, directions and lifecycle","html":"<style>\n  #anim-right-target {\n    width: 160px;\n    height: 100px;\n    display: grid;\n    place-items: center;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    background: var(--card);\n    color: var(--card-foreground);\n    font-size: 0.875rem;\n    font-weight: 500;\n  }\n  /* .btn carries no aria-pressed styling of its own - mark the active edge */\n  .btn[aria-pressed='true'] {\n    background: var(--accent);\n    color: var(--accent-foreground);\n  }\n</style>\n<div style=\"display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-bottom: 1rem\">\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-right-in\">In</button>\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-right-out\">Out</button>\n  <span\n    id=\"anim-right-dirs\"\n    role=\"group\"\n    aria-label=\"Direction\"\n    style=\"display: inline-flex; gap: 0.25rem; margin-inline: 0.5rem\"\n  >\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-direction=\"north\" aria-pressed=\"false\">N</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-direction=\"south\" aria-pressed=\"false\">S</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-direction=\"west\" aria-pressed=\"true\">W</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-direction=\"east\" aria-pressed=\"false\">E</button>\n  </span>\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-right-pause\">Pause</button>\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-right-resume\">Resume</button>\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-right-finish\">Finish</button>\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-right-reset\">Reset</button>\n  <label style=\"display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.8rem; margin-inline-start: 0.5rem\">\n    ms\n    <input class=\"input\" type=\"number\" id=\"anim-right-duration\" value=\"1500\" min=\"50\" step=\"50\" style=\"width: 6rem\" />\n  </label>\n  <select class=\"select\" id=\"anim-right-easing\" aria-label=\"Easing\">\n    <option value=\"cubic-bezier(0.16, 1, 0.3, 1)\" selected>ease-out (default)</option>\n    <option value=\"ease\">ease</option>\n    <option value=\"ease-in-out\">ease-in-out</option>\n    <option value=\"linear\">linear</option>\n    <option value=\"cubic-bezier(.34, 1.56, .64, 1)\">overshoot</option>\n  </select>\n</div>\n<div id=\"anim-right-target\">Slide Right</div>\n","individual":false},{"label":"Scroll-bound slide-in","html":"<style>\n  #anim-right-scroll-target {\n    width: 160px;\n    height: 100px;\n    display: grid;\n    place-items: center;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    background: var(--card);\n    color: var(--card-foreground);\n    font-size: 0.875rem;\n    font-weight: 500;\n  }\n</style>\n<div\n  id=\"anim-right-scroller\"\n  style=\"\n    height: 220px;\n    overflow-y: auto;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    padding: 1rem;\n  \"\n>\n  <div\n    style=\"\n      height: 600px;\n      display: flex;\n      align-items: flex-start;\n      justify-content: center;\n      font-size: 0.8rem;\n      color: var(--muted-foreground);\n    \"\n    >Scroll down - the slide-in scrubs with the scroll position ↓</div\n  >\n  <div id=\"anim-right-scroll-target\">Slide Right</div>\n</div>\n","individual":false}]
