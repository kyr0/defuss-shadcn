[{"label":"In / out, directions and lifecycle","html":"<style>\n  #anim-up-target {\n    width: 160px;\n    height: 100px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    background: var(--card);\n    color: var(--card-foreground);\n    font-weight: 600;\n  }\n</style>\n<div style=\"display: flex; flex-direction: column; gap: 1rem\">\n  <div\n    style=\"\n      min-height: 200px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      border: 1px dashed var(--border);\n      border-radius: var(--radius-lg);\n      overflow: hidden;\n    \"\n  >\n    <div id=\"anim-up-target\">Slide Up</div>\n  </div>\n  <div style=\"display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-up-in\">In</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-up-out\">Out</button>\n    <span aria-hidden=\"true\" style=\"color: var(--border)\">|</span>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-up-dir-n\" aria-pressed=\"false\">N</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-up-dir-s\" aria-pressed=\"true\">S</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-up-dir-w\" aria-pressed=\"false\">W</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-up-dir-e\" aria-pressed=\"false\">E</button>\n    <span aria-hidden=\"true\" style=\"color: var(--border)\">|</span>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-up-pause\">Pause</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-up-resume\">Resume</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-up-finish\">Finish</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-up-reset\">Reset</button>\n    <label for=\"anim-up-duration\" class=\"text-sm\">Duration</label>\n    <input class=\"input\" id=\"anim-up-duration\" type=\"number\" value=\"1500\" min=\"50\" step=\"50\" style=\"width: 6rem\" />\n    <label for=\"anim-up-easing\" class=\"text-sm\">Easing</label>\n    <select class=\"select\" id=\"anim-up-easing\">\n      <option value=\"cubic-bezier(0.16, 1, 0.3, 1)\" selected>ease-out (default)</option>\n      <option value=\"ease\">ease</option>\n      <option value=\"ease-in-out\">ease-in-out</option>\n      <option value=\"linear\">linear</option>\n      <option value=\"cubic-bezier(0.34, 1.56, 0.64, 1)\">springy</option>\n    </select>\n  </div>\n</div>\n","individual":false},{"label":"Scroll-bound slide up","html":"<style>\n  #anim-up-scroll-target {\n    width: 160px;\n    height: 100px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    background: var(--card);\n    color: var(--card-foreground);\n    font-weight: 600;\n  }\n</style>\n<div\n  id=\"anim-up-scroller\"\n  style=\"height: 220px; overflow-y: auto; border: 1px solid var(--border); border-radius: var(--radius-lg)\"\n>\n  <div style=\"height: 600px; display: flex; align-items: flex-end; justify-content: center; padding-bottom: 2rem\">\n    <div id=\"anim-up-scroll-target\">Scroll drives me</div>\n  </div>\n</div>\n","individual":false}]
