[{"label":"Use Case (card)","html":"<article class=\"mk-use-case\" data-variant=\"card\" aria-labelledby=\"uc-c1\"\n  ><div class=\"mk-use-case-copy\"\n    ><span class=\"mk-use-case-eyebrow\"><i data-lucide=\"headphones\"></i> Support</span\n    ><h3 class=\"mk-use-case-title\" id=\"uc-c1\">Answer tickets from one knowledge base</h3\n    ><p class=\"mk-use-case-text\">Docs your agents and your customers both search.</p\n    ><p class=\"mk-use-case-metric\"><strong>2×</strong> faster first replies</p></div\n  ></article\n>\n","individual":true},{"label":"Default","html":"<article class=\"mk-use-case\" aria-labelledby=\"uc-launch\">\n  <div class=\"mk-use-case-layout\">\n    <div class=\"mk-use-case-copy\">\n      <span class=\"mk-use-case-eyebrow\"><i data-lucide=\"rocket\"></i> For product teams</span>\n      <h2 class=\"mk-use-case-title\" id=\"uc-launch\">Launch with five teams - without the war room</h2>\n      <p class=\"mk-use-case-text\"\n        >Launches stall when marketing, support and engineering plan in different tools. Acme puts the launch plan, the\n        docs and every open question on one board, so each team sees what the others need.</p\n      >\n      <ul class=\"mk-use-case-outcomes\">\n        <li><i data-lucide=\"check\"></i>One launch board that every team updates</li>\n        <li><i data-lucide=\"check\"></i>Release notes drafted from the shipped work</li>\n        <li><i data-lucide=\"check\"></i>Support briefed before customers ask</li>\n      </ul>\n      <p class=\"mk-use-case-metric\"><strong>−40%</strong> time from code freeze to launch</p>\n    </div>\n    <figure class=\"mk-use-case-media\"><img src=\"https://picsum.photos/seed/usecase-launch/1000/750\" alt=\"\" /></figure>\n  </div>\n</article>\n","individual":true},{"label":"Reverse","html":"<article class=\"mk-use-case\" data-variant=\"reverse\" aria-labelledby=\"uc-onboard\">\n  <div class=\"mk-use-case-layout\">\n    <div class=\"mk-use-case-copy\">\n      <span class=\"mk-use-case-eyebrow\"><i data-lucide=\"users\"></i> For people teams</span>\n      <h2 class=\"mk-use-case-title\" id=\"uc-onboard\">Onboard new hires in a week, not a quarter</h2>\n      <p class=\"mk-use-case-text\"\n        >Templates turn your onboarding into a checklist every manager can run - with the right docs linked at the right\n        day.</p\n      >\n      <ul class=\"mk-use-case-outcomes\">\n        <li><i data-lucide=\"check\"></i>A first-week plan per role</li>\n        <li><i data-lucide=\"check\"></i>Buddies and check-ins scheduled automatically</li>\n      </ul>\n      <p class=\"mk-use-case-metric\"><strong>5 days</strong> to the first shipped task</p>\n    </div>\n    <figure class=\"mk-use-case-media\"><img src=\"https://picsum.photos/seed/usecase-onboard/1000/750\" alt=\"\" /></figure>\n  </div>\n</article>\n","individual":true},{"label":"Cards","html":"<div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: 1rem; width: 100%\">\n  <article class=\"mk-use-case\" data-variant=\"card\" aria-labelledby=\"uc-c1\"\n    ><div class=\"mk-use-case-copy\"\n      ><span class=\"mk-use-case-eyebrow\"><i data-lucide=\"headphones\"></i> Support</span\n      ><h3 class=\"mk-use-case-title\" id=\"uc-c1\">Answer tickets from one knowledge base</h3\n      ><p class=\"mk-use-case-text\">Docs your agents and your customers both search.</p\n      ><p class=\"mk-use-case-metric\"><strong>2×</strong> faster first replies</p></div\n    ></article\n  >\n  <article class=\"mk-use-case\" data-variant=\"card\" aria-labelledby=\"uc-c2\"\n    ><div class=\"mk-use-case-copy\"\n      ><span class=\"mk-use-case-eyebrow\"><i data-lucide=\"megaphone\"></i> Marketing</span\n      ><h3 class=\"mk-use-case-title\" id=\"uc-c2\">Plan campaigns with the product team</h3\n      ><p class=\"mk-use-case-text\">One calendar for launches, content and ads.</p\n      ><p class=\"mk-use-case-metric\"><strong>+25%</strong> campaigns on time</p></div\n    ></article\n  >\n  <article class=\"mk-use-case\" data-variant=\"card\" aria-labelledby=\"uc-c3\"\n    ><div class=\"mk-use-case-copy\"\n      ><span class=\"mk-use-case-eyebrow\"><i data-lucide=\"graduation-cap\"></i> Education</span\n      ><h3 class=\"mk-use-case-title\" id=\"uc-c3\">Run a semester of projects</h3\n      ><p class=\"mk-use-case-text\">Students, teachers and deadlines in one space.</p\n      ><p class=\"mk-use-case-metric\"><strong>300</strong> schools on Acme</p></div\n    ></article\n  >\n</div>\n","individual":false}]
