     data-node=\"utils\"\n      data-tone=\"muted\"\n      data-badge=\"3 in\"\n      data-step=\"3\"\n      style=\"--col: 3; --row: 3\"\n      ><span class=\"diagram-node-name\">utils</span></div\n    >\n    <div\n      class=\"diagram-node\"\n      data-node=\"zod\"\n      data-tone=\"external\"\n      data-badge=\"1 in\"\n      data-step=\"3\"\n      style=\"--col: 4; --row: 3\"\n    >\n      <span class=\"diagram-node-eyebrow\">Third-party</span>\n      <span class=\"diagram-node-name\">zod</span>\n    </div>\n    <div\n      class=\"diagram-node\"\n      data-node=\"config\"\n      data-tone=\"muted\"\n      data-badge=\"1 in\"\n      data-step=\"4\"\n      style=\"--col: 2; --row: 4\"\n      ><span class=\"diagram-node-name\">config</span></div\n    >\n  </div>\n  <ol class=\"diagram-edges\">\n    <li class=\"diagram-edge\" data-from=\"web\" data-to=\"ui\"></li>\n    <li class=\"diagram-edge\" data-from=\"web\" data-to=\"client\"></li>\n    <li class=\"diagram-edge\" data-from=\"admin\" data-to=\"ui\"></li>\n    <li class=\"diagram-edge\" data-from=\"admin\" data-to=\"client\"></li>\n    <li class=\"diagram-edge\" data-from=\"cli\" data-to=\"client\"></li>\n    <li class=\"diagram-edge\" data-from=\"client\" data-to=\"auth\"></li>\n    <li class=\"diagram-edge\" data-from=\"client\" data-to=\"utils\"></li>\n    <li class=\"diagram-edge\" data-from=\"client\" data-to=\"zod\"></li>\n    <li class=\"diagram-edge\" data-from=\"ui\" data-to=\"utils\"></li>\n    <li class=\"diagram-edge\" data-from=\"auth\" data-to=\"config\"></li>\n    <li\n      class=\"diagram-edge\"\n      data-from=\"config\"\n      data-to=\"client\"\n      data-curve=\"around\"\n      data-line=\"dashed\"\n      data-tone=\"accent\"\n      data-step=\"5\"\n      >cycle</li\n    >\n  </ol>\n  <ul class=\"diagram-legend\">\n    <li data-swatch=\"line\">imports</li>\n    <li data-swatch=\"external\">Third-party</li>\n    <li data-swatch=\"muted\">Leaf</li>\n    <li data-swatch=\"accent-line\">C