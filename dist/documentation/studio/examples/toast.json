[{"label":"Default","html":"<button\n  class=\"btn\"\n  data-variant=\"default\"\n  onclick=\"df$.shadcn.toast.show({ title: 'Event created', description: 'Monday, January 3rd at 6:00pm' })\"\n>\n  Show Toast\n</button>\n","individual":false},{"label":"Variants","html":"<button\n  class=\"btn\"\n  data-variant=\"outline\"\n  onclick=\"df$.shadcn.toast.success({ title: 'Success', description: 'Your changes have been saved.' })\"\n>\n  Success\n</button>\n<button\n  class=\"btn\"\n  data-variant=\"outline\"\n  onclick=\"df$.shadcn.toast.warning({ title: 'Warning', description: 'Your session will expire in 5 minutes.' })\"\n>\n  Warning\n</button>\n<button\n  class=\"btn\"\n  data-variant=\"outline\"\n  onclick=\"df$.shadcn.toast.info({ title: 'Info', description: 'A new version is available for download.' })\"\n>\n  Info\n</button>\n<button\n  class=\"btn\"\n  data-variant=\"destructive\"\n  onclick=\"df$.shadcn.toast.error({ title: 'Error', description: 'Something went wrong. Please try again.' })\"\n>\n  Error\n</button>\n","individual":false},{"label":"With Description","html":"<button\n  class=\"btn\"\n  data-variant=\"outline\"\n  onclick=\"\n    df$.shadcn.toast.show({ title: 'Scheduled', description: 'Your report will be generated at 9:00 AM tomorrow.' })\n  \"\n>\n  Show Toast\n</button>\n","individual":false},{"label":"With Action","html":"<button\n  class=\"btn\"\n  data-variant=\"outline\"\n  onclick=\"\n    df$.shadcn.toast.show({\n      title: 'Changes saved',\n      description: 'Your profile has been updated.',\n      action: { label: 'Undo', onClick: () => df$.shadcn.toast.show('Undone!') },\n    })\n  \"\n>\n  Show Toast\n</button>\n","individual":false},{"label":"Stacked toasts","html":"<div class=\"flex flex-wrap gap-2\">\n  <button class=\"btn\" id=\"pile-send\">Send 3 notifications</button>\n  <button class=\"btn\" data-variant=\"outline\" id=\"pile-mode\" aria-pressed=\"true\">Mode: pile</button>\n</div>\n","individual":false},{"label":"Animations","html":"<div class=\"flex flex-wrap gap-2\">\n  <button\n    class=\"btn\"\n    data-variant=\"outline\"\n    onclick=\"\n      df$.shadcn.toast.show({\n        title: 'Slide in',\n        description: 'From the east edge, out the same way.',\n        animation: { in: 'slideIn', out: 'slideOut', direction: 'east' },\n      })\n    \"\n    >Slide</button\n  >\n  <button\n    class=\"btn\"\n    data-variant=\"outline\"\n    onclick=\"\n      df$.shadcn.toast.success({\n        title: 'Pop',\n        description: 'A springy scale-in.',\n        animation: { in: 'popIn', out: 'popOut' },\n      })\n    \"\n    >Pop</button\n  >\n  <button\n    class=\"btn\"\n    data-variant=\"outline\"\n    onclick=\"\n      df$.shadcn.toast.info({\n        title: 'Flip',\n        description: 'Turns in on its axis.',\n        animation: { in: 'flipIn', out: 'flipOut' },\n      })\n    \"\n    >Flip</button\n  >\n  <button\n    class=\"btn\"\n    data-variant=\"outline\"\n    onclick=\"\n      df$.shadcn.toast.show({\n        title: 'Blur',\n        description: 'Comes into focus.',\n        animation: { in: 'blurIn', out: 'blurOut' },\n      })\n    \"\n    >Blur</button\n  >\n  <button\n    class=\"btn\"\n    data-variant=\"outline\"\n    onclick=\"\n      df$.shadcn.toast.warning({\n        title: 'Zoom',\n        description: 'Grows from the corner.',\n        animation: { in: 'zoomIn', out: 'zoomOut' },\n      })\n    \"\n    >Zoom</button\n  >\n  <button\n    class=\"btn\"\n    data-variant=\"outline\"\n    onclick=\"\n      df$.shadcn.toast.show({\n        title: 'Wipe',\n        description: 'Revealed edge to edge.',\n        animation: { in: 'wipeIn', out: 'wipeOut', direction: 'west' },\n      })\n    \"\n    >Wipe</button\n  >\n</div>\n","individual":false},{"label":"Aura","html":"<div class=\"flex flex-wrap gap-2\">\n  <button\n    class=\"btn\"\n    onclick=\"\n      df$.shadcn.toast.show({\n        title: 'You are live',\n        description: 'Your stream started - 128 viewers.',\n        aura: true,\n        animation: { in: 'popIn', out: 'fadeOut' },\n      })\n    \"\n    >Aura</button\n  >\n  <button\n    class=\"btn\"\n    data-variant=\"outline\"\n    onclick=\"\n      df$.shadcn.toast.success({\n        title: 'Achievement unlocked',\n        description: '100 deploys without a rollback.',\n        aura: 'rainbow',\n        animation: { in: 'zoomIn', out: 'zoomOut' },\n      })\n    \"\n    >Rainbow</button\n  >\n  <button\n    class=\"btn\"\n    data-variant=\"outline\"\n    onclick=\"df$.shadcn.toast.show({ title: 'Welcome to Pro', description: 'Your upgrade is active.', aura: 'gold' })\"\n    >Gold</button\n  >\n</div>\n","individual":false},{"label":"Size & Density","html":"<div class=\"flex flex-wrap gap-2\">\n  <button\n    class=\"btn\"\n    data-variant=\"outline\"\n    onclick=\"df$.shadcn.toast.show({ title: 'Narrow toast', description: 'Width envelope sm.', size: 'sm' })\"\n    >Size sm</button\n  >\n  <button\n    class=\"btn\"\n    data-variant=\"outline\"\n    onclick=\"df$.shadcn.toast.show({ title: 'Wide toast', description: 'Width envelope lg.', size: 'lg' })\"\n    >Size lg</button\n  >\n  <button\n    class=\"btn\"\n    data-variant=\"outline\"\n    onclick=\"\n      df$.shadcn.toast.show({ title: 'Compact toast', description: 'Tighter padding and gap.', density: 'compact' })\n    \"\n    >Density compact</button\n  >\n  <button\n    class=\"btn\"\n    data-variant=\"outline\"\n    onclick=\"\n      df$.shadcn.toast.show({ title: 'Spacious toast', description: 'Roomier padding and gap.', density: 'spacious' })\n    \"\n    >Density spacious</button\n  >\n</div>\n","individual":false}]
