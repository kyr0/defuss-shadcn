[{"label":"Textarea (readonly)","html":"<textarea class=\"textarea\" id=\"ed-brief-out\" rows=\"8\" readonly aria-label=\"The document as Markdown\" placeholder=\"Click Read as Markdown\"></textarea>\n","individual":true},{"label":"Default","html":"<textarea class=\"textarea\" placeholder=\"Type your message...\"></textarea>\n","individual":true},{"label":"Disabled","html":"<textarea class=\"textarea\" disabled></textarea>\n","individual":true},{"label":"With description","html":"<label class=\"label\" for=\"bio\">Bio</label>\n<textarea class=\"textarea\" id=\"bio\" placeholder=\"Tell us...\" aria-describedby=\"bio-desc\"></textarea>\n<p class=\"field-description\" id=\"bio-desc\">You can use markdown.</p>\n","individual":false},{"label":"Rows and a limit","html":"<div class=\"flex flex-col gap-2\" style=\"max-width: 28rem\">\n  <label class=\"label\" for=\"notes\">Notes</label>\n  <textarea\n    class=\"textarea\"\n    id=\"notes\"\n    data-rows=\"2\"\n    data-max-rows=\"6\"\n    data-resize=\"none\"\n    placeholder=\"Type a few lines - it grows, then scrolls\"\n  >\nLine one\nLine two\nLine three</textarea>\n</div>\n","individual":false},{"label":"Character count","html":"<div class=\"flex flex-col gap-2\" style=\"max-width: 28rem\">\n  <label class=\"label\" for=\"about\">About you</label>\n  <textarea\n    class=\"textarea\"\n    id=\"about\"\n    data-rows=\"3\"\n    maxlength=\"160\"\n    aria-describedby=\"about-count\"\n    placeholder=\"Tell people about yourself\"\n  ></textarea>\n  <output class=\"field-description\" id=\"about-count\" for=\"about\">0 / 160</output>\n</div>\n","individual":false},{"label":"Composer","html":"<div class=\"flex flex-col gap-3\" style=\"max-width: 34rem\">\n  <form class=\"textarea-group\" id=\"composer\" aria-label=\"Message composer\">\n    <ul class=\"file-drop-list\" aria-label=\"Attachments\"></ul>\n    <textarea\n      class=\"textarea\"\n      data-rows=\"1\"\n      data-max-rows=\"6\"\n      name=\"message\"\n      placeholder=\"Write a message - Enter sends, Shift+Enter adds a line\"\n      aria-label=\"Message\"\n    ></textarea>\n    <div class=\"textarea-group-actions\">\n      <button class=\"btn\" data-variant=\"ghost\" data-size=\"icon-sm\" type=\"button\" data-attach aria-label=\"Attach images\"\n        ><i data-lucide=\"plus\"></i\n      ></button>\n      <input type=\"file\" accept=\"image/*\" multiple hidden data-files />\n      <span class=\"textarea-group-spacer\"></span>\n      <output class=\"textarea-group-count\" data-count>0 / 500</output>\n      <button class=\"btn\" data-size=\"icon-sm\" type=\"submit\" data-send aria-label=\"Send\" disabled\n        ><i data-lucide=\"arrow-up\"></i\n      ></button>\n    </div>\n  </form>\n  <ul class=\"text-sm m-0 ps-5 flex flex-col gap-1\" id=\"composer-log\" aria-label=\"Sent\"></ul>\n</div>\n","individual":false},{"label":"Inline composer","html":"<div class=\"flex flex-col gap-3\" style=\"max-width: 34rem\">\n  <form class=\"textarea-group\" data-layout=\"inline\" id=\"composer-inline\" aria-label=\"Message composer\">\n    <ul class=\"file-drop-list\" aria-label=\"Attachments\"></ul>\n    <div class=\"textarea-group-actions\">\n      <button class=\"btn\" data-variant=\"ghost\" data-size=\"icon-sm\" type=\"button\" data-attach aria-label=\"Attach images\"\n        ><i data-lucide=\"plus\"></i\n      ></button>\n      <input type=\"file\" accept=\"image/*\" multiple hidden data-files />\n    </div>\n    <textarea\n      class=\"textarea\"\n      data-rows=\"1\"\n      data-max-rows=\"6\"\n      name=\"message\"\n      placeholder=\"Message - Enter sends\"\n      aria-label=\"Message\"\n    ></textarea>\n    <div class=\"textarea-group-actions\">\n      <button class=\"btn\" data-size=\"icon-sm\" type=\"submit\" data-send aria-label=\"Send\" disabled\n        ><i data-lucide=\"arrow-up\"></i\n      ></button>\n    </div>\n  </form>\n  <ul class=\"text-sm m-0 ps-5 flex flex-col gap-1\" id=\"composer-inline-log\" aria-label=\"Sent\"></ul>\n</div>\n","individual":false}]
