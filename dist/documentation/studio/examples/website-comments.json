[{"label":"A discussion","html":"<section\n  id=\"site-comments\"\n  data-i18n-component\n  aria-labelledby=\"discussion-title\"\n  style=\"display: flex; flex-direction: column; gap: 1.25rem; width: 100%; max-width: 44rem\"\n>\n  <div class=\"flex justify-end\">\n    <select\n      class=\"select\"\n      data-size=\"sm\"\n      data-app-locale\n      aria-label=\"Language\"\n      data-i18n-aria-label-en=\"Language\"\n      data-i18n-aria-label-de=\"Sprache\"\n      style=\"width: auto\"\n    >\n      <option value=\"en\" lang=\"en\">English</option>\n      <option value=\"de\" lang=\"de\">Deutsch</option>\n    </select>\n  </div>\n  <header class=\"mk-comment-header\">\n    <h2 class=\"mk-comment-header-title\" id=\"discussion-title\"\n      ><span data-i18n-target=\"title\">Comments</span> <span class=\"badge\" data-variant=\"secondary\">3</span></h2\n    >\n    <div class=\"mk-comment-header-actions\">\n      <label class=\"mk-comment-header-sort\"\n        ><span data-i18n-target=\"sort\">Sort by</span>\n        <select class=\"select\" data-size=\"sm\" name=\"sort\" data-comments-sort>\n          <option value=\"top\" data-i18n-target=\"sort-top\">Top</option>\n          <option value=\"newest\" data-i18n-target=\"sort-newest\">Newest</option>\n          <option value=\"oldest\" data-i18n-target=\"sort-oldest\">Oldest</option>\n        </select>\n      </label>\n    </div>\n  </header>\n  <form\n    class=\"mk-comment-form\"\n    aria-label=\"Add a comment\"\n    data-i18n-aria-label-en=\"Add a comment\"\n    data-i18n-aria-label-de=\"Einen Kommentar schreiben\"\n  >\n    <span class=\"avatar\"><img class=\"avatar-image\" src=\"images/mk-portrait.png\" alt=\"\" /></span>\n    <div class=\"mk-comment-form-main\">\n      <textarea\n        class=\"textarea\"\n        name=\"comment\"\n        rows=\"2\"\n        required\n        minlength=\"2\"\n        placeholder=\"Join the discussion…\" data-i18n-placeholder-en=\"Join the discussion…\" data-i18n-placeholder-de=\"Diskutiere mit…\"\n        aria-label=\"Comment\" data-i18n-aria-label-en=\"Comment\" data-i18n-aria-label-de=\"Kommentar\"\n      ></textarea>\n      <div class=\"mk-comment-form-footer\">\n        <p class=\"mk-comment-form-hint\" data-i18n-target=\"hint\">Markdown works. Be kind.</p>\n        <button type=\"submit\" class=\"btn\" data-i18n-target=\"post\">Post comment</button>\n      </div>\n    </div>\n  </form>\n  <div data-comments-thread>\n    <article class=\"mk-comment-item\" id=\"d-1\" data-likes=\"24\">\n      <span class=\"avatar\"><img class=\"avatar-image\" src=\"images/mk-portrait2.png\" alt=\"\" /></span>\n      <div class=\"mk-comment-item-main\">\n        <header class=\"mk-comment-item-head\">\n          <a class=\"mk-comment-item-author\" href=\"#\">Hannah Lee</a>\n          <a class=\"mk-comment-item-time\" href=\"#/comments/d-1\" data-router-link\n            ><time datetime=\"2026-10-01T08:12\" data-i18n-target=\"time-d-1\"\n              ><span data-i18n-value=\"ago1\">2 hours ago</span></time\n            ></a\n          >\n        </header>\n        <div class=\"mk-comment-item-body\"\n          ><p\n            >The write-ahead log section finally made CRDTs click for me. Would love a follow-up on how you\n            garbage-collect old operations.</p\n          ></div\n        >\n        <footer class=\"mk-comment-item-actions\">\n          <button\n            type=\"button\"\n            class=\"btn\"\n            data-variant=\"ghost\"\n            data-size=\"xs\"\n            aria-label=\"Like (24)\"\n            data-i18n-aria-label-en=\"Like (24)\"\n            data-i18n-aria-label-de=\"Gefällt mir (24)\"\n            ><i data-lucide=\"thumbs-up\"></i> 24</button\n          >\n          <button type=\"button\" class=\"btn\" data-variant=\"ghost\" data-size=\"xs\"\n            ><i data-lucide=\"reply\"></i> <span data-i18n-target=\"reply-1\">Reply</span></button\n          >\n        </footer>\n      </div>\n      <ol class=\"mk-comment-item-replies\">\n        <li>\n          <article class=\"mk-comment-item\" id=\"d-2\">\n            <span class=\"avatar\"><img class=\"avatar-image\" src=\"images/mk-portrait.png\" alt=\"\" /></span>\n            <div class=\"mk-comment-item-main\">\n              <header class=\"mk-comment-item-head\">\n                <a class=\"mk-comment-item-author\" href=\"#\">Sophie Tan</a\n                ><span class=\"badge\" data-variant=\"outline\" data-i18n-target=\"author\">Author</span>\n                <a class=\"mk-comment-item-time\" href=\"#/comments/d-2\" data-router-link\n                  ><time datetime=\"2026-10-01T09:03\" data-i18n-target=\"time-d-2\"\n                    ><span data-i18n-value=\"ago2\">1 hour ago</span></time\n                  ></a\n                >\n              </header>\n              <div class=\"mk-comment-item-body\"\n                ><p\n                  >That is next on the list! Short version: we compact once every replica has acknowledged an\n                  operation.</p\n                ></div\n              >\n              <footer class=\"mk-comment-item-actions\">\n                <button\n                  type=\"button\"\n                  class=\"btn\"\n                  data-variant=\"ghost\"\n                  data-size=\"xs\"\n                  aria-label=\"Like (11)\"\n                  data-i18n-aria-label-en=\"Like (11)\"\n                  data-i18n-aria-label-de=\"Gefällt mir (11)\"\n                  ><i data-lucide=\"thumbs-up\"></i> 11</button\n                >\n                <button type=\"button\" class=\"btn\" data-variant=\"ghost\" data-size=\"xs\"\n                  ><i data-lucide=\"reply\"></i> <span data-i18n-target=\"reply-2\">Reply</span></button\n                >\n              </footer>\n            </div>\n          </article>\n        </li>\n        <li>\n          <article class=\"mk-comment-item\" id=\"d-3\">\n            <span class=\"avatar\"><img class=\"avatar-image\" src=\"images/mk-portrait.png\" alt=\"\" /></span>\n            <div class=\"mk-comment-item-main\">\n              <header class=\"mk-comment-item-head\">\n                <a class=\"mk-comment-item-author\" href=\"#\">Aron Homberg</a>\n                <a class=\"mk-comment-item-time\" href=\"#/comments/d-3\" data-router-link\n                  ><time datetime=\"2026-10-01T09:30\" data-i18n-target=\"time-d-3\"\n                    ><span data-i18n-value=\"ago3\">40 minutes ago</span></time\n                  ></a\n                >\n              </header>\n              <div class=\"mk-comment-item-body\"><p>Seconded - and how it plays with the 30-day branch rule.</p></div>\n              <footer class=\"mk-comment-item-actions\">\n                <button\n                  type=\"button\"\n                  class=\"btn\"\n                  data-variant=\"ghost\"\n                  data-size=\"xs\"\n                  aria-label=\"Like (3)\"\n                  data-i18n-aria-label-en=\"Like (3)\"\n                  data-i18n-aria-label-de=\"Gefällt mir (3)\"\n                  ><i data-lucide=\"thumbs-up\"></i> 3</button\n                >\n                <button type=\"button\" class=\"btn\" data-variant=\"ghost\" data-size=\"xs\"\n                  ><i data-lucide=\"reply\"></i> <span data-i18n-target=\"reply-3\">Reply</span></button\n                >\n              </footer>\n            </div>\n          </article>\n        </li>\n      </ol>\n    </article>\n    <article class=\"mk-comment-item\" id=\"d-4\" data-likes=\"5\">\n      <span class=\"avatar\"><img class=\"avatar-image\" src=\"images/mk-portrait2.png\" alt=\"\" /></span>\n      <div class=\"mk-comment-item-main\">\n        <header class=\"mk-comment-item-head\">\n          <a class=\"mk-comment-item-author\" href=\"#\">Priya Natarajan</a>\n          <a class=\"mk-comment-item-time\" href=\"#/comments/d-4\" data-router-link\n            ><time datetime=\"2026-10-01T07:02\" data-i18n-target=\"time-d-4\"\n              ><span data-i18n-value=\"ago4\">3 hours ago</span></time\n            ></a\n          >\n        </header>\n        <div class=\"mk-comment-item-body\"><p>Is the 30-day branch rule configurable per workspace?</p></div>\n        <footer class=\"mk-comment-item-actions\">\n          <button\n            type=\"button\"\n            class=\"btn\"\n            data-variant=\"ghost\"\n            data-size=\"xs\"\n            aria-label=\"Like (5)\"\n            data-i18n-aria-label-en=\"Like (5)\"\n            data-i18n-aria-label-de=\"Gefällt mir (5)\"\n            ><i data-lucide=\"thumbs-up\"></i> 5</button\n          >\n          <button type=\"button\" class=\"btn\" data-variant=\"ghost\" data-size=\"xs\"\n            ><i data-lucide=\"reply\"></i> <span data-i18n-target=\"reply-4\">Reply</span></button\n          >\n        </footer>\n      </div>\n    </article>\n    <form\n      class=\"mk-comment-form\"\n      data-variant=\"reply\"\n      aria-label=\"Reply to Priya Natarajan\"\n      data-i18n-aria-label-en=\"Reply to Priya Natarajan\"\n      data-i18n-aria-label-de=\"Priya Natarajan antworten\"\n      style=\"padding-inline-start: 3.25rem\"\n    >\n      <span class=\"avatar\" data-size=\"sm\"><img class=\"avatar-image\" src=\"images/mk-portrait.png\" alt=\"\" /></span>\n      <div class=\"mk-comment-form-main\">\n        <textarea\n          class=\"textarea\"\n          name=\"reply\"\n          rows=\"1\"\n          required\n          placeholder=\"Reply to Priya…\" data-i18n-placeholder-en=\"Reply to Priya…\" data-i18n-placeholder-de=\"Priya antworten…\"\n          aria-label=\"Reply to Priya Natarajan\" data-i18n-aria-label-en=\"Reply to Priya Natarajan\" data-i18n-aria-label-de=\"Priya Natarajan antworten\"\n        ></textarea>\n        <div class=\"mk-comment-form-footer\">\n          <button type=\"reset\" class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" data-i18n-target=\"cancel\">Cancel</button>\n          <button type=\"submit\" class=\"btn\" data-size=\"sm\" data-i18n-target=\"reply-submit\">Reply</button>\n        </div>\n      </div>\n    </form>\n  </div>\n  <!-- the translations: one template per target and language (defuss-i18n) -->\n  <template data-i18n-for=\"title\" data-i18n-locale=\"en\">Comments</template>\n  <template data-i18n-for=\"title\" data-i18n-locale=\"de\">Kommentare</template>\n  <template data-i18n-for=\"sort\" data-i18n-locale=\"en\">Sort by</template>\n  <template data-i18n-for=\"sort\" data-i18n-locale=\"de\">Sortieren nach</template>\n  <template data-i18n-for=\"sort-top\" data-i18n-locale=\"en\">Top</template>\n  <template data-i18n-for=\"sort-top\" data-i18n-locale=\"de\">Beliebteste</template>\n  <template data-i18n-for=\"sort-newest\" data-i18n-locale=\"en\">Newest</template>\n  <template data-i18n-for=\"sort-newest\" data-i18n-locale=\"de\">Neueste</template>\n  <template data-i18n-for=\"sort-oldest\" data-i18n-locale=\"en\">Oldest</template>\n  <template data-i18n-for=\"sort-oldest\" data-i18n-locale=\"de\">Älteste</template>\n  <template data-i18n-for=\"hint\" data-i18n-locale=\"en\">Markdown works. Be kind.</template>\n  <template data-i18n-for=\"hint\" data-i18n-locale=\"de\">Markdown funktioniert. Sei freundlich.</template>\n  <template data-i18n-for=\"post\" data-i18n-locale=\"en\">Post comment</template>\n  <template data-i18n-for=\"post\" data-i18n-locale=\"de\">Kommentar senden</template>\n  <template data-i18n-for=\"author\" data-i18n-locale=\"en\">Author</template>\n  <template data-i18n-for=\"author\" data-i18n-locale=\"de\">Autorin</template>\n  <template data-i18n-for=\"reply-1\" data-i18n-locale=\"en\">Reply</template>\n  <template data-i18n-for=\"reply-1\" data-i18n-locale=\"de\">Antworten</template>\n  <template data-i18n-for=\"reply-2\" data-i18n-locale=\"en\">Reply</template>\n  <template data-i18n-for=\"reply-2\" data-i18n-locale=\"de\">Antworten</template>\n  <template data-i18n-for=\"reply-3\" data-i18n-locale=\"en\">Reply</template>\n  <template data-i18n-for=\"reply-3\" data-i18n-locale=\"de\">Antworten</template>\n  <template data-i18n-for=\"reply-4\" data-i18n-locale=\"en\">Reply</template>\n  <template data-i18n-for=\"reply-4\" data-i18n-locale=\"de\">Antworten</template>\n  <template data-i18n-for=\"time-d-1\" data-i18n-locale=\"en\"><span data-i18n-value=\"ago1\"></span></template>\n  <template data-i18n-for=\"time-d-1\" data-i18n-locale=\"de\"><span data-i18n-value=\"ago1\"></span></template>\n  <template data-i18n-for=\"time-d-2\" data-i18n-locale=\"en\"><span data-i18n-value=\"ago2\"></span></template>\n  <template data-i18n-for=\"time-d-2\" data-i18n-locale=\"de\"><span data-i18n-value=\"ago2\"></span></template>\n  <template data-i18n-for=\"time-d-3\" data-i18n-locale=\"en\"><span data-i18n-value=\"ago3\"></span></template>\n  <template data-i18n-for=\"time-d-3\" data-i18n-locale=\"de\"><span data-i18n-value=\"ago3\"></span></template>\n  <template data-i18n-for=\"time-d-4\" data-i18n-locale=\"en\"><span data-i18n-value=\"ago4\"></span></template>\n  <template data-i18n-for=\"time-d-4\" data-i18n-locale=\"de\"><span data-i18n-value=\"ago4\"></span></template>\n  <template data-i18n-for=\"cancel\" data-i18n-locale=\"en\">Cancel</template>\n  <template data-i18n-for=\"cancel\" data-i18n-locale=\"de\">Abbrechen</template>\n  <template data-i18n-for=\"reply-submit\" data-i18n-locale=\"en\">Reply</template>\n  <template data-i18n-for=\"reply-submit\" data-i18n-locale=\"de\">Antworten</template>\n</section>\n","individual":false}]
