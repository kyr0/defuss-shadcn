[{"label":"Art Deco Night","html":"<section\n  class=\"presentation\"\n  id=\"deck-waterfall\"\n  data-anim-in=\"irisIn\"\n  data-anim-out=\"fadeOut\"\n  style=\"\n    --presentation-ink: #07111f;\n    --presentation-ink-foreground: #f8e8b6;\n    --presentation-paper: #f8e8b6;\n    --presentation-paper-foreground: #0a1727;\n    --presentation-accent: #e2b857;\n    font-family: Georgia, 'Times New Roman', serif;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"Aurora Cinemas - the 2025 revenue bridge\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Revenue bridge of Aurora Cinemas from 48.2 to 55.3 million euros, morphing into a running total, a ranking of movers and a revenue donut\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Cover\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\">Waterfall · Art Deco Night</p>\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        position: relative;\n        max-width: 1250px;\n        text-transform: uppercase;\n        letter-spacing: 0.03em;\n        font-weight: 400;\n        font-size: 6.25rem;\n      \"\n      >How 2025 reached €55.3 M</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >Aurora Cinemas turned last year’s €48.2 M into a record - six moves, two of them against us.</p\n    >\n    <p aria-hidden=\"true\" style=\"letter-spacing: 1.5rem; color: #e2b857; font-size: 1.75rem; margin: 2.5rem 0 0\"\n      >◆ ◆ ◆</p\n    >\n    <p class=\"presentation-note\">Open on the result; the deck is the explanation.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"bridge\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"The bridge\"\n  >\n    <header class=\"presentation-header\"><span>The bridge</span><span>€ M · 2024 → 2025</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        text-transform: uppercase;\n        letter-spacing: 0.03em;\n        font-weight: 400;\n      \"\n      >Four gains, two losses, one record year</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Let the bars build - the invisible baseline does the heavy lifting.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"thread\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Running total\"\n  >\n    <header class=\"presentation-header\"><span>Second reading</span><span>The gold thread</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        text-transform: uppercase;\n        letter-spacing: 0.03em;\n        font-weight: 400;\n      \"\n      >The running total never fell back to the start</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Same data, cumulative instead of incremental.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"movers\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Movers ranked\"\n  >\n    <header class=\"presentation-header\"><span>Third reading</span><span>Ranked by size</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        text-transform: uppercase;\n        letter-spacing: 0.03em;\n        font-weight: 400;\n      \"\n      >Tickets carried the year - the streaming window hurt most</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Out of journey order, the bars answer: what mattered most?</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"The movers\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Three numbers for the board</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #5ab7a5;\n            font-weight: 400;\n          \"\n          >+€<span data-count=\"6.4\">6.4</span> M</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\"\n          >from ticket sales - attendance up 11%</p\n        >\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #e2b857;\n            font-weight: 400;\n          \"\n          >−€<span data-count=\"4.8\">4.8</span> M</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\"\n          >lost to the shorter streaming window</p\n        >\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"font-size: 6.25rem; margin: 0 0 0.5rem; font-variant-numeric: tabular-nums; font-weight: 400\"\n          >+<span data-count=\"14.7\">14.7</span>%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\"\n          >revenue growth, the best since opening</p\n        >\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >The fight between the first two numbers is next year’s budget meeting.</p\n    >\n    <p class=\"presentation-note\">Name the fight, then let the room argue about it.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"In the auditorium\">\n    <header class=\"presentation-header\"><span>Why it worked</span><span>Attendance +11%</span></header>\n    <div style=\"display: flex; gap: 4.5rem; align-items: center; margin-top: 3.5rem\">\n      <div style=\"flex: 1 1 0; min-width: 0\">\n        <h2\n          class=\"presentation-title\"\n          data-df-entrance=\"up\"\n          style=\"font-size: 3.4rem; text-transform: uppercase; letter-spacing: 0.03em; font-weight: 400\"\n          >People came back for the big screen</h2\n        >\n        <p class=\"presentation-lede\" data-df-entrance=\"fade\" style=\"--df-motion-delay: 300ms; font-size: 1.7rem\"\n          >Premium seats and event nights turned a film into an evening out - the ticket line is attendance, not\n          price.</p\n        >\n      </div>\n      <figure\n        class=\"image\"\n        data-ratio=\"4/3\"\n        data-df-entrance=\"iris\"\n        style=\"--df-motion-delay: 150ms; flex: 0 0 700px; margin: 0\"\n      >\n        <img\n          src=\"https://picsum.photos/id/117/960/720\"\n          alt=\"Silhouettes of an audience in a dark hall facing a bright stage light\"\n          loading=\"lazy\"\n          width=\"960\"\n          height=\"720\"\n          style=\"width: 100%; height: 100%; object-fit: cover\"\n        />\n        <figcaption class=\"image-caption\" style=\"font-size: 1.25rem\"\n          >Event night, main auditorium (stock photo).</figcaption\n        >\n      </figure>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">One image, one reason: the room was full again.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"north\"\n    data-anim-in-blocks=\"6\"\n    aria-label=\"The bridge as a table\"\n  >\n    <header class=\"presentation-header\"><span>The bridge</span><span>Step by step</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" style=\"font-size: 1.45rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Aurora Cinemas revenue bridge, € millions (fictional).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Step</th><th class=\"table-head\" style=\"text-align: right\">Change</th\n            ><th class=\"table-head\" style=\"text-align: right\">Running total</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">2024 revenue</td><td class=\"table-cell\" style=\"text-align: right\">—</td\n            ><td class=\"table-cell\" style=\"text-align: right\">48.2</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Tickets</td><td class=\"table-cell\" style=\"text-align: right\">+6.4</td\n            ><td class=\"table-cell\" style=\"text-align: right\">54.6</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Streaming window</td><td class=\"table-cell\" style=\"text-align: right\">−4.8</td\n            ><td class=\"table-cell\" style=\"text-align: right\">49.8</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Concessions</td><td class=\"table-cell\" style=\"text-align: right\">+3.1</td\n            ><td class=\"table-cell\" style=\"text-align: right\">52.9</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Energy costs</td><td class=\"table-cell\" style=\"text-align: right\">−1.9</td\n            ><td class=\"table-cell\" style=\"text-align: right\">51.0</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Premium seats</td><td class=\"table-cell\" style=\"text-align: right\">+2.7</td\n            ><td class=\"table-cell\" style=\"text-align: right\">53.7</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Private events</td><td class=\"table-cell\" style=\"text-align: right\">+1.6</td\n            ><td class=\"table-cell\" style=\"text-align: right\">55.3</td></tr\n          >\n        </tbody>\n        <tfoot>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">2025 revenue</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">+7.1 net</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">55.3</td></tr\n          >\n        </tfoot>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The chart walks the journey; the table reconciles it to the cent.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p class=\"presentation-title\" style=\"font-size: 3.3rem; line-height: 1.22; font-weight: 400\"\n        >“We stopped arguing about the total the day we saw the streaming bar hanging below the line.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span class=\"avatar\" data-size=\"xl\" style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem\"\n        ><span class=\"avatar-fallback\">MO</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Mara Okafor<br /><span style=\"opacity: 0.7; font-size: 1.4rem\">CFO, Aurora Cinemas - 9 budget cycles</span></p\n      >\n    </div>\n    <p class=\"presentation-note\">Pause two beats after the quote.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"mix\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Revenue mix\"\n  >\n    <header class=\"presentation-header\"><span>Where it came from</span><span>2025 · €55.3 M</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        text-transform: uppercase;\n        letter-spacing: 0.03em;\n        font-weight: 400;\n      \"\n      >Tickets are half the house - concessions a quarter</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The same names, reframed as shares of the final total.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Questions from the board\"\n  >\n    <header class=\"presentation-header\"><span>Q & A</span><span>Asked in the meeting</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.2rem;\n        margin-block: 5.25rem 1.5rem;\n        text-transform: uppercase;\n        letter-spacing: 0.03em;\n        font-weight: 400;\n      \"\n      >Questions from the board</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"wf-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Is the ticket gain price or volume?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Volume: attendance rose 11% while the average ticket price moved less than 2%.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"wf-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Can we win back the streaming window?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Partly - two distributors offered a 45-day window for premium titles in exchange for guaranteed screens.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"wf-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Why keep a loss-making energy line?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >It is not a line we can drop: the 2026 heat-pump retrofit halves it from year two.</p\n          ></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Open one answer at a time - the accordion keeps only one open.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Takeaways</span><span>For 2026</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">◆</span\n        ><span>Protect the ticket engine - it produced 90% of the net gain.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">◆</span\n        ><span>Negotiate the streaming window before it costs another €5 M.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">◆</span\n        ><span>Premium seats paid back in one year; roll them out to two more sites.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">◆</span\n        ><span>Hedge energy: the smallest loss is also the most predictable one.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Thirty seconds - do not walk the list.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"south\"\n    data-anim-in-blocks=\"8\"\n    aria-label=\"Closing\"\n  >\n    <p aria-hidden=\"true\" style=\"letter-spacing: 1.5rem; color: #e2b857; font-size: 1.75rem; margin: 0 0 2rem\">◆ ◆ ◆</p>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        text-transform: uppercase;\n        letter-spacing: 0.03em;\n        font-weight: 400;\n      \"\n      >Every total is a story of parts</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px\"\n      >€48.2 M to €55.3 M in six moves - fictional cinema, real pattern.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">Close on the pattern, not the numbers.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 12</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"12\" value=\"1\"></progress>\n</section>\n","individual":false}]
