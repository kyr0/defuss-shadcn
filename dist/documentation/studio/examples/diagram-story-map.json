[{"label":"Grocery app","html":"<figure class=\"diagram\" id=\"dg-story\" data-type=\"story-map\" aria-label=\"Story map for a grocery app\">\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">User story map</span>\n    <span class=\"diagram-title\">Grocery app: the whole story, and the first cut</span>\n    <span class=\"diagram-dek\"\n      >Narrative left to right, priority top to bottom. Everything above the cut is the MVP.</span\n    >\n  </figcaption>\n  <div class=\"diagram-canvas\" style=\"--cols: 4\">\n    <div class=\"diagram-group\" data-shape=\"lane\" style=\"--col: 1; --row: 3; --span: 5; --rspan: 2\"\n      ><span class=\"diagram-group-label\">MVP</span></div\n    >\n    <div class=\"diagram-group\" data-shape=\"lane\" style=\"--col: 1; --row: 5; --span: 5\"\n      ><span class=\"diagram-group-label\">Release 2</span></div\n    >\n    <div class=\"diagram-group\" data-shape=\"lane\" style=\"--col: 1; --row: 6; --span: 5\"\n      ><span class=\"diagram-group-label\">Later</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"find-food\" data-shape=\"activity\" style=\"--col: 2; --row: 1\">\n      <span class=\"diagram-node-eyebrow\">Activity 1</span>\n      <span class=\"diagram-node-name\">Find food</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"build-a-basket\" data-shape=\"activity\" style=\"--col: 3; --row: 1\">\n      <span class=\"diagram-node-eyebrow\">Activity 2</span>\n      <span class=\"diagram-node-name\">Build a basket</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"pay\" data-shape=\"activity\" style=\"--col: 4; --row: 1\">\n      <span class=\"diagram-node-eyebrow\">Activity 3</span>\n      <span class=\"diagram-node-name\">Pay</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"get-it-delivered\" data-shape=\"activity\" style=\"--col: 5; --row: 1\">\n      <span class=\"diagram-node-eyebrow\">Activity 4</span>\n      <span class=\"diagram-node-name\">Get it delivered</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"search\" style=\"--col: 2; --row: 2\"\n      ><span class=\"diagram-node-name\">Search</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"add-to-basket\" style=\"--col: 3; --row: 2\"\n      ><span class=\"diagram-node-name\">Add to basket</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"checkout\" style=\"--col: 4; --row: 2\"\n      ><span class=\"diagram-node-name\">Checkout</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"track\" style=\"--col: 5; --row: 2\"\n      ><span class=\"diagram-node-name\">Track</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"search-by-name\" style=\"--col: 2; --row: 3\"\n      ><span class=\"diagram-node-name\">Search by name</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"browse-aisles\" style=\"--col: 2; --row: 4\"\n      ><span class=\"diagram-node-name\">Browse aisles</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"quantity-stepper\" style=\"--col: 3; --row: 3\"\n      ><span class=\"diagram-node-name\">Quantity stepper</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"card-payment\" style=\"--col: 4; --row: 3\"\n      ><span class=\"diagram-node-name\">Card payment</span></div\n    >\n    <div\n      class=\"diagram-node\"\n      data-node=\"delivery-slot-picker\"\n      data-tone=\"accent\"\n      data-badge=\"risk\"\n      style=\"--col: 5; --row: 3\"\n    >\n      <span class=\"diagram-node-name\">Delivery slot picker</span>\n      <span class=\"diagram-node-meta\">courier API unknown</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"order-status\" style=\"--col: 5; --row: 4\"\n      ><span class=\"diagram-node-name\">Order status</span></div\n    >\n    <div class=\"diagram-rule\" style=\"--row: 4\"><span>Release cut</span></div>\n    <div class=\"diagram-node\" data-node=\"filters\" style=\"--col: 2; --row: 5\"\n      ><span class=\"diagram-node-name\">Filters</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"saved-baskets\" style=\"--col: 3; --row: 5\"\n      ><span class=\"diagram-node-name\">Saved baskets</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"apple-pay\" style=\"--col: 4; --row: 5\"\n      ><span class=\"diagram-node-name\">Apple Pay</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"live-courier-map\" style=\"--col: 5; --row: 5\"\n      ><span class=\"diagram-node-name\">Live courier map</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"recipes\" style=\"--col: 2; --row: 6\"\n      ><span class=\"diagram-node-name\">Recipes</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"split-payment\" style=\"--col: 4; --row: 6\"\n      ><span class=\"diagram-node-name\">Split payment</span></div\n    >\n  </div>\n  <ul class=\"diagram-legend\">\n    <li data-swatch=\"muted\">Activity</li>\n    <li data-swatch=\"accent\">Riskiest story</li>\n    <li data-swatch=\"accent-line\">Release cut</li>\n  </ul>\n</figure>\n","individual":true},{"label":"Backbone, skeleton, slices","html":"<figure\n  class=\"diagram\"\n  id=\"dg-story-steps\"\n  data-type=\"story-map\"\n  data-steps\n  data-autoplay\n  aria-label=\"Story map for a grocery app\"\n>\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">User story map</span>\n    <span class=\"diagram-title\">Grocery app: the whole story, and the first cut</span>\n    <span class=\"diagram-dek\"\n      >Narrative left to right, priority top to bottom. Everything above the cut is the MVP.</span\n    >\n  </figcaption>\n  <div class=\"diagram-canvas\" style=\"--cols: 4\">\n    <div class=\"diagram-group\" data-shape=\"lane\" data-step=\"3\" style=\"--col: 1; --row: 3; --span: 5; --rspan: 2\"\n      ><span class=\"diagram-group-label\">MVP</span></div\n    >\n    <div class=\"diagram-group\" data-shape=\"lane\" data-step=\"5\" style=\"--col: 1; --row: 5; --span: 5\"\n      ><span class=\"diagram-group-label\">Release 2</span></div\n    >\n    <div class=\"diagram-group\" data-shape=\"lane\" data-step=\"6\" style=\"--col: 1; --row: 6; --span: 5\"\n      ><span class=\"diagram-group-label\">Later</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"find-food\" data-shape=\"activity\" data-step=\"1\" style=\"--col: 2; --row: 1\">\n      <span class=\"diagram-node-eyebrow\">Activity 1</span>\n      <span class=\"diagram-node-name\">Find food</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"build-a-basket\" data-shape=\"activity\" data-step=\"1\" style=\"--col: 3; --row: 1\">\n      <span class=\"diagram-node-eyebrow\">Activity 2</span>\n      <span class=\"diagram-node-name\">Build a basket</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"pay\" data-shape=\"activity\" data-step=\"1\" style=\"--col: 4; --row: 1\">\n      <span class=\"diagram-node-eyebrow\">Activity 3</span>\n      <span class=\"diagram-node-name\">Pay</span>\n    </div>\n    <div\n      class=\"diagram-node\"\n      data-node=\"get-it-delivered\"\n      data-shape=\"activity\"\n      data-step=\"1\"\n      style=\"--col: 5; --row: 1\"\n    >\n      <span class=\"diagram-node-eyebrow\">Activity 4</span>\n      <span class=\"diagram-node-name\">Get it delivered</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"search\" data-step=\"2\" style=\"--col: 2; --row: 2\"\n      ><span class=\"diagram-node-name\">Search</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"add-to-basket\" data-step=\"2\" style=\"--col: 3; --row: 2\"\n      ><span class=\"diagram-node-name\">Add to basket</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"checkout\" data-step=\"2\" style=\"--col: 4; --row: 2\"\n      ><span class=\"diagram-node-name\">Checkout</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"track\" data-step=\"2\" style=\"--col: 5; --row: 2\"\n      ><span class=\"diagram-node-name\">Track</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"search-by-name\" data-step=\"3\" style=\"--col: 2; --row: 3\"\n      ><span class=\"diagram-node-name\">Search by name</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"browse-aisles\" data-step=\"3\" style=\"--col: 2; --row: 4\"\n      ><span class=\"diagram-node-name\">Browse aisles</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"quantity-stepper\" data-step=\"3\" style=\"--col: 3; --row: 3\"\n      ><span class=\"diagram-node-name\">Quantity stepper</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"card-payment\" data-step=\"3\" style=\"--col: 4; --row: 3\"\n      ><span class=\"diagram-node-name\">Card payment</span></div\n    >\n    <div\n      class=\"diagram-node\"\n      data-node=\"delivery-slot-picker\"\n      data-tone=\"accent\"\n      data-badge=\"risk\"\n      data-step=\"3\"\n      style=\"--col: 5; --row: 3\"\n    >\n      <span class=\"diagram-node-name\">Delivery slot picker</span>\n      <span class=\"diagram-node-meta\">courier API unknown</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"order-status\" data-step=\"3\" style=\"--col: 5; --row: 4\"\n      ><span class=\"diagram-node-name\">Order status</span></div\n    >\n    <div class=\"diagram-rule\" style=\"--row: 4\" data-step=\"4\" data-step-label=\"The release cut\"\n      ><span>Release cut</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"filters\" data-step=\"5\" style=\"--col: 2; --row: 5\"\n      ><span class=\"diagram-node-name\">Filters</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"saved-baskets\" data-step=\"5\" style=\"--col: 3; --row: 5\"\n      ><span class=\"diagram-node-name\">Saved baskets</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"apple-pay\" data-step=\"5\" style=\"--col: 4; --row: 5\"\n      ><span class=\"diagram-node-name\">Apple Pay</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"live-courier-map\" data-step=\"5\" style=\"--col: 5; --row: 5\"\n      ><span class=\"diagram-node-name\">Live courier map</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"recipes\" data-step=\"6\" style=\"--col: 2; --row: 6\"\n      ><span class=\"diagram-node-name\">Recipes</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"split-payment\" data-step=\"6\" style=\"--col: 4; --row: 6\"\n      ><span class=\"diagram-node-name\">Split payment</span></div\n    >\n  </div>\n  <ul class=\"diagram-legend\">\n    <li data-swatch=\"muted\">Activity</li>\n    <li data-swatch=\"accent\">Riskiest story</li>\n    <li data-swatch=\"accent-line\">Release cut</li>\n  </ul>\n</figure>\n","individual":true},{"label":"The cut moves","html":"<figure\n  class=\"diagram\"\n  id=\"dg-story-delta\"\n  data-type=\"story-map\"\n  data-delta\n  aria-label=\"Story map after the MVP review\"\n>\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">MVP review</span>\n    <span class=\"diagram-title\">The cut moves</span>\n  </figcaption>\n  <div class=\"diagram-canvas\" style=\"--cols: 3\">\n    <div class=\"diagram-group\" data-shape=\"lane\" style=\"--col: 1; --row: 2; --span: 4\"\n      ><span class=\"diagram-group-label\">MVP</span></div\n    >\n    <div class=\"diagram-group\" data-shape=\"lane\" style=\"--col: 1; --row: 3; --span: 4\"\n      ><span class=\"diagram-group-label\">Release 2</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"find-food\" data-shape=\"activity\" style=\"--col: 2; --row: 1\"\n      ><span class=\"diagram-node-name\">Find food</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"pay\" data-shape=\"activity\" style=\"--col: 3; --row: 1\"\n      ><span class=\"diagram-node-name\">Pay</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"get-it-delivered\" data-shape=\"activity\" style=\"--col: 4; --row: 1\"\n      ><span class=\"diagram-node-name\">Get it delivered</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"search\" style=\"--col: 2; --row: 2\"\n      ><span class=\"diagram-node-name\">Search by name</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"card\" style=\"--col: 3; --row: 2\"\n      ><span class=\"diagram-node-name\">Card payment</span></div\n    >\n    <div\n      class=\"diagram-node\"\n      data-node=\"slot\"\n      data-tone=\"accent\"\n      data-change=\"changed\"\n      data-change-note=\"de-risked: no courier API needed\"\n      style=\"--col: 4; --row: 2\"\n    >\n      <span class=\"diagram-node-name\" data-before=\"Delivery slot picker\">Fixed 2h windows</span>\n    </div>\n    <div\n      class=\"diagram-node\"\n      data-node=\"apple\"\n      data-change=\"added\"\n      data-change-note=\"pulled into the MVP\"\n      style=\"--col: 3; --row: 2; margin-top: 3.25rem\"\n      ><span class=\"diagram-node-name\">Apple Pay</span></div\n    >\n    <div\n      class=\"diagram-node\"\n      data-node=\"browse\"\n      data-change=\"moved\"\n      data-change-note=\"MVP → Release 2\"\n      data-before-style=\"--col:2;--row:2;margin-top:3.25rem\"\n      style=\"--col: 2; --row: 3\"\n      ><span class=\"diagram-node-name\">Browse aisles</span></div\n    >\n    <div class=\"diagram-rule\" style=\"--row: 2\"><span>Release cut</span></div>\n  </div>\n</figure>\n","individual":true},{"label":"Story Map, interactive","html":"<div class=\"flex flex-wrap items-center gap-2 mb-3\">\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-diagram-for=\"dg-story-live\" data-diagram-action=\"prev\"\n    >Previous</button\n  >\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-diagram-for=\"dg-story-live\" data-diagram-action=\"next\"\n    >Next</button\n  >\n  <button class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" data-diagram-for=\"dg-story-live\" data-diagram-action=\"clear\"\n    >Clear</button\n  >\n  <output class=\"text-sm text-muted-foreground\" data-diagram-for=\"dg-story-live\"\n    >Click a box or an arrow - or press Next.</output\n  >\n</div>\n<figure\n  class=\"diagram\"\n  id=\"dg-story-live\"\n  data-interactive\n  data-type=\"story-map\"\n  aria-label=\"Story map for a grocery app\"\n>\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">User story map</span>\n    <span class=\"diagram-title\">Grocery app: the whole story, and the first cut</span>\n    <span class=\"diagram-dek\"\n      >Narrative left to right, priority top to bottom. Everything above the cut is the MVP.</span\n    >\n  </figcaption>\n  <div class=\"diagram-canvas\" style=\"--cols: 4\">\n    <div class=\"diagram-group\" data-shape=\"lane\" style=\"--col: 1; --row: 3; --span: 5; --rspan: 2\"\n      ><span class=\"diagram-group-label\">MVP</span></div\n    >\n    <div class=\"diagram-group\" data-shape=\"lane\" style=\"--col: 1; --row: 5; --span: 5\"\n      ><span class=\"diagram-group-label\">Release 2</span></div\n    >\n    <div class=\"diagram-group\" data-shape=\"lane\" style=\"--col: 1; --row: 6; --span: 5\"\n      ><span class=\"diagram-group-label\">Later</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"find-food\" data-shape=\"activity\" style=\"--col: 2; --row: 1\">\n      <span class=\"diagram-node-eyebrow\">Activity 1</span>\n      <span class=\"diagram-node-name\">Find food</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"build-a-basket\" data-shape=\"activity\" style=\"--col: 3; --row: 1\">\n      <span class=\"diagram-node-eyebrow\">Activity 2</span>\n      <span class=\"diagram-node-name\">Build a basket</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"pay\" data-shape=\"activity\" style=\"--col: 4; --row: 1\">\n      <span class=\"diagram-node-eyebrow\">Activity 3</span>\n      <span class=\"diagram-node-name\">Pay</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"get-it-delivered\" data-shape=\"activity\" style=\"--col: 5; --row: 1\">\n      <span class=\"diagram-node-eyebrow\">Activity 4</span>\n      <span class=\"diagram-node-name\">Get it delivered</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"search\" style=\"--col: 2; --row: 2\"\n      ><span class=\"diagram-node-name\">Search</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"add-to-basket\" style=\"--col: 3; --row: 2\"\n      ><span class=\"diagram-node-name\">Add to basket</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"checkout\" style=\"--col: 4; --row: 2\"\n      ><span class=\"diagram-node-name\">Checkout</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"track\" style=\"--col: 5; --row: 2\"\n      ><span class=\"diagram-node-name\">Track</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"search-by-name\" style=\"--col: 2; --row: 3\"\n      ><span class=\"diagram-node-name\">Search by name</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"browse-aisles\" style=\"--col: 2; --row: 4\"\n      ><span class=\"diagram-node-name\">Browse aisles</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"quantity-stepper\" style=\"--col: 3; --row: 3\"\n      ><span class=\"diagram-node-name\">Quantity stepper</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"card-payment\" style=\"--col: 4; --row: 3\"\n      ><span class=\"diagram-node-name\">Card payment</span></div\n    >\n    <div\n      class=\"diagram-node\"\n      data-node=\"delivery-slot-picker\"\n      data-tone=\"accent\"\n      data-badge=\"risk\"\n      style=\"--col: 5; --row: 3\"\n    >\n      <span class=\"diagram-node-name\">Delivery slot picker</span>\n      <span class=\"diagram-node-meta\">courier API unknown</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"order-status\" style=\"--col: 5; --row: 4\"\n      ><span class=\"diagram-node-name\">Order status</span></div\n    >\n    <div class=\"diagram-rule\" style=\"--row: 4\"><span>Release cut</span></div>\n    <div class=\"diagram-node\" data-node=\"filters\" style=\"--col: 2; --row: 5\"\n      ><span class=\"diagram-node-name\">Filters</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"saved-baskets\" style=\"--col: 3; --row: 5\"\n      ><span class=\"diagram-node-name\">Saved baskets</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"apple-pay\" style=\"--col: 4; --row: 5\"\n      ><span class=\"diagram-node-name\">Apple Pay</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"live-courier-map\" style=\"--col: 5; --row: 5\"\n      ><span class=\"diagram-node-name\">Live courier map</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"recipes\" style=\"--col: 2; --row: 6\"\n      ><span class=\"diagram-node-name\">Recipes</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"split-payment\" style=\"--col: 4; --row: 6\"\n      ><span class=\"diagram-node-name\">Split payment</span></div\n    >\n  </div>\n  <ul class=\"diagram-legend\">\n    <li data-swatch=\"muted\">Activity</li>\n    <li data-swatch=\"accent\">Riskiest story</li>\n    <li data-swatch=\"accent-line\">Release cut</li>\n  </ul>\n</figure>\n","individual":false},{"label":"Story Map, inspect and edit","html":"<div class=\"flex items-center gap-2 mb-3\">\n  <button type=\"button\" class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-panel-toggle=\"dg-story-edit-panel\"\n    ><i data-lucide=\"panel-right\"></i> Inspector</button\n  >\n  <span class=\"text-sm text-muted-foreground\">Click a box or an arrow, then edit it.</span>\n</div>\n<div class=\"flex flex-col gap-3\">\n  <div style=\"flex: 1 1 0; min-width: 0\">\n    <figure\n      class=\"diagram\"\n      id=\"dg-story-edit\"\n      data-interactive\n      data-type=\"story-map\"\n      aria-label=\"Story map for a grocery app\"\n    >\n      <figcaption class=\"diagram-caption\">\n        <span class=\"diagram-eyebrow\">User story map</span>\n        <span class=\"diagram-title\">Grocery app: the whole story, and the first cut</span>\n        <span class=\"diagram-dek\"\n          >Narrative left to right, priority top to bottom. Everything above the cut is the MVP.</span\n        >\n      </figcaption>\n      <div class=\"diagram-canvas\" style=\"--cols: 4\">\n        <div class=\"diagram-group\" data-shape=\"lane\" style=\"--col: 1; --row: 3; --span: 5; --rspan: 2\"\n          ><span class=\"diagram-group-label\">MVP</span></div\n        >\n        <div class=\"diagram-group\" data-shape=\"lane\" style=\"--col: 1; --row: 5; --span: 5\"\n          ><span class=\"diagram-group-label\">Release 2</span></div\n        >\n        <div class=\"diagram-group\" data-shape=\"lane\" style=\"--col: 1; --row: 6; --span: 5\"\n          ><span class=\"diagram-group-label\">Later</span></div\n        >\n        <div class=\"diagram-node\" data-node=\"find-food\" data-shape=\"activity\" style=\"--col: 2; --row: 1\">\n          <span class=\"diagram-node-eyebrow\">Activity 1</span>\n          <span class=\"diagram-node-name\">Find food</span>\n        </div>\n        <div class=\"diagram-node\" data-node=\"build-a-basket\" data-shape=\"activity\" style=\"--col: 3; --row: 1\">\n          <span class=\"diagram-node-eyebrow\">Activity 2</span>\n          <span class=\"diagram-node-name\">Build a basket</span>\n        </div>\n        <div class=\"diagram-node\" data-node=\"pay\" data-shape=\"activity\" style=\"--col: 4; --row: 1\">\n          <span class=\"diagram-node-eyebrow\">Activity 3</span>\n          <span class=\"diagram-node-name\">Pay</span>\n        </div>\n        <div class=\"diagram-node\" data-node=\"get-it-delivered\" data-shape=\"activity\" style=\"--col: 5; --row: 1\">\n          <span class=\"diagram-node-eyebrow\">Activity 4</span>\n          <span class=\"diagram-node-name\">Get it delivered</span>\n        </div>\n        <div class=\"diagram-node\" data-node=\"search\" style=\"--col: 2; --row: 2\"\n          ><span class=\"diagram-node-name\">Search</span></div\n        >\n        <div class=\"diagram-node\" data-node=\"add-to-basket\" style=\"--col: 3; --row: 2\"\n          ><span class=\"diagram-node-name\">Add to basket</span></div\n        >\n        <div class=\"diagram-node\" data-node=\"checkout\" style=\"--col: 4; --row: 2\"\n          ><span class=\"diagram-node-name\">Checkout</span></div\n        >\n        <div class=\"diagram-node\" data-node=\"track\" style=\"--col: 5; --row: 2\"\n          ><span class=\"diagram-node-name\">Track</span></div\n        >\n        <div class=\"diagram-node\" data-node=\"search-by-name\" style=\"--col: 2; --row: 3\"\n          ><span class=\"diagram-node-name\">Search by name</span></div\n        >\n        <div class=\"diagram-node\" data-node=\"browse-aisles\" style=\"--col: 2; --row: 4\"\n          ><span class=\"diagram-node-name\">Browse aisles</span></div\n        >\n        <div class=\"diagram-node\" data-node=\"quantity-stepper\" style=\"--col: 3; --row: 3\"\n          ><span class=\"diagram-node-name\">Quantity stepper</span></div\n        >\n        <div class=\"diagram-node\" data-node=\"card-payment\" style=\"--col: 4; --row: 3\"\n          ><span class=\"diagram-node-name\">Card payment</span></div\n        >\n        <div\n          class=\"diagram-node\"\n          data-node=\"delivery-slot-picker\"\n          data-tone=\"accent\"\n          data-badge=\"risk\"\n          style=\"--col: 5; --row: 3\"\n        >\n          <span class=\"diagram-node-name\">Delivery slot picker</span>\n          <span class=\"diagram-node-meta\">courier API unknown</span>\n        </div>\n        <div class=\"diagram-node\" data-node=\"order-status\" style=\"--col: 5; --row: 4\"\n          ><span class=\"diagram-node-name\">Order status</span></div\n        >\n        <div class=\"diagram-rule\" style=\"--row: 4\"><span>Release cut</span></div>\n        <div class=\"diagram-node\" data-node=\"filters\" style=\"--col: 2; --row: 5\"\n          ><span class=\"diagram-node-name\">Filters</span></div\n        >\n        <div class=\"diagram-node\" data-node=\"saved-baskets\" style=\"--col: 3; --row: 5\"\n          ><span class=\"diagram-node-name\">Saved baskets</span></div\n        >\n        <div class=\"diagram-node\" data-node=\"apple-pay\" style=\"--col: 4; --row: 5\"\n          ><span class=\"diagram-node-name\">Apple Pay</span></div\n        >\n        <div class=\"diagram-node\" data-node=\"live-courier-map\" style=\"--col: 5; --row: 5\"\n          ><span class=\"diagram-node-name\">Live courier map</span></div\n        >\n        <div class=\"diagram-node\" data-node=\"recipes\" style=\"--col: 2; --row: 6\"\n          ><span class=\"diagram-node-name\">Recipes</span></div\n        >\n        <div class=\"diagram-node\" data-node=\"split-payment\" style=\"--col: 4; --row: 6\"\n          ><span class=\"diagram-node-name\">Split payment</span></div\n        >\n      </div>\n      <ul class=\"diagram-legend\">\n        <li data-swatch=\"muted\">Activity</li>\n        <li data-swatch=\"accent\">Riskiest story</li>\n        <li data-swatch=\"accent-line\">Release cut</li>\n      </ul>\n    </figure>\n  </div>\n  <section class=\"card panel\" id=\"dg-story-edit-panel\" aria-labelledby=\"dg-story-edit-title\" style=\"\">\n    <header class=\"panel-header\">\n      <i data-lucide=\"sliders-horizontal\" class=\"panel-icon\" aria-hidden=\"true\"></i>\n      <h3 class=\"panel-title\" id=\"dg-story-edit-title\">Inspector</h3>\n      <div class=\"panel-tools\">\n        <button\n          type=\"button\"\n          class=\"btn panel-close\"\n          data-variant=\"ghost\"\n          data-size=\"icon-sm\"\n          aria-label=\"Close Inspector\"\n          ><i data-lucide=\"x\"></i\n        ></button>\n      </div>\n    </header>\n    <div class=\"panel-body\" data-flush>\n      <div\n        class=\"property-grid\"\n        id=\"dg-story-edit-grid\"\n        data-frame=\"none\"\n        data-empty-text=\"Click a box or an arrow.\"\n        aria-label=\"Selection properties\"\n      ></div>\n    </div>\n  </section>\n</div>\n","individual":false}]
