[{"label":"Glass Hologram","html":"<section\n  class=\"presentation\"\n  id=\"deck-chord\"\n  data-anim-in=\"zoomIn\"\n  data-anim-in-scale=\"1.1\"\n  data-anim-out=\"fadeOut\"\n  style=\"\n    --presentation-ink: #0c1024;\n    --presentation-ink-foreground: #f5f7ff;\n    --presentation-paper: #edf0ff;\n    --presentation-paper-foreground: #12172e;\n    --presentation-accent: #7cffee;\n    font-family: Inter, system-ui, sans-serif;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"Who flies where - passenger flows between world regions\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Annual air passengers between six world regions as a chord diagram, 368 million in total, Europe–North America the largest flow at 62 million; then totals and growth by region\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Cover\">\n    <div\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        right: 120px;\n        top: 150px;\n        width: 560px;\n        height: 560px;\n        border-radius: 50%;\n        border: 2px solid rgba(124, 255, 238, 0.5);\n        background: conic-gradient(\n          from 40deg,\n          rgba(124, 255, 238, 0.35),\n          rgba(167, 139, 250, 0.35),\n          rgba(244, 114, 182, 0.3),\n          rgba(124, 255, 238, 0.35)\n        );\n        filter: blur(1px);\n        mask: radial-gradient(circle, transparent 58%, #000 60%, #000 72%, transparent 74%);\n      \"\n    ></div>\n    <div\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        right: 250px;\n        top: 280px;\n        width: 300px;\n        height: 300px;\n        border-radius: 50%;\n        background: radial-gradient(circle, rgba(124, 255, 238, 0.25), transparent 70%);\n      \"\n    ></div>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\">Chord · Glass Hologram</p>\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        position: relative;\n        max-width: 1250px;\n        font-family: Inter, system-ui, sans-serif;\n        font-weight: 650;\n        letter-spacing: -0.03em;\n        font-size: 6.75rem;\n        max-width: 760px;\n      \"\n      >Who flies where</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >368 million passengers a year between six regions - every flow runs both ways.</p\n    >\n    <p class=\"presentation-note\">The glass ring previews the chord.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"ring\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"All flows\"\n  >\n    <header class=\"presentation-header\"><span>Flows</span><span>Passengers per year, millions</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Inter, system-ui, sans-serif;\n        font-weight: 650;\n        letter-spacing: -0.03em;\n      \"\n      >Six regions, thirteen corridors</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Arc length = a region’s traffic; ribbon width = one corridor.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"europe\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Europe\"\n  >\n    <header class=\"presentation-header\"><span>Flows</span><span>Europe highlighted</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Inter, system-ui, sans-serif;\n        font-weight: 650;\n        letter-spacing: -0.03em;\n      \"\n      >Europe touches 54% of all passengers</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The ribbons that do not touch Europe dim.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"totals\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Totals\"\n  >\n    <header class=\"presentation-header\"\n      ><span>Volume</span><span>Passengers touching each region, millions</span></header\n    >\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Inter, system-ui, sans-serif;\n        font-weight: 650;\n        letter-spacing: -0.03em;\n      \"\n      >Europe and North America dominate volume</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The ring unrolls into bars.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Three numbers for the network plan</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: Inter, system-ui, sans-serif;\n            font-weight: 650;\n            letter-spacing: -0.03em;\n          \"\n          ><span data-count=\"368\">368</span> M</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">passengers between regions per year</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #7cffee;\n            font-family: Inter, system-ui, sans-serif;\n            font-weight: 650;\n            letter-spacing: -0.03em;\n          \"\n          ><span data-count=\"62\">62</span> M</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\"\n          >Europe ↔ North America - the busiest corridor</p\n        >\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: Inter, system-ui, sans-serif;\n            font-weight: 650;\n            letter-spacing: -0.03em;\n          \"\n          >+<span data-count=\"21\">21</span>%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\"\n          >Africa’s growth since 2019 - the fastest</p\n        >\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >The biggest corridors are mature. The fastest growth is on the thinnest ribbons.</p\n    >\n    <p class=\"presentation-note\">Maturity versus growth - the planning tension.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Sky\">\n    <header class=\"presentation-header\"><span>Capacity</span><span>Long-haul</span></header>\n    <div style=\"display: flex; gap: 4.5rem; align-items: center; margin-top: 3.5rem\">\n      <div style=\"flex: 1 1 0; min-width: 0\">\n        <h2\n          class=\"presentation-title\"\n          data-df-entrance=\"up\"\n          style=\"\n            font-size: 3.4rem;\n            font-family: Inter, system-ui, sans-serif;\n            font-weight: 650;\n            letter-spacing: -0.03em;\n          \"\n          >Every ribbon is a timetable</h2\n        >\n        <p class=\"presentation-lede\" data-df-entrance=\"fade\" style=\"--df-motion-delay: 300ms; font-size: 1.7rem\"\n          >The Europe–North America ribbon alone is about 480 long-haul departures a week, each way.</p\n        >\n      </div>\n      <figure\n        class=\"image\"\n        data-ratio=\"4/3\"\n        data-df-entrance=\"blur\"\n        style=\"--df-motion-delay: 150ms; flex: 0 0 700px; margin: 0\"\n      >\n        <img\n          src=\"https://picsum.photos/id/53/960/720\"\n          alt=\"A clear blue sky with a thin white streak of cloud\"\n          loading=\"lazy\"\n          width=\"960\"\n          height=\"720\"\n          style=\"width: 100%; height: 100%; object-fit: cover\"\n        />\n        <figcaption class=\"image-caption\" style=\"font-size: 1.25rem\">A trail across the sky (stock photo).</figcaption>\n      </figure>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Make the ribbon physical.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"north\"\n    data-anim-in-blocks=\"6\"\n    data-anim-in-color=\"#7CFFEE\"\n    aria-label=\"Corridor table\"\n  >\n    <header class=\"presentation-header\"><span>Corridors</span><span>Top six, millions per year</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" style=\"font-size: 1.7rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Largest inter-regional air corridors, both directions (synthetic).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Corridor</th><th class=\"table-head\" style=\"text-align: right\">Passengers</th\n            ><th class=\"table-head\" style=\"text-align: right\">Share</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\" style=\"font-weight: 700\"\n            ><td class=\"table-cell\">Europe ↔ North America</td><td class=\"table-cell\" style=\"text-align: right\">62 M</td\n            ><td class=\"table-cell\" style=\"text-align: right\">17%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">North America ↔ Latin America</td\n            ><td class=\"table-cell\" style=\"text-align: right\">51 M</td\n            ><td class=\"table-cell\" style=\"text-align: right\">14%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Europe ↔ Asia-Pacific</td><td class=\"table-cell\" style=\"text-align: right\">48 M</td\n            ><td class=\"table-cell\" style=\"text-align: right\">13%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">North America ↔ Asia-Pacific</td\n            ><td class=\"table-cell\" style=\"text-align: right\">44 M</td\n            ><td class=\"table-cell\" style=\"text-align: right\">12%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Europe ↔ Middle East</td><td class=\"table-cell\" style=\"text-align: right\">41 M</td\n            ><td class=\"table-cell\" style=\"text-align: right\">11%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Asia-Pacific ↔ Middle East</td\n            ><td class=\"table-cell\" style=\"text-align: right\">36 M</td\n            ><td class=\"table-cell\" style=\"text-align: right\">10%</td></tr\n          >\n        </tbody>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Six corridors carry 77% of the ring.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"\n          font-size: 3.3rem;\n          line-height: 1.22;\n          font-family: Inter, system-ui, sans-serif;\n          font-weight: 650;\n          letter-spacing: -0.03em;\n          font-size: 2.9rem;\n        \"\n        >“The ring showed our board in one picture why a hub in the Middle East changes everything between Europe and\n        Asia.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #12172e; color: #7cffee\"\n        ><span class=\"avatar-fallback\">AR</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Amal Rahimi<br /><span style=\"opacity: 0.7; font-size: 1.4rem\">Network planner - 31 routes launched</span></p\n      >\n    </div>\n    <p class=\"presentation-note\">The hub insight is the chord’s strength.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"growth\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Growth\"\n  >\n    <header class=\"presentation-header\"><span>Growth</span><span>Passengers vs 2019</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Inter, system-ui, sans-serif;\n        font-weight: 650;\n        letter-spacing: -0.03em;\n      \"\n      >The thin ribbons grow fastest</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The same regions, re-sorted by growth.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Questions from the network team\"\n  >\n    <header class=\"presentation-header\"><span>Q & A</span><span>Network planning</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.2rem;\n        margin-block: 5.25rem 1.5rem;\n        font-family: Inter, system-ui, sans-serif;\n        font-weight: 650;\n        letter-spacing: -0.03em;\n      \"\n      >Questions from the network team</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"ch-qa2\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Why is traffic inside a region missing?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >The ring shows only flows between regions; domestic and intra-regional travel would dwarf it.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"ch-qa2\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Are connecting passengers double counted?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\">No - each passenger is counted once, origin to destination region.</p></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"ch-qa2\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Where would a new route matter most?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Africa ↔ Asia-Pacific: 6 M today, growing twice as fast as the network.</p\n          ></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The counting question keeps the chart honest.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Takeaways</span><span>For the network plan</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">◇</span\n        ><span>Chords show mutual flows where a sankey would force a direction.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">◇</span\n        ><span>Europe sits on more than half of all inter-regional travel.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">◇</span\n        ><span>Hubs in the Middle East thicken Europe–Asia indirectly.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">◇</span\n        ><span>Grow the thin ribbons - they carry the growth.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Short and luminous.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"south\"\n    data-anim-in-blocks=\"6\"\n    data-anim-in-color=\"#A78BFA\"\n    aria-label=\"Closing\"\n  >\n    <div\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        right: 120px;\n        top: 150px;\n        width: 560px;\n        height: 560px;\n        border-radius: 50%;\n        border: 2px solid rgba(124, 255, 238, 0.5);\n        background: conic-gradient(\n          from 40deg,\n          rgba(124, 255, 238, 0.35),\n          rgba(167, 139, 250, 0.35),\n          rgba(244, 114, 182, 0.3),\n          rgba(124, 255, 238, 0.35)\n        );\n        filter: blur(1px);\n        mask: radial-gradient(circle, transparent 58%, #000 60%, #000 72%, transparent 74%);\n      \"\n    ></div>\n    <div\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        right: 250px;\n        top: 280px;\n        width: 300px;\n        height: 300px;\n        border-radius: 50%;\n        background: radial-gradient(circle, rgba(124, 255, 238, 0.25), transparent 70%);\n      \"\n    ></div>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        font-family: Inter, system-ui, sans-serif;\n        font-weight: 650;\n        letter-spacing: -0.03em;\n      \"\n      >Every flow runs both ways</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px\"\n      >Synthetic passenger flows - the chord is the real way to read a network.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">Let the ring close the talk.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 12</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"12\" value=\"1\"></progress>\n</section>\n","individual":false}]
