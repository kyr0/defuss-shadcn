[{"label":"Popover","html":"<div class=\"popover\" id=\"demo-pop-center\" popover=\"\">\n  <div class=\"popover-header\">\n    <p class=\"popover-title\">Center aligned</p>\n    <p class=\"popover-description\">Default center alignment.</p>\n  </div>\n</div>\n","individual":true},{"label":"Popover 2","html":"<button class=\"btn\" data-variant=\"outline\" popovertarget=\"demo-popover\">Open Popover</button>\n<div class=\"popover\" id=\"demo-popover\" popover>\n  <div class=\"popover-header\">\n    <p class=\"popover-title\">Dimensions</p>\n    <p class=\"popover-description\">Set the dimensions for the layer.</p>\n  </div>\n  <div class=\"popover-content\">\n    <p style=\"margin: 0; font-size: 0.8125rem; color: var(--muted-foreground)\">Width: 100% • Height: auto</p>\n  </div>\n</div>\n","individual":false},{"label":"Popover 3","html":"<button class=\"btn\" data-variant=\"outline\" popovertarget=\"demo-popover-form\">Open Popover</button>\n<div class=\"popover\" id=\"demo-popover-form\" popover style=\"width: 20rem\">\n  <div class=\"popover-header\">\n    <p class=\"popover-title\">Dimensions</p>\n    <p class=\"popover-description\">Set the dimensions for the layer.</p>\n  </div>\n  <div class=\"popover-content\">\n    <div style=\"display: grid; gap: 0.5rem\">\n      <div style=\"display: grid; grid-template-columns: 1fr 2fr; align-items: center; gap: 1rem\">\n        <label class=\"label\" for=\"pop-width\" style=\"text-align: right\">Width</label>\n        <input class=\"input\" id=\"pop-width\" type=\"text\" value=\"100%\" style=\"height: 2rem; font-size: 0.8125rem\" />\n      </div>\n      <div style=\"display: grid; grid-template-columns: 1fr 2fr; align-items: center; gap: 1rem\">\n        <label class=\"label\" for=\"pop-max-width\" style=\"text-align: right\">Max. width</label>\n        <input class=\"input\" id=\"pop-max-width\" type=\"text\" value=\"300px\" style=\"height: 2rem; font-size: 0.8125rem\" />\n      </div>\n      <div style=\"display: grid; grid-template-columns: 1fr 2fr; align-items: center; gap: 1rem\">\n        <label class=\"label\" for=\"pop-height\" style=\"text-align: right\">Height</label>\n        <input class=\"input\" id=\"pop-height\" type=\"text\" value=\"25px\" style=\"height: 2rem; font-size: 0.8125rem\" />\n      </div>\n      <div style=\"display: grid; grid-template-columns: 1fr 2fr; align-items: center; gap: 1rem\">\n        <label class=\"label\" for=\"pop-max-height\" style=\"text-align: right\">Max. height</label>\n        <input class=\"input\" id=\"pop-max-height\" type=\"text\" value=\"none\" style=\"height: 2rem; font-size: 0.8125rem\" />\n      </div>\n    </div>\n  </div>\n</div>\n","individual":false},{"label":"Popover 4","html":"<button class=\"btn\" data-variant=\"outline\" popovertarget=\"demo-pop-start\">Start</button>\n<div class=\"popover\" id=\"demo-pop-start\" popover data-align=\"start\">\n  <div class=\"popover-header\">\n    <p class=\"popover-title\">Start aligned</p>\n    <p class=\"popover-description\">Popover aligned to the start edge.</p>\n  </div>\n</div>\n<button class=\"btn\" data-variant=\"outline\" popovertarget=\"demo-pop-center\">Center</button>\n<div class=\"popover\" id=\"demo-pop-center\" popover>\n  <div class=\"popover-header\">\n    <p class=\"popover-title\">Center aligned</p>\n    <p class=\"popover-description\">Default center alignment.</p>\n  </div>\n</div>\n<button class=\"btn\" data-variant=\"outline\" popovertarget=\"demo-pop-end\">End</button>\n<div class=\"popover\" id=\"demo-pop-end\" popover data-align=\"end\">\n  <div class=\"popover-header\">\n    <p class=\"popover-title\">End aligned</p>\n    <p class=\"popover-description\">Popover aligned to the end edge.</p>\n  </div>\n</div>\n","individual":false},{"label":"Popover 5","html":"<button class=\"btn\" data-variant=\"outline\" popovertarget=\"demo-pop-top\">Top</button>\n<div class=\"popover\" id=\"demo-pop-top\" popover data-side=\"top\">\n  <div class=\"popover-header\">\n    <p class=\"popover-title\">Top side</p>\n    <p class=\"popover-description\">Positioned above the trigger.</p>\n  </div>\n</div>\n<button class=\"btn\" data-variant=\"outline\" popovertarget=\"demo-pop-right\">Right</button>\n<div class=\"popover\" id=\"demo-pop-right\" popover data-side=\"right\">\n  <div class=\"popover-header\">\n    <p class=\"popover-title\">Right side</p>\n    <p class=\"popover-description\">Positioned to the right.</p>\n  </div>\n</div>\n<button class=\"btn\" data-variant=\"outline\" popovertarget=\"demo-pop-bottom\">Bottom</button>\n<div class=\"popover\" id=\"demo-pop-bottom\" popover>\n  <div class=\"popover-header\">\n    <p class=\"popover-title\">Bottom side</p>\n    <p class=\"popover-description\">Default bottom positioning.</p>\n  </div>\n</div>\n<button class=\"btn\" data-variant=\"outline\" popovertarget=\"demo-pop-left\">Left</button>\n<div class=\"popover\" id=\"demo-pop-left\" popover data-side=\"left\">\n  <div class=\"popover-header\">\n    <p class=\"popover-title\">Left side</p>\n    <p class=\"popover-description\">Positioned to the left.</p>\n  </div>\n</div>\n","individual":false},{"label":"Density","html":"<div class=\"flex flex-wrap gap-2\">\n  <button class=\"btn\" data-variant=\"outline\" popovertarget=\"density-popover-compact\">Compact</button>\n  <div class=\"popover\" id=\"density-popover-compact\" popover data-density=\"compact\">\n    <div class=\"popover-header\"\n      ><p class=\"popover-title\">Compact density</p><p class=\"popover-description\">Content padding 0.75rem.</p></div\n    >\n  </div>\n  <button class=\"btn\" data-variant=\"outline\" popovertarget=\"density-popover-comfortable\">Comfortable</button>\n  <div class=\"popover\" id=\"density-popover-comfortable\" popover data-density=\"comfortable\">\n    <div class=\"popover-header\"\n      ><p class=\"popover-title\">Comfortable density</p\n      ><p class=\"popover-description\">Identical to the unsized default - 1rem.</p></div\n    >\n  </div>\n  <button class=\"btn\" data-variant=\"outline\" popovertarget=\"density-popover-spacious\">Spacious</button>\n  <div class=\"popover\" id=\"density-popover-spacious\" popover data-density=\"spacious\">\n    <div class=\"popover-header\"\n      ><p class=\"popover-title\">Spacious density</p><p class=\"popover-description\">Content padding 1.25rem.</p></div\n    >\n  </div>\n</div>\n","individual":false}]
