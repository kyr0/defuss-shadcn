[{"label":"Envelope","html":"<div class=\"envelope\" id=\"en-part-amp\" aria-label=\"Amp envelope\">\n  \n</div>\n","individual":true},{"label":"Envelope (sm)","html":"<div class=\"envelope\" id=\"en-part-pluck\" data-size=\"sm\" aria-label=\"Pluck envelope\">\n  \n</div>\n","individual":true},{"label":"Envelope (lg)","html":"<div class=\"envelope\" id=\"en-part-eq\" data-kind=\"filter\" data-size=\"lg\" data-range=\"18\" aria-label=\"Equalizer\">\n  \n</div>\n","individual":true},{"label":"Envelope","html":"<div class=\"grid gap-3\">\n  <div class=\"envelope\" id=\"en-amp\" aria-label=\"Amp envelope\" data-state-demo>\n    \n  </div>\n  <div class=\"flex flex-wrap items-center gap-4\" data-envelope-for=\"en-amp\">\n    <button class=\"btn\" type=\"button\" data-envelope-action=\"gate\">Hold to play</button>\n    <button class=\"btn\" type=\"button\" data-variant=\"outline\" data-envelope-action=\"trigger\" data-value=\"0.5\"\n      >Play 0.5 s</button\n    >\n    <div\n      class=\"knob\"\n      data-size=\"sm\"\n      data-envelope-param=\"attack\"\n      data-scale=\"power\"\n      data-exponent=\"3\"\n      data-format=\"time\"\n    >\n      <input class=\"knob-input\" type=\"range\" id=\"en-amp-attack\" min=\"0\" max=\"5\" step=\"any\" value=\"0.02\" />\n      <label class=\"knob-label\" for=\"en-amp-attack\">Attack</label>\n      <output class=\"knob-value\" for=\"en-amp-attack\">20 ms</output>\n    </div>\n    <div\n      class=\"knob\"\n      data-size=\"sm\"\n      data-envelope-param=\"decay\"\n      data-scale=\"power\"\n      data-exponent=\"3\"\n      data-format=\"time\"\n    >\n      <input class=\"knob-input\" type=\"range\" id=\"en-amp-decay\" min=\"0\" max=\"5\" step=\"any\" value=\"0.35\" />\n      <label class=\"knob-label\" for=\"en-amp-decay\">Decay</label>\n      <output class=\"knob-value\" for=\"en-amp-decay\">350 ms</output>\n    </div>\n    <div class=\"knob\" data-size=\"sm\" data-envelope-param=\"sustain\" data-format=\"percent\">\n      <input class=\"knob-input\" type=\"range\" id=\"en-amp-sustain\" min=\"0\" max=\"1\" step=\"any\" value=\"0.6\" />\n      <label class=\"knob-label\" for=\"en-amp-sustain\">Sustain</label>\n      <output class=\"knob-value\" for=\"en-amp-sustain\">60%</output>\n    </div>\n    <div\n      class=\"knob\"\n      data-size=\"sm\"\n      data-envelope-param=\"release\"\n      data-scale=\"power\"\n      data-exponent=\"3\"\n      data-format=\"time\"\n    >\n      <input class=\"knob-input\" type=\"range\" id=\"en-amp-release\" min=\"0\" max=\"10\" step=\"any\" value=\"0.6\" />\n      <label class=\"knob-label\" for=\"en-amp-release\">Release</label>\n      <output class=\"knob-value\" for=\"en-amp-release\">600 ms</output>\n    </div>\n    <p class=\"text-sm text-muted-foreground m-0\">\n      <output data-envelope-output=\"phase\"></output> <output data-envelope-output=\"value\"></output>\n    </p>\n  </div>\n</div>\n","individual":false},{"label":"Delay, hold and bends","html":"<div class=\"grid gap-3\">\n  <div class=\"envelope\" id=\"en-dahdsr\" data-length=\"3\" data-color=\"chart-2\" aria-label=\"Filter envelope\">\n    \n  </div>\n  <div class=\"flex items-center gap-3\" data-envelope-for=\"en-dahdsr\">\n    <button class=\"btn\" type=\"button\" data-size=\"sm\" data-envelope-action=\"trigger\" data-value=\"1\">Play 1 s</button>\n    <button class=\"btn\" type=\"button\" data-size=\"sm\" data-variant=\"outline\" data-envelope-action=\"reset\">Reset</button>\n    <span class=\"text-sm text-muted-foreground\"><output data-envelope-output=\"phase\"></output></span>\n  </div>\n</div>\n","individual":false},{"label":"A synth voice","html":"<div class=\"grid gap-4\" id=\"en-voice\">\n  <div class=\"grid grid-cols-auto gap-4\" style=\"--layout-min: 18rem\">\n    <div class=\"grid gap-1\">\n      <span class=\"text-sm font-medium\">Amp</span>\n      <div class=\"envelope\" id=\"en-voice-amp\" data-size=\"sm\" aria-label=\"Amp envelope\">\n        \n      </div>\n    </div>\n    <div class=\"grid gap-1\">\n      <span class=\"text-sm font-medium\">Filter envelope</span>\n      <div class=\"envelope\" id=\"en-voice-fenv\" data-size=\"sm\" data-color=\"chart-2\" aria-label=\"Filter envelope\">\n        \n      </div>\n    </div>\n  </div>\n  <div class=\"grid grid-cols-auto items-center gap-4\" style=\"--layout-min: 18rem\">\n    <div\n      class=\"envelope\"\n      id=\"en-voice-filter\"\n      data-kind=\"filter\"\n      data-size=\"sm\"\n      data-color=\"chart-3\"\n      aria-label=\"Filter\"\n    >\n      \n    </div>\n    <div class=\"flex flex-wrap items-start gap-4\" data-envelope-for=\"en-voice-filter\">\n      <div\n        class=\"knob\"\n        data-size=\"sm\"\n        data-envelope-param=\"cut.frequency\"\n        data-scale=\"exponential\"\n        data-format=\"si\"\n        data-unit=\"Hz\"\n      >\n        <input class=\"knob-input\" type=\"range\" id=\"en-voice-cutoff\" min=\"20\" max=\"20000\" step=\"any\" value=\"400\" />\n        <label class=\"knob-label\" for=\"en-voice-cutoff\">Cutoff</label>\n        <output class=\"knob-value\" for=\"en-voice-cutoff\">400 Hz</output>\n        \n      </div>\n      <div\n        class=\"knob\"\n        data-size=\"sm\"\n        data-envelope-param=\"cut.Q\"\n        data-format=\"signed\"\n        data-unit=\"dB\"\n        data-decimals=\"1\"\n      >\n        <input class=\"knob-input\" type=\"range\" id=\"en-voice-res\" min=\"-12\" max=\"24\" step=\"0.1\" value=\"8\" />\n        <label class=\"knob-label\" for=\"en-voice-res\">Resonance</label>\n        <output class=\"knob-value\" for=\"en-voice-res\">+8.0 dB</output>\n      </div>\n      <div class=\"knob\" data-size=\"sm\" data-format=\"percent\" id=\"en-voice-amount-knob\">\n        <input class=\"knob-input\" type=\"range\" id=\"en-voice-amount\" min=\"0\" max=\"1\" step=\"any\" value=\"0.6\" />\n        <label class=\"knob-label\" for=\"en-voice-amount\">Env amount</label>\n        <output class=\"knob-value\" for=\"en-voice-amount\">60%</output>\n      </div>\n    </div>\n  </div>\n  <div class=\"flex flex-wrap gap-1\" role=\"group\" aria-label=\"Keys\">\n    <button class=\"btn\" type=\"button\" data-variant=\"outline\" data-note=\"130.81\">C</button>\n    <button class=\"btn\" type=\"button\" data-variant=\"outline\" data-note=\"146.83\">D</button>\n    <button class=\"btn\" type=\"button\" data-variant=\"outline\" data-note=\"164.81\">E</button>\n    <button class=\"btn\" type=\"button\" data-variant=\"outline\" data-note=\"196\">G</button>\n    <button class=\"btn\" type=\"button\" data-variant=\"outline\" data-note=\"220\">A</button>\n    <button class=\"btn\" type=\"button\" data-variant=\"outline\" data-note=\"261.63\">C'</button>\n  </div>\n</div>\n","individual":false},{"label":"Compressor","html":"<div class=\"flex flex-wrap items-start gap-6\">\n  <div class=\"envelope\" id=\"en-comp\" data-kind=\"dynamics\" data-range=\"48\" aria-label=\"Compressor\">\n    \n  </div>\n  <div class=\"grid gap-3\" data-envelope-for=\"en-comp\">\n    <div class=\"flex flex-wrap items-start gap-4\">\n      <div\n        class=\"knob\"\n        data-size=\"sm\"\n        data-envelope-param=\"threshold\"\n        data-format=\"signed\"\n        data-unit=\"dB\"\n        data-decimals=\"1\"\n      >\n        <input class=\"knob-input\" type=\"range\" id=\"en-comp-threshold\" min=\"-48\" max=\"0\" step=\"0.5\" value=\"-24\" />\n        <label class=\"knob-label\" for=\"en-comp-threshold\">Threshold</label>\n        <output class=\"knob-value\" for=\"en-comp-threshold\">-24.0 dB</output>\n      </div>\n      <div class=\"knob\" data-size=\"sm\" data-envelope-param=\"ratio\" data-scale=\"exponential\" data-decimals=\"1\">\n        <input class=\"knob-input\" type=\"range\" id=\"en-comp-ratio\" min=\"1\" max=\"20\" step=\"any\" value=\"4\" />\n        <label class=\"knob-label\" for=\"en-comp-ratio\">Ratio</label>\n        <output class=\"knob-value\" for=\"en-comp-ratio\">4.0</output>\n      </div>\n      <div class=\"knob\" data-size=\"sm\" data-envelope-param=\"knee\" data-unit=\"dB\" data-decimals=\"1\">\n        <input class=\"knob-input\" type=\"range\" id=\"en-comp-knee\" min=\"0\" max=\"24\" step=\"0.5\" value=\"6\" />\n        <label class=\"knob-label\" for=\"en-comp-knee\">Knee</label>\n        <output class=\"knob-value\" for=\"en-comp-knee\">6.0 dB</output>\n      </div>\n      <div\n        class=\"knob\"\n        data-size=\"sm\"\n        data-envelope-param=\"makeup\"\n        data-format=\"signed\"\n        data-unit=\"dB\"\n        data-decimals=\"1\"\n        data-origin=\"0\"\n      >\n        <input class=\"knob-input\" type=\"range\" id=\"en-comp-makeup\" min=\"-12\" max=\"24\" step=\"0.5\" value=\"6\" />\n        <label class=\"knob-label\" for=\"en-comp-makeup\">Makeup</label>\n        <output class=\"knob-value\" for=\"en-comp-makeup\">+6.0 dB</output>\n      </div>\n      <div class=\"knob\" data-size=\"sm\" data-envelope-param=\"attack\" data-scale=\"exponential\" data-format=\"time\">\n        <input class=\"knob-input\" type=\"range\" id=\"en-comp-attack\" min=\"0.001\" max=\"1\" step=\"any\" value=\"0.005\" />\n        <label class=\"knob-label\" for=\"en-comp-attack\">Attack</label>\n        <output class=\"knob-value\" for=\"en-comp-attack\">5.00 ms</output>\n      </div>\n      <div class=\"knob\" data-size=\"sm\" data-envelope-param=\"release\" data-scale=\"exponential\" data-format=\"time\">\n        <input class=\"knob-input\" type=\"range\" id=\"en-comp-release\" min=\"0.01\" max=\"1\" step=\"any\" value=\"0.15\" />\n        <label class=\"knob-label\" for=\"en-comp-release\">Release</label>\n        <output class=\"knob-value\" for=\"en-comp-release\">150 ms</output>\n      </div>\n    </div>\n    <div class=\"flex items-center gap-3\">\n      <button class=\"btn\" type=\"button\" id=\"en-comp-play\" aria-pressed=\"false\">Play drums</button>\n      <span class=\"text-sm text-muted-foreground\">\n        Reduction <output data-envelope-output=\"reduction\"></output> · <output data-envelope-output=\"phase\"></output>\n      </span>\n    </div>\n  </div>\n</div>\n","individual":false},{"label":"Filter","html":"<div class=\"grid gap-3\">\n  <div class=\"envelope\" id=\"en-filter\" data-kind=\"filter\" data-color=\"chart-3\" aria-label=\"Filter\">\n    \n  </div>\n  <div class=\"flex flex-wrap items-center gap-4\" data-envelope-for=\"en-filter\">\n    <select class=\"select\" data-size=\"sm\" data-envelope-param=\"cut.type\" aria-label=\"Type\">\n      <option value=\"lowpass\">Low pass</option>\n      <option value=\"highpass\">High pass</option>\n      <option value=\"bandpass\">Band pass</option>\n      <option value=\"notch\">Notch</option>\n    </select>\n    <select class=\"select\" data-size=\"sm\" data-envelope-param=\"cut.slope\" aria-label=\"Slope\">\n      <option value=\"12\">12 dB/oct</option>\n      <option value=\"24\">24 dB/oct</option>\n      <option value=\"48\">48 dB/oct</option>\n    </select>\n    <div class=\"flex items-center gap-2\">\n      <input class=\"checkbox\" type=\"checkbox\" id=\"en-cut-on-1\" data-envelope-param=\"cut.on\" />\n      <label class=\"label\" for=\"en-cut-on-1\">On</label>\n    </div>\n    <button class=\"btn\" type=\"button\" data-size=\"sm\" data-variant=\"outline\" id=\"en-filter-sweep\" aria-pressed=\"false\">\n      Sweep\n    </button>\n  </div>\n</div>\n","individual":false},{"label":"EQ","html":"<div class=\"grid gap-3\">\n  <div class=\"envelope\" id=\"en-eq\" data-kind=\"filter\" data-size=\"lg\" data-range=\"18\" aria-label=\"Equalizer\">\n    \n  </div>\n  <div class=\"flex flex-wrap items-center gap-4\" data-envelope-for=\"en-eq\">\n    <div class=\"flex items-center gap-2\">\n      <input class=\"checkbox\" type=\"checkbox\" id=\"en-low-on-2\" data-envelope-param=\"low.on\" />\n      <label class=\"label\" for=\"en-low-on-2\">Low cut</label>\n    </div>\n    <div class=\"flex items-center gap-2\">\n      <input class=\"checkbox\" type=\"checkbox\" id=\"en-bass-on-3\" data-envelope-param=\"bass.on\" />\n      <label class=\"label\" for=\"en-bass-on-3\">Bass</label>\n    </div>\n    <div class=\"flex items-center gap-2\">\n      <input class=\"checkbox\" type=\"checkbox\" id=\"en-3-on-4\" data-envelope-param=\"3.on\" />\n      <label class=\"label\" for=\"en-3-on-4\">Bell</label>\n    </div>\n    <div class=\"flex items-center gap-2\">\n      <input class=\"checkbox\" type=\"checkbox\" id=\"en-air-on-5\" data-envelope-param=\"air.on\" />\n      <label class=\"label\" for=\"en-air-on-5\">Air</label>\n    </div>\n    <div class=\"flex items-center gap-2\">\n      <input class=\"checkbox\" type=\"checkbox\" id=\"en-notch-on-6\" data-envelope-param=\"notch.on\" />\n      <label class=\"label\" for=\"en-notch-on-6\">Hum</label>\n    </div>\n  </div>\n</div>\n","individual":false},{"label":"Sizes, colours and states","html":"<div class=\"grid grid-cols-auto gap-4\" style=\"--layout-min: 18rem\">\n  <div class=\"envelope\" data-size=\"sm\" data-color=\"chart-1\" aria-label=\"Pluck\">\n    \n  </div>\n  <div class=\"envelope\" data-size=\"sm\" data-color=\"chart-4\" aria-label=\"Pad\">\n    \n  </div>\n  <div class=\"envelope\" data-readonly data-color=\"chart-5\" aria-label=\"Read only\">\n    \n  </div>\n  <div class=\"envelope\" aria-disabled=\"true\" data-color=\"destructive\" aria-label=\"Disabled\">\n    \n  </div>\n</div>\n","individual":false},{"label":"In a form","html":"<form class=\"grid gap-3\" id=\"en-form\">\n  <div class=\"envelope\" id=\"en-form-env\" data-size=\"sm\" aria-label=\"Envelope\">\n    \n  </div>\n  <div class=\"flex flex-wrap items-start gap-4\" data-envelope-for=\"en-form-env\">\n    <div\n      class=\"knob\"\n      data-size=\"sm\"\n      data-envelope-param=\"attack\"\n      data-scale=\"power\"\n      data-exponent=\"3\"\n      data-format=\"time\"\n    >\n      <input\n        class=\"knob-input\"\n        type=\"range\"\n        id=\"en-form-attack\"\n        name=\"attack\"\n        min=\"0\"\n        max=\"5\"\n        step=\"0.001\"\n        value=\"0.05\"\n      />\n      <label class=\"knob-label\" for=\"en-form-attack\">Attack</label>\n      <output class=\"knob-value\" for=\"en-form-attack\">50 ms</output>\n    </div>\n    <div class=\"knob\" data-size=\"sm\" data-envelope-param=\"sustain\" data-format=\"percent\">\n      <input\n        class=\"knob-input\"\n        type=\"range\"\n        id=\"en-form-sustain\"\n        name=\"sustain\"\n        min=\"0\"\n        max=\"1\"\n        step=\"0.01\"\n        value=\"0.7\"\n      />\n      <label class=\"knob-label\" for=\"en-form-sustain\">Sustain</label>\n      <output class=\"knob-value\" for=\"en-form-sustain\">70%</output>\n    </div>\n    <div\n      class=\"knob\"\n      data-size=\"sm\"\n      data-envelope-param=\"release\"\n      data-scale=\"power\"\n      data-exponent=\"3\"\n      data-format=\"time\"\n    >\n      <input\n        class=\"knob-input\"\n        type=\"range\"\n        id=\"en-form-release\"\n        name=\"release\"\n        min=\"0\"\n        max=\"10\"\n        step=\"0.001\"\n        value=\"0.4\"\n      />\n      <label class=\"knob-label\" for=\"en-form-release\">Release</label>\n      <output class=\"knob-value\" for=\"en-form-release\">400 ms</output>\n    </div>\n  </div>\n  <div class=\"flex items-center gap-2\">\n    <button class=\"btn\" type=\"submit\" data-size=\"sm\">Submit</button>\n    <button class=\"btn\" type=\"reset\" data-size=\"sm\" data-variant=\"outline\">Reset</button>\n    <output class=\"text-sm text-muted-foreground\" id=\"en-form-data\"></output>\n  </div>\n</form>\n","individual":false}]
