d-all-2\" checked />\n      <label for=\"d-all-2\">External disks</label>\n    </div>\n    <div class=\"checkbox-item\">\n      <input class=\"checkbox\" type=\"checkbox\" id=\"d-all-3\" />\n      <label for=\"d-all-3\">CDs, DVDs, and iPods</label>\n    </div>\n    <div class=\"checkbox-item\">\n      <input class=\"checkbox\" type=\"checkbox\" id=\"d-all-4\" />\n      <label for=\"d-all-4\">Connected servers</label>\n    </div>\n  </div>\n</fieldset>\n","individual":false},{"label":"Group","html":"<fieldset style=\"border: none; padding: 0; margin: 0\" aria-describedby=\"d-grp-desc\">\n  <legend style=\"font-size: 0.875rem; font-weight: 500; margin-bottom: 0.25rem\"\n    >Select items to display on the desktop:</legend\n  >\n  <p class=\"field-description\" id=\"d-grp-desc\" style=\"margin-bottom: 0.75rem\">Choose which items are visible.</p>\n  <div style=\"display: flex; flex-direction: column; gap: 0.5rem\">\n    <div class=\"checkbox-item\">\n      <input class=\"checkbox\" type=\"checkbox\" id=\"d-grp-1\" checked />\n      <label for=\"d-grp-1\">Hard disks</label>\n    </div>\n    <div class=\"checkbox-item\">\n      <input class=\"checkbox\" type=\"checkbox\" id=\"d-grp-2\" checked />\n      <label for=\"d-grp-2\">External disks</label>\n    </div>\n    <div class=\"checkbox-item\">\n      <input class=\"checkbox\" type=\"checkbox\" id=\"d-grp-3\" />\n      <label for=\"d-grp-3\">CDs, DVDs, and iPods</label>\n    </div>\n    <div class=\"checkbox-item\">\n      <input class=\"checkbox\" type=\"checkbox\" id=\"d-grp-4\" />\n      <label for=\"d-grp-4\">Connected servers</label>\n    </div>\n  </div>\n</fieldset>\n","individual":false}]
