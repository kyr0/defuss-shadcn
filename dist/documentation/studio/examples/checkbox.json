[{"label":"Checkbox","html":"<input class=\"checkbox\" type=\"checkbox\" id=\"terms\" />\n","individual":true},{"label":"Checkbox (checked)","html":"<input class=\"checkbox\" type=\"checkbox\" id=\"option\" checked />\n","individual":true},{"label":"Checkbox (disabled)","html":"<input class=\"checkbox\" type=\"checkbox\" id=\"d-dis\" disabled />\n","individual":true},{"label":"Checkbox (disabled, checked)","html":"<input class=\"checkbox\" type=\"checkbox\" id=\"d-dis-checked\" disabled checked />\n","individual":true},{"label":"Default","html":"<div class=\"checkbox-item\">\n  <input class=\"checkbox\" type=\"checkbox\" id=\"terms\" />\n  <label for=\"terms\">Accept terms and conditions</label>\n</div>\n","individual":false},{"label":"With description","html":"<div class=\"checkbox-item-block\">\n  <input class=\"checkbox\" type=\"checkbox\" id=\"d-notify\" style=\"margin-top: 0.125rem\" aria-describedby=\"d-notify-desc\" />\n  <div>\n    <label for=\"d-notify\" class=\"item-title\">Enable notifications</label>\n    <p class=\"field-description\" id=\"d-notify-desc\">You can enable or disable notifications at any time.</p>\n  </div>\n</div>\n","individual":false},{"label":"Disabled","html":"<div class=\"flex flex-col gap-3\">\n  <div class=\"checkbox-item\">\n    <input class=\"checkbox\" type=\"checkbox\" id=\"d-dis\" disabled />\n    <label for=\"d-dis\">Disabled</label>\n  </div>\n  <div class=\"checkbox-item\">\n    <input class=\"checkbox\" type=\"checkbox\" id=\"d-dis-checked\" disabled checked />\n    <label for=\"d-dis-checked\">Disabled checked</label>\n  </div>\n</div>\n","individual":false},{"label":"Checked by default","html":"<div class=\"checkbox-item\">\n  <input class=\"checkbox\" type=\"checkbox\" id=\"option\" checked />\n  <label for=\"option\">Pre-checked option</label>\n</div>\n","individual":false},{"label":"Indeterminate","html":"<div class=\"flex flex-col gap-4\">\n  <div class=\"checkbox-item\">\n    <input class=\"checkbox\" type=\"checkbo