[{"label":"An article page","html":"<style>\n  @import url('https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;0,7..72,700;1,7..72,400&family=Manrope:wght@500;600;700;800&display=swap');\n  /* An engineering long read: a site bar, the headline over a wide photo that leaves the text column, a 40rem column\n     of Literata at reading size, a pull-quote with a hanging mark, then the author, the way on and what to read next.\n     Literata for reading, Manrope for every label around it. Looks: Longform (warm white and deep blue, follows light /\n     dark), Blueprint (navy, a drawing grid behind the headline, cyan) and E-ink (grey paper, black only, a grain). */\n  #site-article {\n    --background: oklch(0.99 0.003 85);\n    --foreground: oklch(0.2 0.012 260);\n    --card: oklch(0.975 0.004 85);\n    --card-foreground: var(--foreground);\n    --muted: oklch(0.955 0.005 85);\n    --muted-foreground: oklch(0.46 0.015 260);\n    --border: oklch(0.2 0.012 260 / 0.12);\n    --input: oklch(0.2 0.012 260 / 0.24);\n    --primary: oklch(0.47 0.13 258);\n    --primary-foreground: oklch(0.99 0.003 85);\n    --secondary: oklch(0.955 0.005 85);\n    --secondary-foreground: var(--foreground);\n    --accent: oklch(0.95 0.025 258);\n    --accent-foreground: oklch(0.38 0.12 258);\n    --ring: var(--primary);\n    --radius: 0.5rem;\n    --radius-sm: max(0px, calc(var(--radius) - 4px));\n    --radius-md: max(0px, calc(var(--radius) - 2px));\n    --radius-lg: var(--radius);\n    --radius-xl: calc(var(--radius) + 4px);\n    --article-read: 'Literata', Georgia, serif;\n    --article-ui: 'Manrope', var(--font-sans);\n    --article-band: transparent;\n    color-scheme: light;\n    container-type: inline-size;\n    box-sizing: border-box;\n    display: flex;\n    flex-direction: column;\n    width: 100%;\n    overflow-x: clip;\n    padding-block-end: clamp(3rem, 7vw, 5.5rem);\n    background: var(--background);\n    color: var(--foreground);\n    font-family: var(--article-ui);\n  }\n  .dark #site-article[data-look='longform'] {\n    color-scheme: dark;\n    --background: oklch(0.19 0.01 260);\n    --foreground: oklch(0.93 0.006 85);\n    --card: oklch(0.225 0.012 260);\n    --muted: oklch(0.25 0.012 260);\n    --muted-foreground: oklch(0.74 0.012 260);\n    --border: oklch(0.93 0.006 85 / 0.12);\n    --input: oklch(0.93 0.006 85 / 0.24);\n    --primary: oklch(0.76 0.11 255);\n    --primary-foreground: oklch(0.19 0.01 260);\n    --secondary: oklch(0.25 0.012 260);\n    --accent: oklch(0.28 0.04 258);\n    --accent-foreground: oklch(0.86 0.08 255);\n  }\n  #site-article[data-look='blueprint'] {\n    color-scheme: dark;\n    --background: oklch(0.24 0.06 255);\n    --foreground: oklch(0.96 0.012 230);\n    --card: oklch(0.28 0.065 255);\n    --muted: oklch(0.3 0.065 255);\n    --muted-foreground: oklch(0.8 0.04 235);\n    --border: oklch(0.96 0.012 230 / 0.16);\n    --input: oklch(0.96 0.012 230 / 0.28);\n    --primary: oklch(0.85 0.11 205);\n    --primary-foreground: oklch(0.22 0.06 255);\n    --secondary: oklch(0.3 0.065 255);\n    --accent: oklch(0.32 0.07 240);\n    --accent-foreground: oklch(0.9 0.08 205);\n    --article-band: oklch(0.21 0.06 255);\n  }\n  #site-article[data-look='eink'] {\n    color-scheme: light;\n    --background: oklch(0.935 0.002 90);\n    --foreground: oklch(0.16 0 0);\n    --card: oklch(0.955 0.002 90);\n    --muted: oklch(0.9 0.002 90);\n    --muted-foreground: oklch(0.38 0 0);\n    --border: oklch(0.16 0 0 / 0.16);\n    --input: oklch(0.16 0 0 / 0.3);\n    --primary: oklch(0.16 0 0);\n    --primary-foreground: oklch(0.935 0.002 90);\n    --secondary: oklch(0.9 0.002 90);\n    --accent: oklch(0.88 0.002 90);\n    --accent-foreground: oklch(0.16 0 0);\n    --radius: 0.125rem;\n  }\n  #site-article .article-look-only {\n    display: none;\n  }\n  #site-article[data-look='blueprint'] .article-look-only[data-for='blueprint'],\n  #site-article[data-look='eink'] .article-look-only[data-for='eink'] {\n    display: block;\n  }\n  /* the site bar */\n  #site-article .article-bar {\n    box-sizing: border-box;\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    justify-content: space-between;\n    gap: 0.75rem 1.5rem;\n    width: 100%;\n    min-height: 4.5rem;\n    padding: 0.75rem clamp(1rem, 4vw, 2.5rem);\n    border-block-end: 1px solid var(--border);\n  }\n  #site-article .article-brand {\n    color: var(--foreground);\n    text-decoration: none;\n    font-weight: 800;\n    font-size: 1.0625rem;\n    letter-spacing: -0.02em;\n  }\n  #site-article .article-brand span {\n    color: var(--muted-foreground);\n    font-weight: 600;\n  }\n  #site-article .article-bar-controls {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.5rem;\n  }\n  #site-article .article-bar .select {\n    min-width: 8.5rem;\n  }\n  #site-article .article-progress {\n    position: sticky;\n    top: 0;\n    z-index: 5;\n    height: 3px;\n    margin-block-end: -3px;\n    background: var(--primary);\n    transform-origin: left;\n    scale: 0 1;\n    animation: article-progress linear both;\n    animation-timeline: scroll(root);\n  }\n  @keyframes article-progress {\n    to {\n      scale: 1 1;\n    }\n  }\n  @supports not (animation-timeline: scroll()) {\n    #site-article .article-progress {\n      display: none;\n    }\n  }\n  /* the header: label, headline, standfirst, the byline - then the wide photo */\n  #site-article .mk-article-header {\n    position: relative;\n    isolation: isolate;\n    box-sizing: border-box;\n    width: 100%;\n    max-width: none;\n    align-items: stretch;\n    gap: 1.25rem;\n    padding: clamp(3rem, 7vw, 5rem) clamp(1rem, 4vw, 2.5rem) 0;\n  }\n  #site-article .mk-article-header > .surface {\n    inset: 0 0 auto;\n    height: calc(100% - clamp(8rem, 16vw, 14rem));\n    background: var(--article-band);\n  }\n  #site-article .article-grid {\n    --surface-size: 28px;\n    --surface-ink: oklch(0.85 0.08 210 / 0.09);\n    --surface-bg: var(--article-band);\n    mask-image: linear-gradient(#000 60%, transparent);\n  }\n  #site-article .article-grain {\n    --surface-size: 160px;\n    --surface-ink: oklch(0.16 0 0 / 0.06);\n    --surface-bg: transparent;\n  }\n  #site-article .mk-article-header > :is(a, h1, p, div):not(.surface) {\n    box-sizing: border-box;\n    width: 100%;\n    max-width: 41rem;\n    margin-inline: auto;\n  }\n  #site-article .mk-article-header-category {\n    color: var(--primary);\n    font-size: 0.8125rem;\n    font-weight: 800;\n    letter-spacing: 0.1em;\n    text-decoration: none;\n    text-transform: uppercase;\n  }\n  #site-article .mk-article-header-title {\n    font: 700 clamp(2.5rem, 6vw, 4.25rem)/1.04 var(--article-read);\n    letter-spacing: -0.025em;\n    text-wrap: balance;\n  }\n  #site-article .mk-article-header-subtitle {\n    margin: 0;\n    color: var(--muted-foreground);\n    font: 400 clamp(1.1875rem, 2vw, 1.4375rem)/1.45 var(--article-read);\n    text-wrap: pretty;\n  }\n  #site-article .mk-article-header-byline {\n    gap: 0.875rem;\n    margin-block-start: 0.5rem;\n    font-size: 0.875rem;\n  }\n  #site-article .mk-article-header-author {\n    color: var(--foreground);\n    font-weight: 700;\n    text-decoration: none;\n  }\n  #site-article .mk-article-header-meta {\n    color: var(--muted-foreground);\n    font-variant-numeric: tabular-nums;\n  }\n  #site-article .mk-article-header-media {\n    width: 100%;\n    max-width: 62rem;\n    margin: clamp(1.5rem, 4vw, 2.5rem) auto 0;\n  }\n  #site-article .mk-article-header-media img {\n    aspect-ratio: 2 / 1;\n    width: 100%;\n    object-fit: cover;\n    border-radius: var(--radius-xl);\n  }\n  #site-article[data-look='eink'] .mk-article-header-media img {\n    filter: grayscale(1) contrast(1.05);\n  }\n  #site-article .mk-article-header-media figcaption {\n    margin-block-start: 0.75rem;\n    color: var(--muted-foreground);\n    font-size: 0.8125rem;\n  }\n  /* the column */\n  #site-article .article-column {\n    box-sizing: border-box;\n    width: 100%;\n    max-width: 44rem;\n    margin-inline: auto;\n    padding-inline: clamp(1rem, 4vw, 1.5rem);\n  }\n  #site-article .mk-share-links {\n    margin-block: 2rem 0;\n    padding-block-end: 1.5rem;\n    border-block-end: 1px solid var(--border);\n  }\n  #site-article .mk-share-links-label {\n    color: var(--muted-foreground);\n    font-size: 0.8125rem;\n    font-weight: 700;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n  }\n  #site-article .mk-article-body {\n    --_measure: 41rem;\n    box-sizing: border-box;\n    padding-block: 2.25rem 1rem;\n    padding-inline: clamp(1rem, 4vw, 1.5rem);\n    font: 400 clamp(1.0625rem, 1.5vw, 1.1875rem)/1.75 var(--article-read);\n  }\n  #site-article .mk-article-body h2 {\n    margin-block: 2.5rem 0.75rem;\n    font: 700 1.5rem/1.25 var(--article-ui);\n    letter-spacing: -0.02em;\n  }\n  #site-article .mk-article-body a {\n    color: var(--primary);\n    text-decoration-thickness: 1px;\n    text-underline-offset: 0.2em;\n  }\n  #site-article .mk-article-body > p:first-child::first-letter {\n    float: left;\n    margin: 0.1em 0.12em 0 0;\n    font: 700 3.6em/0.8 var(--article-read);\n    color: var(--foreground);\n  }\n  /* the pull-quote: larger, a hanging mark in the accent, a rule above and below */\n  #site-article .mk-article-body > blockquote:not([class]) {\n    position: relative;\n    margin: 2.5rem 0;\n    padding: 1.75rem 0 1.5rem;\n    border: 0;\n    border-block: 1px solid var(--border);\n    background: none;\n    font-style: normal;\n  }\n  #site-article .mk-article-body > blockquote:not([class])::before {\n    content: '\\201C';\n    position: absolute;\n    top: 0.15rem;\n    left: -0.05em;\n    color: var(--primary);\n    font: 700 4.5rem/1 var(--article-read);\n  }\n  #site-article .mk-article-body > blockquote:not([class]) p {\n    margin: 0;\n    padding-inline-start: 2.75rem;\n    font: 400 italic clamp(1.375rem, 2.4vw, 1.75rem)/1.35 var(--article-read);\n    letter-spacing: -0.01em;\n  }\n  #site-article .mk-article-body > blockquote:not([class]) cite {\n    display: block;\n    margin-block-start: 0.875rem;\n    padding-inline-start: 2.75rem;\n    color: var(--muted-foreground);\n    font: 700 0.8125rem/1.3 var(--article-ui);\n    font-style: normal;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n  }\n  /* after the text: the author, the way on, what to read next */\n  #site-article .article-after {\n    display: flex;\n    flex-direction: column;\n    gap: 3rem;\n    padding-block-start: 1.5rem;\n  }\n  #site-article .mk-author-bio {\n    gap: 1.25rem;\n    padding: 1.75rem;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-xl);\n    background: var(--card);\n  }\n  #site-article .mk-author-bio-label {\n    color: var(--muted-foreground);\n    font-size: 0.75rem;\n    font-weight: 700;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n  }\n  #site-article .mk-author-bio-name {\n    font: 700 1.25rem/1.2 var(--article-ui);\n  }\n  #site-article .mk-author-bio-name a {\n    color: inherit;\n    text-decoration: none;\n  }\n  #site-article .mk-author-bio-text {\n    font-family: var(--article-read);\n  }\n  #site-article .mk-article-nav-dir {\n    font-size: 0.75rem;\n    font-weight: 700;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n  }\n  #site-article .mk-article-nav-title {\n    font: 600 1.0625rem/1.3 var(--article-read);\n  }\n  #site-article .article-next {\n    display: flex;\n    flex-direction: column;\n    gap: 1.25rem;\n  }\n  #site-article .article-next h2 {\n    margin: 0;\n    font-size: 0.8125rem;\n    font-weight: 800;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n  }\n  #site-article .article-next-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr));\n    gap: 1.5rem;\n  }\n  #site-article .mk-related-item-title {\n    font: 600 1.0625rem/1.3 var(--article-read);\n  }\n  #site-article .mk-related-item-title a {\n    color: inherit;\n  }\n  #site-article[data-look='eink'] .mk-related-item-media img {\n    filter: grayscale(1);\n  }\n  #site-article .mk-author-list-title {\n    font-size: 0.8125rem;\n    font-weight: 800;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n  }\n  @media (prefers-reduced-motion: reduce) {\n    #site-article .article-progress {\n      animation: none;\n      display: none;\n    }\n  }\n  /* light or dark: the Swap writes the page's dark class - every look has a light and a dark palette */\n  #site-article .site-mode {\n    flex: none;\n    border: 1px solid var(--input);\n    border-radius: var(--radius-md);\n    background: var(--background);\n    color: var(--foreground);\n  }\n  #site-article .site-mode:hover {\n    background: var(--accent);\n    color: var(--accent-foreground);\n  }\n  /* -- modes: each look in light and dark, derived from the palettes above (the other mode of each look) -- */\n  :root:not(.dark) #site-article[data-look='longform'] {\n    --accent: oklch(0.945 0.025 258);\n    --accent-foreground: oklch(0.2 0.012 260);\n  }\n  .dark #site-article[data-look='longform'] {\n    --accent-foreground: oklch(0.93 0.006 85);\n  }\n  .dark #site-article[data-look='blueprint'] {\n    --accent: oklch(0.33 0.05 240);\n    --accent-foreground: oklch(0.96 0.012 230);\n  }\n  :root:not(.dark) #site-article[data-look='blueprint'] {\n    color-scheme: light;\n    --background: oklch(0.985 0.025 255);\n    --foreground: oklch(0.2 0.012 230);\n    --card: oklch(0.997 0.025 255);\n    --card-foreground: oklch(0.2 0.012 230);\n    --muted: oklch(0.95 0.025 255);\n    --muted-foreground: oklch(0.46 0.03 235);\n    --border: oklch(0.2 0.012 230 / 0.12);\n    --input: oklch(0.2 0.012 230 / 0.12);\n    --primary: oklch(0.58 0.11 205);\n    --primary-foreground: oklch(0.17 0.03 205);\n    --secondary: oklch(0.955 0.025 255);\n    --secondary-foreground: oklch(0.25 0.012 230);\n    --accent: oklch(0.94 0.025 240);\n    --accent-foreground: oklch(0.2 0.012 230);\n    --ring: oklch(0.58 0.11 205);\n    --article-band: oklch(0.956 0.03 255);\n    --popover: oklch(0.997 0 0);\n    --popover-foreground: oklch(0.2 0 0);\n  }\n  :root:not(.dark) #site-article[data-look='eink'] {\n    --accent: oklch(0.89 0.002 90);\n  }\n  .dark #site-article[data-look='eink'] {\n    color-scheme: dark;\n    --background: oklch(0.17 0.002 90);\n    --foreground: oklch(0.94 0 0);\n    --card: oklch(0.205 0.002 90);\n    --card-foreground: oklch(0.94 0 0);\n    --muted: oklch(0.24 0.002 90);\n    --muted-foreground: oklch(0.74 0 0);\n    --border: oklch(0.95 0 0 / 0.14);\n    --input: oklch(0.95 0 0 / 0.14);\n    --primary: oklch(0.93 0 0);\n    --primary-foreground: oklch(0.17 0 0);\n    --secondary: oklch(0.25 0.002 90);\n    --secondary-foreground: oklch(0.9 0 0);\n    --accent: oklch(0.26 0.002 90);\n    --accent-foreground: oklch(0.94 0 0);\n    --ring: oklch(0.93 0 0);\n    --article-band: oklch(0.97 0 0 / 0);\n    --popover: oklch(0.215 0 0);\n    --popover-foreground: oklch(0.94 0 0);\n  }\n  /* -- modes: end -- */\n</style>\n<article id=\"site-article\" data-look=\"longform\" data-i18n-component>\n  <div class=\"article-bar\">\n    <a class=\"article-brand\" href=\"#/\">Acme <span>Engineering</span></a>\n    <div class=\"article-bar-controls\">\n      <select\n        class=\"select\"\n        data-size=\"sm\"\n        data-site-look\n        aria-label=\"Look\"\n        data-i18n-aria-label-en=\"Look\"\n        data-i18n-aria-label-de=\"Stil\"\n        style=\"width: auto\"\n      >\n        <option value=\"longform\" data-i18n-target=\"look-longform\">Longform</option>\n        <option value=\"blueprint\" data-i18n-target=\"look-blueprint\">Blueprint</option>\n        <option value=\"eink\" data-i18n-target=\"look-eink\">E-ink</option>\n      </select>\n      <select\n        class=\"select\"\n        data-size=\"sm\"\n        data-app-locale\n        aria-label=\"Language\"\n        data-i18n-aria-label-en=\"Language\"\n        data-i18n-aria-label-de=\"Sprache\"\n        style=\"width: auto\"\n      >\n        <option value=\"en\" lang=\"en\">English</option>\n        <option value=\"de\" lang=\"de\">Deutsch</option>\n      </select>\n      <label class=\"swap site-mode\" data-variant=\"rotate\" data-size=\"sm\">\n        <input\n          type=\"checkbox\"\n          data-site-mode\n          aria-label=\"Dark mode\"\n          data-i18n-aria-label-en=\"Dark mode\"\n          data-i18n-aria-label-de=\"Dunkler Modus\"\n        />\n        <span class=\"swap-on\" aria-hidden=\"true\"><i data-lucide=\"moon\"></i></span>\n        <span class=\"swap-off\" aria-hidden=\"true\"><i data-lucide=\"sun\"></i></span>\n      </label>\n    </div>\n  </div>\n  <div class=\"article-progress\" aria-hidden=\"true\"></div>\n  <header class=\"mk-article-header\">\n    <div\n      class=\"surface article-grid article-look-only\"\n      data-for=\"blueprint\"\n      data-variant=\"background\"\n      data-pattern=\"grid\"\n      aria-hidden=\"true\"\n    ></div>\n    <div\n      class=\"surface article-grain article-look-only\"\n      data-for=\"eink\"\n      data-variant=\"background\"\n      data-pattern=\"grain\"\n      aria-hidden=\"true\"\n    ></div>\n    <a class=\"mk-article-header-category\" href=\"#\">Engineering</a>\n    <h1 class=\"mk-article-header-title\">How offline sync works in Acme 4.0</h1>\n    <p class=\"mk-article-header-subtitle\">CRDTs, a write-ahead log and a lot of patience.</p>\n    <div class=\"mk-article-header-byline\">\n      <span class=\"avatar\"\n        ><img class=\"avatar-image\" src=\"https://i.pravatar.cc/96?img=47\" alt=\"\" data-article-face\n      /></span>\n      <div>\n        <a class=\"mk-article-header-author\" href=\"#\">Sophie Tan</a>\n        <div class=\"mk-article-header-meta\"\n          ><time datetime=\"2026-10-01\" data-article-date\n            ><span data-i18n-target=\"date\"><span data-i18n-value=\"date\">1 October 2026</span></span></time\n          ><span data-i18n-target=\"read\"><span data-i18n-value=\"minutes\">8</span> min read</span></div\n        >\n      </div>\n    </div>\n    <figure class=\"mk-article-header-media\">\n      <img src=\"https://picsum.photos/id/60/1400/700\" alt=\"A desk with a keyboard, a tablet and a notebook\" />\n      <figcaption>The first sketch of the sync pipeline, March 2026.</figcaption>\n    </figure>\n  </header>\n  <div class=\"article-column\">\n    <div\n      class=\"mk-share-links\"\n      role=\"group\"\n      aria-label=\"Share this article\"\n      data-i18n-aria-label-en=\"Share this article\"\n      data-i18n-aria-label-de=\"Diesen Artikel teilen\"\n    >\n      <span class=\"mk-share-links-label\" data-i18n-target=\"share\">Share</span>\n      <ul class=\"mk-share-links-list\">\n        <li\n          ><a\n            class=\"btn\"\n            data-variant=\"outline\"\n            data-size=\"icon-sm\"\n            href=\"https://x.com/intent/post?url=https%3A%2F%2Fexample.com%2Fcalm-software&amp;text=Calm%20software\"\n            target=\"_blank\"\n            rel=\"noopener\"\n            aria-label=\"Share on X\"\n            data-i18n-aria-label-en=\"Share on X\"\n            data-i18n-aria-label-de=\"Auf X teilen\"\n            ><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\">\n              <path\n                d=\"M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-6.4L6.4 22H3.3l7.3-8.3L.8 2h6.4l4.4 5.9L18.9 2Zm-1.1 18h1.7L6.3 3.9H4.5L17.8 20Z\"\n              /></svg></a\n        ></li>\n        <li\n          ><a\n            class=\"btn\"\n            data-variant=\"outline\"\n            data-size=\"icon-sm\"\n            href=\"https://www.linkedin.com/sharing/share-offsite/?url=https%3A%2F%2Fexample.com%2Fcalm-software\"\n            target=\"_blank\"\n            rel=\"noopener\"\n            aria-label=\"Share on LinkedIn\"\n            data-i18n-aria-label-en=\"Share on LinkedIn\"\n            data-i18n-aria-label-de=\"Auf LinkedIn teilen\"\n            ><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\">\n              <path\n                d=\"M5 3.5A2.5 2.5 0 1 1 5 8.5 2.5 2.5 0 0 1 5 3.5ZM3 10h4v11H3V10Zm7 0h3.8v1.6h.1c.5-1 1.8-1.9 3.6-1.9 3.9 0 4.5 2.5 4.5 5.8V21h-4v-4.9c0-1.2 0-2.7-1.7-2.7s-2 1.3-2 2.6v5h-4V10Z\"\n              /></svg></a\n        ></li>\n        <li\n          ><a\n            class=\"btn\"\n            data-variant=\"outline\"\n            data-size=\"icon-sm\"\n            href=\"mailto:?subject=Calm%20software&amp;body=https%3A%2F%2Fexample.com%2Fcalm-software\"\n            aria-label=\"Share by email\"\n            data-i18n-aria-label-en=\"Share by email\"\n            data-i18n-aria-label-de=\"Per E-Mail teilen\"\n            ><i data-lucide=\"mail\"></i></a\n        ></li>\n        <li\n          ><button\n            type=\"button\"\n            class=\"btn\"\n            data-variant=\"outline\"\n            data-size=\"icon-sm\"\n            data-share=\"copy\"\n            aria-label=\"Copy link\"\n            data-i18n-aria-label-en=\"Copy link\"\n            data-i18n-aria-label-de=\"Link kopieren\"\n            ><i data-lucide=\"link\"></i></button\n        ></li>\n      </ul>\n    </div>\n  </div>\n  <div class=\"mk-article-body\" data-article-body>\n    <p\n      >Sync is the feature nobody notices until it fails. Our goal for 4.0 was simple to state and hard to build:\n      <strong>never lose a keystroke</strong>, online or off.</p\n    >\n    <h2>Why CRDTs</h2>\n    <p\n      >A conflict-free replicated data type lets two devices edit the same document without a server deciding who wins.\n      Every operation <a href=\"#\">commutes</a> - merging becomes a set union.</p\n    >\n    <blockquote><p>The best sync is the one you forget is there.</p><cite>Hannah Lee, Design</cite></blockquote>\n  </div>\n  <div class=\"article-column article-after\">\n    <section class=\"mk-author-bio\" aria-labelledby=\"article-bio\">\n      <span class=\"avatar\" data-size=\"lg\"\n        ><img class=\"avatar-image\" src=\"https://i.pravatar.cc/160?img=47\" alt=\"\"\n      /></span>\n      <div class=\"mk-author-bio-body\">\n        <span class=\"mk-author-bio-label\" data-i18n-target=\"written\">Written by</span>\n        <h2 class=\"mk-author-bio-name\" id=\"article-bio\"><a href=\"#\">Sophie Tan</a></h2>\n        <p class=\"mk-author-bio-role\" data-i18n-target=\"bio-role\">Staff engineer, Sync team</p>\n        <p class=\"mk-author-bio-text\"\n          >Sophie leads the sync team at Acme. Before that she built storage engines at two databases you have heard of.\n          She writes about distributed systems, testing, and calm engineering.</p\n        >\n        <ul class=\"mk-author-bio-links\">\n          <li\n            ><a\n              class=\"btn\"\n              data-variant=\"ghost\"\n              data-size=\"icon-sm\"\n              href=\"#\"\n              rel=\"me\"\n              aria-label=\"Website\"\n              data-i18n-aria-label-en=\"Website\"\n              data-i18n-aria-label-de=\"Website\"\n              ><i data-lucide=\"globe\"></i></a\n          ></li>\n          <li\n            ><a\n              class=\"btn\"\n              data-variant=\"ghost\"\n              data-size=\"icon-sm\"\n              href=\"#\"\n              rel=\"me\"\n              aria-label=\"Email Sophie\"\n              data-i18n-aria-label-en=\"Email Sophie\"\n              data-i18n-aria-label-de=\"Sophie eine E-Mail schreiben\"\n              ><i data-lucide=\"mail\"></i></a\n          ></li>\n          <li\n            ><a\n              class=\"btn\"\n              data-variant=\"ghost\"\n              data-size=\"icon-sm\"\n              href=\"#\"\n              aria-label=\"RSS feed of Sophie's posts\"\n              data-i18n-aria-label-en=\"RSS feed of Sophie's posts\"\n              data-i18n-aria-label-de=\"RSS-Feed von Sophies Beiträgen\"\n              ><i data-lucide=\"rss\"></i></a\n          ></li>\n        </ul>\n      </div>\n    </section>\n    <nav\n      class=\"mk-article-nav\"\n      aria-label=\"More articles\"\n      data-i18n-aria-label-en=\"More articles\"\n      data-i18n-aria-label-de=\"Weitere Artikel\"\n    >\n      <a class=\"mk-article-nav-link\" href=\"#/articles/designing-for-calm\" data-router-link rel=\"prev\">\n        <span class=\"mk-article-nav-dir\"\n          ><i data-lucide=\"arrow-left\" aria-hidden=\"true\"></i> <span data-i18n-target=\"prev\">Previous</span></span\n        >\n        <span class=\"mk-article-nav-title\">Designing for calm</span>\n      </a>\n      <a class=\"mk-article-nav-link\" href=\"#/articles/testing-sync\" data-router-link rel=\"next\">\n        <span class=\"mk-article-nav-dir\"\n          ><span data-i18n-target=\"next\">Next</span> <i data-lucide=\"arrow-right\" aria-hidden=\"true\"></i\n        ></span>\n        <span class=\"mk-article-nav-title\">Testing sync with a lossy network</span>\n      </a>\n    </nav>\n    <section class=\"article-next\" aria-labelledby=\"read-next\">\n      <h2 id=\"read-next\" data-i18n-target=\"read-next\">Read next</h2>\n      <div class=\"article-next-grid\">\n        <article class=\"mk-related-item\" data-variant=\"card\">\n          <figure class=\"mk-related-item-media\"><img src=\"https://picsum.photos/id/225/600/400\" alt=\"\" /></figure>\n          <div class=\"mk-related-item-body\">\n            <span class=\"mk-related-item-kind\" data-i18n-target=\"kind-article\">Article</span>\n            <h3 class=\"mk-related-item-title\"\n              ><a href=\"#/articles/designing-for-calm\" data-router-link>Designing for calm</a></h3\n            >\n            <p class=\"mk-related-item-meta\" data-i18n-target=\"meta-calm\">24 Sep 2026 · 5 min read</p>\n          </div>\n        </article>\n        <article class=\"mk-related-item\