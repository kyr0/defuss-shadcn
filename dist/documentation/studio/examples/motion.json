[{"label":"data-df-entrance","html":"<code data-df-entrance=\"up\">up</code>\n","individual":true},{"label":"data-df-entrance (open)","html":"<details class=\"accordion-item\" name=\"hb-qa\" open data-df-entrance=\"up\">\n  <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n    ><span>Did cars shrink because people moved away?</span\n    ><svg\n      class=\"accordion-chevron\"\n      aria-hidden=\"true\"\n      width=\"28\"\n      height=\"28\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n    >\n      <path d=\"m6 9 6 6 6-6\" /></svg\n  ></summary>\n  <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n    ><p style=\"margin: 0 0 1.4rem\"\n      >No - the region grew 3% over the period; car trips fell while total trips rose from 997k to 1.12 M.</p\n    ></div\n  >\n</details>\n","individual":true},{"label":"data-df-stagger","html":"<ul\n  data-df-stagger=\"\"\n  style=\"--df-motion-stagger-step: 140ms; margin: 0 0 0.85rem; padding: 0; list-style: none; display: grid; gap: 0.5rem\"\n>\n  <li data-df-entrance=\"up\" class=\"card\" style=\"padding: 0.5rem 0.85rem\"\n    >Entrance vocabulary - fifteen directions, zero JS</li\n  >\n  <li data-df-entrance=\"up\" class=\"card\" style=\"padding: 0.5rem 0.85rem\"\n    >animation-composition: add - your transforms survive</li\n  >\n  <li data-df-entrance=\"up\" class=\"card\" style=\"padding: 0.5rem 0.85rem\"\n    >Deterministic replay: cancel → play, finished/cancel handles</li\n  >\n  <li data-df-entrance=\"up\" class=\"card\" style=\"padding: 0.5rem 0.85rem\"\n    >1ms under prefers-reduced-motion - contract intact</li\n  >\n</ul>\n","individual":true},{"label":"Anatomy","html":"<table class=\"table mini-table\">\n  <tbody>\n    <tr\n      ><td><code>data-df-entrance=\"up\"</code></td\n      ><td>drift in from below (also down / left / right)</td></tr\n    >\n    <tr\n      ><td><code>data-df-entrance=\"pop\"</code></td\n      ><td>scale with overshoot (also zoom / zoom-out)</td></tr\n    >\n    <tr\n      ><td><code>data-df-entrance=\"flip\"</code></td\n      ><td>rotational (also spin / skew)</td></tr\n    >\n    <tr\n      ><td><code>data-df-entrance=\"wipe\"</code></td\n      ><td>clip-path reveals (also wipe-up / iris)</td></tr\n    >\n    <tr\n      ><td><code>style=\"--df-motion-delay:400ms\"</code></td\n      ><td>timing surface (also -duration / -ease / -distance …)</td></tr\n    >\n    <tr\n      ><td><code>data-df-stagger=\"\"</code></td\n      ><td>container grader for child delays</td></tr\n    >\n    <tr\n      ><td><code>data-df-draw</code> + <code>pathLength=\"1\"</code></td\n      ><td>SVG draw-in primitive</td></tr\n    >\n  </tbody>\n</table>\n","individual":false},{"label":"The vocabulary","html":"<div\n  id=\"vocab\"\n  style=\"\n    --df-motion-duration: 1500ms;\n    --df-motion-ease: cubic-bezier(0.45, 0, 0.55, 1);\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 0.75rem 1.25rem;\n    font-family: var(--font-mono);\n    font-size: 0.85rem;\n  \"\n>\n  <code data-df-entrance=\"up\">up</code>\n  <code data-df-entrance=\"down\">down</code>\n  <code data-df-entrance=\"left\">left</code>\n  <code data-df-entrance=\"right\">right</code>\n  <code data-df-entrance=\"zoom\">zoom</code>\n  <code data-df-entrance=\"zoom-out\">zoom-out</code>\n  <code data-df-entrance=\"pop\" style=\"--df-motion-ease: cubic-bezier(0.34, 1.56, 0.64, 1)\">pop</code>\n  <code data-df-entrance=\"spin\">spin</code>\n  <code data-df-entrance=\"flip\">flip</code>\n  <code data-df-entrance=\"skew\">skew</code>\n  <code data-df-entrance=\"blur\">blur</code>\n  <code data-df-entrance=\"wipe\">wipe</code>\n  <code data-df-entrance=\"wipe-up\">wipe-up</code>\n  <code data-df-entrance=\"iris\">iris</code>\n  <code data-df-entrance=\"fade\">fade</code>\n</div>\n<button\n  class=\"btn\"\n  data-size=\"sm\"\n  style=\"margin-top: 1.25rem\"\n  onclick=\"document.querySelectorAll('#vocab [data-df-entrance]').forEach((el) => ddf$.entrance(el))\"\n  >Replay all</button\n>\n","individual":false},{"label":"Stagger + timing","html":"<section id=\"stagger-demo\" style=\"--df-motion-duration: 520ms; --df-motion-distance: 28px\">\n  <h4 data-df-entrance=\"wipe\" style=\"margin: 0 0 0.75rem\">Release 2.4</h4>\n  <ul\n    data-df-stagger\n    style=\"\n      --df-motion-stagger-step: 140ms;\n      margin: 0 0 0.85rem;\n      padding: 0;\n      list-style: none;\n      display: grid;\n      gap: 0.5rem;\n    \"\n  >\n    <li data-df-entrance=\"up\" class=\"card\" style=\"padding: 0.5rem 0.85rem\"\n      >Entrance vocabulary - fifteen directions, zero JS</li\n    >\n    <li data-df-entrance=\"up\" class=\"card\" style=\"padding: 0.5rem 0.85rem\"\n      >animation-composition: add - your transforms survive</li\n    >\n    <li data-df-entrance=\"up\" class=\"card\" style=\"padding: 0.5rem 0.85rem\"\n      >Deterministic replay: cancel → play, finished/cancel handles</li\n    >\n    <li data-df-entrance=\"up\" class=\"card\" style=\"padding: 0.5rem 0.85rem\"\n      >1ms under prefers-reduced-motion - contract intact</li\n    >\n  </ul>\n  <button\n    class=\"btn\"\n    data-size=\"sm\"\n    onclick=\"document.querySelectorAll('#stagger-demo [data-df-entrance]').forEach((el) => ddf$.entrance(el))\"\n    >Run stagger</button\n  >\n</section>\n","individual":false},{"label":"SVG draw-in","html":"<svg\n  id=\"draw-demo\"\n  width=\"360\"\n  height=\"110\"\n  viewBox=\"0 0 360 110\"\n  fill=\"none\"\n  stroke=\"var(--primary)\"\n  stroke-width=\"5\"\n  stroke-linecap=\"round\"\n  style=\"display: block; margin-bottom: 0.85rem\"\n>\n  <path\n    data-df-draw\n    pathLength=\"1\"\n    style=\"--df-motion-duration: 900ms\"\n    d=\"M8 90 C 90 85, 150 20, 210 40 S 320 95, 352 14\"\n  />\n</svg>\n<button class=\"btn\" data-size=\"sm\" onclick=\"ddf$.draw(document.querySelector('#draw-demo path'))\">Draw again</button>\n","individual":false},{"label":"JS controller","html":"<div class=\"card\" id=\"m-console\" style=\"max-width: 26rem; padding: 1rem\">\n  <div style=\"display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin-bottom: 0.85rem\">\n    <code style=\"font-size: 0.8rem\">ddf$.entrance(card, effect)</code>\n    <span class=\"badge\" data-variant=\"secondary\" id=\"m-status\">idle</span>\n  </div>\n  <div\n    id=\"m-card\"\n    class=\"card\"\n    data-df-entrance=\"up\"\n    style=\"\n      --df-motion-duration: 1500ms;\n      --df-motion-ease: cubic-bezier(0.45, 0, 0.55, 1);\n      padding: 1.25rem 1rem;\n      text-align: center;\n      font-weight: 600;\n      margin-bottom: 1.25rem;\n    \"\n  >\n    Ship it. <span class=\"badge\" data-variant=\"outline\" id=\"m-effect\" style=\"margin-left: 0.4rem\">up</span>\n  </div>\n  <div id=\"m-chips\" style=\"display: flex; flex-wrap: wrap; gap: 0.4rem\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-effect=\"flip\">flip</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-effect=\"pop\">pop</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-effect=\"spin\">spin</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-effect=\"wipe\">wipe</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-effect=\"iris\">iris</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-effect=\"zoom-out\">zoom-out</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-effect=\"skew\">skew</button>\n  </div>\n</div>\n","individual":false}]
