 code</li>\n        <li>discount</li>\n      </ul>\n    </div>\n  </div>\n  <ol class=\"diagram-edges\">\n    <li class=\"diagram-edge\" data-from=\"customer\" data-to=\"order\" data-head=\"zero-many\" data-tail=\"one\">places</li>\n    <li\n      class=\"diagram-edge\"\n      data-from=\"customer\"\n      data-to=\"sub\"\n      data-head=\"zero-many\"\n      data-tail=\"one\"\n      data-change=\"added\"\n      >holds</li\n    >\n    <li\n      class=\"diagram-edge\"\n      data-from=\"sub\"\n      data-to=\"order\"\n      data-head=\"zero-many\"\n      data-tail=\"zero-one\"\n      data-change=\"added\"\n      >renews into</li\n    >\n    <li\n      class=\"diagram-edge\"\n      data-from=\"order\"\n      data-to=\"coupon\"\n      data-head=\"zero-one\"\n      data-tail=\"zero-many\"\n      data-change=\"removed\"\n      >applies</li\n    >\n  </ol>\n</figure>\n","individual":true},{"label":"Orders schema","html":"<figure class=\"diagram\" id=\"dg-schema\" data-type=\"db-schema\" aria-label=\"Orders database schema\">\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Database schema</span>\n    <span class=\"diagram-title\">public schema · orders</span>\n  </figcaption>\n  <div class=\"diagram-canvas\" style=\"--cols: 3\">\n    <div class=\"diagram-node\" data-node=\"customers\" style=\"--col: 1; --row: 1\">\n      <span class=\"diagram-node-eyebrow\">Table</span>\n      <span class=\"diagram-node-name\">public.customers</span>\n      <ul class=\"diagram-node-fields\">\n        <li data-field=\"id\" data-key=\"pk\"><span>id</span><span>uuid</span></li>\n        <li data-field=\"email\" data-key=\"uq\"><span>email</span><span>text</span></li>\n        <li data-field=\"name\"><span>name</span><span>text</span></li>\n        <li data-field=\"created_at\"><span>created_at</span><span>timestamptz</span></li>\n      </ul>\n    </div>\n    <div class=\"diagram-node\" data-node=\"orders\" data-tone=\"accent\" style=\"--col: 2; --row: 1\">\n   