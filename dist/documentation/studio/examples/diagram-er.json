dress</span>\n      <ul class=\"diagram-node-fields\">\n        <li>street</li>\n        <li>city</li>\n        <li>country</li>\n      </ul>\n    </div>\n  </div>\n  <ol class=\"diagram-edges\">\n    <li\n      class=\"diagram-edge\"\n      data-from=\"customer\"\n      data-to=\"order\"\n      data-head=\"zero-many\"\n      data-tail=\"one\"\n      data-from-label=\"1\"\n      data-to-label=\"0..*\"\n      >places</li\n    >\n    <li\n      class=\"diagram-edge\"\n      data-from=\"order\"\n      data-to=\"line\"\n      data-head=\"one-many\"\n      data-tail=\"one\"\n      data-from-label=\"1\"\n      data-to-label=\"1..*\"\n      >contains</li\n    >\n    <li\n      class=\"diagram-edge\"\n      data-from=\"line\"\n      data-to=\"product\"\n      data-head=\"one\"\n      data-tail=\"zero-many\"\n      data-from-label=\"0..*\"\n      data-to-label=\"1\"\n      >refers to</li\n    >\n    <li class=\"diagram-edge\" data-from=\"customer\" data-to=\"address\" data-head=\"one-many\" data-tail=\"one\">ships to</li>\n  </ol>\n</figure>\n","individual":true},{"label":"Domain model, step by step","html":"<figure class=\"diagram\" id=\"dg-er-steps\" data-type=\"er\" data-steps data-autoplay aria-label=\"Commerce domain model\">\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">ER · domain model</span>\n    <span class=\"diagram-title\">Customers, orders, products</span>\n  </figcaption>\n  <div class=\"diagram-canvas\" style=\"--cols: 3; --diagram-gap-y: 4rem\">\n    <div class=\"diagram-node\" data-node=\"customer\" style=\"--col: 1; --row: 1\">\n      <span class=\"diagram-node-eyebrow\">Entity</span>\n      <span class=\"diagram-node-name\">Customer</span>\n      <ul class=\"diagram-node-fields\">\n        <li># id</li>\n        <li>name</li>\n        <li>email</li>\n      </ul>\n    </div>\n    <div class=\"diagram-node\" data-node=\"order\" data-tone=\"accent\" style=\"--col: 2; --row: 1\">\n      <span class=\"diagram-node-eyebrow\">Enti