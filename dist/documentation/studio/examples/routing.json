[{"label":"A mailbox with routes","html":"<div class=\"flex flex-wrap gap-6\" id=\"mail\" style=\"min-height: 13rem\">\n  <nav class=\"flex flex-col gap-1\" aria-label=\"Folders\" style=\"min-width: 9rem\">\n    <a class=\"btn\" data-variant=\"ghost\" href=\"#/\" data-router-link aria-current=\"page\">Inbox</a>\n    <a class=\"btn\" data-variant=\"ghost\" href=\"#/archive\" data-router-link>Archive</a>\n    <p class=\"text-xs text-muted-foreground mt-2\"><output id=\"mail-route\">inbox · /</output></p>\n  </nav>\n  <section class=\"flex flex-col gap-2\" data-view=\"inbox\" style=\"flex: 1 1 16rem\">\n    <h3 class=\"text-sm font-medium m-0\">Inbox</h3>\n    <a href=\"#/messages/1\" data-router-link>Lunch on Friday?</a>\n    <a href=\"#/messages/2\" data-router-link>The Q4 plan, second draft</a>\n  </section>\n  <section class=\"flex flex-col gap-2\" data-view=\"archive\" style=\"flex: 1 1 16rem\" hidden>\n    <h3 class=\"text-sm font-medium m-0\">Archive</h3>\n    <a href=\"#/messages/3\" data-router-link>Welcome to the team</a>\n    <a href=\"#/messages/9\" data-router-link>A message that is gone</a>\n  </section>\n  <section class=\"flex flex-col gap-2\" data-view=\"message\" style=\"flex: 1 1 16rem\" hidden>\n    <a href=\"#/\" data-router-link>← Inbox</a>\n    <h3 class=\"text-sm font-medium m-0\" id=\"mail-subject\"></h3>\n    <p class=\"text-sm text-muted-foreground m-0\" id=\"mail-body\"></p>\n  </section>\n  <section class=\"flex flex-col gap-2\" data-view=\"missing\" style=\"flex: 1 1 16rem\" hidden>\n    <h3 class=\"text-sm font-medium m-0\">Not found</h3>\n    <p class=\"text-sm text-muted-foreground m-0\"\n      >No such message - <a href=\"#/\" data-router-link>back to the inbox</a>.</p\n    >\n  </section>\n</div>\n","individual":false}]
