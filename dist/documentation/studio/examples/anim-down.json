[{"label":"In / out, directions and lifecycle","html":"<style>\n  #anim-down-target {\n    width: 160px;\n    height: 100px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    background: var(--card);\n    color: var(--card-foreground);\n    font-size: 0.85rem;\n  }\n</style>\n<div style=\"display: flex; flex-direction: column; gap: 0.75rem\">\n  <div id=\"anim-down-target\">slide me</div>\n  <div style=\"display: flex; flex-wrap: wrap; gap: 0.4rem\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-down-in\">In</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-down-out\">Out</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-anim-down-dir=\"north\" aria-pressed=\"true\">N</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-anim-down-dir=\"south\" aria-pressed=\"false\">S</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-anim-down-dir=\"west\" aria-pressed=\"false\">W</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-anim-down-dir=\"east\" aria-pressed=\"false\">E</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-down-pause\">Pause</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-down-resume\">Resume</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-down-finish\">Finish</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-down-reset\">Reset</button>\n  </div>\n  <div style=\"display: flex; align-items: center; gap: 0.75rem; font-size: 0.85rem\">\n    <label for=\"anim-down-duration\">Duration (ms)</label>\n    <input class=\"input\" id=\"anim-down-duration\" type=\"number\" min=\"50\" step=\"50\" value=\"1500\" style=\"width: 6rem\" />\n    <label for=\"anim-down-easing\">Easing</label>\n    <select class=\"select\" id=\"anim-down-easing\">\n      <option value=\"cubic-bezier(0.16, 1, 0.3, 1)\" selected>default (ease-out-expo)</option>\n      <option value=\"linear\">linear</option>\n      <option value=\"ease-in-out\">ease-in-out</option>\n      <option value=\"cubic-bezier(0.34, 1.56, 0.64, 1)\">overshoot</option>\n    </select>\n  </div>\n</div>\n","individual":false},{"label":"Scroll-bound slide-in","html":"<style>\n  #anim-down-scroll-target {\n    width: 160px;\n    height: 100px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    background: var(--card);\n    color: var(--card-foreground);\n    font-size: 0.85rem;\n  }\n</style>\n<div\n  id=\"anim-down-scroller\"\n  style=\"\n    height: 220px;\n    overflow-y: auto;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    padding: 1rem;\n  \"\n>\n  <div style=\"height: 600px; display: flex; flex-direction: column; justify-content: space-between\">\n    <p class=\"text-sm text-muted-foreground\" style=\"margin: 0\">Scroll down - the box slides in as you go.</p>\n    <div id=\"anim-down-scroll-target\">scroll-driven</div>\n  </div>\n</div>\n","individual":false}]
