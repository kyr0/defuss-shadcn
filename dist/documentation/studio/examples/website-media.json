[{"label":"A media page","html":"<div style=\"display: flex; flex-direction: column; gap: 4rem; width: 100%\">\n  <section class=\"mk-text-media\" aria-labelledby=\"tm-1\">\n    <div class=\"mk-text-media-layout\">\n      <div class=\"mk-text-media-copy\">\n        <span class=\"mk-text-media-eyebrow\">Offline first</span>\n        <h2 class=\"mk-text-media-title\" id=\"tm-1\">Your work travels with you</h2>\n        <p class=\"mk-text-media-text\"\n          >Every change is saved on your device first and synced when you are back online - on a plane, in a tunnel, at\n          the cabin.</p\n        >\n        <ul class=\"mk-text-media-list\"\n          ><li><i data-lucide=\"check\"></i>Edits never wait for the network</li\n          ><li><i data-lucide=\"check\"></i>Conflicts resolve themselves</li\n          ><li><i data-lucide=\"check\"></i>Works on every device</li></ul\n        >\n        <a class=\"mk-text-media-link\" href=\"#\">How sync works <i data-lucide=\"arrow-right\"></i></a>\n      </div>\n      <figure class=\"mk-text-media-media\"\n        ><img src=\"https://picsum.photos/seed/tm-cabin/1000/750\" alt=\"A laptop on a table in a mountain cabin\"\n      /></figure>\n    </div>\n  </section>\n  <section class=\"mk-media-gallery\" aria-labelledby=\"mg-title\">\n    <header class=\"mk-media-gallery-head\">\n      <h2 id=\"mg-title\">Lisbon, autumn 2026</h2>\n      <span>8 photos</span>\n      <div class=\"mk-media-gallery-tools\">\n        <div class=\"mk-media-gallery-views\" role=\"radiogroup\" aria-label=\"Layout\">\n          <label\n            ><input type=\"radio\" name=\"mg-view\" value=\"grid\" checked /><i data-lucide=\"layout-grid\"></i\n            ><span class=\"sr-only\">Grid</span></label\n          >\n          <label\n            ><input type=\"radio\" name=\"mg-view\" value=\"masonry\" /><i data-lucide=\"layout-dashboard\"></i\n            ><span class=\"sr-only\">Masonry</span></label\n          >\n          <label\n            ><input type=\"radio\" name=\"mg-view\" value=\"strip\" /><i data-lucide=\"gallery-horizontal\"></i\n            ><span class=\"sr-only\">Filmstrip</span></label\n          >\n        </div>\n        <button\n          class=\"btn\"\n          data-variant=\"outline\"\n          data-size=\"sm\"\n          type=\"button\"\n          commandfor=\"mg-viewer\"\n          command=\"show-modal\"\n          ><i data-lucide=\"play\"></i> Slideshow</button\n        >\n      </div>\n    </header>\n    <ul class=\"mk-media-gallery-grid\">\n      <li\n        ><figure><img src=\"https://picsum.photos/seed/mg-1/800/600\" alt=\"Harbour at dawn\" /></figure\n      ></li>\n      <li\n        ><figure><img src=\"https://picsum.photos/seed/mg-2/600/800\" alt=\"Stairs in Alfama\" /></figure\n      ></li>\n      <li\n        ><figure><img src=\"https://picsum.photos/seed/mg-3/800/500\" alt=\"River light\" /></figure\n      ></li>\n      <li\n        ><figure><img src=\"https://picsum.photos/seed/mg-4/600/600\" alt=\"Tiles\" /></figure\n      ></li>\n      <li\n        ><figure><img src=\"https://picsum.photos/seed/mg-5/800/600\" alt=\"Market morning\" /></figure\n      ></li>\n      <li\n        ><figure><img src=\"https://picsum.photos/seed/mg-6/600/900\" alt=\"Old tram\" /></figure\n      ></li>\n      <li\n        ><figure><img src=\"https://picsum.photos/seed/mg-7/800/600\" alt=\"Coastline\" /></figure\n      ></li>\n      <li\n        ><figure><img src=\"https://picsum.photos/seed/mg-8/700/500\" alt=\"Rooftops\" /></figure\n      ></li>\n    </ul>\n    <dialog class=\"mk-media-gallery-viewer\" id=\"mg-viewer\" aria-label=\"Slideshow: Lisbon, autumn 2026\">\n      <div class=\"mk-media-gallery-viewer-inner\">\n        <ul class=\"mk-media-gallery-track\" tabindex=\"0\" aria-label=\"Photos - scroll sideways\">\n          <li\n            ><img src=\"https://picsum.photos/seed/mg-1/1600/1200\" alt=\"Harbour at dawn\" /><p\n              >1 / 8 · Harbour at dawn</p\n            ></li\n    