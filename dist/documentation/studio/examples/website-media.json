[{"label":"A media page","html":"<style>\n  @import url('https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap');\n  /* Acme Stories, the company's media room, on one 76rem grid with ONE language: an Instrument Serif title per\n     section, Instrument Sans for everything else, square-cornered pictures, sections numbered 01-05 on a hairline,\n     one accent. The film always plays in a dark screening band. Moves: a customs stamp on the first picture, film\n     frames around the stills in Cinema, the podcast cover turning like a record while it plays. Looks: Gallery\n     (white walls and vermilion, follows light / dark), Cinema (black, amber, grain over the stills) and Archive\n     (warm paper, sepia prints, brown ink). */\n  #site-media {\n    --background: oklch(0.99 0 0);\n    --foreground: oklch(0.18 0 0);\n    --card: oklch(1 0 0);\n    --card-foreground: var(--foreground);\n    --muted: oklch(0.96 0 0);\n    --muted-foreground: oklch(0.44 0 0);\n    --border: oklch(0.18 0 0 / 0.12);\n    --input: oklch(0.18 0 0 / 0.24);\n    --primary: oklch(0.18 0 0);\n    --primary-foreground: oklch(0.99 0 0);\n    --secondary: oklch(0.96 0 0);\n    --secondary-foreground: var(--foreground);\n    --accent: oklch(0.58 0.2 32);\n    --accent-foreground: oklch(0.99 0 0);\n    --ring: var(--accent);\n    /* one corner for every box in the site - pictures, players, cards, buttons alike */\n    --radius: 0.375rem;\n    --radius-sm: var(--radius);\n    --radius-md: var(--radius);\n    --radius-lg: var(--radius);\n    --radius-xl: var(--radius);\n    --md-title: 'Instrument Serif', Georgia, serif;\n    --md-stamp: oklch(0.5 0.16 255);\n    --md-photo: saturate(1);\n    color-scheme: light;\n    container-type: inline-size;\n    counter-reset: md;\n    box-sizing: border-box;\n    display: flex;\n    flex-direction: column;\n    width: 100%;\n    overflow-x: clip;\n    background: var(--background);\n    color: var(--foreground);\n    font:\n      400 1rem/1.55 'Instrument Sans',\n      var(--font-sans);\n  }\n  .dark #site-media[data-look='gallery'] {\n    color-scheme: dark;\n    --background: oklch(0.17 0 0);\n    --foreground: oklch(0.95 0 0);\n    --card: oklch(0.21 0 0);\n    --muted: oklch(0.24 0 0);\n    --muted-foreground: oklch(0.74 0 0);\n    --border: oklch(0.95 0 0 / 0.12);\n    --input: oklch(0.95 0 0 / 0.24);\n    --primary: oklch(0.95 0 0);\n    --primary-foreground: oklch(0.17 0 0);\n    --secondary: oklch(0.24 0 0);\n    --accent: oklch(0.7 0.17 35);\n    --md-stamp: oklch(0.75 0.12 255);\n  }\n  #site-media[data-look='cinema'] {\n    color-scheme: dark;\n    --background: oklch(0.12 0 0);\n    --foreground: oklch(0.94 0.01 85);\n    --card: oklch(0.16 0 0);\n    --muted: oklch(0.2 0 0);\n    --muted-foreground: oklch(0.74 0.01 85);\n    --border: oklch(0.94 0.01 85 / 0.12);\n    --input: oklch(0.94 0.01 85 / 0.24);\n    --primary: oklch(0.82 0.13 80);\n    --primary-foreground: oklch(0.12 0 0);\n    --secondary: oklch(0.2 0 0);\n    --secondary-foreground: var(--foreground);\n    --accent: oklch(0.82 0.13 80);\n    --accent-foreground: oklch(0.12 0 0);\n    --md-stamp: oklch(0.82 0.13 80);\n  }\n  #site-media[data-look='archive'] {\n    color-scheme: light;\n    --background: oklch(0.955 0.018 78);\n    --foreground: oklch(0.26 0.03 50);\n    --card: oklch(0.975 0.014 78);\n    --muted: oklch(0.925 0.022 75);\n    --muted-foreground: oklch(0.46 0.035 55);\n    --border: oklch(0.26 0.03 50 / 0.14);\n    --input: oklch(0.26 0.03 50 / 0.26);\n    --primary: oklch(0.36 0.06 45);\n    --primary-foreground: oklch(0.975 0.014 78);\n    --secondary: oklch(0.925 0.022 75);\n    --secondary-foreground: var(--foreground);\n    --accent: oklch(0.48 0.12 40);\n    --accent-foreground: oklch(0.975 0.014 78);\n    --md-stamp: oklch(0.45 0.12 30);\n    --md-photo: sepia(0.55) saturate(0.8) contrast(1.02);\n  }\n  #site-media .md-look-only {\n    display: none;\n  }\n  #site-media[data-look='cinema'] .md-look-only[data-for='cinema'] {\n    display: block;\n  }\n  /* one grid for every section */\n  #site-media > :not(template) {\n    box-sizing: border-box;\n    width: 100%;\n    padding-inline: max(clamp(1rem, 4vw, 2.5rem), calc((100% - 76rem) / 2));\n  }\n  #site-media .md-bar {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 0.75rem 1.5rem;\n    min-height: 4.5rem;\n    padding-block: 0.75rem;\n    border-block-end: 1px solid var(--border);\n  }\n  #site-media .md-brand {\n    margin-inline-end: auto;\n    color: var(--foreground);\n    text-decoration: none;\n    font: 400 1.625rem/1 var(--md-title);\n  }\n  #site-media .md-brand i {\n    color: var(--accent);\n  }\n  #site-media .md-bar-controls {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.5rem;\n  }\n  #site-media .md-bar .select {\n    min-width: 8rem;\n  }\n  /* sections: a number on a hairline, then the content */\n  #site-media > .md-section {\n    counter-increment: md;\n    padding-block: clamp(3rem, 6vw, 4.5rem);\n  }\n  #site-media > .md-section::before {\n    content: counter(md, decimal-leading-zero);\n    display: block;\n    margin-block-end: 1.5rem;\n    padding-block-start: 0.75rem;\n    border-block-start: 1px solid var(--foreground);\n    color: var(--accent);\n    font-size: 0.75rem;\n    font-weight: 700;\n    letter-spacing: 0.12em;\n  }\n  #site-media\n    :is(.mk-text-media-title, .mk-media-gallery-head h2, .mk-video-player-caption h3, .mk-audio-player-title) {\n    font-family: var(--md-title);\n    font-style: normal;\n    font-weight: 400;\n    letter-spacing: -0.01em;\n  }\n  #site-media img {\n    filter: var(--md-photo);\n  }\n  /* the opening: copy beside the first picture, a customs stamp on it */\n  #site-media .md-hero {\n    padding-block: clamp(3.5rem, 8vw, 6rem);\n  }\n  #site-media .mk-text-media {\n    max-width: none;\n    margin: 0;\n  }\n  #site-media .mk-text-media-title {\n    font-size: clamp(2.75rem, 6.5vw, 5rem);\n    line-height: 0.98;\n  }\n  #site-media .mk-text-media-text {\n    font-size: 1.125rem;\n    color: var(--muted-foreground);\n  }\n  #site-media .mk-text-media-eyebrow {\n    color: var(--accent);\n    font-size: 0.75rem;\n    font-weight: 700;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n  }\n  #site-media .mk-text-media-media {\n    position: relative;\n    overflow: visible;\n  }\n  #site-media .mk-text-media-media img {\n    border-radius: var(--radius);\n  }\n  #site-media .md-stamp {\n    position: absolute;\n    z-index: 2;\n    left: -1.75rem;\n    bottom: -1.75rem;\n    display: grid;\n    place-items: center;\n    width: 7.5rem;\n    aspect-ratio: 1;\n    margin: 0;\n    padding: 1.25rem;\n    border: 3px double var(--md-stamp);\n    border-radius: 50%;\n    color: var(--md-stamp);\n    background: var(--background);\n    text-align: center;\n    font:\n      700 0.6875rem/1.2 'Instrument Sans',\n      sans-serif;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    rotate: -12deg;\n  }\n  #site-media .md-stamp b {\n    display: block;\n    font-size: 1.375rem;\n    letter-spacing: 0.04em;\n  }\n  @container (width < 40rem) {\n    #site-media .md-stamp {\n      left: 0.75rem;\n      bottom: -1.25rem;\n      width: 6rem;\n      padding: 1rem;\n    }\n  }\n  /* photos: the grid, film frames in Cinema */\n  #site-media .mk-media-gallery {\n    position: relative;\n    isolation: isolate;\n    max-width: none;\n    margin: 0;\n  }\n  #site-media .mk-media-gallery-head h2 {\n    font-size: clamp(2rem, 4vw, 3rem);\n  }\n  #site-media .mk-media-gallery-grid {\n    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));\n    gap: 0.75rem;\n  }\n  #site-media .mk-media-gallery-grid figure {\n    border-radius: var(--radius);\n  }\n  #site-media[data-look='cinema'] .mk-media-gallery-grid figure {\n    padding: 0.85rem 0;\n    border-radius: 0;\n    background:\n      repeating-linear-gradient(90deg, oklch(0.93 0.02 85 / 0.85) 0 0.45rem, transparent 0.45rem 1.05rem) 0 0.2rem /\n        100% 0.4rem no-repeat,\n      repeating-linear-gradient(90deg, oklch(0.93 0.02 85 / 0.85) 0 0.45rem, transparent 0.45rem 1.05rem) 0\n        calc(100% - 0.2rem) / 100% 0.4rem no-repeat,\n      oklch(0.06 0 0);\n  }\n  #site-media[data-look='cinema'] .mk-media-gallery-grid img {\n    filter: sepia(0.35) contrast(1.1) saturate(0.8);\n  }\n  #site-media .md-grain {\n    z-index: 1;\n    pointer-events: none;\n    mix-blend-mode: overlay;\n    opacity: 0.22;\n  }\n  /* the film: always in a dark screening band */\n  #site-media > .md-film {\n    color-scheme: dark;\n    --background: oklch(0.14 0 0);\n    --foreground: oklch(0.95 0.005 85);\n    --card: oklch(0.18 0 0);\n    --muted: oklch(0.22 0 0);\n    --muted-foreground: oklch(0.74 0.005 85);\n    --border: oklch(0.95 0.005 85 / 0.14);\n    background: var(--background);\n    color: var(--foreground);\n  }\n  #site-media > .md-film::before {\n    border-color: var(--foreground);\n  }\n  #site-media .mk-video-player {\n    max-width: none;\n    margin: 0;\n  }\n  #site-media .mk-video-player-caption h3 {\n    font-size: clamp(1.75rem, 3vw, 2.25rem);\n  }\n  /* listen: the player beside the episodes */\n  #site-media .md-listen {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr);\n    gap: 2rem;\n    align-items: start;\n  }\n  @container (width > 56rem) {\n    #site-media .md-listen {\n      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n    }\n  }\n  #site-media .md-listen::before {\n    grid-column: 1 / -1;\n    margin-block-end: 0 !important;\n  }\n  #site-media .mk-audio-player,\n  #site-media .mk-playlist {\n    border-radius: var(--radius-xl);\n  }\n  #site-media .mk-audio-player-cover {\n    border-radius: 50%;\n    animation: md-spin 6s linear infinite paused;\n  }\n  #site-media .mk-audio-player:has(audio:not([paused])) .mk-audio-player-cover {\n    animation-play-state: running;\n  }\n  @keyframes md-spin {\n    to {\n      rotate: 360deg;\n    }\n  }\n  /* compare and share: the before / after beside what people posted */\n  #site-media .md-pair {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr);\n    gap: 2rem;\n    align-items: start;\n  }\n  @container (width > 56rem) {\n    #site-media .md-pair {\n      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);\n      gap: 2.5rem;\n    }\n  }\n  #site-media .md-pair::before {\n    grid-column: 1 / -1;\n    margin-block-end: 0 !important;\n  }\n  #site-media .md-pair .mk-before-after {\n    max-width: none;\n    margin: 0;\n  }\n  #site-media .md-posts {\n    display: grid;\n    gap: 1rem;\n  }\n  #site-media .mk-social-post {\n    border-radius: var(--radius-xl);\n  }\n  /* the opening's two calls to action */\n  #site-media .md-cta {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.75rem;\n    margin-block-start: 0.75rem;\n  }\n  /* Lisbon: every picture lifts and sharpens under the pointer, the others step back */\n  #site-media .mk-media-gallery-grid figure {\n    position: relative;\n    overflow: hidden;\n  }\n  #site-media .mk-media-gallery-grid img {\n    transition:\n      scale 0.6s cubic-bezier(0.2, 0.7, 0.2, 1),\n      filter 0.4s;\n  }\n  #site-media .mk-media-gallery-grid a:is(:hover, :focus-visible) img {\n    scale: 1.07;\n  }\n  #site-media .mk-media-gallery-grid:has(a:is(:hover, :focus-visible)) a:not(:is(:hover, :focus-visible)) img {\n    filter: var(--md-photo) saturate(0.35) brightness(0.8);\n  }\n  #site-media .mk-media-gallery-grid figcaption {\n    position: absolute;\n    inset: auto 0 0;\n    padding: 2.5rem 1rem 0.85rem;\n    background: linear-gradient(transparent, oklch(0.1 0 0 / 0.7));\n    color: oklch(0.98 0 0);\n    font: 400 1.25rem/1.1 var(--md-title);\n    translate: 0 100%;\n    transition: translate 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);\n  }\n  #site-media .mk-media-gallery-grid a:is(:hover, :focus-visible) figcaption {\n    translate: 0 0;\n  }\n  #site-media .mk-media-gallery-grid a:focus-visible {\n    outline: 2px solid var(--ring);\n    outline-offset: 3px;\n    border-radius: var(--radius);\n  }\n  /* a hovered episode: a quiet tint, never the accent */\n  #site-media .mk-playlist-item label:hover {\n    background: var(--muted);\n  }\n  /* the podcast: the cover beside the episode, the player as wide as its column */\n  #site-media .mk-audio-player[data-variant='podcast'] {\n    grid-template-columns: minmax(0, 1fr);\n    align-content: start;\n  }\n  #site-media .mk-audio-player[data-variant='podcast'] .mk-audio-player-cover {\n    width: 8rem;\n    height: 8rem;\n  }\n  #site-media .mk-audio-player-controls {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 0.5rem;\n  }\n  #site-media .mk-audio-player-controls audio {\n    flex: 1 1 14rem;\n    min-width: 0;\n  }\n  @media (prefers-reduced-motion: reduce) {\n    #site-media .mk-audio-player-cover {\n      animation: none;\n    }\n    #site-media .mk-media-gallery-grid :is(img, figcaption) {\n      transition: none;\n    }\n  }\n  /* light or dark: the Swap writes the page's dark class - every look has a light and a dark palette */\n  #site-media .site-mode {\n    flex: none;\n    border: 1px solid var(--input);\n    border-radius: var(--radius-md);\n    background: var(--background);\n    color: var(--foreground);\n  }\n  #site-media .site-mode:hover {\n    background: var(--accent);\n    color: var(--accent-foreground);\n  }\n  /* -- modes: each look in light and dark, derived from the palettes above (the other mode of each look) -- */\n  :root:not(.dark) #site-media[data-look='gallery'] {\n    --accent: oklch(0.945 0.045 32);\n    --accent-foreground: oklch(0.18 0 0);\n  }\n  .dark #site-media[data-look='gallery'] {\n    --accent: oklch(0.26 0.05 35);\n    --accent-foreground: oklch(0.95 0 0);\n  }\n  .dark #site-media[data-look='cinema'] {\n    --accent: oklch(0.24 0.05 80);\n    --accent-foreground: oklch(0.94 0.01 85);\n  }\n  :root:not(.dark) #site-media[data-look='cinema'] {\n    color-scheme: light;\n    --background: oklch(0.985 0 0);\n    --foreground: oklch(0.2 0.01 85);\n    --card: oklch(0.997 0 0);\n    --card-foreground: oklch(0.2 0.01 85);\n    --muted: oklch(0.95 0 0);\n    --muted-foreground: oklch(0.46 0.01 85);\n    --border: oklch(0.2 0.01 85 / 0.12);\n    --input: oklch(0.2 0.01 85 / 0.12);\n    --primary: oklch(0.55 0.13 80);\n    --primary-foreground: oklch(0.985 0.005 80);\n    --secondary: oklch(0.955 0 0);\n    --secondary-foreground: oklch(0.25 0.01 85);\n    --accent: oklch(0.94 0.025 80);\n    --accent-foreground: oklch(0.2 0.01 85);\n    --ring: oklch(0.57 0.13 80);\n    --md-stamp: oklch(0.57 0.13 80);\n    --popover: oklch(0.997 0 0);\n    --popover-foreground: oklch(0.2 0 0);\n  }\n  :root:not(.dark) #site-media[data-look='archive'] {\n    --accent: oklch(0.91 0.045 40);\n    --accent-foreground: oklch(0.26 0.03 50);\n  }\n  .dark #site-media[data-look='archive'] {\n    color-scheme: dark;\n    --background: oklch(0.17 0.018 78);\n    --foreground: oklch(0.94 0.03 50);\n    --card: oklch(0.205 0.014 78);\n    --card-foreground: oklch(0.94 0.03 50);\n    --muted: oklch(0.24 0.022 75);\n    --muted-foreground: oklch(0.74 0.03 55);\n    --border: oklch(0.95 0.02 50 / 0.14);\n    --input: oklch(0.95 0.02 50 / 0.14);\n    --primary: oklch(0.66 0.06 45);\n    --primary-foreground: oklch(0.17 0.03 45);\n    --secondary: oklch(0.25 0.022 75);\n    --secondary-foreground: oklch(0.9 0.03 50);\n    --accent: oklch(0.26 0.042 40);\n    --accent-foreground: oklch(0.94 0.03 50);\n    --ring: oklch(0.72 0.12 40);\n    --md-stamp: oklch(0.69 0.12 30);\n    --popover: oklch(0.215 0 0);\n    --popover-foreground: oklch(0.94 0 0);\n  }\n  /* -- modes: end -- */\n</style>\n<div id=\"site-media\" data-look=\"gallery\" data-i18n-component>\n  <div class=\"md-bar\">\n    <a class=\"md-brand\" href=\"#/\">Acme <i>Stories</i></a>\n    <div class=\"md-bar-controls\">\n      <select\n        class=\"select\"\n        data-size=\"sm\"\n        data-site-look\n        aria-label=\"Look\"\n        data-i18n-aria-label-en=\"Look\"\n        data-i18n-aria-label-de=\"Stil\"\n        style=\"width: auto\"\n      >\n        <option value=\"gallery\" data-i18n-target=\"look-gallery\">Gallery</option>\n        <option value=\"cinema\" data-i18n-target=\"look-cinema\">Cinema</option>\n        <option value=\"archive\" data-i18n-target=\"look-archive\">Archive</option>\n      </select>\n      <select\n        class=\"select\"\n        data-size=\"sm\"\n        data-app-locale\n        aria-label=\"Language\"\n        data-i18n-aria-label-en=\"Language\"\n        data-i18n-aria-label-de=\"Sprache\"\n        style=\"width: auto\"\n      >\n        <option value=\"en\" lang=\"en\">English</option>\n        <option value=\"de\" lang=\"de\">Deutsch</option>\n      </select>\n      <label class=\"swap site-mode\" data-variant=\"rotate\" data-size=\"sm\">\n        <input\n          type=\"checkbox\"\n          data-site-mode\n          aria-label=\"Dark mode\"\n          data-i18n-aria-label-en=\"Dark mode\"\n          data-i18n-aria-label-de=\"Dunkler Modus\"\n        />\n        <span class=\"swap-on\" aria-hidden=\"true\"><i data-lucide=\"moon\"></i></span>\n        <span class=\"swap-off\" aria-hidden=\"true\"><i data-lucide=\"sun\"></i></span>\n      </label>\n    </div>\n  </div>\n  <section class=\"mk-text-media md-hero\" aria-labelledby=\"tm-1\">\n    <div class=\"mk-text-media-layout\">\n      <div class=\"mk-text-media-copy\">\n        <span class=\"mk-text-media-eyebrow\" data-i18n-target=\"eyebrow\">Offline first</span>\n        <h2 class=\"mk-text-media-title\" id=\"tm-1\" data-i18n-target=\"tm-title\">Your work travels with you</h2>\n        <p class=\"mk-text-media-text\"\n          >Every change is saved on your device first and synced when you are back online - on a plane, in a tunnel, at\n          the cabin.</p\n        >\n        <ul class=\"mk-text-media-list\"\n          ><li><i data-lucide=\"check\"></i><span data-i18n-target=\"tm-wait\">Edits never wait for the network</span></li\n          ><li><i data-lucide=\"check\"></i><span data-i18n-target=\"tm-conflicts\">Conflicts resolve themselves</span></li\n          ><li><i data-lucide=\"check\"></i><span data-i18n-target=\"tm-devices\">Works on every device</span></li></ul\n        >\n        <div class=\"md-cta\">\n          <a class=\"btn\" data-size=\"lg\" href=\"#\"\n            ><span data-i18n-target=\"tm-link\">How sync works</span> <i data-lucide=\"arrow-right\"></i\n          ></a>\n          <a class=\"btn\" data-variant=\"outline\" data-size=\"lg\" href=\"#vp-title\"\n            ><i data-lucide=\"play\"></i> <span data-i18n-target=\"tm-watch\">Watch the film</span></a\n          >\n        </div>\n      </div>\n      <figure class=\"mk-text-media-media\"\n        ><img src=\"https://picsum.photos/id/48/1000/750\" alt=\"A laptop on a café table\" /><p\n          class=\"md-stamp\"\n          aria-hidden=\"true\"\n          ><span><b>LIS</b><span data-i18n-target=\"stamp\">works offline · 2026</span></span></p\n        ></figure\n      >\n    </div>\n  </section>\n  <section class=\"mk-media-gallery md-section\" aria-labelledby=\"mg-title\">\n    <div\n      class=\"shader md-grain md-look-only\"\n      data-for=\"cinema\"\n      data-variant=\"background\"\n      data-effect=\"grain-gradient\"\n      data-colors=\"oklch(0.5 0 0) oklch(0.7 0.05 80)\"\n      data-speed=\"2\"\n      data-fps=\"24\"\n      aria-hidden=\"true\"\n    ></div>\n    <header class=\"mk-media-gallery-head\">\n      <h2 id=\"mg-title\" data-i18n-target=\"mg-title\">Lisbon, autumn 2026</h2>\n      <span data-i18n-target=\"mg-count\">8 photos</span>\n      <div class=\"mk-media-gallery-tools\">\n        <div\n          class=\"mk-media-gallery-views\"\n          role=\"radiogroup\"\n          aria-label=\"Layout\"\n          data-i18n-aria-label-en=\"Layout\"\n    