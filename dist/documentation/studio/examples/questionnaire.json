[{"label":"Product feedback","html":"<form class=\"questionnaire\" id=\"q-feedback\" aria-label=\"Product feedback\" style=\"max-width: 34rem\">\n  <div class=\"questionnaire-progress\"></div>\n  <section class=\"questionnaire-block\" data-block=\"usage\" data-title=\"Your usage\">\n    <fieldset class=\"questionnaire-step\" data-step=\"often\">\n      <legend class=\"questionnaire-title\">How often do you use the app?</legend>\n      <div class=\"questionnaire-choices\">\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"often\" value=\"daily\" required /><span class=\"questionnaire-choice-label\"\n            >Every day</span\n          ></label\n        >\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"often\" value=\"weekly\" /><span class=\"questionnaire-choice-label\"\n            >Every week</span\n          ></label\n        >\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"often\" value=\"rarely\" data-goto=\"why\" /><span class=\"questionnaire-choice-label\"\n            >Rarely</span\n          ></label\n        >\n      </div>\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"features\" data-min=\"1\" data-max=\"2\" data-next=\"score\">\n      <legend class=\"questionnaire-title\">Which features do you rely on?</legend>\n      <p class=\"questionnaire-description\">Pick up to two.</p>\n      <div class=\"questionnaire-choices\">\n        <label class=\"questionnaire-choice\"\n          ><input type=\"checkbox\" name=\"features\" value=\"search\" /><span class=\"questionnaire-choice-label\"\n            >Search</span\n          ></label\n        >\n        <label class=\"questionnaire-choice\"\n          ><input type=\"checkbox\" name=\"features\" value=\"sync\" /><span class=\"questionnaire-choice-label\"\n            >Sync across devices</span\n          ></label\n        >\n        <label class=\"questionnaire-choice\"\n          ><input type=\"checkbox\" name=\"features\" value=\"share\" /><span class=\"questionnaire-choice-label\"\n            >Sharing</span\n          ></label\n        >\n        <label class=\"questionnaire-choice\"\n          ><input type=\"checkbox\" name=\"features\" value=\"offline\" /><span class=\"questionnaire-choice-label\"\n            >Offline mode</span\n          ></label\n        >\n      </div>\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"why\" data-next=\"score\">\n      <legend class=\"questionnaire-title\">What keeps you from using it more?</legend>\n      <div class=\"questionnaire-field\">\n        <label class=\"label\" for=\"q-why\">In a sentence or two</label>\n        <textarea class=\"textarea\" id=\"q-why\" name=\"why\" rows=\"3\" required minlength=\"10\"></textarea>\n      </div>\n    </fieldset>\n  </section>\n  <section class=\"questionnaire-block\" data-block=\"opinion\" data-title=\"Your opinion\">\n    <fieldset class=\"questionnaire-step\" data-step=\"score\">\n      <legend class=\"questionnaire-title\">How would you rate the app?</legend>\n      <p class=\"questionnaire-description\">Click a star - or press 1 to 5.</p>\n      <div class=\"rating\" data-size=\"lg\" role=\"radiogroup\" aria-label=\"Your rating\">\n        <label class=\"rating-item\"\n          ><input class=\"rating-input\" type=\"radio\" name=\"score\" value=\"1\" aria-label=\"1 star\" required\n        /></label>\n        <label class=\"rating-item\"\n          ><input class=\"rating-input\" type=\"radio\" name=\"score\" value=\"2\" aria-label=\"2 stars\"\n        /></label>\n        <label class=\"rating-item\"\n          ><input class=\"rating-input\" type=\"radio\" name=\"score\" value=\"3\" aria-label=\"3 stars\"\n        /></label>\n        <label class=\"rating-item\"\n          ><input class=\"rating-input\" type=\"radio\" name=\"score\" value=\"4\" aria-label=\"4 stars\"\n        /></label>\n        <label class=\"rating-item\"\n          ><input class=\"rating-input\" type=\"radio\" name=\"score\" value=\"5\" aria-label=\"5 stars\"\n        /></label>\n      </div>\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"comment\" data-optional>\n      <legend class=\"questionnaire-title\">Anything else?</legend>\n      <div class=\"questionnaire-field\">\n        <label class=\"label\" for=\"q-comment\">Comment</label>\n        <textarea class=\"textarea\" id=\"q-comment\" name=\"comment\" rows=\"3\"></textarea>\n      </div>\n    </fieldset>\n  </section>\n  <fieldset class=\"questionnaire-step\" data-step=\"review\" data-end>\n    <legend class=\"questionnaire-title\">Check your answers</legend>\n    <div class=\"questionnaire-summary\"></div>\n  </fieldset>\n  <div class=\"questionnaire-actions\">\n    <button class=\"btn\" data-variant=\"ghost\" type=\"button\" data-questionnaire=\"back\">Back</button>\n    <button class=\"btn\" data-variant=\"outline\" type=\"submit\" data-questionnaire=\"skip\">Skip</button>\n    <button class=\"btn\" type=\"submit\" data-questionnaire=\"next\">Continue</button>\n    <button class=\"btn\" type=\"submit\" data-questionnaire=\"submit\">Send feedback</button>\n  </div>\n  <div class=\"questionnaire-complete\">\n    <p class=\"questionnaire-title\">Thank you!</p>\n    <p class=\"questionnaire-description\"\n      >Your feedback goes straight to the team.\n      <button class=\"questionnaire-edit\" type=\"button\" data-questionnaire=\"restart\">Answer again</button></p\n    >\n  </div>\n</form>\n","individual":true},{"label":"Keyboard first","html":"<form\n  class=\"questionnaire\"\n  id=\"q-poll\"\n  aria-label=\"Team poll\"\n  data-shortcuts=\"digits\"\n  data-auto-advance\n  data-persist=\"none\"\n  style=\"max-width: 30rem\"\n>\n  <div class=\"questionnaire-progress\"></div>\n  <fieldset class=\"questionnaire-step\" data-step=\"lunch\">\n    <legend class=\"questionnaire-title\">Team lunch on…</legend>\n    <div class=\"questionnaire-choices\">\n      <label class=\"questionnaire-choice\"\n        ><input type=\"radio\" name=\"lunch\" value=\"thu\" required /><span class=\"questionnaire-choice-label\"\n          >Thursday</span\n        ></label\n      >\n      <label class=\"questionnaire-choice\"\n        ><input type=\"radio\" name=\"lunch\" value=\"fri\" /><span class=\"questionnaire-choice-label\">Friday</span></label\n      >\n    </div>\n  </fieldset>\n  <fieldset class=\"questionnaire-step\" data-step=\"food\">\n    <legend class=\"questionnaire-title\">…eating?</legend>\n    <div class=\"questionnaire-choices\">\n      <label class=\"questionnaire-choice\"\n        ><input type=\"radio\" name=\"food\" value=\"pizza\" required /><span class=\"questionnaire-choice-label\"\n          >Pizza</span\n        ></label\n      >\n      <label class=\"questionnaire-choice\"\n        ><input type=\"radio\" name=\"food\" value=\"ramen\" /><span class=\"questionnaire-choice-label\">Ramen</span></label\n      >\n      <label class=\"questionnaire-choice\"\n        ><input type=\"radio\" name=\"food\" value=\"salad\" /><span class=\"questionnaire-choice-label\">Salad</span></label\n      >\n    </div>\n  </fieldset>\n  <fieldset class=\"questionnaire-step\" data-step=\"done\" data-end>\n    <legend class=\"questionnaire-title\">Got it.</legend>\n    <div class=\"questionnaire-summary\"></div>\n  </fieldset>\n  <div class=\"questionnaire-actions\">\n    <button class=\"btn\" data-variant=\"ghost\" type=\"button\" data-questionnaire=\"back\">Back</button>\n    <button class=\"btn\" type=\"submit\" data-questionnaire=\"next\">Next</button>\n    <button class=\"btn\" type=\"submit\" data-questionnaire=\"submit\">Vote</button>\n  </div>\n  <div class=\"questionnaire-complete\"><p>Vote counted.</p></div>\n</form>\n","individual":true},{"label":"In a card, sending somewhere","html":"<div class=\"card\" style=\"max-width: 30rem\">\n  <div class=\"card-header\">\n    <h3 class=\"card-title\">Book a demo</h3>\n    <p class=\"card-description\">Two questions, then we call you.</p>\n  </div>\n  <div class=\"card-content\">\n    <form class=\"questionnaire\" id=\"q-demo\" aria-label=\"Book a demo\" data-persist=\"none\">\n      <fieldset class=\"questionnaire-step\" data-step=\"name\">\n        <legend class=\"questionnaire-title\">Your name?</legend>\n        <input class=\"input\" name=\"name\" required aria-label=\"Your name\" autocomplete=\"name\" />\n      </fieldset>\n      <fieldset class=\"questionnaire-step\" data-step=\"phone\">\n        <legend class=\"questionnaire-title\">Your phone number?</legend>\n        <input\n          class=\"input\"\n          name=\"phone\"\n          type=\"tel\"\n          required\n          pattern=\"[+0-9 ()-]{6,}\"\n          aria-label=\"Phone number\"\n          autocomplete=\"tel\"\n        />\n      </fieldset>\n      <fieldset class=\"questionnaire-step\" data-step=\"confirm\" data-end>\n        <legend class=\"questionnaire-title\">Shall we call?</legend>\n        <div class=\"questionnaire-summary\"></div>\n      </fieldset>\n      <div class=\"questionnaire-actions\">\n        <button class=\"btn\" data-variant=\"ghost\" type=\"button\" data-questionnaire=\"back\">Back</button>\n        <button class=\"btn\" type=\"submit\" data-questionnaire=\"next\">Next</button>\n        <button class=\"btn\" type=\"submit\" data-questionnaire=\"submit\">Call me</button>\n      </div>\n      <div class=\"questionnaire-complete\"><p>We'll call you within a day.</p></div>\n    </form>\n  </div>\n</div>\n","individual":false},{"label":"In a dialog","html":"<button class=\"btn\" type=\"button\" commandfor=\"q-dialog\" command=\"show-modal\">Report a problem</button>\n<dialog class=\"dialog\" id=\"q-dialog\" data-size=\"lg\" aria-labelledby=\"q-dialog-title\">\n  <div class=\"dialog-content\">\n    <div class=\"dialog-header\">\n      <h2 class=\"dialog-title\" id=\"q-dialog-title\">Report a problem</h2>\n    </div>\n    <form class=\"questionnaire\" id=\"q-report\" aria-labelledby=\"q-dialog-title\">\n      <div class=\"questionnaire-progress\"></div>\n      <fieldset class=\"questionnaire-step\" data-step=\"area\">\n        <legend class=\"questionnaire-title\">Where did it happen?</legend>\n        <div class=\"questionnaire-choices\">\n          <label class=\"questionnaire-choice\"\n            ><input type=\"radio\" name=\"area\" value=\"web\" required /><span class=\"questionnaire-choice-label\"\n              >The website</span\n            ></label\n          >\n          <label class=\"questionnaire-choice\"\n            ><input type=\"radio\" name=\"area\" value=\"app\" /><span class=\"questionnaire-choice-label\"\n              >The mobile app</span\n            ></label\n          >\n        </div>\n      </fieldset>\n      <fieldset class=\"questionnaire-step\" data-step=\"what\">\n        <legend class=\"questionnaire-title\">What went wrong?</legend>\n        <textarea class=\"textarea\" name=\"what\" rows=\"3\" required aria-label=\"What went wrong\"></textarea>\n      </fieldset>\n      <fieldset class=\"questionnaire-step\" data-step=\"send\" data-end>\n        <legend class=\"questionnaire-title\">Send this report?</legend>\n        <div class=\"questionnaire-summary\"></div>\n      </fieldset>\n      <div class=\"questionnaire-actions\">\n        <button class=\"btn\" data-variant=\"ghost\" type=\"button\" data-questionnaire=\"back\">Back</button>\n        <button class=\"btn\" type=\"submit\" data-questionnaire=\"next\">Next</button>\n        <button class=\"btn\" type=\"submit\" data-questionnaire=\"submit\">Send report</button>\n      </div>\n    </form>\n  </div>\n</dialog>\n","individual":false}]
