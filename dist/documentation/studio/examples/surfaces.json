[{"label":"Every combination","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <form id=\"lab\" class=\"shader-controls\" aria-label=\"Surface controls\">\n    <div class=\"shader-controls-field\">\n      <label class=\"label\" for=\"lab-backend\">Backend</label>\n      <div class=\"shader-controls-cycle\" role=\"group\" aria-label=\"Backend\">\n        <button\n          type=\"button\"\n          class=\"btn\"\n          data-variant=\"outline\"\n          data-size=\"icon-sm\"\n          data-step=\"-1\"\n          aria-label=\"Previous backend\"\n        >\n          <i data-lucide=\"chevron-left\" aria-hidden=\"true\"></i>\n        </button>\n        <select class=\"select\" id=\"lab-backend\">\n          <option value=\"shader\" selected>Shader - the surface effect</option>\n          <option value=\"css\">CSS - the Surface component</option>\n        </select>\n        <button\n          type=\"button\"\n          class=\"btn\"\n          data-variant=\"outline\"\n          data-size=\"icon-sm\"\n          data-step=\"1\"\n          aria-label=\"Next backend\"\n        >\n          <i data-lucide=\"chevron-right\" aria-hidden=\"true\"></i>\n        </button>\n      </div>\n    </div>\n    <div class=\"shader-controls-field\">\n      <label class=\"label\" for=\"lab-pattern\">Pattern</label>\n      <div class=\"shader-controls-cycle\" role=\"group\" aria-label=\"Pattern\">\n        <button\n          type=\"button\"\n          class=\"btn\"\n          data-variant=\"outline\"\n          data-size=\"icon-sm\"\n          data-step=\"-1\"\n          aria-label=\"Previous pattern\"\n        >\n          <i data-lucide=\"chevron-left\" aria-hidden=\"true\"></i>\n        </button>\n        <select class=\"select\" id=\"lab-pattern\"></select>\n        <button\n          type=\"button\"\n          class=\"btn\"\n          data-variant=\"outline\"\n          data-size=\"icon-sm\"\n          data-step=\"1\"\n          aria-label=\"Next pattern\"\n        >\n          <i data-lucide=\"chevron-right\" aria-hidden=\"true\"></i>\n        </button>\n      </div>\n    </div>\n    <div class=\"shader-controls-field\">\n      <label class=\"label\" for=\"lab-material\">Material</label>\n      <div class=\"shader-controls-cycle\" role=\"group\" aria-label=\"Material\">\n        <button\n          type=\"button\"\n          class=\"btn\"\n          data-variant=\"outline\"\n          data-size=\"icon-sm\"\n          data-step=\"-1\"\n          aria-label=\"Previous material\"\n        >\n          <i data-lucide=\"chevron-left\" aria-hidden=\"true\"></i>\n        </button>\n        <select class=\"select\" id=\"lab-material\"></select>\n        <button\n          type=\"button\"\n          class=\"btn\"\n          data-variant=\"outline\"\n          data-size=\"icon-sm\"\n          data-step=\"1\"\n          aria-label=\"Next material\"\n        >\n          <i data-lucide=\"chevron-right\" aria-hidden=\"true\"></i>\n        </button>\n      </div>\n    </div>\n    <div class=\"shader-controls-field\">\n      <label class=\"label\" for=\"lab-projection\">Projection</label>\n      <div class=\"shader-controls-cycle\" role=\"group\" aria-label=\"Projection\">\n        <button\n          type=\"button\"\n          class=\"btn\"\n          data-variant=\"outline\"\n          data-size=\"icon-sm\"\n          data-step=\"-1\"\n          aria-label=\"Previous projection\"\n        >\n          <i data-lucide=\"chevron-left\" aria-hidden=\"true\"></i>\n        </button>\n        <select class=\"select\" id=\"lab-projection\"></select>\n        <button\n          type=\"button\"\n          class=\"btn\"\n          data-variant=\"outline\"\n          data-size=\"icon-sm\"\n          data-step=\"1\"\n          aria-label=\"Next projection\"\n        >\n          <i data-lucide=\"chevron-right\" aria-hidden=\"true\"></i>\n        </button>\n      </div>\n    </div>\n    <div class=\"shader-controls-field\">\n      <label class=\"label\" for=\"lab-motion\">Motion</label>\n      <div class=\"shader-controls-cycle\" role=\"group\" aria-label=\"Motion\">\n        <button\n          type=\"button\"\n          class=\"btn\"\n          data-variant=\"outline\"\n          data-size=\"icon-sm\"\n          data-step=\"-1\"\n          aria-label=\"Previous motion\"\n        >\n          <i data-lucide=\"chevron-left\" aria-hidden=\"true\"></i>\n        </button>\n        <select class=\"select\" id=\"lab-motion\"></select>\n        <button\n          type=\"button\"\n          class=\"btn\"\n          data-variant=\"outline\"\n          data-size=\"icon-sm\"\n          data-step=\"1\"\n          aria-label=\"Next motion\"\n        >\n          <i data-lucide=\"chevron-right\" aria-hidden=\"true\"></i>\n        </button>\n      </div>\n    </div>\n    <div class=\"shader-controls-field\">\n      <div class=\"shader-controls-head\">\n        <label class=\"label\" for=\"lab-scale\">Scale</label>\n        <output class=\"slider-value\" for=\"lab-scale\">8</output>\n      </div>\n      <input class=\"slider\" type=\"range\" id=\"lab-scale\" min=\"2\" max=\"20\" step=\"1\" value=\"8\" />\n    </div>\n    <div class=\"shader-controls-field\">\n      <div class=\"shader-controls-head\">\n        <label class=\"label\" for=\"lab-light\">Light</label>\n        <output class=\"slider-value\" for=\"lab-light\">135°</output>\n      </div>\n      <input\n        class=\"slider\"\n        type=\"range\"\n        id=\"lab-light\"\n        min=\"0\"\n        max=\"360\"\n        step=\"5\"\n        value=\"135\"\n        data-unit=\"degree\"\n        data-unit-display=\"narrow\"\n      />\n    </div>\n    <div class=\"shader-controls-field\">\n      <div class=\"shader-controls-head\">\n        <label class=\"label\" for=\"lab-elevation\">Elevation</label>\n        <output class=\"slider-value\" for=\"lab-elevation\">45°</output>\n      </div>\n      <input\n        class=\"slider\"\n        type=\"range\"\n        id=\"lab-elevation\"\n        min=\"5\"\n        max=\"85\"\n        step=\"1\"\n        value=\"45\"\n        data-unit=\"degree\"\n        data-unit-display=\"narrow\"\n      />\n    </div>\n    <div class=\"shader-controls-field\">\n      <div class=\"shader-controls-head\">\n        <label class=\"label\" for=\"lab-speed\">Speed</label>\n        <output class=\"slider-value\" for=\"lab-speed\">1</output>\n      </div>\n      <input class=\"slider\" type=\"range\" id=\"lab-speed\" min=\"0\" max=\"3\" step=\"0.05\" value=\"1\" />\n    </div>\n    <div class=\"shader-controls-field\">\n      <div class=\"shader-controls-head\">\n        <label class=\"label\" for=\"lab-direction\">Direction</label>\n        <output class=\"slider-value\" for=\"lab-direction\">30°</output>\n      </div>\n      <input\n        class=\"slider\"\n        type=\"range\"\n        id=\"lab-direction\"\n        min=\"0\"\n        max=\"360\"\n        step=\"5\"\n        value=\"30\"\n        data-unit=\"degree\"\n        data-unit-display=\"narrow\"\n      />\n    </div>\n    <div class=\"shader-controls-field\">\n      <div class=\"shader-controls-head\">\n        <label class=\"label\" for=\"lab-rotation\">Rotation</label>\n        <output class=\"slider-value\" for=\"lab-rotation\">0°</output>\n      </div>\n      <input\n        class=\"slider\"\n        type=\"range\"\n        id=\"lab-rotation\"\n        min=\"0\"\n        max=\"360\"\n        step=\"5\"\n        value=\"0\"\n        data-unit=\"degree\"\n        data-unit-display=\"narrow\"\n      />\n    </div>\n    <div class=\"shader-controls-field\">\n      <span class=\"label\" id=\"lab-colors-label\">Colors - surface, ink, accent</span>\n      <div class=\"shader-controls-colors\" role=\"group\" aria-labelledby=\"lab-colors-label\">\n        <input type=\"color\" id=\"lab-c0\" value=\"#dfe7ef\" aria-label=\"Surface color\" />\n        <input type=\"color\" id=\"lab-c1\" value=\"#2a9d8f\" aria-label=\"Ink color\" />\n        <input type=\"color\" id=\"lab-c2\" value=\"#e9c46a\" aria-label=\"Accent color\" />\n      </div>\n    </div>\n    <button class=\"btn\" type=\"button\" id=\"lab-random\" data-variant=\"outline\">Surprise me</button>\n  </form>\n  <div class=\"grid gap-3\" style=\"align-content: start\">\n    <div\n      class=\"shader\"\n      id=\"lab-shader\"\n      data-effect=\"surface\"\n      data-pattern=\"cubes\"\n      data-material=\"ceramic\"\n      data-projection=\"floor\"\n      data-motion=\"drift\"\n      data-colors=\"#dfe7ef #2a9d8f #e9c46a\"\n      data-interactive\n      aria-hidden=\"true\"\n      style=\"border-radius: var(--radius)\"\n    ></div>\n    <div\n      class=\"surface\"\n      id=\"lab-css\"\n      data-pattern=\"hex\"\n      hidden\n      aria-hidden=\"true\"\n      style=\"border-radius: var(--radius)\"\n    ></div>\n    <pre\n      id=\"lab-code\"\n      class=\"m-0 overflow-x-auto\"\n      style=\"padding: 0.75rem 1rem; border-radius: var(--radius); background: var(--muted); font: 0.75rem/1.5 var(--font-mono)\"\n    ></pre>\n  </div>\n</div>\n","individual":false}]
