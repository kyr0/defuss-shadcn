[{"label":"Kbd","html":"<kbd class=\"kbd\">Esc</kbd>\n","individual":true},{"label":"Kbd (sm)","html":"<kbd class=\"kbd\" data-size=\"sm\">Esc</kbd>\n","individual":true},{"label":"Kbd (lg)","html":"<kbd class=\"kbd\" data-size=\"lg\">Esc</kbd>\n","individual":true},{"label":"Keys","html":"<div class=\"flex flex-wrap items-center gap-2\">\n  <kbd class=\"kbd\">Esc</kbd>\n  <kbd class=\"kbd\">Enter</kbd>\n  <kbd class=\"kbd\">⇧</kbd>\n  <kbd class=\"kbd\">⌥</kbd>\n  <kbd class=\"kbd\">Tab</kbd>\n  <kbd class=\"kbd\">?</kbd>\n</div>\n","individual":false},{"label":"Combination","html":"<div class=\"flex flex-wrap items-center gap-5\">\n  <kbd class=\"kbd-group\">\n    <kbd class=\"kbd\">⌘</kbd>\n    <kbd class=\"kbd\">K</kbd>\n  </kbd>\n  <kbd class=\"kbd-group\">\n    <kbd class=\"kbd\">⌘</kbd>\n    <kbd class=\"kbd\">⇧</kbd>\n    <kbd class=\"kbd\">P</kbd>\n  </kbd>\n</div>\n","individual":false},{"label":"With a separator","html":"<kbd class=\"kbd-group\" data-separator>\n  <kbd class=\"kbd\">Ctrl</kbd>\n  <kbd class=\"kbd\">Shift</kbd>\n  <kbd class=\"kbd\">P</kbd>\n</kbd>\n","individual":false},{"label":"Sizes","html":"<div class=\"flex items-center gap-3\">\n  <kbd class=\"kbd\" data-size=\"sm\">Esc</kbd>\n  <kbd class=\"kbd\">Esc</kbd>\n  <kbd class=\"kbd\" data-size=\"lg\">Esc</kbd>\n</div>\n","individual":false},{"label":"In a control","html":"<div class=\"flex flex-wrap items-center gap-3\">\n  <button class=\"btn\" data-variant=\"outline\" data-action=\"k\"\n    >Search <kbd class=\"kbd\" data-size=\"sm\" data-shortcut=\"k\">⌘K</kbd></button\n  >\n  <button class=\"btn\" data-variant=\"default\" data-action=\"s\"\n    >Save <kbd class=\"kbd\" data-size=\"sm\" data-shortcut=\"s\">⌘S</kbd></button\n  >\n  <button class=\"btn\" data-variant=\"ghost\" data-action=\"z\"\n    >Undo <kbd class=\"kbd\" data-size=\"sm\" data-shortcut=\"z\">⌘Z</kbd></button\n  >\n</div>\n<output id=\"kbd-control-log\" class=\"text-sm text-muted-foreground\" style=\"display: block; margin-top: 0.75rem\"\n  >Click into the preview, then press ⌘K, ⌘S or ⌘Z.</output\n>\n","individual":false},{"label":"In prose","html":"<p class=\"p\" style=\"max-width: 28rem\">\n  Press\n  <kbd class=\"kbd-group\"><kbd class=\"kbd\" data-shortcut=\"k\">⌘</kbd><kbd class=\"kbd\" data-shortcut=\"k\">K</kbd></kbd> to\n  open the command palette, or <kbd class=\"kbd\" data-shortcut=\"escape\">Esc</kbd> to dismiss it.\n</p>\n<dialog id=\"kbd-prose-palette\" class=\"command\" aria-label=\"Command palette\">\n  <div class=\"command-content\">\n    <div class=\"command-input-wrapper\">\n      <svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        aria-hidden=\"true\"\n      >\n        <circle cx=\"11\" cy=\"11\" r=\"8\"></circle>\n        <path d=\"m21 21-4.3-4.3\"></path>\n      </svg>\n      <input class=\"command-input\" type=\"text\" placeholder=\"Type a command…\" autocomplete=\"off\" spellcheck=\"false\" />\n    </div>\n    <div class=\"command-list\">\n      <div class=\"command-group\">\n        <p class=\"command-group-heading\">Suggestions</p>\n        <button class=\"command-item\">New document</button>\n        <button class=\"command-item\">Search files</button>\n        <button class=\"command-item\">Settings</button>\n      </div>\n    </div>\n    <div class=\"command-empty\" hidden>No results found.</div>\n  </div>\n</dialog>\n","individual":false},{"label":"In a menu","html":"<div class=\"flex flex-wrap items-center gap-3\">\n  <button class=\"btn\" data-variant=\"outline\" data-dropdown-trigger=\"kbd-menu\">Edit</button>\n  <span id=\"kbd-tags\" class=\"flex flex-wrap gap-2\"></span>\n</div>\n<div id=\"kbd-menu\" role=\"menu\" popover class=\"dropdown-content\" aria-label=\"Edit\" style=\"min-width: 13rem\">\n  <button role=\"menuitem\" class=\"dropdown-item\" tabindex=\"-1\" data-edit=\"undo\"\n    >Undo\n    <span class=\"dropdown-shortcut\"\n      ><kbd class=\"kbd-group\"\n        ><kbd class=\"kbd\" data-size=\"sm\" data-shortcut=\"undo\">⌘</kbd\n        ><kbd class=\"kbd\" data-size=\"sm\" data-shortcut=\"undo\">Z</kbd></kbd\n      ></span\n    ></button\n  >\n  <button role=\"menuitem\" class=\"dropdown-item\" tabindex=\"-1\" data-edit=\"redo\"\n    >Redo\n    <span class=\"dropdown-shortcut\"\n      ><kbd class=\"kbd-group\"\n        ><kbd class=\"kbd\" data-size=\"sm\" data-shortcut=\"redo\">⌘</kbd\n        ><kbd class=\"kbd\" data-size=\"sm\" data-shortcut=\"redo\">⇧</kbd\n        ><kbd class=\"kbd\" data-size=\"sm\" data-shortcut=\"redo\">Z</kbd></kbd\n      ></span\n    ></button\n  >\n  <div class=\"dropdown-separator\" role=\"separator\"></div>\n  <button role=\"menuitem\" class=\"dropdown-item\" data-variant=\"destructive\" tabindex=\"-1\" data-edit=\"delete\"\n    >Delete\n    <span class=\"dropdown-shortcut\"><kbd class=\"kbd\" data-size=\"sm\" data-shortcut=\"delete\">⌫</kbd></span></button\n  >\n</div>\n<output id=\"kbd-menu-log\" class=\"text-sm text-muted-foreground\" style=\"display: block; margin-top: 0.75rem\"\n  >Click into the preview, then press ⌫, ⌘Z or ⌘⇧Z.</output\n>\n","individual":false},{"label":"In a tooltip","html":"<div class=\"flex flex-wrap items-center gap-3\">\n  <button class=\"btn\" data-variant=\"outline\" data-tooltip-trigger=\"kbd-tip\" aria-pressed=\"false\" id=\"kbd-bold\"\n    >Bold</button\n  >\n  <p class=\"p\" id=\"kbd-bold-text\" style=\"margin: 0\">The quick brown fox jumps over the lazy dog.</p>\n</div>\n<div class=\"tooltip\" id=\"kbd-tip\" popover=\"hint\" role=\"tooltip\"\n  >Bold\n  <kbd class=\"kbd-group\"\n    ><kbd class=\"kbd\" data-size=\"sm\" data-shortcut=\"b\">⌘</kbd\n    ><kbd class=\"kbd\" data-size=\"sm\" data-shortcut=\"b\">B</kbd></kbd\n  ></div\n>\n","individual":false},{"label":"Decorative shortcuts","html":"<button class=\"btn\" data-variant=\"secondary\" data-command-trigger=\"kbd-palette\"\n  >Open command palette <kbd class=\"kbd\" data-size=\"sm\" aria-hidden=\"true\">⌘K</kbd></button\n>\n<dialog id=\"kbd-palette\" class=\"command\" aria-label=\"Command palette\">\n  <div class=\"command-content\">\n    <div class=\"command-input-wrapper\">\n      <svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        aria-hidden=\"true\"\n      >\n        <circle cx=\"11\" cy=\"11\" r=\"8\"></circle>\n        <path d=\"m21 21-4.3-4.3\"></path>\n      </svg>\n      <input class=\"command-input\" type=\"text\" placeholder=\"Type a command…\" autocomplete=\"off\" spellcheck=\"false\" />\n    </div>\n    <div class=\"command-list\">\n      <div class=\"command-group\">\n        <p class=\"command-group-heading\">Suggestions</p>\n        <button class=\"command-item\">New document</button>\n        <button class=\"command-item\">Search files</button>\n        <button class=\"command-item\">Settings</button>\n      </div>\n    </div>\n    <div class=\"command-empty\" hidden>No results found.</div>\n  </div>\n</dialog>\n","individual":false}]
