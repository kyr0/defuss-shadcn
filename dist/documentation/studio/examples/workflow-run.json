[{"label":"Run in the page","html":"<div class=\"grid gap-2\">\n  <div class=\"flex flex-wrap items-center gap-2\">\n    <button class=\"btn\" data-size=\"sm\" type=\"button\" data-workflow-for=\"numbers\" data-workflow-action=\"run\">Run</button>\n    <button\n      class=\"btn\"\n      data-variant=\"outline\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"numbers\"\n      data-workflow-action=\"cancel\"\n      >Cancel</button\n    >\n    <span class=\"text-sm text-muted-foreground\" id=\"numbers-log\">Not run yet</span>\n  </div>\n  <div class=\"workflow\" id=\"numbers\" aria-label=\"A numbers pipeline\" style=\"--workflow-height: 24rem\"></div>\n</div>\n","individual":false},{"label":"A pretend remote runner","html":"<div class=\"grid gap-2\">\n  <div class=\"flex flex-wrap items-center gap-2\">\n    <button class=\"btn\" data-size=\"sm\" type=\"button\" data-workflow-for=\"remote\" data-workflow-action=\"run\"\n      >Send to the runner</button\n    >\n    <button\n      class=\"btn\"\n      data-variant=\"outline\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"remote\"\n      data-workflow-action=\"cancel\"\n      >Cancel</button\n    >\n  </div>\n  <div\n    class=\"workflow\"\n    id=\"remote\"\n    data-generate=\"9\"\n    data-edges=\"14\"\n    data-seed=\"2\"\n    data-stage=\"3\"\n    aria-label=\"A remote run\"\n    style=\"--workflow-height: 28rem\"\n  ></div>\n  <pre class=\"text-xs m-0\" style=\"max-block-size: 8rem; overflow: auto\" id=\"remote-log\"></pre>\n</div>\n","individual":false}]
