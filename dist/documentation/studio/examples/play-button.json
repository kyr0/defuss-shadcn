n</div>\n","individual":false},{"label":"Variants","html":"<div class=\"flex flex-wrap items-center gap-4\">\n  <button class=\"play-button\" type=\"button\" aria-label=\"Play\"></button>\n  <button class=\"play-button\" type=\"button\" data-variant=\"secondary\" aria-label=\"Play (secondary)\"></button>\n  <button class=\"play-button\" type=\"button\" data-variant=\"outline\" aria-label=\"Play (outline)\"></button>\n  <div\n    class=\"grid place-items-center\"\n    style=\"\n      inline-size: 14rem;\n      aspect-ratio: 16/9;\n      border-radius: var(--radius-lg);\n      background: url(images/mk-wide3.png) center/cover;\n    \"\n  >\n    <button class=\"play-button\" type=\"button\" data-variant=\"glass\" aria-label=\"Play the trailer\"></button>\n  </div>\n</div>\n","individual":false},{"label":"In a teaser","html":"<section class=\"teaser\" data-ratio=\"16/9\" aria-label=\"The product tour\">\n  <img class=\"teaser-media\" src=\"images/mk-wide3.png\" alt=\"\" />\n  <button\n    class=\"play-button\"\n    type=\"button\"\n    data-variant=\"glass\"\n    data-size=\"lg\"\n    aria-label=\"Play the product tour\"\n  ></button>\n  <p class=\"teaser-title\">The product tour</p>\n  <template class=\"teaser-content\">\n    <video\n      src=\"videos/demo.mp4\"\n      controls\n      autoplay\n      playsinline\n      style=\"inline-size: 100%; display: block; border-radius: var(--radius-xl)\"\n    ></video>\n  </template>\n</section>\n","individual":false}]
