[{"label":"A news front","html":"<style>\n  @import url('https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;500;600;700;800&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;0,6..72,700;1,6..72,400&family=UnifrakturMaguntia&family=Anton&display=swap');\n  /* A daily paper on a 78rem page: the edition bar, a blackletter nameplate with two ears, the section row between\n     rules, the breaking ticker, the lead story beside the latest headlines, then the story rows. Serif headlines\n     (Newsreader), a grotesque for everything around them (Libre Franklin), one red for the paper's voice. Looks:\n     Broadsheet (newsprint, follows light / dark), Evening edition (navy and amber) and Tabloid (white, red, Anton). */\n  #site-news {\n    --background: oklch(0.968 0.006 85);\n    --foreground: oklch(0.17 0.008 80);\n    --card: oklch(0.985 0.004 85);\n    --card-foreground: var(--foreground);\n    --muted: oklch(0.925 0.008 85);\n    --muted-foreground: oklch(0.43 0.012 80);\n    --border: oklch(0.17 0.008 80 / 0.16);\n    --input: oklch(0.17 0.008 80 / 0.28);\n    --primary: oklch(0.5 0.18 27);\n    --primary-foreground: oklch(0.985 0.004 85);\n    --secondary: oklch(0.925 0.008 85);\n    --secondary-foreground: var(--foreground);\n    --accent: oklch(0.925 0.008 85);\n    --accent-foreground: var(--foreground);\n    --ring: var(--primary);\n    --radius: 0rem;\n    --radius-sm: 0rem;\n    --radius-md: 0rem;\n    --radius-lg: 0rem;\n    --radius-xl: 0rem;\n    --news-plate: 'UnifrakturMaguntia', var(--font-serif);\n    --news-head: 'Newsreader', Georgia, serif;\n    --news-sans: 'Libre Franklin', var(--font-sans);\n    --news-body: 'Newsreader', Georgia, serif;\n    --news-rule: var(--foreground);\n    --news-ink: var(--primary);\n    container-type: inline-size;\n    color-scheme: light;\n    box-sizing: border-box;\n    display: flex;\n    flex-direction: column;\n    gap: clamp(1.25rem, 2.5vw, 2rem);\n    width: 100%;\n    padding: 0 clamp(1rem, 4vw, 2.5rem) clamp(2.5rem, 6vw, 4.5rem);\n    background: var(--background);\n    color: var(--foreground);\n    font: 400 1rem/1.5 var(--news-sans);\n  }\n  #site-news > * {\n    box-sizing: border-box;\n    width: 100%;\n    max-width: 78rem;\n    margin-inline: auto;\n  }\n  .dark #site-news[data-look='broadsheet'] {\n    color-scheme: dark;\n    --background: oklch(0.19 0.006 80);\n    --foreground: oklch(0.93 0.008 85);\n    --card: oklch(0.22 0.006 80);\n    --muted: oklch(0.26 0.008 80);\n    --muted-foreground: oklch(0.72 0.012 85);\n    --border: oklch(0.93 0.008 85 / 0.16);\n    --input: oklch(0.93 0.008 85 / 0.28);\n    --primary: oklch(0.68 0.17 27);\n    --primary-foreground: oklch(0.16 0.006 80);\n    --secondary: oklch(0.26 0.008 80);\n    --accent: oklch(0.26 0.008 80);\n  }\n  #site-news[data-look='evening'] {\n    color-scheme: dark;\n    --background: oklch(0.2 0.03 258);\n    --foreground: oklch(0.94 0.012 85);\n    --card: oklch(0.235 0.032 258);\n    --muted: oklch(0.27 0.032 258);\n    --muted-foreground: oklch(0.76 0.025 250);\n    --border: oklch(0.94 0.012 85 / 0.16);\n    --input: oklch(0.94 0.012 85 / 0.3);\n    --primary: oklch(0.8 0.13 75);\n    --primary-foreground: oklch(0.2 0.03 258);\n    --secondary: oklch(0.27 0.032 258);\n    --accent: oklch(0.27 0.032 258);\n    --accent-foreground: var(--foreground);\n  }\n  #site-news[data-look='tabloid'] {\n    color-scheme: light;\n    --background: oklch(0.995 0 0);\n    --foreground: oklch(0.13 0 0);\n    --card: oklch(1 0 0);\n    --muted: oklch(0.95 0 0);\n    --muted-foreground: oklch(0.38 0 0);\n    --border: oklch(0.13 0 0 / 0.18);\n    --primary: oklch(0.56 0.22 27);\n    --primary-foreground: oklch(0.995 0 0);\n    --news-plate: 'Anton', Impact, sans-serif;\n    --news-head: 'Anton', Impact, sans-serif;\n    --news-body: 'Libre Franklin', var(--font-sans);\n    --news-ink: var(--foreground);\n  }\n  /* the edition bar: the city edition on the left, the look and the language on the right */\n  #site-news .news-bar {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    justify-content: space-between;\n    gap: 0.75rem 1.5rem;\n    padding-block: 0.875rem;\n    font-size: 0.8125rem;\n    color: var(--muted-foreground);\n  }\n  #site-news .news-bar-controls {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.5rem;\n  }\n  #site-news .news-bar .select {\n    width: auto;\n    min-width: 8.5rem;\n  }\n  /* the masthead: the folio line, the nameplate between its ears, the sections between rules */\n  #site-news .mk-news-header[data-variant='masthead'] {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);\n    align-items: center;\n    column-gap: 2rem;\n    row-gap: 0;\n    max-width: 78rem;\n    padding: 0;\n    border-block-start: 3px solid var(--news-rule);\n  }\n  #site-news .mk-news-header[data-variant='masthead'] > :not(.news-ear, .mk-news-header-title) {\n    grid-column: 1 / -1;\n  }\n  #site-news .mk-news-header[data-variant='masthead'] .mk-news-header-top {\n    padding-block: 0.625rem;\n    border-block: 0;\n    border-block-end: 1px solid var(--border);\n    font-size: 0.75rem;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n  }\n  #site-news .mk-news-header-kicker {\n    color: var(--foreground);\n    font-weight: 700;\n  }\n  #site-news .mk-news-header[data-variant='masthead'] .mk-news-header-title {\n    grid-column: 2;\n    grid-row: 2;\n    margin: 0;\n    padding-block: clamp(1rem, 2.5vw, 1.75rem);\n    font-family: var(--news-plate);\n    font-weight: 400;\n    font-size: clamp(2.75rem, 7.5vw, 5.75rem);\n    line-height: 1;\n    letter-spacing: 0;\n    white-space: nowrap;\n  }\n  /* the ears: weather and price, set like the paper's small print - no boxes */\n  #site-news .news-ear {\n    grid-row: 2;\n    justify-self: start;\n    display: grid;\n    gap: 0.25rem;\n    max-width: 15rem;\n    margin: 0;\n    padding-inline-start: 0.875rem;\n    border-inline-start: 2px solid var(--news-ink);\n    font-size: 0.8125rem;\n    line-height: 1.4;\n    color: var(--muted-foreground);\n    text-align: start;\n    text-wrap: balance;\n  }\n  #site-news .news-ear:last-of-type {\n    grid-column: 3;\n    justify-self: end;\n    padding-inline: 0 0.875rem;\n    border-inline: 0 2px solid var(--news-ink);\n    text-align: end;\n  }\n  #site-news .news-ear b {\n    font: 700 1.25rem/1.1 var(--news-head);\n    color: var(--foreground);\n  }\n  #site-news .mk-news-header[data-variant='masthead'] .mk-news-header-topics {\n    gap: 0.25rem 1.75rem;\n    border-block: 1px solid var(--news-rule);\n    box-shadow: inset 0 -3px 0 -2px var(--news-rule);\n    padding-block: 0.125rem 0.25rem;\n  }\n  #site-news .mk-news-header[data-variant='masthead'] .mk-news-header-topics a {\n    padding-block: 0.625rem;\n    font-size: 0.9375rem;\n    font-weight: 600;\n    color: var(--foreground);\n  }\n  #site-news .mk-news-header[data-variant='masthead'] .mk-news-header-topics a[aria-current] {\n    text-decoration: underline 2px var(--primary);\n    text-underline-offset: 0.45em;\n  }\n  #site-news[data-look='tabloid'] .mk-news-header[data-variant='masthead'] .mk-news-header-title {\n    justify-self: center;\n    padding: 0.12em 0.4em 0.08em;\n    margin-block: 1.25rem;\n    background: var(--primary);\n    color: var(--primary-foreground);\n    text-transform: uppercase;\n  }\n  /* the ticker: a solid label, the headlines between hairlines */\n  #site-news .mk-news-ticker {\n    border: 0;\n    border-block: 1px solid var(--border);\n    border-radius: 0;\n    background: transparent;\n    color: var(--foreground);\n    font-size: 0.9375rem;\n  }\n  #site-news .mk-news-ticker[data-variant='breaking'] .mk-news-ticker-label {\n    padding-inline: 1rem;\n    background: var(--primary);\n    color: var(--primary-foreground);\n    font-size: 0.75rem;\n    font-weight: 800;\n    letter-spacing: 0.1em;\n  }\n  #site-news .mk-news-ticker-items a {\n    color: inherit;\n  }\n  /* the front: the lead story beside the latest headlines and the numbers, a column rule between */\n  #site-news .news-front {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr);\n    gap: 2rem;\n    align-items: start;\n  }\n  @container (width > 56rem) {\n    #site-news .news-front {\n      grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr);\n      gap: 2.75rem;\n    }\n    #site-news .news-front > * + * {\n      border-inline-start: 1px solid var(--border);\n      padding-inline-start: 2.75rem;\n    }\n  }\n  #site-news .mk-news-item {\n    border-color: var(--border);\n  }\n  #site-news .mk-news-item-category {\n    color: var(--primary);\n    font-weight: 700;\n    letter-spacing: 0.06em;\n  }\n  #site-news .mk-news-item-meta {\n    font-size: 0.75rem;\n  }\n  #site-news .mk-news-item-title {\n    font-family: var(--news-head);\n    font-weight: 600;\n    letter-spacing: -0.005em;\n    text-wrap: balance;\n  }\n  #site-news .mk-news-item-title a {\n    color: inherit;\n  }\n  #site-news .mk-news-item[data-variant='lead'] {\n    gap: 1.25rem;\n    padding-block-end: 0;\n    border: 0;\n  }\n  #site-news .mk-news-item[data-variant='lead'] .mk-news-item-body {\n    gap: 0.75rem;\n  }\n  #site-news .mk-news-item[data-variant='lead'] .mk-news-item-title {\n    font-size: clamp(2rem, 4.2vw, 3.25rem);\n    font-weight: 700;\n    line-height: 1.04;\n    letter-spacing: -0.02em;\n  }\n  #site-news .mk-news-item[data-variant='lead'] .mk-news-item-summary {\n    max-width: 40rem;\n    font: 400 clamp(1.0625rem, 1.6vw, 1.25rem)/1.5 var(--news-body);\n    color: var(--muted-foreground);\n  }\n  #site-news .news-byline {\n    margin: 0;\n    font-size: 0.8125rem;\n    color: var(--muted-foreground);\n  }\n  #site-news .news-byline b {\n    color: var(--foreground);\n    font-weight: 600;\n  }\n  #site-news[data-look='tabloid'] .mk-news-item-title {\n    font-weight: 400;\n    text-transform: uppercase;\n    letter-spacing: 0.005em;\n    line-height: 1;\n  }\n  /* the lead photo, screened in halftone - the paper's ink on the paper */\n  #site-news .mk-news-item[data-variant='lead'] .mk-news-item-media {\n    order: 1;\n    aspect-ratio: auto;\n    overflow: visible;\n    background: none;\n  }\n  #site-news .news-screen {\n    --shader-aspect: 16 / 9;\n    display: block;\n    width: 100%;\n  }\n  #site-news .news-credit {\n    margin: 0.5rem 0 0;\n    font-size: 0.6875rem;\n    letter-spacing: 0.06em;\n    text-align: end;\n    text-transform: uppercase;\n    color: var(--muted-foreground);\n  }\n  /* the column: section labels on a heavy rule */\n  #site-news .news-label {\n    margin: 0 0 0.25rem;\n    padding-block-start: 0.625rem;\n    border-block-start: 3px solid var(--news-rule);\n    font: 800 0.75rem/1.2 var(--news-sans);\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n  }\n  #site-news .mk-news-item[data-variant='compact'] .mk-news-item-title {\n    font-size: 1.0625rem;\n    font-weight: 600;\n    line-height: 1.3;\n  }\n  #site-news .mk-news-item[data-variant='compact'] .mk-news-item-meta {\n    min-width: 4.5rem;\n    color: var(--muted-foreground);\n    font-variant-numeric: tabular-nums;\n  }\n  #site-news .news-numbers {\n    margin-block-start: 2rem;\n  }\n  #site-news .news-numbers dl {\n    display: grid;\n    grid-template-columns: auto 1fr;\n    gap: 0.875rem 1rem;\n    margin: 0.875rem 0 0;\n    align-items: baseline;\n  }\n  #site-news .news-numbers dt {\n    min-width: 3.5rem;\n    font: 700 2rem/1 var(--news-head);\n    color: var(--news-ink);\n    font-variant-numeric: tabular-nums;\n  }\n  #site-news .news-numbers dd {\n    margin: 0;\n    font-size: 0.875rem;\n    line-height: 1.4;\n    color: var(--muted-foreground);\n  }\n  #site-news[data-look='tabloid'] .news-numbers dt {\n    font-weight: 400;\n    color: var(--primary);\n  }\n  /* the story rows below the fold */\n  #site-news .news-stories {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));\n    gap: 0 2.5rem;\n    padding-block-start: 0.25rem;\n    border-block-start: 3px solid var(--news-rule);\n  }\n  #site-news .news-stories .mk-news-item {\n    grid-template-columns: minmax(0, 1fr);\n    gap: 0.875rem;\n    padding-block: 1.25rem;\n    border: 0;\n  }\n  #site-news .news-stories .mk-news-item-media {\n    order: -1;\n    width: 100%;\n    aspect-ratio: 3 / 2;\n  }\n  #site-news .news-stories .mk-news-item-media img {\n    filter: grayscale(1) contrast(1.05);\n  }\n  #site-news[data-look='evening'] .news-stories .mk-news-item-media img {\n    filter: grayscale(1) sepia(0.45) hue-rotate(185deg) saturate(0.8);\n  }\n  #site-news .news-stories .mk-news-item-title {\n    font-size: 1.375rem;\n    line-height: 1.2;\n  }\n  #site-news .news-stories .mk-news-item-summary {\n    font-size: 0.9375rem;\n    line-height: 1.55;\n    color: var(--muted-foreground);\n  }\n  @container (width < 44rem) {\n    #site-news .news-ear {\n      display: none;\n    }\n    #site-news .mk-news-header[data-variant='masthead'] .mk-news-header-title {\n      grid-column: 1 / -1;\n      justify-self: center;\n      white-space: normal;\n      text-align: center;\n    }\n  }\n  /* light or dark: the Swap writes the page's dark class - every look has a light and a dark palette */\n  #site-news .site-mode {\n    flex: none;\n    border: 1px solid var(--input);\n    border-radius: var(--radius-md);\n    background: var(--background);\n    color: var(--foreground);\n  }\n  #site-news .site-mode:hover {\n    background: var(--accent);\n    color: var(--accent-foreground);\n  }\n  /* -- modes: each look in light and dark, derived from the palettes above (the other mode of each look) -- */\n  :root:not(.dark) #site-news[data-look='broadsheet'] {\n    --accent: oklch(0.923 0.008 85);\n  }\n  .dark #site-news[data-look='broadsheet'] {\n    --accent: oklch(0.28 0.008 80);\n  }\n  .dark #site-news[data-look='evening'] {\n    --accent: oklch(0.29 0.032 258);\n  }\n  :root:not(.dark) #site-news[data-look='evening'] {\n    color-scheme: light;\n    --background: oklch(0.985 0.025 258);\n    --foreground: oklch(0.2 0.012 85);\n    --card: oklch(0.997 0.025 258);\n    --card-foreground: oklch(0.2 0.012 85);\n    --muted: oklch(0.95 0.025 258);\n    --muted-foreground: oklch(0.46 0.025 250);\n    --border: oklch(0.2 0.012 85 / 0.12);\n    --input: oklch(0.2 0.012 85 / 0.12);\n    --primary: oklch(0.55 0.13 75);\n    --primary-foreground: oklch(0.985 0.005 75);\n    --secondary: oklch(0.955 0.025 258);\n    --secondary-foreground: oklch(0.25 0.012 85);\n    --accent: oklch(0.94 0.025 258);\n    --accent-foreground: oklch(0.2 0.012 85);\n    --ring: oklch(0.55 0.13 75);\n    --news-rule: oklch(0.218 0.012 85);\n    --news-ink: oklch(0.55 0.13 75);\n    --popover: oklch(0.997 0 0);\n    --popover-foreground: oklch(0.2 0 0);\n  }\n  :root:not(.dark) #site-news[data-look='tabloid'] {\n    --accent: oklch(0.95 0.008 0);\n  }\n  .dark #site-news[data-look='tabloid'] {\n    color-scheme: dark;\n    --background: oklch(0.17 0 0);\n    --foreground: oklch(0.94 0 0);\n    --card: oklch(0.205 0 0);\n    --card-foreground: oklch(0.94 0 0);\n    --muted: oklch(0.24 0 0);\n    --muted-foreground: oklch(0.74 0 0);\n    --border: oklch(0.95 0 0 / 0.14);\n    --input: oklch(0.95 0.008 80 / 0.14);\n    --primary: oklch(0.8 0.18 27);\n    --primary-foreground: oklch(0.17 0.03 27);\n    --secondary: oklch(0.25 0.008 85);\n    --secondary-foreground: oklch(0.9 0 0);\n    --accent: oklch(0.26 0.008 0);\n    --accent-foreground: oklch(0.94 0 0);\n    --ring: oklch(0.8 0.18 27);\n    --news-rule: oklch(0.97 0 0);\n    --news-ink: oklch(0.97 0 0);\n    --popover: oklch(0.215 0 0);\n    --popover-foreground: oklch(0.94 0 0);\n  }\n  /* -- modes: end -- */\n</style>\n<div id=\"site-news\" data-look=\"broadsheet\" data-i18n-component>\n  <div class=\"news-bar\">\n    <span data-i18n-target=\"edition\">Lisbon edition · Late city</span>\n    <div class=\"news-bar-controls\">\n      <select\n        class=\"select\"\n        data-size=\"sm\"\n        data-site-look\n        aria-label=\"Look\"\n        data-i18n-aria-label-en=\"Look\"\n        data-i18n-aria-label-de=\"Stil\"\n        style=\"width: auto\"\n      >\n        <option value=\"broadsheet\" data-i18n-target=\"look-broadsheet\">Broadsheet</option>\n        <option value=\"evening\" data-i18n-target=\"look-evening\">Evening edition</option>\n        <option value=\"tabloid\" data-i18n-target=\"look-tabloid\">Tabloid</option>\n      </select>\n      <select\n        class=\"select\"\n        data-size=\"sm\"\n        data-app-locale\n        aria-label=\"Language\"\n        data-i18n-aria-label-en=\"Language\"\n        data-i18n-aria-label-de=\"Sprache\"\n        style=\"width: auto\"\n      >\n        <option value=\"en\" lang=\"en\">English</option>\n        <option value=\"de\" lang=\"de\">Deutsch</option>\n      </select>\n      <label class=\"swap site-mode\" data-variant=\"rotate\" data-size=\"sm\">\n        <input\n          type=\"checkbox\"\n          data-site-mode\n          aria-label=\"Dark mode\"\n          data-i18n-aria-label-en=\"Dark mode\"\n          data-i18n-aria-label-de=\"Dunkler Modus\"\n        />\n        <span class=\"swap-on\" aria-hidden=\"true\"><i data-lucide=\"moon\"></i></span>\n        <span class=\"swap-off\" aria-hidden=\"true\"><i data-lucide=\"sun\"></i></span>\n      </label>\n    </div>\n  </div>\n  <header class=\"mk-news-header\" data-variant=\"masthead\">\n    <div class=\"mk-news-header-top\">\n      <span class=\"mk-news-header-kicker\" data-i18n-target=\"kicker\">Vol. 12 · No. 274</span>\n      <time class=\"mk-news-header-date\" datetime=\"2026-10-01\" data-i18n-target=\"today\"\n        ><span data-i18n-value=\"today\">Thursday, 1 October 2026</span></time\n      >\n    </div>\n    <p class=\"news-ear\"\n      ><b data-i18n-target=\"ear-weather\">Lisbon 21°</b\n      ><span data-i18n-target=\"ear-weather-text\">Sunny, a light breeze off the river</span></p\n    >\n    <h1 class=\"mk-news-header-title\">The Acme Times</h1>\n    <p class=\"news-ear\"\n      ><b data-i18n-target=\"ear-price\">€2.50</b\n      ><span data-i18n-target=\"ear-price-text\">All the release notes fit to print</span></p\n    >\n    <nav\n      class=\"mk-news-header-topics\"\n      aria-label=\"Sections\"\n      data-i18n-aria-label-en=\"Sections\"\n      data-i18n-aria-label-de=\"Ressorts\"\n    >\n      <a href=\"#/\" data-router-link aria-current=\"page\"><span data-i18n-target=\"nav-front\">Front page</span></a>\n      <a href=\"#/section/product\" data-router-link><span data-i18n-target=\"nav-product\">Product</span></a>\n      <a href=\"#/section/company\" data-router-link><span data-i18n-target=\"nav-company\">Company</span></a>\n      <a href=\"#/section/engineering\" data-router-link><span data-i18n-target=\"nav-engineering\">Engineering</span></a>\n    </nav>\n  </header>\n  <section\n    class=\"mk-news-ticker\"\n    data-variant=\"breaking\"\n    aria-label=\"Breaking news\"\n    data-i18n-aria-label-en=\"Breaking news\"\n    data-i18n-aria-label-de=\"Eilmeldungen\"\n  >\n    <span class=\"mk-news-ticker-label\" data-i18n-target=\"breaking\">Breaking</span>\n    <div class=\"mk-news-ticker-viewport\">\n      <div class=\"mk-news-ticker-track\">\n        <ul class=\"mk-news-ticker-items\">\n          <li\n            ><a href=\"#\"><time>09:41</time> Acme 4.0 ships with offline sync</a></li\n          >\n          <li\n            ><a href=\"#\"><time>09:12</time> Shared spaces open to every team</a></li\n          >\n          <li\n            ><a href=\"#\"><time>08:30</time> Passkeys become the default sign-in</a></li\n          >\n        </ul>\n        <ul class=\"mk-news-ticker-items\" aria-hidden=\"true\" inert>\n          <li\n            ><a href=\"#\"><time>09:41</time> Acme 4.0 ships with offline sync</a></li\n          >\n          <li\n            ><a href=\"#\"><time>09:12</time