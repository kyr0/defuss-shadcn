[{"label":"Engineering Blueprint","html":"<section\n  class=\"presentation\"\n  id=\"deck-stack\"\n  data-anim-in=\"zoomIn\"\n  data-anim-in-scale=\"1.08\"\n  data-anim-out=\"fadeOut\"\n  style=\"\n    --presentation-ink: #073553;\n    --presentation-ink-foreground: #e9f7ff;\n    --presentation-paper: #e9f7ff;\n    --presentation-paper-foreground: #0a4a78;\n    --presentation-accent: #7be0d3;\n    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"A decade of the grid - electricity mix 2015 to 2025\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Electricity generation mix from 2015 to 2025 as 100 percent columns, stacked areas, fossil versus low-carbon, and a 2025 donut: wind grew from 13 to 33 percent, coal fell from 42 to 16\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Cover\">\n    <svg\n      aria-hidden=\"true\"\n      width=\"1600\"\n      height=\"900\"\n      viewBox=\"0 0 1600 900\"\n      style=\"position: absolute; inset: 0; opacity: 0.18\"\n    >\n      <defs>\n        <pattern id=\"ns-grid\" width=\"40\" height=\"40\" patternUnits=\"userSpaceOnUse\">\n          <path d=\"M40 0H0V40\" fill=\"none\" stroke=\"#E9F7FF\" stroke-width=\"1\" />\n        </pattern>\n      </defs>\n      <rect width=\"1600\" height=\"900\" fill=\"url(#ns-grid)\" />\n      <circle cx=\"1270\" cy=\"330\" r=\"190\" fill=\"none\" stroke=\"#7BE0D3\" stroke-width=\"3\" stroke-dasharray=\"14 10\" />\n      <path d=\"M1270 100V560M1040 330H1500\" stroke=\"#7BE0D3\" stroke-width=\"2\" />\n    </svg>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\"\n      >Normalized stack · Engineering Blueprint</p\n    >\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        position: relative;\n        max-width: 1250px;\n        font-weight: 600;\n        letter-spacing: -0.01em;\n        font-size: 6.25rem;\n        max-width: 1000px;\n      \"\n      >A decade of the grid</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >Same demand, different machines: how every 100 kWh was made, 2015 to 2025.</p\n    >\n    <p class=\"presentation-note\">The drafting grid sets the tone - this is an engineering review.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"mix\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Mix by year\"\n  >\n    <header class=\"presentation-header\"><span>GEN-MIX-01</span><span>% of generation</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 600;\n        letter-spacing: -0.01em;\n      \"\n      >Wind overtook coal in 2023</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Each column is 100%: composition, not totals.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"flow\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Mix as flow\"\n  >\n    <header class=\"presentation-header\"><span>GEN-MIX-02</span><span>stacked area</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 600;\n        letter-spacing: -0.01em;\n      \"\n      >The same decade as a flow</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Columns melt into areas - the trend reads as a current.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"split\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Fossil vs low-carbon\"\n  >\n    <header class=\"presentation-header\"><span>GEN-MIX-03</span><span>two groups</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 600;\n        letter-spacing: -0.01em;\n      \"\n      >Low-carbon went from 48% to 70%</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Six sources merge into two groups.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Three numbers for the review board</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #7be0d3;\n            font-weight: 600;\n            letter-spacing: -0.01em;\n          \"\n          ><span data-count=\"70\">70</span>%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">low-carbon generation in 2025</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-weight: 600;\n            letter-spacing: -0.01em;\n          \"\n          ><span data-count=\"33\">33</span>%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">from wind - now the largest source</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-weight: 600;\n            letter-spacing: -0.01em;\n          \"\n          ><span data-count=\"42\">42</span>→16%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">coal’s share, 2015 to 2025</p>\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >Nuclear left the mix in 2024; wind, solar and hydro more than covered the gap.</p\n    >\n    <p class=\"presentation-note\">Say the nuclear line out loud - someone will ask.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"The wires\">\n    <header class=\"presentation-header\"><span>GRID</span><span>transmission</span></header>\n    <div style=\"display: flex; gap: 4.5rem; align-items: center; margin-top: 3.5rem\">\n      <div style=\"flex: 1 1 0; min-width: 0\">\n        <h2\n          class=\"presentation-title\"\n          data-df-entrance=\"up\"\n          style=\"font-size: 3.4rem; font-weight: 600; letter-spacing: -0.01em\"\n          >The bottleneck moved from plants to wires</h2\n        >\n        <p class=\"presentation-lede\" data-df-entrance=\"fade\" style=\"--df-motion-delay: 300ms; font-size: 1.7rem\"\n          >Wind is built where it blows, not where people live. 1,900 km of new lines carried the shift.</p\n        >\n      </div>\n      <figure\n        class=\"image\"\n        data-ratio=\"4/3\"\n        data-df-entrance=\"zoom\"\n        style=\"--df-motion-delay: 150ms; flex: 0 0 700px; margin: 0\"\n      >\n        <img\n          src=\"https://picsum.photos/id/69/960/720\"\n          alt=\"Railway tracks running through a forest under overhead power lines\"\n          loading=\"lazy\"\n          width=\"960\"\n          height=\"720\"\n          style=\"width: 100%; height: 100%; object-fit: cover\"\n        />\n        <figcaption class=\"image-caption\" style=\"font-size: 1.25rem\"\n          >Lines through the forest (stock photo).</figcaption\n        >\n      </figure>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Transmission is the unsung half of the chart.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"south\"\n    data-anim-in-blocks=\"6\"\n    data-anim-in-color=\"#7BE0D3\"\n    aria-label=\"Mix table\"\n  >\n    <header class=\"presentation-header\"><span>GEN-MIX-TABLE</span><span>% of generation</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" style=\"font-size: 1.7rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Generation mix of a fictional grid, % of annual generation (synthetic).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Source</th><th class=\"table-head\" style=\"text-align: right\">2015</th\n            ><th class=\"table-head\" style=\"text-align: right\">2019</th\n            ><th class=\"table-head\" style=\"text-align: right\">2023</th\n            ><th class=\"table-head\" style=\"text-align: right\">2025</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Coal</td><td class=\"table-cell\" style=\"text-align: right\">42</td\n            ><td class=\"table-cell\" style=\"text-align: right\">30</td\n            ><td class=\"table-cell\" style=\"text-align: right\">21</td\n            ><td class=\"table-cell\" style=\"text-align: right\">16</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Gas</td><td class=\"table-cell\" style=\"text-align: right\">10</td\n            ><td class=\"table-cell\" style=\"text-align: right\">15</td\n            ><td class=\"table-cell\" style=\"text-align: right\">15</td\n            ><td class=\"table-cell\" style=\"text-align: right\">14</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Nuclear</td><td class=\"table-cell\" style=\"text-align: right\">14</td\n            ><td class=\"table-cell\" style=\"text-align: right\">12</td\n            ><td class=\"table-cell\" style=\"text-align: right\">2</td\n            ><td class=\"table-cell\" style=\"text-align: right\">0</td></tr\n          >\n          <tr class=\"table-row\" style=\"font-weight: 700\"\n            ><td class=\"table-cell\">Wind</td><td class=\"table-cell\" style=\"text-align: right\">13</td\n            ><td class=\"table-cell\" style=\"text-align: right\">21</td\n            ><td class=\"table-cell\" style=\"text-align: right\">30</td\n            ><td class=\"table-cell\" style=\"text-align: right\">33</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Solar</td><td class=\"table-cell\" style=\"text-align: right\">6</td\n            ><td class=\"table-cell\" style=\"text-align: right\">8</td\n            ><td class=\"table-cell\" style=\"text-align: right\">13</td\n            ><td class=\"table-cell\" style=\"text-align: right\">17</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Hydro & bio</td><td class=\"table-cell\" style=\"text-align: right\">15</td\n            ><td class=\"table-cell\" style=\"text-align: right\">14</td\n            ><td class=\"table-cell\" style=\"text-align: right\">19</td\n            ><td class=\"table-cell\" style=\"text-align: right\">20</td></tr\n          >\n        </tbody>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Every column sums to 100.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"font-size: 3.3rem; line-height: 1.22; font-weight: 600; letter-spacing: -0.01em\"\n        >“Balancing used to mean ramping coal. Today it means forecasting weather - and trading with our neighbours.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #073553; color: #7be0d3\"\n        ><span class=\"avatar-fallback\">IS</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Ines Sørensen<br /><span style=\"opacity: 0.7; font-size: 1.4rem\"\n          >Grid control room lead - 17 winters on shift</span\n        ></p\n      >\n    </div>\n    <p class=\"presentation-note\">The operator’s view makes the chart physical.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"y2025\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"2025 mix\"\n  >\n    <header class=\"presentation-header\"><span>GEN-MIX-2025</span><span>2025 · 100%</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 600;\n        letter-spacing: -0.01em;\n      \"\n      >2025: a third wind, a sixth coal</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The last column folds into a donut.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Review questions\"\n  >\n    <header class=\"presentation-header\"><span>REVIEW</span><span>Open items</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"font-size: 3.2rem; margin-block: 5.25rem 1.5rem; font-weight: 600; letter-spacing: -0.01em\"\n      >Questions from the review board</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"ns-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>What happens on windless weeks?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Gas and imports cover it: gas share stayed near 14% as the backup, not the baseload.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"ns-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Did total demand change?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Barely - 1.2% higher in 2025 than 2015; the stack is about composition.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"ns-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Where does storage show up?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >It does not generate - it shifts. 2.1 GW of batteries move solar into the evening peak.</p\n          ></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Storage is the question to prepare for.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Takeaways</span><span>Actions</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">→</span\n        ><span>Keep building wind - it is now the backbone.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">→</span\n        ><span>Gas is the balancer; plan its hours, not its share.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">→</span\n        ><span>Transmission and storage decide the next 10 points.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">→</span\n        ><span>Coal at 16% is the next exit to schedule.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Four actions, one slide.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"north\"\n    data-anim-in-blocks=\"6\"\n    data-anim-in-color=\"#7BE0D3\"\n    aria-label=\"Closing\"\n  >\n    <svg\n      aria-hidden=\"true\"\n      width=\"1600\"\n      height=\"900\"\n      viewBox=\"0 0 1600 900\"\n      style=\"position: absolute; inset: 0; opacity: 0.18\"\n    >\n      <defs>\n        <pattern id=\"ns-grid\" width=\"40\" height=\"40\" patternUnits=\"userSpaceOnUse\">\n          <path d=\"M40 0H0V40\" fill=\"none\" stroke=\"#E9F7FF\" stroke-width=\"1\" />\n        </pattern>\n      </defs>\n      <rect width=\"1600\" height=\"900\" fill=\"url(#ns-grid)\" />\n      <circle cx=\"1270\" cy=\"330\" r=\"190\" fill=\"none\" stroke=\"#7BE0D3\" stroke-width=\"3\" stroke-dasharray=\"14 10\" />\n      <path d=\"M1270 100V560M1040 330H1500\" stroke=\"#7BE0D3\" stroke-width=\"2\" />\n    </svg>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        font-weight: 600;\n        letter-spacing: -0.01em;\n      \"\n      >Same 100%, new machines</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px\"\n      >A fictional grid, synthetic shares - the normalized stack shows the shift without the noise of totals.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">Close on the chart idea.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 12</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"12\" value=\"1\"></progress>\n</section>\n","individual":false}]
