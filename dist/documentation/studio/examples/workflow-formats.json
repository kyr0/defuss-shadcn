[{"label":"Files and samples","html":"<div class=\"grid gap-2\">\n  <div class=\"flex flex-wrap items-center gap-2\">\n    <button\n      class=\"btn\"\n      data-variant=\"outline\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"formats\"\n      data-workflow-action=\"import\"\n      >Import</button\n    >\n    <button\n      class=\"btn\"\n      data-variant=\"outline\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"formats\"\n      data-workflow-action=\"export\"\n      >Export</button\n    >\n    <button class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" type=\"button\" id=\"load-comfy\">ComfyUI sample</button>\n    <button class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" type=\"button\" id=\"load-gradio\">Gradio sample</button>\n    <span class=\"text-sm text-muted-foreground\" data-workflow-for=\"formats\" data-workflow-output=\"title\"></span>\n  </div>\n  <div class=\"workflow\" id=\"formats\" aria-label=\"Formats\" style=\"--workflow-height: 20rem\">\n    \n  </div>\n  <pre class=\"text-xs m-0\" style=\"max-block-size: 12rem; overflow: auto\" id=\"formats-json\"></pre>\n</div>\n","individual":false}]
