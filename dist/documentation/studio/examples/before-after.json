[{"label":"Slider","html":"<figure class=\"mk-before-after\">\n  <div class=\"mk-before-after-stage\">\n    <img\n      class=\"mk-before-after-before\"\n      src=\"https://picsum.photos/seed/ba-street/1200/800?grayscale&amp;blur=2\"\n      alt=\"Before: the photo, faded and blurred\"\n    />\n    <img\n      class=\"mk-before-after-after\"\n      src=\"https://picsum.photos/seed/ba-street/1200/800\"\n      alt=\"After: the same photo, restored in color\"\n    />\n    <span class=\"mk-before-after-handle\" aria-hidden=\"true\"></span>\n    <span class=\"mk-before-after-label\" data-side=\"before\">Before</span>\n    <span class=\"mk-before-after-label\" data-side=\"after\">After</span>\n    <input\n      class=\"mk-before-after-range\"\n      type=\"range\"\n      min=\"0\"\n      max=\"100\"\n      value=\"50\"\n      aria-label=\"Divider position: drag to compare before and after\"\n    />\n  </div>\n  <figcaption class=\"mk-before-after-caption\">Restoring a faded photo: color and detail back.</figcaption>\n</figure>\n","individual":true},{"label":"Toggle","html":"<figure class=\"mk-before-after\" data-variant=\"toggle\" style=\"max-width: 40rem\">\n  <div class=\"mk-before-after-stage\">\n    <img\n      class=\"mk-before-after-before\"\n      src=\"https://picsum.photos/seed/ba-room/1200/800?grayscale\"\n      alt=\"Before: the living room, grey and empty\"\n    />\n    <img\n      class=\"mk-before-after-after\"\n      src=\"https://picsum.photos/seed/ba-room/1200/800\"\n      alt=\"After: the living room, furnished and warm\"\n    />\n  </div>\n  <div class=\"switch-item mk-before-after-toggle\"\n    ><input class=\"switch\" type=\"checkbox\" role=\"switch\" id=\"ba-toggle\" /><label for=\"ba-toggle\">Show after</label></div\n  >\n</figure>\n","individual":true},{"label":"Side by side","html":"<figure class=\"mk-before-after\" data-variant=\"split\">\n  <div class=\"mk-before-after-stage\">\n    <div\n      ><img\n        class=\"mk-before-after-before\"\n        src=\"https://picsum.photos/seed/ba-garden/900/600?grayscale\"\n        alt=\"Before: the garden in winter\"\n      /><span class=\"mk-before-after-label\" data-side=\"before\">Before</span></div\n    >\n    <div\n      ><img\n        class=\"mk-before-after-after\"\n        src=\"https://picsum.photos/seed/ba-garden/900/600\"\n        alt=\"After: the garden in spring\"\n      /><span class=\"mk-before-after-label\" data-side=\"after\">After</span></div\n    >\n  </div>\n  <figcaption class=\"mk-before-after-caption\">The same garden, five months apart.</figcaption>\n</figure>\n","individual":true}]
