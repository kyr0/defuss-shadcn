[{"label":"Bug report across four teams","html":"<figure class=\"diagram\" id=\"dg-swim\" data-type=\"swimlane\" aria-label=\"Support escalation across teams\">\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Swimlane</span>\n    <span class=\"diagram-title\">A bug report, across four teams</span>\n    <span class=\"diagram-dek\">The handoff into engineering is where the days go.</span>\n  </figcaption>\n  <div\n    class=\"diagram-canvas\"\n    style=\"grid-template-columns: 5.5rem repeat(5, minmax(6.5rem, 1fr)); --diagram-node-w: 7.5rem\"\n  >\n    <div class=\"diagram-group\" data-shape=\"lane\" style=\"--col: 1; --row: 1; --span: 6\"\n      ><span class=\"diagram-group-label\">Customer</span></div\n    >\n    <div class=\"diagram-group\" data-shape=\"lane\" style=\"--col: 1; --row: 2; --span: 6\"\n      ><span class=\"diagram-group-label\">Support</span></div\n    >\n    <div class=\"diagram-group\" data-shape=\"lane\" style=\"--col: 1; --row: 3; --span: 6\"\n      ><span class=\"diagram-group-label\">Engineering</span></div\n    >\n    <div class=\"diagram-group\" data-shape=\"lane\" style=\"--col: 1; --row: 4; --span: 6\"\n      ><span class=\"diagram-group-label\">Release</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"report\" data-shape=\"pill\" style=\"--col: 2; --row: 1\"\n      ><span class=\"diagram-node-name\">Reports a bug</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"triage\" style=\"--col: 3; --row: 2\">\n      <span class=\"diagram-node-name\">Triage</span>\n      <span class=\"diagram-node-meta\">reproduce · tag</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"known\" data-shape=\"diamond\" style=\"--col: 4; --row: 2\"\n      ><span class=\"diagram-node-name\">Known issue?</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"answer\" style=\"--col: 5; --row: 1\">\n      <span class=\"diagram-node-name\">Answer</span>\n      <span class=\"diagram-node-meta\">workaround</span>\n    </div>\n    <div\n      class=\"diagram-node\"\n      data-node=\"fix\"\n      data-tone=\"accent\"\n      data-step-label=\"The handoff\"\n      style=\"--col: 4; --row: 3\"\n    >\n      <span class=\"diagram-node-name\">Fix</span>\n      <span class=\"diagram-node-meta\">branch · PR</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"review\" style=\"--col: 5; --row: 3\">\n      <span class=\"diagram-node-name\">Review</span>\n      <span class=\"diagram-node-meta\">two approvals</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"ship\" style=\"--col: 6; --row: 4\">\n      <span class=\"diagram-node-name\">Ship</span>\n      <span class=\"diagram-node-meta\">next train</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"notify\" data-shape=\"pill\" style=\"--col: 6; --row: 1\"\n      ><span class=\"diagram-node-name\">Notified</span></div\n    >\n  </div>\n  <ol class=\"diagram-edges\">\n    <li class=\"diagram-edge\" data-from=\"report\" data-to=\"triage\">ticket</li>\n    <li class=\"diagram-edge\" data-from=\"triage\" data-to=\"known\"></li>\n    <li class=\"diagram-edge\" data-from=\"known\" data-to=\"answer\">yes</li>\n    <li class=\"diagram-edge\" data-from=\"known\" data-to=\"fix\" data-tone=\"accent\">no · handoff</li>\n    <li class=\"diagram-edge\" data-from=\"fix\" data-to=\"review\"></li>\n    <li class=\"diagram-edge\" data-from=\"review\" data-to=\"ship\">merge</li>\n    <li class=\"diagram-edge\" data-from=\"ship\" data-to=\"notify\" data-line=\"dashed\">release note</li>\n  </ol>\n</figure>\n","individual":true},{"label":"Bug report, step by step","html":"<figure\n  class=\"diagram\"\n  id=\"dg-swim-steps\"\n  data-type=\"swimlane\"\n  data-steps\n  data-autoplay\n  aria-label=\"Support escalation across teams\"\n>\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Swimlane</span>\n    <span class=\"diagram-title\">A bug report, across four teams</span>\n    <span class=\"diagram-dek\">The handoff into engineering is where the days go.</span>\n  </figcaption>\n  <div\n    class=\"diagram-canvas\"\n    style=\"grid-template-columns: 5.5rem repeat(5, minmax(6.5rem, 1fr)); --diagram-node-w: 7.5rem\"\n  >\n    <div class=\"diagram-group\" data-shape=\"lane\" data-step=\"0\" style=\"--col: 1; --row: 1; --span: 6\"\n      ><span class=\"diagram-group-label\">Customer</span></div\n    >\n    <div class=\"diagram-group\" data-shape=\"lane\" data-step=\"0\" style=\"--col: 1; --row: 2; --span: 6\"\n      ><span class=\"diagram-group-label\">Support</span></div\n    >\n    <div class=\"diagram-group\" data-shape=\"lane\" data-step=\"0\" style=\"--col: 1; --row: 3; --span: 6\"\n      ><span class=\"diagram-group-label\">Engineering</span></div\n    >\n    <div class=\"diagram-group\" data-shape=\"lane\" data-step=\"0\" style=\"--col: 1; --row: 4; --span: 6\"\n      ><span class=\"diagram-group-label\">Release</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"report\" data-shape=\"pill\" data-step=\"1\" style=\"--col: 2; --row: 1\"\n      ><span class=\"diagram-node-name\">Reports a bug</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"triage\" data-step=\"2\" style=\"--col: 3; --row: 2\">\n      <span class=\"diagram-node-name\">Triage</span>\n      <span class=\"diagram-node-meta\">reproduce · tag</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"known\" data-shape=\"diamond\" data-step=\"3\" style=\"--col: 4; --row: 2\"\n      ><span class=\"diagram-node-name\">Known issue?</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"answer\" data-step=\"4\" style=\"--col: 5; --row: 1\">\n      <span class=\"diagram-node-name\">Answer</span>\n      <span class=\"diagram-node-meta\">workaround</span>\n    </div>\n    <div\n      class=\"diagram-node\"\n      data-node=\"fix\"\n      data-tone=\"accent\"\n      data-step=\"4\"\n      data-step-label=\"The handoff\"\n      style=\"--col: 4; --row: 3\"\n    >\n      <span class=\"diagram-node-name\">Fix</span>\n      <span class=\"diagram-node-meta\">branch · PR</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"review\" data-step=\"5\" style=\"--col: 5; --row: 3\">\n      <span class=\"diagram-node-name\">Review</span>\n      <span class=\"diagram-node-meta\">two approvals</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"ship\" data-step=\"6\" style=\"--col: 6; --row: 4\">\n      <span class=\"diagram-node-name\">Ship</span>\n      <span class=\"diagram-node-meta\">next train</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"notify\" data-shape=\"pill\" data-step=\"7\" style=\"--col: 6; --row: 1\"\n      ><span class=\"diagram-node-name\">Notified</span></div\n    >\n  </div>\n  <ol class=\"diagram-edges\">\n    <li class=\"diagram-edge\" data-from=\"report\" data-to=\"triage\">ticket</li>\n    <li class=\"diagram-edge\" data-from=\"triage\" data-to=\"known\"></li>\n    <li class=\"diagram-edge\" data-from=\"known\" data-to=\"answer\">yes</li>\n    <li class=\"diagram-edge\" data-from=\"known\" data-to=\"fix\" data-tone=\"accent\">no · handoff</li>\n    <li class=\"diagram-edge\" data-from=\"fix\" data-to=\"review\"></li>\n    <li class=\"diagram-edge\" data-from=\"review\" data-to=\"ship\">merge</li>\n    <li class=\"diagram-edge\" data-from=\"ship\" data-to=\"notify\" data-line=\"dashed\">release note</li>\n  </ol>\n</figure>\n","individual":true},{"label":"A bot does the first triage","html":"<figure class=\"diagram\" id=\"dg-swim-delta\" data-type=\"swimlane\" data-delta aria-label=\"Escalation with a bot triage\">\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Process change</span>\n    <span class=\"diagram-title\">A bot does the first triage</span>\n  </figcaption>\n  <div\n    class=\"diagram-canvas\"\n    style=\"grid-template-columns: 6rem repeat(4, minmax(7rem, 1fr)); --diagram-node-w: 8.5rem\"\n  >\n    <div class=\