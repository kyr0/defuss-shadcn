[{"label":"Radial Progress (sm)","html":"<div\n  class=\"radial-progress\"\n  data-size=\"sm\"\n  role=\"progressbar\"\n  aria-valuenow=\"40\"\n  aria-valuemin=\"0\"\n  aria-valuemax=\"100\"\n></div>\n","individual":true},{"label":"Radial Progress (lg)","html":"<div\n  class=\"radial-progress\"\n  data-size=\"lg\"\n  role=\"progressbar\"\n  aria-label=\"Percent\"\n  aria-valuenow=\"38\"\n  aria-valuemin=\"0\"\n  aria-valuemax=\"100\"\n></div>\n","individual":true},{"label":"Radial Progress (secondary)","html":"<div\n  class=\"radial-progress\"\n  data-variant=\"secondary\"\n  role=\"progressbar\"\n  aria-label=\"Secondary\"\n  aria-valuenow=\"60\"\n  aria-valuemin=\"0\"\n  aria-valuemax=\"100\"\n></div>\n","individual":true},{"label":"Determinate","html":"<div\n  class=\"radial-progress\"\n  role=\"progressbar\"\n  aria-label=\"Upload\"\n  aria-valuenow=\"70\"\n  aria-valuemin=\"0\"\n  aria-valuemax=\"100\"\n  >70%</div\n>\n","individual":true},{"label":"Values","html":"<div class=\"flex flex-wrap items-center gap-4\">\n  <div class=\"radial-progress\" role=\"progressbar\" aria-valuenow=\"0\" aria-valuemin=\"0\" aria-valuemax=\"100\"></div>\n  <div class=\"radial-progress\" role=\"progressbar\" aria-valuenow=\"20\" aria-valuemin=\"0\" aria-valuemax=\"100\"></div>\n  <div class=\"radial-progress\" role=\"progressbar\" aria-valuenow=\"60\" aria-valuemin=\"0\" aria-valuemax=\"100\"></div>\n  <div class=\"radial-progress\" role=\"progressbar\" aria-valuenow=\"80\" aria-valuemin=\"0\" aria-valuemax=\"100\"></div>\n  <div class=\"radial-progress\" role=\"progressbar\" aria-valuenow=\"100\" aria-valuemin=\"0\" aria-valuemax=\"100\"></div>\n</div>\n","individual":false},{"label":"Colors","html":"<div class=\"flex flex-col gap-4\">\n  <div class=\"flex flex-wrap items-center gap-4\">\n    <div\n      class=\"radial-progress\"\n      data-tone=\"success\"\n      role=\"progressbar\"\n      aria-label=\"Tests\"\n      aria-valuenow=\"92\"\n      aria-valuemin=\"0\"\n      aria-valuemax=\"100\"\n    ></div>\n    <div\n      class=\"radial-progress\"\n      data-tone=\"warning\"\n      role=\"progressbar\"\n      aria-label=\"Disk\"\n      aria-valuenow=\"78\"\n      aria-valuemin=\"0\"\n      aria-valuemax=\"100\"\n    ></div>\n    <div\n      class=\"radial-progress\"\n      data-tone=\"info\"\n      role=\"progressbar\"\n      aria-label=\"Sync\"\n      aria-valuenow=\"45\"\n      aria-valuemin=\"0\"\n      aria-valuemax=\"100\"\n    ></div>\n    <div\n      class=\"radial-progress\"\n      data-tone=\"destructive\"\n      role=\"progressbar\"\n      aria-label=\"Quota\"\n      aria-valuenow=\"97\"\n      aria-valuemin=\"0\"\n      aria-valuemax=\"100\"\n    ></div>\n    <div\n      class=\"radial-progress\"\n      role=\"progressbar\"\n      aria-label=\"Brand\"\n      aria-valuenow=\"60\"\n      aria-valuemin=\"0\"\n      aria-valuemax=\"100\"\n      style=\"--progress-color: oklch(0.62 0.2 300)\"\n    ></div>\n    <div\n      class=\"radial-progress\"\n      data-variant=\"secondary\"\n      role=\"progressbar\"\n      aria-label=\"Secondary\"\n      aria-valuenow=\"60\"\n      aria-valuemin=\"0\"\n      aria-valuemax=\"100\"\n    ></div>\n  </div>\n  <div class=\"flex flex-wrap items-center gap-4\">\n    <div\n      class=\"radial-progress\"\n      data-tone=\"auto\"\n      role=\"progressbar\"\n      aria-label=\"Auto, low\"\n      aria-valuenow=\"20\"\n      aria-valuemin=\"0\"\n      aria-valuemax=\"100\"\n    ></div>\n    <div\n      class=\"radial-progress\"\n      data-tone=\"auto\"\n      role=\"progressbar\"\n      aria-label=\"Auto, mid\"\n      aria-valuenow=\"50\"\n      aria-valuemin=\"0\"\n      aria-valuemax=\"100\"\n    ></div>\n    <div\n      class=\"radial-progress\"\n      data-tone=\"auto\"\n      role=\"progressbar\"\n      aria-label=\"Auto, high\"\n      aria-valuenow=\"85\"\n      aria-valuemin=\"0\"\n      aria-valuemax=\"100\"\n    ></div>\n  </div>\n</div>\n","individual":false},{"label":"Labels","html":"<div class=\"flex flex-wrap items-center gap-6\">\n  <div\n    class=\"radial-progress\"\n    data-size=\"lg\"\n    role=\"progressbar\"\n    aria-label=\"Percent\"\n    aria-valuenow=\"38\"\n    aria-valuemin=\"0\"\n    aria-valuemax=\"100\"\n  ></div>\n  <div\n    class=\"radial-progress\"\n    data-size=\"lg\"\n    data-format=\"fraction\"\n    role=\"progressbar\"\n    aria-label=\"Lessons\"\n    aria-valuenow=\"3\"\n    aria-valuemin=\"0\"\n    aria-valuemax=\"8\"\n  ></div>\n  <div\n    class=\"radial-progress\"\n    data-size=\"lg\"\n    data-template=\"{value} km\"\n    role=\"progressbar\"\n    aria-label=\"Run\"\n    aria-valuenow=\"7\"\n    aria-valuemin=\"0\"\n    aria-valuemax=\"10\"\n  ></div>\n  <div\n    class=\"radial-progress\"\n    data-size=\"lg\"\n    data-tone=\"success\"\n    data-format=\"fraction\"\n    role=\"progressbar\"\n    aria-label=\"Workouts\"\n    aria-valuenow=\"4\"\n    aria-valuemin=\"0\"\n    aria-valuemax=\"5\"\n  >\n    <span class=\"radial-progress-value\"></span>\n    <span class=\"radial-progress-caption\">workouts</span>\n  </div>\n</div>\n","individual":false},{"label":"Step by step","html":"<div class=\"flex items-center gap-6\">\n  <div\n    class=\"radial-progress\"\n    id=\"rp-st\"\n    data-size=\"lg\"\n    data-tone=\"auto\"\n    data-step=\"10\"\n    role=\"progressbar\"\n    aria-label=\"Installing\"\n    aria-valuenow=\"30\"\n    aria-valuemin=\"0\"\n    aria-valuemax=\"100\"\n  ></div>\n  <div class=\"flex flex-wrap gap-2\" style=\"max-width: 14rem\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" commandfor=\"rp-st\" command=\"--decrement\"\n      >− 10%</button\n    >\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" commandfor=\"rp-st\" command=\"--increment\"\n      >+ 10%</button\n    >\n    <button class=\"btn\" data-variant=\"secondary\" data-size=\"sm\" type=\"button\" onclick=\"runRingSteps()\">Run</button>\n    <button class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" type=\"button\" commandfor=\"rp-st\" command=\"--reset\"\n      >Reset</button\n    >\n  </div>\n</div>\n","individual":false},{"label":"Linear (interpolated)","html":"<div class=\"flex items-center gap-6\">\n  <div\n    class=\"radial-progress\"\n    id=\"rp-lin\"\n    data-size=\"lg\"\n    data-duration=\"4000\"\n    role=\"progressbar\"\n    aria-label=\"Rendering\"\n    aria-valuenow=\"0\"\n    aria-valuemin=\"0\"\n    aria-valuemax=\"100\"\n  >\n    <span class=\"radial-progress-value\"></span>\n    <span class=\"radial-progress-caption\">rendering</span>\n  </div>\n  <div class=\"flex flex-wrap gap-2\" style=\"max-width: 14rem\">\n    <button class=\"btn\" data-size=\"sm\" type=\"button\" commandfor=\"rp-lin\" command=\"--play\">Play</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" commandfor=\"rp-lin\" command=\"--pause\"\n      >Pause</button\n    >\n    <button\n      class=\"btn\"\n      data-variant=\"outline\"\n      data-size=\"sm\"\n      type=\"button\"\n      onclick=\"document.getElementById('rp-lin').api.setState('default', { value: 75, duration: 1200 })\"\n      >Glide to 75%</button\n    >\n    <button class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" type=\"button\" commandfor=\"rp-lin\" command=\"--reset\"\n      >Reset</button\n    >\n  </div>\n</div>\n","individual":false},{"label":"Indeterminate","html":"<div class=\"flex items-center gap-4\">\n  <div\n    class=\"radial-progress\"\n    data-indeterminate=\"…\"\n    role=\"progressbar\"\n    aria-label=\"Connecting\"\n    aria-valuemin=\"0\"\n    aria-valuemax=\"100\"\n  ></div>\n  <div\n    class=\"radial-progress\"\n    data-tone=\"info\"\n    data-size=\"sm\"\n    data-indeterminate=\"\"\n    role=\"progressbar\"\n    aria-label=\"Loading\"\n    aria-valuemin=\"0\"\n    aria-valuemax=\"100\"\n  ></div>\n</div>\n","individual":false},{"label":"Sizes","html":"<div class=\"flex flex-wrap items-center gap-4\">\n  <div\n    class=\"radial-progress\"\n    data-size=\"sm\"\n    role=\"progressbar\"\n    aria-valuenow=\"40\"\n    aria-valuemin=\"0\"\n    aria-valuemax=\"100\"\n  ></div>\n  <div class=\"radial-progress\" role=\"progressbar\" aria-valuenow=\"40\" aria-valuemin=\"0\" aria-valuemax=\"100\"></div>\n  <div\n    class=\"radial-progress\"\n    data-size=\"lg\"\n    role=\"progressbar\"\n    aria-valuenow=\"40\"\n    aria-valuemin=\"0\"\n    aria-valuemax=\"100\"\n  ></div>\n</div>\n","individual":false},{"label":"Custom size and thickness","html":"<div class=\"flex flex-wrap items-center gap-6\">\n  <div\n    class=\"radial-progress\"\n    role=\"progressbar\"\n    aria-valuenow=\"60\"\n    aria-valuemin=\"0\"\n    aria-valuemax=\"100\"\n    style=\"--size: 10rem; --thickness: 2px\"\n  ></div>\n  <div\n    class=\"radial-progress\"\n    role=\"progressbar\"\n    aria-valuenow=\"75\"\n    aria-valuemin=\"0\"\n    aria-valuemax=\"100\"\n    style=\"--size: 6rem; --thickness: 1.5rem\"\n  ></div>\n  <div\n    class=\"radial-progress\"\n    data-tone=\"success\"\n    role=\"progressbar\"\n    aria-valuenow=\"100\"\n    aria-valuemin=\"0\"\n    aria-valuemax=\"100\"\n    aria-label=\"Upload\"\n    ><i data-lucide=\"check\" aria-hidden=\"true\"></i\n  ></div>\n</div>\n","individual":false},{"label":"In cards","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr))\">\n  <div class=\"card\">\n    <div class=\"card-content flex items-center gap-4\" style=\"padding-block: 1.25rem\">\n      <div\n        class=\"radial-progress\"\n        data-tone=\"auto\"\n        role=\"progressbar\"\n        aria-valuenow=\"28\"\n        aria-valuemin=\"0\"\n        aria-valuemax=\"100\"\n        aria-label=\"Storage free\"\n      ></div>\n      <div\n        ><p class=\"text-sm font-medium m-0\">Storage free</p\n        ><p class=\"text-sm text-muted-foreground m-0\">28 GB of 100 GB</p></div\n      >\n    </div>\n  </div>\n  <div class=\"card\">\n    <div class=\"card-content flex items-center gap-4\" style=\"padding-block: 1.25rem\">\n      <div\n        class=\"radial-progress\"\n        data-format=\"fraction\"\n        role=\"progressbar\"\n        aria-valuenow=\"6\"\n        aria-valuemin=\"0\"\n        aria-valuemax=\"10\"\n        aria-label=\"Seats booked\"\n      ></div>\n      <div\n        ><p class=\"text-sm font-medium m-0\">Seats booked</p\n        ><p class=\"text-sm text-muted-foreground m-0\">6 of 10 seats</p></div\n      >\n    </div>\n  </div>\n  <div class=\"card\">\n    <div class=\"card-content flex items-center gap-4\" style=\"padding-block: 1.25rem\">\n      <div\n        class=\"radial-progress\"\n        data-tone=\"success\"\n        role=\"progressbar\"\n        aria-valuenow=\"100\"\n        aria-valuemin=\"0\"\n        aria-valuemax=\"100\"\n        aria-label=\"Weekly goal\"\n      ></div>\n      <div\n        ><p class=\"text-sm font-medium m-0\">Weekly goal</p\n        ><p class=\"text-sm text-muted-foreground m-0\">5 of 5 workouts</p></div\n      >\n    </div>\n  </div>\n</div>\n","individual":false}]
