[{"label":"Default","html":"<figure class=\"image\" style=\"max-width: 400px\">\n  <img\n    src=\"https://images.unsplash.com/photo-1588345921523-c2dcdb7f1dcd?w=800&amp;h=400&amp;fit=crop\"\n    alt=\"Abstract gradient\"\n  />\n</figure>\n","individual":true},{"label":"With Caption","html":"<figure class=\"image\" style=\"max-width: 400px\">\n  <img\n    src=\"https://images.unsplash.com/photo-1588345921523-c2dcdb7f1dcd?w=800&amp;h=400&amp;fit=crop\"\n    alt=\"Abstract gradient\"\n  />\n  <figcaption class=\"image-caption\">Photo by Unsplash - Abstract gradient composition</figcaption>\n</figure>\n","individual":true},{"label":"Fallback","html":"<figure class=\"image\" style=\"max-width: 400px; height: 200px\">\n  <img src=\"https://invalid-url-that-will-fail.example/photo.jpg\" alt=\"Broken image example\" />\n  <div class=\"image-fallback\">\n    <svg\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"1.5\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n    >\n      <rect width=\"18\" height=\"18\" x=\"3\" y=\"3\" rx=\"2\" ry=\"2\"></rect>\n      <circle cx=\"9\" cy=\"9\" r=\"2\"></circle>\n      <path d=\"m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21\"></path>\n    </svg>\n  </div>\n</figure>\n","individual":true},{"label":"Lightbox Preview","html":"<figure class=\"image\" data-preview style=\"max-width: 400px\">\n  <img\n    src=\"https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800&amp;h=400&amp;fit=crop\"\n    data-src-full=\"https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=2400&amp;h=1200&amp;fit=crop&amp;q=85\"\n    alt=\"Mountain landscape\"\n  />\n  <figcaption class=\"image-caption\">Click to preview - opens the 2400 px original</figcaption>\n</figure>\n","individual":true},{"label":"Progressive Loading","html":"<figure class=\"image\" data-preview style=\"max-width: 400px\">\n  <img\n    src=\"https://images.unsplash.com/photo-1588345921523-c2dcdb7f1dcd?w=800&amp;h=400&amp;fit=crop\"\n    data-src-low=\"https://images.unsplash.com/photo-1588345921523-c2dcdb7f1dcd?w=32&amp;h=16&amp;fit=crop\"\n    data-src-high=\"https://images.unsplash.com/photo-1588345921523-c2dcdb7f1dcd?w=1600&amp;h=800&amp;fit=crop\"\n    alt=\"Abstract gradient\"\n  />\n  <figcaption class=\"image-caption\">Progressive: low-res placeholder → standard → high-res on retina/zoom</figcaption>\n</figure>\n","individual":true},{"label":"Aspect Ratios","html":"<div style=\"display: flex; gap: 1rem; flex-wrap: wrap; align-items: flex-start\">\n  <figure class=\"image\" data-ratio=\"1/1\" style=\"width: 120px\">\n    <img src=\"https://images.unsplash.com/photo-1588345921523-c2dcdb7f1dcd?w=400&amp;h=400&amp;fit=crop\" alt=\"Square\" />\n    <figcaption class=\"image-caption\">1:1</figcaption>\n  </figure>\n  <figure class=\"image\" data-ratio=\"4/3\" style=\"width: 160px\">\n    <img\n      src=\"https://images.unsplash.com/photo-1588345921523-c2dcdb7f1dcd?w=400&amp;h=300&amp;fit=crop\"\n      alt=\"Standard\"\n    />\n    <figcaption class=\"image-caption\">4:3</figcaption>\n  </figure>\n  <figure class=\"image\" data-ratio=\"16/9\" style=\"width: 200px\">\n    <img\n      src=\"https://images.unsplash.com/photo-1588345921523-c2dcdb7f1dcd?w=400&amp;h=225&amp;fit=crop\"\n      alt=\"Widescreen\"\n    />\n    <figcaption class=\"image-caption\">16:9</figcaption>\n  </figure>\n  <figure class=\"image\" data-ratio=\"3/4\" style=\"width: 120px\">\n    <img\n      src=\"https://images.unsplash.com/photo-1588345921523-c2dcdb7f1dcd?w=300&amp;h=400&amp;fit=crop\"\n      alt=\"Portrait\"\n    />\n    <figcaption class=\"image-caption\">3:4</figcaption>\n  </figure>\n</div>\n","individual":false},{"label":"Object Fit","html":"<div style=\"display: flex; gap: 1rem; flex-wrap: wrap; align-items: flex-start\">\n  <figure class=\"image\" data-ratio=\"4/3\" style=\"width: 180px; background: var(--muted)\">\n    <img\n      src=\"https://images.unsplash.com/photo-1588345921523-c2dcdb7f1dcd?w=800&amp;h=400&amp;fit=crop\"\n      alt=\"Cover (default)\"\n    />\n    <figcaption class=\"image-caption\">cover (default)</figcaption>\n  </figure>\n  <figure class=\"image\" data-ratio=\"4/3\" data-fit=\"contain\" style=\"width: 180px; background: var(--muted)\">\n    <img\n      src=\"https://images.unsplash.com/photo-1588345921523-c2dcdb7f1dcd?w=800&amp;h=400&amp;fit=crop\"\n      alt=\"Contain\"\n    />\n    <figcaption class=\"image-caption\">contain</figcaption>\n  </figure>\n  <figure class=\"image\" data-ratio=\"4/3\" data-fit=\"none\" style=\"width: 180px; background: var(--muted)\">\n    <img src=\"https://images.unsplash.com/photo-1588345921523-c2dcdb7f1dcd?w=800&amp;h=400&amp;fit=crop\" alt=\"None\" />\n    <figcaption class=\"image-caption\">none</figcaption>\n  </figure>\n</div>\n","individual":false},{"label":"Border Radius","html":"<div style=\"display: flex; gap: 1rem; flex-wrap: wrap; align-items: flex-start\">\n  <figure class=\"image\" data-radius=\"none\" data-ratio=\"1/1\" style=\"width: 100px\">\n    <img\n      src=\"https://images.unsplash.com/photo-1588345921523-c2dcdb7f1dcd?w=400&amp;h=400&amp;fit=crop\"\n      alt=\"No radius\"\n    />\n    <figcaption class=\"image-caption\">none</figcaption>\n  </figure>\n  <figure class=\"image\" data-radius=\"sm\" data-ratio=\"1/1\" style=\"width: 100px\">\n    <img\n      src=\"https://images.unsplash.com/photo-1588345921523-c2dcdb7f1dcd?w=400&amp;h=400&amp;fit=crop\"\n      alt=\"Small radius\"\n    />\n    <figcaption class=\"image-caption\">sm</figcaption>\n  </figure>\n  <figure class=\"image\" data-ratio=\"1/1\" style=\"width: 100px\">\n    <img\n      src=\"https://images.unsplash.com/photo-1588345921523-c2dcdb7f1dcd?w=400&amp;h=400&amp;fit=crop\"\n      alt=\"Default radius\"\n    />\n    <figcaption class=\"image-caption\">default (lg)</figcaption>\n  </figure>\n  <figure class=\"image\" data-radius=\"full\" data-ratio=\"1/1\" style=\"width: 100px\">\n    <img\n      src=\"https://images.unsplash.com/photo-1588345921523-c2dcdb7f1dcd?w=400&amp;h=400&amp;fit=crop\"\n      alt=\"Full radius\"\n    />\n    <figcaption class=\"image-caption\">full</figcaption>\n  </figure>\n</div>\n","individual":false}]
