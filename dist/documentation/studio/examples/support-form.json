[{"label":"Default","html":"<section class=\"mk-support-form\" aria-labelledby=\"sp-title\">\n  <div class=\"mk-support-form-layout\">\n    <form action=\"#\" method=\"post\">\n      <h2 id=\"sp-title\" style=\"margin: 0; font-size: 1.25rem\">Contact support</h2>\n      <div class=\"mk-support-form-field\"\n        ><label class=\"label\" for=\"sp-topic\">Topic</label\n        ><select class=\"select\" id=\"sp-topic\" name=\"topic\" required\n          ><option value=\"\">Choose a topic</option\n          ><option>Billing</option\n          ><option>Sync &amp; offline</option\n          ><option>Account access</option\n          ><option>Something else</option></select\n        ></div\n      >\n      <div class=\"mk-support-form-field\"\n        ><label class=\"label\" for=\"sp-subj\">Subject</label><input class=\"input\" id=\"sp-subj\" name=\"subject\" required\n      /></div>\n      <div class=\"mk-support-form-field\"\n        ><label class=\"label\" for=\"sp-desc\">What happened?</label><textarea\n          class=\"textarea\"\n          id=\"sp-desc\"\n          name=\"description\"\n          rows=\"5\"\n          required\n          placeholder=\"Steps, what you expected, what you saw…\"\n        ></textarea>\n      </div>\n      <fieldset class=\"mk-support-form-priority\"\n        ><legend>Priority</legend\n        ><div\n          ><label><input type=\"radio\" name=\"priority\" value=\"low\" />Low</label\n          ><label><input type=\"radio\" name=\"priority\" value=\"normal\" checked />Normal</label\n          ><label><input type=\"radio\" name=\"priority\" value=\"urgent\" />Urgent</label></div\n        ></fieldset\n      >\n      <label class=\"mk-support-form-drop\" for=\"sp-files\"\n        ><i data-lucide=\"paperclip\"></i><strong>Attach screenshots or logs</strong><span>Up to 5 files, 20 MB each</span\n        ><input id=\"sp-files\" type=\"file\" name=\"files\" multiple\n      /></label>\n      <div class=\"mk-support-form-field\"\n        ><label class=\"label\" for=\"sp-mail\">Reply to</label\n        ><input class=\"input\" id=\"sp-mail\" type=\"email\" name=\"email\" autocomplete=\"email\" required\n      /></div>\n      <button class=\"btn\" type=\"submit\">Send request</button>\n    </form>\n    <aside class=\"mk-support-form-aside\" aria-label=\"Before you write\">\n      <div class=\"mk-support-form-sla\"\n        ><i data-lucide=\"clock\"></i\n        ><span><strong>Usually within 4 hours</strong><br />Mon–Fri, 8:00–20:00 CET</span></div\n      >\n      <h2>These might help</h2>\n      <ul\n        ><li\n          ><a href=\"#\"><i data-lucide=\"file-text\"></i>Sync is stuck on one device</a></li\n        ><li\n          ><a href=\"#\"><i data-lucide=\"file-text\"></i>Change your billing email</a></li\n        ><li\n          ><a href=\"#\"><i data-lucide=\"file-text\"></i>Recover a deleted doc</a></li\n        ></ul\n      >\n      <p>Status: all systems normal.</p>\n    </aside>\n  </div>\n</section>\n","individual":true}]
