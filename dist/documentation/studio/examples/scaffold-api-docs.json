[{"label":"API reference","html":"<!-- the search model's modules import packages by name - this map names their pinned builds -->\n\n<style>\n  /* Acme API: the scaffold's own glue - a three-column reference (navigation, the page, its code) in the system\n     tokens, so a theme or dark mode restyles it. Methods carry a hue each; the code panels stay dark in both modes. */\n  .ad {\n    --ad-code: oklch(0.18 0.012 260);\n    --ad-code-line: oklch(0.3 0.012 260);\n    container-type: inline-size;\n    display: grid;\n    grid-template-rows: auto minmax(0, 1fr);\n    grid-template-columns: minmax(0, 1fr);\n    height: var(--scaffold-height, 50rem);\n    overflow: hidden;\n    background: var(--background);\n    color: var(--foreground);\n    font-family: var(--font-sans);\n  }\n  .ad [hidden] {\n    display: none !important;\n  }\n  .ad-bar {\n    display: flex;\n    align-items: center;\n    gap: 0.75rem;\n    min-height: 3.5rem;\n    padding-inline: 1rem;\n    border-block-end: 1px solid var(--border);\n    background: var(--card);\n  }\n  .ad-brand {\n    display: flex;\n    align-items: center;\n    gap: 0.5rem;\n    color: inherit;\n    font-weight: 600;\n    text-decoration: none;\n    white-space: nowrap;\n    & svg {\n      width: 1.25rem;\n      height: 1.25rem;\n      color: var(--primary);\n    }\n    & small {\n      color: var(--muted-foreground);\n      font-weight: 500;\n    }\n  }\n  .ad-bar .select {\n    width: auto;\n  }\n  .ad-search {\n    display: flex;\n    flex: 1;\n    align-items: center;\n    gap: 0.5rem;\n    max-width: 24rem;\n    margin-inline-start: auto;\n    padding: 0.375rem 0.5rem 0.375rem 0.75rem;\n    border: 1px solid var(--input);\n    border-radius: var(--radius-md);\n    background: var(--background);\n    color: var(--muted-foreground);\n    font: inherit;\n    font-size: 0.875rem;\n    cursor: pointer;\n    & svg {\n      width: 1rem;\n      height: 1rem;\n    }\n    & span {\n      flex: 1;\n      text-align: start;\n    }\n  }\n  .ad-controls {\n    display: flex;\n    align-items: center;\n    gap: 0.5rem;\n  }\n  .ad-menu {\n    display: none;\n  }\n  .ad-body {\n    position: relative;\n    display: grid;\n    grid-template-columns: 16rem minmax(0, 1fr);\n    min-height: 0;\n  }\n  .ad-side {\n    overflow: auto;\n    overscroll-behavior: contain;\n    padding: 1rem 0.75rem 1.5rem;\n    border-inline-end: 1px solid var(--border);\n    background: var(--card);\n  }\n  .ad-side .mk-docs-navigation {\n    font-size: 0.875rem;\n  }\n  .ad-side .mk-docs-navigation a {\n    display: flex;\n    align-items: center;\n    justify-content: flex-start;\n    gap: 0.5rem;\n  }\n  .ad-key-state {\n    display: flex;\n    align-items: center;\n    gap: 0.5rem;\n    margin-block-start: 1.25rem;\n    padding: 0.625rem 0.75rem;\n    border: 1px dashed var(--border);\n    border-radius: var(--radius-md);\n    color: var(--muted-foreground);\n    font-size: 0.8125rem;\n    & i,\n    & svg {\n      width: 0.875rem;\n      height: 0.875rem;\n    }\n  }\n  .ad-main {\n    container: ad-main / inline-size;\n    overflow: auto;\n    overscroll-behavior: contain;\n    scroll-padding-block-start: 1rem;\n  }\n  .ad-page {\n    max-width: 76rem;\n    padding: 1.75rem clamp(1rem, 3cqi, 2.5rem) 3rem;\n  }\n  .ad-version-note {\n    margin-block-end: 1.25rem;\n  }\n  /* the method tag: one hue per method, readable on the page and on the code panel */\n  .ad-method {\n    --ad-h: 150;\n    display: inline-flex;\n    flex: none;\n    align-items: center;\n    align-self: center;\n    justify-content: center;\n    min-width: 3.25rem;\n    padding: 0.0625rem 0.375rem;\n    border-radius: var(--radius-sm);\n    background: oklch(0.6 0.13 var(--ad-h) / 0.14);\n    color: oklch(0.45 0.13 var(--ad-h));\n    font-family: var(--font-mono);\n    font-size: 0.6875rem;\n    font-weight: 600;\n    letter-spacing: 0.02em;\n    &[data-method='POST'] {\n      --ad-h: 255;\n    }\n    &[data-method='PATCH'] {\n      --ad-h: 70;\n    }\n    &[data-method='DELETE'] {\n      --ad-h: 25;\n    }\n  }\n  .dark .ad .ad-method,\n  .ad .ad-code-panel .ad-method {\n    background: oklch(0.7 0.12 var(--ad-h) / 0.18);\n    color: oklch(0.82 0.12 var(--ad-h));\n  }\n  .ad-side .ad-method {\n    min-width: 2.75rem;\n    font-size: 0.625rem;\n  }\n  .ad-article {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) minmax(0, 27rem);\n    gap: 2rem 2.5rem;\n    align-items: start;\n  }\n  .ad-article > .mk-docs-content {\n    max-width: none;\n  }\n  /* sticky, and never taller than the app below its bar: a long answer scrolls inside the aside, not out of reach */\n  .ad-aside {\n    position: sticky;\n    top: 0;\n    display: grid;\n    align-content: start;\n    gap: 1rem;\n    max-block-size: calc(var(--scaffold-height, 50rem) - 3.5rem - 2rem);\n    overflow-y: auto;\n    overscroll-behavior: contain;\n  }\n  .ad-endpoint-line {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 0.5rem;\n    margin-block: 0.5rem 1rem;\n    padding: 0.5rem 0.75rem;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-md);\n    background: var(--muted);\n    font-family: var(--font-mono);\n    font-size: 0.875rem;\n    & code {\n      flex: 1;\n      background: none;\n      overflow-wrap: anywhere;\n    }\n  }\n  .ad-params {\n    display: grid;\n    margin: 0 0 1.5rem;\n    padding: 0;\n    list-style: none;\n    border-block-start: 1px solid var(--border);\n    & > li {\n      display: grid;\n      gap: 0.25rem;\n      padding-block: 0.75rem;\n      border-block-end: 1px solid var(--border);\n    }\n    & p {\n      margin: 0;\n      color: var(--muted-foreground);\n      font-size: 0.875rem;\n    }\n  }\n  .ad-param-head {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: baseline;\n    gap: 0.5rem;\n    font-size: 0.875rem;\n    & code {\n      font-weight: 600;\n    }\n    & .ad-type {\n      color: var(--muted-foreground);\n      font-family: var(--font-mono);\n      font-size: 0.75rem;\n    }\n    & .ad-required {\n      color: var(--destructive);\n      font-size: 0.75rem;\n      font-weight: 500;\n    }\n  }\n  .ad-enum {\n    color: var(--muted-foreground);\n    font-size: 0.8125rem;\n    & code {\n      font-size: 0.75rem;\n    }\n  }\n  .ad-responses {\n    display: grid;\n    gap: 0.5rem;\n    margin: 0 0 1.5rem;\n    padding: 0;\n    list-style: none;\n    & li {\n      display: flex;\n      gap: 0.75rem;\n      align-items: baseline;\n      font-size: 0.875rem;\n    }\n  }\n  .ad-status {\n    --ad-h: 150;\n    min-width: 2.5rem;\n    color: oklch(0.5 0.13 var(--ad-h));\n    font-family: var(--font-mono);\n    font-weight: 600;\n    &[data-class='4'] {\n      --ad-h: 40;\n    }\n    &[data-class='5'] {\n      --ad-h: 25;\n    }\n  }\n  .dark .ad .ad-status,\n  .ad .ad-code-panel .ad-status {\n    color: oklch(0.8 0.13 var(--ad-h));\n  }\n  /* the try-it form */\n  .ad-try {\n    margin-block-end: 1.5rem;\n  }\n  .ad-try .card-content {\n    display: grid;\n    gap: 0.875rem;\n  }\n  .ad-try-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));\n    gap: 0.75rem 1rem;\n  }\n  .ad-field {\n    display: grid;\n    gap: 0.375rem;\n    & .label {\n      font-family: var(--font-mono);\n      font-size: 0.8125rem;\n    }\n  }\n  .ad-try-actions {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 0.5rem;\n  }\n  /* code panels: the request samples (a Code Example block) and the live response */\n  .ad-aside .mk-code-block {\n    margin: 0;\n  }\n  .ad .mk-code-block:has(input[value='curl']:checked) [data-tab='curl'],\n  .ad .mk-code-block:has(input[value='js']:checked) [data-tab='js'],\n  .ad .mk-code-block:has(input[value='python']:checked) [data-tab='python'] {\n    display: block;\n  }\n  /* an empty painted line keeps its height */\n  .ad .mk-code-block code > span:empty::before {\n    content: ' ';\n  }\n  .ad .mk-code-block pre {\n    max-height: 22rem;\n    overflow: auto;\n  }\n  .ad-code-panel {\n    overflow: hidden;\n    border-radius: var(--radius-lg);\n    background: var(--ad-code);\n    color: oklch(0.92 0 0);\n    font-size: 0.8125rem;\n  }\n  .ad-code-head {\n    display: flex;\n    align-items: center;\n    gap: 0.625rem;\n    min-height: 2.5rem;\n    padding-inline: 1rem;\n    border-block-end: 1px solid var(--ad-code-line);\n    color: oklch(0.75 0 0);\n    font-size: 0.75rem;\n    & strong {\n      margin-inline-end: auto;\n      color: oklch(0.92 0 0);\n      font-weight: 600;\n    }\n    & .ad-meta {\n      font-family: var(--font-mono);\n    }\n  }\n  .ad-code-panel pre {\n    max-height: 22rem;\n    margin: 0;\n    padding: 0.875rem 1rem;\n    overflow: auto;\n    background: none;\n    color: inherit;\n    font-family: var(--font-mono);\n    font-size: 0.8125rem;\n    line-height: 1.6;\n    white-space: pre;\n  }\n  .ad-code-panel .ad-empty {\n    margin: 0;\n    padding: 1rem;\n    color: oklch(0.72 0 0);\n    font-size: 0.8125rem;\n  }\n  /* defuss-rpc: every call is POST /rpc - the tag says RPC, or STREAM for a generator */\n  .ad-method[data-method='RPC'] {\n    --ad-h: 300;\n  }\n  .ad-method[data-method='STREAM'] {\n    --ad-h: 200;\n  }\n  /* each page as Markdown and JSON, for readers that do not run the app */\n  .ad-doc-links {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 0.375rem 0.75rem;\n    margin: -0.5rem 0 1.25rem;\n    color: var(--muted-foreground);\n    font-size: 0.8125rem;\n    & a {\n      display: inline-flex;\n      align-items: center;\n      gap: 0.25rem;\n      color: inherit;\n      text-underline-offset: 3px;\n    }\n    & svg {\n      width: 0.875rem;\n      height: 0.875rem;\n    }\n  }\n  .ad-signature {\n    margin: 0 0 1.25rem;\n    padding: 0.75rem 1rem;\n    overflow-x: auto;\n    border-radius: var(--radius-lg);\n    background: var(--ad-code);\n    color: oklch(0.92 0 0);\n    font-family: var(--font-mono);\n    font-size: 0.8125rem;\n    white-space: pre;\n  }\n  .ad-badges {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 0.375rem;\n    margin-block-end: 1rem;\n  }\n  .ad-rpc-wide {\n    grid-column: 1 / -1;\n  }\n  /* trees as high as their rows (rpcFit), one row a fixed height */\n  .ad-rpc-tree,\n  .ad-rpc-result .property-tree {\n    --property-tree-row-height: 1.75rem;\n  }\n  /* a listing Shiki has not painted (offline, or still loading) keeps the inset of a painted line */\n  .ad .mk-code-block code:not(:has(> span)) {\n    padding-inline: 1rem;\n    white-space: pre;\n  }\n  .ad-rpc-frames {\n    display: grid;\n    gap: 0.25rem;\n    max-block-size: 10rem;\n    margin: 0 0 0.75rem;\n    padding: 0;\n    overflow: auto;\n    list-style: none;\n    font-family: var(--font-mono);\n    font-size: 0.75rem;\n    & li {\n      padding: 0.25rem 0.5rem;\n      border-radius: var(--radius-sm);\n      background: var(--muted);\n      overflow-wrap: anywhere;\n    }\n  }\n  .ad-rpc-error {\n    margin: 0 0 0.75rem;\n    color: var(--destructive);\n    font-size: 0.8125rem;\n  }\n  .ad .mk-code-block:has(input[value='ts']:checked) [data-tab='ts'],\n  .ad .mk-code-block:has(input[value='fetch']:checked) [data-tab='fetch'],\n  .ad .mk-code-block:has(input[value='rcurl']:checked) [data-tab='rcurl'] {\n    display: block;\n  }\n  /* the resource and home pages */\n  .ad-cards {\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));\n    gap: 1rem;\n    margin-block: 1rem 2rem;\n  }\n  .ad-cards .card {\n    color: inherit;\n    text-decoration: none;\n    transition: border-color 0.15s;\n    &:hover {\n      border-color: var(--ring);\n    }\n  }\n  .ad-ops {\n    display: grid;\n    margin: 0 0 1.5rem;\n    padding: 0;\n    list-style: none;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    & li + li {\n      border-block-start: 1px solid var(--border);\n    }\n    & a {\n      display: grid;\n      grid-template-columns: auto minmax(0, 1fr) auto;\n      gap: 0.75rem;\n      align-items: center;\n      padding: 0.625rem 0.875rem;\n      color: inherit;\n      text-decoration: none;\n      &:hover {\n        background: var(--muted);\n      }\n    }\n    & code {\n      color: var(--muted-foreground);\n      font-size: 0.8125rem;\n      overflow-wrap: anywhere;\n    }\n  }\n  .ad .mk-docs-content-prose pre {\n    padding: 0.75rem 1rem;\n    border-radius: var(--radius-md);\n    background: var(--ad-code);\n    color: oklch(0.92 0 0);\n    overflow: auto;\n  }\n  .ad .mk-docs-content-prose pre code {\n    background: none;\n    color: inherit;\n  }\n  /* the search palette: a method and a path beside each hit, the timing below */\n  .ad .command .command-item {\n    display: flex;\n    align-items: center;\n    gap: 0.625rem;\n    color: inherit;\n    text-decoration: none;\n    & .ad-hit-path {\n      margin-inline-start: auto;\n      color: var(--muted-foreground);\n      font-family: var(--font-mono);\n      font-size: 0.75rem;\n    }\n  }\n  .ad-find-status {\n    margin: 0;\n    padding: 0.5rem 0.875rem;\n    border-block-start: 1px solid var(--border);\n    color: var(--muted-foreground);\n    font-size: 0.75rem;\n  }\n  /* narrower: the code column goes under the page, then the navigation becomes a drawer behind the menu button */\n  @container ad-main (width < 56rem) {\n    .ad-article {\n      grid-template-columns: minmax(0, 1fr);\n    }\n    .ad-aside {\n      position: static;\n    }\n  }\n  @container (width < 48rem) {\n    .ad-menu {\n      display: inline-flex;\n    }\n    .ad-search kbd,\n    .ad-brand small,\n    .ad-bar .select {\n      display: none;\n    }\n    /* the search and Authorize shrink to their icons; their labels stay the accessible names */\n    .ad-search {\n      flex: none;\n      padding: 0.5rem;\n    }\n    .ad-search span,\n    .ad-controls [data-ad-authorize] span {\n      position: absolute;\n      width: 1px;\n      height: 1px;\n      overflow: hidden;\n      clip-path: inset(50%);\n      white-space: nowrap;\n    }\n    .ad-bar {\n      gap: 0.375rem;\n      padding-inline: 0.5rem;\n    }\n    .ad-body {\n      grid-template-columns: minmax(0, 1fr);\n    }\n    .ad-side {\n      position: absolute;\n      inset: 0 auto 0 0;\n      z-index: 5;\n      width: min(18rem, 85%);\n      box-shadow: var(--shadow-lg);\n      translate: -100% 0;\n      visibility: hidden;\n      transition:\n        translate 0.2s,\n        visibility 0.2s;\n    }\n    .ad[data-menu-open] .ad-side {\n      translate: 0 0;\n      visibility: visible;\n    }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .ad-side {\n      transition: none;\n    }\n  }\n</style>\n<div class=\"ad\" data-ad data-i18n-component>\n  <header class=\"ad-bar\">\n    <button\n      class=\"btn ad-menu\"\n      type=\"button\"\n      data-variant=\"ghost\"\n      data-size=\"icon\"\n      data-ad-menu\n      aria-expanded=\"false\"\n      aria-label=\"Menu\"\n      data-i18n-aria-label-en=\"Menu\"\n      data-i18n-aria-label-de=\"Menü\"\n    >\n      <i data-lucide=\"menu\"></i>\n    </button>\n    <a class=\"ad-brand\" href=\"#/\" data-router-link\n      ><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\">\n        <path d=\"m18 16 4-4-4-4\" />\n        <path d=\"m6 8-4 4 4 4\" />\n        <path d=\"m14.5 4-5 16\" /></svg\n      >Acme API <small data-i18n-target=\"brand-sub\">reference</small></a\n    >\n    <select\n      class=\"select\"\n      data-size=\"sm\"\n      data-ad-version\n      aria-label=\"API version\"\n      data-i18n-aria-label-en=\"API version\"\n      data-i18n-aria-label-de=\"API-Version\"\n    >\n      <option value=\"v4\" data-i18n-target=\"version-latest\">v4 (latest)</option>\n      <option value=\"v3\">v3</option>\n    </select>\n    <button class=\"ad-search\" type=\"button\" data-command-trigger=\"ad-find\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\">\n        <circle cx=\"11\" cy=\"11\" r=\"8\" />\n        <path d=\"m21 21-4.3-4.3\" /></svg\n      ><span data-i18n-target=\"search\">Search the API</span\n      ><kbd class=\"kbd-group\"><kbd class=\"kbd\">⌘</kbd><kbd class=\"kbd\">K</kbd></kbd>\n    </button>\n    <div class=\"ad-controls\">\n      <button class=\"btn\" type=\"button\" data-variant=\"outline\" data-size=\"sm\" data-ad-authorize>\n        <i data-lucide=\"key-round\"></i><span data-i18n-target=\"authorize\" data-ad-key-off>Authorize</span\n        ><span data-i18n-target=\"authorized\" data-ad-key-on hidden>Authorized</span>\n      </button>\n      <div\n        class=\"language-switcher\"\n        data-app-locale\n        role=\"group\"\n        aria-label=\"Language\"\n        data-i18n-aria-label-en=\"Language\"\n        data-i18n-aria-label-de=\"Sprache\"\n        data-languages=\"en de\"\n        data-value=\"en\"\n        data-size=\"sm\"\n        data-display=\"code\"\n        data-align=\"end\"\n      ></div>\n      <label class=\"swap\" data-variant=\"rotate\" data-size=\"sm\">\n        <input\n          type=\"checkbox\"\n          data-ad-mode\n          aria-label=\"Dark mode\"\n          data-i18n-aria-label-en=\"Dark mode\"\n          data-i18n-aria-label-de=\"Dunkler Modus\"\n        />\n        <span class=\"swap-on\" aria-hidden=\"true\"><i data-lucide=\"moon\"></i></span>\n        <span class=\"swap-off\" aria-hidden=\"true\"><i data-lucide=\"sun\"></i></span>\n      </label>\n    </div>\n  </header>\n  <div class=\"ad-body\">\n    <aside class=\"ad-side\">\n      <!-- the navigation is written from the data block: the guides, then each resource and its endpoints -->\n      <nav\n        class=\"mk-docs-navigation\"\n        data-ad-nav\n        aria-label=\"API reference\"\n        data-i18n-aria-label-en=\"API reference\"\n        data-i18n-aria-label-de=\"API-Referenz\"\n      ></nav>\n      <p class=\"ad-key-state\">\n        <span class=\"badge\" data-variant=\"secondary\" data-i18n-target=\"sandbox\">Sandbox</span\n        ><span data-i18n-target=\"sandbox-note\">Requests go to the sandbox in this page</span>\n      </p>\n    </aside>\n    <main class=\"ad-main\" data-ad-main>\n      <div class=\"ad-page\">\n        <div class=\"alert ad-version-note\" data-variant=\"destructive\" role=\"status\" data-ad-v3 hidden>\n          <i class=\"alert-icon\" data-lucide=\"triangle-alert\"></i>\n          <div class=\"alert-content\">\n            <h2 class=\"alert-title\" data-i18n-target=\"v3-title\">You are reading v3</h2>\n            <p class=\"alert-description\" data-i18n-target=\"v3-text\">\n              v3 stops answering on 31 March 2027. The samples call /v3 - switch to v4 for new work.\n            </p>\n          </div>\n        </div>\n        <!-- the guides and the home page -->\n        <section data-ad-view=\"guide\" hidden>\n          <article class=\"mk-docs-content\" aria-labelledby=\"ad-guide-title\">\n            <nav class=\"breadcrumb\" aria-label=\"Breadcrumb\">\n              <ol class=\"breadcrumb-list\">\n                <li class=\"breadcrumb-item\"><a class=\"breadcrumb-link\" href=\"#/\" data-router-link>Acme API</a></li>\n                <li class=\"breadcrumb-separator\" aria-hidden=\"true\">/</li>\n                <li class=\"breadcrumb-item\">\n                  <span class=\"breadcrumb-page\" aria-current=\"page\" data-ad-guide-crumb></span>\n                </li>\n              </ol>\n            </nav>\n            <h1 class=\"mk-docs-content-title\" id=\"ad-guide-title\" data-ad-guide-title></h1>\n            <p class=\"ad-doc-links\" data-ad-doc-links></p>\n            <p class=\"mk-docs-content-lead\" data-ad-guide-lead></p>\n            <div class=\"mk-docs-content-prose\" data-ad-guide-body></div>\n            <div class=\"ad-cards\" data-ad-home-cards></div>\n            <nav class=\"mk-docs-content-pager\" aria-label=\"Pagination\" data-ad-pager></nav>\n          </article>\n        </section>\n        <!-- a resource: its object and its endpoints -->\n        <section data-ad-view=\"resource\" hidden>\n          <div class=\"ad-article\">\n            <article class=\"mk-docs-content\" aria-labelledby=\"ad-res-title\">\n              <nav class=\"breadcrumb\" aria-label=\"Breadcrumb\">\n                <ol class=\"breadcrumb-list\">\n                  <li class=\"breadcrumb-item\">\n                    <a class=\"breadcrumb-link\" href=\"#/\" data-router-link data-i18n-target=\"crumb-reference\"\n                      >API reference</a\n                    >\n                  </li>\n                  <li class=\"breadcrumb-separator\" aria-hidden=\"true\">/</li>\n                  <li class=\"breadcrumb-item\">\n                    <span class=\"breadcrumb-page\" aria-current=\"page\" data-ad-res-crumb></span>\n                  </li>\n                </ol>\n              </nav>\n              <h1 class=\"mk-docs-content-title\" id=\"ad-res-title\" data-ad-res-title></h1>\n              <p class=\"ad-doc-links\" data-ad-doc-links></p>\n              <p class=\"mk-docs-content-lead\" data-ad-res-lead></p>\n              <h2 class=\"text-lg font-semibold mt-6 mb-3\" data-i18n-target=\"h-endpoints\">Endpoints</h2>\n              <ul class=\"ad-ops\" data-ad-res-ops></ul>\n              <h2 class=\"text-lg font-semibold mb-3\" data-ad-res-object></h2>\n              <ul class=\"ad-params\" data-ad-res-fields></ul>\n              <nav class=\"mk-docs-content-pager\" aria-label=\"Pagination\" data-ad-pager></nav>\n            </article>\n            <aside class=\"ad-aside\">\n              <div class=\"ad-code-panel\">\n                <div class=\"ad-code-head\"><strong data-ad-res-example></strong><span class=\"ad-meta\">JSON</span></div>\n                <pre data-lang=\"json\" data-ad-res-json></pre>\n              </div>\n            </aside>\n          </div>\n      