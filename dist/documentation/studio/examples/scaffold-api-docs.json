alue=\"rcurl\" />curl</label\n                    ><label><input type=\"radio\" name=\"ad-rpc-lang\" value=\"fetch\" />fetch</label>\n                  </div>\n                  <button\n                    class=\"mk-code-block-copy\"\n                    type=\"button\"\n                    data-ad-rpc-copy\n                    aria-label=\"Copy code\"\n                    data-i18n-aria-label-en=\"Copy code\"\n                    data-i18n-aria-label-de=\"Code kopieren\"\n                  >\n                    <i data-lucide=\"copy\"></i>\n                  </button>\n                </div>\n                <pre data-tab=\"ts\" data-lang=\"ts\"><code data-ad-rsample=\"ts\"></code></pre>\n                <pre data-tab=\"rcurl\" data-lang=\"bash\"><code data-ad-rsample=\"curl\"></code></pre>\n                <pre data-tab=\"fetch\" data-lang=\"js\"><code data-ad-rsample=\"js\"></code></pre>\n                <span class=\"mk-code-block-status\" role=\"status\"></span>\n              </figure>\n              <div class=\"card ad-rpc-result\" data-ad-rpc-response aria-live=\"polite\">\n                <div class=\"card-header\">\n                  <h2 class=\"card-title\" data-i18n-target=\"h-answer\">Answer</h2>\n                  <p class=\"card-description\">\n                    <span class=\"ad-status\" data-ad-rpc-status></span> <span class=\"ad-meta\" data-ad-rpc-time></span>\n                  </p>\n                </div>\n                <div class=\"card-content\">\n                  <p class=\"ad-empty\" data-ad-rpc-empty data-i18n-target=\"answer-empty\"\n                    >Send the call to see its answer.</p\n                  >\n                  <p class=\"ad-rpc-error\" data-ad-rpc-error hidden></p>\n                  <ol class=\"ad-rpc-frames\" data-ad-rpc-frames hidden></ol>\n                  <div\n                    class=\"property-tree\"\n                    data-readonly\n                    data-ad-rpc-result\n                    aria-labe