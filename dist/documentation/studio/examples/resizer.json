[{"label":"Resizer (divider)","html":"<div\n  class=\"resizer\"\n  data-variant=\"divider\"\n  data-handles=\"e\"\n  data-axis=\"w\"\n  data-keys=\"edge\"\n  data-min=\"140\"\n  data-max=\"360\"\n>\n  <nav\n    style=\"\n      width: 12rem;\n      height: 100%;\n      padding: 0.75rem;\n      border-inline-end: 1px solid var(--border);\n      background: var(--muted);\n      box-sizing: border-box;\n    \"\n  >\n    <p style=\"margin: 0 0 0.5rem; font-weight: 600\">Inbox</p>\n    <p style=\"margin: 0; color: var(--muted-foreground); font-size: 0.875rem\"\n      >Drag my right edge, or Tab to it and press ← / →. Double-click it to reset.</p\n    >\n  </nav>\n</div>\n","individual":true},{"label":"Pixel-perfect","html":"<div class=\"resizer\" data-handles=\"se\" data-min=\"120\">\n  <div class=\"card\" style=\"width: 20rem; height: 10rem; padding: 1rem\">\n    <h3 class=\"card-title\">Panel</h3>\n    <p class=\"card-description\" style=\"margin-top: 0.5rem\"\n      >Drag the corner. The runtime writes style.width / style.height - pixel-perfect, no quantization.</p\n    >\n  </div>\n</div>\n","individual":true},{"label":"All sides + corners","html":"<div class=\"resizer\" data-handles=\"all\" data-min=\"120\">\n  <div class=\"card\" style=\"width: 18rem; height: 12rem; padding: 1rem\">\n    <h3 class=\"card-title\">Canvas</h3>\n    <p class=\"card-description\" style=\"margin-top: 0.5rem\"\n      >Edges resize one axis, corners both. Grab any of the 8 chips.</p\n    >\n  </div>\n</div>\n","individual":true},{"label":"Width only","html":"<div class=\"resizer\" data-handles=\"w e\" data-axis=\"w\" data-min=\"140\" data-max=\"520\">\n  <div class=\"card\" style=\"width: 16rem; padding: 1rem\">\n    <h3 class=\"card-title\">Report</h3>\n    <p class=\"card-description\" style=\"margin-top: 0.5rem\"\n      >Height follows the text; only the horizontal edges respond.</p\n    >\n  </div>\n</div>\n","individual":true},{"label":"Keys move the edge","html":"<div\n  class=\"resizer\"\n  data-handles=\"w\"\n  data-axis=\"w\"\n  data-keys=\"edge\"\n  data-min=\"140\"\n  data-max=\"520\"\n  style=\"margin-inline-start: auto\"\n>\n  <div class=\"card\" style=\"width: 16rem; padding: 1rem\">\n    <h3 class=\"card-title\">Inspector</h3>\n    <p class=\"card-description\" style=\"margin-top: 0.5rem\">Tab to the left edge, then press ← / →.</p>\n  </div>\n</div>\n","individual":true},{"label":"Class-based sizing","html":"<div class=\"resizer\" data-handles=\"all\" data-resize-mode=\"classes\">\n  <div class=\"card w-64 h-40\" style=\"padding: 1rem\">\n    <h3 class=\"card-title\">Card</h3>\n    <p class=\"card-description\" style=\"margin-top: 0.5rem\"\n      >Authored w-64 h-40. Drags snap to the nearest w-N / h-N token (4 px steps) - no inline styles.</p\n    >\n  </div>\n</div>\n","individual":true},{"label":"Controlled","html":"<div class=\"resizer\" data-handles=\"all\" data-resize-mode=\"controlled\" data-min=\"120\">\n  <div class=\"card\" style=\"width: 18rem; height: 11rem; padding: 1rem\">\n    <h3 class=\"card-title\">Consumer owns the box</h3>\n    <p class=\"card-description\" style=\"margin-top: 0.5rem\"\n      >Live size below - updated from the <code>resizer-resize</code> event, not from any style the component writes.</p\n    >\n    <output class=\"mono-meta\" id=\"rs-controlled\" style=\"display: block; margin-top: 0.5rem\">288 × 176</output>\n  </div>\n</div>\n","individual":true},{"label":"Sidebar - pixels","html":"<div class=\"resizer\" data-handles=\"all\" data-min=\"220\" data-max=\"560\" data-min-h=\"160\" data-max-h=\"480\">\n  <aside\n    class=\"app-sidebar\"\n    data-state-name=\"default\"\n    style=\"width: 24rem; height: 18rem; border-radius: var(--radius-lg)\"\n  >\n    <div class=\"sidebar-header\">\n      <a class=\"sidebar-logo\" href=\"#\">\n        <i data-lucide=\"command\" style=\"width: 1rem; height: 1rem\"></i>\n        <span class=\"sidebar-logo-text\">MyApp</span>\n      </a>\n    </div>\n    <div class=\"sidebar-content\">\n      <nav class=\"sidebar-nav\">\n        <a class=\"sidebar-link\" href=\"#\" aria-current=\"page\"><i data-lucide=\"home\"></i><span>Dashboard</span></a>\n        <a class=\"sidebar-link\" href=\"#\"><i data-lucide=\"inbox\"></i><span>Inbox</span></a>\n        <a class=\"sidebar-link\" href=\"#\"><i data-lucide=\"folder\"></i><span>Projects</span></a>\n      </nav>\n    </div>\n  </aside>\n</div>\n","individual":true},{"label":"Sidebar - classes","html":"<div\n  class=\"resizer\"\n  data-handles=\"all\"\n  data-resize-mode=\"classes\"\n  data-min=\"220\"\n  data-max=\"560\"\n  data-min-h=\"160\"\n  data-max-h=\"480\"\n>\n  <aside class=\"app-sidebar w-96 h-72\" data-state-name=\"default\" style=\"border-radius: var(--radius-lg)\">\n    <div class=\"sidebar-header\">\n      <a class=\"sidebar-logo\" href=\"#\">\n        <i data-lucide=\"command\" style=\"width: 1rem; height: 1rem\"></i>\n        <span class=\"sidebar-logo-text\">MyApp</span>\n      </a>\n    </div>\n    <div class=\"sidebar-content\">\n      <nav class=\"sidebar-nav\">\n        <a class=\"sidebar-link\" href=\"#\" aria-current=\"page\"><i data-lucide=\"home\"></i><span>Dashboard</span></a>\n        <a class=\"sidebar-link\" href=\"#\"><i data-lucide=\"inbox\"></i><span>Inbox</span></a>\n        <a class=\"sidebar-link\" href=\"#\"><i data-lucide=\"folder\"></i><span>Projects</span></a>\n      </nav>\n    </div>\n  </aside>\n</div>\n","individual":true},{"label":"Split-pane divider","html":"<div\n  style=\"\n    display: flex;\n    height: 14rem;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    overflow: hidden;\n  \"\n>\n  <div\n    class=\"resizer\"\n    data-variant=\"divider\"\n    data-handles=\"e\"\n    data-axis=\"w\"\n    data-keys=\"edge\"\n    data-min=\"140\"\n    data-max=\"360\"\n  >\n    <nav\n      style=\"\n        width: 12rem;\n        height: 100%;\n        padding: 0.75rem;\n        border-inline-end: 1px solid var(--border);\n        background: var(--muted);\n        box-sizing: border-box;\n      \"\n    >\n      <p style=\"margin: 0 0 0.5rem; font-weight: 600\">Inbox</p>\n      <p style=\"margin: 0; color: var(--muted-foreground); font-size: 0.875rem\"\n        >Drag my right edge, or Tab to it and press ← / →. Double-click it to reset.</p\n      >\n    </nav>\n  </div>\n  <main style=\"flex: 1; padding: 0.75rem\">Message</main>\n</div>\n","individual":false}]
