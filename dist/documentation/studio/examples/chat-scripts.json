[{"label":"A support bot","html":"<div class=\"flex flex-col gap-2\">\n  <section class=\"session\" id=\"cs-support\" aria-label=\"Support chat\" style=\"height: 30rem\">\n    <div class=\"session-viewport\" aria-label=\"Messages\"><div class=\"session-content\"></div></div>\n    <div class=\"session-footer\">\n      <form class=\"textarea-group\" data-layout=\"inline\" id=\"cs-support-composer\" aria-label=\"Message composer\">\n        <textarea class=\"textarea\" rows=\"1\" aria-label=\"Message\" placeholder=\"Type a message ...\"></textarea>\n        <button class=\"btn\" type=\"submit\" data-size=\"sm\">Send</button>\n      </form>\n    </div>\n  </section>\n  <div class=\"flex gap-2\">\n    <button class=\"btn\" type=\"button\" data-variant=\"outline\" data-size=\"sm\" id=\"cs-support-back\">Back</button>\n    <button class=\"btn\" type=\"button\" data-variant=\"ghost\" data-size=\"sm\" id=\"cs-support-restart\">Restart</button>\n  </div>\n</div>\n","individual":false},{"label":"A pizza order","html":"<section class=\"session\" id=\"cs-pizza\" aria-label=\"Pizza order\" style=\"height: 34rem\">\n  <div class=\"session-viewport\" aria-label=\"Messages\"><div class=\"session-content\"></div></div>\n</section>\n","individual":false},{"label":"Getting to know you","html":"<section class=\"session\" id=\"cs-free\" aria-label=\"Onboarding\" style=\"height: 26rem\">\n  <div class=\"session-viewport\" aria-label=\"Messages\"><div class=\"session-content\"></div></div>\n  <div class=\"session-footer\">\n    <form class=\"textarea-group\" data-layout=\"inline\" id=\"cs-free-composer\" aria-label=\"Message composer\">\n      <textarea class=\"textarea\" rows=\"1\" aria-label=\"Message\" placeholder=\"Your answer ...\"></textarea>\n      <button class=\"btn\" type=\"submit\" data-size=\"sm\">Send</button>\n    </form>\n  </div>\n</section>\n","individual":false},{"label":"Hooks","html":"<div class=\"flex flex-wrap gap-4\">\n  <div class=\"flex flex-col gap-2\" style=\"flex: 1 1 18rem; min-width: 0\">\n    <ol\n      class=\"text-sm\"\n      id=\"cs-hooks-turns\"\n      style=\"margin: 0; padding-inline-start: 1.25rem; display: grid; gap: 0.5rem\"\n    ></ol>\n    <div id=\"cs-hooks-card\"></div>\n  </div>\n  <pre class=\"text-xs\" id=\"cs-hooks-log\" style=\"flex: 1 1 14rem; white-space: pre-wrap; margin: 0\"></pre>\n</div>\n","individual":false},{"label":"Validate","html":"<pre class=\"text-xs\" id=\"cs-validate\" style=\"white-space: pre-wrap; margin: 0\"></pre>\n","individual":false}]
