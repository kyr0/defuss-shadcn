[{"label":"Taskbar","html":"<nav class=\"taskbar\" data-taskbar-for=\"tb-desk-l\" data-position=\"left\" aria-label=\"Taskbar on the left\">\n  <button class=\"start-button\" data-variant=\"icon\" type=\"button\" aria-haspopup=\"menu\">\n    <i data-lucide=\"layout-grid\" class=\"start-button-icon\"></i>\n    <span class=\"start-button-label\">Start</span>\n  </button>\n  <div class=\"taskbar-windows\" role=\"group\" aria-label=\"Open windows\"></div>\n</nav>\n","individual":true},{"label":"A desktop","html":"<div class=\"grid gap-2\">\n  <label class=\"flex items-center gap-2 text-sm\"\n    >Look\n    <select class=\"select\" data-look style=\"width: auto\">\n      <option value=\"\">Modern</option>\n      <option value=\"win7\">7</option>\n      <option value=\"winxp\">XP</option>\n      <option value=\"win98\">98</option>\n      <option value=\"win95\">95</option>\n    </select></label\n  >\n\n  <div class=\"desktop\" style=\"height: 26rem; border-radius: var(--radius-lg)\">\n    <div\n      class=\"window-desktop window-manager\"\n      id=\"tb-desk\"\n      style=\"--desktop-wallpaper: linear-gradient(160deg, oklch(0.55 0.1 240), oklch(0.35 0.08 200))\"\n    >\n      <div\n        class=\"desktop-manager\"\n        id=\"tb-icons\"\n        data-on-wallpaper\n        role=\"listbox\"\n        aria-multiselectable=\"true\"\n        aria-label=\"Desktop\"\n      >\n        <div class=\"desktop-icon\" role=\"option\" data-value=\"tb-notes\">\n          <span class=\"desktop-icon-image\"><span class=\"desktop-glyph\" data-glyph=\"text\"></span></span>\n          <span class=\"desktop-icon-label\">Notes</span>\n        </div>\n        <div class=\"desktop-icon\" role=\"option\" data-value=\"tb-files\">\n          <span class=\"desktop-icon-image\"><span class=\"desktop-glyph\" data-glyph=\"folder\"></span></span>\n          <span class=\"desktop-icon-label\">Files</span>\n        </div>\n        <div class=\"desktop-icon\" role=\"option\" data-value=\"tb-calc\">\n          <span class=\"desktop-icon-image\"><span class=\"desktop-glyph\" data-glyph=\"calculator\"></span></span>\n          <span class=\"desktop-icon-label\">Calculator</span>\n        </div>\n      </div>\n      <dialog class=\"window\" id=\"tb-notes\" open style=\"--window-x: 8rem; --window-y: 1.5rem; --window-w: 17rem\">\n        <header class=\"window-titlebar\">\n          <span class=\"window-icon desktop-glyph\" data-glyph=\"text\"></span>\n          <h2 class=\"window-title\">Notes</h2>\n          <form method=\"dialog\" class=\"window-controls\">\n            <button type=\"button\" class=\"window-minimize\" aria-label=\"Minimize\"></button>\n            <button type=\"button\" class=\"window-maximize\" aria-label=\"Maximize\"></button>\n            <button class=\"window-close\" aria-label=\"Close\"></button>\n          </form>\n        </header>\n        <div class=\"window-body\"><textarea class=\"textarea\" aria-label=\"Note\">Buy milk</textarea></div>\n      </dialog>\n      <dialog class=\"window\" id=\"tb-files\" style=\"--window-x: 14rem; --window-y: 4rem; --window-w: 16rem\">\n        <header class=\"window-titlebar\">\n          <span class=\"window-icon desktop-glyph\" data-glyph=\"folder\"></span>\n          <h2 class=\"window-title\">Files</h2>\n          <form method=\"dialog\" class=\"window-controls\">\n            <button type=\"button\" class=\"window-minimize\" aria-label=\"Minimize\"></button>\n            <button type=\"button\" class=\"window-maximize\" aria-label=\"Maximize\"></button>\n            <button class=\"window-close\" aria-label=\"Close\"></button>\n          </form>\n        </header>\n        <div class=\"window-body\">Documents, Pictures, Music</div>\n      </dialog>\n      <dialog class=\"window\" id=\"tb-calc\" style=\"--window-x: 20rem; --window-y: 2rem; --window-w: 12rem\">\n        <header class=\"window-titlebar\">\n          <span class=\"window-icon desktop-glyph\" data-glyph=\"calculator\"></span>\n          <h2 class=\"window-title\">Calculator</h2>\n          <form method=\"dialog\" class=\"window-controls\">\n            <button type=\"button\" class=\"window-minimize\" aria-label=\"Minimize\"></button>\n            <button class=\"window-close\" aria-label=\"Close\"></button>\n          </form>\n        </header>\n        <div class=\"window-body\">0</div>\n      </dialog>\n    </div>\n    <nav class=\"taskbar\" id=\"tb-bar\" data-state-demo data-taskbar-for=\"tb-desk\" aria-label=\"Taskbar\">\n      <button class=\"start-button\" type=\"button\" popovertarget=\"tb-start\" aria-haspopup=\"menu\">\n        <span class=\"start-button-icon desktop-glyph\" data-glyph=\"flag\"></span>\n        <span class=\"start-button-label\">Start</span>\n      </button>\n      <div class=\"taskbar-windows\" role=\"group\" aria-label=\"Open windows\"></div>\n      <div class=\"tray\" role=\"group\" aria-label=\"Notification area\">\n        <button class=\"tray-item\" type=\"button\" aria-label=\"Network\"><i data-lucide=\"wifi\"></i></button>\n        <button class=\"tray-item\" type=\"button\" aria-label=\"Volume\"><i data-lucide=\"volume-2\"></i></button>\n        <time class=\"tray-clock\"></time>\n        <button class=\"tray-show-desktop\" type=\"button\" aria-label=\"Show desktop\"></button>\n      </div>\n    </nav>\n    <div class=\"start-menu\" id=\"tb-start\" popover aria-label=\"Start\">\n      <label class=\"start-menu-search\">\n        <i data-lucide=\"search\"></i>\n        <input type=\"search\" placeholder=\"Search apps\" aria-label=\"Search apps\" />\n      </label>\n      <div class=\"start-menu-list\" role=\"group\" aria-label=\"All apps\">\n        <button class=\"start-menu-item\" type=\"button\" data-value=\"tb-notes\">\n          <span class=\"start-menu-icon\"><span class=\"desktop-glyph\" data-glyph=\"text\"></span></span>\n          <span class=\"start-menu-label\">Notes</span>\n        </button>\n        <button class=\"start-menu-item\" type=\"button\" data-value=\"tb-files\">\n          <span class=\"start-menu-icon\"><span class=\"desktop-glyph\" data-glyph=\"folder\"></span></span>\n          <span class=\"start-menu-label\">Files</span>\n        </button>\n        <button class=\"start-menu-item\" type=\"button\" data-value=\"tb-calc\">\n          <span class=\"start-menu-icon\"><span class=\"desktop-glyph\" data-glyph=\"calculator\"></span></span>\n          <span class=\"start-menu-label\">Calculator</span>\n        </button>\n      </div>\n    </div>\n  </div>\n</div>\n","individual":false},{"label":"Edges and centring","html":"<div class=\"grid gap-3\" style=\"grid-template-columns: 1fr 1fr\">\n  <div class=\"desktop\" style=\"height: 12rem; min-height: 0; border-radius: var(--radius-md)\">\n    <div class=\"window-desktop window-manager\" id=\"tb-desk-l\">\n      <dialog class=\"window\" open style=\"--window-x: 0.75rem; --window-y: 0.75rem; --window-w: 9rem\">\n        <header class=\"window-titlebar\"\n          ><span class=\"window-icon desktop-glyph\" data-glyph=\"mail\"></span><h2 class=\"window-title\">Mail</h2></header\n        >\n        <div class=\"window-body\">Inbox</div>\n      </dialog>\n    </div>\n    <nav class=\"taskbar\" data-taskbar-for=\"tb-desk-l\" data-position=\"left\" aria-label=\"Taskbar on the left\">\n      <button class=\"start-button\" data-variant=\"icon\" type=\"button\" aria-haspopup=\"menu\">\n        <span class=\"start-button-icon desktop-glyph\" data-glyph=\"flag\"></span>\n        <span class=\"start-button-label\">Start</span>\n      </button>\n      <div class=\"taskbar-windows\" role=\"group\" aria-label=\"Open windows\"></div>\n    </nav>\n  </div>\n  <div class=\"desktop\" style=\"height: 12rem; min-height: 0; border-radius: var(--radius-md)\">\n    <div class=\"window-desktop window-manager\" id=\"tb-desk-c\">\n      <dialog class=\"window\" open style=\"--window-x: 0.75rem; --window-y: 0.75rem; --window-w: 9rem\">\n        <header class=\"window-titlebar\"\n          ><span class=\"window-icon desktop-glyph\" data-glyph=\"music\"></span><h2 class=\"window-title\">Music</h2></header\n        >\n        <div class=\"window-body\">Playing</div>\n      </dialog>\n    </div>\n    <nav class=\"taskbar\" data-taskbar-for=\"tb-desk-c\" data-align=\"center\" aria-label=\"Centred taskbar\">\n      <button class=\"start-button\" data-variant=\"icon\" type=\"button\" aria-haspopup=\"menu\">\n        <span class=\"start-button-icon desktop-glyph\" data-glyph=\"flag\"></span>\n        <span class=\"start-button-label\">Start</span>\n      </button>\n      <div class=\"taskbar-windows\" role=\"group\" aria-label=\"Open windows\"></div>\n      <div class=\"tray\" role=\"group\" aria-label=\"Notification area\"><time class=\"tray-clock\"></time></div>\n    </nav>\n  </div>\n</div>\n","individual":false}]
