 verifier + challenge</li>\n          <li class=\"diagram-edge\" data-from=\"app\" data-to=\"auth\">GET /authorize ?code_challenge</li>\n          <li class=\"diagram-edge\" data-from=\"auth\" data-to=\"user\" data-line=\"dashed\">login + consent</li>\n          <li class=\"diagram-edge\" data-from=\"auth\" data-to=\"app\" data-line=\"dashed\">302 ?code=…</li>\n          <li class=\"diagram-edge\" data-from=\"app\" data-to=\"auth\">POST /token code + verifier</li>\n          <li class=\"diagram-edge\" data-from=\"auth\" data-to=\"app\" data-line=\"dashed\" data-tone=\"accent\" data-flow=\"1600\"\n            >access + refresh token</li\n          >\n          <li class=\"diagram-edge\" data-from=\"app\" data-to=\"api\">GET /orders · Bearer</li>\n          <li class=\"diagram-edge\" data-from=\"api\" data-to=\"app\" data-line=\"dashed\">200 orders</li>\n        </ol>\n      </div>\n    </figure>\n  </div>\n  <section class=\"card panel\" id=\"dg-seq-edit-panel\" aria-labelledby=\"dg-seq-edit-title\" style=\"\">\n    <header class=\"panel-header\">\n      <i data-lucide=\"sliders-horizontal\" class=\"panel-icon\" aria-hidden=\"true\"></i>\n      <h3 class=\"panel-title\" id=\"dg-seq-edit-title\">Inspector</h3>\n      <div class=\"panel-tools\">\n        <button\n          type=\"button\"\n          class=\"btn panel-close\"\n          data-variant=\"ghost\"\n          data-size=\"icon-sm\"\n          aria-label=\"Close Inspector\"\n          ><i data-lucide=\"x\"></i\n        ></button>\n      </div>\n    </header>\n    <div class=\"panel-body\" data-flush>\n      <div\n        class=\"property-grid\"\n        id=\"dg-seq-edit-grid\"\n        data-frame=\"none\"\n        data-empty-text=\"Click a box or an arrow.\"\n        aria-label=\"Selection properties\"\n      ></div>\n    </div>\n  </section>\n</div>\n","individual":false}]
