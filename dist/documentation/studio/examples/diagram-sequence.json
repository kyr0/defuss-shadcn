[{"label":"Authorization code + PKCE","html":"<figure class=\"diagram\" id=\"dg-seq\" data-type=\"sequence\" aria-label=\"OAuth 2.0 authorization code flow with PKCE\">\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Sequence</span>\n    <span class=\"diagram-title\">Sign-in: authorization code + PKCE</span>\n    <span class=\"diagram-dek\">Time runs down. Calls are solid, returns dashed; the token response is the accent.</span>\n  </figcaption>\n  <div class=\"diagram-canvas\" style=\"--cols: 4\">\n    <div class=\"diagram-node\" data-node=\"user\">\n      <span class=\"diagram-node-eyebrow\">Actor</span>\n      <span class=\"diagram-node-name\">User</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"app\">\n      <span class=\"diagram-node-eyebrow\">SPA</span>\n      <span class=\"diagram-node-name\">Browser app</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"auth\" data-tone=\"accent\">\n      <span class=\"diagram-node-eyebrow\">IdP</span>\n      <span class=\"diagram-node-name\">Auth server</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"api\">\n      <span class=\"diagram-node-eyebrow\">Resource</span>\n      <span class=\"diagram-node-name\">Orders API</span>\n    </div>\n    <ol class=\"diagram-edges\">\n      <li class=\"diagram-edge\" data-from=\"user\" data-to=\"app\">click “Sign in”</li>\n      <li class=\"diagram-edge\" data-from=\"app\" data-to=\"app\">make verifier + challenge</li>\n      <li class=\"diagram-edge\" data-from=\"app\" data-to=\"auth\">GET /authorize ?code_challenge</li>\n      <li class=\"diagram-edge\" data-from=\"auth\" data-to=\"user\" data-line=\"dashed\">login + consent</li>\n      <li class=\"diagram-edge\" data-from=\"auth\" data-to=\"app\" data-line=\"dashed\">302 ?code=…</li>\n      <li class=\"diagram-edge\" data-from=\"app\" data-to=\"auth\">POST /token code + verifier</li>\n      <li class=\"diagram-edge\" data-from=\"auth\" data-to=\"app\" data-line=\"dashed\" data-tone=\"accent\" data-flow=\"1600\"\n        >access + refresh token</li\n      >\n      <li class=\"diagram-edge\" data-from=\"app\" data-to=\"api\">GET /orders · Bearer</li>\n      <li class=\"diagram-edge\" data-from=\"api\" data-to=\"app\" data-line=\"dashed\">200 orders</li>\n    </ol>\n  </div>\n</figure>\n","individual":true},{"label":"Message by message","html":"<figure\n  class=\"diagram\"\n  id=\"dg-seq-steps\"\n  data-type=\"sequence\"\n  data-steps\n  data-autoplay\n  aria-label=\"OAuth 2.0 authorization code flow with PKCE\"\n>\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Sequence</span>\n    <span class=\"diagram-title\">Sign-in: authorization code + PKCE</span>\n    <span class=\"diagram-dek\">Time runs down. Calls are solid, returns dashed; the token response is the accent.</span>\n  </figcaption>\n  <div class=\"diagram-canvas\" style=\"--cols: 4\">\n    <div class=\"diagram-node\" data-node=\"user\">\n      <span class=\"diagram-node-eyebrow\">Actor</span>\n      <span class=\"diagram-node-name\">User</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"app\">\n      <span class=\"diagram-node-eyebrow\">SPA</span>\n      <span class=\"diagram-node-name\">Browser app</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"auth\" data-tone=\"accent\">\n      <span class=\"diagram-node-eyebrow\">IdP</span>\n      <span class=\"diagram-node-name\">Auth server</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"api\">\n      <span class=\"diagram-node-eyebrow\">Resource</span>\n      <span class=\"diagram-node-name\">Orders API</span>\n    </div>\n    <ol class=\"diagram-edges\">\n      <li class=\"diagram-edge\" data-from=\"user\" data-to=\"app\">click “Sign in”</li>\n      <li class=\"diagram-edge\" data-from=\"app\" data-to=\"app\">make verifier + challenge</li>\n      <li class=\"diagram-edge\" data-from=\"app\" data-to=\"auth\">GET /authorize ?code_challenge</li>\n      <li class=\"diagram-edge\" data-from=\"auth\" data-to=\"user\" data-line=\"dashed\">login + consent</li>\n      <li class=\"diagram-edge\" data-from=\"auth\" data-to=\"app\" data-line=\"dashed\">302 ?code=…</li>\n      <li class=\"diagram-edge\" data-from=\"app\" data-to=\"auth\">POST /token code + verifier</li>\n      <li class=\"diagram-edge\" data-from=\"auth\" data-to=\"app\" data-line=\"dashed\" data-tone=\"accent\" data-flow=\"1600\"\n        >access + refresh token</li\n      >\n      <li class=\"diagram-edge\" data-from=\"app\" data-to=\"api\">GET /orders · Bearer</li>\n      <li class=\"diagram-edge\" data-from=\"api\" data-to=\"app\" data-line=\"dashed\">200 orders</li>\n    </ol>\n  </div>\n</figure>\n","individual":true},{"label":"Implicit flow → PKCE","html":"<figure\n  class=\"diagram\"\n  id=\"dg-seq-delta\"\n  data-type=\"sequence\"\n  data-delta\n  aria-label=\"Implicit flow to code flow with PKCE\"\n>\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Protocol change</span>\n    <span class=\"diagram-title\">From the implicit flow to PKCE</span>\n  </figcaption>\n  <div class=\"diagram-canvas\" style=\"--cols: 3\">\n    <div class=\"diagram-node\" data-node=\"app\">\n      <span class=\"diagram-node-eyebrow\">SPA</span>\n      <span class=\"diagram-node-name\">Browser app</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"auth\">\n      <span class=\"diagram-node-eyebrow\">IdP</span>\n      <span class=\"diagram-node-name\">Auth server</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"api\">\n      <span class=\"diagram-node-eyebrow\">Resource</span>\n      <span class=\"diagram-node-name\">Orders API</span>\n    </div>\n    <ol class=\"diagram-edges\">\n      <li class=\"diagram-edge\" data-from=\"app\" data-to=\"app\" data-change=\"added\">make verifier + challenge</li>\n      <li\n        class=\"diagram-edge\"\n        data-from=\"app\"\n        data-to=\"auth\"\n        data-change=\"changed\"\n        data-before=\"GET /authorize ?response_type=token\"\n        >GET /authorize ?code_challenge</li\n      >\n      <li class=\"diagram-edge\" data-from=\"auth\" data-to=\"app\" data-line=\"dashed\" data-change=\"removed\"\n        >#access_token=… in the URL</li\n      >\n      <li class=\"diagram-edge\" data-from=\"auth\" data-to=\"app\" data-line=\"dashed\" data-change=\"added\">302 ?code=…</li>\n      <li class=\"diagram-edge\" data-from=\"app\" data-to=\"auth\" data-change=\"added\">POST /token code + verifier</li>\n      <li class=\"diagram-edge\" data-from=\"auth\" data-to=\"app\" data-line=\"dashed\" data-tone=\"accent\" data-change=\"added\"\n        >access + refresh token</li\n      >\n      <li class=\"diagram-edge\" data-from=\"app\" data-to=\"api\">GET /orders · Bearer</li>\n    </ol>\n  </div>\n</figure>\n","individual":true},{"label":"Sequence, interactive","html":"<div class=\"flex flex-wrap items-center gap-2 mb-3\">\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-diagram-for=\"dg-seq-live\" data-diagram-action=\"prev\"\n    >Previous</button\n  >\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-diagram-for=\"dg-seq-live\" data-diagram-action=\"next\"\n    >Next</button\n  >\n  <button class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" data-diagram-for=\"dg-seq-live\" data-diagram-action=\"clear\"\n    >Clear</button\n  >\n  <output class=\"text-sm text-muted-foreground\" data-diagram-for=\"dg-seq-live\"\n    >Click a box or an arrow - or press Next.</output\n  >\n</div>\n<figure\n  class=\"diagram\"\n  id=\"dg-seq-live\"\n  data-interactive\n  data-type=\"sequence\"\n  aria-label=\"OAuth 2.0 authorization code flow with PKCE\"\n>\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Sequence</span>\n    <span class=\"diagram-title\">Sign-in: authorization code + PKCE</span>\n    <span class=\"diagram-dek\">Time runs down. Calls are solid, returns dashed; the token response is the accent.</span>\n  </figcaption>\n  <div class=\"diagram-canvas\" style=\"--cols: 4\">\n    <div class=\"diagram-node\" data-node=\"user\">\n      <span class=\"diagram-node-eyebrow\">Actor</span>\n      <span class=\"diagram-node-name\">User</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"app\">\n      <span class=\"diagram-node-eyebrow\">SPA</span>\n      <span class=\"diagram-node-name\">Browser app</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"auth\" data-tone=\"accent\">\n      <span class=\"diagram-node-eyebrow\">IdP</span>\n      <span class=\"diagram-node-name\">Auth server</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"api\">\n      <span class=\"diagram-node-eyebrow\">Resource</span>\n      <span class=\"diagram-node-name\">Orders API</span>\n    </div>\n    <ol class=\"diagram-edges\">\n      <li class=\"diagram-edge\" data-from=\"user\" data-to=\"app\">click “Sign in”</li>\n      <li class=\"diagram-edge\" data-from=\"app\" data-to=\"app\">make verifier + challenge</li>\n      <li class=\"diagram-edge\" data-from=\"app\" data-to=\"auth\">GET /authorize ?code_challenge</li>\n      <li class=\"diagram-edge\" data-from=\"auth\" data-to=\"user\" data-line=\"dashed\">login + consent</li>\n      <li class=\"diagram-edge\" data-from=\"auth\" data-to=\"app\" data-line=\"dashed\">302 ?code=…</li>\n      <li class=\"diagram-edge\" data-from=\"app\" data-to=\"auth\">POST /token code + verifier</li>\n      <li class=\"diagram-edge\" data-from=\"auth\" data-to=\"app\" data-line=\"dashed\" data-tone=\"accent\" data-flow=\"1600\"\n        >access + refresh token</li\n      >\n      <li class=\"diagram-edge\" data-from=\"app\" data-to=\"api\">GET /orders · Bearer</li>\n      <li class=\"diagram-edge\" data-from=\"api\" data-to=\"app\" data-line=\"dashed\">200 orders</li>\n    </ol>\n  </div>\n</figure>\n","individual":false},{"label":"Sequence, inspect and edit","html":"<div class=\"flex items-center 