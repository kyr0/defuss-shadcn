[{"label":"Pages","html":"<div\n  class=\"data-grid\"\n  id=\"dg-pages\"\n  aria-label=\"Paged customers\"\n  data-paging=\"pages\"\n  data-page-size=\"20\"\n  style=\"height: 24rem; max-width: 36rem\"\n>\n  <div class=\"data-grid-viewport\">\n    <div class=\"data-grid-head\">\n      <div class=\"data-grid-row\">\n        <div class=\"data-grid-header\" data-field=\"id\" data-type=\"number\" data-format=\"\" data-width=\"5rem\">#</div>\n        <div class=\"data-grid-header\" data-field=\"name\" data-width=\"minmax(10rem, 1fr)\" data-filter=\"text\">Name</div>\n        <div\n          class=\"data-grid-header\"\n          data-field=\"plan\"\n          data-width=\"7rem\"\n          data-filter=\"select\"\n          data-options=\"Free,Pro,Team\"\n          >Plan</div\n        >\n        <div class=\"data-grid-header\" data-field=\"seats\" data-type=\"number\" data-width=\"6rem\">Seats</div>\n      </div>\n    </div>\n    <div class=\"data-grid-body\"></div>\n  </div>\n</div>\n","individual":true},{"label":"Infinite scrolling","html":"<div\n  class=\"data-grid\"\n  id=\"dg-feed\"\n  aria-label=\"Event log\"\n  data-paging=\"infinite\"\n  data-page-size=\"50\"\n  style=\"height: 20rem; max-width: 36rem\"\n>\n  <div class=\"data-grid-viewport\">\n    <div class=\"data-grid-head\">\n      <div class=\"data-grid-row\">\n        <div\n          class=\"data-grid-header\"\n          data-field=\"id\"\n          data-type=\"number\"\n          data-format=\"\"\n          data-width=\"5rem\"\n          data-sortable=\"false\"\n          >#</div\n        >\n        <div class=\"data-grid-header\" data-field=\"level\" data-width=\"6rem\" data-sortable=\"false\">Level</div>\n        <div class=\"data-grid-header\" data-field=\"message\" data-width=\"minmax(14rem, 1fr)\" data-sortable=\"false\"\n          >Message</div\n        >\n      </div>\n    </div>\n    <div class=\"data-grid-body\"></div>\n  </div>\n</div>\n","individual":true},{"label":"Custom cells","html":"<div class=\"data-grid\" id=\"dg-cells\" aria-label=\"Deployments\" style=\"height: 16rem; max-width: 40rem\">\n  <div class=\"data-grid-viewport\">\n    <div class=\"data-grid-head\">\n      <div class=\"data-grid-row\">\n        <div class=\"data-grid-header\" data-field=\"service\" data-width=\"minmax(9rem, 1fr)\">Service</div>\n        <div class=\"data-grid-header\" data-field=\"status\" data-width=\"8rem\">Status</div>\n        <div class=\"data-grid-header\" data-field=\"coverage\" data-type=\"number\" data-width=\"10rem\">Coverage</div>\n      </div>\n    </div>\n    <div class=\"data-grid-body\"></div>\n  </div>\n</div>\n","individual":true},{"label":"Inline editing","html":"<div class=\"data-grid\" id=\"dg-edit\" aria-label=\"Products\" style=\"height: 18rem\">\n  <div class=\"data-grid-viewport\">\n    <div class=\"data-grid-head\">\n      <div class=\"data-grid-row\">\n        <div class=\"data-grid-header\" data-field=\"sku\" data-width=\"7rem\" data-format=\"\">SKU</div>\n        <div\n          class=\"data-grid-header\"\n          data-field=\"name\"\n          data-width=\"minmax(10rem, 1fr)\"\n          data-editable\n          data-required\n          data-filter=\"text\"\n          >Product</div\n        >\n        <div\n          class=\"data-grid-header\"\n          data-field=\"stock\"\n          data-type=\"number\"\n          data-width=\"7rem\"\n          data-editable\n          data-min=\"0\"\n          data-integer\n          data-sort=\"desc\"\n          >Stock</div\n        >\n        <div\n          class=\"data-grid-header\"\n          data-field=\"price\"\n          data-type=\"number\"\n          data-format=\"currency:EUR\"\n          data-width=\"8rem\"\n          data-editable\n          data-min=\"0\"\n          data-step=\"0.01\"\n          >Price</div\n        >\n        <div\n          class=\"data-grid-header\"\n          data-field=\"category\"\n          data-width=\"9rem\"\n          data-editable\n          data-editor=\"enum\"\n          data-options=\"Tools, Garden, Kitchen, Office\"\n          data-filter=\"select\"\n          >Category</div\n        >\n        <div class=\"data-grid-header\" data-field=\"active\" data-width=\"6rem\" data-editable data-editor=\"boolean\"\n          >Active</div\n        >\n        <div class=\"data-grid-header\" data-field=\"color\" data-width=\"7rem\" data-editable data-editor=\"color\"\n          >Colour</div\n        >\n        <div class=\"data-grid-header\" data-field=\"restock\" data-width=\"9rem\" data-editable data-editor=\"date\"\n          >Restock</div\n        >\n      </div>\n    </div>\n    <div class=\"data-grid-body\"></div>\n  </div>\n</div>\n<p class=\"text-sm\" style=\"margin-block-start: 0.5rem\"\n  ><output id=\"dg-edit-log\">Double-click a cell to edit it.</output></p\n>\n","individual":false},{"label":"Custom editors","html":"<div class=\"data-grid\" id=\"dg-custom\" aria-label=\"Tasks\" style=\"height: 18rem; max-width: 46rem\">\n  <div class=\"data-grid-viewport\">\n    <div class=\"data-grid-head\">\n      <div class=\"data-grid-row\">\n        <div class=\"data-grid-header\" data-field=\"task\" data-width=\"minmax(10rem, 1fr)\" data-editable data-required\n          >Task</div\n        >\n        <div\n          class=\"data-grid-header\"\n          data-field=\"score\"\n          data-type=\"number\"\n          data-width=\"9rem\"\n          data-align=\"start\"\n          data-editable\n          >Priority</div\n        >\n        <div\n          class=\"data-grid-header\"\n          data-field=\"progress\"\n          data-type=\"number\"\n          data-width=\"11rem\"\n          data-align=\"start\"\n          data-editable\n          >Progress</div\n        >\n        <div class=\"data-grid-header\" data-field=\"owner\" data-width=\"8rem\" data-editable>Owner</div>\n        <div class=\"data-grid-header\" data-field=\"archived\" data-width=\"6rem\">Archived</div>\n      </div>\n    </div>\n    <div class=\"data-grid-body\"></div>\n  </div>\n</div>\n<p class=\"text-sm\" style=\"margin-block-start: 0.5rem\"\n  ><output id=\"dg-custom-log\">Double-click a priority, a progress or an owner.</output></p\n>\n","individual":false},{"label":"Selection models","html":"<div class=\"flex flex-col gap-2\">\n  <div class=\"toggle-group\" role=\"group\" aria-label=\"Selection model\" data-type=\"single\" data-size=\"sm\" id=\"dg-models\">\n    <button class=\"toggle\" aria-pressed=\"false\" value=\"row\">Row</button>\n    <button class=\"toggle\" aria-pressed=\"true\" value=\"cell\">Cell</button>\n    <button class=\"toggle\" aria-pressed=\"false\" value=\"column\">Column</button>\n    <button class=\"toggle\" aria-pressed=\"false\" value=\"row column\">Row + column</button>\n    <button class=\"toggle\" aria-pressed=\"false\" value=\"checkbox\">Checkbox</button>\n  </div>\n  <div\n    class=\"data-grid\"\n    id=\"dg-select\"\n    aria-label=\"Parts\"\n    data-select=\"multiple\"\n    data-select-model=\"cell\"\n    style=\"height: 20rem\"\n  >\n    <div class=\"data-grid-viewport\">\n      <div class=\"data-grid-head\">\n        <div class=\"data-grid-row\">\n          <div class=\"data-grid-header\" data-field=\"sku\" data-width=\"7rem\">SKU</div>\n          <div class=\"data-grid-header\" data-field=\"name\" data-width=\"minmax(9rem, 1fr)\" data-editable data-required\n            >Product</div\n          >\n          <div\n            class=\"data-grid-header\"\n            data-field=\"stock\"\n            data-type=\"number\"\n            data-width=\"6rem\"\n            data-editable\n            data-min=\"0\"\n            data-integer\n            >Stock</div\n          >\n          <div\n            class=\"data-grid-header\"\n            data-field=\"price\"\n            data-type=\"number\"\n            data-format=\"currency:EUR\"\n            data-width=\"7rem\"\n            data-editable\n            data-min=\"0\"\n            >Price</div\n          >\n          <div\n            class=\"data-grid-header\"\n            data-field=\"category\"\n            data-width=\"8rem\"\n            data-editable\n            data-editor=\"enum\"\n            data-options=\"Tools, Garden, Kitchen, Office\"\n            >Category</div\n          >\n        </div>\n      </div>\n      <div class=\"data-grid-body\"></div>\n    </div>\n  </div>\n  <p class=\"text-sm\"><output id=\"dg-select-log\">Select cells, then Ctrl/Cmd+C.</output></p>\n</div>\n","individual":false},{"label":"Checkbox selection","html":"<div\n  class=\"data-grid\"\n  id=\"dg-checks\"\n  aria-label=\"People\"\n  data-select=\"multiple\"\n  data-select-model=\"checkbox\"\n  data-persist=\"none\"\n  style=\"height: 20rem\"\n>\n  <div class=\"data-grid-viewport\">\n    <div class=\"data-grid-head\">\n      <div class=\"data-grid-row\">\n        <div class=\"data-grid-header\" data-field=\"name\" data-width=\"minmax(9rem, 1fr)\" data-filter=\"text\">Name</div>\n        <div class=\"data-grid-header\" data-field=\"team\" data-width=\"8rem\" data-filter=\"select\">Team</div>\n        <div class=\"data-grid-header\" data-field=\"role\" data-width=\"9rem\">Role</div>\n        <div class=\"data-grid-header\" data-field=\"since\" data-type=\"number\" data-format=\"\" data-width=\"5rem\">Since</div>\n      </div>\n    </div>\n    <div class=\"data-grid-body\"></div>\n  </div>\n</div>\n<p class=\"text-sm\" style=\"margin-block-start: 0.5rem\"><output id=\"dg-checks-log\">Nobody is selected.</output></p>\n","individual":false},{"label":"Drag and drop between grids","html":"<div class=\"flex flex-col gap-2\">\n  <div class=\"grid gap-3\" style=\"grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr))\">\n    <div\n      class=\"data-grid\"\n      id=\"dg-backlog\"\n      aria-label=\"Backlog\"\n      data-select=\"multiple\"\n      data-drag\n      data-drop\n      data-persist=\"none\"\n      style=\"height: 18rem\"\n    >\n      <div class=\"data-grid-viewport\">\n        <div class=\"data-grid-head\">\n          <div class=\"data-grid-row\">\n            <div class=\"data-grid-header\" data-field=\"key\" data-width=\"5rem\">Key</div>\n            <div class=\"data-grid-header\" data-field=\"title\" data-width=\"minmax(8rem, 1fr)\">Backlog</div>\n            <div class=\"data-grid-header\" data-field=\"points\" data-type=\"number\" data-format=\"\" data-width=\"4.5rem\"\n              >Pts</div\n            >\n          </div>\n        </div>\n        <div class=\"data-grid-body\"></div>\n      </div>\n    </div>\n    <div\n      class=\"data-grid\"\n      id=\"dg-sprint\"\n      aria-label=\"Sprint\"\n      data-select=\"multiple\"\n      data-select-model=\"checkbox\"\n      data-drag\n      data-drop\n      data-persist=\"none\"\n      style=\"height: 18rem\"\n    >\n      <div class=\"data-grid-viewport\">\n        <div class=\"data-grid-head\">\n          <div class=\"data-grid-row\">\n            <div class=\"data-grid-header\" data-field=\"key\" data-width=\"5rem\">Key</div>\n            <div class=\"data-grid-header\" data-field=\"title\" data-width=\"minmax(8rem, 1fr)\">Sprint</div>\n            <div class=\"data-grid-header\" data-field=\"points\" data-type=\"number\" data-format=\"\" data-width=\"4.5rem\"\n              >Pts</div\n            >\n          </div>\n        </div>\n        <div class=\"data-grid-body\"></div>\n      </div>\n    </div>\n  </div>\n  <div class=\"flex flex-wrap items-center gap-2\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"dg-to-sprint\">Move to Sprint</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"dg-to-backlog\">Move to Backlog</button>\n    <p class=\"text-sm\"><output id=\"dg-dnd-log\">Drag a row from one grid into the other.</output></p>\n  </div>\n</div>\n","individual":false},{"label":"100,000 orders","html":"<div class=\"flex flex-col gap-2\">\n  <div\n    class=\"data-grid\"\n    id=\"dg-orders\"\n    aria-label=\"Orders\"\n    data-select=\"multiple\"\n    data-empty-text=\"No orders match.\"\n    style=\"height: 24rem\"\n  >\n    <div class=\"data-grid-viewport\">\n      <div class=\"data-grid-head\">\n        <div class=\"data-grid-row\">\n          <div\n            class=\"data-grid-header\"\n            data-field=\"id\"\n            data-type=\"number\"\n            data-format=\"\"\n            data-width=\"6rem\"\n            data-filter=\"number\"\n            data-locked\n            >Order</div\n          >\n          <div class=\"data-grid-header\" data-field=\"customer\" data-width=\"11rem\" data-filter=\"text\">Customer</div>\n          <div class=\"data-grid-header\" data-field=\"country\" data-width=\"9rem\" data-filter=\"select\">Country</div>\n          <div class=\"data-grid-header\" data-field=\"product\" data-width=\"10rem\" data-filter=\"text\">Product</div>\n          <div class=\"data-grid-header\" data-field=\"quantity\" data-type=\"number\" data-width=\"6rem\" data-filter=\"number\"\n            >Qty</div\n          >\n          <div\n            class=\"data-grid-header\"\n            data-field=\"total\"\n            data-type=\"number\"\n            data-format=\"currency:EUR\"\n            data-width=\"8rem\"\n            data-filter=\"number\"\n            >Total</div\n          >\n          <div class=\"data-grid-header\" data-field=\"status\" data-width=\"8rem\" data-filter=\"select\">Status</div>\n          <div class=\"data-grid-header\" data-field=\"date\" data-format=\"date\" data-width=\"8rem\">Date</div>\n        </div>\n      </div>\n      <div class=\"data-grid-body\"></div>\n    </div>\n  </div>\n  <p class=\"text-sm text-muted-foreground m-0\" id=\"dg-orders-query\" aria-live=\"polite\"></p>\n</div>\n","individual":false},{"label":"Projection: computed columns and totals","html":"<div class=\"flex flex-col gap-2\">\n  <div class=\"data-grid\" id=\"dg-lines\" aria-label=\"Order lines\" data-empty-text=\"No lines match.\" style=\"height: 22rem\">\n    <div class=\"data-grid-viewport\">\n      <div class=\"data-grid-head\">\n        <div class=\"data-grid-row\">\n          <div\n            class=\"data-grid-header\"\n            data-field=\"id\"\n            data-type=\"number\"\n            data-format=\"\"\n            data-width=\"6rem\"\n            data-filter=\"number\"\n            data-locked\n            >Line</div\n          >\n          <div class=\"data-grid-header\" data-field=\"product\" data-width=\"10rem\" data-filter=\"text\">Product</div>\n          <div class=\"data-grid-header\" data-field=\"country\" data-width=\"9rem\" data-filter=\"select\">Country</div>\n          <div class=\"data-grid-header\" data-field=\"quantity\" data-type=\"number\" data-width=\"5rem\" data-filter=\"number\"\n            >Qty</div\n          >\n          <div\n            class=\"data-grid-header\"\n            data-field=\"discount\"\n            data-type=\"number\"\n            data-format=\"percent\"\n            data-width=\"6rem\"\n            data-filter=\"number\"\n            >Discount</div\n          >\n          <div\n            class=\"data-grid-header\"\n            data-field=\"net\"\n            data-type=\"number\"\n            data-format=\"currency:EUR\"\n            data-width=\"8rem\"\n            data-filter=\"number\"\n            >Net</div\n          >\n          <div\n            class=\"data-grid-header\"\n            data-field=\"vat\"\n            data-type=\"number\"\n            data-format=\"currency:EUR\"\n            data-width=\"7rem\"\n            data-filter=\"number\"\n            >VAT</div\n          >\n          <div\n            class=\"data-grid-header\"\n            data-field=\"gross\"\n            data-type=\"number\"\n            data-format=\"currency:EUR\"\n            data-width=\"8rem\"\n            data-filter=\"number\"\n            >Gross</div\n          >\n        </div>\n      </div>\n      <div class=\"data-grid-body\"></div>\n    </div>\n  </div>\n  <output class=\"text-sm text-muted-foreground\" id=\"dg-lines-totals\" aria-live=\"polite\"\n    >Projecting 100,000 lines…</output\n  >\n</div>\n","individual":false},{"label":"Aggregation: a report that follows the grid","html":"<div class=\"flex flex-col gap-3\">\n  <div\n    class=\"data-grid\"\n    id=\"dg-report-orders\"\n    aria-label=\"Orders\"\n    data-empty-text=\"No orders match.\"\n    style=\"height: 16rem\"\n  >\n    <div class=\"data-grid-viewport\">\n      <div class=\"data-grid-head\">\n        <div class=\"data-grid-row\">\n          <div class=\"data-grid-header\" data-field=\"id\" data-type=\"number\" data-format=\"\" data-width=\"6rem\">Order</div>\n          <div class=\"data-grid-header\" data-field=\"country\" data-width=\"9rem\" data-filter=\"select\">Country</div>\n          <div class=\"data-grid-header\" data-field=\"product\" data-width=\"10rem\" data-filter=\"select\">Product</div>\n          <div class=\"data-grid-header\" data-field=\"status\" data-width=\"8rem\" data-filter=\"select\">Status</div>\n          <div class=\"data-grid-header\" data-field=\"quantity\" data-type=\"number\" data-width=\"5rem\" data-filter=\"number\"\n            >Qty</div\n          >\n          <div\n            class=\"data-grid-header\"\n            data-field=\"total\"\n            data-type=\"number\"\n            data-format=\"currency:EUR\"\n            data-width=\"8rem\"\n            data-filter=\"number\"\n            >Total</div\n          >\n        </div>\n      </div>\n      <div class=\"data-grid-body\"></div>\n    </div>\n  </div>\n  <div class=\"flex flex-wrap items-center gap-2\">\n    <label class=\"label\" for=\"dg-report-by\">Group by</label>\n    <select class=\"select w-auto\" id=\"dg-report-by\">\n      <option value=\"country\" selected>Country</option>\n      <option value=\"product\">Product</option>\n      <option value=\"status\">Status</option>\n    </select>\n    <output class=\"text-sm text-muted-foreground\" id=\"dg-report-line\" aria-live=\"polite\"></output>\n  </div>\n  <div class=\"data-grid\" id=\"dg-report\" aria-label=\"Report\" data-empty-text=\"No groups.\" style=\"height: 14rem\">\n    <div class=\"data-grid-viewport\">\n      <div class=\"data-grid-head\">\n        <div class=\"data-grid-row\">\n          <div class=\"data-grid-header\" data-field=\"group\" data-width=\"minmax(9rem, 1fr)\">Group</div>\n          <div class=\"data-grid-header\" data-field=\"orders\" data-type=\"number\" data-width=\"6rem\">Orders</div>\n          <div class=\"data-grid-header\" data-field=\"units\" data-type=\"number\" data-width=\"6rem\">Units</div>\n          <div\n            class=\"data-grid-header\"\n            data-field=\"revenue\"\n            data-type=\"number\"\n            data-format=\"currency:EUR\"\n            data-width=\"9rem\"\n            >Revenue</div\n          >\n          <div\n            class=\"data-grid-header\"\n            data-field=\"average\"\n            data-type=\"number\"\n            data-format=\"currency:EUR\"\n            data-width=\"8rem\"\n            >Avg order</div\n          >\n          <div\n            class=\"data-grid-header\"\n            data-field=\"largest\"\n            data-type=\"number\"\n            data-format=\"currency:EUR\"\n            data-width=\"8rem\"\n            >Largest</div\n          >\n          <div class=\"data-grid-header\" data-field=\"refunds\" data-type=\"number\" data-width=\"6rem\">Refunds</div>\n        </div>\n      </div>\n      <div class=\"data-grid-body\"></div>\n    </div>\n  </div>\n</div>\n","individual":false},{"label":"Arranging columns","html":"<div class=\"flex flex-col gap-3\">\n  <div class=\"data-grid\" id=\"dg-arrange\" aria-label=\"People\" style=\"height: 15rem\">\n    <div class=\"data-grid-viewport\">\n      <div class=\"data-grid-head\">\n        <div class=\"data-grid-row\">\n          <div class=\"data-grid-header\" data-field=\"id\" data-type=\"number\" data-format=\"\" data-width=\"5rem\" data-locked>\n            ID\n          </div>\n          <div class=\"data-grid-header\" data-field=\"name\" data-width=\"10rem\">Name</div>\n          <div class=\"data-grid-header\" data-field=\"email\" data-width=\"14rem\" hidden>Email</div>\n          <div class=\"data-grid-header\" data-field=\"team\" data-width=\"8rem\">Team</div>\n          <div class=\"data-grid-header\" data-field=\"city\" data-width=\"8rem\">City</div>\n          <div class=\"data-grid-header\" data-field=\"since\" data-type=\"number\" data-format=\"\" data-width=\"6rem\"\n            >Since</div\n          >\n        </div>\n      </div>\n      <div class=\"data-grid-body\"></div>\n    </div>\n  </div>\n  <div class=\"flex flex-wrap items-center gap-2\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"dg-arrange-reset\">Reset columns</button>\n  </div>\n  <pre\n    class=\"text-xs m-0 overflow-x-auto\"\n    id=\"dg-arrange-json\"\n    style=\"padding: 0.75rem; border-radius: var(--radius-md); background: var(--muted)\"\n  ></pre>\n</div>\n","individual":false},{"label":"The store is the query","html":"<div class=\"flex flex-col gap-3\">\n  <div class=\"flex flex-wrap gap-2\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" data-q=\"top\">Top revenue</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" data-q=\"eu\">EU only</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" data-q=\"lock\">Lock name + region</button>\n    <button class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" type=\"button\" data-q=\"reset\">Reset</button>\n  </div>\n  <div class=\"data-grid\" id=\"dg-driven\" aria-label=\"Accounts\" style=\"height: 16rem\">\n    <div class=\"data-grid-viewport\">\n      <div class=\"data-grid-head\">\n        <div class=\"data-grid-row\">\n          <div class=\"data-grid-header\" data-field=\"name\" data-width=\"11rem\">Account</div>\n          <div class=\"data-grid-header\" data-field=\"region\" data-width=\"7rem\">Region</div>\n          <div\n            class=\"data-grid-header\"\n            data-field=\"revenue\"\n            data-type=\"number\"\n            data-format=\"currency:USD\"\n            data-width=\"9rem\"\n            >Revenue</div\n          >\n          <div class=\"data-grid-header\" data-field=\"growth\" data-type=\"number\" data-format=\"percent\" data-width=\"7rem\"\n            >Growth</div\n          >\n          <div class=\"data-grid-header\" data-field=\"owner\" data-width=\"9rem\">Owner</div>\n        </div>\n      </div>\n      <div class=\"data-grid-body\"></div>\n    </div>\n  </div>\n  <pre\n    class=\"text-xs m-0 overflow-x-auto\"\n    id=\"dg-driven-json\"\n    style=\"padding: 0.75rem; border-radius: var(--radius-md); background: var(--muted)\"\n  ></pre>\n</div>\n","individual":false},{"label":"A kept view","html":"<div class=\"flex flex-col gap-3\" style=\"max-width: 36rem\">\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"dg-remount\" style=\"align-self: flex-start\"\n    >Mount a fresh grid</button\n  >\n  <div id=\"dg-kept-host\"></div>\n</div>\n<template id=\"dg-kept-template\">\n  <div\n    class=\"data-grid\"\n    id=\"dg-kept\"\n    aria-label=\"Cities\"\n    data-persist=\"local\"\n    data-persist-key=\"docs:cities-grid\"\n    style=\"height: 14rem\"\n  >\n    <div class=\"data-grid-viewport\">\n      <div class=\"data-grid-head\">\n        <div class=\"data-grid-row\">\n          <div class=\"data-grid-header\" data-field=\"city\" data-width=\"minmax(9rem, 1fr)\" data-filter=\"text\">City</div>\n          <div class=\"data-grid-header\" data-field=\"country\" data-width=\"8rem\" data-filter=\"select\">Country</div>\n          <div class=\"data-grid-header\" data-field=\"population\" data-type=\"number\" data-width=\"9rem\" data-sort=\"desc\"\n            >Population</div\n          >\n        </div>\n      </div>\n      <div class=\"data-grid-body\"></div>\n    </div>\n  </div>\n</template>\n","individual":false},{"label":"Loading and empty","html":"<div class=\"flex flex-wrap gap-4\">\n  <div class=\"data-grid\" aria-label=\"Waiting for data\" style=\"height: 11rem; flex: 1; min-width: 14rem\">\n    <div class=\"data-grid-viewport\">\n      <div class=\"data-grid-head\">\n        <div class=\"data-grid-row\">\n          <div class=\"data-grid-header\" data-field=\"name\" data-width=\"minmax(8rem, 1fr)\">Name</div>\n        </div>\n      </div>\n      <div class=\"data-grid-body\"></div>\n    </div>\n  </div>\n  <div\n    class=\"data-grid\"\n    id=\"dg-empty\"\n    aria-label=\"No matches\"\n    data-empty-text=\"Nothing matches 'zebra'.\"\n    style=\"height: 11rem; flex: 1; min-width: 14rem\"\n  >\n    <div class=\"data-grid-viewport\">\n      <div class=\"data-grid-head\">\n        <div class=\"data-grid-row\">\n          <div class=\"data-grid-header\" data-field=\"name\" data-width=\"minmax(8rem, 1fr)\">Name</div>\n        </div>\n      </div>\n      <div class=\"data-grid-body\"></div>\n    </div>\n  </div>\n</div>\n","individual":false}]
