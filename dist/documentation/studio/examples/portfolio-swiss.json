[{"label":"Lukas Graf, graphic designer","html":"<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;700;800&display=swap');\n  #pf-swiss {\n    --background: oklch(1 0 0);\n    --foreground: oklch(0.14 0 0);\n    --card: oklch(1 0 0);\n    --card-foreground: var(--foreground);\n    --muted: oklch(0.96 0 0);\n    --muted-foreground: oklch(0.45 0 0);\n    --border: var(--foreground);\n    --input: var(--foreground);\n    --primary: oklch(0.6 0.235 28);\n    --primary-foreground: oklch(1 0 0);\n    --secondary: var(--muted);\n    --secondary-foreground: var(--foreground);\n    --accent: var(--muted);\n    --accent-foreground: var(--foreground);\n    --ring: var(--primary);\n    --radius: 0px;\n    --radius-sm: max(0px, calc(var(--radius) - 4px));\n    --radius-md: max(0px, calc(var(--radius) - 2px));\n    --radius-lg: var(--radius);\n    --radius-xl: calc(var(--radius) + 4px);\n    --font-sans: 'Inter Tight', 'Helvetica Neue', Helvetica, Arial, sans-serif;\n    container: pf-swiss / inline-size;\n    box-sizing: border-box;\n    width: 100%;\n    overflow: clip;\n    padding: 1.25rem clamp(1rem, 3vw, 2rem) 3rem;\n    background: var(--background);\n    color: var(--foreground);\n    font-family: var(--font-sans);\n  }\n  .dark #pf-swiss {\n    --background: oklch(0.14 0 0);\n    --foreground: oklch(0.98 0 0);\n    --card: oklch(0.14 0 0);\n    --muted: oklch(0.22 0 0);\n    --muted-foreground: oklch(0.72 0 0);\n    --primary: oklch(0.65 0.23 28);\n  }\n  #pf-swiss .pf-grid {\n    display: grid;\n    grid-template-columns: repeat(12, minmax(0, 1fr));\n    column-gap: clamp(0.75rem, 2cqi, 1.5rem);\n    max-width: 90rem;\n    margin-inline: auto;\n  }\n  #pf-swiss .pf-grid > * {\n    grid-column: 1 / -1;\n  }\n  #pf-swiss .pf-hero {\n    position: relative;\n    display: grid;\n    grid-template-columns: subgrid;\n    align-items: end;\n    padding-block-end: clamp(2rem, 5cqi, 4rem);\n  }\n  #pf-swiss .pf-name {\n    grid-column: 1 / span 10;\n    margin: 0;\n    font-size: clamp(4rem, 17cqi, 15rem);\n    font-weight: 800;\n    letter-spacing: -0.06em;\n    line-height: 0.82;\n  }\n  #pf-swiss .pf-name span {\n    display: block;\n  }\n  #pf-swiss .pf-square {\n    grid-column: 11 / span 2;\n    align-self: start;\n    width: 100%;\n    aspect-ratio: 1;\n    background: var(--primary);\n  }\n  #pf-swiss .pf-intro {\n    display: grid;\n    grid-template-columns: subgrid;\n    row-gap: 2rem;\n    padding-block: 1.25rem clamp(3rem, 7cqi, 6rem);\n    border-block-start: 2px solid var(--foreground);\n  }\n  #pf-swiss .pf-intro > img {\n    grid-column: span 3;\n    width: 100%;\n    aspect-ratio: 3 / 4;\n    object-fit: cover;\n    filter: grayscale(1) contrast(1.1);\n  }\n  #pf-swiss .pf-intro > p {\n    grid-column: span 6;\n    margin: 0;\n    font-size: clamp(1.25rem, 0.9rem + 1.3cqi, 2.125rem);\n    font-weight: 500;\n    letter-spacing: -0.02em;\n    line-height: 1.15;\n    text-wrap: pretty;\n  }\n  #pf-swiss .pf-intro > dl {\n    grid-column: span 3;\n    margin: 0;\n    font-size: 1.0625rem;\n    line-height: 1.45;\n  }\n  #pf-swiss .pf-intro dt {\n    margin-block-start: 1rem;\n    font-weight: 700;\n  }\n  #pf-swiss .pf-intro dt:first-child {\n    margin-block-start: 0;\n  }\n  #pf-swiss .pf-intro dd {\n    margin: 0;\n    color: var(--muted-foreground);\n  }\n  #pf-swiss .pf-section {\n    display: grid;\n    grid-template-columns: subgrid;\n    row-gap: 1.5rem;\n    padding-block: 1rem clamp(3rem, 7cqi, 6rem);\n    border-block-start: 2px solid var(--foreground);\n  }\n  #pf-swiss .pf-section > h2 {\n    grid-column: span 3;\n    margin: 0;\n    font-size: 1.125rem;\n    font-weight: 700;\n  }\n  #pf-swiss .pf-section > h2 span {\n    color: var(--primary);\n  }\n  #pf-swiss .pf-section > :not(h2) {\n    grid-column: 4 / -1;\n  }\n  #pf-swiss .mk-portfolio-grid {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    grid-auto-rows: auto;\n    gap: clamp(0.75rem, 2cqi, 1.5rem);\n  }\n  #pf-swiss .mk-portfolio-grid-link {\n    border-radius: 0;\n    background: none;\n  }\n  #pf-swiss .mk-portfolio-grid-media {\n    aspect-ratio: 1;\n    height: auto;\n    filter: grayscale(1) contrast(1.1);\n    transition:\n      filter 0.3s,\n      scale 0.5s;\n  }\n  #pf-swiss .mk-portfolio-grid-link:is(:hover, :focus-visible) .mk-portfolio-grid-media {\n    filter: none;\n  }\n  #pf-swiss .mk-portfolio-grid-caption {\n    position: static;\n    padding: 0.6rem 0 0;\n    background: none;\n    color: var(--foreground);\n    text-shadow: none;\n  }\n  #pf-swiss .mk-portfolio-grid-title {\n    font-size: 1.125rem;\n  }\n  #pf-swiss .mk-portfolio-grid-meta {\n    color: var(--muted-foreground);\n    font-size: 1rem;\n  }\n  #pf-swiss .mk-stat-label {\n    font-size: 1.0625rem;\n  }\n  #pf-swiss .mk-resume-entry-title {\n    font-size: 1.25rem;\n  }\n  #pf-swiss :is(.mk-resume-entry-org, .mk-resume-entry-when, .mk-resume-entry-body) {\n    font-size: 1.0625rem;\n  }\n  #pf-swiss .mk-availability-status {\n    font-size: 1rem;\n  }\n  #pf-swiss .mk-stats {\n    padding: 0;\n  }\n  #pf-swiss .mk-stats-grid {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n  #pf-swiss .mk-stat {\n    border-inline-start: 2px solid var(--foreground);\n  }\n  #pf-swiss .mk-stat-value {\n    font-size: clamp(3rem, 2rem + 4cqi, 6rem);\n    font-weight: 800;\n    letter-spacing: -0.05em;\n    color: var(--primary);\n  }\n  #pf-swiss .mk-availability {\n    border: 0;\n    border-block-start: 2px solid var(--foreground);\n    box-shadow: none;\n    padding-inline: 0;\n  }\n  #pf-swiss .pf-mail {\n    display: block;\n    margin-block-start: 1.5rem;\n    color: inherit;\n    font-size: clamp(2rem, 1rem + 5cqi, 5.5rem);\n    font-weight: 800;\n    letter-spacing: -0.05em;\n    line-height: 1;\n    text-decoration: none;\n    overflow-wrap: anywhere;\n  }\n  #pf-swiss .pf-mail:is(:hover, :focus-visible) {\n    color: var(--primary);\n  }\n  @container pf-swiss (max-width: 48rem) {\n    #pf-swiss .pf-name {\n      grid-column: 1 / -1;\n    }\n    #pf-swiss .pf-square {\n      position: absolute;\n      grid-area: auto;\n      inset-block-start: 0;\n      inset-inline-end: 0;\n      width: 24%;\n    }\n    #pf-swiss .pf-intro > img {\n      grid-column: span 5;\n    }\n    #pf-swiss .pf-intro > p {\n      grid-column: span 7;\n    }\n    #pf-swiss .pf-intro > dl {\n      grid-column: 1 / -1;\n    }\n    #pf-swiss .pf-section > h2,\n    #pf-swiss .pf-section > :not(h2) {\n      grid-column: 1 / -1;\n    }\n    #pf-swiss .mk-portfolio-grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n    #pf-swiss .mk-stats-grid {\n      grid-template-columns: minmax(0, 1fr);\n    }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    #pf-swiss .mk-portfolio-grid-media {\n      transition: none;\n    }\n  }\n  /* light or dark: the Swap writes the page's dark class - every look has a light and a dark palette */\n  #pf-swiss .site-mode {\n    flex: none;\n    border: 1px solid var(--input);\n    border-radius: var(--radius-md);\n    background: var(--background);\n    color: var(--foreground);\n  }\n  #pf-swiss .site-mode:hover {\n    background: var(--accent);\n    color: var(--accent-foreground);\n  }\n  #pf-swiss {\n    position: relative;\n  }\n  #pf-swiss [hidden] {\n    display: none !important;\n  }\n  /* the views - the home page and a page per project - sit on the same twelve columns */\n  #pf-swiss [data-pf-view] {\n    display: grid;\n    grid-template-columns: subgrid;\n    grid-column: 1 / -1;\n  }\n  #pf-swiss [data-pf-view] > * {\n    grid-column: 1 / -1;\n  }\n  /* the Site Header on the grid: the name, the numbered index, the city and the mode. No container of its own - a\n     container is laid out on its own and cannot take its parent's columns */\n  #pf-swiss .mk-header {\n    container: none;\n    display: grid;\n    grid-template-columns: subgrid;\n    background: none;\n    color: inherit;\n    border-block-start: 2px solid var(--foreground);\n  }\n  #pf-swiss .mk-header-inner {\n    display: grid;\n    grid-template-columns: subgrid;\n    grid-column: 1 / -1;\n    align-items: start;\n    column-gap: normal;\n    row-gap: 0.75rem;\n    min-height: 4.5rem;\n    max-width: none;\n    margin: 0;\n    padding: 0.6rem 0 2rem;\n    font-size: 1.0625rem;\n    font-weight: 500;\n    line-height: 1.35;\n  }\n  #pf-swiss .mk-header-brand {\n    grid-column: span 3;\n    display: block;\n    color: inherit;\n  }\n  #pf-swiss .mk-header-name {\n    display: block;\n    color: inherit;\n    font-size: inherit;\n    font-weight: 700;\n    letter-spacing: 0;\n  }\n  #pf-swiss .pf-brand-line {\n    display: block;\n    color: var(--muted-foreground);\n  }\n  #pf-swiss .mk-header-nav {\n    display: block;\n    grid-column: span 6;\n  }\n  #pf-swiss .nav-menu-list {\n    flex-wrap: wrap;\n    gap: 0.25rem 1.5rem;\n  }\n  #pf-swiss .nav-menu-link {\n    gap: 0.4rem;\n    padding: 0;\n    border-radius: 0;\n    color: inherit;\n    font-size: inherit;\n    text-underline-offset: 0.25em;\n  }\n  #pf-swiss .nav-menu-link span {\n    color: var(--primary);\n  }\n  #pf-swiss .nav-menu-link:is(:hover, :focus-visible, [aria-current]) {\n    background: none;\n    color: inherit;\n    text-decoration: underline 2px;\n  }\n  #pf-swiss .mk-header-actions {\n    grid-column: span 3;\n    justify-content: end;\n    gap: 1rem;\n  }\n  /* a project page: the name across the grid, the facts beside the brief, the pictures, then the next project */\n  #pf-swiss .pf-case-bar {\n    display: flex;\n    justify-content: space-between;\n    gap: 1rem;\n    margin: 0;\n    padding-block: 0.6rem 2rem;\n    border-block-start: 2px solid var(--foreground);\n    font-size: 1.0625rem;\n    font-weight: 500;\n  }\n  #pf-swiss .pf-case-bar a {\n    color: inherit;\n    text-underline-offset: 0.25em;\n  }\n  #pf-swiss .pf-case-bar a:is(:hover, :focus-visible) {\n    color: var(--primary);\n  }\n  #pf-swiss .pf-case-title {\n    grid-column: 1 / span 10;\n    margin: 0;\n    font-size: clamp(3rem, 9cqi, 8.5rem);\n    font-weight: 800;\n    letter-spacing: -0.055em;\n    line-height: 0.88;\n    text-wrap: balance;\n  }\n  #pf-swiss .pf-case-mark {\n    grid-column: 12 / span 1;\n    width: 100%;\n    aspect-ratio: 1;\n    background: var(--primary);\n  }\n  #pf-swiss .pf-case-intro {\n    display: grid;\n    grid-template-columns: subgrid;\n    grid-column: 1 / -1;\n    row-gap: 2rem;\n    padding-block: clamp(2rem, 5cqi, 4rem);\n  }\n  #pf-swiss .pf-case-intro > dl {\n    grid-column: span 3;\n    margin: 0;\n    font-size: 1.0625rem;\n    line-height: 1.45;\n  }\n  #pf-swiss .pf-case-intro dt {\n    margin-block-start: 1rem;\n    font-weight: 700;\n  }\n  #pf-swiss .pf-case-intro dt:first-child {\n    margin-block-start: 0;\n  }\n  #pf-swiss .pf-case-intro dd {\n    margin: 0;\n    color: var(--muted-foreground);\n  }\n  #pf-swiss .pf-case-intro > p {\n    grid-column: span 9;\n    margin: 0;\n    font-size: clamp(1.25rem, 0.9rem + 1.3cqi, 2.125rem);\n    font-weight: 500;\n    letter-spacing: -0.02em;\n    line-height: 1.15;\n    text-wrap: pretty;\n  }\n  #pf-swiss .pf-case-cover {\n    grid-column: 1 / -1;\n    width: 100%;\n    aspect-ratio: 16 / 9;\n    margin-block-end: clamp(3rem, 7cqi, 6rem);\n    object-fit: cover;\n  }\n  #pf-swiss .pf-section p {\n    margin: 0;\n    max-width: 46rem;\n    font-size: 1.1875rem;\n    line-height: 1.5;\n    text-wrap: pretty;\n  }\n  #pf-swiss .pf-case-pair {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: clamp(0.75rem, 2cqi, 1.5rem);\n    margin-block-start: 1.5rem;\n  }\n  #pf-swiss .pf-case-pair img {\n    width: 100%;\n    aspect-ratio: 1;\n    object-fit: cover;\n  }\n  #pf-swiss .pf-case-pager {\n    display: grid;\n    grid-template-columns: subgrid;\n    grid-column: 1 / -1;\n    padding-block: 1rem clamp(3rem, 7cqi, 6rem);\n    border-block-start: 2px solid var(--foreground);\n  }\n  #pf-swiss .pf-case-pager a {\n    grid-column: span 6;\n    display: grid;\n    gap: 0.25rem;\n    color: inherit;\n    text-decoration: none;\n  }\n  #pf-swiss .pf-case-pager a + a {\n    text-align: end;\n  }\n  #pf-swiss .pf-case-pager small {\n    font-size: 1.0625rem;\n    font-weight: 700;\n  }\n  #pf-swiss .pf-case-pager small span {\n    color: var(--primary);\n  }\n  #pf-swiss .pf-case-pager strong {\n    font-size: clamp(1.5rem, 1rem + 2cqi, 3rem);\n    font-weight: 800;\n    letter-spacing: -0.04em;\n    line-height: 1;\n  }\n  #pf-swiss .pf-case-pager a:is(:hover, :focus-visible) strong {\n    color: var(--primary);\n  }\n  /* the Site Footer: the index once more in four numbered columns, the studio's address, the name */\n  #pf-swiss .mk-footer {\n    grid-column: 1 / -1;\n    background: none;\n    color: inherit;\n    border-block-start: 2px solid var(--foreground);\n  }\n  #pf-swiss .mk-footer-inner {\n    gap: 1.5rem;\n    max-width: none;\n    padding: 1rem 0 0;\n  }\n  #pf-swiss .mk-footer-nav {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: 2rem clamp(0.75rem, 2cqi, 1.5rem);\n  }\n  #pf-swiss .mk-footer-heading {\n    color: inherit;\n    font-size: 1.0625rem;\n    font-weight: 700;\n  }\n  #pf-swiss .mk-footer-heading span {\n    color: var(--primary);\n  }\n  #pf-swiss .mk-footer-list {\n    gap: 0.35rem;\n    font-size: 1.0625rem;\n  }\n  #pf-swiss .mk-footer-list a:is(:hover, :focus-visible) {\n    color: var(--primary);\n    text-decoration: none;\n  }\n  #pf-swiss .mk-footer address {\n    color: var(--muted-foreground);\n    font-size: 1.0625rem;\n    font-style: normal;\n    line-height: 1.45;\n  }\n  #pf-swiss .mk-footer-rule {\n    height: 2px;\n    margin: 0;\n    border: 0;\n    background: var(--foreground);\n  }\n  #pf-swiss .mk-footer-brand {\n    color: inherit;\n  }\n  #pf-swiss .mk-footer-brand-name {\n    font-size: 1.0625rem;\n    font-weight: 700;\n  }\n  #pf-swiss .mk-footer-copy {\n    font-size: 1rem;\n  }\n  @container pf-swiss (max-width: 48rem) {\n    #pf-swiss .mk-header-brand {\n      grid-column: span 8;\n    }\n    #pf-swiss .mk-header-actions {\n      grid-column: span 4;\n    }\n    #pf-swiss .mk-header-nav {\n      grid-column: 1 / -1;\n      grid-row: 2;\n    }\n    #pf-swiss .pf-place {\n      display: none;\n    }\n    #pf-swiss .pf-case-title {\n      grid-column: 1 / span 9;\n    }\n    #pf-swiss .pf-case-mark {\n      grid-column: 10 / -1;\n    }\n    #pf-swiss :is(.pf-case-intro > dl, .pf-case-intro > p, .pf-case-pager a) {\n      grid-column: 1 / -1;\n    }\n    #pf-swiss .pf-case-pager {\n      row-gap: 1.5rem;\n    }\n    #pf-swiss .mk-footer-nav {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n  }\n  /* -- modes: each look in light and dark, derived from the palettes above (the other mode of each look) -- */\n  :root:not(.dark) #pf-swiss {\n    --primary: oklch(0.62 0.235 28);\n    --primary-foreground: oklch(0.17 0.03 28);\n    --accent: oklch(0.955 0 0);\n  }\n  .dark #pf-swiss {\n    --primary-foreground: oklch(0.17 0.03 28);\n    --accent: oklch(0.24 0 0);\n  }\n  /* -- modes: end -- */\n</style>\n<div id=\"pf-swiss\">\n  <div class=\"pf-grid\">\n    <header class=\"mk-header\">\n      <div class=\"mk-header-inner\">\n        <a class=\"mk-header-brand\" href=\"#/\" data-router-link\n          ><span class=\"mk-header-name\">Lukas Graf</span\n          ><span class=\"pf-brand-line\">Grafik, Typografie, Plakate</span></a\n        >\n        <nav class=\"mk-header-nav\" aria-label=\"Main\">\n          <ul class=\"nav-menu-list\">\n            <li class=\"nav-menu-item\"\n              ><a class=\"nav-menu-link\" href=\"#/work\" data-router-link><span>01</span> Work</a></li\n            >\n            <li class=\"nav-menu-item\"\n              ><a class=\"nav-menu-link\" href=\"#/numbers\" data-router-link><span>02</span> In numbers</a></li\n            >\n            <li class=\"nav-menu-item\"\n              ><a class=\"nav-menu-link\" href=\"#/career\" data-router-link><span>03</span> Career</a></li\n            >\n            <li class=\"nav-menu-item\"\n              ><a class=\"nav-menu-link\" href=\"#/contact\" data-router-link><span>04</span> Contact</a></li\n            >\n          </ul>\n        </nav>\n        <div class=\"mk-header-actions\">\n          <span class=\"pf-place\">Zürich, CH</span>\n          <label class=\"swap site-mode\" data-variant=\"rotate\" data-size=\"sm\">\n            <input type=\"checkbox\" data-site-mode aria-label=\"Dark mode\" />\n            <span class=\"swap-on\" aria-hidden=\"true\"><i data-lucide=\"moon\"></i></span>\n            <span class=\"swap-off\" aria-hidden=\"true\"><i data-lucide=\"sun\"></i></span>\n          </label>\n        </div>\n      </div>\n    </header>\n    <div data-pf-view=\"home\">\n      <section class=\"pf-hero\" aria-labelledby=\"pf-sw-name\">\n        <h1 class=\"pf-name\" id=\"pf-sw-name\">\n          <span data-df-entrance=\"wipe\">Lukas</span>\n          <span data-df-entrance=\"wipe\" style=\"--df-motion-delay: 150ms\">Graf</span>\n        </h1>\n        <span class=\"pf-square\" data-df-entrance=\"left\" style=\"--df-motion-delay: 400ms\" aria-hidden=\"true\"></span>\n      </section>\n      <section class=\"pf-intro\" aria-label=\"About\">\n        <img src=\"images/photos/1005-600x800.webp\" alt=\"Lukas Graf\" data-df-entrance=\"fade\" />\n        <p\n          >Posters, identities and typefaces for museums, concert halls and the old town of Zürich. Fourteen years of\n          grids - and of knowing when to break one.</p\n        >\n        <dl>\n          <dt>Now</dt>\n          <dd>Identity of Museum Rietpark's 2027 season</dd>\n          <dt>Teaching</dt>\n          <dd>Typography evening class, since 2019</dd>\n          <dt>Member</dt>\n          <dd>Swiss Poster Guild</dd>\n        </dl>\n      </section>\n      <section class=\"pf-section\" aria-labelledby=\"pf-sw-work\" data-pf-section=\"work\">\n        <h2 id=\"pf-sw-work\"><span>01</span> Work</h2>\n        <ul class=\"mk-portfolio-grid\">\n          <li class=\"mk-portfolio-grid-item\">\n            <a class=\"mk-portfolio-grid-link\" href=\"#/work/halle-neun\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"images/photos/951-700x700.webp\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Halle Neun season posters</strong>\n                <span class=\"mk-portfolio-grid-meta\">Posters, 2026</span>\n              </span>\n            </a>\n          </li>\n          <li class=\"mk-portfolio-grid-item\">\n            <a class=\"mk-portfolio-grid-link\" href=\"#/work/rietpark\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"images/photos/939-700x700.webp\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Museum Rietpark wayfinding</strong>\n                <span class=\"mk-portfolio-grid-meta\">Signage, 2025</span>\n              </span>\n            </a>\n          </li>\n          <li class=\"mk-portfolio-grid-item\">\n            <a class=\"mk-portfolio-grid-link\" href=\"#/work/limmat-grotesk\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"images/photos/403-700x700.webp\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Limmat Grotesk</strong>\n                <span class=\"mk-portfolio-grid-meta\">Typeface, 2024</span>\n              </span>\n            </a>\n          </li>\n          <li class=\"mk-portfolio-grid-item\">\n            <a class=\"mk-portfolio-grid-link\" href=\"#/work/altstadt\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"images/photos/946-700x700.webp\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Altstadt Society</strong>\n                <span class=\"mk-portfolio-grid-meta\">Identity, 2022</span>\n              </span>\n            </a>\n          </li>\n        </ul>\n      </section>\n      <section class=\"pf-section\" aria-labelledby=\"pf-sw-numbers\" data-pf-section=\"numbers\">\n        <h2 id=\"pf-sw-numbers\"><span>02</span> In numbers</h2>\n        <div class=\"mk-stats\">\n          <div class=\"mk-stats-grid\">\n            <div class=\"mk-stat\"\n              ><span class=\"mk-stat-value\">212</span><span class=\"mk-stat-label\">posters printed</span></div\n            >\n            <div class=\"mk-stat\"\n              ><span class=\"mk-stat-value\">14</span><span class=\"mk-stat-label\">typefaces released</span></div\n            >\n            <div class=\"mk-stat\"\n              ><span class=\"mk-stat-value\">9</span><span class=\"mk-stat-label\">design awards</span></div\n            >\n          </div>\n        </div>\n      </section>\n      <section class=\"pf-section\" aria-labelledby=\"pf-sw-cv\" data-pf-section=\"career\">\n        <h2 id=\"pf-sw-cv\"><span>03</span> Career</h2>\n        <ol class=\"mk-resume-entries\" data-variant=\"columns\">\n          <li class=\"mk-resume-entry\">\n            <div class=\"mk-resume-entry-body\">\n              <div class=\"mk-resume-entry-head\">\n                <h3 class=\"mk-resume-entry-title\">Own studio</h3>\n                <p class=\"mk-resume-entry-org\"><span>Zürich</span></p>\n                <p class=\"mk-resume-entry-when\"><time datetime=\"2016\">2016</time> - today</p>\n              </div>\n            </div>\n          </li>\n          <li class=\"mk-resume-entry\">\n            <div class=\"mk-resume-entry-body\">\n              <div class=\"mk-resume-entry-head\">\n                <h3 class=\"mk-resume-entry-title\">Designer</h3>\n                <p class=\"mk-resume-entry-org\"><span>Studio Brunner, Zürich</span></p>\n                <p class=\"mk-resume-entry-when\"\n                  ><time datetime=\"2012\">2012</time> - <time datetime=\"2016\">2016</time></p\n                >\n              </div>\n            </div>\n          </li>\n          <li class=\"mk-resume-entry\">\n            <div class=\"mk-resume-entry-body\">\n              <div class=\"mk-resume-entry-head\">\n                <h3 class=\"mk-resume-entry-title\">Visual communication, BA</h3>\n                <p class=\"mk-resume-entry-org\"><span>Hochschule Rhein, Basel</span></p>\n                <p class=\"mk-resume-entry-when\"\n                  ><time datetime=\"2008\">2008</time> - <time datetime=\"2012\">2012</time></p\n                >\n              </div>\n            </div>\n          </li>\n        </ol>\n      </section>\n      <section class=\"pf-section\" aria-labelledby=\"pf-sw-contact\" data-pf-section=\"contact\">\n        <h2 id=\"pf-sw-contact\"><span>04</span> Contact</h2>\n        <div>\n          <aside class=\"mk-availability\" data-variant=\"banner\" aria-labelledby=\"pf-sw-hire\">\n            <p class=\"mk-availability-status\"\n              ><span class=\"indicator-dot\" data-variant=\"warning\" aria-hidden=\"true\"></span> Limited</p\n            >\n            <p class=\"mk-availability-title\" id=\"pf-sw-hire\">Two poster commissions open for 2027</p>\n          </aside>\n          <a class=\"pf-mail\" href=\"mailto:lukas@example.com\">lukas@example.com</a>\n        </div>\n      </section>\n    </div>\n    <article data-pf-view=\"project\" aria-labelledby=\"pf-sw-case-title\" hidden>\n      <p class=\"pf-case-bar\">\n        <a href=\"#/work\" data-router-link>← Back to the index</a>\n        <span><span data-case=\"no\">01</span> / 04</span>\n      </p>\n      <h1 class=\"pf-case-title\" id=\"pf-sw-case-title\" data-case=\"title\">Halle Neun season posters</h1>\n      <span class=\"pf-case-mark\" aria-hidden=\"true\"></span>\n      <div class=\"pf-case-intro\">\n        <dl>\n          <dt>Client</dt>\n          <dd data-case=\"client\">Halle Neun, Zürich</dd>\n          <dt>Discipline</dt>\n          <dd data-case=\"kind\">Posters</dd>\n          <dt>Year</dt>\n          <dd data-case=\"year\">2026</dd>\n          <dt>Role</dt>\n          <dd data-case=\"role\">Design, typography, print supervision</dd>\n        </dl>\n        <p data-case=\"summary\"\n          >Forty-two concerts, forty-two posters, one grid - a season you can read from across the tram stop.</p\n        >\n      </div>\n      <img\n        class=\"pf-case-cover\"\n        data-case-img=\"0\"\n        data-w=\"1600\"\n        data-h=\"900\"\n        src=\"images/photos/951-1600x900.webp\"\n        alt=\"A building front striped in red, yellow and white\"\n      />\n      <section class=\"pf-section\" aria-labelledby=\"pf-sw-brief\">\n        <h2 id=\"pf-sw-brief\"><span>A</span> Brief</h2>\n        <p data-case=\"brief\"\n          >Halle Neun books jazz, chamber music and electronics in one old engine shed. The season needed one voice for\n          three audiences, and posters that still read at fifty metres on a wet Tuesday.</p\n        >\n      </section>\n      <section class=\"pf-section\" aria-labelledby=\"pf-sw-making\">\n        <h2 id=\"pf-sw-making\"><span>B</span> Work</h2>\n        <div>\n          <p data-case=\"work\"\n            >Every poster sits on the same twelve columns: the date in red at the top left, the act set as large as the\n            grid allows, the hall's stripes as the only image. The stripes turn by genre - level for chamber music,\n            slanted for jazz, upright for the electronic nights - so the series sorts itself on a wall.</p\n          >\n          <div class=\"pf-case-pair\">\n            <img\n              data-case-img=\"1\"\n              data-w=\"800\"\n              data-h=\"800\"\n              src=\"images/photos/158-800x800.webp\"\n              alt=\"Stage lights fanning out over a concert crowd\"\n            />\n            <img\n              data-case-img=\"2\"\n              data-w=\"800\"\n              data-h=\"800\"\n              src=\"images/photos/117-800x800.webp\"\n              alt=\"Raised hands in front of a lit stage in a dark hall\"\n            />\n          </div>\n        </div>\n      </section>\n      <section class=\"pf-section\" aria-labelledby=\"pf-sw-result\">\n        <h2 id=\"pf-sw-result\"><span>C</span> Result</h2>\n        <p data-case=\"result\"\n          >Nine more nights sold out than the season before. The posters went up in 180 frames across the city, and the\n          stripes moved onto the tickets, the programme and the doors of the hall.</p\n        >\n      </section>\n      <nav class=\"pf-case-pager\" aria-label=\"More work\">\n        <a href=\"#/work/altstadt\" data-router-link data-case-link=\"prev\"\n          ><small>← <span>Previous</span></small\n          ><strong data-case-title=\"prev\">Altstadt Society</strong></a\n        >\n        <a href=\"#/work/rietpark\" data-router-link data-case-link=\"next\"\n          ><small><span>Next</span> →</small><strong data-case-title=\"next\">Museum Rietpark wayfinding</strong></a\n        >\n      </nav>\n    </article>\n    <footer class=\"mk-footer\">\n      <div class=\"mk-footer-inner\">\n        <nav class=\"mk-footer-nav\" aria-label=\"Footer\">\n          <div class=\"mk-footer-col\">\n            <h3 class=\"mk-footer-heading\"><span>01</span> Work</h3>\n            <ul class=\"mk-footer-list\">\n              <li><a href=\"#/work/halle-neun\" data-router-link>Halle Neun season posters</a></li>\n              <li><a href=\"#/work/rietpark\" data-router-link>Museum Rietpark wayfinding</a></li>\n              <li><a href=\"#/work/limmat-grotesk\" data-router-link>Limmat Grotesk</a></li>\n              <li><a href=\"#/work/altstadt\" data-router-link>Altstadt Society</a></li>\n            </ul>\n          </div>\n          <div class=\"mk-footer-col\">\n            <h3 class=\"mk-footer-heading\"><span>02</span> Studio</h3>\n            <ul class=\"mk-footer-list\">\n              <li><a href=\"#/numbers\" data-router-link>In numbers</a></li>\n              <li><a href=\"#/career\" data-router-link>Career</a></li>\n              <li><a href=\"#/contact\" data-router-link>Contact</a></li>\n            </ul>\n          </div>\n          <div class=\"mk-footer-col\">\n            <h3 class=\"mk-footer-heading\"><span>03</span> Elsewhere</h3>\n            <ul class=\"mk-footer-list\">\n              <li><a href=\"https://www.instagram.com/\" target=\"_blank\" rel=\"noopener\">Instagram</a></li>\n              <li><a href=\"https://www.behance.net/\" target=\"_blank\" rel=\"noopener\">Behance</a></li>\n              <li><a href=\"mailto:lukas@example.com\">lukas@example.com</a></li>\n            </ul>\n          </div>\n          <div class=\"mk-footer-col\">\n            <h3 class=\"mk-footer-heading\"><span>04</span> Address</h3>\n            <address>Lukas Graf Grafik<br />Ankerstrasse 12<br />8004 Zürich</address>\n          </div>\n        </nav>\n        <hr class=\"separator mk-footer-rule\" />\n        <div class=\"mk-footer-bottom\">\n          <a class=\"mk-footer-brand\" href=\"#/\" data-router-link><span class=\"mk-footer-brand-name\">Lukas Graf</span></a>\n          <div class=\"mk-footer-meta\">\n            <p class=\"mk-footer-copy\">© 2026 Lukas Graf · Set in Inter Tight on twelve columns</p>\n          </div>\n        </div>\n      </div>\n    </footer>\n  </div>\n  <!-- the projects the routes name, in order -->\n  \n</div>\n","individual":false}]
