[{"label":"Lukas Graf, graphic designer","html":"<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;700;800&display=swap');\n  #pf-swiss {\n    --background: oklch(1 0 0);\n    --foreground: oklch(0.14 0 0);\n    --card: oklch(1 0 0);\n    --card-foreground: var(--foreground);\n    --muted: oklch(0.96 0 0);\n    --muted-foreground: oklch(0.45 0 0);\n    --border: var(--foreground);\n    --input: var(--foreground);\n    --primary: oklch(0.6 0.235 28);\n    --primary-foreground: oklch(1 0 0);\n    --secondary: var(--muted);\n    --secondary-foreground: var(--foreground);\n    --accent: var(--muted);\n    --accent-foreground: var(--foreground);\n    --ring: var(--primary);\n    --radius: 0px;\n    --radius-sm: max(0px, calc(var(--radius) - 4px));\n    --radius-md: max(0px, calc(var(--radius) - 2px));\n    --radius-lg: var(--radius);\n    --radius-xl: calc(var(--radius) + 4px);\n    --font-sans: 'Inter Tight', 'Helvetica Neue', Helvetica, Arial, sans-serif;\n    container: pf-swiss / inline-size;\n    box-sizing: border-box;\n    width: 100%;\n    overflow: clip;\n    padding: 1.25rem clamp(1rem, 3vw, 2rem) 3rem;\n    background: var(--background);\n    color: var(--foreground);\n    font-family: var(--font-sans);\n  }\n  .dark #pf-swiss {\n    --background: oklch(0.14 0 0);\n    --foreground: oklch(0.98 0 0);\n    --card: oklch(0.14 0 0);\n    --muted: oklch(0.22 0 0);\n    --muted-foreground: oklch(0.72 0 0);\n    --primary: oklch(0.65 0.23 28);\n  }\n  #pf-swiss .pf-grid {\n    display: grid;\n    grid-template-columns: repeat(12, minmax(0, 1fr));\n    column-gap: clamp(0.75rem, 2cqi, 1.5rem);\n    max-width: 90rem;\n    margin-inline: auto;\n  }\n  #pf-swiss .pf-grid > * {\n    grid-column: 1 / -1;\n  }\n  #pf-swiss .pf-top {\n    display: grid;\n    grid-template-columns: subgrid;\n    padding-block: 0.6rem 2rem;\n    border-block-start: 2px solid var(--foreground);\n    font-size: 1.0625rem;\n    font-weight: 500;\n    line-height: 1.35;\n  }\n  #pf-swiss .pf-top > :nth-child(1) {\n    grid-column: span 3;\n  }\n  #pf-swiss .pf-top > :nth-child(2) {\n    grid-column: span 3;\n  }\n  #pf-swiss .pf-top > :nth-child(3) {\n    grid-column: span 3;\n  }\n  #pf-swiss .pf-top > :nth-child(4) {\n    grid-column: span 3;\n    text-align: end;\n  }\n  #pf-swiss .pf-top p {\n    margin: 0;\n  }\n  #pf-swiss .pf-top a {\n    color: inherit;\n  }\n  #pf-swiss .pf-hero {\n    position: relative;\n    display: grid;\n    grid-template-columns: subgrid;\n    align-items: end;\n    padding-block-end: clamp(2rem, 5cqi, 4rem);\n  }\n  #pf-swiss .pf-name {\n    grid-column: 1 / span 10;\n    margin: 0;\n    font-size: clamp(4rem, 17cqi, 15rem);\n    font-weight: 800;\n    letter-spacing: -0.06em;\n    line-height: 0.82;\n  }\n  #pf-swiss .pf-name span {\n    display: block;\n  }\n  #pf-swiss .pf-square {\n    grid-column: 11 / span 2;\n    align-self: start;\n    width: 100%;\n    aspect-ratio: 1;\n    background: var(--primary);\n  }\n  #pf-swiss .pf-intro {\n    display: grid;\n    grid-template-columns: subgrid;\n    row-gap: 2rem;\n    padding-block: 1.25rem clamp(3rem, 7cqi, 6rem);\n    border-block-start: 2px solid var(--foreground);\n  }\n  #pf-swiss .pf-intro > img {\n    grid-column: span 3;\n    width: 100%;\n    aspect-ratio: 3 / 4;\n    object-fit: cover;\n    filter: grayscale(1) contrast(1.1);\n  }\n  #pf-swiss .pf-intro > p {\n    grid-column: span 6;\n    margin: 0;\n    font-size: clamp(1.25rem, 0.9rem + 1.3cqi, 2.125rem);\n    font-weight: 500;\n    letter-spacing: -0.02em;\n    line-height: 1.15;\n    text-wrap: pretty;\n  }\n  #pf-swiss .pf-intro > dl {\n    grid-column: span 3;\n    margin: 0;\n    font-size: 1.0625rem;\n    line-height: 1.45;\n  }\n  #pf-swiss .pf-intro dt {\n    margin-block-start: 1rem;\n    font-weight: 700;\n  }\n  #pf-swiss .pf-intro dt:first-child {\n    margin-block-start: 0;\n  }\n  #pf-swiss .pf-intro dd {\n    margin: 0;\n    color: var(--muted-foreground);\n  }\n  #pf-swiss .pf-section {\n    display: grid;\n    grid-template-columns: subgrid;\n    row-gap: 1.5rem;\n    padding-block: 1rem clamp(3rem, 7cqi, 6rem);\n    border-block-start: 2px solid var(--foreground);\n  }\n  #pf-swiss .pf-section > h2 {\n    grid-column: span 3;\n    margin: 0;\n    font-size: 1.125rem;\n    font-weight: 700;\n  }\n  #pf-swiss .pf-section > h2 span {\n    color: var(--primary);\n  }\n  #pf-swiss .pf-section > :not(h2) {\n    grid-column: 4 / -1;\n  }\n  #pf-swiss .mk-portfolio-grid {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    grid-auto-rows: auto;\n    gap: clamp(0.75rem, 2cqi, 1.5rem);\n  }\n  #pf-swiss .mk-portfolio-grid-link {\n    border-radius: 0;\n    background: none;\n  }\n  #pf-swiss .mk-portfolio-grid-media {\n    aspect-ratio: 1;\n    height: auto;\n    filter: grayscale(1) contrast(1.1);\n    transition:\n      filter 0.3s,\n      scale 0.5s;\n  }\n  #pf-swiss .mk-portfolio-grid-link:is(:hover, :focus-visible) .mk-portfolio-grid-media {\n    filter: none;\n  }\n  #pf-swiss .mk-portfolio-grid-caption {\n    position: static;\n    padding: 0.6rem 0 0;\n    background: none;\n    color: var(--foreground);\n    text-shadow: none;\n  }\n  #pf-swiss .mk-portfolio-grid-title {\n    font-size: 1.125rem;\n  }\n  #pf-swiss .mk-portfolio-grid-meta {\n    color: var(--muted-foreground);\n    font-size: 1rem;\n  }\n  #pf-swiss .mk-stat-label {\n    font-size: 1.0625rem;\n  }\n  #pf-swiss .mk-resume-entry-title {\n    font-size: 1.25rem;\n  }\n  #pf-swiss :is(.mk-resume-entry-org, .mk-resume-entry-when, .mk-resume-entry-body) {\n    font-size: 1.0625rem;\n  }\n  #pf-swiss .mk-availability-status {\n    font-size: 1rem;\n  }\n  #pf-swiss .mk-stats {\n    padding: 0;\n  }\n  #pf-swiss .mk-stats-grid {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n  #pf-swiss .mk-stat {\n    border-inline-start: 2px solid var(--foreground);\n  }\n  #pf-swiss .mk-stat-value {\n    font-size: clamp(3rem, 2rem + 4cqi, 6rem);\n    font-weight: 800;\n    letter-spacing: -0.05em;\n    color: var(--primary);\n  }\n  #pf-swiss .mk-availability {\n    border: 0;\n    border-block-start: 2px solid var(--foreground);\n    box-shadow: none;\n    padding-inline: 0;\n  }\n  #pf-swiss .pf-mail {\n    display: block;\n    margin-block-start: 1.5rem;\n    color: inherit;\n    font-size: clamp(2rem, 1rem + 5cqi, 5.5rem);\n    font-weight: 800;\n    letter-spacing: -0.05em;\n    line-height: 1;\n    text-decoration: none;\n    overflow-wrap: anywhere;\n  }\n  #pf-swiss .pf-mail:is(:hover, :focus-visible) {\n    color: var(--primary);\n  }\n  @container pf-swiss (max-width: 48rem) {\n    #pf-swiss .pf-top > :nth-child(n) {\n      grid-column: span 6;\n      text-align: start;\n    }\n    #pf-swiss .pf-name {\n      grid-column: 1 / -1;\n    }\n    #pf-swiss .pf-square {\n      position: absolute;\n      grid-area: auto;\n      inset-block-start: 0;\n      inset-inline-end: 0;\n      width: 24%;\n    }\n    #pf-swiss .pf-intro > img {\n      grid-column: span 5;\n    }\n    #pf-swiss .pf-intro > p {\n      grid-column: span 7;\n    }\n    #pf-swiss .pf-intro > dl {\n      grid-column: 1 / -1;\n    }\n    #pf-swiss .pf-section > h2,\n    #pf-swiss .pf-section > :not(h2) {\n      grid-column: 1 / -1;\n    }\n    #pf-swiss .mk-portfolio-grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n    #pf-swiss .mk-stats-grid {\n      grid-template-columns: minmax(0, 1fr);\n    }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    #pf-swiss .mk-portfolio-grid-media {\n      transition: none;\n    }\n  }\n  /* light or dark: the Swap writes the page's dark class - every look has a light and a dark palette */\n  #pf-swiss .site-mode {\n    flex: none;\n    border: 1px solid var(--input);\n    border-radius: var(--radius-md);\n    background: var(--background);\n    color: var(--foreground);\n  }\n  #pf-swiss .site-mode:hover {\n    background: var(--accent);\n    color: var(--accent-foreground);\n  }\n  #pf-swiss {\n    position: relative;\n  }\n  #pf-swiss > .site-mode {\n    position: absolute;\n    z-index: 20;\n    inset: var(--site-mode-top, 0.75rem) clamp(0.75rem, 2vw, 1.25rem) auto auto;\n  }\n  /* -- modes: each look in light and dark, derived from the palettes above (the other mode of each look) -- */\n  :root:not(.dark) #pf-swiss {\n    --primary: oklch(0.62 0.235 28);\n    --primary-foreground: oklch(0.17 0.03 28);\n    --accent: oklch(0.955 0 0);\n  }\n  .dark #pf-swiss {\n    --primary-foreground: oklch(0.17 0.03 28);\n    --accent: oklch(0.24 0 0);\n  }\n  /* -- modes: end -- */\n</style>\n<div id=\"pf-swiss\">\n  <label class=\"swap site-mode\" data-variant=\"rotate\" data-size=\"sm\">\n    <input type=\"checkbox\" data-site-mode aria-label=\"Dark mode\" />\n    <span class=\"swap-on\" aria-hidden=\"true\"><i data-lucide=\"moon\"></i></span>\n    <span class=\"swap-off\" aria-hidden=\"true\"><i data-lucide=\"sun\"></i></span>\n  </label>\n  <div class=\"pf-grid\">\n    <header class=\"pf-top\">\n      <p>Lukas Graf</p>\n      <p>Grafik, Typografie, Plakate</p>\n      <p>Zürich, CH</p>\n      <p><a href=\"mailto:lukas@example.com\">lukas@example.com</a></p>\n    </header>\n    <section class=\"pf-hero\" aria-labelledby=\"pf-sw-name\">\n      <h1 class=\"pf-name\" id=\"pf-sw-name\">\n        <span data-df-entrance=\"wipe\">Lukas</span>\n        <span data-df-entrance=\"wipe\" style=\"--df-motion-delay: 150ms\">Graf</span>\n      </h1>\n      <span class=\"pf-square\" data-df-entrance=\"left\" style=\"--df-motion-delay: 400ms\" aria-hidden=\"true\"></span>\n    </section>\n    <section class=\"pf-intro\" aria-label=\"About\">\n      <img src=\"https://picsum.photos/id/669/600/800\" alt=\"Lukas Graf\" data-df-entrance=\"fade\" />\n      <p\n        >Posters, identities and typefaces for museums, theatres and the city of Zürich. Fourteen years of grids - and\n        of knowing when to break one.</p\n      >\n      <dl>\n        <dt>Now</dt>\n        <dd>Identity of the Kunsthaus 2027 season</dd>\n        <dt>Teaching</dt>\n        <dd>Typography, ZHdK, since 2019</dd>\n        <dt>Member</dt>\n        <dd>Alliance Graphique Internationale</dd>\n      </dl>\n    </section>\n    <section class=\"pf-section\" aria-labelledby=\"pf-sw-work\">\n      <h2 id=\"pf-sw-work\"><span>01</span> Work</h2>\n      <ul class=\"mk-portfolio-grid\">\n        <li class=\"mk-portfolio-grid-item\">\n          <a class=\"mk-portfolio-grid-link\" href=\"#\">\n            <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/951/700/700\" alt=\"\" />\n            <span class=\"mk-portfolio-grid-caption\">\n              <strong class=\"mk-portfolio-grid-title\">Tonhalle season posters</strong>\n              <span class=\"mk-portfolio-grid-meta\">Posters, 2026</span>\n            </span>\n          </a>\n        </li>\n        <li class=\"mk-portfolio-grid-item\">\n          <a class=\"mk-portfolio-grid-link\" href=\"#\">\n            <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/939/700/700\" alt=\"\" />\n            <span class=\"mk-portfolio-grid-caption\">\n              <strong class=\"mk-portfolio-grid-title\">Kunsthaus wayfinding</strong>\n              <span class=\"mk-portfolio-grid-meta\">Signage, 2025</span>\n            </span>\n          </a>\n        </li>\n        <li class=\"mk-portfolio-grid-item\">\n          <a class=\"mk-portfolio-grid-link\" href=\"#\">\n            <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/403/700/700\" alt=\"\" />\n            <span class=\"mk-portfolio-grid-caption\">\n              <strong class=\"mk-portfolio-grid-title\">Limmat Grotesk</strong>\n              <span class=\"mk-portfolio-grid-meta\">Typeface, 2024</span>\n            </span>\n          </a>\n        </li>\n        <li class=\"mk-portfolio-grid-item\">\n          <a class=\"mk-portfolio-grid-link\" href=\"#\">\n            <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/1047/700/700\" alt=\"\" />\n            <span class=\"mk-portfolio-grid-caption\">\n              <strong class=\"mk-portfolio-grid-title\">City of Zürich</strong>\n              <span class=\"mk-portfolio-grid-meta\">Identity, 2022</span>\n            </span>\n          </a>\n        </li>\n      </ul>\n    </section>\n    <section class=\"pf-section\" aria-labelledby=\"pf-sw-numbers\">\n      <h2 id=\"pf-sw-numbers\"><span>02</span> In numbers</h2>\n      <div class=\"mk-stats\">\n        <div class=\"mk-stats-grid\">\n          <div class=\"mk-stat\"\n            ><span class=\"mk-stat-value\">212</span><span class=\"mk-stat-label\">posters printed</span></div\n          >\n          <div class=\"mk-stat\"\n            ><span class=\"mk-stat-value\">14</span><span class=\"mk-stat-label\">typefaces released</span></div\n          >\n          <div class=\"mk-stat\"\n            ><span class=\"mk-stat-value\">9</span><span class=\"mk-stat-label\">Swiss Design Awards</span></div\n          >\n        </div>\n      </div>\n    </section>\n    <section class=\"pf-section\" aria-labelledby=\"pf-sw-cv\">\n      <h2 id=\"pf-sw-cv\"><span>03</span> Career</h2>\n      <ol class=\"mk-resume-entries\" data-variant=\"columns\">\n        <li class=\"mk-resume-entry\">\n          <div class=\"mk-resume-entry-body\">\n            <div class=\"mk-resume-entry-head\">\n              <h3 class=\"mk-resume-entry-title\">Own studio</h3>\n              <p class=\"mk-resume-entry-org\"><span>Zürich</span></p>\n              <p class=\"mk-resume-entry-when\"><time datetime=\"2016\">2016</time> - today</p>\n            </div>\n          </div>\n        </li>\n        <li class=\"mk-resume-entry\">\n          <div class=\"mk-resume-entry-body\">\n            <div class=\"mk-resume-entry-head\">\n              <h3 class=\"mk-resume-entry-title\">Designer</h3>\n              <p class=\"mk-resume-entry-org\"><a href=\"#\">Studio Brunner</a></p>\n              <p class=\"mk-resume-entry-when\"><time datetime=\"2012\">2012</time> - <time datetime=\"2016\">2016</time></p>\n            </div>\n          </div>\n        </li>\n        <li class=\"mk-resume-entry\">\n          <div class=\"mk-resume-entry-body\">\n            <div class=\"mk-resume-entry-head\">\n              <h3 class=\"mk-resume-entry-title\">Visual communication, BA</h3>\n              <p class=\"mk-resume-entry-org\"><a href=\"#\">Schule für Gestaltung Basel</a></p>\n              <p class=\"mk-resume-entry-when\"><time datetime=\"2008\">2008</time> - <time datetime=\"2012\">2012</time></p>\n            </div>\n          </div>\n        </li>\n      </ol>\n    </section>\n    <section class=\"pf-section\" aria-labelledby=\"pf-sw-contact\">\n      <h2 id=\"pf-sw-contact\"><span>04</span> Contact</h2>\n      <div>\n        <aside class=\"mk-availability\" data-variant=\"banner\" aria-labelledby=\"pf-sw-hire\">\n          <p class=\"mk-availability-status\"\n            ><span class=\"indicator-dot\" data-variant=\"warning\" aria-hidden=\"true\"></span> Limited</p\n          >\n          <p class=\"mk-availability-title\" id=\"pf-sw-hire\">Two poster commissions open for 2027</p>\n        </aside>\n        <a class=\"pf-mail\" href=\"mailto:lukas@example.com\">lukas@example.com</a>\n      </div>\n    </section>\n  </div>\n</div>\n","individual":false}]
