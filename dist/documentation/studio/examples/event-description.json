[{"label":"Default","html":"<section class=\"mk-event-description\" aria-label=\"About the event\">\n  <div class=\"mk-event-description-layout\">\n    <div class=\"mk-event-description-body\">\n      <section aria-labelledby=\"ed-about\"\n        ><h2 id=\"ed-about\">About</h2\n        ><p\n          >Acme Summit brings together the people who build the tools teams use every day. Two days, one track, no\n          sponsor pitches - just honest talks on making software calmer, and workshops where you leave with something\n          built.</p\n        ></section\n      >\n      <section aria-labelledby=\"ed-who\"\n        ><h2 id=\"ed-who\">Who it is for</h2>\n        <ul class=\"mk-event-description-audience\"\n          ><li><i data-lucide=\"lightbulb\"></i>Product managers</li\n          ><li><i data-lucide=\"pen-tool\"></i>Designers</li\n          ><li><i data-lucide=\"code\"></i>Engineers</li\n          ><li><i data-lucide=\"users\"></i>Team leads</li></ul\n        >\n      </section>\n      <section aria-labelledby=\"ed-take\"\n        ><h2 id=\"ed-take\">What you will take away</h2>\n        <ul class=\"mk-event-description-takeaways\"\n          ><li><i data-lucide=\"check\"></i>A playbook for async planning</li\n          ><li><i data-lucide=\"check\"></i>Patterns for quiet, accessible UI</li\n          ><li><i data-lucide=\"check\"></i>How offline-first sync really works</li\n          ><li><i data-lucide=\"check\"></i>Fifty new colleagues to ask</li></ul\n        >\n      </section>\n    </div>\n    <aside class=\"mk-event-description-facts\" aria-label=\"Event facts\">\n      <dl>\n        <div><dt>Date</dt><dd>12–13 Nov 2026</dd></div>\n        <div><dt>Format</dt><dd>In person + stream</dd></div>\n        <div><dt>Language</dt><dd>English</dd></div>\n        <div><dt>Price</dt><dd>From €290</dd></div>\n        <div><dt>Recordings</dt><dd>For all attendees</dd></div>\n      </dl>\n      <div class=\"mk-event-description-capacity\"\n        ><label for=\"ed-seats\"><strong>320 of 400</strong> seats taken</label\n        ><meter id=\"ed-seats\" min=\"0\" max=\"400\" low=\"300\" high=\"380\" optimum=\"0\" value=\"320\">320 of 400</meter></div\n      >\n      <a class=\"btn\" href=\"#\">Register</a>\n    </aside>\n  </div>\n</section>\n","individual":true}]
