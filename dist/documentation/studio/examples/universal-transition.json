[{"label":"Kinetic Typography","html":"<section\n  class=\"presentation\"\n  id=\"deck-morph\"\n  data-anim-in=\"zoomIn\"\n  data-anim-in-scale=\"0.6\"\n  data-anim-out=\"zoomOut\"\n  style=\"\n    --presentation-ink: #111111;\n    --presentation-ink-foreground: #ffffff;\n    --presentation-paper: #f5f4f0;\n    --presentation-paper-foreground: #111111;\n    --presentation-accent: #ff3e00;\n    font-family: Arial, Helvetica, sans-serif;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"120,000 tickets - one dataset, four forms\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Festival tickets by sales channel, 120,000 in total: app 46,000, web 38,000, box office 17,000, resellers 12,000, partners 7,000, morphing from bars to a donut to sized dots to revenue bars\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Cover\">\n    <p\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        right: -40px;\n        bottom: -80px;\n        margin: 0;\n        font:\n          900 26rem/0.8 'Arial Black',\n          Impact,\n          sans-serif;\n        color: #ff3e00;\n        opacity: 0.9;\n        letter-spacing: -0.06em;\n      \"\n      >120K</p\n    >\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\"\n      >Universal transition · Kinetic Typography</p\n    >\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        position: relative;\n        max-width: 1250px;\n        font-family: 'Arial Black', Impact, sans-serif;\n        text-transform: uppercase;\n        letter-spacing: -0.03em;\n        font-size: 10rem;\n      \"\n      >Sold out</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >A three-day festival, 120,000 tickets, five ways to buy one.</p\n    >\n    <p class=\"presentation-note\">The giant number is the whole cover.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"bars\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Bars\"\n  >\n    <header class=\"presentation-header\"><span>Rank it</span><span>Tickets by channel</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Arial Black', Impact, sans-serif;\n        text-transform: uppercase;\n        letter-spacing: -0.03em;\n        font-size: 3.2rem;\n      \"\n      >Rank it: the app wins</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Bars answer: which channel is biggest?</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"donut\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Donut\"\n  >\n    <header class=\"presentation-header\"><span>Compose it</span><span>Share of 120,000</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Arial Black', Impact, sans-serif;\n        text-transform: uppercase;\n        letter-spacing: -0.03em;\n        font-size: 3.2rem;\n      \"\n      >Compose it: 70% online</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The same five bars fold into a ring.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"dots\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Dots\"\n  >\n    <header class=\"presentation-header\"><span>Distribute it</span><span>Tickets × average price</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Arial Black', Impact, sans-serif;\n        text-transform: uppercase;\n        letter-spacing: -0.03em;\n        font-size: 3.2rem;\n      \"\n      >Distribute it: resellers charge most</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The ring bursts into dots - x is volume, y is average price.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Three numbers from the box office</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: 'Arial Black', Impact, sans-serif;\n            text-transform: uppercase;\n            letter-spacing: -0.03em;\n          \"\n          ><span data-count=\"120\">120</span>K</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">tickets, sold out in 19 days</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #ff3e00;\n            font-family: 'Arial Black', Impact, sans-serif;\n            text-transform: uppercase;\n            letter-spacing: -0.03em;\n          \"\n          ><span data-count=\"70\">70</span>%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">bought on the app or the web</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: 'Arial Black', Impact, sans-serif;\n            text-transform: uppercase;\n            letter-spacing: -0.03em;\n          \"\n          >€<span data-count=\"19.4\">19.4</span>M</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">ticket revenue</p>\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >The box office still sold 17,000 - mostly day tickets on the gate.</p\n    >\n    <p class=\"presentation-note\">Three numbers, huge type.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Festival\" style=\"overflow: hidden\">\n    <video\n      autoplay\n      muted\n      loop\n      playsinline\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n        opacity: 0.55;\n        mix-blend-mode: screen;\n      \"\n    >\n      <source src=\"videos/demo.webm\" type=\"video/webm\" />\n      <source src=\"videos/demo.mp4\" type=\"video/mp4\" />\n    </video>\n    <div\n      aria-hidden=\"true\"\n      style=\"position: absolute; inset: 0; background: linear-gradient(90deg, #111111 30%, rgba(255, 62, 0, 0.3))\"\n    ></div>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\">Three days</p>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"blur\"\n      style=\"\n        position: relative;\n        font-size: 5rem;\n        max-width: 1100px;\n        font-family: 'Arial Black', Impact, sans-serif;\n        text-transform: uppercase;\n        letter-spacing: -0.03em;\n        font-size: 4.5rem;\n      \"\n      >Forty acts, two stages, one field</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 400ms; position: relative; max-width: 900px\"\n      >The loop is the mood; the chart is the business behind it.</p\n    >\n    <p class=\"presentation-note\">Let the loop breathe for a moment.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"north\"\n    data-anim-in-blocks=\"5\"\n    data-anim-in-color=\"#FF3E00\"\n    aria-label=\"Channel table\"\n  >\n    <header class=\"presentation-header\"><span>The ledger</span><span>By channel</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" data-density=\"spacious\" style=\"font-size: 1.7rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Festival tickets by sales channel (synthetic).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Channel</th><th class=\"table-head\" style=\"text-align: right\">Tickets</th\n            ><th class=\"table-head\" style=\"text-align: right\">Avg price</th\n            ><th class=\"table-head\" style=\"text-align: right\">Revenue</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">App</td><td class=\"table-cell\" style=\"text-align: right\">46,000</td\n            ><td class=\"table-cell\" style=\"text-align: right\">€161</td\n            ><td class=\"table-cell\" style=\"text-align: right\">€7.4 M</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Web</td><td class=\"table-cell\" style=\"text-align: right\">38,000</td\n            ><td class=\"table-cell\" style=\"text-align: right\">€166</td\n            ><td class=\"table-cell\" style=\"text-align: right\">€6.3 M</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Box office</td><td class=\"table-cell\" style=\"text-align: right\">17,000</td\n            ><td class=\"table-cell\" style=\"text-align: right\">€129</td\n            ><td class=\"table-cell\" style=\"text-align: right\">€2.2 M</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Resellers</td><td class=\"table-cell\" style=\"text-align: right\">12,000</td\n            ><td class=\"table-cell\" style=\"text-align: right\">€217</td\n            ><td class=\"table-cell\" style=\"text-align: right\">€2.6 M</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Partners</td><td class=\"table-cell\" style=\"text-align: right\">7,000</td\n            ><td class=\"table-cell\" style=\"text-align: right\">€129</td\n            ><td class=\"table-cell\" style=\"text-align: right\">€0.9 M</td></tr\n          >\n        </tbody>\n        <tfoot>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Total</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">120,000</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">€162</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">€19.4 M</td></tr\n          >\n        </tfoot>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Resellers: fewest tickets, highest price.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"\n          font-size: 3.3rem;\n          line-height: 1.22;\n          font-family: 'Arial Black', Impact, sans-serif;\n          text-transform: uppercase;\n          letter-spacing: -0.03em;\n          font-size: 3.2rem;\n        \"\n        >“The app queue opened at nine. By ten past, a third of the festival was gone.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #ff3e00; color: #111111\"\n        ><span class=\"avatar-fallback\">ZC</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Zoë Carter<br /><span style=\"opacity: 0.7; font-size: 1.4rem\">Festival ticketing lead - fictional</span></p\n      >\n    </div>\n    <p class=\"presentation-note\">The ten-minute story.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"revenue\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Revenue\"\n  >\n    <header class=\"presentation-header\"><span>Earn it</span><span>Revenue by channel, € M</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Arial Black', Impact, sans-serif;\n        text-transform: uppercase;\n        letter-spacing: -0.03em;\n        font-size: 3.2rem;\n      \"\n      >Earn it: €19.4 M</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The dots land as revenue bars - same names, fourth form.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Questions from the promoters\"\n  >\n    <header class=\"presentation-header\"><span>Q & A</span><span>Promoters</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.2rem;\n        margin-block: 5.25rem 1.5rem;\n        font-family: 'Arial Black', Impact, sans-serif;\n        text-transform: uppercase;\n        letter-spacing: -0.03em;\n        font-size: 3rem;\n      \"\n      >Questions from the promoters</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"ut-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Should we cap resale prices?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >A cap at face value +10% would cut reseller revenue by about €0.7 M - and fan complaints by most of it.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"ut-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Why keep the box office?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Day tickets and last-minute buyers: 60% of its sales were on the festival days.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"ut-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Next year: more app?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >The app sold fastest; its queue needs capacity for 30,000 users at once.</p\n          ></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The resale question is the hot one.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Takeaways</span><span>Never cut away</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">→</span\n        ><span>Morph the same data instead of cutting between charts.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">→</span\n        ><span>Stable names carry identity across forms.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">→</span\n        ><span>Online sold 70% - plan the queue, not just the stage.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">→</span\n        ><span>Resale is small in volume and big in attention.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Fast read, big type.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"south\"\n    data-anim-in-blocks=\"5\"\n    data-anim-in-color=\"#FF3E00\"\n    aria-label=\"Closing\"\n  >\n    <p\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        right: -40px;\n        bottom: -80px;\n        margin: 0;\n        font:\n          900 26rem/0.8 'Arial Black',\n          Impact,\n          sans-serif;\n        color: #ff3e00;\n        opacity: 0.9;\n        letter-spacing: -0.06em;\n      \"\n      >120K</p\n    >\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        font-family: 'Arial Black', Impact, sans-serif;\n        text-transform: uppercase;\n        letter-spacing: -0.03em;\n        font-size: 8rem;\n      \"\n      >Never cut away</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px\"\n      >A synthetic festival - one dataset in four forms is the real technique.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">Hold on the closing line.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 12</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"12\" value=\"1\"></progress>\n</section>\n","individual":false}]
