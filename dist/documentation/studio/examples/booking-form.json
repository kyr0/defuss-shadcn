[{"label":"Default","html":"<section class=\"mk-booking-form\" aria-labelledby=\"bk-title\">\n  <h2 id=\"bk-title\" class=\"sr-only\">Book an appointment</h2>\n  <form action=\"#\" method=\"post\">\n    <div class=\"mk-booking-form-layout\">\n      <div style=\"display: grid; gap: 2rem\">\n        <fieldset class=\"mk-booking-form-group\">\n          <legend>1. Choose a service</legend>\n          <div class=\"mk-booking-form-options\">\n            <label class=\"mk-booking-form-option\" for=\"bk-intro\"\n              ><input class=\"radio\" type=\"radio\" name=\"service\" id=\"bk-intro\" value=\"bk-intro\" checked required /><span\n                ><strong>Intro call</strong><small>20 min · video</small></span\n              ><b>Free</b></label\n            >\n            <label class=\"mk-booking-form-option\" for=\"bk-workshop\"\n              ><input class=\"radio\" type=\"radio\" name=\"service\" id=\"bk-workshop\" value=\"bk-workshop\" required /><span\n                ><strong>Team workshop</strong><small>90 min · on site or video</small></span\n              ><b>€240</b></label\n            >\n            <label class=\"mk-booking-form-option\" for=\"bk-review\"\n              ><input class=\"radio\" type=\"radio\" name=\"service\" id=\"bk-review\" value=\"bk-review\" required /><span\n                ><strong>Workspace review</strong><small>45 min · video</small></span\n              ><b>€90</b></label\n            >\n          </div>\n        </fieldset>\n        <fieldset class=\"mk-booking-form-group\">\n          <legend>2. Pick a date and time</legend>\n          <div class=\"mk-booking-form-field\"\n            ><label class=\"label\" for=\"bk-date\">Date</label\n            ><input class=\"input\" type=\"date\" id=\"bk-date\" name=\"date\" min=\"2026-10-02\" value=\"2026-10-06\" required\n          /></div>\n          <div class=\"mk-booking-form-slots\" role=\"group\" aria-label=\"Available times\">\n            <label class=\"mk-booking-form-slot\"\n              ><input type=\"radio\" name=\"slot\" value=\"09:00\" required /><span>09:00</span></label\n            ><label class=\"mk-booking-form-slot\"\n              ><input type=\"radio\" name=\"slot\" value=\"09:30\" disabled required /><span>09:30</span></label\n            ><label class=\"mk-booking-form-slot\"\n              ><input type=\"radio\" name=\"slot\" value=\"10:00\" checked required /><span>10:00</span></label\n            ><label class=\"mk-booking-form-slot\"\n              ><input type=\"radio\" name=\"slot\" value=\"11:30\" required /><span>11:30</span></label\n            ><label class=\"mk-booking-form-slot\"\n              ><input type=\"radio\" name=\"slot\" value=\"13:00\" disabled required /><span>13:00</span></label\n            ><label class=\"mk-booking-form-slot\"\n              ><input type=\"radio\" name=\"slot\" value=\"14:30\" required /><span>14:30</span></label\n            ><label class=\"mk-booking-form-slot\"\n              ><input type=\"radio\" name=\"slot\" value=\"16:00\" required /><span>16:00</span></label\n            ><label class=\"mk-booking-form-slot\"\n              ><input type=\"radio\" name=\"slot\" value=\"16:30\" disabled required /><span>16:30</span></label\n            >\n          </div>\n          <span class=\"mk-booking-form-tz\">Times in Lisbon time (WEST, UTC+1)</span>\n        </fieldset>\n      </div>\n      <div style=\"display: grid; gap: 2rem; align-content: start\">\n        <fieldset class=\"mk-booking-form-group\">\n          <legend>3. Your details</legend>\n          <div class=\"mk-booking-form-fields\">\n            <div class=\"mk-booking-form-field\"\n              ><label class=\"label\" for=\"bk-name\">Name</label\n              ><input class=\"input\" id=\"bk-name\" name=\"name\" autocomplete=\"name\" required\n            /></div>\n            <div class=\"mk-booking-form-field\"\n              ><label class=\"label\" for=\"bk-email\">Email</label\n              ><input class=\"input\" id=\"bk-email\" type=\"email\" name=\"email\" autocomplete=\"email\" required\n            /></div>\n            <div class=\"mk-booking-form-field\" data-span=\"full\"\n              ><label class=\"label\" for=\"bk-notes\">Anything we should know?</label><textarea class=\"textarea\" id=\"bk-notes\" name=\"notes\" rows=\"3\"></textarea>\n            </div>\n          </div>\n        </fieldset>\n        <div class=\"mk-booking-form-summary\">\n          <p>You can change or cancel up to 24 hours before. We send a calendar invite right away.</p>\n          <button class=\"btn\" type=\"submit\">Confirm booking</button>\n        </div>\n      </div>\n    </div>\n  </form>\n</section>\n","individual":true},{"label":"Compact","html":"<section class=\"mk-booking-form\" data-variant=\"compact\" aria-labelledby=\"bk2-title\">\n  <form action=\"#\" method=\"post\">\n    <fieldset class=\"mk-booking-form-group\">\n      <legend id=\"bk2-title\">Book a table · Tomorrow</legend>\n      <div class=\"mk-booking-form-slots\" role=\"group\" aria-label=\"Available times\">\n        <label class=\"mk-booking-form-slot\"\n          ><input type=\"radio\" name=\"slot\" value=\"18:00\" required /><span>18:00</span></label\n        ><label class=\"mk-booking-form-slot\"\n          ><input type=\"radio\" name=\"slot\" value=\"18:30\" disabled required /><span>18:30</span></label\n        ><label class=\"mk-booking-form-slot\"\n          ><input type=\"radio\" name=\"slot\" value=\"19:00\" checked required /><span>19:00</span></label\n        ><label class=\"mk-booking-form-slot\"\n          ><input type=\"radio\" name=\"slot\" value=\"19:30\" required /><span>19:30</span></label\n        ><label class=\"mk-booking-form-slot\"\n          ><input type=\"radio\" name=\"slot\" value=\"20:00\" disabled required /><span>20:00</span></label\n        ><label class=\"mk-booking-form-slot\"\n          ><input type=\"radio\" name=\"slot\" value=\"21:00\" required /><span>21:00</span></label\n        >\n      </div>\n    </fieldset>\n    <div class=\"mk-booking-form-fields\">\n      <div class=\"mk-booking-form-field\"\n        ><label class=\"label\" for=\"bk2-guests\">Guests</label\n        ><input class=\"input\" type=\"number\" id=\"bk2-guests\" name=\"guests\" min=\"1\" max=\"8\" value=\"2\" inputmode=\"numeric\"\n      /></div>\n      <div class=\"mk-booking-form-field\"\n        ><label class=\"label\" for=\"bk2-phone\">Phone</label\n        ><input class=\"input\" type=\"tel\" id=\"bk2-phone\" name=\"phone\" autocomplete=\"tel\" required\n      /></div>\n    </div>\n    <button class=\"btn\" type=\"submit\">Reserve</button>\n  </form>\n</section>\n","individual":true}]
