[{"label":"In / out and lifecycle","html":"<style>\n  #anim-fade-target {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 160px;\n    height: 100px;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    background: var(--card);\n    color: var(--card-foreground);\n    font-weight: 600;\n  }\n</style>\n<div style=\"display: flex; flex-direction: column; gap: 0.85rem; align-items: flex-start\">\n  <div id=\"anim-fade-target\">fade me</div>\n  <div style=\"display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-fade-in\">In</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-fade-out\">Out</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-fade-pause\">Pause</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-fade-resume\">Resume</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-fade-finish\">Finish</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-fade-reset\">Reset</button>\n    <span class=\"badge\" data-variant=\"secondary\" id=\"anim-fade-state\">idle</span>\n  </div>\n  <div style=\"display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center\">\n    <label class=\"text-sm\" for=\"anim-fade-duration\">Duration (ms)</label>\n    <input class=\"input\" type=\"number\" id=\"anim-fade-duration\" value=\"1500\" min=\"0\" step=\"50\" style=\"width: 6rem\" />\n    <label class=\"text-sm\" for=\"anim-fade-easing\">Easing</label>\n    <select class=\"select\" id=\"anim-fade-easing\">\n      <option value=\"cubic-bezier(0.16, 1, 0.3, 1)\" selected>ease-out (default)</option>\n      <option value=\"ease\">ease</option>\n      <option value=\"ease-in-out\">ease-in-out</option>\n      <option value=\"linear\">linear</option>\n      <option value=\"cubic-bezier(.34,1.56,.64,1)\">spring-ish</option>\n    </select>\n  </div>\n</div>\n","individual":false},{"label":"Scroll-bound fade","html":"<style>\n  #anim-fade-scroll-target {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 160px;\n    height: 100px;\n    margin: 1rem;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    background: var(--card);\n    color: var(--card-foreground);\n    font-weight: 600;\n  }\n</style>\n<div\n  id=\"anim-fade-scroller\"\n  style=\"height: 220px; overflow-y: auto; border: 1px solid var(--border); border-radius: var(--radius-lg)\"\n>\n  <div\n    style=\"\n      height: 600px;\n      display: flex;\n      align-items: flex-start;\n      justify-content: center;\n      padding: 1rem;\n      color: var(--muted-foreground);\n    \"\n    >Scroll down - the scroll position is the fade's timeline.</div\n  >\n  <div id=\"anim-fade-scroll-target\">scroll-driven</div>\n  <div style=\"height: 200px\"></div>\n</div>\n","individual":false}]
