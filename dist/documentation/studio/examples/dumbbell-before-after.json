[{"label":"Financial Broadsheet","html":"<section\n  class=\"presentation\"\n  id=\"deck-dumbbell\"\n  data-anim-in=\"wipeIn\"\n  data-anim-in-direction=\"north\"\n  data-anim-out=\"fadeOut\"\n  style=\"\n    --presentation-ink: #1d2a23;\n    --presentation-ink-foreground: #f4eedc;\n    --presentation-paper: #f4eedc;\n    --presentation-paper-foreground: #1d2a23;\n    --presentation-accent: #a51c30;\n    font-family: Georgia, 'Times New Roman', serif;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"Rents 2019 to 2025 - a broadsheet deck\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Monthly rent per square metre in seven districts, 2019 versus 2025, Harbor up 61 percent, then rent as a share of median income\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Cover\">\n    <div\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        inset-inline: 7%;\n        inset-block-start: 7%;\n        border-block: 3px double currentColor;\n        height: 1.1rem;\n        opacity: 0.5;\n      \"\n    ></div>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\"\n      >Dumbbell · Financial Broadsheet</p\n    >\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"position: relative; max-width: 1250px; font-weight: 400; letter-spacing: -0.01em; font-size: 6.5rem\"\n      >Rents, six years on</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >Seven districts, two dates, one gap that matters more than either endpoint.</p\n    >\n    <p class=\"presentation-note\">The double rule is the masthead; the deck reads like the business section.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"gap\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Rent per m²\"\n  >\n    <header class=\"presentation-header\"><span>The market</span><span>€ per m² per month · 2019 → 2025</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 400;\n        letter-spacing: -0.01em;\n      \"\n      >Every district got dearer - Old Town leads at €19.80</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Hollow dot 2019, burgundy dot 2025: the line between them is the story.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"growth\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Sorted by growth\"\n  >\n    <header class=\"presentation-header\"><span>The market</span><span>Sorted by % change</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 400;\n        letter-spacing: -0.01em;\n      \"\n      >Harbor moved fastest: +61% in six years</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The same dumbbells re-sort - the cheapest districts rose the most.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"change\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Change\"\n  >\n    <header class=\"presentation-header\"><span>The change</span><span>% change 2019 → 2025</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 400;\n        letter-spacing: -0.01em;\n      \"\n      >The catch-up: cheap districts are closing the gap</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Each dumbbell collapses into its change bar.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Three numbers for the housing committee</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #a51c30;\n            font-weight: 400;\n            letter-spacing: -0.01em;\n          \"\n          >+<span data-count=\"61\">61</span>%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">rent rise in Harbor since 2019</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-weight: 400;\n            letter-spacing: -0.01em;\n          \"\n          >€<span data-count=\"19.8\">19.8</span></p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\"\n          >per m² in Old Town - the new ceiling</p\n        >\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-weight: 400;\n            letter-spacing: -0.01em;\n          \"\n          ><span data-count=\"31\">31</span>%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\"\n          >of median income for a 70 m² flat, city average</p\n        >\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >The rule of thumb says 30%. Five of seven districts are above it.</p\n    >\n    <p class=\"presentation-note\">The 30% line is the one people remember.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Street view\">\n    <header class=\"presentation-header\"><span>On the street</span><span>Harbor district</span></header>\n    <div style=\"display: flex; gap: 4.5rem; align-items: center; margin-top: 3.5rem\">\n      <div style=\"flex: 1 1 0; min-width: 0\">\n        <h2\n          class=\"presentation-title\"\n          data-df-entrance=\"up\"\n          style=\"font-size: 3.4rem; font-weight: 400; letter-spacing: -0.01em\"\n          >Warehouses became flats; the flats became expensive</h2\n        >\n        <p class=\"presentation-lede\" data-df-entrance=\"fade\" style=\"--df-motion-delay: 300ms; font-size: 1.7rem\"\n          >Harbor had the cheapest rents in 2019. Twelve conversions later it sits mid-table - and still climbing.</p\n        >\n      </div>\n      <figure\n        class=\"image\"\n        data-ratio=\"4/3\"\n        data-df-entrance=\"wipe\"\n        style=\"--df-motion-delay: 150ms; flex: 0 0 700px; margin: 0\"\n      >\n        <img\n          src=\"https://picsum.photos/id/57/960/720\"\n          alt=\"A quiet city street lined with brick buildings and parked cars\"\n          loading=\"lazy\"\n          width=\"960\"\n          height=\"720\"\n          style=\"width: 100%; height: 100%; object-fit: cover\"\n        />\n        <figcaption class=\"image-caption\" style=\"font-size: 1.25rem\"\n          >A converted street near the harbor (stock photo).</figcaption\n        >\n      </figure>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Pause on the photo - this is what +61% looks like.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"north\"\n    data-anim-in-blocks=\"6\"\n    data-anim-in-color=\"#A51C30\"\n    aria-label=\"Rent table\"\n  >\n    <header class=\"presentation-header\"><span>The data</span><span>€ per m² per month</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" style=\"font-size: 1.45rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Median asking rent per m², seven districts (synthetic).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">District</th><th class=\"table-head\" style=\"text-align: right\">2019</th\n            ><th class=\"table-head\" style=\"text-align: right\">2025</th\n            ><th class=\"table-head\" style=\"text-align: right\">Change</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Old Town</td><td class=\"table-cell\" style=\"text-align: right\">14.20</td\n            ><td class=\"table-cell\" style=\"text-align: right\">19.80</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+39%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Riverside</td><td class=\"table-cell\" style=\"text-align: right\">12.60</td\n            ><td class=\"table-cell\" style=\"text-align: right\">18.90</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+50%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">University</td><td class=\"table-cell\" style=\"text-align: right\">11.80</td\n            ><td class=\"table-cell\" style=\"text-align: right\">16.40</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+39%</td></tr\n          >\n          <tr class=\"table-row\" style=\"font-weight: 700\"\n            ><td class=\"table-cell\">Harbor</td><td class=\"table-cell\" style=\"text-align: right\">9.40</td\n            ><td class=\"table-cell\" style=\"text-align: right\">15.10</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+61%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Midtown</td><td class=\"table-cell\" style=\"text-align: right\">10.90</td\n            ><td class=\"table-cell\" style=\"text-align: right\">14.30</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+31%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Suburbs</td><td class=\"table-cell\" style=\"text-align: right\">8.90</td\n            ><td class=\"table-cell\" style=\"text-align: right\">11.20</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+26%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Industrial</td><td class=\"table-cell\" style=\"text-align: right\">7.10</td\n            ><td class=\"table-cell\" style=\"text-align: right\">10.60</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+49%</td></tr\n          >\n        </tbody>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Figures in the table, argument in the chart.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"font-size: 3.3rem; line-height: 1.22; font-weight: 400; letter-spacing: -0.01em\"\n        >“We used to send students to Harbor. Now we send them to Industrial - and next year, probably further.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #a51c30; color: #f4eedc\"\n        ><span class=\"avatar-fallback\">AV</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Amira Vogt<br /><span style=\"opacity: 0.7; font-size: 1.4rem\"\n          >Student housing office - 11 years of placements</span\n        ></p\n      >\n    </div>\n    <p class=\"presentation-note\">The quote makes the geography personal.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"burden\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Rent burden\"\n  >\n    <header class=\"presentation-header\"\n      ><span>The burden</span><span>Rent for 70 m² as % of median income</span></header\n    >\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 400;\n        letter-spacing: -0.01em;\n      \"\n      >Five districts now cost more than 30% of income</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The dots become columns: 2019 against 2025, per district.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Questions from the committee\"\n  >\n    <header class=\"presentation-header\"><span>Q & A</span><span>Housing committee</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"font-size: 3.2rem; margin-block: 5.25rem 1.5rem; font-weight: 400; letter-spacing: -0.01em\"\n      >Questions from the committee</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"db-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Are these asking rents or paid rents?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Asking rents for new contracts; sitting tenants pay on average 18% less.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"db-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Did incomes not rise too?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >They did, by 14% - which is why the burden rose by points, not by the full rent increase.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"db-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Which district is next?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Industrial: +49% already, and the first two conversions open next spring.</p\n          ></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Keep one answer open at a time.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Takeaways</span><span>For the housing plan</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">§</span\n        ><span>The cheapest districts rise fastest - protect them before, not after.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">§</span\n        ><span>Conversions drive the jumps: track permits, not just rents.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">§</span\n        ><span>Report burden, not only price - 30% of income is the line people feel.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">§</span\n        ><span>Industrial is where Harbor was in 2019.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Four lines - then open the floor.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"south\"\n    data-anim-in-blocks=\"5\"\n    data-anim-in-color=\"#A51C30\"\n    aria-label=\"Closing\"\n  >\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        font-weight: 400;\n        letter-spacing: -0.01em;\n      \"\n      >Mind the gap</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px\"\n      >Seven districts, two dates - synthetic figures, a very real pattern.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">Close on the metaphor.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 12</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"12\" value=\"1\"></progress>\n</section>\n","individual":false}]
