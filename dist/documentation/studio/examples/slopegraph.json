[{"label":"Terminal Data Noir","html":"<section\n  class=\"presentation\"\n  id=\"deck-slope\"\n  data-anim-in=\"wipeIn\"\n  data-anim-in-direction=\"west\"\n  data-anim-out=\"blurOut\"\n  style=\"\n    --presentation-ink: #050706;\n    --presentation-ink-foreground: #c9ffd8;\n    --presentation-paper: #0c140f;\n    --presentation-paper-foreground: #c9ffd8;\n    --presentation-accent: #43ff76;\n    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"Languages in job ads 2020 to 2025 - terminal deck\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Share of job ads mentioning seven programming languages in 2020 and 2025: TypeScript up 10 points, Python up 8, Java down 7\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Cover\">\n    <p\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        inset-block-start: 7%;\n        inset-inline-start: 7%;\n        margin: 0;\n        font-size: 1.4rem;\n        color: #43ff76;\n        opacity: 0.8;\n      \"\n      >$ jobs --languages --since 2020 ▍</p\n    >\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\"\n      >Slopegraph · Terminal Data Noir</p\n    >\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"position: relative; max-width: 1250px; font-weight: 700; letter-spacing: -0.02em; font-size: 5.5rem\"\n      >What employers asked for, 2020 → 2025</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >Seven languages, 184,000 job ads, two snapshots - direction before magnitude.</p\n    >\n    <p class=\"presentation-note\">The prompt line is decoration - the deck talks like a terminal.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"slope\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"All slopes\"\n  >\n    <header class=\"presentation-header\"><span>share_of_ads</span><span>% of ads · 2020 → 2025</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n      \"\n      >Four up, three down</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Green climbs, red slides. Read the direction first, the numbers second.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"risers\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Risers\"\n  >\n    <header class=\"presentation-header\"><span>share_of_ads</span><span>filter: rising</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n      \"\n      >TypeScript doubled - Rust grew fivefold from a tiny base</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The fallers dim; the risers keep their light.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"delta\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Change in points\"\n  >\n    <header class=\"presentation-header\"><span>delta_pp</span><span>percentage points</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n      \"\n      >Net change: +10 for TypeScript, −7 for Java</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Slopes become deltas - one bar per language.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Three numbers for the hiring plan</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #43ff76;\n            font-weight: 700;\n            letter-spacing: -0.02em;\n          \"\n          >+<span data-count=\"10\">10</span> pp</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">TypeScript - the biggest climb</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-weight: 700;\n            letter-spacing: -0.02em;\n          \"\n          ><span data-count=\"29\">29</span>%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">of all ads now ask for Python</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #ff5f56;\n            font-weight: 700;\n            letter-spacing: -0.02em;\n          \"\n          >−<span data-count=\"7\">7</span> pp</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">Java - still third, but falling</p>\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >Python and TypeScript together appear in almost half of all ads.</p\n    >\n    <p class=\"presentation-note\">Shares overlap: an ad can ask for more than one language.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"At the desk\">\n    <header class=\"presentation-header\"><span>context</span><span>ads sampled weekly</span></header>\n    <div style=\"display: flex; gap: 4.5rem; align-items: center; margin-top: 3.5rem\">\n      <figure\n        class=\"image\"\n        data-ratio=\"4/3\"\n        data-df-entrance=\"blur\"\n        style=\"--df-motion-delay: 150ms; flex: 0 0 700px; margin: 0\"\n      >\n        <img\n          src=\"https://picsum.photos/id/60/960/720\"\n          alt=\"Top-down view of a desk with a keyboard, a tablet, notebooks and a mouse\"\n          loading=\"lazy\"\n          width=\"960\"\n          height=\"720\"\n          style=\"width: 100%; height: 100%; object-fit: cover\"\n        />\n        <figcaption class=\"image-caption\" style=\"font-size: 1.25rem\">A developer’s desk (stock photo).</figcaption>\n      </figure>\n      <div style=\"flex: 1 1 0; min-width: 0\">\n        <h2\n          class=\"presentation-title\"\n          data-df-entrance=\"up\"\n          style=\"font-size: 3.4rem; font-weight: 700; letter-spacing: -0.02em\"\n          >One stack per team, many stacks per ad</h2\n        >\n        <p class=\"presentation-lede\" data-df-entrance=\"fade\" style=\"--df-motion-delay: 300ms; font-size: 1.7rem\"\n          >The typical 2025 ad lists 2.4 languages, up from 1.8 - full-stack roles pull TypeScript along with everything\n          else.</p\n        >\n      </div>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Explain the overlap before someone asks.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"west\"\n    data-anim-in-blocks=\"8\"\n    data-anim-in-stagger=\"40\"\n    data-anim-in-color=\"#43FF76\"\n    aria-label=\"Share table\"\n  >\n    <header class=\"presentation-header\"><span>SELECT *</span><span>% of job ads</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" style=\"font-size: 1.45rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Share of job ads mentioning each language (synthetic sample of 184,000 ads).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Language</th><th class=\"table-head\" style=\"text-align: right\">2020</th\n            ><th class=\"table-head\" style=\"text-align: right\">2025</th\n            ><th class=\"table-head\" style=\"text-align: right\">Δ pp</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Python</td><td class=\"table-cell\" style=\"text-align: right\">21</td\n            ><td class=\"table-cell\" style=\"text-align: right\">29</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+8</td></tr\n          >\n          <tr class=\"table-row\" style=\"font-weight: 700\"\n            ><td class=\"table-cell\">TypeScript</td><td class=\"table-cell\" style=\"text-align: right\">9</td\n            ><td class=\"table-cell\" style=\"text-align: right\">19</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+10</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Java</td><td class=\"table-cell\" style=\"text-align: right\">24</td\n            ><td class=\"table-cell\" style=\"text-align: right\">17</td\n            ><td class=\"table-cell\" style=\"text-align: right\">−7</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">C#</td><td class=\"table-cell\" style=\"text-align: right\">13</td\n            ><td class=\"table-cell\" style=\"text-align: right\">12</td\n            ><td class=\"table-cell\" style=\"text-align: right\">−1</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Go</td><td class=\"table-cell\" style=\"text-align: right\">4</td\n            ><td class=\"table-cell\" style=\"text-align: right\">8</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+4</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">PHP</td><td class=\"table-cell\" style=\"text-align: right\">11</td\n            ><td class=\"table-cell\" style=\"text-align: right\">6</td\n            ><td class=\"table-cell\" style=\"text-align: right\">−5</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Rust</td><td class=\"table-cell\" style=\"text-align: right\">1</td\n            ><td class=\"table-cell\" style=\"text-align: right\">5</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+4</td></tr\n          >\n        </tbody>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Every number on one screen, for the follow-up.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"font-size: 3.3rem; line-height: 1.22; font-weight: 700; letter-spacing: -0.02em; font-size: 2.8rem\"\n        >“We stopped writing “JavaScript” in our ads. Nobody applies for it anymore - they apply for TypeScript.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #43ff76; color: #050706\"\n        ><span class=\"avatar-fallback\">RN</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Rafael Nunes<br /><span style=\"opacity: 0.7; font-size: 1.4rem\"\n          >Engineering recruiter - 1,300 roles filled</span\n        ></p\n      >\n    </div>\n    <p class=\"presentation-note\">The quote explains the TypeScript jump better than any chart.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"rank\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"2025 ranking\"\n  >\n    <header class=\"presentation-header\"><span>ORDER BY share_2025</span><span>% of ads · 2025</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n      \"\n      >The 2025 league table</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The delta bars regrow into the 2025 shares and re-sort.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Questions from the team\"\n  >\n    <header class=\"presentation-header\"><span>Q & A</span><span>engineering all-hands</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"font-size: 3.2rem; margin-block: 5.25rem 1.5rem; font-weight: 700; letter-spacing: -0.02em\"\n      >Questions from the team</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"sl-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Is Java dying?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >No - 17% of ads is still a third place. It is losing share to TypeScript on the backend, not\n            disappearing.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"sl-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Why does Rust matter at 5%?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Growth from 1% signals where infrastructure teams are heading; salaries in those ads are 18% above\n            median.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"sl-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Should we rewrite anything?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >No. Hire for the language, train for the stack - the ads are a lagging indicator.</p\n          ></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The Java question always comes first.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>takeaways</span><span>exit 0</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">></span\n        ><span>TypeScript is the default for new web roles - write it into the ad.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">></span\n        ><span>Python keeps growing on the back of data and AI work.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">></span\n        ><span>Java and PHP still fill a quarter of ads combined: do not drop them.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">></span\n        ><span>Watch Rust and Go - small shares, steep slopes.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Read, then open the floor.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"east\"\n    data-anim-in-blocks=\"8\"\n    data-anim-in-stagger=\"40\"\n    data-anim-in-color=\"#43FF76\"\n    aria-label=\"Closing\"\n  >\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n      \"\n      >Direction before magnitude</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px\"\n      >Seven lines, two dates - synthetic ads, a familiar shift.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">End on the rule.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 12</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"12\" value=\"1\"></progress>\n</section>\n","individual":false}]
