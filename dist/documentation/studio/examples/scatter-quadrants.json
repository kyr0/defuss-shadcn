[{"label":"Annual Report Corporate","html":"<section\n  class=\"presentation\"\n  id=\"deck-quadrants\"\n  data-anim-in=\"slideIn\"\n  data-anim-in-direction=\"south\"\n  data-anim-in-distance=\"60px\"\n  data-anim-out=\"fadeOut\"\n  style=\"\n    --presentation-ink: #12304a;\n    --presentation-ink-foreground: #f3f6fa;\n    --presentation-paper: #f3f6fa;\n    --presentation-paper-foreground: #12304a;\n    --presentation-accent: #0a7e8c;\n    font-family: 'Avenir Next', 'Segoe UI', Arial, sans-serif;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"Portfolio review 2025 - growth and retention\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Eight software products by year-over-year growth and net revenue retention, bubble size annual recurring revenue: Nimbus, Ledgerly and Relay are stars; then ARR bars and 2026 targets\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Cover\">\n    <svg\n      aria-hidden=\"true\"\n      width=\"620\"\n      height=\"620\"\n      viewBox=\"0 0 620 620\"\n      style=\"position: absolute; right: 110px; top: 140px\"\n    >\n      <rect x=\"0\" y=\"0\" width=\"300\" height=\"300\" fill=\"#0A7E8C\" opacity=\"0.9\" />\n      <rect x=\"320\" y=\"0\" width=\"300\" height=\"300\" fill=\"#12304A\" opacity=\"0.12\" />\n      <rect x=\"0\" y=\"320\" width=\"300\" height=\"300\" fill=\"#12304A\" opacity=\"0.12\" />\n      <rect x=\"320\" y=\"320\" width=\"300\" height=\"300\" fill=\"#12304A\" opacity=\"0.06\" />\n    </svg>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\"\n      >Scatter quadrants · Annual Report</p\n    >\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        position: relative;\n        max-width: 1250px;\n        font-family: 'Avenir Next', 'Segoe UI', Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n        font-size: 6.25rem;\n        max-width: 760px;\n      \"\n      >Portfolio review 2025</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >Eight products, two questions: are they growing, and do customers stay and spend more?</p\n    >\n    <p class=\"presentation-note\">The teal square is the corner everyone wants to be in.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"map\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Portfolio map\"\n  >\n    <header class=\"presentation-header\"\n      ><span>Portfolio</span><span>Growth × net revenue retention · bubble = ARR</span></header\n    >\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Avenir Next', 'Segoe UI', Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n      \"\n      >Where each product stands</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Right = growing, up = expanding accounts. Bubble size is revenue.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"stars\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"The stars\"\n  >\n    <header class=\"presentation-header\"><span>Portfolio</span><span>Top-right quadrant</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Avenir Next', 'Segoe UI', Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n      \"\n      >Three stars: Nimbus, Ledgerly, Relay</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Everything outside the corner dims.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"arr\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"ARR\"\n  >\n    <header class=\"presentation-header\"><span>Revenue</span><span>Annual recurring revenue, € M</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Avenir Next', 'Segoe UI', Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n      \"\n      >The money still sits in the slow quadrant</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The bubbles collapse into bars - Harbor CRM and Atlas pay the bills.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Three numbers for the board</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: 'Avenir Next', 'Segoe UI', Arial, sans-serif;\n            font-weight: 700;\n            letter-spacing: -0.02em;\n          \"\n          >€<span data-count=\"139\">139</span> M</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">total ARR across eight products</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: 'Avenir Next', 'Segoe UI', Arial, sans-serif;\n            font-weight: 700;\n            letter-spacing: -0.02em;\n          \"\n          ><span data-count=\"30\">30</span>%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">of it from one product: Harbor CRM</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #0a7e8c;\n            font-family: 'Avenir Next', 'Segoe UI', Arial, sans-serif;\n            font-weight: 700;\n            letter-spacing: -0.02em;\n          \"\n          ><span data-count=\"128\">128</span>%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">net revenue retention at Nimbus</p>\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >The stars are growing fast, but they are a third of the revenue. The plan has to fund one with the other.</p\n    >\n    <p class=\"presentation-note\">The funding tension is the board conversation.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Customers\">\n    <header class=\"presentation-header\"><span>Customers</span><span>4,800 accounts</span></header>\n    <div style=\"display: flex; gap: 4.5rem; align-items: center; margin-top: 3.5rem\">\n      <figure\n        class=\"image\"\n        data-ratio=\"4/3\"\n        data-df-entrance=\"up\"\n        style=\"--df-motion-delay: 150ms; flex: 0 0 700px; margin: 0\"\n      >\n        <img\n          src=\"https://picsum.photos/id/48/960/720\"\n          alt=\"An open laptop on a wooden table in a bright café\"\n          loading=\"lazy\"\n          width=\"960\"\n          height=\"720\"\n          style=\"width: 100%; height: 100%; object-fit: cover\"\n        />\n        <figcaption class=\"image-caption\" style=\"font-size: 1.25rem\"\n          >Where our customers work (stock photo).</figcaption\n        >\n      </figure>\n      <div style=\"flex: 1 1 0; min-width: 0\">\n        <h2\n          class=\"presentation-title\"\n          data-df-entrance=\"up\"\n          style=\"\n            font-size: 3.4rem;\n            font-family: 'Avenir Next', 'Segoe UI', Arial, sans-serif;\n            font-weight: 700;\n            letter-spacing: -0.02em;\n          \"\n          >Retention is a product decision</h2\n        >\n        <p class=\"presentation-lede\" data-df-entrance=\"fade\" style=\"--df-motion-delay: 300ms; font-size: 1.7rem\"\n          >Nimbus accounts add seats every quarter because onboarding takes ten minutes. Pathway accounts leave because\n          it takes ten days.</p\n        >\n      </div>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Tie retention to onboarding - the key insight.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"north\"\n    data-anim-in-blocks=\"5\"\n    data-anim-in-color=\"#0A7E8C\"\n    aria-label=\"Portfolio table\"\n  >\n    <header class=\"presentation-header\"><span>The data</span><span>FY 2025</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" style=\"font-size: 1.45rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Fictional software portfolio, FY 2025 (synthetic).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Product</th><th class=\"table-head\" style=\"text-align: right\">Growth</th\n            ><th class=\"table-head\" style=\"text-align: right\">NRR</th\n            ><th class=\"table-head\" style=\"text-align: right\">ARR (€ M)</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\" style=\"font-weight: 700\"\n            ><td class=\"table-cell\">Nimbus</td><td class=\"table-cell\" style=\"text-align: right\">+62%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">128%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">14</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Ledgerly</td><td class=\"table-cell\" style=\"text-align: right\">+48%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">118%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">22</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Relay</td><td class=\"table-cell\" style=\"text-align: right\">+33%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">112%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">9</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Harbor CRM</td><td class=\"table-cell\" style=\"text-align: right\">+18%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">104%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">41</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Atlas</td><td class=\"table-cell\" style=\"text-align: right\">+12%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">109%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">31</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Pathway</td><td class=\"table-cell\" style=\"text-align: right\">+71%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">96%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">6</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Sprout</td><td class=\"table-cell\" style=\"text-align: right\">+55%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">88%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">4</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Quill</td><td class=\"table-cell\" style=\"text-align: right\">+9%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">93%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">12</td></tr\n          >\n        </tbody>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">NRR above 100% means existing customers grow on their own.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"\n          font-size: 3.3rem;\n          line-height: 1.22;\n          font-family: 'Avenir Next', 'Segoe UI', Arial, sans-serif;\n          font-weight: 700;\n          letter-spacing: -0.02em;\n          font-size: 3rem;\n        \"\n        >“Growth without retention is a leaky bucket with a fast tap. Pathway taught us that in one year.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #0a7e8c; color: #f3f6fa\"\n        ><span class=\"avatar-fallback\">SO</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Sara Osei<br /><span style=\"opacity: 0.7; font-size: 1.4rem\"\n          >Chief product officer - 8 products, 1 portfolio</span\n        ></p\n      >\n    </div>\n    <p class=\"presentation-note\">The bucket metaphor lands with finance people.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"plan\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"2026 plan\"\n  >\n    <header class=\"presentation-header\"><span>Plan 2026</span><span>Target positions</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Avenir Next', 'Segoe UI', Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n      \"\n      >The 2026 plan: move Pathway and Sprout up, not right</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The bubbles travel to their targets - retention first for the leaky ones.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Questions from the board\"\n  >\n    <header class=\"presentation-header\"><span>Q & A</span><span>Board meeting</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.2rem;\n        margin-block: 5.25rem 1.5rem;\n        font-family: 'Avenir Next', 'Segoe UI', Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n      \"\n      >Questions from the board</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"sq-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Should we sunset Quill?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Not yet - €12 M ARR at 93% retention still returns cash; we freeze new features instead.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"sq-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Why not push Harbor CRM harder?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\">Its market grows 6% a year; 18% growth already means taking share.</p></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"sq-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>What does the plan cost?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\">€9 M in onboarding and success teams, mostly for Pathway and Sprout.</p></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Quill is the emotional one - keep it factual.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Takeaways</span><span>Portfolio actions</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">◼</span\n        ><span>Fund the stars from the cash cows - deliberately, with a number.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">◼</span\n        ><span>Fix retention before buying growth.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">◼</span\n        ><span>Freeze, don’t kill, the low-growth, high-cash products.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">◼</span\n        ><span>Review positions quarterly; the map moves.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Four actions for the minutes.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"south\"\n    data-anim-in-blocks=\"5\"\n    data-anim-in-color=\"#0A7E8C\"\n    aria-label=\"Closing\"\n  >\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        font-family: 'Avenir Next', 'Segoe UI', Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.02em;\n      \"\n      >Position answers two questions at once</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px\"\n      >Eight fictional products, synthetic figures - the quadrant logic is the real tool.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">Close on the method.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 12</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"12\" value=\"1\"></progress>\n</section>\n","individual":false}]
