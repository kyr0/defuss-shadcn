[{"label":"Default","html":"<form action=\"#\" method=\"post\">\n  <fieldset class=\"mk-payment-form\">\n    <legend>Payment</legend>\n    <div class=\"mk-payment-form-methods\">\n      <label><input type=\"radio\" name=\"method\" value=\"card\" checked /><i data-lucide=\"credit-card\"></i>Card</label>\n      <label><input type=\"radio\" name=\"method\" value=\"paypal\" /><i data-lucide=\"wallet\"></i>PayPal</label>\n      <label><input type=\"radio\" name=\"method\" value=\"bank\" /><i data-lucide=\"landmark\"></i>Bank transfer</label>\n    </div>\n    <div class=\"mk-payment-form-panel\" data-method=\"card\">\n      <div class=\"mk-payment-form-fields\">\n        <div class=\"mk-payment-form-field mk-payment-form-number\" data-span=\"full\"\n          ><label class=\"label\" for=\"pf-num\">Card number</label\n          ><div class=\"mk-payment-form-number\"\n            ><input\n              class=\"input\"\n              id=\"pf-num\"\n              name=\"cc-number\"\n              autocomplete=\"cc-number\"\n              inputmode=\"numeric\"\n              pattern=\"[0-9 ]{13,23}\"\n              placeholder=\"1234 1234 1234 1234\"\n            /><ul aria-hidden=\"true\"\n              ><li>VISA</li\n              ><li>MC</li\n              ><li>AMEX</li></ul\n            ></div\n          ></div\n        >\n        <div class=\"mk-payment-form-field\"\n          ><label class=\"label\" for=\"pf-exp\">Expiry</label\n          ><input\n            class=\"input\"\n            id=\"pf-exp\"\n            name=\"cc-exp\"\n            autocomplete=\"cc-exp\"\n            inputmode=\"numeric\"\n            placeholder=\"MM / YY\"\n        /></div>\n        <div class=\"mk-payment-form-field\"\n          ><label class=\"label\" for=\"pf-cvc\">Security code</label\n          ><input\n            class=\"input\"\n            id=\"pf-cvc\"\n            name=\"cc-csc\"\n            autocomplete=\"cc-csc\"\n            inputmode=\"numeric\"\n            maxlength=\"4\"\n            placeholder=\"CVC\"\n        /></div>\n        <div class=\"mk-payment-form-field\" data-span=\"full\"\n          ><label class=\"label\" for=\"pf-name\">Name on card</label\n          ><input class=\"input\" id=\"pf-name\" name=\"cc-name\" autocomplete=\"cc-name\"\n        /></div>\n      </div>\n      <div class=\"checkbox-item\"\n        ><input class=\"checkbox\" type=\"checkbox\" id=\"pf-save\" name=\"save\" /><label for=\"pf-save\"\n          >Save this card for next time</label\n        ></div\n      >\n    </div>\n    <div class=\"mk-payment-form-panel\" data-method=\"paypal\"\n      ><p>You will be sent to PayPal to approve the payment, then back here to confirm.</p></div\n    >\n    <div class=\"mk-payment-form-panel\" data-method=\"bank\">\n      <p>Transfer the total within 7 days. Your order ships when the money arrives.</p>\n      <dl\n        ><div><dt>IBAN</dt><dd>PT50 0002 0123 1234 5678 9015 4</dd></div\n        ><div><dt>Reference</dt><dd>A-20481</dd></div></dl\n      >\n    </div>\n    <button class=\"btn\" data-size=\"lg\" type=\"submit\">Pay €88.90</button>\n    <p class=\"mk-payment-form-note\"\n      ><i data-lucide=\"lock\"></i> Payments are encrypted and processed by our payment provider.</p\n    >\n  </fieldset>\n</form>\n","individual":true},{"label":"Saved cards","html":"<fieldset class=\"mk-payment-form\">\n  <legend>Pay with</legend>\n  <div class=\"mk-payment-form-saved\">\n    <label\n      ><input class=\"radio\" type=\"radio\" name=\"card\" value=\"visa\" checked /><span class=\"mk-payment-form-brand\"\n        >VISA</span\n      ><span>•••• 4242</span><small>Expires 08/28</small></label\n    >\n    <label\n      ><input class=\"radio\" type=\"radio\" name=\"card\" value=\"mc\" /><span class=\"mk-payment-form-brand\">MC</span\n      ><span>•••• 5100</span><small>Expires 01/27</small></label\n    >\n    <label\n      ><input class=\"radio\" type=\"radio\" name=\"card\" value=\"new\" /><span\n        class=\"mk-payment-form-brand\"\n        aria-hidden=\"true\"\n        >+</span\n      ><span>Use another card</span><small></small\n    ></label>\n  </div>\n</fieldset>\n","individual":true}]
