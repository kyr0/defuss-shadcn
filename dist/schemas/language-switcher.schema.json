{
  "schemaVersion": 1,
  "name": "language-switcher",
  "states": {
    "value": {
      "type": "string",
      "target": {
        "kind": "root"
      },
      "mutation": {
        "kind": "api",
        "name": "default",
        "args": {
          "value": "@value"
        }
      },
      "observation": {
        "kind": "attribute",
        "name": "data-value"
      },
      "editor": {
        "component": "text"
      }
    },
    "open": {
      "type": "boolean",
      "default": false,
      "target": {
        "kind": "root"
      },
      "mutation": {
        "kind": "api",
        "name": "open"
      },
      "observation": {
        "kind": "attribute",
        "name": "data-state-name"
      },
      "editor": {
        "component": "checkbox"
      }
    }
  },
  "actions": {}
}
