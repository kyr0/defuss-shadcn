[{"label":"An account area","html":"<div style=\"display: flex; flex-direction: column; gap: 3rem; width: 100%\">\n  <section class=\"mk-login-form\" data-variant=\"split\" aria-labelledby=\"lf2-title\">\n    <div class=\"mk-login-form-split\">\n      <div class=\"mk-login-form-panel\">\n        <div class=\"mk-login-form-head\"\n          ><svg\n            viewBox=\"0 0 24 24\"\n            width=\"28\"\n            height=\"28\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            aria-hidden=\"true\"\n          >\n            <polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\" /></svg\n          ><h1 id=\"lf2-title\">Sign in to Acme</h1></div\n        >\n        <form action=\"#\" method=\"post\">\n          <div class=\"mk-auth-field\"\n            ><label class=\"label\" for=\"lf2-email\">Email</label\n            ><input class=\"input\" id=\"lf2-email\" type=\"email\" name=\"email\" autocomplete=\"username\" required\n          /></div>\n          <div class=\"mk-auth-field\"\n            ><label class=\"label\" for=\"lf2-pass\">Password</label\n            ><input\n              class=\"input\"\n              id=\"lf2-pass\"\n              type=\"password\"\n              name=\"password\"\n              autocomplete=\"current-password\"\n              required\n          /></div>\n          <button class=\"btn\" type=\"submit\">Sign in</button>\n        </form>\n        <p class=\"mk-login-form-foot\"><a href=\"#\">Forgot your password?</a></p>\n      </div>\n      <figure class=\"mk-login-form-aside\" style=\"margin: 0\">\n        <img src=\"https://picsum.photos/seed/login-aside/800/1000\" alt=\"\" />\n        <blockquote>\"Acme gave our team its afternoons back.\"</blockquote>\n        <figcaption>Marco Rossi, COO at Globex</figcaption>\n      </figure>\n    </div>\n  </section>\n  <div style=\"display: grid; gap: 1rem; max-width: 24rem; width: 100%\">\n    <div class=\"mk-social-login\" data-variant=\"icons\">\n      <a class=\"btn\" data-variant=\"outline\" href=\"#\" aria-label=\"Continue with Google\"\n        ><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" aria-hidden=\"true\">\n          <path\n            fill=\"#4285F4\"\n            d=\"M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.4h6.5a5.6 5.6 0 0 1-2.4 3.7v3h3.9c2.3-2.1 3.5-5.2 3.5-8.8Z\"\n          />\n          <path\n            fill=\"#34A853\"\n            d=\"M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2-3.1 0-5.8-2.1-6.7-5H1.3v3.1A12 12 0 0 0 12 24Z\"\n          />\n          <path fill=\"#FBBC05\" d=\"M5.3 14.3a7.2 7.2 0 0 1 0-4.6V6.6h-4a12 12 0 0 0 0 10.8l4-3.1Z\" />\n          <path\n            fill=\"#EA4335\"\n            d=\"M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4A11.9 11.9 0 0 0 1.3 6.6l4 3.1c.9-2.9 3.6-4.9 6.7-4.9Z\"\n          /></svg\n      ></a>\n      <a class=\"btn\" data-variant=\"outline\" href=\"#\" aria-label=\"Continue with Apple\"\n        ><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"currentColor\" aria-hidden=\"true\">\n          <path\n            d=\"M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9a4.8 4.8 0 0 0-3.8-2c-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9a5 5 0 0 0-4.2 2.6c-1.8 3.1-.5 7.7 1.3 10.2.8 1.2 1.8 2.6 3.1 2.5 1.3 0 1.7-.8 3.2-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.4a10 10 0 0 0 1.4-2.8 4.3 4.3 0 0 1-2.1-4.2ZM14 5.1A4.2 4.2 0 0 0 15 2a4.4 4.4 0 0 0-2.8 1.5 4.1 4.1 0 0 0-1 3c1 .1 2.1-.5 2.8-1.4Z\"\n          /></svg\n      ></a>\n      <a class=\"btn\" data-variant=\"outline\" href=\"#\" aria-label=\"Continue with GitHub\"\n        ><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"currentColor\" aria-hidden=\"true\">\n          <path\n            d=\"M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2.1c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5Z\"\n          /></svg\n      ></a>\n      <a class=\"btn\" data-variant=\"outline\" href=\"#\" aria-label=\"Continue with Microsoft\"\n        ><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" aria-hidden=\"true\">\n          <path fill=\"#F25022\" d=\"M1 1h10.5v10.5H1z\" />\n          <path fill=\"#7FBA00\" d=\"M12.5 1H23v10.5H12.5z\" />\n          <path fill=\"#00A4EF\" d=\"M1 12.5h10.5V23H1z\" />\n          <path fill=\"#FFB900\" d=\"M12.5 12.5H23V23H12.5z\" /></svg\n      ></a>\n    </div>\n    <p class=\"mk-social-login-divider\">or continue with email</p>\n    <div style=\"display: grid; gap: 0.5rem\"\n      ><label class=\"label\" for=\"sl-email\">Email</label\n      ><input class=\"input\" id=\"sl-email\" type=\"email\" autocomplete=\"username\"\n    /></div>\n  </div>\n  <header class=\"mk-profile-header\">\n    <img class=\"mk-profile-header-cover\" src=\"https://picsum.photos/seed/profile-cover/1400/400\" alt=\"\" />\n    <div class=\"mk-profile-header-body\">\n      <div class=\"mk-profile-header-top\">\n        <span class=\"avatar\" data-size=\"xl\"><img class=\"avatar-image\" src=\"images/mk-portrait2.png\" alt=\"\" /></span>\n        <div class=\"mk-profile-header-actions\">\n          <a class=\"btn\" href=\"#\">Follow</a>\n          <a class=\"btn\" data-variant=\"outline\" href=\"#\">Message</a>\n          <button class=\"btn\" data-variant=\"outline\" data-size=\"icon\" type=\"button\" aria-label=\"More actions\"\n            ><i data-lucide=\"ellipsis\"></i\n          ></button>\n        </div>\n      </div>\n      <div>\n        <h1 class=\"mk-profile-header-name\"\n          >Hannah Lee <span class=\"badge\" data-variant=\"secondary\" data-size=\"sm\">Design Lead</span></h1\n        >\n        <p class=\"mk-profile-header-handle\">@hannahdesigns</p>\n      </div>\n      <p class=\"mk-profile-header-bio\"\n        >Making software quieter at Northwind. Writing about calm design, type and the space between things.</p\n      >\n      <ul class=\"mk-profile-header-meta\">\n        <li><i data-lucide=\"map-pin\"></i>Lisbon, Portugal</li>\n        <li><i data-lucide=\"link\"></i><a href=\"#\">hannahlee.design</a></li>\n        <li><i data-lucide=\"calendar\"></i>Joined <time datetime=\"2021-03\">March 2021</time></li>\n      </ul>\n      <dl class=\"mk-profile-header-stats\"\n        ><div><dt>followers</dt><dd>1.2k</dd></div\n        ><div><dt>following</dt><dd>318</dd></div\n        ><div><dt>posts</dt><dd>94</dd></div></dl\n      >\n    </div>\n  </header>\n  <div class=\"mk-security-settings\">\n    <section class=\"mk-security-settings-section\" aria-labelledby=\"sec-sign\">\n      <h2 id=\"sec-sign\">Signing in</h2>\n      <div class=\"mk-security-settings-row\"\n        ><i data-lucide=\"key-round\"></i\n        ><div\n          ><strong>Password</strong><p>Last changed <time datetime=\"2026-07-02\">3 months ago</time></p></div\n        ><a class=\"btn\" data-variant=\"outline\" data-size=\"sm\" href=\"#\">Change</a></div\n      >\n      <div class=\"mk-security-settings-row\"\n        ><i data-lucide=\"smartphone\"></i\n        ><div\n          ><strong\n            >Two-factor authentication <span class=\"mk-security-settings-status\" data-status=\"on\">On</span></strong\n          ><p>Authenticator app · backup codes saved</p></div\n        ><div class=\"switch-item\"\n          ><input class=\"switch\" type=\"checkbox\" role=\"switch\" id=\"sec-2fa\" checked /><label\n            for=\"sec-2fa\"\n            class=\"sr-only\"\n            >Two-factor authentication</label\n          ></div\n        ></div\n      >\n      <div class=\"mk-security-settings-row\"\n        ><i data-lucide=\"fingerprint\"></i\n        ><div\n          ><strong>Passkeys <span class=\"mk-security-settings-status\" data-status=\"off\">None yet</span></strong\n          ><p>Sign in with your fingerprint or face - no password.</p></div\n        ><a class=\"btn\" data-variant=\"outline\" data-size=\"sm\" href=\"#\">Add a passkey</a></div\n      >\n    </section>\n    <section class=\"mk-security-settings-section\" aria-labelledby=\"sec-sess\">\n      <h2 id=\"sec-sess\">Where you're signed in</h2>\n      <ul class=\"mk-security-settings-list\">\n        <li\n          ><span class=\"mk-security-settings-device\"><i data-lucide=\"laptop\"></i></span\n          ><div\n            ><strong\n              >Chrome on macOS <span class=\"badge\" data-variant=\"secondary\" data-size=\"sm\">This device</span></strong\n            ><span>Lisbon · active now</span></div\n          ></li\n        >\n        <li\n          ><span class=\"mk-security-settings-device\"><i data-lucide=\"smartphone\"></i></span\n          ><div><strong>Safari on iPhone</strong><span>Lisbon · 2 hours ago</span></div\n          ><button class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" type=\"button\" aria-label=\"Sign out Safari on iPhone\"\n            >Sign out</button\n          ></li\n        >\n        <li\n          ><span class=\"mk-security-settings-device\"><i data-lucide=\"monitor\"></i></span\n          ><div><strong>Firefox on Windows</strong><span>Berlin · 3 days ago</span></div\n          ><button\n            class=\"btn\"\n            data-variant=\"ghost\"\n            data-size=\"sm\"\n            type=\"button\"\n            aria-label=\"Sign out Firefox on Windows\"\n            >Sign out</button\n          ></li\n        >\n      </ul>\n      <div class=\"mk-security-settings-foot\"\n        ><button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\"\n          >Sign out of all other sessions</button\n        ></div\n      >\n    </section>\n  </div>\n  <div class=\"mk-notification-settings\">\n    <table>\n      <caption class=\"sr-only\">Notifications by topic and channel</caption>\n      <thead\n        ><tr\n          ><th scope=\"col\">Topic</th><th scope=\"col\">Email</th><th scope=\"col\">Push</th><th scope=\"col\">SMS</th></tr\n        ></thead\n      >\n      <tbody>\n        <tr\n          ><th scope=\"row\">Mentions<small>When someone @mentions you</small></th\n          ><td\n            ><input\n              class=\"checkbox\"\n              type=\"checkbox\"\n              name=\"mentions\"\n              value=\"email\"\n              checked\n              aria-label=\"Mentions by Email\" /></td\n          ><td\n            ><input\n              class=\"checkbox\"\n              type=\"checkbox\"\n              name=\"mentions\"\n              value=\"push\"\n              checked\n              aria-label=\"Mentions by Push\" /></td\n          ><td><input class=\"checkbox\" type=\"checkbox\" name=\"mentions\" value=\"sms\" aria-label=\"Mentions by SMS\" /></td\n        ></tr>\n        <tr\n          ><th scope=\"row\">Comments<small>Replies on your docs and tasks</small></th\n          ><td\n            ><input\n              class=\"checkbox\"\n              type=\"checkbox\"\n              name=\"comments\"\n              value=\"email\"\n              checked\n              aria-label=\"Comments by Email\" /></td\n          ><td><input class=\"checkbox\" type=\"checkbox\" name=\"comments\" value=\"push\" aria-label=\"Comments by Push\" /></td\n          ><td><input class=\"checkbox\" type=\"checkbox\" name=\"comments\" value=\"sms\" aria-label=\"Comments by SMS\" /></td\n        ></tr>\n        <tr\n          ><th scope=\"row\">Assignments<small>Tasks assigned to you</small></th\n          ><td\n            ><input\n              class=\"checkbox\"\n              type=\"checkbox\"\n              name=\"assignments\"\n              value=\"email\"\n              checked\n              aria-label=\"Assignments by Email\" /></td\n          ><td\n            ><input\n              class=\"checkbox\"\n              type=\"checkbox\"\n              name=\"assignments\"\n              value=\"push\"\n              checked\n              aria-label=\"Assignments by Push\" /></td\n          ><td\n            ><input\n              class=\"checkbox\"\n              type=\"checkbox\"\n              name=\"assignments\"\n              value=\"sms\"\n              checked\n              aria-label=\"Assignments by SMS\" /></td\n        ></tr>\n        <tr\n          ><th scope=\"row\">Weekly digest<small>A summary every Monday</small></th\n          ><td\n            ><input\n              class=\"checkbox\"\n              type=\"checkbox\"\n              name=\"weekly-digest\"\n              value=\"email\"\n              checked\n              aria-label=\"Weekly digest by Email\" /></td\n          ><td\n            ><input\n              class=\"checkbox\"\n              type=\"checkbox\"\n              name=\"weekly-digest\"\n              value=\"push\"\n              aria-label=\"Weekly digest by Push\" /></td\n          ><td\n            ><input\n              class=\"checkbox\"\n              type=\"checkbox\"\n              name=\"weekly-digest\"\n              value=\"sms\"\n              aria-label=\"Weekly digest by SMS\" /></td\n        ></tr>\n      </tbody>\n    </table>\n  </div>\n  <nav class=\"mk-form-progress\" data-variant=\"numbered\" aria-label=\"Progress\">\n    <ol class=\"mk-form-progress-steps\">\n      <li data-done\n        ><span class=\"mk-form-progress-dot\" aria-hidden=\"true\"><i data-lucide=\"check\"></i></span>Account</li\n      >\n      <li data-done\n        ><span class=\"mk-form-progress-dot\" aria-hidden=\"true\"><i data-lucide=\"check\"></i></span>Company</li\n      >\n      <li aria-current=\"step\"><span class=\"mk-form-progress-dot\" aria-hidden=\"true\">3</span>Plan</li>\n      <li><span class=\"mk-form-progress-dot\" aria-hidden=\"true\">4</span>Invite</li>\n    </ol>\n  </nav>\n  <form class=\"mk-survey-question\" action=\"#\" method=\"post\">\n    <div class=\"mk-survey-question-meta\"\n      ><span>Question 3 of 8</span\n      ><progress class=\"progress\" value=\"3\" max=\"8\" aria-label=\"Survey progress\">3 of 8</progress></div\n    >\n    <fieldset>\n      <legend>How big is your team?</legend>\n      <label class=\"mk-survey-question-option\"><input type=\"radio\" name=\"team\" value=\"0\" required />Just me</label>\n      <label class=\"mk-survey-question-option\"\n        ><input type=\"radio\" name=\"team\" value=\"1\" checked required />2–10 people</label\n      >\n      <label class=\"mk-survey-question-option\"><input type=\"radio\" name=\"team\" value=\"2\" required />11–50 people</label>\n      <label class=\"mk-survey-question-option\"><input type=\"radio\" name=\"team\" value=\"3\" required />More than 50</label>\n    </fieldset>\n    <div class=\"mk-survey-question-actions\"\n      ><button class=\"btn\" data-variant=\"ghost\" type=\"button\">Back</button\n      ><button class=\"btn\" type=\"submit\">Next</button></div\n    >\n  </form>\n  <div\n    style=\"\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));\n      gap: 2rem;\n      align-items: start;\n    \"\n  >\n    <section class=\"mk-empty-state\" aria-labelledby=\"es-1\">\n      <span class=\"mk-empty-state-icon\" aria-hidden=\"true\"><i data-lucide=\"folder-open\"></i></span>\n      <h2 class=\"mk-empty-state-title\" id=\"es-1\">No projects yet</h2>\n      <p class=\"mk-empty-state-text\"\n        >Projects keep plans, docs and tasks together. Create one, or start from a template.</p\n      >\n      <div class=\"mk-empty-state-actions\"\n        ><a class=\"btn\" href=\"#\"><i data-lucide=\"plus\"></i> New project</a\n        ><a class=\"btn\" data-variant=\"outline\" href=\"#\">Browse templates</a></div\n      >\n    </section>\n    <section class=\"mk-success-state\" role=\"status\" aria-labelledby=\"ss-1\">\n      <span class=\"mk-success-state-icon\" aria-hidden=\"true\"><i data-lucide=\"check\"></i></span>\n      <h2 class=\"mk-success-state-title\" id=\"ss-1\">Invitations sent</h2>\n      <p class=\"mk-success-state-text\">Your three teammates get an email with a link to join. It works for 7 days.</p>\n      <dl class=\"mk-success-state-summary\"\n        ><div><dt>Workspace</dt><dd>Acme Product</dd></div\n        ><div><dt>Invited</dt><dd>3 people</dd></div\n        ><div><dt>Role</dt><dd>Editor</dd></div></dl\n      >\n      <div class=\"mk-success-state-actions\"\n        ><a class=\"btn\" href=\"#\">Go to workspace</a><a class=\"btn\" data-variant=\"outline\" href=\"#\">Invite more</a></div\n      >\n    </section>\n  </div>\n  <section class=\"mk-error-state\" data-variant=\"inline\" role=\"alert\" aria-labelledby=\"er-2\">\n    <span class=\"mk-error-state-icon\" aria-hidden=\"true\"><i data-lucide=\"wifi-off\"></i></span>\n    <h2 class=\"mk-error-state-title\" id=\"er-2\">You're offline</h2>\n    <p class=\"mk-error-state-text\">Changes are saved on this device and sync when you're back.</p>\n    <div class=\"mk-error-state-actions\"\n      ><button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\">Retry now</button></div\n    >\n  </section>\n</div>\n","individual":false}]
