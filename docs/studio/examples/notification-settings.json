[{"label":"Matrix","html":"<div class=\"mk-notification-settings\">\n  <table>\n    <caption class=\"sr-only\">Notifications by topic and channel</caption>\n    <thead\n      ><tr\n        ><th scope=\"col\">Topic</th><th scope=\"col\">Email</th><th scope=\"col\">Push</th><th scope=\"col\">SMS</th></tr\n      ></thead\n    >\n    <tbody>\n      <tr\n        ><th scope=\"row\">Mentions<small>When someone @mentions you</small></th\n        ><td\n          ><input\n            class=\"checkbox\"\n            type=\"checkbox\"\n            name=\"mentions\"\n            value=\"email\"\n            checked\n            aria-label=\"Mentions by Email\" /></td\n        ><td\n          ><input\n            class=\"checkbox\"\n            type=\"checkbox\"\n            name=\"mentions\"\n            value=\"push\"\n            checked\n            aria-label=\"Mentions by Push\" /></td\n        ><td><input class=\"checkbox\" type=\"checkbox\" name=\"mentions\" value=\"sms\" aria-label=\"Mentions by SMS\" /></td\n      ></tr>\n      <tr\n        ><th scope=\"row\">Comments<small>Replies on your docs and tasks</small></th\n        ><td\n          ><input\n            class=\"checkbox\"\n            type=\"checkbox\"\n            name=\"comments\"\n            value=\"email\"\n            checked\n            aria-label=\"Comments by Email\" /></td\n        ><td><input class=\"checkbox\" type=\"checkbox\" name=\"comments\" value=\"push\" aria-label=\"Comments by Push\" /></td\n        ><td><input class=\"checkbox\" type=\"checkbox\" name=\"comments\" value=\"sms\" aria-label=\"Comments by SMS\" /></td\n      ></tr>\n      <tr\n        ><th scope=\"row\">Assignments<small>Tasks assigned to you</small></th\n        ><td\n          ><input\n            class=\"checkbox\"\n            type=\"checkbox\"\n            name=\"assignments\"\n            value=\"email\"\n            checked\n            aria-label=\"Assignments by Email\" /></td\n        ><td\n          ><input\n            class=\"checkbox\"\n            type=\"checkbox\"\n            name=\"assignments\"\n            value=\"push\"\n            checked\n            aria-label=\"Assignments by Push\" /></td\n        ><td\n          ><input\n            class=\"checkbox\"\n            type=\"checkbox\"\n            name=\"assignments\"\n            value=\"sms\"\n            checked\n            aria-label=\"Assignments by SMS\" /></td\n      ></tr>\n      <tr\n        ><th scope=\"row\">Weekly digest<small>A summary every Monday</small></th\n        ><td\n          ><input\n            class=\"checkbox\"\n            type=\"checkbox\"\n            name=\"weekly-digest\"\n            value=\"email\"\n            checked\n            aria-label=\"Weekly digest by Email\" /></td\n        ><td\n          ><input\n            class=\"checkbox\"\n            type=\"checkbox\"\n            name=\"weekly-digest\"\n            value=\"push\"\n            aria-label=\"Weekly digest by Push\" /></td\n        ><td\n          ><input\n            class=\"checkbox\"\n            type=\"checkbox\"\n            name=\"weekly-digest\"\n            value=\"sms\"\n            aria-label=\"Weekly digest by SMS\" /></td\n      ></tr>\n    </tbody>\n  </table>\n</div>\n","individual":true},{"label":"List","html":"<div class=\"mk-notification-settings\" data-variant=\"list\">\n  <ul>\n    <li\n      ><label for=\"ns-0\">Mentions<small>When someone @mentions you</small></label\n      ><input class=\"switch\" type=\"checkbox\" role=\"switch\" id=\"ns-0\" checked\n    /></li>\n    <li\n      ><label for=\"ns-1\">Comments<small>Replies on your docs and tasks</small></label\n      ><input class=\"switch\" type=\"checkbox\" role=\"switch\" id=\"ns-1\"\n    /></li>\n    <li\n      ><label for=\"ns-2\">Assignments<small>Tasks assigned to you</small></label\n      ><input class=\"switch\" type=\"checkbox\" role=\"switch\" id=\"ns-2\" checked\n    /></li>\n  </ul>\n  <div class=\"mk-notification-settings-digest\"\n    ><label for=\"ns-freq\">Send a digest</label\n    ><select class=\"select\" id=\"ns-freq\"\n      ><option>Daily</option\n      ><option selected>Weekly</option\n      ><option>Never</option></select\n    ></div\n  >\n</div>\n","individual":true}]
