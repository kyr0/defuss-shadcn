[{"label":"Waterfall","html":"<figure class=\"chart-frame\" style=\"margin: 0\">\n  <h3 class=\"chart-title\">Revenue bridge, start to end</h3>\n  <p class=\"chart-dek\">Churn and FX erase what Product, Pricing and Operations add - the bridge lands at 135.</p>\n  <div\n    id=\"chg-waterfall\"\n    class=\"chart\"\n    role=\"img\"\n    aria-label=\"Waterfall chart from 120 to 135; gains from Product, Pricing and Operations, losses from Churn and FX\"\n  ></div>\n  <figcaption class=\"chart-source\">Synthetic data · adapted from echarts-feat 06-waterfall</figcaption>\n</figure>\n","individual":false},{"label":"Normalized stack","html":"<figure class=\"chart-frame\" style=\"margin: 0\">\n  <h3 class=\"chart-title\">Traffic mix by channel</h3>\n  <p class=\"chart-dek\">Direct declines while Social and Referral grow - shares, not absolutes.</p>\n  <div\n    class=\"chart\"\n    role=\"img\"\n    aria-label=\"Normalized stacked bars of traffic share by channel from 2022 to 2026; Direct declines from 42 to 27 percent\"\n    data-chart='{\"legend\":{\"left\":0},\"xAxis\":{\"type\":\"category\",\"data\":[\"2022\",\"2023\",\"2024\",\"2025\",\"2026\"]},\"yAxis\":{\"type\":\"value\",\"max\":100,\"axisLabel\":{\"formatter\":\"{value}%\"}},\"series\":[{\"name\":\"Direct\",\"type\":\"bar\",\"stack\":\"total\",\"barWidth\":\"52%\",\"itemStyle\":{\"borderRadius\":0},\"data\":[42,40,35,30,27]},{\"name\":\"Search\",\"type\":\"bar\",\"stack\":\"total\",\"itemStyle\":{\"borderRadius\":0},\"data\":[25,24,25,27,26]},{\"name\":\"Social\",\"type\":\"bar\",\"stack\":\"total\",\"itemStyle\":{\"borderRadius\":0},\"data\":[18,20,22,23,24]},{\"name\":\"Referral\",\"type\":\"bar\",\"stack\":\"total\",\"itemStyle\":{\"borderRadius\":[4,4,0,0]},\"data\":[15,16,18,20,23]}]}'\n  ></div>\n  <figcaption class=\"chart-source\">Synthetic data · adapted from echarts-feat 07-normalized-stack</figcaption>\n</figure>\n","individual":false},{"label":"Bump ranking","html":"<figure class=\"chart-frame\" style=\"margin: 0\">\n  <h3 class=\"chart-title\">League position by quarter</h3>\n  <p class=\"chart-dek\">Alpha and Beta trade the top spot; Epsilon never leaves the bottom two.</p>\n  <div\n    class=\"chart\"\n    role=\"img\"\n    aria-label=\"Bump chart of rank over six quarters; Alpha and Beta trade first place, Epsilon stays last\"\n    data-chart='{\"grid\":{\"top\":16,\"right\":80},\"xAxis\":{\"type\":\"category\",\"data\":[\"Q1\",\"Q2\",\"Q3\",\"Q4\",\"Q5\",\"Q6\"],\"boundaryGap\":false},\"yAxis\":{\"type\":\"value\",\"inverse\":true,\"min\":1,\"max\":5,\"interval\":1,\"splitLine\":{\"show\":false},\"axisLabel\":{\"formatter\":\"#{value}\"}},\"series\":[{\"name\":\"Alpha\",\"type\":\"line\",\"smooth\":0.3,\"symbolSize\":10,\"lineStyle\":{\"width\":4},\"data\":[1,1,2,2,1,1],\"endLabel\":{\"show\":true,\"formatter\":\"{a}\",\"distance\":10,\"fontWeight\":600},\"emphasis\":{\"focus\":\"series\"}},{\"name\":\"Beta\",\"type\":\"line\",\"smooth\":0.3,\"symbolSize\":10,\"lineStyle\":{\"width\":4},\"data\":[2,3,1,1,2,3],\"endLabel\":{\"show\":true,\"formatter\":\"{a}\",\"distance\":10,\"fontWeight\":600},\"emphasis\":{\"focus\":\"series\"}},{\"name\":\"Gamma\",\"type\":\"line\",\"smooth\":0.3,\"symbolSize\":10,\"lineStyle\":{\"width\":4},\"data\":[4,2,3,3,3,2],\"endLabel\":{\"show\":true,\"formatter\":\"{a}\",\"distance\":10,\"fontWeight\":600},\"emphasis\":{\"focus\":\"series\"}},{\"name\":\"Delta\",\"type\":\"line\",\"smooth\":0.3,\"symbolSize\":10,\"lineStyle\":{\"width\":4},\"data\":[3,4,4,5,4,4],\"endLabel\":{\"show\":true,\"formatter\":\"{a}\",\"distance\":10,\"fontWeight\":600},\"emphasis\":{\"focus\":\"series\"}},{\"name\":\"Epsilon\",\"type\":\"line\",\"smooth\":0.3,\"symbolSize\":10,\"lineStyle\":{\"width\":4},\"data\":[5,5,5,4,5,5],\"endLabel\":{\"show\":true,\"formatter\":\"{a}\",\"distance\":10,\"fontWeight\":600},\"emphasis\":{\"focus\":\"series\"}}]}'\n  ></div>\n  <figcaption class=\"chart-source\">Synthetic data · adapted from echarts-feat 08-bump-ranking</figcaption>\n</figure>\n","individual":false},{"label":"Annotated time series","html":"<figure class=\"chart-frame\" style=\"margin: 0\">\n  <h3 class=\"chart-title\">Weekly active users, 18 weeks</h3>\n  <p class=\"chart-dek\">A shaded launch window and one event pin do the editorial work.</p>\n  <div\n    id=\"chg-annotated\"\n    class=\"chart\"\n    data-size=\"lg\"\n    role=\"img\"\n    aria-label=\"Annotated line chart of weekly active users rising from 32 to 78, with a shaded launch window in weeks 6 to 9 and an event pin in week 8\"\n  ></div>\n  <figcaption class=\"chart-source\">Synthetic data · adapted from echarts-feat 11-annotated-timeseries</figcaption>\n</figure>\n","individual":false}]
