[{"label":"Sheet","html":"<dialog\n  id=\"density-sheet-compact\"\n  class=\"sheet\"\n  data-side=\"right\"\n  data-density=\"compact\"\n  role=\"dialog\"\n  aria-modal=\"true\"\n  aria-labelledby=\"ds-c-title\"\n>\n  <div class=\"sheet-content\">\n    <div class=\"sheet-header\">\n      <h2 class=\"sheet-title\" id=\"ds-c-title\">Compact density</h2>\n      <p class=\"sheet-description\">Content padding is 1rem instead of the default 1.5rem.</p>\n    </div>\n  </div>\n  <button class=\"sheet-close-x\" data-sheet-close=\"\" aria-label=\"Close\"\n    ><svg\n      width=\"15\"\n      height=\"15\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n      aria-hidden=\"true\"\n    >\n      <path d=\"M18 6 6 18M6 6l12 12\" /></svg\n  ></button>\n</dialog>\n","individual":true},{"label":"Right","html":"<button class=\"btn\" data-variant=\"outline\" data-sheet-trigger=\"sheet-right\" aria-haspopup=\"dialog\"\n  >Open Right Sheet</button\n>\n<dialog\n  id=\"sheet-right\"\n  class=\"sheet\"\n  data-side=\"right\"\n  role=\"dialog\"\n  aria-modal=\"true\"\n  aria-labelledby=\"sheet-right-title\"\n>\n  <div class=\"sheet-content\">\n    <div class=\"sheet-header\">\n      <h2 class=\"sheet-title\" id=\"sheet-right-title\">Edit Profile</h2>\n      <p class=\"sheet-description\">Make changes to your profile here. Click save when you're done.</p>\n    </div>\n    <div class=\"sheet-body\">\n      <div style=\"display: flex; flex-direction: column; gap: 1rem\">\n        <div>\n          <label class=\"label\" for=\"sheet-name\">Name</label>\n          <input id=\"sheet-name\" class=\"input\" type=\"text\" value=\"Aron Homberg\" />\n        </div>\n        <div>\n          <label class=\"label\" for=\"sheet-username\">Username</label>\n          <input id=\"sheet-username\" class=\"input\" type=\"text\" value=\"@kyr0\" />\n        </div>\n      </div>\n    </div>\n    <div class=\"sheet-footer\">\n      <button class=\"btn\" data-variant=\"outline\" data-sheet-close>Cancel</button>\n      <button class=\"btn\" data-variant=\"default\" data-sheet-close>Save changes</button>\n    </div>\n  </div>\n  <button class=\"sheet-close-x\" data-sheet-close aria-label=\"Close\">\n    <svg\n      width=\"15\"\n      height=\"15\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n      aria-hidden=\"true\"\n    >\n      <path d=\"M18 6 6 18M6 6l12 12\" />\n    </svg>\n  </button>\n</dialog>\n","individual":false},{"label":"Left","html":"<button class=\"btn\" data-variant=\"outline\" data-sheet-trigger=\"sheet-left\" aria-haspopup=\"dialog\"\n  >Open Left Sheet</button\n>\n<dialog\n  id=\"sheet-left\"\n  class=\"sheet\"\n  data-side=\"left\"\n  role=\"dialog\"\n  aria-modal=\"true\"\n  aria-labelledby=\"sheet-left-title\"\n>\n  <div class=\"sheet-content\">\n    <div class=\"sheet-header\">\n      <h2 class=\"sheet-title\" id=\"sheet-left-title\">Navigation</h2>\n      <p class=\"sheet-description\">Browse sections of the application.</p>\n    </div>\n    <div class=\"sheet-body\">\n      <nav style=\"display: flex; flex-direction: column; gap: 0.25rem\">\n        <a\n          href=\"#\"\n          style=\"\n            display: flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 0.5rem 0.75rem;\n            border-radius: var(--radius-lg);\n            font-size: 0.875rem;\n            text-decoration: none;\n            color: var(--foreground);\n            transition: background 150ms;\n          \"\n          onmouseover=\"this.style.background = 'var(--accent)'\"\n          onmouseout=\"this.style.background = ''\"\n          >Home</a\n        >\n        <a\n          href=\"#\"\n          style=\"\n            display: flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 0.5rem 0.75rem;\n            border-radius: var(--radius-lg);\n            font-size: 0.875rem;\n            text-decoration: none;\n            color: var(--foreground);\n            transition: background 150ms;\n          \"\n          onmouseover=\"this.style.background = 'var(--accent)'\"\n          onmouseout=\"this.style.background = ''\"\n          >Dashboard</a\n        >\n        <a\n          href=\"#\"\n          style=\"\n            display: flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 0.5rem 0.75rem;\n            border-radius: var(--radius-lg);\n            font-size: 0.875rem;\n            text-decoration: none;\n            color: var(--foreground);\n            transition: background 150ms;\n          \"\n          onmouseover=\"this.style.background = 'var(--accent)'\"\n          onmouseout=\"this.style.background = ''\"\n          >Settings</a\n        >\n        <a\n          href=\"#\"\n          style=\"\n            display: flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 0.5rem 0.75rem;\n            border-radius: var(--radius-lg);\n            font-size: 0.875rem;\n            text-decoration: none;\n            color: var(--foreground);\n            transition: background 150ms;\n          \"\n          onmouseover=\"this.style.background = 'var(--accent)'\"\n          onmouseout=\"this.style.background = ''\"\n          >Help</a\n        >\n      </nav>\n    </div>\n  </div>\n  <button class=\"sheet-close-x\" data-sheet-close aria-label=\"Close\">\n    <svg\n      width=\"15\"\n      height=\"15\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n      aria-hidden=\"true\"\n    >\n      <path d=\"M18 6 6 18M6 6l12 12\" />\n    </svg>\n  </button>\n</dialog>\n","individual":false},{"label":"Top","html":"<button class=\"btn\" data-variant=\"outline\" data-sheet-trigger=\"sheet-top\" aria-haspopup=\"dialog\">Open Top Sheet</button>\n<dialog id=\"sheet-top\" class=\"sheet\" data-side=\"top\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"sheet-top-title\">\n  <div class=\"sheet-content\">\n    <div class=\"sheet-header\">\n      <h2 class=\"sheet-title\" id=\"sheet-top-title\">Notifications</h2>\n      <p class=\"sheet-description\">You have 3 unread messages.</p>\n    </div>\n    <div class=\"sheet-body\">\n      <div style=\"display: flex; flex-direction: column; gap: 0.75rem\">\n        <div\n          style=\"\n            display: flex;\n            align-items: flex-start;\n            gap: 0.75rem;\n            padding: 0.75rem;\n            border-radius: var(--radius-lg);\n            background: color-mix(in oklch, var(--muted), transparent 50%);\n          \"\n        >\n          <div\n            style=\"\n              width: 0.5rem;\n              height: 0.5rem;\n              border-radius: 9999px;\n              background: var(--primary);\n              margin-top: 0.375rem;\n              flex-shrink: 0;\n            \"\n          />\n          <div>\n            <p class=\"item-title m-0\">New comment on your post</p>\n            <p style=\"font-size: 0.75rem; color: var(--muted-foreground); margin: 0.125rem 0 0\">2 minutes ago</p>\n          </div>\n        </div>\n        <div\n          style=\"\n            display: flex;\n            align-items: flex-start;\n            gap: 0.75rem;\n            padding: 0.75rem;\n            border-radius: var(--radius-lg);\n            background: color-mix(in oklch, var(--muted), transparent 50%);\n          \"\n        >\n          <div\n            style=\"\n              width: 0.5rem;\n              height: 0.5rem;\n              border-radius: 9999px;\n              background: var(--primary);\n              margin-top: 0.375rem;\n              flex-shrink: 0;\n            \"\n          />\n          <div>\n            <p class=\"item-title m-0\">Deployment successful</p>\n            <p style=\"font-size: 0.75rem; color: var(--muted-foreground); margin: 0.125rem 0 0\">15 minutes ago</p>\n          </div>\n        </div>\n        <div\n          style=\"\n            display: flex;\n            align-items: flex-start;\n            gap: 0.75rem;\n            padding: 0.75rem;\n            border-radius: var(--radius-lg);\n            background: color-mix(in oklch, var(--muted), transparent 50%);\n          \"\n        >\n          <div\n            style=\"\n              width: 0.5rem;\n              height: 0.5rem;\n              border-radius: 9999px;\n              background: var(--muted-foreground);\n              margin-top: 0.375rem;\n              flex-shrink: 0;\n            \"\n          />\n          <div>\n            <p class=\"item-title m-0\">Team invitation accepted</p>\n            <p style=\"font-size: 0.75rem; color: var(--muted-foreground); margin: 0.125rem 0 0\">1 hour ago</p>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div class=\"sheet-footer\">\n      <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-sheet-close>Dismiss all</button>\n    </div>\n  </div>\n  <button class=\"sheet-close-x\" data-sheet-close aria-label=\"Close\">\n    <svg\n      width=\"15\"\n      height=\"15\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n      aria-hidden=\"true\"\n    >\n      <path d=\"M18 6 6 18M6 6l12 12\" />\n    </svg>\n  </button>\n</dialog>\n","individual":false},{"label":"Bottom","html":"<button class=\"btn\" data-variant=\"outline\" data-sheet-trigger=\"sheet-bottom\" aria-haspopup=\"dialog\"\n  >Open Bottom Sheet</button\n>\n<dialog\n  id=\"sheet-bottom\"\n  class=\"sheet\"\n  data-side=\"bottom\"\n  role=\"dialog\"\n  aria-modal=\"true\"\n  aria-labelledby=\"sheet-bottom-title\"\n>\n  <div class=\"sheet-content\">\n    <div class=\"sheet-header\">\n      <h2 class=\"sheet-title\" id=\"sheet-bottom-title\">Cookie Preferences</h2>\n      <p class=\"sheet-description\"\n        >Manage your cookie settings. You can enable or disable different types of cookies below.</p\n      >\n    </div>\n    <div class=\"sheet-body\">\n      <div style=\"display: flex; flex-direction: column; gap: 1rem\">\n        <div style=\"display: flex; align-items: center; justify-content: space-between\">\n          <div>\n            <p class=\"item-title m-0\">Essential Cookies</p>\n            <p style=\"font-size: 0.75rem; color: var(--muted-foreground); margin: 0.125rem 0 0\"\n              >Required for the website to function.</p\n            >\n          </div>\n          <span style=\"font-size: 0.75rem; color: var(--muted-foreground)\">Always on</span>\n        </div>\n        <div style=\"display: flex; align-items: center; justify-content: space-between; gap: 1rem\">\n          <div>\n            <p style=\"font-size: 0.875rem; font-weight: 500; margin: 0\" id=\"cookie-analytics-label\"\n              >Analytics Cookies</p\n            >\n            <p style=\"font-size: 0.75rem; color: var(--muted-foreground); margin: 0.125rem 0 0\"\n              >Help us improve our website.</p\n            >\n          </div>\n          <input\n            class=\"checkbox\"\n            type=\"checkbox\"\n            id=\"cookie-analytics\"\n            aria-labelledby=\"cookie-analytics-label\"\n            checked\n          />\n        </div>\n        <div style=\"display: flex; align-items: center; justify-content: space-between; gap: 1rem\">\n          <div>\n            <p style=\"font-size: 0.875rem; font-weight: 500; margin: 0\" id=\"cookie-marketing-label\"\n              >Marketing Cookies</p\n            >\n            <p style=\"font-size: 0.75rem; color: var(--muted-foreground); margin: 0.125rem 0 0\"\n              >Used for targeted advertising.</p\n            >\n          </div>\n          <input class=\"checkbox\" type=\"checkbox\" id=\"cookie-marketing\" aria-labelledby=\"cookie-marketing-label\" />\n        </div>\n      </div>\n    </div>\n    <div class=\"sheet-footer\">\n      <button class=\"btn\" data-variant=\"outline\" data-sheet-close>Cancel</button>\n      <button class=\"btn\" data-variant=\"default\" data-sheet-close>Save preferences</button>\n    </div>\n  </div>\n  <button class=\"sheet-close-x\" data-sheet-close aria-label=\"Close\">\n    <svg\n      width=\"15\"\n      height=\"15\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n      aria-hidden=\"true\"\n    >\n      <path d=\"M18 6 6 18M6 6l12 12\" />\n    </svg>\n  </button>\n</dialog>\n","individual":false},{"label":"Density","html":"<div class=\"flex flex-wrap gap-2\">\n  <button class=\"btn\" data-variant=\"outline\" data-sheet-trigger=\"density-sheet-compact\" aria-haspopup=\"dialog\"\n    >Compact</button\n  >\n  <button class=\"btn\" data-variant=\"outline\" data-sheet-trigger=\"density-sheet-comfortable\" aria-haspopup=\"dialog\"\n    >Comfortable</button\n  >\n  <button class=\"btn\" data-variant=\"outline\" data-sheet-trigger=\"density-sheet-spacious\" aria-haspopup=\"dialog\"\n    >Spacious</button\n  >\n</div>\n<dialog\n  id=\"density-sheet-compact\"\n  class=\"sheet\"\n  data-side=\"right\"\n  data-density=\"compact\"\n  role=\"dialog\"\n  aria-modal=\"true\"\n  aria-labelledby=\"ds-c-title\"\n>\n  <div class=\"sheet-content\">\n    <div class=\"sheet-header\">\n      <h2 class=\"sheet-title\" id=\"ds-c-title\">Compact density</h2>\n      <p class=\"sheet-description\">Content padding is 1rem instead of the default 1.5rem.</p>\n    </div>\n  </div>\n  <button class=\"sheet-close-x\" data-sheet-close aria-label=\"Close\"\n    ><svg\n      width=\"15\"\n      height=\"15\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n      aria-hidden=\"true\"\n    >\n      <path d=\"M18 6 6 18M6 6l12 12\" /></svg\n  ></button>\n</dialog>\n<dialog\n  id=\"density-sheet-comfortable\"\n  class=\"sheet\"\n  data-side=\"right\"\n  data-density=\"comfortable\"\n  role=\"dialog\"\n  aria-modal=\"true\"\n  aria-labelledby=\"ds-cm-title\"\n>\n  <div class=\"sheet-content\">\n    <div class=\"sheet-header\">\n      <h2 class=\"sheet-title\" id=\"ds-cm-title\">Comfortable density</h2>\n      <p class=\"sheet-description\">Identical to the unsized default - 1.5rem content padding.</p>\n    </div>\n  </div>\n  <button class=\"sheet-close-x\" data-sheet-close aria-label=\"Close\"\n    ><svg\n      width=\"15\"\n      height=\"15\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n      aria-hidden=\"true\"\n    >\n      <path d=\"M18 6 6 18M6 6l12 12\" /></svg\n  ></button>\n</dialog>\n<dialog\n  id=\"density-sheet-spacious\"\n  class=\"sheet\"\n  data-side=\"right\"\n  data-density=\"spacious\"\n  role=\"dialog\"\n  aria-modal=\"true\"\n  aria-labelledby=\"ds-s-title\"\n>\n  <div class=\"sheet-content\">\n    <div class=\"sheet-header\">\n      <h2 class=\"sheet-title\" id=\"ds-s-title\">Spacious density</h2>\n      <p class=\"sheet-description\">Content padding grows to 2rem.</p>\n    </div>\n  </div>\n  <button class=\"sheet-close-x\" data-sheet-close aria-label=\"Close\"\n    ><svg\n      width=\"15\"\n      height=\"15\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n      aria-hidden=\"true\"\n    >\n      <path d=\"M18 6 6 18M6 6l12 12\" /></svg\n  ></button>\n</dialog>\n","individual":false}]
