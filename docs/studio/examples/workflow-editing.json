[{"label":"An editor with its toolbar","html":"<div class=\"grid gap-2\">\n  <div class=\"toolbar flex-wrap\" role=\"toolbar\" aria-label=\"Edit\">\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"etl\"\n      data-workflow-action=\"undo\"\n      >Undo</button\n    >\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"etl\"\n      data-workflow-action=\"redo\"\n      >Redo</button\n    >\n    <div class=\"separator\" data-orientation=\"vertical\" role=\"separator\"></div>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"etl\"\n      data-workflow-action=\"select-all\"\n      >Select all</button\n    >\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"etl\"\n      data-workflow-action=\"align-left\"\n      >Align left</button\n    >\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"etl\"\n      data-workflow-action=\"align-top\"\n      >Align top</button\n    >\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"etl\"\n      data-workflow-action=\"group\"\n      data-workflow-title=\"Cleaning\"\n      >Group</button\n    >\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"etl\"\n      data-workflow-action=\"ungroup\"\n      >Ungroup</button\n    >\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"etl\"\n      data-workflow-action=\"duplicate\"\n      >Duplicate</button\n    >\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"etl\"\n      data-workflow-action=\"delete\"\n      >Delete</button\n    >\n    <div class=\"separator\" data-orientation=\"vertical\" role=\"separator\"></div>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"etl\"\n      data-workflow-action=\"arrange\"\n      >Arrange</button\n    >\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"etl\"\n      data-workflow-action=\"fit\"\n      >Fit</button\n    >\n  </div>\n  <div class=\"grid gap-2\" style=\"grid-template-columns: minmax(0, 1fr) 16rem\">\n    <div class=\"workflow\" id=\"etl\" aria-label=\"A data pipeline\" style=\"--workflow-height: 26rem\">\n      \n    </div>\n    <div class=\"card\">\n      <div\n        class=\"card-content\"\n        style=\"max-block-size: 26rem; overflow: auto\"\n        data-workflow-for=\"etl\"\n        data-workflow-outlet=\"inspector\"\n      ></div>\n    </div>\n  </div>\n</div>\n","individual":false},{"label":"A tree beside the editor","html":"<div class=\"grid gap-2\">\n  <div class=\"toolbar flex-wrap\" role=\"toolbar\" aria-label=\"Navigate the release workflow\">\n    <button class=\"toggle\" id=\"release-follow\" type=\"button\" aria-pressed=\"true\" data-size=\"sm\">\n      <svg\n        aria-hidden=\"true\"\n        width=\"16\"\n        height=\"16\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n      >\n        <circle cx=\"12\" cy=\"12\" r=\"10\" />\n        <path d=\"M22 12h-4M6 12H2M12 6V2M12 22v-4\" />\n      </svg>\n      Follow\n    </button>\n    <div class=\"separator\" data-orientation=\"vertical\" role=\"separator\"></div>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"release\"\n      data-workflow-action=\"fit\"\n      >Fit</button\n    >\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"release\"\n      data-workflow-action=\"parent\"\n      >Up</button\n    >\n    <div class=\"flex-1\" data-workflow-for=\"release\" data-workflow-outlet=\"breadcrumb\"></div>\n  </div>\n  <div class=\"grid gap-2\" style=\"grid-template-columns: minmax(11rem, 15rem) minmax(0, 1fr)\">\n    <div class=\"grid gap-2 content-start\">\n      <input class=\"input\" data-tree-filter=\"release-tree\" aria-label=\"Find a node\" placeholder=\"Find a node…\" />\n      <div\n        class=\"data-tree\"\n        id=\"release-tree\"\n        aria-label=\"The release workflow's nodes\"\n        data-label-field=\"title\"\n        data-exclusive\n        data-persist=\"none\"\n        style=\"height: 22rem\"\n      ></div>\n    </div>\n    <div class=\"workflow\" id=\"release\" aria-label=\"Release workflow\" style=\"--workflow-height: 24.75rem\">\n      \n    </div>\n  </div>\n</div>\n","individual":false},{"label":"Every node edits inline","html":"<div class=\"grid gap-2\">\n  <div class=\"workflow\" id=\"grading\" data-layout=\"list\" aria-label=\"Grading\" style=\"--workflow-height: 22rem\">\n    \n    \n  </div>\n  <ol class=\"text-sm text-muted-foreground m-0 ps-5\" id=\"grading-log\" aria-live=\"polite\">\n    <li>Edit a value - each change lands here.</li>\n  </ol>\n</div>\n","individual":false},{"label":"A window and a wizard","html":"<div class=\"grid gap-2\">\n  <div class=\"window-desktop\" style=\"height: 24rem\">\n    <div class=\"workflow\" id=\"jobs\" aria-label=\"Jobs\" style=\"--workflow-height: 24rem\">\n      \n    </div>\n    <dialog\n      class=\"window\"\n      id=\"jobs-code\"\n      data-resizable\n      style=\"--window-x: 2.5rem; --window-y: 1.5rem; --window-w: 26rem\"\n    >\n      <header class=\"window-titlebar\">\n        <h2 class=\"window-title\" id=\"jobs-code-title\">Template</h2>\n        <form method=\"dialog\" class=\"window-controls\">\n          <button class=\"window-close\" aria-label=\"Close\"></button>\n        </form>\n      </header>\n      <div class=\"window-body\" data-flush>\n        <textarea\n          class=\"textarea\"\n          id=\"jobs-code-text\"\n          aria-labelledby=\"jobs-code-title\"\n          rows=\"10\"\n          spellcheck=\"false\"\n          style=\"border: 0; border-radius: 0; font-family: var(--font-mono); font-size: 0.8125rem; resize: none\"\n        ></textarea>\n      </div>\n      <footer class=\"window-statusbar flex justify-end gap-2\">\n        <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"jobs-code-cancel\">Cancel</button>\n        <button class=\"btn\" data-size=\"sm\" type=\"button\" id=\"jobs-code-save\">Save</button>\n      </footer>\n    </dialog>\n  </div>\n  <ol class=\"text-sm text-muted-foreground m-0 ps-5\" id=\"jobs-log\" aria-live=\"polite\">\n    <li>Open an editor - the requests and the changes land here.</li>\n  </ol>\n  <dialog class=\"dialog\" id=\"jobs-wizard\" aria-labelledby=\"jobs-wizard-title\">\n    <form method=\"dialog\" class=\"dialog-content\" id=\"jobs-wizard-form\">\n      <div class=\"dialog-header\">\n        <h2 class=\"dialog-title\" id=\"jobs-wizard-title\">Configure the upscaler</h2>\n        <p class=\"dialog-description\">Three steps; Finish folds the answers into the node's config.</p>\n      </div>\n      <ol class=\"steps\" id=\"jobs-wizard-steps\">\n        <li class=\"step\" data-status=\"current\" aria-current=\"step\">\n          <div class=\"step-indicator\">1</div>\n          <div class=\"step-content\">\n            <p class=\"step-title\">Model</p>\n            <p class=\"step-description\">What upscales</p>\n          </div>\n        </li>\n        <li class=\"step\">\n          <div class=\"step-indicator\">2</div>\n          <div class=\"step-content\">\n            <p class=\"step-title\">Clean-up</p>\n            <p class=\"step-description\">Noise and faces</p>\n          </div>\n        </li>\n        <li class=\"step\">\n          <div class=\"step-indicator\">3</div>\n          <div class=\"step-content\">\n            <p class=\"step-title\">Output</p>\n            <p class=\"step-description\">The file</p>\n          </div>\n        </li>\n      </ol>\n      <div class=\"dialog-body\">\n        <fieldset class=\"grid gap-3 m-0 p-0\" style=\"border: 0\" data-step=\"0\">\n          <legend class=\"label mb-2\">Model</legend>\n          <div class=\"radio-group\" role=\"radiogroup\" aria-label=\"Model\">\n            <label class=\"flex items-center gap-2\"\n              ><input class=\"radio\" type=\"radio\" name=\"model\" value=\"real-esrgan-x4\" /> Real-ESRGAN x4</label\n            >\n            <label class=\"flex items-center gap-2\"\n              ><input class=\"radio\" type=\"radio\" name=\"model\" value=\"swinir\" /> SwinIR</label\n            >\n            <label class=\"flex items-center gap-2\"\n              ><input class=\"radio\" type=\"radio\" name=\"model\" value=\"lanczos\" /> Lanczos (no model)</label\n            >\n          </div>\n          <label class=\"label\" for=\"jobs-scale\">Scale</label>\n          <select class=\"select\" id=\"jobs-scale\" name=\"scale\">\n            <option value=\"2\">2×</option>\n            <option value=\"4\">4×</option>\n            <option value=\"8\">8×</option>\n          </select>\n        </fieldset>\n        <fieldset class=\"grid gap-3 m-0 p-0\" style=\"border: 0\" data-step=\"1\" hidden>\n          <label class=\"label\" for=\"jobs-denoise\">Denoise</label>\n          <input class=\"slider\" type=\"range\" id=\"jobs-denoise\" name=\"denoise\" min=\"0\" max=\"100\" step=\"5\" />\n          <label class=\"flex items-center gap-2\"\n            ><input class=\"switch\" type=\"checkbox\" role=\"switch\" name=\"faces\" /> Restore faces</label\n          >\n        </fieldset>\n        <fieldset class=\"grid gap-3 m-0 p-0\" style=\"border: 0\" data-step=\"2\" hidden>\n          <label class=\"label\" for=\"jobs-format\">Format</label>\n          <select class=\"select\" id=\"jobs-format\" name=\"format\">\n            <option>webp</option>\n            <option>png</option>\n            <option>avif</option>\n          </select>\n          <label class=\"label\" for=\"jobs-quality\">Quality</label>\n          <input class=\"input\" type=\"number\" id=\"jobs-quality\" name=\"quality\" min=\"1\" max=\"100\" />\n        </fieldset>\n      </div>\n      <div class=\"dialog-footer\">\n        <button class=\"btn\" data-variant=\"ghost\" value=\"cancel\" formnovalidate>Cancel</button>\n        <button class=\"btn\" data-variant=\"outline\" type=\"button\" id=\"jobs-back\">Back</button>\n        <button class=\"btn\" type=\"button\" id=\"jobs-next\">Next</button>\n        <button class=\"btn\" value=\"finish\" id=\"jobs-finish\" style=\"display: none\">Finish</button>\n      </div>\n    </form>\n  </dialog>\n</div>\n","individual":false},{"label":"A subworkflow","html":"<div class=\"grid gap-2\">\n  <div class=\"flex flex-wrap items-center gap-2\">\n    <div class=\"flex-1\" data-workflow-for=\"nested\" data-workflow-outlet=\"breadcrumb\"></div>\n    <button\n      class=\"btn\"\n      data-variant=\"outline\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"nested\"\n      data-workflow-action=\"enter\"\n      >Open</button\n    >\n    <button\n      class=\"btn\"\n      data-variant=\"outline\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"nested\"\n      data-workflow-action=\"parent\"\n      >Up</button\n    >\n  </div>\n  <div class=\"workflow\" id=\"nested\" data-selected=\"norm\" aria-label=\"Release notes\" style=\"--workflow-height: 20rem\">\n    \n  </div>\n</div>\n","individual":false}]
