[{"label":"Start Button","html":"<button class=\"start-button\" type=\"button\" popovertarget=\"sb-menu\" aria-haspopup=\"menu\">\n  <i data-lucide=\"layout-grid\" class=\"start-button-icon\"></i>\n  <span class=\"start-button-label\">Start</span>\n</button>\n","individual":true},{"label":"Start Button (icon)","html":"<button class=\"start-button\" data-variant=\"icon\" type=\"button\" popovertarget=\"sb-menu\" aria-haspopup=\"menu\">\n  <i data-lucide=\"layout-grid\" class=\"start-button-icon\"></i>\n  <span class=\"start-button-label\">Start</span>\n</button>\n","individual":true},{"label":"In a taskbar, in every look","html":"<div class=\"grid gap-2\">\n  <label class=\"flex items-center gap-2 text-sm\"\n    >Look\n    <select class=\"select\" data-look style=\"width: auto\">\n      <option value=\"\">Modern</option>\n      <option value=\"win7\">7</option>\n      <option value=\"winxp\">XP</option>\n      <option value=\"win98\">98</option>\n      <option value=\"win95\">95</option>\n    </select></label\n  >\n  <div class=\"desktop\" id=\"sb-desk\" data-state-demo style=\"height: 16rem\">\n    <div class=\"window-desktop window-manager\" id=\"sb-wm\"></div>\n    <nav class=\"taskbar\" data-taskbar-for=\"sb-wm\" aria-label=\"Taskbar\">\n      <button class=\"start-button\" type=\"button\" popovertarget=\"sb-menu\" aria-haspopup=\"menu\">\n        <span class=\"start-button-icon desktop-glyph\" data-glyph=\"flag\"></span>\n        <span class=\"start-button-label\">Start</span>\n      </button>\n      <div class=\"taskbar-windows\" role=\"group\" aria-label=\"Open windows\"></div>\n    </nav>\n    <div class=\"start-menu\" id=\"sb-menu\" popover aria-label=\"Start\">\n      <div class=\"start-menu-list\" role=\"group\" aria-label=\"Apps\">\n        <button class=\"start-menu-item\" type=\"button\" data-value=\"notes\">\n          <span class=\"start-menu-icon\"><span class=\"desktop-glyph\" data-glyph=\"text\"></span></span>\n          <span class=\"start-menu-label\">Notepad</span>\n        </button>\n        <button class=\"start-menu-item\" type=\"button\" data-value=\"settings\">\n          <span class=\"start-menu-icon\"><span class=\"desktop-glyph\" data-glyph=\"settings\"></span></span>\n          <span class=\"start-menu-label\">Settings</span>\n        </button>\n      </div>\n    </div>\n  </div>\n</div>\n","individual":false},{"label":"Icon only","html":"<div class=\"desktop\" style=\"height: 14rem\">\n  <div class=\"window-desktop window-manager\" id=\"sbi-wm\"></div>\n  <nav class=\"taskbar\" data-taskbar-for=\"sbi-wm\" data-align=\"center\" aria-label=\"Taskbar\">\n    <button class=\"start-button\" data-variant=\"icon\" type=\"button\" popovertarget=\"sbi-menu\" aria-haspopup=\"menu\">\n      <span class=\"start-button-icon desktop-glyph\" data-glyph=\"flag\"></span>\n      <span class=\"start-button-label\">Start</span>\n    </button>\n    <div class=\"taskbar-windows\" role=\"group\" aria-label=\"Open windows\"></div>\n  </nav>\n  <div class=\"start-menu\" id=\"sbi-menu\" popover aria-label=\"Start\">\n    <div class=\"start-menu-list\" role=\"group\" aria-label=\"Apps\">\n      <button class=\"start-menu-item\" type=\"button\" data-value=\"notes\">\n        <span class=\"start-menu-icon\"><span class=\"desktop-glyph\" data-glyph=\"text\"></span></span>\n        <span class=\"start-menu-label\">Notepad</span>\n      </button>\n      <button class=\"start-menu-item\" type=\"button\" data-value=\"settings\">\n        <span class=\"start-menu-icon\"><span class=\"desktop-glyph\" data-glyph=\"settings\"></span></span>\n        <span class=\"start-menu-label\">Settings</span>\n      </button>\n    </div>\n  </div>\n</div>\n","individual":false}]
