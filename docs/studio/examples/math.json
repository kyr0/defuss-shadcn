[{"label":"One formula: edited, rendered, computed","html":"<div style=\"display: grid; gap: 1rem\">\n  <div class=\"math-editor\" id=\"ov-editor\" data-math-preview=\"ov-formula\">\n    <label class=\"label\" for=\"ov-source\">Expression</label>\n    <textarea class=\"math-editor-source\" id=\"ov-source\">\\frac{x^2-1}{x-1}</textarea>\n    <div class=\"math-editor-tools\" role=\"group\" aria-label=\"Formula tools\">\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-math-command=\"fraction\"\n        >Fraction</button\n      >\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-math-command=\"power\">Power</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-math-command=\"root\">Root</button>\n    </div>\n  </div>\n  <figure class=\"math-renderer\" id=\"ov-formula\" data-variant=\"card\" aria-label=\"The expression, typeset\">\n    <code class=\"math-renderer-source\">\\frac{x^2-1}{x-1}</code>\n    <figcaption>Rendered as you type</figcaption>\n  </figure>\n  <section class=\"math-compute\" id=\"ov-compute\" aria-label=\"Simplify the expression\">\n    <label class=\"label\" for=\"ov-compute-source\">Input</label>\n    <textarea class=\"math-compute-source\" id=\"ov-compute-source\">\\frac{x^2-1}{x-1}</textarea>\n    <div class=\"math-compute-tools\">\n      <select class=\"select\" data-math-operation aria-label=\"Operation\">\n        <option value=\"simplify\" selected>Simplify</option>\n        <option value=\"differentiate\">Differentiate</option>\n        <option value=\"solve\">Solve for x</option>\n      </select>\n      <button class=\"btn\" type=\"button\" data-math-run>Compute</button>\n    </div>\n  </section>\n</div>\n","individual":false}]
