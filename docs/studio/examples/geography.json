[{"label":"An atlas","html":"<div class=\"grid gap-3\">\n  <div class=\"flex flex-wrap items-center gap-2\">\n    <input\n      class=\"input max-w-64\"\n      type=\"search\"\n      data-geo-for=\"atlas\"\n      data-geo-action=\"search\"\n      placeholder=\"Search: Europe, Germany, Bavaria\"\n      aria-label=\"Search a region\"\n    />\n    <button\n      class=\"btn\"\n      data-variant=\"outline\"\n      type=\"button\"\n      data-geo-for=\"atlas\"\n      data-geo-action=\"focus\"\n      data-value=\"continent:Europe\"\n      >Europe</button\n    >\n    <button\n      class=\"btn\"\n      data-variant=\"outline\"\n      type=\"button\"\n      data-geo-for=\"atlas\"\n      data-geo-action=\"focus\"\n      data-value=\"country:DEU\"\n      >Germany</button\n    >\n    <button class=\"btn\" data-variant=\"ghost\" type=\"button\" data-geo-for=\"atlas\" data-geo-action=\"up\">Up</button>\n    <button class=\"btn\" data-variant=\"ghost\" type=\"button\" data-geo-for=\"atlas\" data-geo-action=\"reset\">World</button>\n    <div class=\"switch-item flex items-center gap-2\">\n      <input\n        class=\"switch\"\n        type=\"checkbox\"\n        role=\"switch\"\n        id=\"atlas-callouts\"\n        data-geo-for=\"atlas\"\n        data-geo-param=\"callouts\"\n      />\n      <label for=\"atlas-callouts\">Callouts</label>\n    </div>\n  </div>\n  <div class=\"geo-map\" id=\"atlas\" aria-label=\"An atlas\" data-highlight=\"lift\"></div>\n  <p class=\"text-sm text-muted-foreground m-0\">\n    Showing <output data-geo-for=\"atlas\" data-geo-output=\"focus\"></output> - picked:\n    <output data-geo-for=\"atlas\" data-geo-output=\"selection\"></output>\n  </p>\n</div>\n","individual":false}]
