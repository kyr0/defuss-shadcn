[{"label":"Default","html":"<div class=\"mk-security-settings\">\n  <section class=\"mk-security-settings-section\" aria-labelledby=\"sec-sign\">\n    <h2 id=\"sec-sign\">Signing in</h2>\n    <div class=\"mk-security-settings-row\"\n      ><i data-lucide=\"key-round\"></i\n      ><div\n        ><strong>Password</strong><p>Last changed <time datetime=\"2026-07-02\">3 months ago</time></p></div\n      ><a class=\"btn\" data-variant=\"outline\" data-size=\"sm\" href=\"#\">Change</a></div\n    >\n    <div class=\"mk-security-settings-row\"\n      ><i data-lucide=\"smartphone\"></i\n      ><div\n        ><strong>Two-factor authentication <span class=\"mk-security-settings-status\" data-status=\"on\">On</span></strong\n        ><p>Authenticator app · backup codes saved</p></div\n      ><div class=\"switch-item\"\n        ><input class=\"switch\" type=\"checkbox\" role=\"switch\" id=\"sec-2fa\" checked /><label for=\"sec-2fa\" class=\"sr-only\"\n          >Two-factor authentication</label\n        ></div\n      ></div\n    >\n    <div class=\"mk-security-settings-row\"\n      ><i data-lucide=\"fingerprint\"></i\n      ><div\n        ><strong>Passkeys <span class=\"mk-security-settings-status\" data-status=\"off\">None yet</span></strong\n        ><p>Sign in with your fingerprint or face - no password.</p></div\n      ><a class=\"btn\" data-variant=\"outline\" data-size=\"sm\" href=\"#\">Add a passkey</a></div\n    >\n  </section>\n  <section class=\"mk-security-settings-section\" aria-labelledby=\"sec-sess\">\n    <h2 id=\"sec-sess\">Where you're signed in</h2>\n    <ul class=\"mk-security-settings-list\">\n      <li\n        ><span class=\"mk-security-settings-device\"><i data-lucide=\"laptop\"></i></span\n        ><div\n          ><strong\n            >Chrome on macOS <span class=\"badge\" data-variant=\"secondary\" data-size=\"sm\">This device</span></strong\n          ><span>Lisbon · active now</span></div\n        ></li\n      >\n      <li\n        ><span class=\"mk-security-settings-device\"><i data-lucide=\"smartphone\"></i></span\n        ><div><strong>Safari on iPhone</strong><span>Lisbon · 2 hours ago</span></div\n        ><button class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" type=\"button\" aria-label=\"Sign out Safari on iPhone\"\n          >Sign out</button\n        ></li\n      >\n      <li\n        ><span class=\"mk-security-settings-device\"><i data-lucide=\"monitor\"></i></span\n        ><div><strong>Firefox on Windows</strong><span>Berlin · 3 days ago</span></div\n        ><button class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" type=\"button\" aria-label=\"Sign out Firefox on Windows\"\n          >Sign out</button\n        ></li\n      >\n    </ul>\n    <div class=\"mk-security-settings-foot\"\n      ><button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\"\n        >Sign out of all other sessions</button\n      ></div\n    >\n  </section>\n</div>\n","individual":true}]
