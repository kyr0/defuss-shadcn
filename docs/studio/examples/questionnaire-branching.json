[{"label":"Support triage","html":"<div class=\"flex flex-wrap gap-6\">\n  <form class=\"questionnaire\" id=\"q-triage\" aria-label=\"Support triage\" data-persist=\"none\" style=\"flex: 1 1 20rem\">\n    <div class=\"questionnaire-progress\"></div>\n    <fieldset class=\"questionnaire-step\" data-step=\"topic\">\n      <legend class=\"questionnaire-title\">What do you need help with?</legend>\n      <div class=\"questionnaire-choices\">\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"topic\" value=\"billing\" required data-goto=\"invoice\" /><span\n            class=\"questionnaire-choice-label\"\n            >Billing</span\n          ></label\n        >\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"topic\" value=\"bug\" data-goto=\"where\" /><span class=\"questionnaire-choice-label\"\n            >Something is broken</span\n          ></label\n        >\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"topic\" value=\"account\" data-goto=\"account\" /><span\n            class=\"questionnaire-choice-label\"\n            >My account</span\n          ></label\n        >\n      </div>\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"invoice\" data-next=\"contact\">\n      <legend class=\"questionnaire-title\">Which invoice?</legend>\n      <input\n        class=\"input\"\n        name=\"invoice\"\n        required\n        pattern=\"INV-[0-9]{4}\"\n        placeholder=\"INV-1234\"\n        aria-label=\"Invoice number\"\n      />\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"where\">\n      <legend class=\"questionnaire-title\">Where does it break?</legend>\n      <select class=\"select\" name=\"where\" required aria-label=\"Where\">\n        <option value=\"\">Choose…</option>\n        <option value=\"login\" data-goto=\"contact\">Signing in</option>\n        <option value=\"export\">Exporting</option>\n      </select>\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"format\" data-next=\"contact\">\n      <legend class=\"questionnaire-title\">Which export format?</legend>\n      <div class=\"questionnaire-choices\">\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"format\" value=\"csv\" required /><span class=\"questionnaire-choice-label\"\n            >CSV</span\n          ></label\n        >\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"format\" value=\"pdf\" /><span class=\"questionnaire-choice-label\">PDF</span></label\n        >\n      </div>\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"account\" data-next=\"contact\">\n      <legend class=\"questionnaire-title\">What about your account?</legend>\n      <div class=\"questionnaire-choices\">\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"account\" value=\"email\" required /><span class=\"questionnaire-choice-label\"\n            >Change my email</span\n          ></label\n        >\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"account\" value=\"delete\" /><span class=\"questionnaire-choice-label\"\n            >Delete it</span\n          ></label\n        >\n      </div>\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"contact\">\n      <legend class=\"questionnaire-title\">How do we reach you?</legend>\n      <input class=\"input\" name=\"email\" type=\"email\" required aria-label=\"Email\" autocomplete=\"email\" />\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"review\" data-end>\n      <legend class=\"questionnaire-title\">Open the ticket?</legend>\n      <div class=\"questionnaire-summary\"></div>\n    </fieldset>\n    <div class=\"questionnaire-actions\">\n      <button class=\"btn\" data-variant=\"ghost\" type=\"button\" data-questionnaire=\"back\">Back</button>\n      <button class=\"btn\" type=\"submit\" data-questionnaire=\"next\">Continue</button>\n      <button class=\"btn\" type=\"submit\" data-questionnaire=\"submit\">Open ticket</button>\n    </div>\n    <div class=\"questionnaire-complete\"><p>Ticket opened.</p></div>\n  </form>\n  <nav class=\"questionnaire-trail\" data-for=\"q-triage\" aria-label=\"Steps taken\" style=\"flex: 0 1 14rem\"></nav>\n</div>\n","individual":false},{"label":"Car insurance quote","html":"<div class=\"flex flex-col gap-3\" style=\"max-width: 34rem\">\n  <form class=\"questionnaire\" id=\"q-quote\" aria-label=\"Insurance quote\" data-persist=\"none\">\n    <div class=\"questionnaire-progress\"></div>\n    <fieldset class=\"questionnaire-step\" data-step=\"driver\">\n      <legend class=\"questionnaire-title\">About the driver</legend>\n      <div class=\"questionnaire-field\"\n        ><label class=\"label\" for=\"q-age\">Age</label\n        ><input class=\"input\" id=\"q-age\" name=\"age\" type=\"number\" min=\"17\" max=\"99\" required\n      /></div>\n      <div class=\"questionnaire-field\"\n        ><label class=\"label\" for=\"q-claims\">Claims in the last 5 years</label\n        ><input class=\"input\" id=\"q-claims\" name=\"claims\" type=\"number\" min=\"0\" max=\"20\" required\n      /></div>\n      <div class=\"questionnaire-field\"\n        ><label class=\"label\" for=\"q-income\">Yearly income (EUR)</label\n        ><input class=\"input\" id=\"q-income\" name=\"income\" type=\"number\" min=\"0\" required\n      /></div>\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"car\">\n      <legend class=\"questionnaire-title\">About the car</legend>\n      <div class=\"questionnaire-field\"\n        ><label class=\"label\" for=\"q-value\">Value (EUR)</label\n        ><input class=\"input\" id=\"q-value\" name=\"value\" type=\"number\" min=\"500\" required\n      /></div>\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"risk\" data-next=\"cover\">\n      <legend class=\"questionnaire-title\">A few more questions</legend>\n      <div class=\"questionnaire-choices\">\n        <label class=\"questionnaire-choice\"\n          ><input type=\"checkbox\" name=\"risk\" value=\"night\" /><span class=\"questionnaire-choice-label\"\n            >I mostly drive at night</span\n          ></label\n        >\n        <label class=\"questionnaire-choice\"\n          ><input type=\"checkbox\" name=\"risk\" value=\"course\" /><span class=\"questionnaire-choice-label\"\n            >I took an advanced driving course</span\n          ></label\n        >\n      </div>\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"finance\" data-next=\"cover\">\n      <legend class=\"questionnaire-title\">Is the car financed?</legend>\n      <div class=\"questionnaire-choices\">\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"finance\" value=\"loan\" required /><span class=\"questionnaire-choice-label\"\n            >A loan</span\n          ></label\n        >\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"finance\" value=\"lease\" /><span class=\"questionnaire-choice-label\"\n            >A lease</span\n          ></label\n        >\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"finance\" value=\"no\" /><span class=\"questionnaire-choice-label\">No</span></label\n        >\n      </div>\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"cover\">\n      <legend class=\"questionnaire-title\">Which cover?</legend>\n      <div class=\"questionnaire-choices\">\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"cover\" value=\"basic\" required /><span class=\"questionnaire-choice-label\"\n            >Third party</span\n          ></label\n        >\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"cover\" value=\"full\" /><span class=\"questionnaire-choice-label\"\n            >Fully comprehensive</span\n          ></label\n        >\n      </div>\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"quote\" data-end>\n      <legend class=\"questionnaire-title\">Your quote is ready</legend>\n      <div class=\"questionnaire-summary\"></div>\n    </fieldset>\n    <div class=\"questionnaire-actions\">\n      <button class=\"btn\" data-variant=\"ghost\" type=\"button\" data-questionnaire=\"back\">Back</button>\n      <button class=\"btn\" type=\"submit\" data-questionnaire=\"next\">Continue</button>\n      <button class=\"btn\" type=\"submit\" data-questionnaire=\"submit\">Get the quote</button>\n    </div>\n    <div class=\"questionnaire-complete\"><p>Quote sent to your inbox.</p></div>\n    \n  </form>\n  <p class=\"text-sm text-muted-foreground m-0\" id=\"q-quote-next\" aria-live=\"polite\"></p>\n</div>\n","individual":false}]
