[{"label":"Border layout","html":"<div class=\"border-layout\" style=\"height: 22rem\">\n  <div class=\"resizer border-layout-north\"\n    ><header class=\"border-layout-pane\" style=\"height: 3.25rem\" aria-label=\"North\"\n      ><span class=\"text-sm font-medium\">North</span\n      ><span class=\"text-xs text-muted-foreground block\">drag the line below</span></header\n    ></div\n  >\n  <div class=\"resizer border-layout-west\"\n    ><nav class=\"border-layout-pane\" style=\"width: 11rem\" aria-label=\"West\"\n      ><span class=\"text-sm font-medium\">West</span\n      ><span class=\"text-xs text-muted-foreground block\">drag the line →</span></nav\n    ></div\n  >\n  <main class=\"border-layout-center border-layout-pane\"\n    ><span class=\"text-sm font-medium\">Center</span\n    ><span class=\"text-xs text-muted-foreground block\">takes what the sides leave</span></main\n  >\n  <div class=\"resizer border-layout-east\"\n    ><aside class=\"border-layout-pane\" style=\"width: 10rem\" aria-label=\"East\"\n      ><span class=\"text-sm font-medium\">East</span\n      ><span class=\"text-xs text-muted-foreground block\">← drag the line</span></aside\n    ></div\n  >\n  <div class=\"resizer border-layout-south\"\n    ><footer class=\"border-layout-pane\" style=\"height: 4.5rem\" aria-label=\"South\"\n      ><span class=\"text-sm font-medium\">South</span\n      ><span class=\"text-xs text-muted-foreground block\">drag the line above</span></footer\n    ></div\n  >\n</div>\n","individual":true},{"label":"West and east dominate","html":"<div class=\"border-layout\" data-dominant=\"we\" style=\"height: 22rem\">\n  <div class=\"resizer border-layout-north\"\n    ><header class=\"border-layout-pane\" style=\"height: 3.25rem\" aria-label=\"North\"\n      ><span class=\"text-sm font-medium\">North</span\n      ><span class=\"text-xs text-muted-foreground block\">drag the line below</span></header\n    ></div\n  >\n  <div class=\"resizer border-layout-west\"\n    ><nav class=\"border-layout-pane\" style=\"width: 11rem\" aria-label=\"West\"\n      ><span class=\"text-sm font-medium\">West</span\n      ><span class=\"text-xs text-muted-foreground block\">drag the line →</span></nav\n    ></div\n  >\n  <main class=\"border-layout-center border-layout-pane\"\n    ><span class=\"text-sm font-medium\">Center</span\n    ><span class=\"text-xs text-muted-foreground block\">takes what the sides leave</span></main\n  >\n  <div class=\"resizer border-layout-east\"\n    ><aside class=\"border-layout-pane\" style=\"width: 10rem\" aria-label=\"East\"\n      ><span class=\"text-sm font-medium\">East</span\n      ><span class=\"text-xs text-muted-foreground block\">← drag the line</span></aside\n    ></div\n  >\n  <div class=\"resizer border-layout-south\"\n    ><footer class=\"border-layout-pane\" style=\"height: 4.5rem\" aria-label=\"South\"\n      ><span class=\"text-sm font-medium\">South</span\n      ><span class=\"text-xs text-muted-foreground block\">drag the line above</span></footer\n    ></div\n  >\n</div>\n","individual":true},{"label":"Horizontal split","html":"<div class=\"border-layout\" style=\"height: 12rem\">\n  <div class=\"resizer border-layout-west\"\n    ><div class=\"border-layout-pane\" style=\"width: 50%\" aria-label=\"One\"\n      ><span class=\"text-sm font-medium\">One</span></div\n    ></div\n  >\n  <main class=\"border-layout-center border-layout-pane\"><span class=\"text-sm font-medium\">Two</span></main>\n</div>\n","individual":true},{"label":"Vertical split","html":"<div class=\"border-layout\" style=\"height: 16rem\">\n  <div class=\"resizer border-layout-north\"\n    ><div class=\"border-layout-pane\" style=\"height: 50%\" aria-label=\"One\"\n      ><span class=\"text-sm font-medium\">One</span></div\n    ></div\n  >\n  <main class=\"border-layout-center border-layout-pane\"><span class=\"text-sm font-medium\">Two</span></main>\n</div>\n","individual":true},{"label":"Three columns","html":"<div class=\"border-layout\" style=\"height: 14rem\">\n  <div class=\"resizer border-layout-west\"\n    ><nav class=\"border-layout-pane\" style=\"width: 9rem\" aria-label=\"Folders\"\n      ><span class=\"text-sm font-medium\">Folders</span></nav\n    ></div\n  >\n  <main class=\"border-layout-center border-layout-pane\"><span class=\"text-sm font-medium\">Messages</span></main>\n  <div class=\"resizer border-layout-east\"\n    ><aside class=\"border-layout-pane\" style=\"width: 40%\" aria-label=\"Reading pane\"\n      ><span class=\"text-sm font-medium\">Reading pane</span></aside\n    ></div\n  >\n</div>\n","individual":true},{"label":"Nested splits","html":"<div class=\"border-layout\" style=\"height: 18rem\">\n  <div class=\"resizer border-layout-west\"\n    ><nav class=\"border-layout-pane\" style=\"width: 12rem\" aria-label=\"Sidebar\"\n      ><span class=\"text-sm font-medium\">Sidebar</span></nav\n    ></div\n  >\n  <div class=\"border-layout-center\">\n    <div class=\"border-layout\" data-frame=\"none\" style=\"height: 100%\">\n      <div class=\"resizer border-layout-north\"\n        ><div class=\"border-layout-pane\" style=\"height: 55%\" aria-label=\"Editor\"\n          ><span class=\"text-sm font-medium\">Editor</span></div\n        ></div\n      >\n      <div class=\"border-layout-center border-layout-pane\"><span class=\"text-sm font-medium\">Terminal</span></div>\n    </div>\n  </div>\n</div>\n","individual":true},{"label":"Regions that fit their content","html":"<div class=\"border-layout\" style=\"height: 20rem\">\n  <header class=\"border-layout-north border-layout-pane\" data-fit style=\"--border-layout-fit-min: 20cqh\">\n    <span class=\"text-sm font-medium\">Toolbar - at least a fifth of the frame</span>\n  </header>\n  <main class=\"border-layout-center border-layout-pane\"><span class=\"text-sm font-medium\">Editor</span></main>\n  <footer class=\"border-layout-south border-layout-pane\" data-fit>\n    <div class=\"flex items-center justify-between gap-2 mb-2\">\n      <span class=\"text-sm font-medium\">Steps</span>\n      <button class=\"btn\" data-size=\"sm\" data-variant=\"outline\" type=\"button\" id=\"fit-add\">Add a step</button>\n    </div>\n    <ol class=\"text-sm m-0\" id=\"fit-steps\">\n      <li>Build</li>\n      <li>Test</li>\n    </ol>\n  </footer>\n</div>\n","individual":true},{"label":"Custom handle","html":"<style>\n  .rail-layout {\n    --border-layout-divider-color: color-mix(in oklch, var(--primary) 35%, transparent);\n    --border-layout-divider-width: 3px;\n    --border-layout-accent: var(--primary);\n  }\n  .rail-layout > .resizer > .resizer-handle::after {\n    content: '';\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    translate: -50% -50%;\n    width: 1rem;\n    height: 1rem;\n    border-radius: 999px;\n    background: var(--primary);\n    box-shadow:\n      0 0 0 3px var(--background),\n      var(--shadow-sm);\n  }\n</style>\n<div class=\"border-layout rail-layout\" style=\"height: 12rem\">\n  <div class=\"resizer border-layout-west\"\n    ><div class=\"border-layout-pane\" style=\"width: 40%\" aria-label=\"Custom\"\n      ><span class=\"text-sm font-medium\">Custom</span></div\n    ></div\n  >\n  <main class=\"border-layout-center border-layout-pane\"><span class=\"text-sm font-medium\">Center</span></main>\n  <div class=\"resizer border-layout-south\"\n    ><div class=\"border-layout-pane\" style=\"height: 3.5rem\" aria-label=\"South\"\n      ><span class=\"text-sm font-medium\">South</span></div\n    ></div\n  >\n</div>\n","individual":true},{"label":"Grips","html":"<div class=\"flex flex-col gap-4\">\n  <div class=\"border-layout\" data-grip=\"dots\" style=\"height: 9rem\">\n    <div class=\"resizer border-layout-west\"\n      ><div class=\"border-layout-pane\" style=\"width: 40%\" aria-label=\"dots\"\n        ><span class=\"text-sm font-medium\">dots</span></div\n      ></div\n    >\n    <main class=\"border-layout-center border-layout-pane\"><span class=\"text-sm font-medium\">Center</span></main>\n  </div>\n  <div class=\"border-layout\" data-grip=\"bar\" style=\"height: 9rem\">\n    <div class=\"resizer border-layout-west\"\n      ><div class=\"border-layout-pane\" style=\"width: 40%\" aria-label=\"bar\"\n        ><span class=\"text-sm font-medium\">bar</span></div\n      ></div\n    >\n    <main class=\"border-layout-center border-layout-pane\"><span class=\"text-sm font-medium\">Center</span></main>\n    <div class=\"resizer border-layout-east\" data-grip=\"none\"\n      ><div class=\"border-layout-pane\" style=\"width: 25%\" aria-label=\"no grip\"\n        ><span class=\"text-sm font-medium\">no grip</span></div\n      ></div\n    >\n  </div>\n</div>\n","individual":false},{"label":"Divider styles","html":"<div class=\"grid gap-3\" style=\"grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr))\">\n  <div class=\"border-layout\" data-divider=\"dashed\" style=\"height: 8rem\">\n    <div class=\"resizer border-layout-west\"\n      ><div class=\"border-layout-pane\" style=\"width: 45%\" aria-label=\"dashed\"\n        ><span class=\"text-sm font-medium\">dashed</span></div\n      ></div\n    >\n    <main class=\"border-layout-center border-layout-pane\"><span class=\"text-sm font-medium\">Center</span></main>\n  </div>\n  <div class=\"border-layout\" data-divider=\"dotted\" style=\"height: 8rem\">\n    <div class=\"resizer border-layout-west\"\n      ><div class=\"border-layout-pane\" style=\"width: 45%\" aria-label=\"dotted\"\n        ><span class=\"text-sm font-medium\">dotted</span></div\n      ></div\n    >\n    <main class=\"border-layout-center border-layout-pane\"><span class=\"text-sm font-medium\">Center</span></main>\n  </div>\n  <div class=\"border-layout\" data-divider=\"double\" style=\"height: 8rem\">\n    <div class=\"resizer border-layout-west\"\n      ><div class=\"border-layout-pane\" style=\"width: 45%\" aria-label=\"double\"\n        ><span class=\"text-sm font-medium\">double</span></div\n      ></div\n    >\n    <main class=\"border-layout-center border-layout-pane\"><span class=\"text-sm font-medium\">Center</span></main>\n  </div>\n  <div class=\"border-layout\" data-divider=\"thick\" style=\"height: 8rem\">\n    <div class=\"resizer border-layout-west\"\n      ><div class=\"border-layout-pane\" style=\"width: 45%\" aria-label=\"thick\"\n        ><span class=\"text-sm font-medium\">thick</span></div\n      ></div\n    >\n    <main class=\"border-layout-center border-layout-pane\"><span class=\"text-sm font-medium\">Center</span></main>\n  </div>\n  <div class=\"border-layout\" data-divider=\"none\" data-grip=\"bar\" style=\"height: 8rem\">\n    <div class=\"resizer border-layout-west\"\n      ><div class=\"border-layout-pane\" style=\"width: 45%\" aria-label=\"none\"\n        ><span class=\"text-sm font-medium\">none</span></div\n      ></div\n    >\n    <main class=\"border-layout-center border-layout-pane\"><span class=\"text-sm font-medium\">Center</span></main>\n  </div>\n  <div class=\"border-layout\" data-divider=\"gap\" data-grip=\"bar\" style=\"height: 8rem\">\n    <div class=\"resizer border-layout-west\"\n      ><div class=\"border-layout-pane\" style=\"width: 45%\" aria-label=\"gap\"\n        ><span class=\"text-sm font-medium\">gap</span></div\n      ></div\n    >\n    <main class=\"border-layout-center border-layout-pane\"><span class=\"text-sm font-medium\">Center</span></main>\n  </div>\n</div>\n","individual":false},{"label":"Collapsible and remembered","html":"<div class=\"flex flex-col gap-2\">\n  <div class=\"flex flex-wrap items-center gap-2\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" data-toggle=\"west\">Toggle west</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" data-toggle=\"south\">Toggle south</button>\n    <button class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" type=\"button\" id=\"bl-reset\">Reset</button>\n    <output class=\"text-sm text-muted-foreground\" id=\"bl-sizes\"></output>\n  </div>\n  <div\n    class=\"border-layout\"\n    id=\"bl-saved\"\n    data-collapsible\n    data-save=\"docs-demo\"\n    data-grip=\"dots\"\n    style=\"height: 16rem\"\n  >\n    <div class=\"resizer border-layout-west\"\n      ><nav class=\"border-layout-pane\" style=\"width: 12rem\" aria-label=\"Files\"\n        ><span class=\"text-sm font-medium\">Files</span\n        ><span class=\"text-xs text-muted-foreground block\">double-click the divider</span></nav\n      ></div\n    >\n    <main class=\"border-layout-center border-layout-pane\"><span class=\"text-sm font-medium\">Editor</span></main>\n    <div class=\"resizer border-layout-south\"\n      ><footer class=\"border-layout-pane\" style=\"height: 5rem\" aria-label=\"Terminal\"\n        ><span class=\"text-sm font-medium\">Terminal</span\n        ><span class=\"text-xs text-muted-foreground block\">Enter on the divider folds it</span></footer\n      ></div\n    >\n  </div>\n</div>\n","individual":false},{"label":"An application window","html":"<div class=\"window-desktop\" style=\"height: 30rem\">\n  <dialog\n    class=\"window\"\n    open\n    data-resizable\n    style=\"--window-x: 0.75rem; --window-y: 0.75rem; --window-w: calc(100% - 1.5rem); --window-h: calc(100% - 1.5rem)\"\n  >\n    <header class=\"window-titlebar\">\n      <i data-lucide=\"app-window\" class=\"window-icon\"></i>\n      <h2 class=\"window-title\">Studio - border-layout.css</h2>\n      <form method=\"dialog\" class=\"window-controls\">\n        <button type=\"button\" class=\"window-minimize\" aria-label=\"Minimize\"></button>\n        <button type=\"button\" class=\"window-maximize\" aria-label=\"Maximize\"></button>\n        <button class=\"window-close\" aria-label=\"Close\"></button>\n      </form>\n    </header>\n    <div class=\"window-body\" data-flush>\n      <div class=\"border-layout\" id=\"ide\" data-dominant=\"we\" data-frame=\"none\" data-collapsible style=\"height: 100%\">\n        <div class=\"resizer border-layout-west\"\n          ><nav class=\"border-layout-pane\" style=\"width: 11rem\" aria-label=\"Files\">\n            <p class=\"text-xs text-muted-foreground m-0 mb-2\">EXPLORER</p>\n            <ul class=\"text-sm m-0 ps-4 flex flex-col gap-1\"\n              ><li>components/</li\n              ><li>border-layout.css</li\n              ><li>border-layout.ts</li\n              ><li>resizer.ts</li></ul\n            >\n          </nav></div\n        >\n        <div\n          class=\"border-layout-north\"\n          style=\"height: 2.5rem; display: flex; align-items: center; padding-inline: 0.25rem\"\n        >\n          <div class=\"menubar\" data-variant=\"ghost\" role=\"menubar\" aria-label=\"Studio\" id=\"ide-menu\">\n            <button class=\"menubar-trigger\" data-dropdown-trigger=\"ide-view\">View</button>\n            <div id=\"ide-view\" role=\"menu\" popover class=\"dropdown-content\" aria-label=\"View\" style=\"min-width: 12rem\">\n              <button role=\"menuitem\" class=\"dropdown-item\" tabindex=\"-1\" data-value=\"west\">Toggle files</button>\n              <button role=\"menuitem\" class=\"dropdown-item\" tabindex=\"-1\" data-value=\"east\">Toggle outline</button>\n              <button role=\"menuitem\" class=\"dropdown-item\" tabindex=\"-1\" data-value=\"south\">Toggle terminal</button>\n              <div class=\"dropdown-separator\" role=\"separator\"></div>\n              <button role=\"menuitem\" class=\"dropdown-item\" tabindex=\"-1\" data-value=\"reset\">Reset layout</button>\n            </div>\n          </div>\n        </div>\n        <main\n          class=\"border-layout-center\"\n          style=\"\n            background: #24292e;\n            color: #e1e4e8;\n            font: 13px/1.6 var(--font-mono);\n            padding: 0.75rem 1rem;\n            white-space: pre;\n          \"\n          >.border-layout { display: grid; grid-template-areas: \"west north east\" \"west center east\" \"west south east\";\n          }</main\n        >\n        <div class=\"resizer border-layout-east\"\n          ><aside class=\"border-layout-pane\" style=\"width: 9rem\" aria-label=\"Outline\">\n            <p class=\"text-xs text-muted-foreground m-0 mb-2\">OUTLINE</p>\n            <ul class=\"text-sm m-0 ps-4\"\n              ><li>.border-layout</li\n              ><li>regions</li\n              ><li>dividers</li></ul\n            >\n          </aside></div\n        >\n        <div class=\"resizer border-layout-south\"\n          ><div style=\"height: 6rem\" aria-label=\"Terminal\">\n            <div class=\"mockup-code\" data-chrome=\"none\" data-size=\"sm\" style=\"height: 100%; border-radius: 0\">\n              <pre data-prefix=\"$\"><code>bun run e2e</code></pre>\n              <pre data-prefix=\">\" data-tone=\"success\"><code>border-layout.e2e: all checks passed</code></pre>\n            </div>\n          </div></div\n        >\n      </div>\n    </div>\n  </dialog>\n</div>\n","individual":false}]
