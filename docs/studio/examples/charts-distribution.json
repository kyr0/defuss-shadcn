[{"label":"Confidence band","html":"<figure class=\"chart-frame\" style=\"margin: 0\">\n  <h3 class=\"chart-title\">Estimate with 95% confidence band</h3>\n  <p class=\"chart-dek\"\n    >The band widens where the forecast is less certain; the dashed marker separates observed from forecast months.</p\n  >\n  <div\n    class=\"chart\"\n    role=\"img\"\n    aria-label=\"Line chart of a monthly estimate rising from 42 to 72, with a confidence band that widens toward December and a dashed forecast marker at July\"\n    data-chart='{\"grid\":{\"top\":32},\"tooltip\":{\"trigger\":\"axis\"},\"xAxis\":{\"type\":\"category\",\"boundaryGap\":false,\"data\":[\"Jan\",\"Feb\",\"Mar\",\"Apr\",\"May\",\"Jun\",\"Jul\",\"Aug\",\"Sep\",\"Oct\",\"Nov\",\"Dec\"]},\"yAxis\":{\"type\":\"value\",\"min\":35,\"max\":90},\"series\":[{\"type\":\"line\",\"stack\":\"band\",\"data\":[40,42,46,48,51,53,55,57,58,59,60,60],\"symbol\":\"none\",\"lineStyle\":{\"opacity\":0},\"silent\":true,\"tooltip\":{\"show\":false}},{\"type\":\"line\",\"stack\":\"band\",\"data\":[4,6,6,7,8,10,12,14,16,18,20,24],\"symbol\":\"none\",\"lineStyle\":{\"opacity\":0},\"areaStyle\":{\"color\":\"color-mix(in oklch, var(--chart-2) 18%, transparent)\"},\"silent\":true,\"tooltip\":{\"show\":false}},{\"name\":\"Estimate\",\"type\":\"line\",\"data\":[42,45,49,51,55,58,61,64,66,68,70,72],\"smooth\":0.35,\"showSymbol\":false,\"lineStyle\":{\"width\":3,\"color\":\"var(--chart-2)\"},\"itemStyle\":{\"color\":\"var(--chart-2)\"},\"markLine\":{\"symbol\":\"none\",\"silent\":true,\"label\":{\"formatter\":\"forecast →\",\"position\":\"end\",\"color\":\"var(--muted-foreground)\"},\"lineStyle\":{\"type\":\"dashed\",\"color\":\"var(--muted-foreground)\"},\"data\":[{\"xAxis\":\"Jul\"}]}}]}'\n  ></div>\n  <figcaption class=\"chart-source\">Synthetic data · adapted from echarts-feat 10-confidence-band</figcaption>\n</figure>\n","individual":false},{"label":"Quadrant scatter","html":"<figure class=\"chart-frame\" style=\"margin: 0\">\n  <h3 class=\"chart-title\">Portfolio position</h3>\n  <p class=\"chart-dek\"\n    >Ten business units by growth and performance; bubble area is revenue, the leader is highlighted.</p\n  >\n  <div\n    id=\"quadrant-chart\"\n    class=\"chart\"\n    data-size=\"lg\"\n    role=\"img\"\n    aria-label=\"Bubble scatter of ten business units by growth and performance, split into quadrants at 50, with unit J highlighted\"\n  ></div>\n  <figcaption class=\"chart-source\">Synthetic data · adapted from echarts-feat 13-scatter-quadrants</figcaption>\n</figure>\n","individual":false},{"label":"Jittered strip","html":"<figure class=\"chart-frame\" style=\"margin: 0\">\n  <h3 class=\"chart-title\">Score distribution by group</h3>\n  <p class=\"chart-dek\"\n    >168 individual scores across four groups; group C is highlighted, the rest fall back to the muted ink.</p\n  >\n  <div\n    id=\"strip-chart\"\n    class=\"chart\"\n    data-size=\"lg\"\n    role=\"img\"\n    aria-label=\"Jittered strip plot of 168 scores across four groups, group C highlighted\"\n  ></div>\n  <figcaption class=\"chart-source\">Synthetic data · adapted from echarts-feat 14-jittered-distribution</figcaption>\n</figure>\n","individual":false},{"label":"Heatmap matrix","html":"<figure class=\"chart-frame\" style=\"margin: 0\">\n  <h3 class=\"chart-title\">Criteria correlation matrix</h3>\n  <p class=\"chart-dek\"\n    >Six survey criteria compared pairwise; the diagonal is the self-correlation, labels keep the exact values\n    readable.</p\n  >\n  <div\n    id=\"matrix-chart\"\n    class=\"chart\"\n    data-size=\"lg\"\n    role=\"img\"\n    aria-label=\"Heatmap matrix of pairwise correlations between six criteria, from minus one to plus one\"\n  ></div>\n  <figcaption class=\"chart-source\">Synthetic data · adapted from echarts-feat 15-heatmap-matrix</figcaption>\n</figure>\n","individual":false},{"label":"Calendar heatmap","html":"<figure class=\"chart-frame\" style=\"margin: 0\">\n  <h3 class=\"chart-title\">Daily activity, 2026</h3>\n  <p class=\"chart-dek\"\n    >Compact daily volume that preserves weekly and seasonal rhythm - incidents, commits, sign-ups.</p\n  >\n  <div\n    id=\"calendar-chart\"\n    class=\"chart\"\n    data-size=\"sm\"\n    role=\"img\"\n    aria-label=\"Calendar heatmap of daily activity for the year 2026, values from 0 to about 58\"\n  ></div>\n  <figcaption class=\"chart-source\">Synthetic data · adapted from echarts-feat 16-calendar-heatmap</figcaption>\n</figure>\n","individual":false},{"label":"Boxplot","html":"<figure class=\"chart-frame\" style=\"margin: 0\">\n  <h3 class=\"chart-title\">Response time by service</h3>\n  <p class=\"chart-dek\"\n    >Five services compared on their full latency distribution (ms); the dots are outlier requests.</p\n  >\n  <div\n    class=\"chart\"\n    role=\"img\"\n    aria-label=\"Boxplot of response time for five services A to E, with four outlier points\"\n    data-chart='{\"grid\":{\"top\":16},\"xAxis\":{\"type\":\"category\",\"data\":[\"Auth\",\"Search\",\"Catalog\",\"Checkout\",\"Media\"],\"axisLabel\":{\"color\":\"var(--foreground)\",\"fontWeight\":500}},\"yAxis\":{\"type\":\"value\",\"min\":0,\"max\":80},\"series\":[{\"name\":\"Latency\",\"type\":\"boxplot\",\"boxWidth\":[\"30%\",\"46%\"],\"data\":[[18,27,34,45,58],[22,33,41,52,64],[15,24,31,39,49],[30,39,47,56,71],[12,19,28,36,54]],\"itemStyle\":{\"color\":\"color-mix(in oklch, var(--chart-2) 16%, transparent)\",\"borderColor\":\"var(--chart-2)\",\"borderWidth\":2}},{\"name\":\"Outliers\",\"type\":\"scatter\",\"data\":[[0,66],[1,72],[3,76],[4,61]],\"symbolSize\":9,\"itemStyle\":{\"color\":\"var(--destructive)\"}}]}'\n  ></div>\n  <figcaption class=\"chart-source\">Synthetic data · adapted from echarts-feat 29-boxplot</figcaption>\n</figure>\n","individual":false},{"label":"Violin (custom series)","html":"<figure class=\"chart-frame\" style=\"margin: 0\">\n  <h3 class=\"chart-title\">Density shape by group</h3>\n  <p class=\"chart-dek\"\n    >Full distribution silhouettes for four groups - where a boxplot compresses, a violin shows the modes. Group B is\n    highlighted.</p\n  >\n  <div\n    id=\"violin-chart\"\n    class=\"chart\"\n    role=\"img\"\n    aria-label=\"Violin plot of four distributions A to D, each drawn as a custom density polygon\"\n  ></div>\n  <figcaption class=\"chart-source\">Synthetic data · adapted from echarts-feat 30-violin-custom</figcaption>\n</figure>\n","individual":false}]
