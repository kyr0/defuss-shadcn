[{"label":"Tray","html":"<div class=\"tray\" id=\"tray-demo\" data-seconds=\"\" data-date=\"\" lang=\"de\" role=\"group\" aria-label=\"Notification area\">\n  <button class=\"tray-item\" type=\"button\" aria-label=\"Network\" popovertarget=\"tray-net\"\n    ><i data-lucide=\"wifi\"></i\n  ></button>\n  <button class=\"tray-item\" type=\"button\" aria-label=\"Notifications, 3 new\" data-badge=\"3\"\n    ><i data-lucide=\"bell\"></i\n  ></button>\n  <time class=\"tray-clock\"></time>\n  <button class=\"tray-show-desktop\" type=\"button\" aria-label=\"Show desktop\"></button>\n</div>\n","individual":true},{"label":"Items, badge and clock","html":"<div class=\"grid gap-3\">\n  <label class=\"flex items-center gap-2 text-sm\"\n    >Look\n    <select class=\"select\" data-look style=\"width: auto\">\n      <option value=\"\">Modern</option>\n      <option value=\"win7\">7</option>\n      <option value=\"winxp\">XP</option>\n      <option value=\"win98\">98</option>\n      <option value=\"win95\">95</option>\n    </select></label\n  >\n  <div class=\"desktop\" style=\"height: 9rem\">\n    <div class=\"window-desktop window-manager\" id=\"tray-wm\"></div>\n    <nav class=\"taskbar\" data-taskbar-for=\"tray-wm\" aria-label=\"Taskbar\">\n      <div\n        class=\"tray\"\n        id=\"tray-demo\"\n        data-state-demo\n        data-seconds\n        data-date\n        lang=\"de\"\n        role=\"group\"\n        aria-label=\"Notification area\"\n      >\n        <button class=\"tray-item\" type=\"button\" aria-label=\"Network\" popovertarget=\"tray-net\"\n          ><i data-lucide=\"wifi\"></i\n        ></button>\n        <button class=\"tray-item\" type=\"button\" aria-label=\"Notifications, 3 new\" data-badge=\"3\"\n          ><i data-lucide=\"bell\"></i\n        ></button>\n        <time class=\"tray-clock\"></time>\n        <button class=\"tray-show-desktop\" type=\"button\" aria-label=\"Show desktop\"></button>\n      </div>\n    </nav>\n  </div>\n  <div class=\"popover\" id=\"tray-net\" popover>\n    <p class=\"m-0 text-sm\"><strong>Home Wi-Fi</strong> - connected</p>\n  </div>\n  <div class=\"flex gap-2\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"tray-add\">Add mail</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"tray-remove\">Remove mail</button>\n  </div>\n</div>\n","individual":false}]
