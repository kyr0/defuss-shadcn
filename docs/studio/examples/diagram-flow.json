v class=\"diagram-node\" data-node=\"approve\" data-shape=\"diamond\" style=\"--col: 3; --row: 2\"\n      ><span class=\"diagram-node-name\">Approve?</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"done\" data-shape=\"pill\" style=\"--col: 4; --row: 2\"\n      ><span class=\"diagram-node-name\">Closed</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"deny\" style=\"--col: 3; --row: 3\"\n      ><span class=\"diagram-node-name\">Decline + explain</span></div\n    >\n  </div>\n  <ol class=\"diagram-edges\">\n    <li class=\"diagram-edge\" data-from=\"req\" data-to=\"paid\"></li>\n    <li class=\"diagram-edge\" data-from=\"paid\" data-to=\"amount\">yes</li>\n    <li class=\"diagram-edge\" data-from=\"amount\" data-to=\"auto\" data-tone=\"accent\">yes</li>\n    <li class=\"diagram-edge\" data-from=\"paid\" data-to=\"review\">no</li>\n    <li class=\"diagram-edge\" data-from=\"amount\" data-to=\"review\">no</li>\n    <li class=\"diagram-edge\" data-from=\"review\" data-to=\"approve\"></li>\n    <li class=\"diagram-edge\" data-from=\"approve\" data-to=\"done\">yes</li>\n    <li class=\"diagram-edge\" data-from=\"auto\" data-to=\"done\"></li>\n    <li class=\"diagram-edge\" data-from=\"approve\" data-to=\"deny\">no</li>\n  </ol>\n</figure>\n","individual":true},{"label":"Fraud check added","html":"<figure class=\"diagram\" id=\"dg-flow-delta\" data-type=\"flow\" data-delta aria-label=\"Refund flow, revised\">\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Process change</span>\n    <span class=\"diagram-title\">Fraud check before the money moves</span>\n  </figcaption>\n  <div class=\"diagram-canvas\" style=\"--cols: 3\">\n    <div class=\"diagram-node\" data-node=\"req\" data-shape=\"pill\" style=\"--col: 1; --row: 1\"\n      ><span class=\"diagram-node-name\">Refund request</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"paid\" data-shape=\"diamond\" data-change=\"changed\" style=\"--col: 2; --row: 1\">\n      <span class=\"diagram-node-name\" data-before=\"Paid within 14 days?\">Paid within 30 days?</span>\n    </div>\n    <div\n      class=\"diagram-node\"\n      data-node=\"fraud\"\n      data-shape=\"diamond\"\n      data-tone=\"accent\"\n      data-change=\"added\"\n      style=\"--col: 3; --row: 1\"\n      ><span class=\"diagram-node-name\">Fraud score < 0.4?</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"auto\" style=\"--col: 3; --row: 2\"\n      ><span class=\"diagram-node-name\">Refund automatically</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"review\" style=\"--col: 2; --row: 2\"\n      ><span class=\"diagram-node-name\">Manual review</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"call\" data-change=\"removed\" style=\"--col: 1; --row: 2\"\n      ><span class=\"diagram-node-name\">Call the customer</span></div\n    >\n  </div>\n  <ol class=\"diagram-edges\">\n    <li class=\"diagram-edge\" data-from=\"req\" data-to=\"paid\"></li>\n    <li class=\"diagram-edge\" data-from=\"paid\" data-to=\"fraud\" data-change=\"added\">yes</li>\n    <li class=\"diagram-edge\" data-from=\"fraud\" data-to=\"auto\" data-change=\"added\">yes</li>\n    <li class=\"diagram-edge\" data-from=\"fraud\" data-to=\"review\" data-change=\"added\">no</li>\n    <li class=\"diagram-edge\" data-from=\"paid\" data-to=\"auto\" data-change=\"removed\">yes</li>\n    <li class=\"diagram-edge\" data-from=\"paid\" data-to=\"review\">no</li>\n    <li class=\"diagram-edge\" data-from=\"review\" data-to=\"call\" data-change=\"removed\">unclear</li>\n  </ol>\n</figure>\n","individual":true},{"label":"Flow, interactive","html":"<div class=\"flex flex-wrap items-center gap-2 mb-3\">\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-diagram-for=\"dg-flow-live\" data-diagram-action=\"prev\"\n    >Previous</button\n  >\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-diagram-for=\"dg-flow-live\" dat