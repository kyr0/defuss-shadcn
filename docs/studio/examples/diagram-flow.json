[{"label":"Refund decision","html":"<figure class=\"diagram\" id=\"dg-flow\" data-type=\"flow\" aria-label=\"Refund decision flow\">\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Flowchart</span>\n    <span class=\"diagram-title\">Should this refund go through?</span>\n  </figcaption>\n  <div class=\"diagram-canvas\" style=\"--cols: 4\">\n    <div class=\"diagram-node\" data-node=\"req\" data-shape=\"pill\" style=\"--col: 1; --row: 1\"\n      ><span class=\"diagram-node-name\">Refund request</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"paid\" data-shape=\"diamond\" style=\"--col: 2; --row: 1\"\n      ><span class=\"diagram-node-name\">Paid within 30 days?</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"amount\" data-shape=\"diamond\" style=\"--col: 3; --row: 1\"\n      ><span class=\"diagram-node-name\">Under €200?</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"auto\" data-tone=\"accent\" style=\"--col: 4; --row: 1\"\n      ><span class=\"diagram-node-name\">Refund automatically</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"review\" style=\"--col: 2; --row: 2\">\n      <span class=\"diagram-node-name\">Manual review</span>\n      <span class=\"diagram-node-meta\">support queue</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"approve\" data-shape=\"diamond\" style=\"--col: 3; --row: 2\"\n      ><span class=\"diagram-node-name\">Approve?</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"done\" data-shape=\"pill\" style=\"--col: 4; --row: 2\"\n      ><span class=\"diagram-node-name\">Closed</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"deny\" style=\"--col: 3; --row: 3\"\n      ><span class=\"diagram-node-name\">Decline + explain</span></div\n    >\n  </div>\n  <ol class=\"diagram-edges\">\n    <li class=\"diagram-edge\" data-from=\"req\" data-to=\"paid\"></li>\n    <li class=\"diagram-edge\" data-from=\"paid\" data-to=\"