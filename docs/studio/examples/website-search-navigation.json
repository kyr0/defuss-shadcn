[{"label":"A search results page","html":"<style>\n  @import url('https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&family=Newsreader:opsz,wght@6..72,400;6..72,600&display=swap');\n  /* The help centre's search on a 76rem page: a site bar, a tinted band with the trail, the title, one large search\n     box (a soft glow runs round it while it has focus) and the content types as tabs; then the filters beside the\n     results - a quiet list, the matches highlighted, pages and topics below. Schibsted Grotesk throughout, the\n     snippets in Newsreader so they read like the pages they come from. Looks: Catalogue (paper and indigo, follows\n     light / dark), Night owl (ink and violet) and Highlighter (white, the matches marked in yellow). */\n  #site-search {\n    --background: oklch(0.99 0.003 270);\n    --foreground: oklch(0.21 0.02 270);\n    --card: oklch(1 0 0);\n    --card-foreground: var(--foreground);\n    --muted: oklch(0.965 0.008 270);\n    --muted-foreground: oklch(0.48 0.02 270);\n    --border: oklch(0.21 0.02 270 / 0.11);\n    --input: oklch(0.21 0.02 270 / 0.22);\n    --primary: oklch(0.48 0.19 275);\n    --primary-foreground: oklch(0.99 0.003 270);\n    --secondary: oklch(0.955 0.018 275);\n    --secondary-foreground: oklch(0.38 0.15 275);\n    --accent: oklch(0.955 0.018 275);\n    --accent-foreground: oklch(0.38 0.15 275);\n    --ring: var(--primary);\n    --radius: 0.625rem;\n    --radius-sm: max(0px, calc(var(--radius) - 4px));\n    --radius-md: max(0px, calc(var(--radius) - 2px));\n    --radius-lg: var(--radius);\n    --radius-xl: calc(var(--radius) + 4px);\n    --sr-band: oklch(0.965 0.012 275);\n    --sr-mark: oklch(0.93 0.05 275);\n    --sr-mark-ink: oklch(0.32 0.15 275);\n    color-scheme: light;\n    container-type: inline-size;\n    box-sizing: border-box;\n    display: flex;\n    flex-direction: column;\n    width: 100%;\n    background: var(--background);\n    color: var(--foreground);\n    font:\n      400 1rem/1.55 'Schibsted Grotesk',\n      var(--font-sans);\n  }\n  .dark #site-search[data-look='catalogue'] {\n    color-scheme: dark;\n    --background: oklch(0.18 0.016 275);\n    --foreground: oklch(0.94 0.008 270);\n    --card: oklch(0.215 0.018 275);\n    --muted: oklch(0.24 0.018 275);\n    --muted-foreground: oklch(0.74 0.018 270);\n    --border: oklch(0.94 0.008 270 / 0.11);\n    --input: oklch(0.94 0.008 270 / 0.22);\n    --primary: oklch(0.72 0.14 275);\n    --primary-foreground: oklch(0.18 0.016 275);\n    --secondary: oklch(0.28 0.05 275);\n    --secondary-foreground: oklch(0.88 0.06 275);\n    --accent: oklch(0.28 0.05 275);\n    --accent-foreground: oklch(0.88 0.06 275);\n    --sr-band: oklch(0.21 0.02 275);\n    --sr-mark: oklch(0.34 0.08 275);\n    --sr-mark-ink: oklch(0.92 0.05 275);\n  }\n  #site-search[data-look='owl'] {\n    color-scheme: dark;\n    --background: oklch(0.16 0.025 290);\n    --foreground: oklch(0.94 0.012 290);\n    --card: oklch(0.2 0.03 290);\n    --muted: oklch(0.23 0.03 290);\n    --muted-foreground: oklch(0.75 0.025 290);\n    --border: oklch(0.94 0.012 290 / 0.12);\n    --input: oklch(0.94 0.012 290 / 0.22);\n    --primary: oklch(0.78 0.13 300);\n    --primary-foreground: oklch(0.16 0.025 290);\n    --secondary: oklch(0.28 0.06 300);\n    --secondary-foreground: oklch(0.9 0.07 300);\n    --accent: oklch(0.28 0.06 300);\n    --accent-foreground: oklch(0.9 0.07 300);\n    --sr-band: oklch(0.19 0.03 290);\n    --sr-mark: oklch(0.82 0.11 185 / 0.22);\n    --sr-mark-ink: oklch(0.88 0.1 185);\n  }\n  #site-search[data-look='marker'] {\n    color-scheme: light;\n    --background: oklch(1 0 0);\n    --foreground: oklch(0.16 0 0);\n    --card: oklch(1 0 0);\n    --muted: oklch(0.965 0 0);\n    --muted-foreground: oklch(0.42 0 0);\n    --border: oklch(0.16 0 0 / 0.12);\n    --input: oklch(0.16 0 0 / 0.26);\n    --primary: oklch(0.16 0 0);\n    --primary-foreground: oklch(1 0 0);\n    --secondary: oklch(0.965 0 0);\n    --secondary-foreground: oklch(0.16 0 0);\n    --accent: oklch(0.965 0 0);\n    --accent-foreground: oklch(0.16 0 0);\n    --ring: oklch(0.16 0 0);\n    --sr-band: oklch(0.975 0.03 100);\n    --sr-mark: oklch(0.93 0.17 105);\n    --sr-mark-ink: oklch(0.16 0 0);\n  }\n  #site-search > :not(template) {\n    box-sizing: border-box;\n    width: 100%;\n    padding-inline: max(clamp(1rem, 4vw, 2.5rem), calc((100% - 76rem) / 2));\n  }\n  /* the site bar */\n  #site-search .sr-bar {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 0.75rem 1.5rem;\n    min-height: 4.5rem;\n    padding-block: 0.75rem;\n    border-block-end: 1px solid var(--border);\n  }\n  #site-search .sr-brand {\n    margin-inline-end: auto;\n    color: var(--foreground);\n    text-decoration: none;\n    font-size: 1.125rem;\n    font-weight: 800;\n    letter-spacing: -0.02em;\n  }\n  #site-search .sr-brand span {\n    color: var(--primary);\n  }\n  #site-search .sr-bar-controls {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.5rem;\n  }\n  #site-search .sr-bar .select {\n    min-width: 8rem;\n  }\n  /* the band: trail, title, search box, tabs */\n  #site-search .sr-hero {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr);\n    gap: 1.75rem;\n    padding-block: clamp(2.5rem, 6vw, 4rem) 0;\n    background: var(--sr-band);\n    border-block-end: 1px solid var(--border);\n  }\n  #site-search .mk-breadcrumbs {\n    max-width: none;\n    margin: 0;\n    padding: 0;\n  }\n  #site-search .mk-breadcrumbs-title {\n    font-size: clamp(2.25rem, 5vw, 3.5rem);\n    font-weight: 800;\n    letter-spacing: -0.035em;\n    line-height: 1.05;\n  }\n  #site-search .mk-search-box {\n    position: relative;\n    isolation: isolate;\n    max-width: 48rem;\n    margin: 0;\n  }\n  #site-search .mk-search-box form {\n    border-radius: var(--radius-xl);\n    background: var(--card);\n    box-shadow: 0 10px 30px -12px oklch(0.2 0.05 275 / 0.25);\n  }\n  #site-search .search-glow {\n    inset: -0.5rem;\n    border-radius: 1.1rem;\n    opacity: 0;\n    transition: opacity 300ms;\n  }\n  #site-search .mk-search-box:focus-within .search-glow {\n    opacity: 1;\n  }\n  #site-search .mk-category-menu {\n    max-width: none;\n    margin: 0;\n    border: 0;\n  }\n  #site-search .mk-category-menu a {\n    font-size: 0.9375rem;\n    font-weight: 600;\n  }\n  /* filters beside results */\n  #site-search .sr-layout {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr);\n    gap: 2.5rem;\n    align-items: start;\n    padding-block: clamp(2rem, 5vw, 3.5rem);\n  }\n  @container (width > 56rem) {\n    #site-search .sr-layout {\n      grid-template-columns: 16rem minmax(0, 1fr);\n      gap: 3.5rem;\n    }\n  }\n  @container (width > 56rem) {\n    #site-search .mk-filter-sidebar {\n      position: sticky;\n      top: 1rem;\n    }\n  }\n  #site-search .mk-filter-sidebar-head h2 {\n    font-size: 1rem;\n    font-weight: 800;\n  }\n  #site-search .mk-filter-sidebar-group > summary {\n    font-weight: 700;\n  }\n  #site-search .sr-results {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr);\n    gap: 1.25rem;\n    min-width: 0;\n  }\n  #site-search .sr-sort {\n    display: flex;\n    justify-content: flex-end;\n  }\n  #site-search .sr-list {\n    display: grid;\n    border-block-start: 1px solid var(--border);\n  }\n  #site-search .mk-search-result {\n    padding-block: 1.5rem;\n    border: 0;\n    border-block-end: 1px solid var(--border);\n    border-radius: 0;\n    background: none;\n  }\n  #site-search .mk-search-result-path {\n    color: var(--muted-foreground);\n    font-size: 0.8125rem;\n    font-weight: 600;\n  }\n  #site-search .mk-search-result-title {\n    margin-block: 0.25rem 0.375rem;\n    font-size: 1.25rem;\n    font-weight: 700;\n    letter-spacing: -0.015em;\n  }\n  #site-search .mk-search-result-title a {\n    color: var(--primary);\n  }\n  #site-search[data-look='marker'] .mk-search-result-title a {\n    color: var(--foreground);\n    text-decoration: underline 2px var(--sr-mark);\n    text-underline-offset: 0.2em;\n  }\n  #site-search .mk-search-result-snippet {\n    max-width: 44rem;\n    font:\n      400 1.0625rem/1.6 'Newsreader',\n      Georgia,\n      serif;\n  }\n  #site-search .mk-search-result-meta {\n    color: var(--muted-foreground);\n    font-size: 0.8125rem;\n  }\n  #site-search mark {\n    padding: 0 0.15em;\n    border-radius: 0.2em;\n    background: var(--sr-mark);\n    color: var(--sr-mark-ink);\n  }\n  #site-search[data-look='marker'] mark {\n    font-weight: 700;\n  }\n  #site-search .mk-search-summary strong {\n    font-weight: 800;\n  }\n  #site-search .mk-search-summary-suggest a {\n    color: var(--primary);\n    font-weight: 700;\n  }\n  #site-search .pagination-list {\n    flex-wrap: wrap;\n    justify-content: center;\n  }\n  #site-search > :is(.mk-tag-cloud, .mk-quick-links) {\n    padding-block: 0 clamp(2.5rem, 5vw, 4rem);\n  }\n  /* light or dark: the Swap writes the page's dark class - every look has a light and a dark palette */\n  #site-search .site-mode {\n    flex: none;\n    border: 1px solid var(--input);\n    border-radius: var(--radius-md);\n    background: var(--background);\n    color: var(--foreground);\n  }\n  #site-search .site-mode:hover {\n    background: var(--accent);\n    color: var(--accent-foreground);\n  }\n  /* -- modes: each look in light and dark, derived from the palettes above (the other mode of each look) -- */\n  :root:not(.dark) #site-search[data-look='catalogue'] {\n    --accent: oklch(0.945 0.018 270);\n    --accent-foreground: oklch(0.21 0.02 270);\n  }\n  .dark #site-search[data-look='catalogue'] {\n    --accent: oklch(0.27 0.05 275);\n    --accent-foreground: oklch(0.94 0.008 270);\n  }\n  .dark #site-search[data-look='owl'] {\n    --accent: oklch(0.25 0.05 300);\n    --accent-foreground: oklch(0.94 0.012 290);\n  }\n  :root:not(.dark) #site-search[data-look='owl'] {\n    color-scheme: light;\n    --background: oklch(0.985 0.025 290);\n    --foreground: oklch(0.2 0.012 290);\n    --card: oklch(0.997 0.025 290);\n    --card-foreground: oklch(0.2 0.012 290);\n    --muted: oklch(0.95 0.025 290);\n    --muted-foreground: oklch(0.46 0.025 290);\n    --border: oklch(0.2 0.012 290 / 0.12);\n    --input: oklch(0.2 0.012 290 / 0.12);\n    --primary: oklch(0.53 0.13 300);\n    --primary-foreground: oklch(0.985 0.005 300);\n    --secondary: oklch(0.955 0.025 300);\n    --secondary-foreground: oklch(0.25 0.03 300);\n    --accent: oklch(0.94 0.025 300);\n    --accent-foreground: oklch(0.2 0.012 290);\n    --ring: oklch(0.53 0.13 300);\n    --sr-band: oklch(0.967 0.03 290);\n    --sr-mark: oklch(0.57 0.11 185 / 0.22);\n    --sr-mark-ink: oklch(0.58 0.1 185);\n    --popover: oklch(0.997 0 0);\n    --popover-foreground: oklch(0.2 0 0);\n  }\n  :root:not(.dark) #site-search[data-look='marker'] {\n    --accent: oklch(0.955 0 0);\n  }\n  .dark #site-search[data-look='marker'] {\n    color-scheme: dark;\n    --background: oklch(0.17 0 0);\n    --foreground: oklch(0.94 0 0);\n    --card: oklch(0.205 0 0);\n    --card-foreground: oklch(0.94 0 0);\n    --muted: oklch(0.24 0 0);\n    --muted-foreground: oklch(0.74 0 0);\n    --border: oklch(0.95 0 0 / 0.12);\n    --input: oklch(0.95 0 0 / 0.14);\n    --primary: oklch(0.93 0 0);\n    --primary-foreground: oklch(0.17 0 0);\n    --secondary: oklch(0.25 0 0);\n    --secondary-foreground: oklch(0.9 0 0);\n    --accent: oklch(0.26 0 0);\n    --accent-foreground: oklch(0.94 0 0);\n    --ring: oklch(0.93 0 0);\n    --sr-band: oklch(0.188 0.03 100);\n    --sr-mark: oklch(0.93 0.17 105);\n    --sr-mark-ink: oklch(0.952 0 0);\n    --popover: oklch(0.215 0 0);\n    --popover-foreground: oklch(0.94 0 0);\n  }\n  /* -- modes: end -- */\n</style>\n<div id=\"site-search\" data-look=\"catalogue\" data-i18n-component>\n  <div class=\"sr-bar\">\n    <a class=\"sr-brand\" href=\"#/\" data-router-link>Acme <span>Help</span></a>\n    <div class=\"sr-bar-controls\">\n      <select\n        class=\"select\"\n        data-size=\"sm\"\n        data-site-look\n        aria-label=\"Look\"\n        data-i18n-aria-label-en=\"Look\"\n        data-i18n-aria-label-de=\"Stil\"\n        style=\"width: auto\"\n      >\n        <option value=\"catalogue\" data-i18n-target=\"look-catalogue\">Catalogue</option>\n        <option value=\"owl\" data-i18n-target=\"look-owl\">Night owl</option>\n        <option value=\"marker\" data-i18n-target=\"look-marker\">Highlighter</option>\n      </select>\n      <select\n        class=\"select\"\n        data-size=\"sm\"\n        data-app-locale\n        aria-label=\"Language\"\n        data-i18n-aria-label-en=\"Language\"\n        data-i18n-aria-label-de=\"Sprache\"\n        style=\"width: auto\"\n      >\n        <option value=\"en\" lang=\"en\">English</option>\n        <option value=\"de\" lang=\"de\">Deutsch</option>\n      </select>\n      <label class=\"swap site-mode\" data-variant=\"rotate\" data-size=\"sm\">\n        <input\n          type=\"checkbox\"\n          data-site-mode\n          aria-label=\"Dark mode\"\n          data-i18n-aria-label-en=\"Dark mode\"\n          data-i18n-aria-label-de=\"Dunkler Modus\"\n        />\n        <span class=\"swap-on\" aria-hidden=\"true\"><i data-lucide=\"moon\"></i></span>\n        <span class=\"swap-off\" aria-hidden=\"true\"><i data-lucide=\"sun\"></i></span>\n      </label>\n    </div>\n  </div>\n  <div class=\"sr-hero\">\n    <div class=\"mk-breadcrumbs\">\n      <nav class=\"breadcrumb\" aria-label=\"Breadcrumb\">\n        <ol class=\"breadcrumb-list\">\n          <li class=\"breadcrumb-item\"\n            ><a\n              class=\"breadcrumb-link\"\n              href=\"#\"\n              aria-label=\"Home\"\n              data-i18n-aria-label-en=\"Home\"\n              data-i18n-aria-label-de=\"Start\"\n              ><i data-lucide=\"house\"></i></a\n          ></li>\n          <li class=\"breadcrumb-separator\" aria-hidden=\"true\">/</li>\n          <li class=\"breadcrumb-item\"\n            ><a class=\"breadcrumb-link\" href=\"#\"><span data-i18n-target=\"crumb-help\">Help centre</span></a></li\n          >\n          <li class=\"breadcrumb-separator\" aria-hidden=\"true\">/</li>\n          <li class=\"breadcrumb-item\"\n            ><span class=\"breadcrumb-page\" aria-current=\"page\"\n              ><span data-i18n-target=\"crumb-search\">Search</span></span\n            ></li\n          >\n        </ol>\n      </nav>\n      <a class=\"mk-breadcrumbs-back\" href=\"#\"\n        ><i data-lucide=\"chevron-left\"></i> <span data-i18n-target=\"crumb-back\">Help centre</span></a\n      >\n      <h1 class=\"mk-breadcrumbs-title\" data-i18n-target=\"page-title\">Search the help centre</h1>\n    </div>\n    <search class=\"mk-search-box\" data-variant=\"large\">\n      <div\n        class=\"shader search-glow\"\n        data-variant=\"border\"\n        data-effect=\"pulsing-border\"\n        data-colors=\"var(--primary) var(--accent)\"\n        data-fps=\"30\"\n        aria-hidden=\"true\"\n      ></div>\n      <form action=\"#\" method=\"get\" role=\"search\" data-search-form>\n        <label class=\"sr-only\" for=\"sb-2\" data-i18n-target=\"sn-1-1\">Search</label>\n        <select\n          class=\"select\"\n          name=\"scope\"\n          aria-label=\"Search in\"\n          data-i18n-aria-label-en=\"Search in\"\n          data-i18n-aria-label-de=\"Suchen in\"\n          ><option data-i18n-target=\"sn-2-1\">Everything</option\n          ><option data-i18n-target=\"sn-3-1\">Docs</option\n          ><option data-i18n-target=\"sn-4-1\">Tasks</option\n          ><option data-i18n-target=\"sn-5-1\">People</option></select\n        >\n        <span class=\"mk-search-box-field\"\n          ><i data-lucide=\"search\"></i\n          ><input\n            class=\"input\"\n            id=\"sb-2\"\n            type=\"search\"\n            name=\"q\"\n            placeholder=\"Search docs, tasks and people\"\n            data-i18n-placeholder-en=\"Search docs, tasks and people\"\n            data-i18n-placeholder-de=\"Doku, Aufgaben und Personen suchen\"\n            autocomplete=\"off\"\n            enterkeyhint=\"search\"\n          /><kbd class=\"kbd\">⌘K</kbd></span\n        >\n        <button class=\"btn\" type=\"submit\" data-i18n-target=\"sn-1-2\">Search</button>\n      </form>\n    </search>\n    <nav\n      class=\"mk-category-menu\"\n      aria-label=\"Categories\"\n      data-i18n-aria-label-en=\"Categories\"\n      data-i18n-aria-label-de=\"Kategorien\"\n    >\n      <ul>\n        <li\n          ><a href=\"#/\" data-router-link data-query=\"category=\" aria-current=\"page\"\n            ><i data-lucide=\"layout-grid\"></i><span data-i18n-target=\"sn-6-1\">All</span><small>248</small></a\n          ></li\n        >\n        <li\n          ><a href=\"#/?category=product\" data-router-link data-query=\"category=product\"\n            ><i data-lucide=\"box\"></i><span data-i18n-target=\"sn-7-1\">Product</span><small>64</small></a\n          ></li\n        >\n        <li\n          ><a href=\"#/?category=engineering\" data-router-link data-query=\"category=engineering\"\n            ><i data-lucide=\"code\"></i><span data-i18n-target=\"sn-8-1\">Engineering</span><small>81</small></a\n          ></li\n        >\n        <li\n          ><a href=\"#/?category=design\" data-router-link data-query=\"category=design\"\n            ><i data-lucide=\"pen-tool\"></i><span>Design</span><small>47</small></a\n          ></li\n        >\n        <li\n          ><a href=\"#/?category=company\" data-router-link data-query=\"category=company\"\n            ><i data-lucide=\"building-2\"></i><span data-i18n-target=\"sn-9-1\">Company</span><small>31</small></a\n          ></li\n        >\n        <li\n          ><a href=\"#/?category=guides\" data-router-link data-query=\"category=guides\"\n            ><i data-lucide=\"book-open\"></i><span data-i18n-target=\"sn-10-1\">Guides</span><small>25</small></a\n          ><