[{"label":"Default","html":"<fieldset class=\"mk-address-form\">\n  <legend>Shipping address</legend>\n  <div class=\"mk-address-form-grid\">\n    <div class=\"mk-address-form-field\"\n      ><label class=\"label\" for=\"ad-country\">Country / region</label\n      ><select class=\"select\" id=\"ad-country\" name=\"country\" autocomplete=\"country\"\n        ><option value=\"PT\">Portugal</option\n        ><option value=\"DE\">Germany</option\n        ><option value=\"FR\">France</option></select\n      ></div\n    >\n    <div class=\"mk-address-form-field\" data-span=\"4\"\n      ><label class=\"label\" for=\"ad-name\">Full name</label\n      ><input class=\"input\" id=\"ad-name\" name=\"name\" autocomplete=\"shipping name\" required\n    /></div>\n    <div class=\"mk-address-form-field\" data-span=\"2\"\n      ><label class=\"label\" for=\"ad-org\">Company <small>(optional)</small></label\n      ><input class=\"input\" id=\"ad-org\" name=\"organization\" autocomplete=\"shipping organization\"\n    /></div>\n    <div class=\"mk-address-form-field\"\n      ><label class=\"label\" for=\"ad-l1\">Street and number</label\n      ><input class=\"input\" id=\"ad-l1\" name=\"address1\" autocomplete=\"shipping address-line1\" required\n    /></div>\n    <div class=\"mk-address-form-field\"\n      ><label class=\"label\" for=\"ad-l2\">Apartment, floor <small>(optional)</small></label\n      ><input class=\"input\" id=\"ad-l2\" name=\"address2\" autocomplete=\"shipping address-line2\"\n    /></div>\n    <div class=\"mk-address-form-field\" data-span=\"2\"\n      ><label class=\"label\" for=\"ad-zip\">Postal code</label\n      ><input class=\"input\" id=\"ad-zip\" name=\"postal\" autocomplete=\"shipping postal-code\" required\n    /></div>\n    <div class=\"mk-address-form-field\" data-span=\"4\"\n      ><label class=\"label\" for=\"ad-city\">City</label\n      ><input class=\"input\" id=\"ad-city\" name=\"city\" autocomplete=\"shipping address-level2\" required\n    /></div>\n    <div class=\"mk-address-form-field\" data-span=\"3\"\n      ><label class=\"label\" for=\"ad-tel\">Phone <small>(for the courier)</small></label\n      ><input class=\"input\" id=\"ad-tel\" type=\"tel\" name=\"tel\" autocomplete=\"shipping tel\" inputmode=\"tel\"\n    /></div>\n    <div class=\"mk-address-form-field\" data-span=\"3\"\n      ><label class=\"label\" for=\"ad-mail\">Email</label\n      ><input class=\"input\" id=\"ad-mail\" type=\"email\" name=\"email\" autocomplete=\"email\" required\n    /></div>\n  </div>\n  <div class=\"mk-address-form-same\"\n    ><input class=\"checkbox\" type=\"checkbox\" id=\"ad-same\" name=\"billing-same\" checked /><label for=\"ad-same\"\n      >Billing address is the same</label\n    ></div\n  >\n</fieldset>\n","individual":true},{"label":"Saved addresses","html":"<fieldset class=\"mk-address-form\" style=\"max-width: 32rem\">\n  <legend>Deliver to</legend>\n  <div class=\"mk-address-form-saved\">\n    <label class=\"mk-address-form-option\"\n      ><input class=\"radio\" type=\"radio\" name=\"addr\" value=\"home\" checked /><strong>Home</strong><a href=\"#\">Edit</a\n      ><address>Anna Silva<br />Rua da Prata 120, 2º<br />1100-420 Lisboa, Portugal</address></label\n    >\n    <label class=\"mk-address-form-option\"\n      ><input class=\"radio\" type=\"radio\" name=\"addr\" value=\"office\" /><strong>Office</strong><a href=\"#\">Edit</a\n      ><address>Anna Silva, Acme<br />Torstraße 45<br />10119 Berlin, Germany</address></label\n    >\n  </div>\n  <a class=\"mk-address-form-add\" href=\"#\"><i data-lucide=\"plus\"></i> Add a new address</a>\n</fieldset>\n","individual":true}]
