[{"label":"Two changes, two Diff figures","html":"<article class=\"paper\" data-variant=\"minimal\" data-print=\"a4\" aria-labelledby=\"pd-title\">\n  <header class=\"paper-hero\">\n    <p class=\"paper-venue\"\n      ><span class=\"badge\" data-variant=\"secondary\">Change report</span\n      ><span>defuss-shadcn · <time datetime=\"2026-10-12\">12 October 2026</time></span></p\n    >\n    <h1 class=\"paper-title\" id=\"pd-title\"\n      >Before and After<span class=\"paper-title-sub\">A source tree moved, a code window fixed</span></h1\n    >\n    <ul class=\"paper-authors\"\n      ><li>Claude</li\n      ><li>Aron Homberg</li></ul\n    >\n  </header>\n\n  <section class=\"paper-section\" aria-labelledby=\"pd-s1\">\n    <h2 id=\"pd-s1\"><span class=\"paper-num\">1&nbsp;</span>The move</h2>\n    <p\n      >Each of the 228 component folders moved into the folder of the sidebar section that lists it, and kept its\n      files.</p\n    >\n    <figure class=\"paper-figure\">\n      <figure class=\"diff\" aria-label=\"The source tree before and after the move: drag the divider to compare\">\n        <div class=\"diff-item-1\">\n          <div class=\"mockup-code\" data-chrome=\"none\" data-variant=\"muted\" style=\"padding-block-start: 2.75rem\">\n            <pre><code>src/components/</code></pre>\n            <pre data-diff=\"remove\"><code>  button/</code></pre>\n            <pre><code>    button.css</code></pre>\n            <pre data-diff=\"remove\"><code>  dialog/</code></pre>\n            <pre><code>    dialog.ts</code></pre>\n          </div>\n          <span class=\"diff-label\">Before</span>\n        </div>\n        <div class=\"diff-item-2\">\n          <div class=\"mockup-code\" data-chrome=\"none\" data-variant=\"muted\" style=\"padding-block-start: 2.75rem\">\n            <pre><code>src/components/</code></pre>\n            <pre data-diff=\"add\"><code>  actions/button/</code></pre>\n            <pre><code>    button.css</code></pre>\n            <pre data-diff=\"add\"><code>  overlays/dialog/</code></pre>\n            <pre><code>    dialog.ts</code></pre>\n          </div>\n          <span class=\"diff-label\">After</span>\n        </div>\n        <input\n          class=\"diff-range\"\n          type=\"range\"\n          min=\"0\"\n          max=\"100\"\n          value=\"50\"\n          step=\"0.1\"\n          aria-label=\"Comparison divider\"\n        />\n      </figure>\n      <figcaption><b>Figure 1.</b> Two of the 228 component folders before and after the move.</figcaption>\n    </figure>\n  </section>\n\n  <section class=\"paper-section\" aria-labelledby=\"pd-s2\">\n    <h2 id=\"pd-s2\"><span class=\"paper-num\">2&nbsp;</span>The fix</h2>\n    <p\n      >The report's tree windows used the default Code Mockup, a dark terminal in both themes: on a light page, and on\n      paper, it stood out as a dark block. The muted variant takes the theme's surface.</p\n    >\n    <figure class=\"paper-figure\">\n      <figure class=\"diff\" aria-label=\"The code window before and after the fix: drag the divider to compare\">\n        <div class=\"diff-item-1\">\n          <div class=\"mockup-code\" data-chrome=\"none\" style=\"padding-block-start: 2.75rem\">\n            <pre><code>src/components/</code></pre>\n            <pre data-diff=\"add\"><code>  actions/button/</code></pre>\n            <pre><code>    button.css</code></pre>\n          </div>\n          <span class=\"diff-label\">Before</span>\n        </div>\n        <div class=\"diff-item-2\">\n          <div class=\"mockup-code\" data-chrome=\"none\" data-variant=\"muted\" style=\"padding-block-start: 2.75rem\">\n            <pre><code>src/components/</code></pre>\n            <pre data-diff=\"add\"><code>  actions/button/</code></pre>\n            <pre><code>    button.css</code></pre>\n          </div>\n          <span class=\"diff-label\">After</span>\n        </div>\n        <input\n          class=\"diff-range\"\n          type=\"range\"\n          min=\"0\"\n          max=\"100\"\n          value=\"50\"\n          step=\"0.1\"\n          aria-label=\"Comparison divider\"\n        />\n      </figure>\n      <figcaption\n        ><b>Figure 2.</b> One tree window before and after the fix: the default terminal, then\n        <code>data-variant=\"muted\"</code>.</figcaption\n      >\n    </figure>\n  </section>\n</article>\n","individual":false},{"label":"Printed: both sides in full","html":"<article class=\"paper\" data-variant=\"minimal\" data-print=\"a4\" aria-labelledby=\"pdp-title\">\n  <header class=\"paper-hero\">\n    <h1 class=\"paper-title\" id=\"pdp-title\">Before and After</h1>\n  </header>\n  <section class=\"paper-section\" aria-labelledby=\"pdp-s1\">\n    <h2 id=\"pdp-s1\"><span class=\"paper-num\">1&nbsp;</span>The move</h2>\n    <figure class=\"paper-figure\">\n      <figure class=\"diff\" aria-label=\"The source tree before and after the move: drag the divider to compare\">\n        <div class=\"diff-item-1\">\n          <div class=\"mockup-code\" data-chrome=\"none\" data-variant=\"muted\" style=\"padding-block-start: 2.75rem\">\n            <pre><code>src/components/</code></pre>\n            <pre data-diff=\"remove\"><code>  button/</code></pre>\n            <pre><code>    button.css</code></pre>\n            <pre data-diff=\"remove\"><code>  dialog/</code></pre>\n            <pre><code>    dialog.ts</code></pre>\n          </div>\n          <span class=\"diff-label\">Before</span>\n        </div>\n        <div class=\"diff-item-2\">\n          <div class=\"mockup-code\" data-chrome=\"none\" data-variant=\"muted\" style=\"padding-block-start: 2.75rem\">\n            <pre><code>src/components/</code></pre>\n            <pre data-diff=\"add\"><code>  actions/button/</code></pre>\n            <pre><code>    button.css</code></pre>\n            <pre data-diff=\"add\"><code>  overlays/dialog/</code></pre>\n            <pre><code>    dialog.ts</code></pre>\n          </div>\n          <span class=\"diff-label\">After</span>\n        </div>\n        <input\n          class=\"diff-range\"\n          type=\"range\"\n          min=\"0\"\n          max=\"100\"\n          value=\"30\"\n          step=\"0.1\"\n          aria-label=\"Comparison divider\"\n        />\n      </figure>\n      <figcaption><b>Figure 1.</b> Two of the 228 component folders before and after the move.</figcaption>\n    </figure>\n  </section>\n</article>\n","individual":false}]
