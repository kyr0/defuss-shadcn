[{"label":"Every effect","html":"<div class=\"fx-gallery grid gap-3\" id=\"fx-gallery\">\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span\n      class=\"shader\"\n      data-effect=\"mesh-gradient\"\n      data-colors=\"#4900ff #00c9ff #fb52d4 #ffb86b\"\n      aria-hidden=\"true\"\n    ></span>\n    <span class=\"text-xs text-muted-foreground\">mesh-gradient</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span\n      class=\"shader\"\n      data-effect=\"grain-gradient\"\n      data-colors=\"#120a2a #5b2bd6 #ff6b9a #ffd27a\"\n      aria-hidden=\"true\"\n    ></span>\n    <span class=\"text-xs text-muted-foreground\">grain-gradient</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"warp\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">warp</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"neuro-noise\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">neuro-noise</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"dithering\" data-colors=\"#1b1b3a #ff5d73 #ffe9a8\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">dithering</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"god-rays\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">god-rays</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"aurora\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">aurora</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span\n      class=\"shader\"\n      data-effect=\"pulsing-border\"\n      data-colors=\"#ff4d8d #7c5cff #2bd9ff\"\n      data-background=\"#0d0f1a\"\n      aria-hidden=\"true\"\n    ></span>\n    <span class=\"text-xs text-muted-foreground\">pulsing-border</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"hologram\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">hologram</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span\n      class=\"shader\"\n      data-effect=\"metaballs\"\n      data-colors=\"#22d3ee #a78bfa #f472b6\"\n      data-background=\"#0b1020\"\n      aria-hidden=\"true\"\n    ></span>\n    <span class=\"text-xs text-muted-foreground\">metaballs</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"liquid-metal\" data-background=\"#15171c\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">liquid-metal</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"water\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">water</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"fluted-glass\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">fluted-glass</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"fluid\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">fluid</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span\n      class=\"shader\"\n      data-effect=\"dot-orbit\"\n      data-colors=\"#f97316 #ec4899 #8b5cf6\"\n      data-background=\"#fff7ed\"\n      aria-hidden=\"true\"\n    ></span>\n    <span class=\"text-xs text-muted-foreground\">dot-orbit</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span\n      class=\"shader\"\n      data-effect=\"topography\"\n      data-colors=\"#a3b18a #588157 #3a5a40\"\n      data-background=\"#f4f1e8\"\n      aria-hidden=\"true\"\n    ></span>\n    <span class=\"text-xs text-muted-foreground\">topography</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"trails\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">trails</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"orb\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">orb</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"galaxy\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">galaxy</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"waves\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">waves</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"plasma\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">plasma</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"bokeh\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">bokeh</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"ripple\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">ripple</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"voronoi\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">voronoi</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"halftone\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">halftone</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"kaleidoscope\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">kaleidoscope</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"clouds\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">clouds</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"fire\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">fire</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"starfield\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">starfield</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span\n      class=\"shader\"\n      data-effect=\"surface\"\n      data-pattern=\"cubes\"\n      data-material=\"ceramic\"\n      data-colors=\"#1d2433 #f2c14e #f78154 #4d9078\"\n      aria-hidden=\"true\"\n    ></span>\n    <span class=\"text-xs text-muted-foreground\">surface</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"silk\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">silk</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"marble\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">marble</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"oil\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">oil</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"prism\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">prism</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"lightning\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">lightning</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"fireflies\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">fireflies</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"caustics\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">caustics</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"matrix\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">matrix</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"op-art\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">op-art</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"glitch\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">glitch</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"crt\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">crt</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"nebula\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">nebula</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"snow\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">snow</span>\n  </button>\n  <button type=\"button\" class=\"fx-tile\" aria-expanded=\"false\" aria-controls=\"fx-stage\">\n    <span class=\"shader\" data-effect=\"smoke\" aria-hidden=\"true\"></span>\n    <span class=\"text-xs text-muted-foreground\">smoke</span>\n  </button>\n  <section class=\"fx-stage card\" id=\"fx-stage\" aria-label=\"The picked effect\" hidden>\n    <div class=\"fx-stage-view\">\n      <div class=\"shader\" id=\"fx-big\" data-effect=\"mesh-gradient\" aria-hidden=\"true\"></div>\n    </div>\n    <div class=\"grid gap-3 content-start\">\n      <div class=\"flex items-center justify-between gap-2\">\n        <h3 class=\"text-sm font-medium m-0\" id=\"fx-name\">mesh-gradient</h3>\n        <button type=\"button\" class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" id=\"fx-close\">Close</button>\n      </div>\n      <div\n        class=\"shader-controls\"\n        data-shader-for=\"fx-big\"\n        data-controls=\"effect options params colors speed actions\"\n      ></div>\n    </div>\n  </section>\n</div>\n<style>\n  .fx-gallery {\n    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));\n    grid-auto-flow: row dense;\n  }\n  .fx-tile {\n    display: grid;\n    gap: 0.25rem;\n    padding: 0;\n    border: 0;\n    background: none;\n    color: inherit;\n    font: inherit;\n    text-align: start;\n    cursor: pointer;\n    & .shader {\n      border-radius: var(--radius);\n      outline: 2px solid transparent;\n      outline-offset: 0;\n      transition: outline-offset 0.15s;\n    }\n    &:hover .shader,\n    &[aria-expanded='true'] .shader {\n      outline-color: var(--ring);\n      outline-offset: 2px;\n    }\n    &:focus-visible {\n      outline: none;\n      & .shader {\n        outline: 2px solid var(--ring);\n        outline-offset: 3px;\n      }\n    }\n  }\n  .fx-stage {\n    grid-column: 1 / -1;\n    display: grid;\n    grid-template-columns: minmax(0, 2fr) minmax(15rem, 1fr);\n    gap: 1rem;\n    padding: 1rem;\n    &[hidden] {\n      display: none;\n    }\n    & .shader {\n      --shader-aspect: 16 / 10;\n      border-radius: var(--radius);\n    }\n  }\n  @media (max-width: 48rem) {\n    .fx-stage {\n      grid-template-columns: minmax(0, 1fr);\n    }\n  }\n</style>\n","individual":false}]
