[{"label":"Shader (background)","html":"<div class=\"shader\" data-variant=\"background\" data-effect=\"aurora\" aria-hidden=\"true\"></div>\n","individual":true},{"label":"Shader (border)","html":"<div\n  class=\"shader\"\n  data-variant=\"border\"\n  data-effect=\"pulsing-border\"\n  data-colors=\"#ff4d8d #7c5cff #2bd9ff\"\n  aria-hidden=\"true\"\n></div>\n","individual":true},{"label":"Shader (background, 18)","html":"<div\n  class=\"shader\"\n  data-variant=\"background\"\n  data-effect=\"matrix\"\n  data-size=\"18\"\n  data-rain=\"0.7\"\n  data-trail=\"0.7\"\n  data-speed=\"0.5\"\n  data-fps=\"30\"\n  aria-hidden=\"true\"\n></div>\n","individual":true},{"label":"A mesh gradient","html":"<div\n  class=\"shader\"\n  data-effect=\"mesh-gradient\"\n  data-colors=\"#4900ff #00c9ff #fb52d4 #ffb86b\"\n  aria-hidden=\"true\"\n  style=\"width: 100%; max-width: 40rem; border-radius: var(--radius)\"\n></div>\n","individual":true},{"label":"A hero on an aurora","html":"<section style=\"border-radius: var(--radius); padding: 4rem 2rem; color: white; overflow: hidden\">\n  <div class=\"shader\" data-variant=\"background\" data-effect=\"aurora\" aria-hidden=\"true\"></div>\n  <p style=\"margin: 0 0 0.5rem; letter-spacing: 0.2em; font-size: 0.75rem; text-transform: uppercase; opacity: 0.8\">\n    Night shift\n  </p>\n  <h2 style=\"margin: 0; font-size: clamp(1.75rem, 5vw, 3rem); line-height: 1.1\">Ship while the sky moves</h2>\n  <p style=\"max-width: 32rem; opacity: 0.85\"\n    >The aurora is one element behind the content - no image, no video, a few kilobytes of GLSL.</p\n  >\n  <button class=\"btn\" type=\"button\" style=\"margin-top: 1rem\">Start building</button>\n</section>\n","individual":false},{"label":"A glowing card","html":"<div class=\"card\" style=\"max-width: 22rem\">\n  <div\n    class=\"shader\"\n    data-variant=\"border\"\n    data-effect=\"pulsing-border\"\n    data-colors=\"#ff4d8d #7c5cff #2bd9ff\"\n    aria-hidden=\"true\"\n  ></div>\n  <div class=\"card-header\">\n    <h3 class=\"card-title\">Pro plan</h3>\n    <p class=\"card-description\">Everything in Team, plus the things you asked for.</p>\n  </div>\n  <div class=\"card-content\"\n    ><p style=\"margin: 0; font-size: 2rem; font-weight: 600\"\n      >$24 <span style=\"font-size: 0.875rem; font-weight: 400\">per month</span></p\n    ></div\n  >\n  <div class=\"card-footer\"><button class=\"btn\" type=\"button\" style=\"width: 100%\">Upgrade</button></div>\n</div>\n","individual":false},{"label":"Theme tokens and fixed colors","html":"<div class=\"grid gap-3\" style=\"grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr))\">\n  <div\n    class=\"shader\"\n    data-effect=\"mesh-gradient\"\n    data-colors=\"var(--chart-1) var(--chart-3) var(--primary) var(--chart-5)\"\n    aria-hidden=\"true\"\n    style=\"border-radius: var(--radius)\"\n  ></div>\n  <div\n    class=\"shader\"\n    data-effect=\"mesh-gradient\"\n    data-colors=\"#ff7e5f #feb47b #ffd86f #fc6262\"\n    aria-hidden=\"true\"\n    style=\"border-radius: var(--radius)\"\n  ></div>\n  <div\n    class=\"shader\"\n    data-effect=\"mesh-gradient\"\n    data-colors=\"oklch(0.75 0.15 160) oklch(0.6 0.2 250) oklch(0.85 0.1 90)\"\n    aria-hidden=\"true\"\n    style=\"border-radius: var(--radius)\"\n  ></div>\n</div>\n","individual":false},{"label":"Slow, tuned, following the pointer","html":"<div class=\"grid gap-3\" style=\"grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr))\">\n  <div\n    class=\"shader\"\n    data-effect=\"mesh-gradient\"\n    data-speed=\"0.4\"\n    data-distortion=\"1.4\"\n    data-swirl=\"0.9\"\n    data-grain=\"0.6\"\n    data-colors=\"#0f172a #6366f1 #ec4899 #f59e0b\"\n    aria-hidden=\"true\"\n    style=\"border-radius: var(--radius)\"\n  ></div>\n  <div\n    class=\"shader\"\n    data-effect=\"metaballs\"\n    data-interactive\n    data-count=\"9\"\n    data-colors=\"#22d3ee #a78bfa #f472b6\"\n    data-background=\"#0b1020\"\n    aria-hidden=\"true\"\n    style=\"border-radius: var(--radius)\"\n  ></div>\n</div>\n","individual":false},{"label":"A logo in liquid metal, a photo dithered","html":"<div class=\"grid gap-3 items-center\" style=\"grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr))\">\n  <div class=\"shader\" data-effect=\"liquid-metal\" style=\"max-width: 14rem; margin: auto\">\n    <svg viewBox=\"0 0 200 200\" role=\"img\" aria-label=\"A star logo\">\n      <path d=\"M100 8l26 62 66 6-50 44 15 66-57-35-57 35 15-66L8 76l66-6z\" fill=\"currentColor\" />\n    </svg>\n  </div>\n  <div class=\"shader\" data-effect=\"dithering\" data-interactive data-pixel=\"2\" style=\"border-radius: var(--radius)\">\n    <img\n      src=\"https://picsum.photos/id/1036/800/500\"\n      alt=\"A snowy forest road\"\n      crossorigin=\"anonymous\"\n      width=\"800\"\n      height=\"500\"\n    />\n  </div>\n</div>\n","individual":false},{"label":"A background at half resolution and 30 frames a second","html":"<section style=\"border-radius: var(--radius); padding: 3rem 2rem; color: white; overflow: hidden\">\n  <div\n    class=\"shader\"\n    data-variant=\"background\"\n    data-effect=\"warp\"\n    data-quality=\"low\"\n    data-fps=\"30\"\n    aria-hidden=\"true\"\n  ></div>\n  <h3 style=\"margin: 0 0 0.5rem; font-size: 1.5rem\">Quiet, and cheap</h3>\n  <p style=\"margin: 0; max-width: 28rem; opacity: 0.9\">A slow background needs neither every pixel nor every frame.</p>\n</section>\n","individual":false},{"label":"A pause button","html":"<div class=\"grid gap-3\">\n  <div\n    class=\"shader\"\n    id=\"pausable\"\n    data-effect=\"galaxy\"\n    data-time=\"12\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 21 / 9; border-radius: var(--radius)\"\n  ></div>\n  <button\n    class=\"btn\"\n    data-variant=\"outline\"\n    type=\"button\"\n    aria-pressed=\"false\"\n    id=\"pause-galaxy\"\n    style=\"justify-self: start\"\n    >Pause</button\n  >\n</div>\n","individual":false}]
