[{"label":"Visual Editor","html":"<div class=\"visual-editor\" id=\"ve-compose\" aria-label=\"A welcome card\" style=\"--visual-editor-height: 22rem\"> </div>\n","individual":true},{"label":"Compose with blocks","html":"<div class=\"stack gap-3\">\n  <div class=\"flex flex-wrap gap-2\" data-visual-editor-for=\"ve-compose\" aria-label=\"Blocks\">\n    <button type=\"button\" class=\"btn\" data-variant=\"outline\" data-size=\"sm\" draggable=\"true\" data-visual-editor-block>\n      Button\n      <template><button class=\"btn\">Get started</button></template>\n    </button>\n    <button type=\"button\" class=\"btn\" data-variant=\"outline\" data-size=\"sm\" draggable=\"true\" data-visual-editor-block>\n      Badge\n      <template><span class=\"badge\" data-variant=\"secondary\">New</span></template>\n    </button>\n    <button type=\"button\" class=\"btn\" data-variant=\"outline\" data-size=\"sm\" draggable=\"true\" data-visual-editor-block>\n      Email field\n      <template\n        ><div class=\"stack gap-2\">\n          <label class=\"label\" for=\"email\">Email</label\n          ><input class=\"input\" id=\"email\" type=\"email\" placeholder=\"you@example.com\" /></div\n      ></template>\n    </button>\n    <button type=\"button\" class=\"btn\" data-variant=\"outline\" data-size=\"sm\" draggable=\"true\" data-visual-editor-block>\n      Alert\n      <template\n        ><div class=\"alert\" role=\"status\">\n          <h5 class=\"alert-title\">Saved</h5>\n          <div class=\"alert-description\">Your changes are live.</div>\n        </div></template\n      >\n    </button>\n  </div>\n  <div class=\"toolbar\" role=\"toolbar\" aria-label=\"Editor\" data-size=\"sm\">\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-visual-editor-for=\"ve-compose\"\n      data-visual-editor-action=\"undo\"\n    >\n      <i data-lucide=\"undo-2\"></i> Undo\n    </button>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-visual-editor-for=\"ve-compose\"\n      data-visual-editor-action=\"redo\"\n    >\n      <i data-lucide=\"redo-2\"></i> Redo\n    </button>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-visual-editor-for=\"ve-compose\"\n      data-visual-editor-action=\"duplicate\"\n    >\n      <i data-lucide=\"copy\"></i> Duplicate\n    </button>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-visual-editor-for=\"ve-compose\"\n      data-visual-editor-action=\"remove\"\n    >\n      <i data-lucide=\"trash-2\"></i> Remove\n    </button>\n  </div>\n  <div\n    class=\"visual-editor\"\n    id=\"ve-compose\"\n    data-state-demo\n    aria-label=\"A welcome card\"\n    style=\"--visual-editor-height: 22rem\"\n  >\n    \n  </div>\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"ve-compose-read\">\n    <i data-lucide=\"code\"></i> Read the markup\n  </button>\n  <textarea class=\"textarea\" id=\"ve-compose-out\" rows=\"6\" readonly aria-label=\"The page markup\" placeholder=\"Click Read the markup\"></textarea>\n</div>\n","individual":false},{"label":"Inspect the selection","html":"<div class=\"stack gap-3\">\n  <div class=\"visual-editor\" id=\"ve-inspect\" aria-label=\"A call to action\" style=\"--visual-editor-height: 16rem\">\n    \n  </div>\n  <div class=\"flex flex-wrap items-end gap-3\">\n    <div class=\"stack gap-1\">\n      <label class=\"label\" for=\"ve-inspect-text\">Text</label>\n      <input class=\"input\" id=\"ve-inspect-text\" disabled />\n    </div>\n    <div class=\"stack gap-1\">\n      <label class=\"label\" for=\"ve-inspect-variant\">Variant</label>\n      <select class=\"select\" id=\"ve-inspect-variant\" disabled>\n        <option value=\"\">default</option>\n        <option>secondary</option>\n        <option>outline</option>\n        <option>ghost</option>\n        <option>destructive</option>\n      </select>\n    </div>\n    <output class=\"text-sm text-muted-foreground\" id=\"ve-inspect-out\" for=\"ve-inspect\">Nothing selected</output>\n  </div>\n</div>\n","individual":false},{"label":"Read only, on a phone","html":"<div class=\"stack gap-3\">\n  <select\n    class=\"select\"\n    data-size=\"sm\"\n    aria-label=\"Device\"\n    data-visual-editor-for=\"ve-phone\"\n    data-visual-editor-action=\"device\"\n  >\n    <option value=\"desktop\">Desktop</option>\n    <option value=\"tablet\">Tablet</option>\n    <option value=\"phone\" selected>Phone</option>\n  </select>\n  <div\n    class=\"visual-editor\"\n    id=\"ve-phone\"\n    data-readonly\n    data-device=\"phone\"\n    aria-label=\"A sign-in form\"\n    style=\"--visual-editor-height: 24rem\"\n  >\n    \n  </div>\n</div>\n","individual":false},{"label":"The markup and its outline","html":"<div class=\"stack gap-3\">\n  <div class=\"visual-editor\" id=\"ve-project\" aria-label=\"A pricing teaser\" style=\"--visual-editor-height: 16rem\">\n    \n  </div>\n  <div class=\"flex flex-wrap gap-2\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"ve-project-save\"\n      >Keep the markup</button\n    >\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"ve-project-load\">Load it back</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"ve-project-outline\"\n      >Show the outline</button\n    >\n  </div>\n  <pre class=\"text-xs\" id=\"ve-project-out\" style=\"max-block-size: 12rem; overflow: auto\"></pre>\n</div>\n","individual":false},{"label":"A locked component","html":"<div class=\"stack gap-3\">\n  <div class=\"visual-editor\" id=\"ve-locked\" aria-label=\"Questions\" style=\"--visual-editor-height: 18rem\">\n    \n  </div>\n  <div class=\"flex flex-wrap items-center gap-2\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"ve-locked-open\">Open every item</button>\n    <span class=\"text-muted-foreground\" id=\"ve-locked-info\">Select an element.</span>\n  </div>\n</div>\n","individual":false}]
