[{"label":"Filter Bar (sticky)","html":"<div class=\"mk-filter-bar\" data-variant=\"sticky\">\n  <form action=\"#\" method=\"get\" aria-label=\"Filters\" style=\"padding-inline: 0.75rem\">\n    <label class=\"mk-filter-bar-chip\"><input type=\"checkbox\" name=\"open\" checked />Open now</label>\n    <label class=\"mk-filter-bar-chip\"><input type=\"checkbox\" name=\"wifi\" />Wi-Fi</label>\n    <label class=\"mk-filter-bar-chip\"><input type=\"checkbox\" name=\"quiet\" />Quiet</label>\n    <output class=\"mk-filter-bar-count\">12 cafés</output>\n  </form>\n</div>\n","individual":true},{"label":"Default","html":"<div class=\"mk-filter-bar\">\n  <form action=\"#\" method=\"get\" aria-label=\"Filters\">\n    <select class=\"select\" name=\"category\" aria-label=\"Category\"\n      ><option>All categories</option\n      ><option>Shirts</option\n      ><option>Knitwear</option></select\n    >\n    <select class=\"select\" name=\"price\" aria-label=\"Price\"\n      ><option>Any price</option\n      ><option>Under €50</option\n      ><option>€50 – €100</option></select\n    >\n    <span class=\"mk-filter-bar-sep\" aria-hidden=\"true\"></span>\n    <label class=\"mk-filter-bar-chip\"\n      ><input type=\"checkbox\" name=\"sale\" checked /><i data-lucide=\"percent\"></i>On sale</label\n    >\n    <label class=\"mk-filter-bar-chip\"><input type=\"checkbox\" name=\"new\" />New in</label>\n    <label class=\"mk-filter-bar-chip\"><input type=\"checkbox\" name=\"organic\" />Organic</label>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\"\n      ><i data-lucide=\"sliders-horizontal\"></i> More filters\n      <span class=\"badge\" data-variant=\"secondary\" data-size=\"sm\">2</span></button\n    >\n    <output class=\"mk-filter-bar-count\">36 products</output>\n  </form>\n</div>\n","individual":true},{"label":"Sticky","html":"<div\n  style=\"\n    max-height: 16rem;\n    overflow: auto;\n    width: 100%;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-md);\n  \"\n>\n  <div class=\"mk-filter-bar\" data-variant=\"sticky\">\n    <form action=\"#\" method=\"get\" aria-label=\"Filters\" style=\"padding-inline: 0.75rem\">\n      <label class=\"mk-filter-bar-chip\"><input type=\"checkbox\" name=\"open\" checked />Open now</label>\n      <label class=\"mk-filter-bar-chip\"><input type=\"checkbox\" name=\"wifi\" />Wi-Fi</label>\n      <label class=\"mk-filter-bar-chip\"><input type=\"checkbox\" name=\"quiet\" />Quiet</label>\n      <output class=\"mk-filter-bar-count\">12 cafés</output>\n    </form>\n  </div>\n  <div style=\"padding: 1rem; display: grid; gap: 0.75rem\"\n    ><p style=\"margin: 0; color: var(--muted-foreground)\">Café 1</p\n    ><p style=\"margin: 0; color: var(--muted-foreground)\">Café 2</p\n    ><p style=\"margin: 0; color: var(--muted-foreground)\">Café 3</p\n    ><p style=\"margin: 0; color: var(--muted-foreground)\">Café 4</p\n    ><p style=\"margin: 0; color: var(--muted-foreground)\">Café 5</p\n    ><p style=\"margin: 0; color: var(--muted-foreground)\">Café 6</p\n    ><p style=\"margin: 0; color: var(--muted-foreground)\">Café 7</p\n    ><p style=\"margin: 0; color: var(--muted-foreground)\">Café 8</p\n    ><p style=\"margin: 0; color: var(--muted-foreground)\">Café 9</p\n    ><p style=\"margin: 0; color: var(--muted-foreground)\">Café 10</p></div\n  >\n</div>\n","individual":false}]
