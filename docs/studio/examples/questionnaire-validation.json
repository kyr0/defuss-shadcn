[{"label":"Sign-up","html":"<form class=\"questionnaire\" id=\"q-signup\" aria-label=\"Sign up\" data-persist=\"none\" style=\"max-width: 32rem\">\n  <div class=\"questionnaire-progress\"></div>\n  <fieldset class=\"questionnaire-step\" data-step=\"user\">\n    <legend class=\"questionnaire-title\">Pick a username</legend>\n    <p class=\"questionnaire-description\">3–16 letters, digits or dashes.</p>\n    <input\n      class=\"input\"\n      name=\"username\"\n      required\n      pattern=\"[a-z0-9-]{3,16}\"\n      aria-label=\"Username\"\n      autocomplete=\"username\"\n    />\n  </fieldset>\n  <fieldset class=\"questionnaire-step\" data-step=\"email\">\n    <legend class=\"questionnaire-title\">Your email</legend>\n    <input class=\"input\" name=\"email\" type=\"email\" required aria-label=\"Email\" autocomplete=\"email\" />\n  </fieldset>\n  <fieldset class=\"questionnaire-step\" data-step=\"interests\" data-min=\"1\" data-max=\"3\">\n    <legend class=\"questionnaire-title\">What are you into?</legend>\n    <p class=\"questionnaire-description\">One to three.</p>\n    <div class=\"questionnaire-choices\" data-columns=\"2\">\n      <label class=\"questionnaire-choice\"\n        ><input type=\"checkbox\" name=\"interests\" value=\"design\" /><span class=\"questionnaire-choice-label\"\n          >Design</span\n        ></label\n      >\n      <label class=\"questionnaire-choice\"\n        ><input type=\"checkbox\" name=\"interests\" value=\"code\" /><span class=\"questionnaire-choice-label\"\n          >Code</span\n        ></label\n      >\n      <label class=\"questionnaire-choice\"\n        ><input type=\"checkbox\" name=\"interests\" value=\"data\" /><span class=\"questionnaire-choice-label\"\n          >Data</span\n        ></label\n      >\n      <label class=\"questionnaire-choice\"\n        ><input type=\"checkbox\" name=\"interests\" value=\"writing\" /><span class=\"questionnaire-choice-label\"\n          >Writing</span\n        ></label\n      >\n    </div>\n  </fieldset>\n  <fieldset class=\"questionnaire-step\" data-step=\"done\" data-end>\n    <legend class=\"questionnaire-title\">All set?</legend>\n    <div class=\"questionnaire-summary\"></div>\n  </fieldset>\n  <div class=\"questionnaire-actions\">\n    <button class=\"btn\" data-variant=\"ghost\" type=\"button\" data-questionnaire=\"back\">Back</button>\n    <button class=\"btn\" type=\"submit\" data-questionnaire=\"next\">Continue</button>\n    <button class=\"btn\" type=\"submit\" data-questionnaire=\"submit\">Create account</button>\n  </div>\n  <div class=\"questionnaire-complete\"><p>Welcome aboard.</p></div>\n</form>\n","individual":false},{"label":"Event booking","html":"<form class=\"questionnaire\" id=\"q-event\" aria-label=\"Book an event\" data-persist=\"none\" style=\"max-width: 32rem\">\n  <div class=\"questionnaire-progress\"></div>\n  <fieldset class=\"questionnaire-step\" data-step=\"dates\">\n    <legend class=\"questionnaire-title\">When?</legend>\n    <div class=\"questionnaire-field\"\n      ><label class=\"label\" for=\"q-from\">From</label><input class=\"input\" id=\"q-from\" name=\"from\" type=\"date\" required\n    /></div>\n    <div class=\"questionnaire-field\"\n      ><label class=\"label\" for=\"q-to\">To</label><input class=\"input\" id=\"q-to\" name=\"to\" type=\"date\" required\n    /></div>\n  </fieldset>\n  <fieldset class=\"questionnaire-step\" data-step=\"venue\">\n    <legend class=\"questionnaire-title\">Which room?</legend>\n    <select class=\"select\" name=\"capacity\" required aria-label=\"Room\">\n      <option value=\"\">Choose…</option>\n      <option value=\"12\">Library (12 people)</option>\n      <option value=\"40\">Studio (40 people)</option>\n      <option value=\"120\">Hall (120 people)</option>\n    </select>\n  </fieldset>\n  <fieldset class=\"questionnaire-step\" data-step=\"guests\">\n    <legend class=\"questionnaire-title\">How many guests?</legend>\n    <input class=\"input\" name=\"guests\" type=\"number\" min=\"1\" required aria-label=\"Guests\" style=\"max-width: 8rem\" />\n  </fieldset>\n  <fieldset class=\"questionnaire-step\" data-step=\"ok\" data-end>\n    <legend class=\"questionnaire-title\">Book it?</legend>\n    <div class=\"questionnaire-summary\"></div>\n  </fieldset>\n  <div class=\"questionnaire-actions\">\n    <button class=\"btn\" data-variant=\"ghost\" type=\"button\" data-questionnaire=\"back\">Back</button>\n    <button class=\"btn\" type=\"submit\" data-questionnaire=\"next\">Continue</button>\n    <button class=\"btn\" type=\"submit\" data-questionnaire=\"submit\">Book</button>\n  </div>\n  <div class=\"questionnaire-complete\"><p>Booked.</p></div>\n  \n</form>\n","individual":false},{"label":"Password","html":"<form class=\"questionnaire\" id=\"q-password\" aria-label=\"Choose a password\" data-persist=\"none\" style=\"max-width: 30rem\">\n  <fieldset class=\"questionnaire-step\" data-step=\"password\">\n    <legend class=\"questionnaire-title\">Choose a password</legend>\n    <input\n      class=\"input\"\n      name=\"password\"\n      type=\"password\"\n      required\n      minlength=\"8\"\n      aria-label=\"Password\"\n      autocomplete=\"new-password\"\n    />\n  </fieldset>\n  <fieldset class=\"questionnaire-step\" data-step=\"confirm\">\n    <legend class=\"questionnaire-title\">Once more</legend>\n    <input\n      class=\"input\"\n      name=\"confirm\"\n      type=\"password\"\n      required\n      aria-label=\"Repeat the password\"\n      autocomplete=\"new-password\"\n    />\n  </fieldset>\n  <fieldset class=\"questionnaire-step\" data-step=\"done\" data-end>\n    <legend class=\"questionnaire-title\">Save it?</legend>\n  </fieldset>\n  <div class=\"questionnaire-actions\">\n    <button class=\"btn\" data-variant=\"ghost\" type=\"button\" data-questionnaire=\"back\">Back</button>\n    <button class=\"btn\" type=\"submit\" data-questionnaire=\"next\">Continue</button>\n    <button class=\"btn\" type=\"submit\" data-questionnaire=\"submit\">Save</button>\n  </div>\n  <div class=\"questionnaire-complete\"><p>Password saved.</p></div>\n</form>\n","individual":false}]
