[{"label":"Academic Monograph","html":"<section\n  class=\"presentation\"\n  id=\"deck-boxplot\"\n  data-anim-in=\"fadeIn\"\n  data-anim-out=\"slideOut\"\n  data-anim-out-direction=\"north\"\n  data-anim-out-distance=\"40px\"\n  style=\"\n    --presentation-ink: #202428;\n    --presentation-ink-foreground: #f7f7f4;\n    --presentation-paper: #f7f7f4;\n    --presentation-paper-foreground: #202428;\n    --presentation-accent: #5e1b28;\n    font-family: Georgia, 'Times New Roman', serif;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"Reading at nine - a study of five teaching methods\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Reading scores of 1,400 nine-year-olds under five teaching methods as boxplots: tutoring plus phonics has the highest median of 72, the self-paced app the widest spread; then means, interquartile ranges and learning gains\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Cover\">\n    <div\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        right: 112px;\n        top: 180px;\n        width: 440px;\n        padding: 2rem 2.25rem;\n        border: 1px solid currentColor;\n        font:\n          italic 1.5rem/1.5 Georgia,\n          serif;\n        opacity: 0.75;\n      \"\n    >\n      <p\n        style=\"\n          margin: 0 0 1rem;\n          font-style: normal;\n          letter-spacing: 0.14em;\n          text-transform: uppercase;\n          font-size: 1.1rem;\n        \"\n        >Plate IV</p\n      >\n      Distribution of reading scores, pupils aged nine, by method of instruction. N = 1,400.\n    </div>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\">Boxplot · Academic Monograph</p>\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        position: relative;\n        max-width: 1250px;\n        font-family: Georgia, 'Times New Roman', serif;\n        font-weight: 400;\n        letter-spacing: -0.01em;\n        font-size: 6.5rem;\n      \"\n      >Reading at nine</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >Five ways to teach reading, 1,400 pupils, one district - the spread before the average.</p\n    >\n    <p class=\"presentation-note\">Monograph tone: patient, precise.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"box\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Distributions\"\n  >\n    <header class=\"presentation-header\"><span>Chapter 2 · Results</span><span>Reading score, 0–100</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Georgia, 'Times New Roman', serif;\n        font-weight: 400;\n        letter-spacing: -0.01em;\n      \"\n      >Five methods, five distributions</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Box = middle half, line = median, whiskers = range. Spread before average.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"means\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Means\"\n  >\n    <header class=\"presentation-header\"><span>Chapter 2 · Results</span><span>Mean score</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Georgia, 'Times New Roman', serif;\n        font-weight: 400;\n        letter-spacing: -0.01em;\n      \"\n      >Tutoring with phonics leads on average: 71.3</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The boxes collapse into their means - and the spread disappears.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"iqr\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Spread\"\n  >\n    <header class=\"presentation-header\"\n      ><span>Chapter 3 · Variation</span><span>Interquartile range, points</span></header\n    >\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Georgia, 'Times New Roman', serif;\n        font-weight: 400;\n        letter-spacing: -0.01em;\n      \"\n      >The app has the widest spread: 31 points</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The same methods, now measured by how uneven they are.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Principal findings</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #5e1b28;\n            font-family: Georgia, 'Times New Roman', serif;\n            font-weight: 400;\n            letter-spacing: -0.01em;\n          \"\n          ><span data-count=\"72\">72</span></p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">median score, tutoring + phonics</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: Georgia, 'Times New Roman', serif;\n            font-weight: 400;\n            letter-spacing: -0.01em;\n          \"\n          ><span data-count=\"31\">31</span></p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\"\n          >points between the app’s quartiles - the widest</p\n        >\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: Georgia, 'Times New Roman', serif;\n            font-weight: 400;\n            letter-spacing: -0.01em;\n          \"\n          ><span data-count=\"1400\">1400</span></p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">pupils in the study</p>\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >The app lifts some children to the top - and leaves others further behind than any other method.</p\n    >\n    <p class=\"presentation-note\">Equity is the finding, not the ranking.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"The book\">\n    <header class=\"presentation-header\"><span>Chapter 1 · Method</span><span>Assessment</span></header>\n    <div style=\"display: flex; gap: 4.5rem; align-items: center; margin-top: 3.5rem\">\n      <figure\n        class=\"image\"\n        data-ratio=\"4/3\"\n        data-df-entrance=\"fade\"\n        style=\"--df-motion-delay: 150ms; flex: 0 0 700px; margin: 0\"\n      >\n        <img\n          src=\"https://picsum.photos/id/24/960/720\"\n          alt=\"An open book lying on a table, its pages curving upward, in soft light\"\n          loading=\"lazy\"\n          width=\"960\"\n          height=\"720\"\n          style=\"width: 100%; height: 100%; object-fit: cover\"\n        />\n        <figcaption class=\"image-caption\" style=\"font-size: 1.25rem\">The assessment passage (stock photo).</figcaption>\n      </figure>\n      <div style=\"flex: 1 1 0; min-width: 0\">\n        <h2\n          class=\"presentation-title\"\n          data-df-entrance=\"up\"\n          style=\"\n            font-size: 3.4rem;\n            font-family: Georgia, 'Times New Roman', serif;\n            font-weight: 400;\n            letter-spacing: -0.01em;\n          \"\n          >One book, one reading test, every pupil</h2\n        >\n        <p class=\"presentation-lede\" data-df-entrance=\"fade\" style=\"--df-motion-delay: 300ms; font-size: 1.7rem\"\n          >All 1,400 pupils read the same unseen passage in June; scores combine accuracy, fluency and comprehension.</p\n        >\n      </div>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Method before results - the academic order.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"north\"\n    data-anim-in-blocks=\"4\"\n    data-anim-in-color=\"#5E1B28\"\n    aria-label=\"Summary table\"\n  >\n    <header class=\"presentation-header\"><span>Table 2</span><span>Five-number summaries</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" data-density=\"spacious\" style=\"font-size: 1.7rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Reading scores by method: min, quartiles, max, mean and n (fictional study).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Method</th><th class=\"table-head\" style=\"text-align: right\">Min</th\n            ><th class=\"table-head\" style=\"text-align: right\">Q1</th\n            ><th class=\"table-head\" style=\"text-align: right\">Median</th\n            ><th class=\"table-head\" style=\"text-align: right\">Q3</th\n            ><th class=\"table-head\" style=\"text-align: right\">Max</th\n            ><th class=\"table-head\" style=\"text-align: right\">Mean</th\n            ><th class=\"table-head\" style=\"text-align: right\">n</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Tutoring + phonics</td><td class=\"table-cell\" style=\"text-align: right\">49</td\n            ><td class=\"table-cell\" style=\"text-align: right\">64</td\n            ><td class=\"table-cell\" style=\"text-align: right\">72</td\n            ><td class=\"table-cell\" style=\"text-align: right\">79</td\n            ><td class=\"table-cell\" style=\"text-align: right\">95</td\n            ><td class=\"table-cell\" style=\"text-align: right\">71.3</td\n            ><td class=\"table-cell\" style=\"text-align: right\">118</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Phonics</td><td class=\"table-cell\" style=\"text-align: right\">41</td\n            ><td class=\"table-cell\" style=\"text-align: right\">58</td\n            ><td class=\"table-cell\" style=\"text-align: right\">66</td\n            ><td class=\"table-cell\" style=\"text-align: right\">74</td\n            ><td class=\"table-cell\" style=\"text-align: right\">92</td\n            ><td class=\"table-cell\" style=\"text-align: right\">65.8</td\n            ><td class=\"table-cell\" style=\"text-align: right\">412</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Mixed</td><td class=\"table-cell\" style=\"text-align: right\">38</td\n            ><td class=\"table-cell\" style=\"text-align: right\">54</td\n            ><td class=\"table-cell\" style=\"text-align: right\">63</td\n            ><td class=\"table-cell\" style=\"text-align: right\">71</td\n            ><td class=\"table-cell\" style=\"text-align: right\">90</td\n            ><td class=\"table-cell\" style=\"text-align: right\">62.6</td\n            ><td class=\"table-cell\" style=\"text-align: right\">398</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Self-paced app</td><td class=\"table-cell\" style=\"text-align: right\">22</td\n            ><td class=\"table-cell\" style=\"text-align: right\">45</td\n            ><td class=\"table-cell\" style=\"text-align: right\">61</td\n            ><td class=\"table-cell\" style=\"text-align: right\">76</td\n            ><td class=\"table-cell\" style=\"text-align: right\">97</td\n            ><td class=\"table-cell\" style=\"text-align: right\">60.2</td\n            ><td class=\"table-cell\" style=\"text-align: right\">267</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Whole language</td><td class=\"table-cell\" style=\"text-align: right\">30</td\n            ><td class=\"table-cell\" style=\"text-align: right\">47</td\n            ><td class=\"table-cell\" style=\"text-align: right\">57</td\n            ><td class=\"table-cell\" style=\"text-align: right\">66</td\n            ><td class=\"table-cell\" style=\"text-align: right\">88</td\n            ><td class=\"table-cell\" style=\"text-align: right\">56.4</td\n            ><td class=\"table-cell\" style=\"text-align: right\">205</td></tr\n          >\n        </tbody>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">n differs - the tutoring group is the smallest.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"\n          font-size: 3.3rem;\n          line-height: 1.22;\n          font-family: Georgia, 'Times New Roman', serif;\n          font-weight: 400;\n          letter-spacing: -0.01em;\n          font-size: 3rem;\n        \"\n        >“An average told us the app works. The boxplot told us for whom - and that was a different answer.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #5e1b28; color: #f7f7f4\"\n        ><span class=\"avatar-fallback\">EH</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Prof. Elena Hart<br /><span style=\"opacity: 0.7; font-size: 1.4rem\">Lead author - fictional study</span></p\n      >\n    </div>\n    <p class=\"presentation-note\">The methodological point in one sentence.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"gain\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Gains\"\n  >\n    <header class=\"presentation-header\"\n      ><span>Chapter 4 · Progress</span><span>Mean gain over the school year, points</span></header\n    >\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Georgia, 'Times New Roman', serif;\n        font-weight: 400;\n        letter-spacing: -0.01em;\n      \"\n      >Tutoring also added the most over the year</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">From levels to progress - September to June.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Reviewer questions\"\n  >\n    <header class=\"presentation-header\"><span>Discussion</span><span>Peer review</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.2rem;\n        margin-block: 5.25rem 1.5rem;\n        font-family: Georgia, 'Times New Roman', serif;\n        font-weight: 400;\n        letter-spacing: -0.01em;\n      \"\n      >Questions from the reviewers</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"bx-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Were pupils assigned at random?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >No - methods were chosen by schools; results adjust for prior attainment but are not causal.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"bx-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Is the tutoring group comparable?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >It is small (n = 118) and more urban; the gain difference stays significant after adjustment.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"bx-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Why is the app so uneven?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Children who used it more than 40 minutes a week scored 19 points higher than light users.</p\n          ></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The random-assignment question must be answered first.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Chapter 5 · Conclusions</span><span>Four findings</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">¶</span\n        ><span>Show spread before quoting an average.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">¶</span\n        ><span>Tutoring with phonics raised both level and progress.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">¶</span\n        ><span>The app’s wide box is an equity warning, not a success story.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">¶</span\n        ><span>Whole-language classes trailed on every measure.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Conclusions as in the monograph.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"south\"\n    data-anim-in-blocks=\"4\"\n    data-anim-in-color=\"#5E1B28\"\n    aria-label=\"Closing\"\n  >\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        font-family: Georgia, 'Times New Roman', serif;\n        font-weight: 400;\n        letter-spacing: -0.01em;\n      \"\n      >Spread first, average second</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px\"\n      >A fictional study with synthetic scores - the boxplot discipline is the real lesson.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">Close the volume.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 12</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"12\" value=\"1\"></progress>\n</section>\n","individual":false}]
