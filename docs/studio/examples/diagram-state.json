\" data-variant=\"outline\" data-size=\"sm\" data-panel-toggle=\"dg-state-edit-panel\"\n    ><i data-lucide=\"panel-right\"></i> Inspector</button\n  >\n  <span class=\"text-sm text-muted-foreground\">Click a box or an arrow, then edit it.</span>\n</div>\n<div class=\"flex flex-col gap-3\">\n  <div style=\"flex: 1 1 0; min-width: 0\">\n    <figure class=\"diagram\" id=\"dg-state-edit\" data-interactive data-type=\"state\" aria-label=\"Order state machine\">\n      <figcaption class=\"diagram-caption\">\n        <span class=\"diagram-eyebrow\">State machine</span>\n        <span class=\"diagram-title\">An order, from cart to delivery</span>\n      </figcaption>\n      <div\n        class=\"diagram-canvas\"\n        style=\"\n          --cols: 5;\n          grid-template-columns: 2.5rem repeat(4, minmax(7.5rem, 1fr));\n          --diagram-node-w: 8rem;\n          --diagram-gap-x: 3.25rem;\n        \"\n      >\n        <div class=\"diagram-node\" data-node=\"s0\" data-shape=\"start\" style=\"--col: 1; --row: 1\"\n          ><span class=\"diagram-node-name\">new</span></div\n        >\n        <div class=\"diagram-node\" data-node=\"cart\" style=\"--col: 2; --row: 1\"\n          ><span class=\"diagram-node-name\">Cart</span></div\n        >\n        <div class=\"diagram-node\" data-node=\"paid\" style=\"--col: 3; --row: 1\"\n          ><span class=\"diagram-node-name\">Paid</span></div\n        >\n        <div class=\"diagram-node\" data-node=\"shipped\" style=\"--col: 4; --row: 1\"\n          ><span class=\"diagram-node-name\">Shipped</span></div\n        >\n        <div class=\"diagram-node\" data-node=\"delivered\" data-tone=\"accent\" style=\"--col: 5; --row: 1\"\n          ><span class=\"diagram-node-name\">Delivered</span></div\n        >\n        <div class=\"diagram-node\" data-node=\"cancel\" data-tone=\"muted\" style=\"--col: 3; --row: 2\"\n          ><span class=\"diagram-node-name\">Cancelled</span></div\n        >\n        <div class=\"diagram-node\" data-node=\"returned\" style=\"--col: 4; --row: 2\"\n          ><span class=\"diagram-node-name\">Returned</span></div\n        >\n        <div class=\"diagram-node\" data-node=\"s1\" data-shape=\"end\" style=\"--col: 5; --row: 2\"\n          ><span class=\"diagram-node-name\">closed</span></div\n        >\n      </div>\n      <ol class=\"diagram-edges\">\n        <li class=\"diagram-edge\" data-from=\"s0\" data-to=\"cart\"></li>\n        <li class=\"diagram-edge\" data-from=\"cart\" data-to=\"paid\">checkout</li>\n        <li class=\"diagram-edge\" data-from=\"cart\" data-to=\"cart\">add item</li>\n        <li class=\"diagram-edge\" data-from=\"paid\" data-to=\"shipped\">dispatch</li>\n        <li class=\"diagram-edge\" data-from=\"shipped\" data-to=\"delivered\">scan</li>\n        <li class=\"diagram-edge\" data-from=\"paid\" data-to=\"cancel\">cancel / refund</li>\n        <li class=\"diagram-edge\" data-from=\"delivered\" data-to=\"returned\">return ≤ 30d</li>\n        <li class=\"diagram-edge\" data-from=\"delivered\" data-to=\"s1\"></li>\n        <li class=\"diagram-edge\" data-from=\"returned\" data-to=\"s1\">refund</li>\n      </ol>\n    </figure>\n  </div>\n  <section class=\"card panel\" id=\"dg-state-edit-panel\" aria-labelledby=\"dg-state-edit-title\" style=\"\">\n    <header class=\"panel-header\">\n      <i data-lucide=\"sliders-horizontal\" class=\"panel-icon\" aria-hidden=\"true\"></i>\n      <h3 class=\"panel-title\" id=\"dg-state-edit-title\">Inspector</h3>\n      <div class=\"panel-tools\">\n        <button\n          type=\"button\"\n          class=\"btn panel-close\"\n          data-variant=\"ghost\"\n          data-size=\"icon-sm\"\n          aria-label=\"Close Inspector\"\n          ><i data-lucide=\"x\"></i\n        ></button>\n      </div>\n    </header>\n    <div class=\"panel-body\" data-flush>\n      <div\n        class=\"property-grid\"\n        id=\"dg-state-edit-grid\"\n        data-frame=\"none\"\n        data-empty-text=\"Click a box or a