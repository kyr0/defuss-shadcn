[{"label":"Fashion Editorial","html":"<section\n  class=\"presentation\"\n  id=\"deck-violin\"\n  data-anim-in=\"irisIn\"\n  data-anim-out=\"fadeOut\"\n  style=\"\n    --presentation-ink: #171312;\n    --presentation-ink-foreground: #f8f4f0;\n    --presentation-paper: #f8f4f0;\n    --presentation-paper-foreground: #171312;\n    --presentation-accent: #b92a4a;\n    font-family: Didot, 'Bodoni MT', Georgia, serif;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"The resale premium - sneakers above retail\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Distribution of resale premiums over retail price for 2,500 sneaker sales in five categories drawn as violins: collaborations have a median premium of 96 percent with a long upper tail; then medians and resale volume\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Cover\">\n    <svg\n      aria-hidden=\"true\"\n      width=\"420\"\n      height=\"760\"\n      viewBox=\"0 0 420 760\"\n      style=\"position: absolute; right: 170px; top: 70px\"\n    >\n      <path\n        d=\"M210 20 C 150 140 120 220 170 300 C 230 390 60 470 90 560 C 120 650 190 700 210 740 C 230 700 300 650 330 560 C 360 470 190 390 250 300 C 300 220 270 140 210 20 Z\"\n        fill=\"#B92A4A\"\n      />\n      <line x1=\"210\" y1=\"0\" x2=\"210\" y2=\"760\" stroke=\"currentColor\" stroke-width=\"2\" opacity=\"0.4\" />\n    </svg>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\">Violin · Fashion Editorial</p>\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        position: relative;\n        max-width: 1250px;\n        font-family: Didot, 'Bodoni MT', Georgia, serif;\n        font-weight: 400;\n        letter-spacing: -0.02em;\n        font-size: 7rem;\n        max-width: 900px;\n      \"\n      >The resale premium</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >2,500 sneaker resales, five categories - and the shape of what people pay above retail.</p\n    >\n    <p class=\"presentation-note\">The red silhouette is the first violin.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"violins\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Distributions\"\n  >\n    <header class=\"presentation-header\"\n      ><span>The market</span><span>Premium over retail, % · 500 sales each</span></header\n    >\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Didot, 'Bodoni MT', Georgia, serif;\n        font-weight: 400;\n        letter-spacing: -0.02em;\n      \"\n      >Five categories, five silhouettes</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Width = how many sales sit at that premium. Shape before summary.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"collabs\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Collaborations\"\n  >\n    <header class=\"presentation-header\"><span>The market</span><span>Collaborations highlighted</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Didot, 'Bodoni MT', Georgia, serif;\n        font-weight: 400;\n        letter-spacing: -0.02em;\n      \"\n      >Collaborations: a long neck of +200% resales</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">One silhouette in red - the others step back.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"medians\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Medians\"\n  >\n    <header class=\"presentation-header\"><span>The summary</span><span>Median premium</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Didot, 'Bodoni MT', Georgia, serif;\n        font-weight: 400;\n        letter-spacing: -0.02em;\n      \"\n      >The median says +96% - the violin says “it depends”</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Each shape shrinks to one number.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">In numbers</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #b92a4a;\n            font-family: Didot, 'Bodoni MT', Georgia, serif;\n            font-weight: 400;\n            letter-spacing: -0.02em;\n          \"\n          >+<span data-count=\"96\">96</span>%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">median premium for collaborations</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: Didot, 'Bodoni MT', Georgia, serif;\n            font-weight: 400;\n            letter-spacing: -0.02em;\n          \"\n          >+<span data-count=\"8\">8</span>%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">median premium for runners</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: Didot, 'Bodoni MT', Georgia, serif;\n            font-weight: 400;\n            letter-spacing: -0.02em;\n          \"\n          ><span data-count=\"18\">18</span>%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\"\n          >of collaboration resales above +200%</p\n        >\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >Most pairs resell near retail. A few resell like art.</p\n    >\n    <p class=\"presentation-note\">The art line is the quote-able one.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Worn\">\n    <header class=\"presentation-header\"><span>Worn, not kept</span><span>Runners</span></header>\n    <div style=\"display: flex; gap: 4.5rem; align-items: center; margin-top: 3.5rem\">\n      <figure\n        class=\"image\"\n        data-ratio=\"4/3\"\n        data-df-entrance=\"iris\"\n        style=\"--df-motion-delay: 150ms; flex: 0 0 700px; margin: 0\"\n      >\n        <img\n          src=\"https://picsum.photos/id/103/960/720\"\n          alt=\"A person’s legs in sneakers stretched out on a sunlit field\"\n          loading=\"lazy\"\n          width=\"960\"\n          height=\"720\"\n          style=\"width: 100%; height: 100%; object-fit: cover\"\n        />\n        <figcaption class=\"image-caption\" style=\"font-size: 1.25rem\">Worn on a Sunday (stock photo).</figcaption>\n      </figure>\n      <div style=\"flex: 1 1 0; min-width: 0\">\n        <h2\n          class=\"presentation-title\"\n          data-df-entrance=\"up\"\n          style=\"\n            font-size: 3.4rem;\n            font-family: Didot, 'Bodoni MT', Georgia, serif;\n            font-weight: 400;\n            letter-spacing: -0.02em;\n          \"\n          >Runners are bought to run</h2\n        >\n        <p class=\"presentation-lede\" data-df-entrance=\"fade\" style=\"--df-motion-delay: 300ms; font-size: 1.7rem\"\n          >71% of runner resales are worn pairs - the premium is thin because the shoes are used.</p\n        >\n      </div>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The other end of the market.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"east\"\n    data-anim-in-blocks=\"5\"\n    data-anim-in-color=\"#B92A4A\"\n    aria-label=\"Premium table\"\n  >\n    <header class=\"presentation-header\"><span>The ledger</span><span>Premium over retail</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" data-density=\"spacious\" style=\"font-size: 1.7rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Resale premium by category, 500 sales each (synthetic).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Category</th><th class=\"table-head\" style=\"text-align: right\">Median</th\n            ><th class=\"table-head\" style=\"text-align: right\">Middle half</th\n            ><th class=\"table-head\" style=\"text-align: right\">Share of resales</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\" style=\"font-weight: 700\"\n            ><td class=\"table-cell\">Collaborations</td><td class=\"table-cell\" style=\"text-align: right\">+96%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+48% – +168%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">22%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Retro</td><td class=\"table-cell\" style=\"text-align: right\">+31%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+12% – +55%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">26%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Basketball</td><td class=\"table-cell\" style=\"text-align: right\">+22%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+6% – +41%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">24%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Skate</td><td class=\"table-cell\" style=\"text-align: right\">+14%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+2% – +29%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">11%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Runners</td><td class=\"table-cell\" style=\"text-align: right\">+8%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">−6% – +21%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">17%</td></tr\n          >\n        </tbody>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Runners sometimes resell below retail - the only category that does.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"\n          font-size: 3.3rem;\n          line-height: 1.22;\n          font-family: Didot, 'Bodoni MT', Georgia, serif;\n          font-weight: 400;\n          letter-spacing: -0.02em;\n          font-size: 3rem;\n        \"\n        >“A collaboration is not a shoe. It is a ticket to a moment - and the price follows the moment, not the\n        leather.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #b92a4a; color: #f8f4f0\"\n        ><span class=\"avatar-fallback\">CV</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Camille Vautrin<br /><span style=\"opacity: 0.7; font-size: 1.4rem\">Resale market editor - fictional</span></p\n      >\n    </div>\n    <p class=\"presentation-note\">Editorial voice.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"volume\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Resale volume\"\n  >\n    <header class=\"presentation-header\"><span>The volume</span><span>Share of all resales</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Didot, 'Bodoni MT', Georgia, serif;\n        font-weight: 400;\n        letter-spacing: -0.02em;\n      \"\n      >Retro and basketball move the most pairs</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The premium story is the collaborations; the volume story is not.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Reader questions\"\n  >\n    <header class=\"presentation-header\"><span>Letters</span><span>Readers ask</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.2rem;\n        margin-block: 5.25rem 1.5rem;\n        font-family: Didot, 'Bodoni MT', Georgia, serif;\n        font-weight: 400;\n        letter-spacing: -0.02em;\n      \"\n      >Letters to the editor</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"vi-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Why violins instead of boxplots?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Collaborations have two peaks - early drops and later hype - a box would hide both.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"vi-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Are fees included?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >No: premiums compare the sale price with retail, before platform fees of 8–12%.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"vi-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Is the premium falling?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >For retro, yes - down 9 points on last year as re-releases increased supply.</p\n          ></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The two-peaks answer justifies the chart.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>The edit</span><span>Four notes</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">—</span\n        ><span>Draw the distribution when the shape is the story.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">—</span\n        ><span>Collaborations are a separate market, not a bigger version of the same one.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">—</span\n        ><span>Runners resell near - sometimes below - retail.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">—</span\n        ><span>Supply, not taste, is cooling the retro premium.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The edit, four lines.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"west\"\n    data-anim-in-blocks=\"5\"\n    data-anim-in-color=\"#B92A4A\"\n    aria-label=\"Closing\"\n  >\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        font-family: Didot, 'Bodoni MT', Georgia, serif;\n        font-weight: 400;\n        letter-spacing: -0.02em;\n        font-size: 6rem;\n      \"\n      >Shape before summary</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px\"\n      >Synthetic resales - the custom-series violin is the real technique.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">Fade to ivory.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 12</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"12\" value=\"1\"></progress>\n</section>\n","individual":false}]
