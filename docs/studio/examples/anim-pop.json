[{"label":"In / out and lifecycle","html":"<style>\n  #anim-pop-target {\n    width: 160px;\n    height: 100px;\n    display: grid;\n    place-items: center;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    background: var(--card);\n    color: var(--card-foreground);\n    font-weight: 600;\n  }\n</style>\n<div style=\"display: flex; flex-direction: column; align-items: flex-start; gap: 1rem\">\n  <div id=\"anim-pop-target\">pop</div>\n  <div style=\"display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-pop-in\">In</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-pop-out\">Out</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-pop-pause\">Pause</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-pop-resume\">Resume</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-pop-finish\">Finish</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-pop-reset\">Reset</button>\n  </div>\n  <div style=\"display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem\">\n    <label class=\"label\" for=\"anim-pop-duration\">Duration (ms)</label>\n    <input class=\"input\" type=\"number\" id=\"anim-pop-duration\" value=\"1500\" min=\"50\" step=\"50\" style=\"width: 6rem\" />\n    <label class=\"label\" for=\"anim-pop-easing\">Easing</label>\n    <select class=\"select\" id=\"anim-pop-easing\">\n      <option value=\"cubic-bezier(0.16, 1, 0.3, 1)\" selected>cubic-bezier(0.16, 1, 0.3, 1) - default</option>\n      <option value=\"ease\">ease</option>\n      <option value=\"ease-in-out\">ease-in-out</option>\n      <option value=\"linear\">linear</option>\n      <option value=\"cubic-bezier(.34, 1.56, .64, 1)\">cubic-bezier(.34, 1.56, .64, 1) - extra springy</option>\n    </select>\n  </div>\n</div>\n","individual":false},{"label":"Scroll binding (parallax)","html":"<div\n  id=\"anim-pop-scroller\"\n  style=\"\n    height: 220px;\n    overflow-y: auto;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    padding: 1rem;\n  \"\n>\n  <div\n    style=\"height: 600px; display: flex; flex-direction: column; align-items: center; justify-content: space-between\"\n  >\n    <span class=\"text-sm text-muted-foreground\">Scroll down - the scroll position pops the card in ↓</span>\n    <div\n      id=\"anim-pop-scroll-target\"\n      style=\"\n        width: 160px;\n        height: 100px;\n        display: grid;\n        place-items: center;\n        border: 1px solid var(--border);\n        border-radius: var(--radius-lg);\n        background: var(--card);\n        color: var(--card-foreground);\n        font-weight: 600;\n      \"\n      >pop</div\n    >\n    <span class=\"text-sm text-muted-foreground\">↑ fully popped at the bottom</span>\n  </div>\n</div>\n","individual":false}]
