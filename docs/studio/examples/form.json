[{"label":"Default","html":"<form class=\"form\">\n  <div class=\"form-field\">\n    <label class=\"label\" for=\"name\">Username</label>\n    <input class=\"input\" type=\"text\" id=\"name\" required aria-describedby=\"name-desc\" />\n    <p class=\"field-description\" id=\"name-desc\">This is your public display name.</p>\n  </div>\n  <div class=\"form-field\">\n    <label class=\"label\" for=\"email\">Email</label>\n    <input class=\"input\" type=\"email\" id=\"email\" required aria-describedby=\"email-desc\" />\n    <p class=\"field-description\" id=\"email-desc\">You can manage email addresses in your settings.</p>\n  </div>\n  <div class=\"form-field\">\n    <label class=\"label\" for=\"bio\">Bio</label>\n    <textarea class=\"textarea\" id=\"bio\" aria-describedby=\"bio-desc\"></textarea>\n    <p class=\"field-description\" id=\"bio-desc\">You can @mention other users and organizations.</p>\n  </div>\n  <div class=\"form-actions\">\n    <button class=\"btn\" type=\"submit\" data-variant=\"default\">Submit</button>\n    <button class=\"btn\" type=\"reset\" data-variant=\"outline\">Reset</button>\n  </div>\n</form>\n","individual":true},{"label":"Consistent field heights","html":"<form class=\"form w-full\" style=\"max-width: 46rem\" onsubmit=\"return false;\">\n  <div class=\"grid grid-cols-4 gap-4\">\n    <div class=\"form-field\">\n      <label class=\"label\" for=\"fh-1a\">Text</label>\n      <input class=\"input\" type=\"text\" id=\"fh-1a\" placeholder=\"Name\" />\n    </div>\n    <div class=\"form-field\">\n      <label class=\"label\" for=\"fh-1b\">Select</label>\n      <select class=\"select\" id=\"fh-1b\"\n        ><option>Option A</option\n        ><option>Option B</option></select\n      >\n    </div>\n    <div class=\"form-field\">\n      <label class=\"label\" for=\"fh-1c\">Number</label>\n      <div class=\"number-input w-full\"\n        ><button type=\"button\" data-action=\"decrement\" aria-label=\"Decrease\">−</button\n        ><input type=\"number\" id=\"fh-1c\" value=\"1\" min=\"0\" max=\"99\" step=\"1\" /><button\n          type=\"button\"\n          data-action=\"increment\"\n          aria-label=\"Increase\"\n          >+</button\n        ></div\n      >\n    </div>\n    <div class=\"form-field\">\n      <label class=\"label\" id=\"fh-1d-label\">Combobox</label>\n      <div class=\"combobox\">\n        <button\n          class=\"btn combobox-trigger\"\n          type=\"button\"\n          data-variant=\"outline\"\n          aria-haspopup=\"listbox\"\n          aria-expanded=\"false\"\n          aria-labelledby=\"fh-1d-label\"\n          aria-controls=\"fh-1d-popover\"\n        >\n          <span class=\"combobox-value\" data-placeholder=\"Pick…\">Pick…</span>\n          <svg\n            class=\"combobox-chevron\"\n            aria-hidden=\"true\"\n            width=\"16\"\n            height=\"16\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m7 15 5 5 5-5\"></path>\n            <path d=\"m7 9 5-5 5 5\"></path>\n          </svg>\n        </button>\n        <div id=\"fh-1d-popover\" class=\"combobox-content\" popover>\n          <div class=\"combobox-listbox\" role=\"listbox\" aria-label=\"Height demo options\">\n            <div role=\"option\" class=\"combobox-item\" data-value=\"a\" aria-selected=\"false\">Option A</div>\n            <div role=\"option\" class=\"combobox-item\" data-value=\"b\" aria-selected=\"false\">Option B</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n  <div class=\"grid grid-cols-4 gap-4\">\n    <div class=\"form-field\">\n      <label class=\"label\" for=\"fh-2a\">Date</label>\n      <input class=\"input date-input\" type=\"date\" id=\"fh-2a\" />\n    </div>\n    <div class=\"form-field\">\n      <label class=\"label\" for=\"fh-2b\">Color</label>\n      <div class=\"color-picker w-full\"\n        ><input type=\"color\" id=\"fh-2b\" value=\"#3b82f6\" /><span class=\"color-picker-value\">#3B82F6</span></div\n      >\n    </div>\n    <div class=\"form-field\">\n      <label class=\"label\" for=\"fh-2c\">File</label>\n      <input class=\"file-input\" type=\"file\" id=\"fh-2c\" />\n    </div>\n    <div class=\"form-field\">\n      <label class=\"label\" for=\"fh-2d\">Reference</label>\n      <input class=\"input\" type=\"text\" id=\"fh-2d\" placeholder=\"Input\" />\n    </div>\n  </div>\n  <div class=\"grid grid-cols-4 gap-4\">\n    <div class=\"form-field\">\n      <label class=\"label\" for=\"fh-3a\">Text <code>xs</code></label>\n      <input class=\"input\" type=\"text\" id=\"fh-3a\" data-size=\"xs\" />\n    </div>\n    <div class=\"form-field\">\n      <label class=\"label\" for=\"fh-3b\">Select <code>xs</code></label>\n      <select class=\"select\" id=\"fh-3b\" data-size=\"xs\"\n        ><option>A</option></select\n      >\n    </div>\n    <div class=\"form-field\">\n      <label class=\"label\" for=\"fh-3c\">Number <code>xs</code></label>\n      <div class=\"number-input w-full\" data-size=\"xs\"\n        ><button type=\"button\" data-action=\"decrement\" aria-label=\"Decrease\">−</button\n        ><input type=\"number\" id=\"fh-3c\" value=\"1\" min=\"0\" max=\"99\" step=\"1\" /><button\n          type=\"button\"\n          data-action=\"increment\"\n          aria-label=\"Increase\"\n          >+</button\n        ></div\n      >\n    </div>\n    <div class=\"form-field\">\n      <label class=\"label\" for=\"fh-3d\">Date <code>xs</code></label>\n      <input class=\"input date-input\" type=\"date\" id=\"fh-3d\" data-size=\"xs\" />\n    </div>\n  </div>\n  <div class=\"grid grid-cols-4 gap-4\">\n    <div class=\"form-field\">\n      <label class=\"label\" for=\"fh-4a\">Text <code>lg</code></label>\n      <input class=\"input\" type=\"text\" id=\"fh-4a\" data-size=\"lg\" />\n    </div>\n    <div class=\"form-field\">\n      <label class=\"label\" for=\"fh-4b\">Select <code>lg</code></label>\n      <select class=\"select\" id=\"fh-4b\" data-size=\"lg\"\n        ><option>A</option></select\n      >\n    </div>\n    <div class=\"form-field\">\n      <label class=\"label\" for=\"fh-4c\">Number <code>lg</code></label>\n      <div class=\"number-input w-full\" data-size=\"lg\"\n        ><button type=\"button\" data-action=\"decrement\" aria-label=\"Decrease\">−</button\n        ><input type=\"number\" id=\"fh-4c\" value=\"1\" min=\"0\" max=\"99\" step=\"1\" /><button\n          type=\"button\"\n          data-action=\"increment\"\n          aria-label=\"Increase\"\n          >+</button\n        ></div\n      >\n    </div>\n    <div class=\"form-field\">\n      <label class=\"label\" for=\"fh-4d\">Date <code>lg</code></label>\n      <input class=\"input date-input\" type=\"date\" id=\"fh-4d\" data-size=\"lg\" />\n    </div>\n  </div>\n</form>\n","individual":true},{"label":"Full composition","html":"<form class=\"form\">\n  <div class=\"form-field\">\n    <label class=\"label\" for=\"name\">Username</label>\n    <input class=\"input\" type=\"text\" id=\"name\" required aria-describedby=\"name-desc\" />\n    <p class=\"field-description\" id=\"name-desc\">This is your public display name.</p>\n  </div>\n  <div class=\"form-field\">\n    <label class=\"label\" for=\"email\">Email</label>\n    <select class=\"select\" id=\"email\">\n      <option>m@example.com</option>\n    </select>\n  </div>\n  <fieldset class=\"form-fieldset\">\n    <legend>Notify me about...</legend>\n    <div class=\"form-group\">\n      <div class=\"form-field-inline\">\n        <input class=\"radio\" type=\"radio\" name=\"notify\" id=\"all\" checked />\n        <label for=\"all\">All new messages</label>\n      </div>\n    </div>\n  </fieldset>\n  <div class=\"form-field-row\">\n    <div>\n      <label class=\"label\" for=\"marketing\">Marketing emails</label>\n      <p class=\"field-description\" id=\"marketing-desc\">Receive emails about new products.</p>\n    </div>\n    <input class=\"switch\" type=\"checkbox\" role=\"switch\" id=\"marketing\" aria-describedby=\"marketing-desc\" />\n  </div>\n  <div class=\"form-actions\">\n    <button class=\"btn\" type=\"submit\">Submit</button>\n  </div>\n</form>\n","individual":true},{"label":"Inline fields","html":"<div class=\"form-field-inline\">\n  <input class=\"checkbox\" type=\"checkbox\" id=\"terms\" />\n  <label for=\"terms\">Accept terms and conditions</label>\n</div>\n<div class=\"form-field-inline\">\n  <input class=\"switch\" type=\"checkbox\" role=\"switch\" id=\"news\" />\n  <label for=\"news\">Subscribe to newsletter</label>\n</div>\n","individual":false},{"label":"Switch rows (notifications)","html":"<div class=\"form-group\">\n  <div class=\"form-field-row\">\n    <div>\n      <label class=\"label\" for=\"marketing\">Marketing emails</label>\n      <p class=\"field-description\" id=\"marketing-desc\">Receive emails about new products, features, and more.</p>\n    </div>\n    <input class=\"switch\" type=\"checkbox\" role=\"switch\" id=\"marketing\" aria-describedby=\"marketing-desc\" />\n  </div>\n  <div class=\"form-field-row\">\n    <div>\n      <label class=\"label\" for=\"security\">Security emails</label>\n      <p class=\"field-description\" id=\"security-desc\">Receive emails about your account security.</p>\n    </div>\n    <input\n      class=\"switch\"\n      type=\"checkbox\"\n      role=\"switch\"\n      id=\"security\"\n      checked\n      disabled\n      aria-describedby=\"security-desc\"\n    />\n  </div>\n</div>\n","individual":false},{"label":"Fieldset grouping","html":"<fieldset class=\"form-fieldset\">\n  <legend>Notify me about...</legend>\n  <div class=\"form-group\">\n    <div class=\"form-field-inline\">\n      <input class=\"radio\" type=\"radio\" name=\"notify\" id=\"all\" checked />\n      <label for=\"all\">All new messages</label>\n    </div>\n    <div class=\"form-field-inline\">\n      <input class=\"radio\" type=\"radio\" name=\"notify\" id=\"direct\" />\n      <label for=\"direct\">Direct messages and mentions</label>\n    </div>\n    <div class=\"form-field-inline\">\n      <input class=\"radio\" type=\"radio\" name=\"notify\" id=\"none\" />\n      <label for=\"none\">Nothing</label>\n    </div>\n  </div>\n</fieldset>\n","individual":false},{"label":"Horizontal layout","html":"<div class=\"form-field\" data-orientation=\"horizontal\">\n  <label class=\"label\" for=\"name\">Name</label>\n  <div>\n    <input class=\"input\" type=\"text\" id=\"name\" aria-describedby=\"name-desc\" />\n    <p class=\"field-description\" id=\"name-desc\">Your full name for identification.</p>\n  </div>\n</div>\n","individual":false},{"label":"Validation with errors","html":"<div class=\"form-field\" data-invalid>\n  <label class=\"label\" for=\"user\">Username</label>\n  <input class=\"input\" type=\"text\" id=\"user\" aria-invalid=\"true\" aria-describedby=\"user-err\" />\n  <p class=\"field-error\" id=\"user-err\" role=\"alert\"> Username must be at least 3 characters. </p>\n</div>\n","individual":false}]
