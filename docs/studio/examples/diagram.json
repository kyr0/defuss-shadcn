[{"label":"A request, end to end","html":"<figure\n  class=\"diagram\"\n  id=\"dg-demo\"\n  data-type=\"architecture\"\n  data-steps\n  data-state-demo\n  aria-label=\"Request path of a web app\"\n>\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Architecture</span>\n    <span class=\"diagram-title\">A request, end to end</span>\n  </figcaption>\n  <div class=\"diagram-canvas\" style=\"--cols: 4\">\n    <div class=\"diagram-group\" data-node=\"cloud\" style=\"--col: 2; --row: 1; --span: 3; --rspan: 2\"\n      ><span class=\"diagram-group-label\">Cloud · eu-west-1</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"browser\" style=\"--col: 1; --row: 1\">\n      <span class=\"diagram-node-eyebrow\">Client</span>\n      <span class=\"diagram-node-name\">Browser</span>\n      <span class=\"diagram-node-meta\">SPA</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"api\" data-tone=\"accent\" style=\"--col: 2; --row: 1\">\n      <span class=\"diagram-node-eyebrow\">Edge</span>\n      <span class=\"diagram-node-name\">API gateway</span>\n      <span class=\"diagram-node-meta\">auth · limits</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"svc\" style=\"--col: 3; --row: 1\">\n      <span class=\"diagram-node-name\">Orders service</span>\n      <span class=\"diagram-node-meta\">Go</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"db\" data-shape=\"store\" style=\"--col: 4; --row: 1\"\n      ><span class=\"diagram-node-name\">Postgres</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"queue\" style=\"--col: 3; --row: 2\">\n      <span class=\"diagram-node-name\">Queue</span>\n      <span class=\"diagram-node-meta\">async jobs</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"mail\" data-tone=\"external\" style=\"--col: 4; --row: 2\">\n      <span class=\"diagram-node-name\">Mailer</span>\n      <span class=\"diagram-node-meta\">external</span>\n    </div>\n  </div>\n  <ol class=\"diagram-edges\">\n    <li class=\"diagram-edge\" data-from=\"browser\" data-to=\"api\">HTTPS</li>\n    <li class=\"diagram-edge\" data-from=\"api\" data-to=\"svc\" data-tone=\"accent\">gRPC</li>\n    <li class=\"diagram-edge\" data-from=\"svc\" data-to=\"db\">SQL</li>\n    <li class=\"diagram-edge\" data-from=\"svc\" data-to=\"queue\" data-line=\"dashed\">enqueue</li>\n    <li class=\"diagram-edge\" data-from=\"queue\" data-to=\"mail\" data-line=\"dashed\">send</li>\n  </ol>\n</figure>\n","individual":true},{"label":"Order fulfilment","html":"<figure class=\"diagram\" id=\"dg-shapes\" data-type=\"flow\" aria-label=\"Order fulfilment flow\">\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Flow</span>\n    <span class=\"diagram-title\">Order fulfilment</span>\n  </figcaption>\n  <div class=\"diagram-canvas\" style=\"--cols: 4\">\n    <div class=\"diagram-node\" data-node=\"placed\" data-shape=\"pill\" style=\"--col: 1; --row: 1\"\n      ><span class=\"diagram-node-name\">Order placed</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"stock\" data-shape=\"diamond\" style=\"--col: 2; --row: 1\"\n      ><span class=\"diagram-node-name\">In stock?</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"pick\" data-tone=\"accent\" style=\"--col: 3; --row: 1\">\n      <span class=\"diagram-node-name\">Pick & pack</span>\n      <span class=\"diagram-node-meta\">warehouse</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"shipped\" data-shape=\"pill\" style=\"--col: 4; --row: 1\"\n      ><span class=\"diagram-node-name\">Shipped</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"inventory\" data-shape=\"store\" style=\"--col: 2; --row: 2\">\n      <span class=\"diagram-node-name\">Inventory</span>\n      <span class=\"diagram-node-meta\">stock levels</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"backorder\" style=\"--col: 3; --row: 2\">\n      <span class=\"diagram-node-name\">Back-order</span>\n      <span class=\"diagram-node-meta\">customer notified</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"supplier\" data-tone=\"external\" style=\"--col: 4; --row: 2\">\n      <span class=\"diagram-node-name\">Supplier</span>\n      <span class=\"diagram-node-meta\">EDI</span>\n    </div>\n  </div>\n  <ol class=\"diagram-edges\">\n    <li class=\"diagram-edge\" data-from=\"placed\" data-to=\"stock\"></li>\n    <li class=\"diagram-edge\" data-from=\"stock\" data-to=\"pick\" data-tone=\"accent\">yes</li>\n    <li class=\"diagram-edge\" data-from=\"pick\" data-to=\"shipped\"></li>\n    <li class=\"diagram-edge\" data-from=\"stock\" data-to=\"inventory\" data-line=\"dashed\" data-head=\"open\">reads</li>\n    <li class=\"diagram-edge\" data-from=\"stock\" data-to=\"backorder\">no</li>\n    <li class=\"diagram-edge\" data-from=\"backorder\" data-to=\"supplier\" data-line=\"dashed\">reorder</li>\n    <li class=\"diagram-edge\" data-from=\"supplier\" data-to=\"pick\">delivery</li>\n  </ol>\n</figure>\n","individual":true},{"label":"Checkout, right now","html":"<figure class=\"diagram\" id=\"dg-tones\" data-type=\"architecture\" aria-label=\"Checkout health right now\">\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Health</span>\n    <span class=\"diagram-title\">Checkout, right now</span>\n  </figcaption>\n  <div class=\"diagram-canvas\" style=\"--cols: 4\">\n    <div\n      class=\"diagram-node\"\n      data-node=\"cdn\"\n      data-tone=\"ok\"\n      data-detail=\"Serving 41k req/s from 212 edge locations, no errors.\"\n      style=\"--col: 1; --row: 1\"\n    >\n      <span class=\"diagram-node-name\">CDN</span>\n      <span class=\"diagram-node-meta\">99.99% · ok</span>\n    </div>\n    <div\n      class=\"diagram-node\"\n      data-node=\"api\"\n      data-tone=\"ok\"\n      data-detail=\"Healthy - 6 pods, autoscaling idle.\"\n      style=\"--col: 2; --row: 1\"\n    >\n      <span class=\"diagram-node-name\">API</span>\n      <span class=\"diagram-node-meta\">p95 120 ms</span>\n    </div>\n    <div\n      class=\"diagram-node\"\n      data-node=\"cart\"\n      data-tone=\"warn\"\n      data-detail=\"Degraded: the tax provider answers slowly; carts still save.\"\n      style=\"--col: 3; --row: 1\"\n    >\n      <span class=\"diagram-node-name\">Cart</span>\n      <span class=\"diagram-node-meta\">p95 1.9 s</span>\n    </div>\n    <div\n      class=\"diagram-node\"\n      data-node=\"tax\"\n      data-tone=\"external\"\n      data-detail=\"Third party - their status page reports elevated latency.\"\n      style=\"--col: 4; --row: 1\"\n    >\n      <span class=\"diagram-node-name\">Tax provider</span>\n      <span class=\"diagram-node-meta\">external</span>\n    </div>\n    <div\n      class=\"diagram-node\"\n      data-node=\"pay\"\n      data-tone=\"danger\"\n      data-detail=\"Failing: card authorizations time out since 14:02.\"\n      style=\"--col: 2; --row: 2\"\n    >\n      <span class=\"diagram-node-name\">Payments</span>\n      <span class=\"diagram-node-meta\">5% errors</span>\n    </div>\n    <div\n      class=\"diagram-node\"\n      data-node=\"db\"\n      data-shape=\"store\"\n      data-tone=\"muted\"\n      data-detail=\"Primary and replica in sync.\"\n      style=\"--col: 3; --row: 2\"\n    >\n      <span class=\"diagram-node-name\">Orders DB</span>\n      <span class=\"diagram-node-meta\">lag 0 s</span>\n    </div>\n    <div\n      class=\"diagram-node\"\n      data-node=\"ic\"\n      data-tone=\"accent\"\n      data-detail=\"Open since 14:05 - payments degraded, rollback in progress.\"\n      style=\"--col: 4; --row: 2\"\n    >\n      <span class=\"diagram-node-name\">Incident #482</span>\n      <span class=\"diagram-node-meta\">commander: Mia</span>\n    </div>\n  </div>\n  <ol class=\"diagram-edges\">\n    <li class=\"diagram-edge\" data-from=\"cdn\" data-to=\"api\">HTTPS</li>\n    <li class=\"diagram-edge\" data-from=\"api\" data-to=\"cart\">gRPC</li>\n    <li class=\"diagram-edge\" data-from=\"cart\" data-to=\"tax\" data-line=\"dashed\">rate</li>\n    <li class=\"diagram-edge\" data-from=\"api\" data-to=\"pay\">gRPC</li>\n    <li class=\"diagram-edge\" data-from=\"pay\" data-to=\"db\">SQL</li>\n    <li class=\"diagram-edge\" data-from=\"pay\" data-to=\"ic\" data-line=\"dashed\" data-tone=\"accent\">paged</li>\n  </ol>\n  <ul class=\"diagram-legend\">\n    <li data-swatch=\"accent\">Incident</li>\n    <li data-swatch=\"warn\">Degraded</li>\n    <li data-swatch=\"external\">External</li>\n  </ul>\n</figure>\n","individual":true},{"label":"From commit to production","html":"<figure class=\"diagram\" id=\"dg-curves\" data-type=\"state\" aria-label=\"A CI/CD pipeline\">\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Pipeline</span>\n    <span class=\"diagram-title\">From commit to production</span>\n  </figcaption>\n  <div class=\"diagram-canvas\" style=\"--cols: 4\">\n    <div class=\"diagram-node\" data-node=\"commit\" data-shape=\"pill\" style=\"--col: 1; --row: 1\"\n      ><span class=\"diagram-node-name\">Commit</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"build\" style=\"--col: 2; --row: 1\">\n      <span class=\"diagram-node-name\">Build</span>\n      <span class=\"diagram-node-meta\">container image</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"test\" style=\"--col: 3; --row: 1\">\n      <span class=\"diagram-node-name\">Test</span>\n      <span class=\"diagram-node-meta\">unit · e2e</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"staging\" style=\"--col: 4; --row: 1\">\n      <span class=\"diagram-node-name\">Staging</span>\n      <span class=\"diagram-node-meta\">smoke tests</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"rollback\" style=\"--col: 3; --row: 2\">\n      <span class=\"diagram-node-name\">Rollback</span>\n      <span class=\"diagram-node-meta\">previous image</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"prod\" data-tone=\"accent\" style=\"--col: 4; --row: 2\">\n      <span class=\"diagram-node-name\">Production</span>\n      <span class=\"diagram-node-meta\">canary → 100%</span>\n    </div>\n  </div>\n  <ol class=\"diagram-edges\">\n    <li class=\"diagram-edge\" data-from=\"commit\" data-to=\"build\">push</li>\n    <li class=\"diagram-edge\" data-from=\"build\" data-to=\"test\"></li>\n    <li class=\"diagram-edge\" data-from=\"test\" data-to=\"test\">retry ×2</li>\n    <li class=\"diagram-edge\" data-from=\"test\" data-to=\"staging\">green</li>\n    <li class=\"diagram-edge\" data-from=\"staging\" data-to=\"prod\" data-tone=\"accent\">approve</li>\n    <li class=\"diagram-edge\" data-from=\"prod\" data-to=\"rollback\" data-line=\"dashed\">alert</li>\n    <li class=\"diagram-edge\" data-from=\"rollback:left\" data-to=\"build:bottom\" data-line=\"dashed\">fix forward</li>\n  </ol>\n</figure>\n","individual":true},{"label":"A library, in classes","html":"<figure class=\"diagram\" id=\"dg-heads\" data-type=\"uml-class\" aria-label=\"Library domain model\">\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">UML class</span>\n    <span class=\"diagram-title\">A library, in classes</span>\n  </figcaption>\n  <div class=\"diagram-canvas\" style=\"--cols: 3; --diagram-node-w: 11rem\">\n    <div class=\"diagram-node\" data-node=\"lendable\" data-shape=\"class\" style=\"--col: 2; --row: 1\">\n      <span class=\"diagram-node-eyebrow\">«interface»</span>\n      <span class=\"diagram-node-name\">Lendable</span>\n      <ul class=\"diagram-node-ops\">\n        <li>+ lend(member)</li>\n      </ul>\n    </div>\n    <div class=\"diagram-node\" data-node=\"library\" data-shape=\"class\" style=\"--col: 1; --row: 2\">\n      <span class=\"diagram-node-name\">Library</span>\n      <ul class=\"diagram-node-fields\">\n        <li data-field=\"__name\"><span>- name</span><span>String</span></li>\n      </ul>\n    </div>\n    <div class=\"diagram-node\" data-node=\"book\" data-shape=\"class\" data-tone=\"accent\" style=\"--col: 2; --row: 2\">\n      <span class=\"diagram-node-name\">Book</span>\n      <ul class=\"diagram-node-fields\">\n        <li data-field=\"__isbn\"><span>- isbn</span><span>String</span></li>\n      </ul>\n      <ul class=\"diagram-node-ops\">\n        <li>+ lend(member)</li>\n      </ul>\n    </div>\n    <div class=\"diagram-node\" data-node=\"member\" data-shape=\"class\" style=\"--col: 3; --row: 2\">\n      <span class=\"diagram-node-name\">Member</span>\n      <ul class=\"diagram-node-fields\">\n        <li data-field=\"__card\"><span>- card</span><span>String</span></li>\n      </ul>\n    </div>\n    <div class=\"diagram-node\" data-node=\"shelf\" data-shape=\"class\" style=\"--col: 1; --row: 3\">\n      <span class=\"diagram-node-name\">Shelf</span>\n      <ul class=\"diagram-node-fields\">\n        <li data-field=\"__code\"><span>- code</span><span>String</span></li>\n      </ul>\n    </div>\n    <div class=\"diagram-node\" data-node=\"ebook\" data-shape=\"class\" style=\"--col: 2; --row: 3\">\n      <span class=\"diagram-node-name\">E-book</span>\n      <ul class=\"diagram-node-fields\">\n        <li data-field=\"__drm\"><span>- drm</span><span>bool</span></li>\n      </ul>\n    </div>\n    <div class=\"diagram-node\" data-node=\"notifier\" data-shape=\"class\" style=\"--col: 3; --row: 3\">\n      <span class=\"diagram-node-name\">Notifier</span>\n      <ul class=\"diagram-node-ops\">\n        <li>+ remind(member)</li>\n      </ul>\n    </div>\n  </div>\n  <ol class=\"diagram-edges\">\n    <li class=\"diagram-edge\" data-from=\"book\" data-to=\"lendable\" data-line=\"dashed\" data-head=\"triangle\"></li>\n    <li class=\"diagram-edge\" data-from=\"ebook\" data-to=\"book\" data-head=\"triangle\"></li>\n    <li\n      class=\"diagram-edge\"\n      data-from=\"library\"\n      data-to=\"shelf\"\n      data-head=\"none\"\n      data-tail=\"diamond\"\n      data-from-label=\"1\"\n      data-to-label=\"1..*\"\n      >has</li\n    >\n    <li class=\"diagram-edge\" data-from=\"shelf\" data-to=\"book\" data-head=\"none\" data-tail=\"diamond-open\">holds</li>\n    <li\n      class=\"diagram-edge\"\n      data-from=\"member\"\n      data-to=\"book\"\n      data-head=\"open\"\n      data-from-label=\"0..1\"\n      data-to-label=\"0..5\"\n      >borrows</li\n    >\n    <li class=\"diagram-edge\" data-from=\"member\" data-to=\"notifier\" data-line=\"dashed\" data-head=\"open\">uses</li>\n  </ol>\n</figure>\n","individual":true},{"label":"Who builds on the library","html":"<figure class=\"diagram\" id=\"dg-free\" data-type=\"flow\" aria-label=\"Who builds on the library\">\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Free canvas</span>\n    <span class=\"diagram-title\">Who builds on the library</span>\n  </figcaption>\n  <div class=\"diagram-canvas\" data-layout=\"free\" style=\"--ratio: 16/7\">\n    <div class=\"diagram-node\" data-node=\"core\" data-tone=\"accent\" style=\"--x: 50; --y: 50\">\n      <span class=\"diagram-node-name\">defuss-shadcn</span>\n      <span class=\"diagram-node-meta\">components · tokens</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"themes\" style=\"--x: 15; --y: 20\">\n      <span class=\"diagram-node-name\">Theme presets</span>\n      <span class=\"diagram-node-meta\">43 tweakcn themes</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"agents\" style=\"--x: 85; --y: 20\">\n      <span class=\"diagram-node-name\">Coding agents</span>\n      <span class=\"diagram-node-meta\">read the skills</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"apps\" style=\"--x: 15; --y: 80\">\n      <span class=\"diagram-node-name\">Your apps</span>\n      <span class=\"diagram-node-meta\">copy · CDN · npm</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"docs\" style=\"--x: 85; --y: 80\">\n      <span class=\"diagram-node-name\">This site</span>\n      <span class=\"diagram-node-meta\">uses every part</span>\n    </div>\n  </div>\n  <ol class=\"diagram-edges\">\n    <li class=\"diagram-edge\" data-from=\"themes\" data-to=\"core\" data-curve=\"curve\">style</li>\n    <li class=\"diagram-edge\" data-from=\"agents\" data-to=\"core\" data-curve=\"curve\">generate</li>\n    <li class=\"diagram-edge\" data-from=\"core\" data-to=\"apps\" data-curve=\"curve\">ship</li>\n    <li class=\"diagram-edge\" data-from=\"core\" data-to=\"docs\" data-curve=\"curve\">render</li>\n  </ol>\n</figure>\n","individual":true},{"label":"The fulfilment flow, flowing","html":"<figure class=\"diagram\" id=\"dg-shapes-flow\" data-type=\"flow\" aria-label=\"Order fulfilment flow\">\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Flow</span>\n    <span class=\"diagram-title\">Order fulfilment</span>\n  </figcaption>\n  <div class=\"diagram-canvas\" style=\"--cols: 4\">\n    <div class=\"diagram-node\" data-node=\"placed\" data-shape=\"pill\" style=\"--col: 1; --row: 1\"\n      ><span class=\"diagram-node-name\">Order placed</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"stock\" data-shape=\"diamond\" style=\"--col: 2; --row: 1\"\n      ><span class=\"diagram-node-name\">In stock?</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"pick\" data-tone=\"accent\" style=\"--col: 3; --row: 1\">\n      <span class=\"diagram-node-name\">Pick & pack</span>\n      <span class=\"diagram-node-meta\">warehouse</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"shipped\" data-shape=\"pill\" style=\"--col: 4; --row: 1\"\n      ><span class=\"diagram-node-name\">Shipped</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"inventory\" data-shape=\"store\" style=\"--col: 2; --row: 2\">\n      <span class=\"diagram-node-name\">Inventory</span>\n      <span class=\"diagram-node-meta\">stock levels</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"backorder\" style=\"--col: 3; --row: 2\">\n      <span class=\"diagram-node-name\">Back-order</span>\n      <span class=\"diagram-node-meta\">customer notified</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"supplier\" data-tone=\"external\" style=\"--col: 4; --row: 2\">\n      <span class=\"diagram-node-name\">Supplier</span>\n      <span class=\"diagram-node-meta\">EDI</span>\n    </div>\n  </div>\n  <ol class=\"diagram-edges\">\n    <li\n      class=\"diagram-edge\"\n      data-from=\"placed\"\n      data-to=\"stock\"\n      data-flow=\"2400\"\n      data-flow-tokens=\"2\"\n      data-flow-delay=\"0\"\n    ></li>\n    <li\n      class=\"diagram-edge\"\n      data-from=\"stock\"\n      data-to=\"pick\"\n      data-tone=\"accent\"\n      data-flow=\"2400\"\n      data-flow-tokens=\"2\"\n      data-flow-delay=\"600\"\n      >yes</li\n    >\n    <li\n      class=\"diagram-edge\"\n      data-from=\"pick\"\n      data-to=\"shipped\"\n      data-flow=\"2400\"\n      data-flow-tokens=\"2\"\n      data-flow-delay=\"1200\"\n    ></li>\n    <li\n      class=\"diagram-edge\"\n      data-from=\"stock\"\n      data-to=\"inventory\"\n      data-line=\"dashed\"\n      data-head=\"open\"\n      data-flow=\"2400\"\n      data-flow-tokens=\"2\"\n      data-flow-delay=\"1800\"\n      >reads</li\n    >\n    <li\n      class=\"diagram-edge\"\n      data-from=\"stock\"\n      data-to=\"backorder\"\n      data-flow=\"2400\"\n      data-flow-tokens=\"2\"\n      data-flow-delay=\"2400\"\n      >no</li\n    >\n    <li\n      class=\"diagram-edge\"\n      data-from=\"backorder\"\n      data-to=\"supplier\"\n      data-line=\"dashed\"\n      data-flow=\"2400\"\n      data-flow-tokens=\"2\"\n      data-flow-delay=\"3000\"\n      >reorder</li\n    >\n    <li\n      class=\"diagram-edge\"\n      data-from=\"supplier\"\n      data-to=\"pick\"\n      data-flow=\"2400\"\n      data-flow-tokens=\"2\"\n      data-flow-delay=\"3600\"\n      >delivery</li\n    >\n  </ol>\n</figure>\n","individual":true},{"label":"Side by side","html":"<figure\n  class=\"diagram\"\n  id=\"dg-delta-cols\"\n  data-type=\"flow\"\n  data-delta=\"columns\"\n  data-delta-labels=\"v1|What changed|v2\"\n  aria-label=\"A small delta, side by side\"\n>\n  <div class=\"diagram-canvas\" style=\"--cols: 3\">\n    <div class=\"diagram-node\" data-node=\"a\" style=\"--col: 1; --row: 1\"\n      ><span class=\"diagram-node-name\">Upload</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"b\" data-tone=\"accent\" data-change=\"added\" style=\"--col: 2; --row: 1\"\n      ><span class=\"diagram-node-name\">Virus scan</span></div\n    >\n    <div class=\"diagram-node\" data-node=\"c\" data-change=\"changed\" style=\"--col: 3; --row: 1\">\n      <span class=\"diagram-node-name\">Store</span>\n      <span class=\"diagram-node-meta\" data-before=\"S3\">S3 · encrypted</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"d\" data-change=\"removed\" style=\"--col: 3; --row: 2\"\n      ><span class=\"diagram-node-name\">Email link</span></div\n    >\n  </div>\n  <ol class=\"diagram-edges\">\n    <li class=\"diagram-edge\" data-from=\"a\" data-to=\"b\" data-change=\"added\"></li>\n    <li class=\"diagram-edge\" data-from=\"b\" data-to=\"c\" data-change=\"added\"></li>\n    <li class=\"diagram-edge\" data-from=\"a\" data-to=\"c\" data-change=\"removed\"></li>\n    <li class=\"diagram-edge\" data-from=\"c\" data-to=\"d\" data-change=\"removed\"></li>\n  </ol>\n</figure>\n","individual":true},{"label":"Incident escalation","html":"<figure\n  class=\"diagram\"\n  id=\"dg-rekey\"\n  data-type=\"flow\"\n  style=\"--diagram-accent: var(--destructive)\"\n  aria-label=\"Incident escalation\"\n>\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Re-keyed accent</span>\n    <span class=\"diagram-title\">Incident escalation</span>\n  </figcaption>\n  <div class=\"diagram-canvas\" style=\"--cols: 4\">\n    <div class=\"diagram-node\" data-node=\