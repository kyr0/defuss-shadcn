[{"label":"The cell of a GPS position, its neighbors and its parent","html":"<div class=\"grid gap-3\">\n  <div class=\"flex flex-wrap items-end gap-3\">\n    <div class=\"grid gap-1\">\n      <label class=\"label\" for=\"s2-pos\">Position - longitude, latitude</label>\n      <input class=\"input\" id=\"s2-pos\" value=\"11.582, 48.1351\" spellcheck=\"false\" />\n    </div>\n    <div class=\"grid gap-1\">\n      <label class=\"label\" for=\"s2-level\">Level <output id=\"s2-level-out\">8</output></label>\n      <input class=\"slider\" type=\"range\" id=\"s2-level\" min=\"2\" max=\"14\" value=\"8\" />\n    </div>\n  </div>\n  <pre class=\"text-xs m-0\" id=\"s2-info\"></pre>\n  <div\n    class=\"geo-map\"\n    id=\"cells\"\n    aria-label=\"S2 cells\"\n    data-projection=\"mercator\"\n    data-center=\"11.6,48.1\"\n    data-zoom=\"40\"\n    data-palette=\"mono\"\n    data-graticule=\"false\"\n  ></div>\n</div>\n","individual":false},{"label":"The cube faces and their children","html":"<div\n  class=\"geo-map\"\n  id=\"faces\"\n  aria-label=\"The six S2 faces\"\n  data-projection=\"orthographic\"\n  data-center=\"20,30\"\n  data-palette=\"mono\"\n></div>\n","individual":false},{"label":"From a cube face down through the levels","html":"<div class=\"grid gap-3\">\n  <div class=\"flex flex-wrap items-center gap-2\">\n    <button class=\"btn\" data-size=\"sm\" type=\"button\" id=\"s2-down\">Into Munich's cell</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" data-geo-for=\"s2-drill\" data-geo-action=\"up\"\n      >Up</button\n    >\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-geo-for=\"s2-drill\"\n      data-geo-action=\"reset\"\n      >World</button\n    >\n    <span class=\"text-sm\"\n      >Framed: <output data-geo-for=\"s2-drill\" data-geo-output=\"focus\"></output> - drawn:\n      <output data-geo-for=\"s2-drill\" data-geo-output=\"level\"></output\n    ></span>\n  </div>\n  <div\n    class=\"geo-map\"\n    id=\"s2-drill\"\n    aria-label=\"The S2 hierarchy\"\n    data-projection=\"equalArea\"\n    data-center=\"11.6,48.1\"\n    data-palette=\"mono\"\n    data-highlight=\"outline\"\n  >\n    \n  </div>\n</div>\n","individual":false}]
