[{"label":"Formula Editing","html":"<div class=\"math-editor\">\n  <label class=\"label\" for=\"given-source\">Given</label>\n  <textarea class=\"math-editor-source\" id=\"given-source\" readonly>a^2 + b^2 = c^2</textarea>\n</div>\n","individual":true},{"label":"A formula field in a form","html":"<form style=\"display: grid; gap: 0.75rem; max-width: 30rem; margin-inline: auto\">\n  <div class=\"math-editor\" data-math-preview=\"area-preview\">\n    <label class=\"label\" for=\"area-source\">Area of a circle</label>\n    <textarea class=\"math-editor-source\" id=\"area-source\" name=\"area\" required>A = \\pi r^2</textarea>\n    <div class=\"math-editor-tools\" role=\"group\" aria-label=\"Formula tools\">\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-math-command=\"fraction\"\n        >Fraction</button\n      >\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-math-command=\"power\">Power</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-math-command=\"root\">Root</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" data-math-command=\"undo\">Undo</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" data-math-command=\"keyboard\"\n        >Keyboard</button\n      >\n    </div>\n  </div>\n  <figure class=\"math-renderer\" id=\"area-preview\" data-variant=\"card\" aria-label=\"Preview\">\n    <code class=\"math-renderer-source\">A = \\pi r^2</code>\n    <figcaption>Preview</figcaption>\n  </figure>\n  <div class=\"flex gap-2\">\n    <button class=\"btn\" type=\"submit\">Save</button>\n    <button class=\"btn\" type=\"reset\" data-variant=\"outline\">Reset</button>\n  </div>\n</form>\n","individual":false},{"label":"Given and locked","html":"<div style=\"display: grid; gap: 1rem; max-width: 30rem; margin-inline: auto\">\n  <div class=\"math-editor\">\n    <label class=\"label\" for=\"given-source\">Given</label>\n    <textarea class=\"math-editor-source\" id=\"given-source\" readonly>a^2 + b^2 = c^2</textarea>\n  </div>\n  <div class=\"math-editor\">\n    <label class=\"label\" for=\"locked-source\">Locked</label>\n    <textarea class=\"math-editor-source\" id=\"locked-source\" disabled>E = mc^2</textarea>\n    <div class=\"math-editor-tools\" role=\"group\" aria-label=\"Formula tools\">\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-math-command=\"fraction\"\n        >Fraction</button\n      >\n    </div>\n  </div>\n</div>\n","individual":false},{"label":"Two editors, one keyboard","html":"<div style=\"display: grid; gap: 1rem; max-width: 34rem; margin-inline: auto\">\n  <div class=\"math-editor\">\n    <label class=\"label\" for=\"kb-one-source\">Left side</label>\n    <textarea class=\"math-editor-source\" id=\"kb-one-source\">\\sin^2 x + \\cos^2 x</textarea>\n    <div class=\"math-editor-tools\" role=\"group\" aria-label=\"Left side tools\">\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-math-command=\"keyboard\"\n        >Keyboard</button\n      >\n    </div>\n  </div>\n  <div class=\"math-editor\">\n    <label class=\"label\" for=\"kb-two-source\">Right side</label>\n    <textarea class=\"math-editor-source\" id=\"kb-two-source\">1</textarea>\n    <div class=\"math-editor-tools\" role=\"group\" aria-label=\"Right side tools\">\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-math-command=\"keyboard\"\n        >Keyboard</button\n      >\n    </div>\n  </div>\n</div>\n","individual":false}]
