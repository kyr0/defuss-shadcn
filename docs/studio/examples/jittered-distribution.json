[{"label":"Organic Data Garden","html":"<section\n  class=\"presentation\"\n  id=\"deck-jitter\"\n  data-anim-in=\"zoomIn\"\n  data-anim-in-scale=\"0.92\"\n  data-anim-out=\"blurOut\"\n  style=\"\n    --presentation-ink: #26351f;\n    --presentation-ink-foreground: #f3f0df;\n    --presentation-paper: #f3f0df;\n    --presentation-paper-foreground: #26351f;\n    --presentation-accent: #d85c41;\n    font-family: 'Trebuchet MS', Arial, sans-serif;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"Four ways to grow raspberries - every plant counted\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Raspberry yield per plant in kilograms for 160 plants under four growing methods: open field averages 1.12, raised bed 1.39, polytunnel 1.91, hydroponic 2.24 with the widest spread\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Cover\">\n    <svg\n      aria-hidden=\"true\"\n      width=\"520\"\n      height=\"620\"\n      viewBox=\"0 0 520 620\"\n      style=\"position: absolute; right: 90px; top: 150px\"\n    >\n      <path d=\"M260 600C250 420 240 260 260 40\" stroke=\"#26351F\" stroke-width=\"10\" fill=\"none\" stroke-linecap=\"round\" />\n      <path d=\"M258 420C160 400 90 330 70 240C170 250 240 320 258 420Z\" fill=\"#5E7F3E\" />\n      <path d=\"M262 300C360 280 430 210 450 120C350 130 280 200 262 300Z\" fill=\"#7C9E55\" />\n      <path d=\"M256 190C190 170 150 110 150 50C220 60 250 120 256 190Z\" fill=\"#5E7F3E\" />\n      <circle cx=\"330\" cy=\"470\" r=\"34\" fill=\"#D85C41\" />\n      <circle cx=\"372\" cy=\"506\" r=\"30\" fill=\"#C04A33\" />\n      <circle cx=\"318\" cy=\"522\" r=\"28\" fill=\"#D85C41\" />\n    </svg>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\"\n      >Jittered distribution · Organic Data Garden</p\n    >\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        position: relative;\n        max-width: 1250px;\n        font-family: 'Trebuchet MS', Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.015em;\n        font-size: 6rem;\n        max-width: 900px;\n      \"\n      >Four ways to grow a raspberry</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >160 plants, one season, every plant weighed - before anyone quotes an average.</p\n    >\n    <p class=\"presentation-note\">The drawing sets the season; the dots will do the rest.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"plants\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Every plant\"\n  >\n    <header class=\"presentation-header\"\n      ><span>The harvest</span><span>kg per plant · 40 plants per method</span></header\n    >\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Trebuchet MS', Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.015em;\n      \"\n      >Every plant, one dot</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Jitter spreads each row so no plant hides behind another.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"hydro\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Hydroponic spread\"\n  >\n    <header class=\"presentation-header\"><span>The harvest</span><span>Hydroponic highlighted</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Trebuchet MS', Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.015em;\n      \"\n      >Hydroponics: the best plants - and some of the worst</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">One colour for one question: why is hydroponics so uneven?</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"means\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Means\"\n  >\n    <header class=\"presentation-header\"><span>Averages</span><span>Mean kg per plant</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Trebuchet MS', Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.015em;\n      \"\n      >The averages say: go hydroponic</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Forty dots merge into one bar per method - watch the spread disappear.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Three numbers from the harvest</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #d85c41;\n            font-family: 'Trebuchet MS', Arial, sans-serif;\n            font-weight: 700;\n            letter-spacing: -0.015em;\n          \"\n          ><span data-count=\"2.24\">2.24</span> kg</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">mean per plant, hydroponic</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: 'Trebuchet MS', Arial, sans-serif;\n            font-weight: 700;\n            letter-spacing: -0.015em;\n          \"\n          ><span data-count=\"0.25\">0.25</span> kg</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\"\n          >middle-half spread in the polytunnel - the tightest</p\n        >\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: 'Trebuchet MS', Arial, sans-serif;\n            font-weight: 700;\n            letter-spacing: -0.015em;\n          \"\n          ><span data-count=\"1.73\">1.73</span> kg</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\"\n          >gap between the best and worst hydroponic plant</p\n        >\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >The average rewards hydroponics. The spread rewards the polytunnel.</p\n    >\n    <p class=\"presentation-note\">Average versus reliability - the growers’ real choice.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"The fruit\">\n    <header class=\"presentation-header\"><span>Quality</span><span>Brix and size</span></header>\n    <div style=\"display: flex; gap: 4.5rem; align-items: center; margin-top: 3.5rem\">\n      <div style=\"flex: 1 1 0; min-width: 0\">\n        <h2\n          class=\"presentation-title\"\n          data-df-entrance=\"up\"\n          style=\"\n            font-size: 3.4rem;\n            font-family: 'Trebuchet MS', Arial, sans-serif;\n            font-weight: 700;\n            letter-spacing: -0.015em;\n          \"\n          >Bigger harvests, same sweetness</h2\n        >\n        <p class=\"presentation-lede\" data-df-entrance=\"fade\" style=\"--df-motion-delay: 300ms; font-size: 1.7rem\"\n          >Sugar content (8.9–9.4 °Brix) barely differed between methods. Yield did - reliability even more.</p\n        >\n      </div>\n      <figure\n        class=\"image\"\n        data-ratio=\"4/3\"\n        data-df-entrance=\"zoom\"\n        style=\"--df-motion-delay: 150ms; flex: 0 0 700px; margin: 0\"\n      >\n        <img\n          src=\"https://picsum.photos/id/102/960/720\"\n          alt=\"A few ripe raspberries on a light surface in warm, soft light\"\n          loading=\"lazy\"\n          width=\"960\"\n          height=\"720\"\n          style=\"width: 100%; height: 100%; object-fit: cover\"\n        />\n        <figcaption class=\"image-caption\" style=\"font-size: 1.25rem\">Harvest week 31 (stock photo).</figcaption>\n      </figure>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Quality is not the trade-off here - reliability is.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"south\"\n    data-anim-in-blocks=\"5\"\n    data-anim-in-color=\"#D85C41\"\n    aria-label=\"Yield table\"\n  >\n    <header class=\"presentation-header\"><span>The data</span><span>kg per plant, 40 plants each</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" data-density=\"spacious\" style=\"font-size: 1.7rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Raspberry yield per plant by growing method, one season (synthetic trial).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Method</th><th class=\"table-head\" style=\"text-align: right\">Mean</th\n            ><th class=\"table-head\" style=\"text-align: right\">Median</th\n            ><th class=\"table-head\" style=\"text-align: right\">Middle half</th\n            ><th class=\"table-head\" style=\"text-align: right\">Range</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Open field</td><td class=\"table-cell\" style=\"text-align: right\">1.12</td\n            ><td class=\"table-cell\" style=\"text-align: right\">1.13</td\n            ><td class=\"table-cell\" style=\"text-align: right\">0.89 – 1.32</td\n            ><td class=\"table-cell\" style=\"text-align: right\">0.57 – 1.62</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Raised bed</td><td class=\"table-cell\" style=\"text-align: right\">1.39</td\n            ><td class=\"table-cell\" style=\"text-align: right\">1.38</td\n            ><td class=\"table-cell\" style=\"text-align: right\">1.18 – 1.62</td\n            ><td class=\"table-cell\" style=\"text-align: right\">1.02 – 1.84</td></tr\n          >\n          <tr class=\"table-row\" style=\"font-weight: 700\"\n            ><td class=\"table-cell\">Polytunnel</td><td class=\"table-cell\" style=\"text-align: right\">1.91</td\n            ><td class=\"table-cell\" style=\"text-align: right\">1.91</td\n            ><td class=\"table-cell\" style=\"text-align: right\">1.80 – 2.05</td\n            ><td class=\"table-cell\" style=\"text-align: right\">1.52 – 2.32</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Hydroponic</td><td class=\"table-cell\" style=\"text-align: right\">2.24</td\n            ><td class=\"table-cell\" style=\"text-align: right\">2.24</td\n            ><td class=\"table-cell\" style=\"text-align: right\">2.00 – 2.46</td\n            ><td class=\"table-cell\" style=\"text-align: right\">1.49 – 3.22</td></tr\n          >\n        </tbody>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The ranges are the argument - read the last column.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"\n          font-size: 3.3rem;\n          line-height: 1.22;\n          font-family: 'Trebuchet MS', Arial, sans-serif;\n          font-weight: 700;\n          letter-spacing: -0.015em;\n          font-size: 3rem;\n        \"\n        >“In hydroponics one pump fault ruins a whole rack. In the tunnel, a bad day costs you one plant.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #d85c41; color: #f3f0df\"\n        ><span class=\"avatar-fallback\">GF</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Greta Falk<br /><span style=\"opacity: 0.7; font-size: 1.4rem\"\n          >Soft-fruit grower - 9 seasons, 4 methods</span\n        ></p\n      >\n    </div>\n    <p class=\"presentation-note\">The grower explains the spread.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"box\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Boxplots\"\n  >\n    <header class=\"presentation-header\"><span>Spread</span><span>Median, middle half, range</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Trebuchet MS', Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.015em;\n      \"\n      >Reliability is a shape, not a number</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The bars re-open into boxplots: the polytunnel box is the narrowest.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Questions from the co-op\"\n  >\n    <header class=\"presentation-header\"><span>Q & A</span><span>Growers’ co-op</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.2rem;\n        margin-block: 5.25rem 1.5rem;\n        font-family: 'Trebuchet MS', Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.015em;\n      \"\n      >Questions from the co-op</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"jd-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Which method would you plant next year?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\">Polytunnel for reliable volume; hydroponics only with redundant pumps.</p></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"jd-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Were the open-field plants unlucky?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Two weeks of June rain cost them about 0.2 kg per plant - the gap would remain.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"jd-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Is 40 plants per method enough?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\">For means, yes; for the extremes, the next trial doubles it.</p></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The co-op wants a recommendation - give it.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Takeaways</span><span>For next season</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">❀</span\n        ><span>Show every observation before summarising it.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">❀</span\n        ><span>Hydroponics: highest mean, widest spread - engineer the risk away.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">❀</span\n        ><span>The polytunnel is the reliable middle.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">❀</span\n        ><span>Open field is cheapest; weather sets its ceiling.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Plain lessons, garden pace.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"north\"\n    data-anim-in-blocks=\"5\"\n    data-anim-in-color=\"#D85C41\"\n    aria-label=\"Closing\"\n  >\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        font-family: 'Trebuchet MS', Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.015em;\n      \"\n      >Every plant counts</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px\"\n      >A synthetic trial of 160 plants - keep every observation visible.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">End on the principle.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 12</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"12\" value=\"1\"></progress>\n</section>\n","individual":false}]
