[{"label":"A workshop card in three languages","html":"<div class=\"card\" id=\"ws-card\" data-i18n-component style=\"max-width: 26rem\">\n  <div class=\"card-header\">\n    <h3 class=\"card-title\" data-i18n-target=\"title\">Workshop: native web components</h3>\n    <p class=\"card-description\" data-i18n-target=\"when\">\n      <span data-i18n-value=\"date\">November 12, 2026</span> · <span data-i18n-value=\"price\">€49.00</span>\n    </p>\n  </div>\n  <div class=\"card-content flex flex-col gap-3\">\n    <p class=\"text-sm m-0\" data-i18n-target=\"seats\" data-i18n-count=\"seats\">\n      <span data-i18n-value=\"seatsLabel\">3</span> seats left\n    </p>\n    <input\n      class=\"input\"\n      type=\"email\"\n      placeholder=\"you@example.com\"\n      aria-label=\"Your email\"\n      data-i18n-aria-label-en=\"Your email\"\n      data-i18n-aria-label-de=\"Deine E-Mail-Adresse\"\n      data-i18n-aria-label-ar=\"بريدك الإلكتروني\"\n    />\n  </div>\n  <div class=\"card-footer flex items-center gap-2\">\n    <button class=\"btn\" type=\"button\" id=\"ws-reserve\" data-i18n-target=\"reserve\">Reserve a seat</button>\n    <select\n      class=\"select\"\n      data-size=\"sm\"\n      id=\"ws-lang\"\n      aria-label=\"Language\"\n      data-i18n-aria-label-en=\"Language\"\n      data-i18n-aria-label-de=\"Sprache\"\n      data-i18n-aria-label-ar=\"اللغة\"\n      style=\"width: auto; margin-inline-start: auto\"\n    >\n      <option value=\"en\" lang=\"en\">English</option>\n      <option value=\"de\" lang=\"de\">Deutsch</option>\n      <option value=\"ar\" lang=\"ar\">العربية</option>\n    </select>\n  </div>\n  <template data-i18n-for=\"title\" data-i18n-locale=\"en\">Workshop: native web components</template>\n  <template data-i18n-for=\"title\" data-i18n-locale=\"de\">Workshop: native Web Components</template>\n  <template data-i18n-for=\"title\" data-i18n-locale=\"ar\">ورشة عمل: مكونات الويب الأصلية</template>\n  <template data-i18n-for=\"when\" data-i18n-locale=\"en\"\n    ><span data-i18n-value=\"date\"></span> · <span data-i18n-value=\"price\"></span\n  ></template>\n  <template data-i18n-for=\"when\" data-i18n-locale=\"de\"\n    ><span data-i18n-value=\"date\"></span> · <span data-i18n-value=\"price\"></span\n  ></template>\n  <template data-i18n-for=\"when\" data-i18n-locale=\"ar\"\n    ><span data-i18n-value=\"date\"></span> · <span data-i18n-value=\"price\"></span\n  ></template>\n  <template data-i18n-for=\"seats\" data-i18n-locale=\"en\" data-i18n-plural=\"one\"\n    ><span data-i18n-value=\"seatsLabel\"></span> seat left</template\n  >\n  <template data-i18n-for=\"seats\" data-i18n-locale=\"en\" data-i18n-plural=\"other\"\n    ><span data-i18n-value=\"seatsLabel\"></span> seats left</template\n  >\n  <template data-i18n-for=\"seats\" data-i18n-locale=\"de\" data-i18n-plural=\"one\"\n    >Noch <span data-i18n-value=\"seatsLabel\"></span> Platz frei</template\n  >\n  <template data-i18n-for=\"seats\" data-i18n-locale=\"de\" data-i18n-plural=\"other\"\n    >Noch <span data-i18n-value=\"seatsLabel\"></span> Plätze frei</template\n  >\n  <template data-i18n-for=\"seats\" data-i18n-locale=\"ar\" data-i18n-plural=\"zero\">لم يبقَ أي مقعد</template>\n  <template data-i18n-for=\"seats\" data-i18n-locale=\"ar\" data-i18n-plural=\"one\">بقي مقعد واحد</template>\n  <template data-i18n-for=\"seats\" data-i18n-locale=\"ar\" data-i18n-plural=\"two\">بقي مقعدان</template>\n  <template data-i18n-for=\"seats\" data-i18n-locale=\"ar\" data-i18n-plural=\"few\"\n    >بقيت <span data-i18n-value=\"seatsLabel\"></span> مقاعد</template\n  >\n  <template data-i18n-for=\"seats\" data-i18n-locale=\"ar\" data-i18n-plural=\"many\"\n    >بقي <span data-i18n-value=\"seatsLabel\"></span> مقعدًا</template\n  >\n  <template data-i18n-for=\"seats\" data-i18n-locale=\"ar\" data-i18n-plural=\"other\"\n    >بقي <span data-i18n-value=\"seatsLabel\"></span> مقعد</template\n  >\n  <template data-i18n-for=\"reserve\" data-i18n-locale=\"en\">Reserve a seat</template>\n  <template data-i18n-for=\"reserve\" data-i18n-locale=\"de\">Platz reservieren</template>\n  <template data-i18n-for=\"reserve\" data-i18n-locale=\"ar\">احجز مقعدًا</template>\n</div>\n","individual":false}]
