[{"label":"Source, preview and state controls","html":"<div\n  class=\"code-example\"\n  id=\"cx-switch\"\n  aria-label=\"Switch preview\"\n  data-preview-style=\"display:flex;justify-content:center\"\n  data-schema='{\"schemaVersion\":1,\"name\":\"switch\",\"states\":{\"checked\":{\"type\":\"boolean\",\"default\":false,\"target\":{\"kind\":\"selector\",\"selector\":\".switch\"},\"mutation\":{\"kind\":\"property\",\"name\":\"checked\"},\"observation\":{\"kind\":\"property\",\"name\":\"checked\"},\"editor\":{\"component\":\"checkbox\"}}},\"actions\":{}}'\n>\n  <textarea>\n<div class=\"switch-item flex items-center gap-2\">\n  <input class=\"switch\" type=\"checkbox\" role=\"switch\" id=\"wifi\">\n  <label class=\"label\" for=\"wifi\">Wi-Fi</label>\n</div>\n  </textarea>\n</div>\n","individual":true},{"label":"Just a source and its preview","html":"<div\n  class=\"code-example\"\n  id=\"cx-buttons\"\n  aria-label=\"Buttons preview\"\n  data-preview-style=\"display:flex;gap:0.5rem;justify-content:center\"\n>\n  <textarea>\n<button class=\"btn\">Save</button>\n<button class=\"btn\" data-variant=\"outline\">Cancel</button>\n<button class=\"btn\" data-variant=\"ghost\">Later</button>\n  </textarea>\n</div>\n","individual":true},{"label":"Booting as a phone","html":"<div class=\"code-example\" id=\"cx-phone\" aria-label=\"Responsive grid\" data-vp-mode=\"phone\">\n  <textarea>\n<div class=\"grid gap-3\" style=\"grid-template-columns:repeat(auto-fit,minmax(9rem,1fr))\">\n  <div class=\"card\"><div class=\"card-header\"><p class=\"card-description\">Revenue</p><h3 class=\"card-title\">$48.2k</h3></div></div>\n  <div class=\"card\"><div class=\"card-header\"><p class=\"card-description\">Orders</p><h3 class=\"card-title\">1,284</h3></div></div>\n  <div class=\"card\"><div class=\"card-header\"><p class=\"card-description\">Refunds</p><h3 class=\"card-title\">12</h3></div></div>\n</div>\n  </textarea>\n</div>\n","individual":true},{"label":"Booting as a print sheet","html":"<div class=\"code-example\" id=\"cx-print\" aria-label=\"Print styles\" data-vp-mode=\"print\">\n  <textarea>\n<style>\n  .cx-media { color: rgb(0, 0, 255); }\n  @media print { .cx-media { color: rgb(255, 0, 0); } }\n  @media screen { .cx-screen-only { display: block; } }\n  @media not screen { .cx-screen-only { display: none; } }\n</style>\n<p class=\"cx-media\">Blue on screen, red in print.</p>\n<p class=\"cx-screen-only\">Only on screen.</p>\n  </textarea>\n</div>\n","individual":true},{"label":"A playground with an API","html":"<div class=\"grid gap-3\" style=\"width: 100%\">\n  <div class=\"flex flex-wrap gap-2\">\n    <button class=\"btn\" data-size=\"sm\" data-variant=\"outline\" id=\"cx-load\">Load a card</button>\n    <button class=\"btn\" data-size=\"sm\" data-variant=\"outline\" id=\"cx-source\">Show the source</button>\n    <button class=\"btn\" data-size=\"sm\" data-variant=\"outline\" id=\"cx-tablet\">Tablet</button>\n    <button class=\"btn\" data-size=\"sm\" data-variant=\"outline\" id=\"cx-reset\">Reset</button>\n  </div>\n  <div class=\"code-example\" id=\"cx-play\" aria-label=\"Playground\">\n    <textarea>\n<p class=\"text-sm\">Edit me - the preview follows.</p>\n    </textarea>\n  </div>\n  <output id=\"cx-log\" class=\"text-sm text-muted-foreground\">Changes show up here.</output>\n</div>\n","individual":false}]
