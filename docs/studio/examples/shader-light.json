[{"label":"Rays from above","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"god-rays-demo\"\n    data-effect=\"god-rays\"\n    data-interactive\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"god-rays-demo\"></div>\n</div>\n","individual":false},{"label":"Northern lights","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"aurora-demo\"\n    data-effect=\"aurora\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"aurora-demo\"></div>\n</div>\n","individual":false},{"label":"A button and a field","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"grid gap-4 items-center\"\n    style=\"grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); padding: 1.5rem\"\n  >\n    <button class=\"btn\" type=\"button\" data-size=\"lg\">\n      <span\n        class=\"shader\"\n        id=\"pulsing-border-demo\"\n        data-variant=\"border\"\n        data-effect=\"pulsing-border\"\n        data-spots=\"2\"\n        data-colors=\"#f472b6 #facc15 #38bdf8\"\n        style=\"--shader-glow: 0.75rem\"\n        aria-hidden=\"true\"\n      ></span>\n      Get early access\n    </button>\n    <label class=\"grid gap-2 focus-glow\">\n      <span class=\"label\">Ask anything</span>\n      <span style=\"display: block; position: relative; isolation: isolate; border-radius: var(--radius-md)\">\n        <span\n          class=\"shader\"\n          data-variant=\"border\"\n          data-effect=\"pulsing-border\"\n          data-thickness=\"1.5\"\n          data-colors=\"#7c5cff #2bd9ff\"\n          style=\"--shader-glow: 0.75rem\"\n          aria-hidden=\"true\"\n        ></span>\n        <input class=\"input\" type=\"text\" placeholder=\"Search the docs\" />\n      </span>\n    </label>\n  </div>\n  <div class=\"shader-controls\" data-shader-for=\"pulsing-border-demo\"></div>\n</div>\n<style>\n  .focus-glow .shader {\n    opacity: 0;\n    transition: opacity 0.3s;\n  }\n  .focus-glow:focus-within .shader {\n    opacity: 1;\n  }\n</style>\n","individual":false},{"label":"A foil portrait","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"hologram-demo\"\n    data-effect=\"hologram\"\n    data-interactive\n    style=\"max-width: 22rem; border-radius: 1rem\"\n  >\n    <img src=\"images/photos/64-720x960.webp\" alt=\"A portrait\" crossorigin=\"anonymous\" width=\"720\" height=\"960\" />\n  </div>\n  <div class=\"shader-controls\" data-shader-for=\"hologram-demo\"></div>\n</div>\n","individual":false},{"label":"Lights out of focus","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"bokeh-demo\"\n    data-effect=\"bokeh\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"bokeh-demo\"></div>\n</div>\n","individual":false},{"label":"Light through a prism","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"prism-demo\"\n    data-effect=\"prism\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"prism-demo\"></div>\n</div>\n","individual":false},{"label":"A thunderstorm","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"lightning-demo\"\n    data-effect=\"lightning\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"lightning-demo\"></div>\n</div>\n","individual":false},{"label":"A summer night","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"fireflies-demo\"\n    data-effect=\"fireflies\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"fireflies-demo\"></div>\n</div>\n","individual":false}]
