[{"label":"Transit Infographic","html":"<section\n  class=\"presentation\"\n  id=\"deck-shift\"\n  data-anim-in=\"slideIn\"\n  data-anim-in-distance=\"160px\"\n  data-anim-out=\"fadeOut\"\n  style=\"\n    --presentation-ink: #15252d;\n    --presentation-ink-foreground: #f2f5f6;\n    --presentation-paper: #ffffff;\n    --presentation-paper-foreground: #15252d;\n    --presentation-accent: #e33f32;\n    font-family: 'Segoe UI', Frutiger, Arial, sans-serif;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"Turnout along Line 1 - twelve districts, two elections\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Change in turnout between 2021 and 2025 in twelve districts along a metro line: University up 11.5 points, Hilltop down 5.4; turnout levels in 2025; and change against the share of residents under 30\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Cover\">\n    <svg\n      aria-hidden=\"true\"\n      width=\"1600\"\n      height=\"220\"\n      viewBox=\"0 0 1600 220\"\n      style=\"position: absolute; left: 0; bottom: 40px\"\n    >\n      <path\n        d=\"M-20 110 H520 Q560 110 590 80 L660 20 H1620\"\n        fill=\"none\"\n        stroke=\"#E33F32\"\n        stroke-width=\"16\"\n        stroke-linecap=\"round\"\n      />\n      <circle cx=\"120\" cy=\"110\" r=\"15\" fill=\"#FFFFFF\" stroke=\"#15252D\" stroke-width=\"6\" />\n      <circle cx=\"260\" cy=\"110\" r=\"15\" fill=\"#FFFFFF\" stroke=\"#15252D\" stroke-width=\"6\" />\n      <circle cx=\"400\" cy=\"110\" r=\"15\" fill=\"#FFFFFF\" stroke=\"#15252D\" stroke-width=\"6\" />\n      <circle cx=\"700\" cy=\"20\" r=\"15\" fill=\"#FFFFFF\" stroke=\"#15252D\" stroke-width=\"6\" />\n      <circle cx=\"860\" cy=\"20\" r=\"15\" fill=\"#FFFFFF\" stroke=\"#15252D\" stroke-width=\"6\" />\n      <circle cx=\"1020\" cy=\"20\" r=\"15\" fill=\"#FFFFFF\" stroke=\"#15252D\" stroke-width=\"6\" />\n      <circle cx=\"1180\" cy=\"20\" r=\"15\" fill=\"#FFFFFF\" stroke=\"#15252D\" stroke-width=\"6\" />\n      <circle cx=\"1340\" cy=\"20\" r=\"15\" fill=\"#FFFFFF\" stroke=\"#15252D\" stroke-width=\"6\" />\n      <circle cx=\"1500\" cy=\"20\" r=\"15\" fill=\"#FFFFFF\" stroke=\"#15252D\" stroke-width=\"6\" />\n    </svg>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\"\n      >Shift arrows · Transit Infographic</p\n    >\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        position: relative;\n        max-width: 1250px;\n        font-family: 'Segoe UI', Frutiger, Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.01em;\n        font-size: 6.25rem;\n      \"\n      >Turnout along Line 1</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >Twelve districts, two elections, one question per stop: did more people vote?</p\n    >\n    <p class=\"presentation-note\">The line is the grammar of the whole deck.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"stops\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Along the line\"\n  >\n    <header class=\"presentation-header\"><span>Line 1</span><span>Turnout change 2021 → 2025, points</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Segoe UI', Frutiger, Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.01em;\n      \"\n      >Seven stops up, five down</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Up arrows teal, down arrows red - read the line left to right.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"ranked\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Ranked\"\n  >\n    <header class=\"presentation-header\"><span>Line 1</span><span>Sorted by change</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Segoe UI', Frutiger, Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.01em;\n      \"\n      >University leads: +11.5 points</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The stations re-order by change; the arrows travel with them.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"levels\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Levels\"\n  >\n    <header class=\"presentation-header\"><span>Turnout 2025</span><span>% who voted</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Segoe UI', Frutiger, Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.01em;\n      \"\n      >Central votes most - Airport Rd least</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The arrows grow into this year’s turnout levels.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Three numbers for the city clerk</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: 'Segoe UI', Frutiger, Arial, sans-serif;\n            font-weight: 700;\n            letter-spacing: -0.01em;\n          \"\n          ><span data-count=\"60.3\">60.3</span>%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">city-wide turnout in 2025</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #00897b;\n            font-family: 'Segoe UI', Frutiger, Arial, sans-serif;\n            font-weight: 700;\n            letter-spacing: -0.01em;\n          \"\n          >+<span data-count=\"2.1\">2.1</span> pts</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">versus 2021</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #e33f32;\n            font-family: 'Segoe UI', Frutiger, Arial, sans-serif;\n            font-weight: 700;\n            letter-spacing: -0.01em;\n          \"\n          >+<span data-count=\"11.5\">11.5</span> pts</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">University - the biggest jump</p>\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >The city average barely moved. Underneath, young districts surged and old ones slipped.</p\n    >\n    <p class=\"presentation-note\">Average versus spread - again.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"On the street\">\n    <header class=\"presentation-header\"><span>Getting there</span><span>Polling day</span></header>\n    <div style=\"display: flex; gap: 4.5rem; align-items: center; margin-top: 3.5rem\">\n      <figure\n        class=\"image\"\n        data-ratio=\"4/3\"\n        data-df-entrance=\"left\"\n        style=\"--df-motion-delay: 150ms; flex: 0 0 700px; margin: 0\"\n      >\n        <img\n          src=\"https://picsum.photos/id/22/960/720\"\n          alt=\"A person in a dark coat walking across a road with white lane markings\"\n          loading=\"lazy\"\n          width=\"960\"\n          height=\"720\"\n          style=\"width: 100%; height: 100%; object-fit: cover\"\n        />\n        <figcaption class=\"image-caption\" style=\"font-size: 1.25rem\">On the way to vote (stock photo).</figcaption>\n      </figure>\n      <div style=\"flex: 1 1 0; min-width: 0\">\n        <h2\n          class=\"presentation-title\"\n          data-df-entrance=\"up\"\n          style=\"\n            font-size: 3.4rem;\n            font-family: 'Segoe UI', Frutiger, Arial, sans-serif;\n            font-weight: 700;\n            letter-spacing: -0.01em;\n          \"\n          >Nine polling stations moved next to metro stops</h2\n        >\n        <p class=\"presentation-lede\" data-df-entrance=\"fade\" style=\"--df-motion-delay: 300ms; font-size: 1.7rem\"\n          >The four biggest gains are all at stops where a polling station moved within 300 m of the platform.</p\n        >\n      </div>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Access, not enthusiasm, may be the story.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"east\"\n    data-anim-in-blocks=\"6\"\n    data-anim-in-color=\"#E33F32\"\n    aria-label=\"Station table\"\n  >\n    <header class=\"presentation-header\"><span>Timetable</span><span>Turnout by stop</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" style=\"font-size: 1.45rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Turnout by district along Line 1, 2021 and 2025 (fictional city).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Stop</th><th class=\"table-head\" style=\"text-align: right\">2021</th\n            ><th class=\"table-head\" style=\"text-align: right\">2025</th\n            ><th class=\"table-head\" style=\"text-align: right\">Change</th\n            ><th class=\"table-head\" style=\"text-align: right\">Under 30</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">University</td><td class=\"table-cell\" style=\"text-align: right\">48.9%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">60.4%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+11.5</td\n            ><td class=\"table-cell\" style=\"text-align: right\">47%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Docklands</td><td class=\"table-cell\" style=\"text-align: right\">51.2%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">59.8%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+8.6</td\n            ><td class=\"table-cell\" style=\"text-align: right\">38%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Central</td><td class=\"table-cell\" style=\"text-align: right\">64.0%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">70.2%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+6.2</td\n            ><td class=\"table-cell\" style=\"text-align: right\">31%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Riverside</td><td class=\"table-cell\" style=\"text-align: right\">61.2%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">66.8%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+5.6</td\n            ><td class=\"table-cell\" style=\"text-align: right\">24%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Parkview</td><td class=\"table-cell\" style=\"text-align: right\">66.7%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">65.9%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">−0.8</td\n            ><td class=\"table-cell\" style=\"text-align: right\">18%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Old Mill</td><td class=\"table-cell\" style=\"text-align: right\">58.4%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">55.1%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">−3.3</td\n            ><td class=\"table-cell\" style=\"text-align: right\">16%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Hilltop</td><td class=\"table-cell\" style=\"text-align: right\">69.5%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">64.1%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">−5.4</td\n            ><td class=\"table-cell\" style=\"text-align: right\">12%</td></tr\n          >\n        </tbody>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Seven of twelve stops - the extremes and the middle.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"\n          font-size: 3.3rem;\n          line-height: 1.22;\n          font-family: 'Segoe UI', Frutiger, Arial, sans-serif;\n          font-weight: 700;\n          letter-spacing: -0.01em;\n          font-size: 3rem;\n        \"\n        >“We put the ballot box where the students already were - at the station. Turnout followed the footfall.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #e33f32; color: #ffffff\"\n        ><span class=\"avatar-fallback\">JT</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Jonas Tamm<br /><span style=\"opacity: 0.7; font-size: 1.4rem\">City elections office - fictional</span></p\n      >\n    </div>\n    <p class=\"presentation-note\">The operational explanation.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"age\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Age\"\n  >\n    <header class=\"presentation-header\"><span>Why</span><span>Change × share of residents under 30</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Segoe UI', Frutiger, Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.01em;\n      \"\n      >Younger districts moved up</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The arrow tips fly into a scatter against age.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Questions from the council\"\n  >\n    <header class=\"presentation-header\"><span>Q & A</span><span>Council committee</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.2rem;\n        margin-block: 5.25rem 1.5rem;\n        font-family: 'Segoe UI', Frutiger, Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.01em;\n      \"\n      >Questions from the council</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"sa-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Is age the cause?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Partly - young districts are also where the polling stations moved; the two effects overlap.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"sa-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Why did Hilltop fall?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Its polling station moved 1.4 km away from the old town hall; turnout fell most among over-70s.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"sa-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>What do we change next time?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Keep the station-side polling places and add a shuttle for Hilltop and Old Mill.</p\n          ></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Hilltop is the fairness question.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Next stops</span><span>Recommendations</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">●</span\n        ><span>Arrows show direction and size in one mark.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">●</span\n        ><span>A flat city average can hide a large reshuffle.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">●</span\n        ><span>Polling places near transit lifted young districts.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">●</span\n        ><span>Protect access for older districts when stations move.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Four stops, then terminus.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"west\"\n    data-anim-in-blocks=\"6\"\n    data-anim-in-color=\"#E33F32\"\n    aria-label=\"Closing\"\n  >\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        font-family: 'Segoe UI', Frutiger, Arial, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.01em;\n      \"\n      >Direction and size in one mark</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px\"\n      >A fictional city and synthetic turnout - the shift arrow is the real grammar.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">Terminus.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 12</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"12\" value=\"1\"></progress>\n</section>\n","individual":false}]
