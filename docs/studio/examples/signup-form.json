[{"label":"Default","html":"<section class=\"mk-signup-form\" aria-labelledby=\"su-title\">\n  <div class=\"mk-signup-form-head\"\n    ><svg\n      viewBox=\"0 0 24 24\"\n      width=\"28\"\n      height=\"28\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n      aria-hidden=\"true\"\n    >\n      <polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\" /></svg\n    ><h1 id=\"su-title\">Create your account</h1><p>Free for 14 days. No credit card.</p></div\n  >\n  <form action=\"#\" method=\"post\">\n    <div class=\"mk-auth-field\"\n      ><label class=\"label\" for=\"su-name\">Full name</label\n      ><input class=\"input\" id=\"su-name\" name=\"name\" autocomplete=\"name\" required\n    /></div>\n    <div class=\"mk-auth-field\"\n      ><label class=\"label\" for=\"su-email\">Work email</label\n      ><input class=\"input\" id=\"su-email\" type=\"email\" name=\"email\" autocomplete=\"email\" required\n    /></div>\n    <div class=\"mk-auth-field\"\n      ><label class=\"label\" for=\"su-pass\">Password</label\n      ><input\n        class=\"input\"\n        id=\"su-pass\"\n        type=\"password\"\n        name=\"password\"\n        autocomplete=\"new-password\"\n        minlength=\"12\"\n        pattern=\"(?=.*[0-9\\W]).{12,}\"\n        required\n        aria-describedby=\"su-pass-rules\"\n      /><ul class=\"mk-signup-form-rules\" id=\"su-pass-rules\"\n        ><li>At least 12 characters</li\n        ><li>A number or a symbol</li\n        ><li>Not your email address</li></ul\n      ></div\n    >\n    <label class=\"mk-signup-form-terms\"\n      ><input class=\"checkbox\" type=\"checkbox\" name=\"terms\" required />I agree to the <a href=\"#\">Terms</a> and the\n      <a href=\"#\">Privacy Policy</a>.</label\n    >\n    <button class=\"btn\" type=\"submit\">Create account</button>\n  </form>\n  <p class=\"mk-signup-form-foot\">Already have an account? <a href=\"#\">Sign in</a></p>\n</section>\n","individual":true},{"label":"Split","html":"<section class=\"mk-signup-form\" data-variant=\"split\" aria-labelledby=\"su2-title\">\n  <div class=\"mk-signup-form-layout\">\n    <div class=\"mk-signup-form-pitch\">\n      <h2>Everything your team needs</h2>\n      <ul>\n        <li\n          ><i data-lucide=\"layout-dashboard\"></i><strong>Plans, docs and tasks</strong\n          ><span>One calm surface for all of it.</span></li\n        >\n        <li><i data-lucide=\"wifi-off\"></i><strong>Works offline</strong><span>Sync catches up when you do.</span></li>\n        <li\n          ><i data-lucide=\"shield-check\"></i><strong>Private by default</strong\n          ><span>Hosted in the EU, never used for training.</span></li\n        >\n      </ul>\n    </div>\n    <div class=\"mk-signup-form-panel\">\n      <div class=\"mk-signup-form-head\"><h1 id=\"su2-title\">Start free</h1></div>\n      <form action=\"#\" method=\"post\">\n        <div class=\"mk-auth-field\"\n          ><label class=\"label\" for=\"su2-email\">Work email</label\n          ><input class=\"input\" id=\"su2-email\" type=\"email\" name=\"email\" autocomplete=\"email\" required\n        /></div>\n        <div class=\"mk-auth-field\"\n          ><label class=\"label\" for=\"su2-pass\">Password</label\n          ><input\n            class=\"input\"\n            id=\"su2-pass\"\n            type=\"password\"\n            name=\"password\"\n            autocomplete=\"new-password\"\n            minlength=\"12\"\n            required\n            aria-describedby=\"su2-pass-rules\"\n          /><ul class=\"mk-signup-form-rules\" id=\"su2-pass-rules\"\n            ><li>At least 12 characters</li\n            ><li>A number or a symbol</li\n            ><li>Not your email address</li></ul\n          ></div\n        >\n        <button class=\"btn\" type=\"submit\">Create account</button>\n      </form>\n    </div>\n  </div>\n</section>\n","individual":true}]
