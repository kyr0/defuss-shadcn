[{"label":"Default","html":"<section class=\"mk-cta\" aria-labelledby=\"cta-1\">\n  <div class=\"mk-cta-inner\">\n    <div class=\"mk-cta-copy\">\n      <h2 class=\"mk-cta-title\" id=\"cta-1\">Ready to work calmer?</h2>\n      <p class=\"mk-cta-desc\">Join 12,000 teams who plan, write and ship in one place.</p>\n    </div>\n    <div class=\"mk-cta-actions\">\n      <a class=\"btn\" data-size=\"lg\" href=\"#\">Start free trial</a>\n      <a class=\"btn\" data-variant=\"outline\" data-size=\"lg\" href=\"#\">Talk to sales</a>\n    </div>\n    <p class=\"mk-cta-note\">Free for 14 days · No credit card required</p>\n  </div>\n</section>\n","individual":true},{"label":"Split","html":"<section class=\"mk-cta\" data-variant=\"split\" aria-labelledby=\"cta-2\">\n  <div class=\"mk-cta-inner\">\n    <div class=\"mk-cta-copy\">\n      <h2 class=\"mk-cta-title\" id=\"cta-2\">See Acme in 20 minutes</h2>\n      <p class=\"mk-cta-desc\">A live walkthrough with a product specialist - bring your questions.</p>\n    </div>\n    <div class=\"mk-cta-actions\"\n      ><a class=\"btn\" data-size=\"lg\" href=\"#\">Book a demo <i data-lucide=\"arrow-right\"></i></a\n    ></div>\n  </div>\n</section>\n","individual":true},{"label":"Dark with a form","html":"<section class=\"mk-cta\" data-variant=\"dark\" aria-labelledby=\"cta-3\">\n  <div class=\"mk-cta-inner\">\n    <div class=\"mk-cta-copy\">\n      <h2 class=\"mk-cta-title\" id=\"cta-3\">Get early access to Spaces</h2>\n      <p class=\"mk-cta-desc\">Shared spaces for every project. Invites go out this month.</p>\n    </div>\n    <form class=\"mk-cta-form\" action=\"#\" method=\"post\">\n      <label class=\"sr-only\" for=\"cta-email\">Email address</label>\n      <input\n        class=\"input\"\n        id=\"cta-email\"\n        type=\"email\"\n        name=\"email\"\n        placeholder=\"you@company.com\"\n        required\n        autocomplete=\"email\"\n      />\n      <button class=\"btn\" data-variant=\"secondary\" type=\"submit\">Request invite</button>\n    </form>\n    <p class=\"mk-cta-note\">2,400 people joined this week.</p>\n  </div>\n</section>\n","individual":true},{"label":"Over a picture","html":"<section class=\"mk-cta\" data-variant=\"image\" aria-labelledby=\"cta-4\">\n  <div class=\"mk-cta-inner\">\n    <img class=\"mk-cta-bg\" src=\"https://picsum.photos/seed/cta-summit/1600/700\" alt=\"\" />\n    <div class=\"mk-cta-copy\">\n      <h2 class=\"mk-cta-title\" id=\"cta-4\">Acme Summit · 12–13 November, Lisbon</h2>\n      <p class=\"mk-cta-desc\">Two days of talks and workshops on calm software. Early-bird ends Friday.</p>\n    </div>\n    <div class=\"mk-cta-actions\">\n      <a class=\"btn\" data-variant=\"secondary\" data-size=\"lg\" href=\"#\">Get your ticket</a>\n      <a class=\"btn\" data-variant=\"outline\" data-size=\"lg\" href=\"#\">See the agenda</a>\n    </div>\n  </div>\n</section>\n","individual":true}]
