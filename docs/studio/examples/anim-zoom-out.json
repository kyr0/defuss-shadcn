[{"label":"In / out and lifecycle","html":"<style>\n  #anim-zoom-out-target {\n    width: 160px;\n    height: 100px;\n    display: grid;\n    place-items: center;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    background: var(--card);\n    color: var(--card-foreground);\n    font-weight: 600;\n  }\n</style>\n<div id=\"anim-zoom-out-target\">zoom-out</div>\n<div style=\"display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-top: 1rem\">\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-zoom-out-in\">In</button>\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-zoom-out-out\">Out</button>\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-zoom-out-pause\">Pause</button>\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-zoom-out-resume\">Resume</button>\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-zoom-out-finish\">Finish</button>\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-zoom-out-reset\">Reset</button>\n  <input\n    class=\"input\"\n    id=\"anim-zoom-out-duration\"\n    type=\"number\"\n    value=\"1500\"\n    min=\"1\"\n    step=\"50\"\n    style=\"width: 6rem\"\n    aria-label=\"Duration in ms\"\n  />\n  <select class=\"select\" id=\"anim-zoom-out-easing\" aria-label=\"Easing\">\n    <option value=\"cubic-bezier(0.16, 1, 0.3, 1)\" selected>default ease-out</option>\n    <option value=\"linear\">linear</option>\n    <option value=\"ease-in-out\">ease-in-out</option>\n    <option value=\"cubic-bezier(0.34, 1.56, 0.64, 1)\">springy overshoot</option>\n  </select>\n</div>\n","individual":false},{"label":"Scroll-driven progress","html":"<style>\n  #anim-zoom-out-scroll-target {\n    width: 160px;\n    height: 100px;\n    display: grid;\n    place-items: center;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    background: var(--card);\n    color: var(--card-foreground);\n    font-weight: 600;\n  }\n</style>\n<div\n  id=\"anim-zoom-out-scroller\"\n  style=\"height: 220px; overflow-y: auto; border: 1px solid var(--border); border-radius: var(--radius-lg)\"\n>\n  <div\n    style=\"\n      height: 600px;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      align-items: center;\n      padding: 1rem;\n    \"\n  >\n    <span style=\"font-size: 0.85rem; color: var(--muted-foreground)\">scroll down</span>\n    <div id=\"anim-zoom-out-scroll-target\">driven by scroll</div>\n    <span style=\"font-size: 0.85rem; color: var(--muted-foreground)\">fully zoomed in</span>\n  </div>\n</div>\n","individual":false}]
