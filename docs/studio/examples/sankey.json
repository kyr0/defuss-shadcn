[{"label":"Industrial Schematic","html":"<section\n  class=\"presentation\"\n  id=\"deck-sankey\"\n  data-anim-in=\"slideIn\"\n  data-anim-in-distance=\"140px\"\n  data-anim-out=\"slideOut\"\n  data-anim-out-distance=\"140px\"\n  style=\"\n    --presentation-ink: #222a2f;\n    --presentation-ink-foreground: #e7e2d7;\n    --presentation-paper: #e7e2d7;\n    --presentation-paper-foreground: #222a2f;\n    --presentation-accent: #e0582d;\n    font-family:\n      Arial Narrow,\n      Arial,\n      sans-serif;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"Where a city’s waste goes - one year of material flows\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"A city’s 412 thousand tonnes of waste in one year as a Sankey diagram from three sources through six material streams to four outcomes: 144 thousand tonnes recycled, 68 composted, 159 burned for energy and 41 landfilled; then outcomes and recovery rate per stream\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Cover\">\n    <svg\n      aria-hidden=\"true\"\n      width=\"700\"\n      height=\"560\"\n      viewBox=\"0 0 700 560\"\n      style=\"position: absolute; right: 100px; top: 170px\"\n    >\n      <rect x=\"20\" y=\"40\" width=\"26\" height=\"200\" fill=\"#222A2F\" />\n      <rect x=\"20\" y=\"270\" width=\"26\" height=\"140\" fill=\"#222A2F\" />\n      <rect x=\"330\" y=\"20\" width=\"26\" height=\"150\" fill=\"#3D6E94\" />\n      <rect x=\"330\" y=\"200\" width=\"26\" height=\"120\" fill=\"#3D6E94\" />\n      <rect x=\"330\" y=\"350\" width=\"26\" height=\"90\" fill=\"#3D6E94\" />\n      <rect x=\"650\" y=\"60\" width=\"26\" height=\"220\" fill=\"#E0582D\" />\n      <rect x=\"650\" y=\"320\" width=\"26\" height=\"110\" fill=\"#E0582D\" />\n      <path d=\"M46 60 C 190 60, 190 40, 330 40 L330 150 C 190 150, 190 200, 46 200 Z\" fill=\"rgba(61,110,148,.25)\" />\n      <path d=\"M46 290 C 190 290, 190 220, 330 220 L330 300 C 190 300, 190 380, 46 380 Z\" fill=\"rgba(61,110,148,.25)\" />\n      <path d=\"M356 40 C 500 40, 500 80, 650 80 L650 250 C 500 250, 500 420, 356 420 Z\" fill=\"rgba(224,88,45,.22)\" />\n      <path d=\"M0 520 H700\" stroke=\"#222A2F\" stroke-width=\"2\" stroke-dasharray=\"10 8\" />\n    </svg>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\">Sankey · Industrial Schematic</p>\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        position: relative;\n        max-width: 1250px;\n        font-family:\n          DIN Condensed,\n          Arial Narrow,\n          Arial,\n          sans-serif;\n        font-weight: 800;\n        text-transform: uppercase;\n        letter-spacing: -0.01em;\n        line-height: 0.95;\n        font-size: 7rem;\n        max-width: 780px;\n      \"\n      >Where a city’s waste goes</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px; max-width: 700px\"\n      >412,000 tonnes a year - three sources, six streams, four ways out.</p\n    >\n    <p class=\"presentation-note\">The schematic on the cover is the Sankey without numbers.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"flow\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"All flows\"\n  >\n    <header class=\"presentation-header\"><span>Flows 2025</span><span>Thousand tonnes per year</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family:\n          DIN Condensed,\n          Arial Narrow,\n          Arial,\n          sans-serif;\n        font-weight: 800;\n        text-transform: uppercase;\n        letter-spacing: -0.01em;\n        line-height: 0.95;\n      \"\n      >From doorstep to destination</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\"\n      >Band width = tonnes. Left: who throws it away; middle: which bin; right: where it ends.</p\n    >\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"plastics\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Plastics\"\n  >\n    <header class=\"presentation-header\"><span>Flows 2025</span><span>Plastics highlighted</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family:\n          DIN Condensed,\n          Arial Narrow,\n          Arial,\n          sans-serif;\n        font-weight: 800;\n        text-transform: uppercase;\n        letter-spacing: -0.01em;\n        line-height: 0.95;\n      \"\n      >Plastics: only 40% come back</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Everything else fades - 25 of 42 kt of plastics are burned.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"outcomes\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Outcomes\"\n  >\n    <header class=\"presentation-header\"><span>Outcomes</span><span>Thousand tonnes per year</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family:\n          DIN Condensed,\n          Arial Narrow,\n          Arial,\n          sans-serif;\n        font-weight: 800;\n        text-transform: uppercase;\n        letter-spacing: -0.01em;\n        line-height: 0.95;\n      \"\n      >Half is recycled or composted</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The right-hand column of the Sankey becomes four bars.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Three numbers for the city council</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family:\n              DIN Condensed,\n              Arial Narrow,\n              Arial,\n              sans-serif;\n            font-weight: 800;\n            text-transform: uppercase;\n            letter-spacing: -0.01em;\n            line-height: 0.95;\n          \"\n          ><span data-count=\"412\">412</span> kt</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">of waste in one year</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #e0582d;\n            font-family:\n              DIN Condensed,\n              Arial Narrow,\n              Arial,\n              sans-serif;\n            font-weight: 800;\n            text-transform: uppercase;\n            letter-spacing: -0.01em;\n            line-height: 0.95;\n          \"\n          ><span data-count=\"51\">51</span>%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">recycled or composted</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family:\n              DIN Condensed,\n              Arial Narrow,\n              Arial,\n              sans-serif;\n            font-weight: 800;\n            text-transform: uppercase;\n            letter-spacing: -0.01em;\n            line-height: 0.95;\n          \"\n          ><span data-count=\"10\">10</span>%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">still ends in landfill</p>\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >The residual bin is the problem: 152 kt, and not one tonne of it is recovered as material.</p\n    >\n    <p class=\"presentation-note\">Where the remaining gains are.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Rooftops\">\n    <header class=\"presentation-header\"><span>Sources</span><span>Households: 238 kt</span></header>\n    <div style=\"display: flex; gap: 4.5rem; align-items: center; margin-top: 3.5rem\">\n      <div style=\"flex: 1 1 0; min-width: 0\">\n        <h2\n          class=\"presentation-title\"\n          data-df-entrance=\"up\"\n          style=\"\n            font-size: 3.4rem;\n            font-family:\n              DIN Condensed,\n              Arial Narrow,\n              Arial,\n              sans-serif;\n            font-weight: 800;\n            text-transform: uppercase;\n            letter-spacing: -0.01em;\n            line-height: 0.95;\n            font-size: 3.6rem;\n          \"\n          >It starts under these roofs</h2\n        >\n        <p class=\"presentation-lede\" data-df-entrance=\"fade\" style=\"--df-motion-delay: 300ms; font-size: 1.7rem\"\n          >Households produce 58% of the city’s waste - 238,000 tonnes, about 650 tonnes every day.</p\n        >\n      </div>\n      <figure\n        class=\"image\"\n        data-ratio=\"4/3\"\n        data-df-entrance=\"zoom-out\"\n        style=\"--df-motion-delay: 150ms; flex: 0 0 700px; margin: 0\"\n      >\n        <img\n          src=\"https://picsum.photos/id/188/960/720\"\n          alt=\"Snow-dusted rooftops of an old city under a grey winter sky, a church dome in the distance\"\n          loading=\"lazy\"\n          width=\"960\"\n          height=\"720\"\n          style=\"width: 100%; height: 100%; object-fit: cover\"\n        />\n        <figcaption class=\"image-caption\" style=\"font-size: 1.25rem\">Rooftops in winter (stock photo).</figcaption>\n      </figure>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The left edge of the Sankey is people.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"east\"\n    data-anim-in-blocks=\"5\"\n    data-anim-in-color=\"#E0582D\"\n    aria-label=\"Stream table\"\n  >\n    <header class=\"presentation-header\"><span>Streams</span><span>Thousand tonnes, 2025</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" style=\"font-size: 1.7rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Material streams and how much of each is recovered as material (synthetic).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Stream</th><th class=\"table-head\" style=\"text-align: right\">Collected</th\n            ><th class=\"table-head\" style=\"text-align: right\">Recovered</th\n            ><th class=\"table-head\" style=\"text-align: right\">Rate</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Residual</td><td class=\"table-cell\" style=\"text-align: right\">152</td\n            ><td class=\"table-cell\" style=\"text-align: right\">0</td\n            ><td class=\"table-cell\" style=\"text-align: right\">0%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Paper</td><td class=\"table-cell\" style=\"text-align: right\">82</td\n            ><td class=\"table-cell\" style=\"text-align: right\">74</td\n            ><td class=\"table-cell\" style=\"text-align: right\">90%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Organic</td><td class=\"table-cell\" style=\"text-align: right\">76</td\n            ><td class=\"table-cell\" style=\"text-align: right\">68</td\n            ><td class=\"table-cell\" style=\"text-align: right\">89%</td></tr\n          >\n          <tr class=\"table-row\" style=\"font-weight: 700\"\n            ><td class=\"table-cell\">Plastics</td><td class=\"table-cell\" style=\"text-align: right\">42</td\n            ><td class=\"table-cell\" style=\"text-align: right\">17</td\n            ><td class=\"table-cell\" style=\"text-align: right\">40%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Rubble</td><td class=\"table-cell\" style=\"text-align: right\">36</td\n            ><td class=\"table-cell\" style=\"text-align: right\">31</td\n            ><td class=\"table-cell\" style=\"text-align: right\">86%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Glass</td><td class=\"table-cell\" style=\"text-align: right\">24</td\n            ><td class=\"table-cell\" style=\"text-align: right\">22</td\n            ><td class=\"table-cell\" style=\"text-align: right\">92%</td></tr\n          >\n        </tbody>\n        <tfoot>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Total</td><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">412</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">212</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">51%</td></tr\n          >\n        </tfoot>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Organic “recovered” means composted.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"\n          font-size: 3.3rem;\n          line-height: 1.22;\n          font-family:\n            DIN Condensed,\n            Arial Narrow,\n            Arial,\n            sans-serif;\n          font-weight: 800;\n          text-transform: uppercase;\n          letter-spacing: -0.01em;\n          line-height: 0.95;\n          font-size: 3.2rem;\n          text-transform: none;\n        \"\n        >“A stacked bar told us the recycling rate. The Sankey told us which bin to fix - and that it is the grey\n        one.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #222a2f; color: #e0582d\"\n        ><span class=\"avatar-fallback\">JK</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Jonas Kranz<br /><span style=\"opacity: 0.7; font-size: 1.4rem\">Head of waste management - fictional</span></p\n      >\n    </div>\n    <p class=\"presentation-note\">Flows beat totals - the study’s thesis.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"rates\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Recovery rate\"\n  >\n    <header class=\"presentation-header\"><span>Streams</span><span>Share recovered as material</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family:\n          DIN Condensed,\n          Arial Narrow,\n          Arial,\n          sans-serif;\n        font-weight: 800;\n        text-transform: uppercase;\n        letter-spacing: -0.01em;\n        line-height: 0.95;\n      \"\n      >Four streams clear the target - plastics lag</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The same bars, now per stream, against the 65% target.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Questions from the council\"\n  >\n    <header class=\"presentation-header\"><span>Q & A</span><span>Council committee</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.2rem;\n        margin-block: 5.25rem 1.5rem;\n        font-family:\n          DIN Condensed,\n          Arial Narrow,\n          Arial,\n          sans-serif;\n        font-weight: 800;\n        text-transform: uppercase;\n        letter-spacing: -0.01em;\n        line-height: 0.95;\n        font-size: 3rem;\n      \"\n      >Questions from the council</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"sk-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Why is burning counted separately?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Energy recovery makes heat and power, but the material is gone - so it does not count toward recycling.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"sk-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>What is in the residual bin?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Sorting studies find about a third is organic waste that belongs in the brown bin.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"sk-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>What would moving that third change?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >About 50 kt more compost - the combined rate would rise from 51% to 64%.</p\n          ></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The residual bin question is the policy.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-dg-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Where a bin goes\"\n  >\n    <header class=\"presentation-header\"><span>Process</span><span>Where a bin goes</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 4.5rem 1.75rem;\n        max-width: 1300px;\n        font-family:\n          DIN Condensed,\n          Arial Narrow,\n          Arial,\n          sans-serif;\n        font-weight: 800;\n        text-transform: uppercase;\n        letter-spacing: -0.01em;\n        line-height: 0.95;\n      \"\n      >From the kerb to its outcome</h2\n    >\n    <div style=\"width: 960px; transform: scale(1.4); transform-origin: 0 0\">\n      <figure\n        class=\"diagram\"\n        id=\"waste-flow\"\n        data-type=\"flow\"\n        data-steps\n        data-interactive\n        data-autoplay=\"900\"\n        aria-label=\"The path of household and business waste through the city\"\n      >\n        <div\n          class=\"diagram-canvas\"\n          style=\"\n            --cols: 4;\n            --diagram-col-min: 7.5rem;\n            --diagram-node-w: 9rem;\n            --diagram-gap-x: 3.5rem;\n            --diagram-gap-y: 1.5rem;\n          \"\n        >\n          <div class=\"diagram-node\" data-node=\"homes\" data-step=\"1\" style=\"--col: 1; --row: 1\">\n            <span class=\"diagram-node-name\">Households</span>\n            <span class=\"diagram-node-meta\">bins · bags</span>\n          </div>\n          <div class=\"diagram-node\" data-node=\"business\" data-step=\"1\" style=\"--col: 1; --row: 3\">\n            <span class=\"diagram-node-name\">Businesses</span>\n            <span class=\"diagram-node-meta\">containers</span>\n          </div>\n          <div class=\"diagram-node\" data-node=\"collect\" data-step=\"2\" style=\"--col: 2; --row: 2\">\n            <span class=\"diagram-node-name\">Collection</span>\n            <span class=\"diagram-node-meta\">trucks · depots</span>\n          </div>\n          <div class=\"diagram-node\" data-node=\"sort\" data-tone=\"accent\" data-step=\"3\" style=\"--col: 3; --row: 2\">\n            <span class=\"diagram-node-name\">Sorting plant</span>\n            <span class=\"diagram-node-meta\">optical · manual</span>\n          </div>\n          <div class=\"diagram-node\" data-node=\"recycle\" data-tone=\"ok\" data-step=\"4\" style=\"--col: 4; --row: 1\">\n            <span class=\"diagram-node-name\">Recycling</span>\n            <span class=\"diagram-node-meta\">paper · glass · metal</span>\n          </div>\n          <div class=\"diagram-node\" data-node=\"energy\" data-step=\"4\" style=\"--col: 4; --row: 2\">\n            <span class=\"diagram-node-name\">Energy from waste</span>\n            <span class=\"diagram-node-meta\">heat · power</span>\n          </div>\n          <div class=\"diagram-node\" data-node=\"landfill\" data-tone=\"warn\" data-step=\"4\" style=\"--col: 4; --row: 3\">\n            <span class=\"diagram-node-name\">Landfill</span>\n            <span class=\"diagram-node-meta\">residue</span>\n          </div>\n        </div>\n        <ol class=\"diagram-edges\">\n          <li class=\"diagram-edge\" data-from=\"homes\" data-to=\"collect\" data-flow></li>\n          <li class=\"diagram-edge\" data-from=\"business\" data-to=\"collect\" data-flow></li>\n          <li class=\"diagram-edge\" data-from=\"collect\" data-to=\"sort\" data-flow>mixed</li>\n          <li class=\"diagram-edge\" data-from=\"sort\" data-to=\"recycle\" data-flow></li>\n          <li class=\"diagram-edge\" data-from=\"sort\" data-to=\"energy\" data-flow></li>\n          <li class=\"diagram-edge\" data-from=\"sort\" data-to=\"landfill\" data-flow></li>\n        </ol>\n      </figure>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\"\n      >The flow behind the Sankey as a process: collection, sorting, three outcomes - the tokens run the material\n      through.</p\n    >\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Takeaways</span><span>For the waste plan</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">▶</span\n        ><span>A Sankey shows where things go, not just how much there is.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">▶</span\n        ><span>Half the waste is recycled or composted; a tenth is landfilled.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">▶</span\n        ><span>Plastics recover 40% - the weakest separate stream.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">▶</span\n        ><span>Fix the residual bin: 152 kt with zero material recovery.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Short, schematic, actionable.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"west\"\n    data-anim-in-blocks=\"5\"\n    data-anim-in-color=\"#E0582D\"\n    aria-label=\"Closing\"\n  >\n    <svg\n      aria-hidden=\"true\"\n      width=\"700\"\n      height=\"560\"\n      viewBox=\"0 0 700 560\"\n      style=\"position: absolute; right: 100px; top: 170px\"\n    >\n      <rect x=\"20\" y=\"40\" width=\"26\" height=\"200\" fill=\"#222A2F\" />\n      <rect x=\"20\" y=\"270\" width=\"26\" height=\"140\" fill=\"#222A2F\" />\n      <rect x=\"330\" y=\"20\" width=\"26\" height=\"150\" fill=\"#3D6E94\" />\n      <rect x=\"330\" y=\"200\" width=\"26\" height=\"120\" fill=\"#3D6E94\" />\n      <rect x=\"330\" y=\"350\" width=\"26\" height=\"90\" fill=\"#3D6E94\" />\n      <rect x=\"650\" y=\"60\" width=\"26\" height=\"220\" fill=\"#E0582D\" />\n      <rect x=\"650\" y=\"320\" width=\"26\" height=\"110\" fill=\"#E0582D\" />\n      <path d=\"M46 60 C 190 60, 190 40, 330 40 L330 150 C 190 150, 190 200, 46 200 Z\" fill=\"rgba(61,110,148,.25)\" />\n      <path d=\"M46 290 C 190 290, 190 220, 330 220 L330 300 C 190 300, 190 380, 46 380 Z\" fill=\"rgba(61,110,148,.25)\" />\n      <path d=\"M356 40 C 500 40, 500 80, 650 80 L650 250 C 500 250, 500 420, 356 420 Z\" fill=\"rgba(224,88,45,.22)\" />\n      <path d=\"M0 520 H700\" stroke=\"#222A2F\" stroke-width=\"2\" stroke-dasharray=\"10 8\" />\n    </svg>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        font-family:\n          DIN Condensed,\n          Arial Narrow,\n          Arial,\n          sans-serif;\n        font-weight: 800;\n        text-transform: uppercase;\n        letter-spacing: -0.01em;\n        line-height: 0.95;\n        font-size: 7rem;\n      \"\n      >Follow the flow</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px; max-width: 700px\"\n      >Synthetic tonnages for a fictional city - the Sankey is the real way to show where things go.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">End on the rails.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 13</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"13\" value=\"1\"></progress>\n</section>\n","individual":false}]
