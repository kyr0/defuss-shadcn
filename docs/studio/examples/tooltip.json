[{"label":"Tooltip","html":"<div class=\"tooltip\" id=\"tip-default\" popover=\"hint\" role=\"tooltip\">Add to library</div>\n","individual":true},{"label":"Default","html":"<div style=\"display: flex; align-items: center; justify-content: center; gap: 1rem; padding: 2.5rem 0\">\n  <button class=\"btn\" data-variant=\"outline\" data-tooltip-trigger=\"tip-default\">Hover me</button>\n  <div class=\"tooltip\" id=\"tip-default\" popover=\"hint\" role=\"tooltip\">Add to library</div>\n</div>\n","individual":false},{"label":"Tooltip 2","html":"<div style=\"display: flex; align-items: center; justify-content: center; gap: 1rem; flex-wrap: wrap; padding: 2.5rem 0\">\n  <button class=\"btn\" data-variant=\"outline\" data-tooltip-trigger=\"tip-top\">Top</button>\n  <div class=\"tooltip\" id=\"tip-top\" popover=\"hint\" role=\"tooltip\">Top tooltip</div>\n  <button class=\"btn\" data-variant=\"outline\" data-tooltip-trigger=\"tip-bottom\">Bottom</button>\n  <div class=\"tooltip\" id=\"tip-bottom\" popover=\"hint\" role=\"tooltip\" data-side=\"bottom\">Bottom tooltip</div>\n  <button class=\"btn\" data-variant=\"outline\" data-tooltip-trigger=\"tip-left\">Left</button>\n  <div class=\"tooltip\" id=\"tip-left\" popover=\"hint\" role=\"tooltip\" data-side=\"left\">Left tooltip</div>\n  <button class=\"btn\" data-variant=\"outline\" data-tooltip-trigger=\"tip-right\">Right</button>\n  <div class=\"tooltip\" id=\"tip-right\" popover=\"hint\" role=\"tooltip\" data-side=\"right\">Right tooltip</div>\n</div>\n","individual":false},{"label":"Tooltip 3","html":"<div style=\"display: flex; align-items: center; justify-content: center; gap: 1rem; flex-wrap: wrap; padding: 2.5rem 0\">\n  <button class=\"btn\" data-variant=\"outline\" data-tooltip-trigger=\"tip-arrow-top\">Top</button>\n  <div class=\"tooltip\" id=\"tip-arrow-top\" popover=\"hint\" role=\"tooltip\"> Top with arrow <div data-arrow></div></div>\n  <button class=\"btn\" data-variant=\"outline\" data-tooltip-trigger=\"tip-arrow-bottom\">Bottom</button>\n  <div class=\"tooltip\" id=\"tip-arrow-bottom\" popover=\"hint\" role=\"tooltip\" data-side=\"bottom\">\n    Bottom with arrow <div data-arrow></div\n  ></div>\n  <button class=\"btn\" data-variant=\"outline\" data-tooltip-trigger=\"tip-arrow-left\">Left</button>\n  <div class=\"tooltip\" id=\"tip-arrow-left\" popover=\"hint\" role=\"tooltip\" data-side=\"left\">\n    Left with arrow <div data-arrow></div\n  ></div>\n  <button class=\"btn\" data-variant=\"outline\" data-tooltip-trigger=\"tip-arrow-right\">Right</button>\n  <div class=\"tooltip\" id=\"tip-arrow-right\" popover=\"hint\" role=\"tooltip\" data-side=\"right\">\n    Right with arrow <div data-arrow></div\n  ></div>\n</div>\n","individual":false},{"label":"With Keyboard Shortcut","html":"<div style=\"display: flex; align-items: center; justify-content: center; gap: 1rem; padding: 2.5rem 0\">\n  <button class=\"btn\" data-variant=\"outline\" data-tooltip-trigger=\"tip-kbd\"\n    ><i data-lucide=\"save\" style=\"width: 16px; height: 16px\"></i> Save\n  </button>\n  <div\n    class=\"tooltip\"\n    id=\"tip-kbd\"\n    popover=\"hint\"\n    role=\"tooltip\"\n    style=\"display: flex; align-items: center; gap: 0.5rem\"\n    data-side=\"bottom\"\n  >\n    Save document\n    <kbd\n      style=\"\n        font-size: 0.625rem;\n        padding: 0.125rem 0.375rem;\n        border-radius: var(--radius-sm);\n        background: oklch(from var(--primary-foreground) l c h / 0.15);\n        color: var(--primary-foreground);\n        font-family: var(--font-mono);\n        pointer-events: none;\n      \"\n      >⌘S</kbd\n    ></div\n  >\n</div>\n","individual":false},{"label":"Tooltip 5","html":"<div style=\"display: flex; align-items: center; justify-content: center; gap: 1rem; flex-wrap: wrap; padding: 2.5rem 0\">\n  <button class=\"btn\" data-variant=\"outline\" data-tooltip-trigger=\"tip-align-start\">Start</button>\n  <div class=\"tooltip\" id=\"tip-align-start\" popover=\"hint\" role=\"tooltip\" data-align=\"start\">\n    Aligned to start <div data-arrow></div\n  ></div>\n  <button class=\"btn\" data-variant=\"outline\" data-tooltip-trigger=\"tip-align-center\">Center</button>\n  <div class=\"tooltip\" id=\"tip-align-center\" popover=\"hint\" role=\"tooltip\">\n    Aligned to center <div data-arrow></div\n  ></div>\n  <button class=\"btn\" data-variant=\"outline\" data-tooltip-trigger=\"tip-align-end\">End</button>\n  <div class=\"tooltip\" id=\"tip-align-end\" popover=\"hint\" role=\"tooltip\" data-align=\"end\">\n    Aligned to end <div data-arrow></div\n  ></div>\n</div>\n","individual":false},{"label":"Tooltip 6","html":"<div style=\"display: flex; align-items: center; justify-content: center; gap: 1rem; padding: 2.5rem 0\">\n  <span data-tooltip-trigger=\"tip-disabled\" style=\"cursor: not-allowed\">\n    <button class=\"btn\" data-variant=\"outline\" disabled style=\"pointer-events: none\">Disabled</button>\n  </span>\n  <div class=\"tooltip\" id=\"tip-disabled\" popover=\"hint\" role=\"tooltip\">This action is unavailable</div>\n</div>\n","individual":false},{"label":"Tooltip 7","html":"<div style=\"display: flex; align-items: center; justify-content: center; gap: 1rem; flex-wrap: wrap; padding: 2.5rem 0\">\n  <button class=\"btn\" data-variant=\"outline\" data-tooltip-trigger=\"tip-instant\" data-delay=\"0\">Instant (0 ms)</button>\n  <div class=\"tooltip\" id=\"tip-instant\" popover=\"hint\" role=\"tooltip\">No delay!</div>\n  <button class=\"btn\" data-variant=\"outline\" data-tooltip-trigger=\"tip-fast\" data-delay=\"200\">Fast (200 ms)</button>\n  <div class=\"tooltip\" id=\"tip-fast\" popover=\"hint\" role=\"tooltip\">Fast tooltip</div>\n  <button class=\"btn\" data-variant=\"outline\" data-tooltip-trigger=\"tip-slow\" data-delay=\"1500\">Slow (1500 ms)</button>\n  <div class=\"tooltip\" id=\"tip-slow\" popover=\"hint\" role=\"tooltip\">Slow tooltip</div>\n</div>\n","individual":false},{"label":"Tooltip 8","html":"<div style=\"display: flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 2.5rem 0\">\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-tooltip-trigger=\"tip-g1\">\n    <i data-lucide=\"bold\" style=\"width: 14px; height: 14px\"></i>\n  </button>\n  <div class=\"tooltip\" id=\"tip-g1\" popover=\"hint\" role=\"tooltip\">Bold</div>\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-tooltip-trigger=\"tip-g2\">\n    <i data-lucide=\"italic\" style=\"width: 14px; height: 14px\"></i>\n  </button>\n  <div class=\"tooltip\" id=\"tip-g2\" popover=\"hint\" role=\"tooltip\">Italic</div>\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-tooltip-trigger=\"tip-g3\">\n    <i data-lucide=\"underline\" style=\"width: 14px; height: 14px\"></i>\n  </button>\n  <div class=\"tooltip\" id=\"tip-g3\" popover=\"hint\" role=\"tooltip\">Underline</div>\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-tooltip-trigger=\"tip-g4\">\n    <i data-lucide=\"strikethrough\" style=\"width: 14px; height: 14px\"></i>\n  </button>\n  <div class=\"tooltip\" id=\"tip-g4\" popover=\"hint\" role=\"tooltip\">Strikethrough</div>\n</div>\n","individual":false}]
