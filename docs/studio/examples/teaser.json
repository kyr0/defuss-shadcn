[{"label":"Default","html":"<section class=\"teaser\" id=\"teaser-demo\" aria-label=\"The quarterly report\">\n  <button class=\"play-button\" type=\"button\" aria-label=\"Show the quarterly report\"></button>\n  <h3 class=\"teaser-title\">The quarterly report</h3>\n  <p class=\"teaser-text\">Revenue, orders and returns - loaded when you ask for them.</p>\n  <template class=\"teaser-content\">\n    <div class=\"card\">\n      <div class=\"card-header\"\n        ><h3 class=\"card-title\">Q3 at a glance</h3><p class=\"card-description\">July to September</p></div\n      >\n      <div class=\"card-content\">\n        <table class=\"table\">\n          <thead\n            ><tr\n              ><th scope=\"col\">Month</th><th scope=\"col\" style=\"text-align: end\">Revenue</th\n              ><th scope=\"col\" style=\"text-align: end\">Orders</th></tr\n            ></thead\n          >\n          <tbody>\n            <tr><td>July</td><td style=\"text-align: end\">$41,200</td><td style=\"text-align: end\">1,204</td></tr>\n            <tr><td>August</td><td style=\"text-align: end\">$45,231</td><td style=\"text-align: end\">1,318</td></tr>\n            <tr><td>September</td><td style=\"text-align: end\">$48,960</td><td style=\"text-align: end\">1,402</td></tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n  </template>\n</section>\n","individual":true},{"label":"Attention: in an aura","html":"<div class=\"aura\" style=\"--shape-round: var(--radius-xl)\">\n  <section class=\"teaser\" data-ratio=\"16/9\" aria-label=\"The system in numbers - a presentation\">\n    <button class=\"play-button\" type=\"button\" data-size=\"lg\" data-pulse aria-label=\"Start the presentation\"></button>\n    <h3 class=\"teaser-title\">Click here to start the presentation!</h3>\n    <p class=\"teaser-text\">The system in numbers - every feature of defuss-shadcn, slide by slide.</p>\n    <template class=\"teaser-content\">\n      <iframe\n        src=\"deck-system-in-numbers.html\"\n        title=\"The System in Numbers\"\n        style=\"display: block; inline-size: 100%; aspect-ratio: 16/9; border: 0; border-radius: var(--radius-xl)\"\n      ></iframe>\n    </template>\n  </section>\n</div>\n","individual":true},{"label":"With a poster","html":"<section class=\"teaser\" data-ratio=\"16/9\" aria-label=\"The product tour\">\n  <img class=\"teaser-media\" src=\"images/mk-wide3.png\" alt=\"\" />\n  <button\n    class=\"play-button\"\n    type=\"button\"\n    data-variant=\"glass\"\n    data-size=\"lg\"\n    aria-label=\"Play the product tour\"\n  ></button>\n  <p class=\"teaser-title\">The product tour</p>\n  <p class=\"teaser-text\">Two minutes, no sign-up.</p>\n  <template class=\"teaser-content\">\n    <video\n      src=\"videos/demo.mp4\"\n      controls\n      autoplay\n      playsinline\n      style=\"inline-size: 100%; display: block; border-radius: var(--radius-xl)\"\n    ></video>\n  </template>\n</section>\n","individual":true}]
