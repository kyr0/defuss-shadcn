[{"label":"Media Timeline","html":"<div class=\"media-timeline\" id=\"mt-basic\" role=\"group\" aria-label=\"A day at the harbour\" data-state-demo>\n  \n</div>\n","individual":true},{"label":"Zoomed in","html":"<div class=\"media-timeline\" id=\"mt-zoom\" role=\"group\" aria-label=\"Harbour sounds\" data-zoom=\"60\">\n  <div class=\"media-timeline-header\">\n    <span class=\"media-timeline-title\">Sounds</span>\n    <output class=\"media-timeline-time\" data-media-timeline-output=\"time\">0:00</output>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"icon-sm\"\n      data-media-timeline-action=\"zoom-out\"\n      aria-label=\"Zoom out\"\n      ><i data-lucide=\"zoom-out\"></i\n    ></button>\n    <button class=\"btn\" data-variant=\"ghost\" data-size=\"icon-sm\" data-media-timeline-action=\"fit\" aria-label=\"Fit\"\n      ><i data-lucide=\"scan\"></i\n    ></button>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"icon-sm\"\n      data-media-timeline-action=\"zoom-in\"\n      aria-label=\"Zoom in\"\n      ><i data-lucide=\"zoom-in\"></i\n    ></button>\n  </div>\n  \n</div>\n","individual":true},{"label":"Annotation rows","html":"<div class=\"media-timeline\" id=\"mt-rows\" role=\"group\" aria-label=\"Harbour picture and sound, annotated\">\n  \n</div>\n","individual":true},{"label":"Time scales","html":"<div class=\"media-timeline\" id=\"mt-scales\" role=\"group\" aria-label=\"Minutes, seconds and frames\" data-zoom=\"120\">\n  \n</div>\n","individual":true},{"label":"Driving a video","html":"<div class=\"grid gap-3\" style=\"max-inline-size: 44rem\">\n  <figure class=\"video\" id=\"mt-video-player\">\n    <div class=\"video-frame\">\n      <video preload=\"metadata\" playsinline poster=\"videos/harbour-poster.jpg\">\n        <source src=\"videos/harbour.webm\" type=\"video/webm\" />\n        <source src=\"videos/harbour.mp4\" type=\"video/mp4\" />\n      </video>\n    </div>\n    <div class=\"video-controls\">\n      <button\n        class=\"btn\"\n        data-variant=\"ghost\"\n        data-size=\"icon-sm\"\n        data-video-action=\"toggle\"\n        aria-pressed=\"false\"\n        aria-label=\"Play\"\n      >\n        <i data-lucide=\"play\"></i><i data-lucide=\"pause\"></i>\n      </button>\n      <output class=\"video-time\" data-video-output=\"time\">0:00</output>\n      <input\n        class=\"slider\"\n        data-size=\"sm\"\n        type=\"range\"\n        min=\"0\"\n        max=\"24\"\n        step=\"0.1\"\n        value=\"0\"\n        data-video-action=\"seek\"\n        aria-label=\"Seek\"\n      />\n      <output class=\"video-time\" data-video-output=\"duration\">0:24</output>\n      <div class=\"video-volume\">\n        <button\n          class=\"btn\"\n          data-variant=\"ghost\"\n          data-size=\"icon-sm\"\n          data-video-action=\"mute\"\n          aria-pressed=\"false\"\n          aria-label=\"Mute\"\n        >\n          <i data-lucide=\"volume-2\"></i><i data-lucide=\"volume-x\"></i>\n        </button>\n        <div class=\"video-volume-panel\">\n          <input\n            class=\"slider\"\n            data-orientation=\"vertical\"\n            data-size=\"xs\"\n            type=\"range\"\n            min=\"0\"\n            max=\"1\"\n            step=\"0.05\"\n            value=\"1\"\n            data-video-action=\"volume\"\n            aria-label=\"Volume\"\n          />\n        </div>\n      </div>\n    </div>\n  </figure>\n  <div class=\"media-timeline\" id=\"mt-video\" role=\"group\" aria-label=\"Harbour timeline\" data-media=\"mt-video-player\">\n    \n  </div>\n</div>\n","individual":false},{"label":"Looping a region","html":"<div class=\"grid gap-3\" style=\"max-inline-size: 44rem\">\n  <figure class=\"video\" id=\"mt-loop-player\">\n    <div class=\"video-frame\">\n      <video preload=\"metadata\" playsinline poster=\"videos/harbour-poster.jpg\">\n        <source src=\"videos/harbour.webm\" type=\"video/webm\" />\n        <source src=\"videos/harbour.mp4\" type=\"video/mp4\" />\n      </video>\n    </div>\n    <div class=\"video-controls\">\n      <button\n        class=\"btn\"\n        data-variant=\"ghost\"\n        data-size=\"icon-sm\"\n        data-video-action=\"toggle\"\n        aria-pressed=\"false\"\n        aria-label=\"Play\"\n      >\n        <i data-lucide=\"play\"></i><i data-lucide=\"pause\"></i>\n      </button>\n      <output class=\"video-time\" data-video-output=\"time\">0:00</output>\n      <input\n        class=\"slider\"\n        data-size=\"sm\"\n        type=\"range\"\n        min=\"0\"\n        max=\"24\"\n        step=\"0.1\"\n        value=\"0\"\n        data-video-action=\"seek\"\n        aria-label=\"Seek\"\n      />\n      <output class=\"video-time\" data-video-output=\"duration\">0:24</output>\n    </div>\n  </figure>\n  <div\n    class=\"media-timeline\"\n    id=\"mt-loop\"\n    role=\"group\"\n    aria-label=\"Harbour timeline with a loop\"\n    data-media=\"mt-loop-player\"\n  >\n    <div class=\"media-timeline-header\">\n      <span class=\"media-timeline-title\">Drag on the ruler to loop</span>\n      <output class=\"media-timeline-time\" data-media-timeline-output=\"loop\"></output>\n      <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-media-timeline-action=\"loop-clear\" disabled>\n        <i data-lucide=\"repeat\"></i> Clear loop\n      </button>\n    </div>\n    \n  </div>\n</div>\n","individual":false},{"label":"Analysis layers","html":"<div class=\"grid gap-3\" style=\"max-inline-size: 44rem\">\n  <div class=\"audio\" id=\"mt-audio-player\" role=\"group\" aria-label=\"A day at the harbour\">\n    <audio preload=\"metadata\" src=\"videos/harbour.mp3\"></audio>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"icon\"\n      data-audio-action=\"toggle\"\n      aria-pressed=\"false\"\n      aria-label=\"Play\"\n    >\n      <i data-lucide=\"play\"></i><i data-lucide=\"pause\"></i>\n    </button>\n    <div class=\"audio-body\">\n      <span class=\"audio-title\">A day at the harbour - field recording</span>\n      <div class=\"audio-progress\">\n        <output class=\"audio-time\" data-audio-output=\"time\">0:00</output>\n        <input\n          class=\"slider\"\n          data-size=\"sm\"\n          type=\"range\"\n          min=\"0\"\n          max=\"24\"\n          step=\"0.1\"\n          value=\"0\"\n          data-audio-action=\"seek\"\n          aria-label=\"Seek\"\n        />\n        <output class=\"audio-time\" data-audio-output=\"duration\">0:24</output>\n      </div>\n    </div>\n  </div>\n  <div class=\"media-timeline\" id=\"mt-audio\" role=\"group\" aria-label=\"Sound analysis\" data-media=\"mt-audio-player\">\n    <div class=\"media-timeline-header\">\n      <span class=\"media-timeline-title\">Sound analysis</span>\n      <output class=\"text-sm text-muted-foreground\" data-media-timeline-output=\"active\"></output>\n    </div>\n    \n  </div>\n</div>\n","individual":false},{"label":"Information sidebar","html":"<div class=\"border-layout\" style=\"height: 36rem\">\n  <main class=\"border-layout-center border-layout-pane\" style=\"display: grid; place-items: center\">\n    <figure class=\"video\" id=\"mt-side-player\" style=\"max-inline-size: 36rem\">\n      <div class=\"video-frame\">\n        <video preload=\"metadata\" playsinline poster=\"videos/harbour-poster.jpg\">\n          <source src=\"videos/harbour.webm\" type=\"video/webm\" />\n          <source src=\"videos/harbour.mp4\" type=\"video/mp4\" />\n        </video>\n      </div>\n      <div class=\"video-controls\">\n        <button\n          class=\"btn\"\n          data-variant=\"ghost\"\n          data-size=\"icon-sm\"\n          data-video-action=\"toggle\"\n          aria-pressed=\"false\"\n          aria-label=\"Play\"\n        >\n          <i data-lucide=\"play\"></i><i data-lucide=\"pause\"></i>\n        </button>\n        <output class=\"video-time\" data-video-output=\"time\">0:00</output>\n        <input\n          class=\"slider\"\n          data-size=\"sm\"\n          type=\"range\"\n          min=\"0\"\n          max=\"24\"\n          step=\"0.1\"\n          value=\"0\"\n          data-video-action=\"seek\"\n          aria-label=\"Seek\"\n        />\n        <output class=\"video-time\" data-video-output=\"duration\">0:24</output>\n      </div>\n    </figure>\n  </main>\n  <div class=\"resizer border-layout-east\">\n    <aside\n      class=\"border-layout-pane\"\n      style=\"width: 17rem; display: grid; gap: 1rem; align-content: start; overflow: auto\"\n      aria-label=\"At the playhead\"\n    >\n      <div style=\"display: grid; gap: 0.75rem\" data-media-timeline-for=\"mt-side\" data-media-timeline-outlet=\"info\">\n        <p class=\"text-sm text-muted-foreground m-0\"\n          >Play the clip or click the timeline - what happens at the playhead shows here.</p\n        >\n      </div>\n      <section style=\"display: grid; gap: 0.375rem\">\n        <h3 class=\"text-sm font-medium m-0\">Log</h3>\n        <div data-media-timeline-for=\"mt-side\" data-media-timeline-outlet=\"events\">\n          <p class=\"text-sm text-muted-foreground m-0\">Nothing logged.</p>\n        </div>\n      </section>\n    </aside>\n  </div>\n  <div class=\"border-layout-south border-layout-pane\" data-fit>\n    <div class=\"media-timeline\" id=\"mt-side\" role=\"group\" aria-label=\"Harbour timeline\" data-media=\"mt-side-player\">\n      \n    </div>\n  </div>\n</div>\n","individual":false},{"label":"Captions from the metadata","html":"<div class=\"grid gap-3\" style=\"max-inline-size: 44rem\">\n  <figure class=\"video\" id=\"mt-cc-player\" data-variant=\"overlay\">\n    <div class=\"video-frame\">\n      <video preload=\"metadata\" playsinline poster=\"videos/harbour-poster.jpg\">\n        <source src=\"videos/harbour.webm\" type=\"video/webm\" />\n        <source src=\"videos/harbour.mp4\" type=\"video/mp4\" />\n      </video>\n      <div class=\"video-captions\"></div>\n    </div>\n    <div class=\"video-controls\">\n      <button\n        class=\"btn\"\n        data-variant=\"ghost\"\n        data-size=\"icon-sm\"\n        data-video-action=\"toggle\"\n        aria-pressed=\"false\"\n        aria-label=\"Play\"\n      >\n        <i data-lucide=\"play\"></i><i data-lucide=\"pause\"></i>\n      </button>\n      <output class=\"video-time\" data-video-output=\"time\">0:00</output>\n      <input\n        class=\"slider\"\n        data-size=\"sm\"\n        type=\"range\"\n        min=\"0\"\n        max=\"24\"\n        step=\"0.1\"\n        value=\"0\"\n        data-video-action=\"seek\"\n        aria-label=\"Seek\"\n      />\n      <output class=\"video-time\" data-video-output=\"duration\">0:24</output>\n      <button\n        class=\"btn\"\n        data-variant=\"ghost\"\n        data-size=\"icon-sm\"\n        data-video-action=\"captions\"\n        aria-pressed=\"true\"\n        aria-label=\"Captions\"\n      >\n        <i data-lucide=\"captions-off\"></i><i data-lucide=\"captions\"></i>\n      </button>\n    </div>\n  </figure>\n  <div class=\"media-timeline\" id=\"mt-cc\" role=\"group\" aria-label=\"Captions timeline\" data-media=\"mt-cc-player\">\n    \n  </div>\n</div>\n","individual":false},{"label":"New data, same playhead","html":"<div class=\"grid gap-3\" style=\"max-inline-size: 44rem\">\n  <div class=\"audio\" id=\"mt-swap-player\" role=\"group\" aria-label=\"A day at the harbour\">\n    <audio preload=\"metadata\" src=\"videos/harbour.mp3\"></audio>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"icon\"\n      data-audio-action=\"toggle\"\n      aria-pressed=\"false\"\n      aria-label=\"Play\"\n    >\n      <i data-lucide=\"play\"></i><i data-lucide=\"pause\"></i>\n    </button>\n    <div class=\"audio-body\">\n      <div class=\"audio-progress\">\n        <output class=\"audio-time\" data-audio-output=\"time\">0:00</output>\n        <input\n          class=\"slider\"\n          data-size=\"sm\"\n          type=\"range\"\n          min=\"0\"\n          max=\"24\"\n          step=\"0.1\"\n          value=\"0\"\n          data-audio-action=\"seek\"\n          aria-label=\"Seek\"\n        />\n        <output class=\"audio-time\" data-audio-output=\"duration\">0:24</output>\n      </div>\n    </div>\n  </div>\n  <div class=\"flex gap-2\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"mt-swap-scenes\">Scenes</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"mt-swap-sounds\">Sounds</button>\n  </div>\n  <div class=\"media-timeline\" id=\"mt-swap\" role=\"group\" aria-label=\"Harbour layers\" data-media=\"mt-swap-player\">\n    \n  </div>\n</div>\n","individual":false},{"label":"A bare video element","html":"<div class=\"grid gap-3\" style=\"max-inline-size: 44rem\">\n  <video\n    id=\"mt-bare-player\"\n    controls\n    preload=\"metadata\"\n    playsinline\n    poster=\"videos/harbour-poster.jpg\"\n    style=\"inline-size: 100%; border-radius: var(--radius-lg)\"\n  >\n    <source src=\"videos/harbour.webm\" type=\"video/webm\" />\n    <source src=\"videos/harbour.mp4\" type=\"video/mp4\" />\n  </video>\n  <div class=\"media-timeline\" id=\"mt-bare\" role=\"group\" aria-label=\"Harbour captions\" data-media=\"mt-bare-player\">\n    \n  </div>\n</div>\n","individual":false}]
