[{"label":"Default","html":"<section class=\"mk-profile-form\" aria-labelledby=\"pf-title\">\n  <h2 id=\"pf-title\" class=\"sr-only\">Profile settings</h2>\n  <form action=\"#\" method=\"post\">\n    <div class=\"mk-profile-form-section\">\n      <div><h2>Photo</h2><p>Shown next to everything you write.</p></div>\n      <div class=\"mk-profile-form-photo\">\n        <span class=\"avatar\" data-size=\"xl\"\n          ><img class=\"avatar-image\" src=\"images/mk-portrait2.png\" alt=\"Current photo\"\n        /></span>\n        <label class=\"btn mk-profile-form-upload\" data-variant=\"outline\" data-size=\"sm\"\n          ><i data-lucide=\"upload\"></i> Upload new<input type=\"file\" name=\"photo\" accept=\"image/*\"\n        /></label>\n        <button class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" type=\"button\">Remove</button>\n      </div>\n    </div>\n    <div class=\"mk-profile-form-section\">\n      <div><h2>Personal</h2><p>Your name as colleagues see it.</p></div>\n      <div class=\"mk-profile-form-fields\">\n        <div class=\"mk-profile-form-field\"\n          ><label class=\"label\" for=\"pf-first\">First name</label\n          ><input class=\"input\" id=\"pf-first\" name=\"given-name\" autocomplete=\"given-name\" value=\"Hannah\"\n        /></div>\n        <div class=\"mk-profile-form-field\"\n          ><label class=\"label\" for=\"pf-last\">Last name</label\n          ><input class=\"input\" id=\"pf-last\" name=\"family-name\" autocomplete=\"family-name\" value=\"Lee\"\n        /></div>\n        <div class=\"mk-profile-form-field\" data-span=\"full\"\n          ><label class=\"label\" for=\"pf-user\">Username</label\n          ><div class=\"mk-profile-form-prefix\"\n            ><span id=\"pf-user-prefix\">acme.com/</span\n            ><input\n              class=\"input\"\n              id=\"pf-user\"\n              name=\"username\"\n              autocomplete=\"username\"\n              value=\"hannahdesigns\"\n              pattern=\"[a-z0-9_]{3,20}\"\n              aria-describedby=\"pf-user-prefix pf-user-hint\" /></div\n          ><span class=\"mk-profile-form-hint\" id=\"pf-user-hint\">3–20 lowercase letters, numbers or _</span></div\n        >\n        <div class=\"mk-profile-form-field\" data-span=\"full\"\n          ><label class=\"label\" for=\"pf-bio\">Bio</label><textarea class=\"textarea\" id=\"pf-bio\" name=\"bio\" rows=\"3\" maxlength=\"160\" aria-describedby=\"pf-bio-hint\">\nMaking software quieter at Northwind.</textarea\n          ><span\n            class=\"mk-profile-form-hint\"\n            id=\"pf-bio-hint\"\n            >Up to 160 characters.</span\n          ></div\n        >\n      </div>\n    </div>\n    <div class=\"mk-profile-form-section\">\n      <div><h2>Details</h2><p>Optional.</p></div>\n      <div class=\"mk-profile-form-fields\">\n        <div class=\"mk-profile-form-field\"\n          ><label class=\"label\" for=\"pf-url\">Website</label\n          ><input class=\"input\" id=\"pf-url\" type=\"url\" name=\"url\" autocomplete=\"url\" placeholder=\"https://\"\n        /></div>\n        <div class=\"mk-profile-form-field\"\n          ><label class=\"label\" for=\"pf-tz\">Time zone</label\n          ><select class=\"select\" id=\"pf-tz\" name=\"tz\"\n            ><option>Europe/Lisbon (WEST)</option\n            ><option>Europe/Berlin (CEST)</option\n            ><option>America/Montreal (EDT)</option></select\n          ></div\n        >\n      </div>\n    </div>\n    <div class=\"mk-profile-form-actions\"\n      ><button class=\"btn\" data-variant=\"ghost\" type=\"reset\">Cancel</button\n      ><button class=\"btn\" type=\"submit\">Save changes</button></div\n    >\n  </form>\n</section>\n","individual":true}]
