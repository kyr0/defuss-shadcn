 <i data-lucide=\"undo-2\"></i>\n  </button>\n  <button class=\"btn\" data-variant=\"ghost\" data-size=\"icon\" aria-label=\"Redo\">\n    <i data-lucide=\"redo-2\"></i>\n  </button>\n  <div class=\"separator\" data-orientation=\"vertical\" role=\"separator\"></div>\n  <button class=\"btn\" data-variant=\"ghost\" data-size=\"icon\" aria-label=\"Copy\">\n    <i data-lucide=\"copy\"></i>\n  </button>\n  <button class=\"btn\" data-variant=\"ghost\" data-size=\"icon\" aria-label=\"Cut\">\n    <i data-lucide=\"scissors\"></i>\n  </button>\n  <button class=\"btn\" data-variant=\"ghost\" data-size=\"icon\" aria-label=\"Paste\">\n    <i data-lucide=\"clipboard-paste\"></i>\n  </button>\n</div>\n","individual":true},{"label":"Sizes","html":"<div class=\"flex flex-wrap gap-4\" style=\"align-items: flex-start\">\n  <div class=\"toolbar\" role=\"toolbar\" aria-label=\"Size xs\" data-size=\"xs\">\n    <button class=\"btn\" type=\"button\">xs</button>\n    <div class=\"separator\" data-orientation=\"vertical\" role=\"separator\"></div>\n    <button class=\"toggle\" type=\"button\" aria-pressed=\"false\"><i data-lucide=\"bold\"></i></button>\n    <button class=\"toggle\" type=\"button\" aria-pressed=\"false\"><i data-lucide=\"italic\"></i></button>\n  </div>\n  <div class=\"toolbar\" role=\"toolbar\" aria-label=\"Size sm\" data-size=\"sm\">\n    <button class=\"btn\" type=\"button\">sm</button>\n    <div class=\"separator\" data-orientation=\"vertical\" role=\"separator\"></div>\n    <button class=\"toggle\" type=\"button\" aria-pressed=\"false\"><i data-lucide=\"bold\"></i></button>\n    <button class=\"toggle\" type=\"button\" aria-pressed=\"false\"><i data-lucide=\"italic\"></i></button>\n  </div>\n  <div class=\"toolbar\" role=\"toolbar\" aria-label=\"Size md\" data-size=\"md\">\n    <button class=\"btn\" type=\"button\">md</button>\n    <div class=\"separator\" data-orientation=\"vertical\" role=\"separator\"></div>\n    <button class=\"toggle\" type=\"button\" aria-pressed=\"false\"><i data-lucide=\"bold\"></i></button>\n    <button class=\"toggle\" type=\"button\" aria-pressed=\"false\"><i data-lucide=\"italic\"></i></button>\n  </div>\n  <div class=\"toolbar\" role=\"toolbar\" aria-label=\"Size lg\" data-size=\"lg\">\n    <button class=\"btn\" type=\"button\">lg</button>\n    <div class=\"separator\" data-orientation=\"vertical\" role=\"separator\"></div>\n    <button class=\"toggle\" type=\"button\" aria-pressed=\"false\"><i data-lucide=\"bold\"></i></button>\n    <button class=\"toggle\" type=\"button\" aria-pressed=\"false\"><i data-lucide=\"italic\"></i></button>\n  </div>\n  <div class=\"toolbar\" role=\"toolbar\" aria-label=\"Size xl\" data-size=\"xl\">\n    <button class=\"btn\" type=\"button\">xl</button>\n    <div class=\"separator\" data-orientation=\"vertical\" role=\"separator\"></div>\n    <button class=\"toggle\" type=\"button\" aria-pressed=\"false\"><i data-lucide=\"bold\"></i></button>\n    <button class=\"toggle\" type=\"button\" aria-pressed=\"false\"><i data-lucide=\"italic\"></i></button>\n  </div>\n</div>\n","individual":false}]
