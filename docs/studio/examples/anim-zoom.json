[{"label":"In / out, origin and lifecycle","html":"<style>\n  .anim-zoom-box {\n    width: 160px;\n    height: 100px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    background: var(--card);\n    color: var(--card-foreground);\n    font-weight: 600;\n  }\n</style>\n<div style=\"display: flex; flex-direction: column; gap: 0.85rem; align-items: flex-start\">\n  <div id=\"anim-zoom-target\" class=\"anim-zoom-box\">zoom me</div>\n  <div style=\"display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-zoom-in\">In</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-zoom-out\">Out</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-zoom-pause\">Pause</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-zoom-resume\">Resume</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-zoom-finish\">Finish</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-zoom-reset\">Reset</button>\n  </div>\n  <div style=\"display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center\">\n    <label class=\"text-sm\" for=\"anim-zoom-duration\">Duration</label>\n    <input class=\"input\" id=\"anim-zoom-duration\" type=\"number\" min=\"0\" step=\"50\" value=\"1500\" style=\"width: 6rem\" />\n    <label class=\"text-sm\" for=\"anim-zoom-origin\">Origin</label>\n    <select class=\"select\" id=\"anim-zoom-origin\">\n      <option value=\"50% 50%\" selected>center</option>\n      <option value=\"0% 0%\">top-left</option>\n      <option value=\"100% 100%\">bottom-right</option>\n    </select>\n    <label class=\"text-sm\" for=\"anim-zoom-easing\">Easing</label>\n    <select class=\"select\" id=\"anim-zoom-easing\">\n      <option value=\"cubic-bezier(0.16, 1, 0.3, 1)\" selected>ease-out (default)</option>\n      <option value=\"linear\">linear</option>\n      <option value=\"ease-in-out\">ease-in-out</option>\n      <option value=\"cubic-bezier(0.34, 1.56, 0.64, 1)\">springy</option>\n    </select>\n  </div>\n</div>\n","individual":false},{"label":"Scroll binding","html":"<style>\n  .anim-zoom-box {\n    width: 160px;\n    height: 100px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    background: var(--card);\n    color: var(--card-foreground);\n    font-weight: 600;\n  }\n</style>\n<div\n  id=\"anim-zoom-scroller\"\n  style=\"height: 220px; overflow-y: auto; border: 1px solid var(--border); border-radius: var(--radius-lg)\"\n>\n  <div style=\"height: 600px; display: flex; align-items: center; justify-content: center\">\n    <div id=\"anim-zoom-scroll-target\" class=\"anim-zoom-box\">scroll to grow</div>\n  </div>\n</div>\n","individual":false}]
