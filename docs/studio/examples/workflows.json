[{"label":"Headline studio","html":"<div class=\"grid gap-2\">\n  <div class=\"toolbar flex-wrap\" role=\"toolbar\" aria-label=\"Headline studio\">\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"studio\"\n      data-workflow-action=\"undo\"\n      >Undo</button\n    >\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"studio\"\n      data-workflow-action=\"redo\"\n      >Redo</button\n    >\n    <div class=\"separator\" data-orientation=\"vertical\" role=\"separator\"></div>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"studio\"\n      data-workflow-action=\"arrange\"\n      >Arrange</button\n    >\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"studio\"\n      data-workflow-action=\"group\"\n      >Group</button\n    >\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"studio\"\n      data-workflow-action=\"duplicate\"\n      >Duplicate</button\n    >\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"studio\"\n      data-workflow-action=\"delete\"\n      >Delete</button\n    >\n    <div class=\"separator\" data-orientation=\"vertical\" role=\"separator\"></div>\n    <button\n      class=\"btn\"\n      data-variant=\"outline\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"studio\"\n      data-workflow-action=\"readonly\"\n      aria-pressed=\"false\"\n      >Read only</button\n    >\n    <button class=\"btn\" data-size=\"sm\" type=\"button\" data-workflow-for=\"studio\" data-workflow-action=\"run\">Run</button>\n    <button\n      class=\"btn\"\n      data-variant=\"outline\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"studio\"\n      data-workflow-action=\"cancel\"\n      >Cancel</button\n    >\n  </div>\n  <div class=\"workflow\" id=\"studio\" aria-label=\"Headline studio\" style=\"--workflow-height: 30rem\"></div>\n  <div class=\"grid gap-2\" style=\"grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr))\">\n    <div class=\"card\">\n      <div class=\"card-header\"><h3 class=\"card-title\">Nodes</h3></div>\n      <div\n        class=\"card-content\"\n        style=\"max-block-size: 20rem; overflow: auto\"\n        data-workflow-for=\"studio\"\n        data-workflow-outlet=\"palette\"\n      ></div>\n    </div>\n    <div class=\"card\">\n      <div class=\"card-header\"><h3 class=\"card-title\">Outline</h3></div>\n      <div\n        class=\"card-content\"\n        style=\"max-block-size: 20rem; overflow: auto\"\n        data-workflow-for=\"studio\"\n        data-workflow-outlet=\"outline\"\n      ></div>\n    </div>\n    <div class=\"card\">\n      <div class=\"card-header\"><h3 class=\"card-title\">Inspector</h3></div>\n      <div\n        class=\"card-content\"\n        style=\"max-block-size: 20rem; overflow: auto\"\n        data-workflow-for=\"studio\"\n        data-workflow-outlet=\"inspector\"\n      ></div>\n    </div>\n  </div>\n  <p class=\"text-sm text-muted-foreground m-0\">\n    <span data-workflow-for=\"studio\" data-workflow-output=\"nodes\"></span> nodes,\n    <span data-workflow-for=\"studio\" data-workflow-output=\"edges\"></span> connections ·\n    <span data-workflow-for=\"studio\" data-workflow-output=\"selection\"></span> ·\n    <span data-workflow-for=\"studio\" data-workflow-output=\"zoom\"></span>\n  </p>\n</div>\n","individual":false}]
