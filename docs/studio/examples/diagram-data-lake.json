QL</li>\n      </ol>\n    </figure>\n  </div>\n  <section class=\"card panel\" id=\"dg-lake-edit-panel\" aria-labelledby=\"dg-lake-edit-title\" style=\"\">\n    <header class=\"panel-header\">\n      <i data-lucide=\"sliders-horizontal\" class=\"panel-icon\" aria-hidden=\"true\"></i>\n      <h3 class=\"panel-title\" id=\"dg-lake-edit-title\">Inspector</h3>\n      <div class=\"panel-tools\">\n        <button\n          type=\"button\"\n          class=\"btn panel-close\"\n          data-variant=\"ghost\"\n          data-size=\"icon-sm\"\n          aria-label=\"Close Inspector\"\n          ><i data-lucide=\"x\"></i\n        ></button>\n      </div>\n    </header>\n    <div class=\"panel-body\" data-flush>\n      <div\n        class=\"property-grid\"\n        id=\"dg-lake-edit-grid\"\n        data-frame=\"none\"\n        data-empty-text=\"Click a box or an arrow.\"\n        aria-label=\"Selection properties\"\n      ></div>\n    </div>\n  </section>\n</div>\n","individual":false}]
