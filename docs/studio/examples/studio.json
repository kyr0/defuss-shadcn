[{"label":"Studio","html":"<style>\n  /* the Studio's own glue: sizes and the example previews. Every control is a shipped component (Border Layout,\n     Panel, Toolbar, Button, Input, Select, Popover, Tree View, Property Grid, Tree Grid, Card, Dropdown, Badge)\n     around the Visual Editor and the HTML Preview Editor */\n  .studio {\n    height: var(--scaffold-height, 50rem);\n    background: var(--background);\n    color: var(--foreground);\n    font-size: 0.875rem;\n  }\n  /* the toolbar spans the north region (the region's divider is its edge) and wraps; its selects take their\n     content's width (a .select fills its line by default) */\n  .studio-bar {\n    flex-wrap: wrap;\n    width: auto;\n    gap: 0.375rem;\n    padding: 0.5rem 0.75rem;\n    border: 0;\n    border-radius: 0;\n  }\n  .studio-bar > .select {\n    width: auto;\n  }\n  .studio-main {\n    display: grid;\n    padding: 0.75rem;\n    background: var(--muted);\n  }\n  .studio-main > .visual-editor {\n    --visual-editor-height: 100%;\n  }\n  .studio-main > .code-example {\n    height: 100%;\n    margin: 0;\n  }\n  /* the canvas or the preview: the card's own display would show a hidden one */\n  .studio-main > [hidden] {\n    display: none;\n  }\n  /* the side views are Panels: minimized to their title bar, maximized over their column. The library's search\n     stays on top while the tree scrolls below it */\n  .studio-library-body {\n    display: flex;\n    flex-direction: column;\n    gap: 0.5rem;\n    padding: 0.5rem;\n  }\n  .studio-library-body > nav {\n    flex: 1;\n    min-height: 0;\n    overflow: auto;\n  }\n  /* the selection tree and the state fit their content - Border Layout regions with data-fit; dense rows: the tree\n     grid's row height is its documented custom property */\n  .studio-state-body > [hidden] {\n    display: none;\n  }\n  #studio-state {\n    --data-grid-row-height: 28px;\n    min-height: 0;\n  }\n  /* the class editor (a Combobox tag input) fills its cell: its field wraps the tags, never widens the table */\n  #studio-props .combobox {\n    inline-size: 100%;\n    min-inline-size: 0;\n  }\n  #studio-props .combobox-field-input {\n    min-inline-size: 3rem;\n  }\n  /* the HTML Preview Editor that runs the selected component (its State API, its render()) - out of sight */\n  .studio-runner {\n    position: absolute;\n    inset-inline-start: -10000px;\n    inset-block-start: 0;\n    width: 960px;\n    visibility: hidden;\n  }\n  /* the picked example: a static frame of its markup (styled, never run - as the canvas shows it), dragged by the\n     grip laid over the frame or clicked as a whole. The grip, not the example, is draggable: WebKit cancels the drag\n     of an element that holds an iframe (VERIFIED in Playwright's WebKit: tmp/probe-webkit-dnd.ts) */\n  .studio-sample-body {\n    scrollbar-gutter: stable;\n  }\n  .studio-sample {\n    display: grid;\n    gap: 0.25rem;\n    margin-block-end: 0.75rem;\n  }\n  .studio-sample-grip {\n    position: absolute;\n    inset: 0;\n    cursor: grab;\n  }\n  #studio-library [draggable='true'] {\n    cursor: grab;\n  }\n  .studio-sample > .btn {\n    justify-content: flex-start;\n    min-width: 0;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n  .studio-sample-view {\n    position: relative;\n    overflow: hidden;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-md);\n    background: var(--background);\n  }\n  .studio-sample:is(:hover, :focus-within) .studio-sample-view {\n    border-color: var(--ring);\n  }\n  .studio-sample-frame {\n    display: block;\n    border: 0;\n    transform-origin: 0 0;\n    pointer-events: none;\n  }\n</style>\n<div\n  class=\"border-layout studio\"\n  id=\"studio\"\n  data-frame=\"none\"\n  data-center-min=\"320\"\n  data-collapsible\n  data-save=\"studio-layout\"\n  data-density=\"compact\"\n>\n  <header class=\"border-layout-north\">\n    <div class=\"toolbar studio-bar\" role=\"toolbar\" aria-label=\"Studio\" data-size=\"sm\">\n      <button\n        class=\"btn\"\n        data-variant=\"ghost\"\n        data-size=\"icon-sm\"\n        type=\"button\"\n        aria-label=\"Components\"\n        aria-pressed=\"true\"\n        data-studio-fold=\"west\"\n      >\n        <i data-lucide=\"panel-left\"></i>\n      </button>\n      <strong>Studio</strong>\n      <input\n        class=\"input\"\n        data-size=\"sm\"\n        id=\"studio-name\"\n        aria-label=\"Project name\"\n        value=\"Untitled app\"\n        style=\"width: 10rem\"\n      />\n      <select class=\"select\" data-size=\"sm\" id=\"studio-projects\" aria-label=\"Open a project\"></select>\n      <div class=\"separator\" data-orientation=\"vertical\" role=\"separator\"></div>\n      <select class=\"select\" data-size=\"sm\" id=\"studio-pages\" aria-label=\"Page\"></select>\n      <button\n        class=\"btn\"\n        data-variant=\"ghost\"\n        data-size=\"icon-sm\"\n        type=\"button\"\n        aria-label=\"Add a page\"\n        popovertarget=\"studio-add-page-pop\"\n      >\n        <i data-lucide=\"file-plus\"></i>\n      </button>\n      <div class=\"popover\" id=\"studio-add-page-pop\" popover>\n        <form class=\"flex gap-1\" id=\"studio-add-page\">\n          <input class=\"input\" data-size=\"sm\" name=\"name\" placeholder=\"New page\" aria-label=\"New page name\" required />\n          <button class=\"btn\" data-size=\"sm\" type=\"submit\">Add</button>\n        </form>\n      </div>\n      <button\n        class=\"btn\"\n        data-variant=\"ghost\"\n        data-size=\"icon-sm\"\n        type=\"button\"\n        aria-label=\"Remove this page\"\n        id=\"studio-remove-page\"\n      >\n        <i data-lucide=\"file-minus\"></i>\n      </button>\n      <div class=\"separator\" data-orientation=\"vertical\" role=\"separator\"></div>\n      <button\n        class=\"btn\"\n        data-variant=\"ghost\"\n        data-size=\"icon-sm\"\n        type=\"button\"\n        aria-label=\"Undo\"\n        data-visual-editor-for=\"studio-canvas\"\n        data-visual-editor-action=\"undo\"\n      >\n        <i data-lucide=\"undo-2\"></i>\n      </button>\n      <button\n        class=\"btn\"\n        data-variant=\"ghost\"\n        data-size=\"icon-sm\"\n        type=\"button\"\n        aria-label=\"Redo\"\n        data-visual-editor-for=\"studio-canvas\"\n        data-visual-editor-action=\"redo\"\n      >\n        <i data-lucide=\"redo-2\"></i>\n      </button>\n      <button\n        class=\"btn\"\n        data-variant=\"ghost\"\n        data-size=\"icon-sm\"\n        type=\"button\"\n        aria-label=\"Duplicate the selection\"\n        data-visual-editor-for=\"studio-canvas\"\n        data-visual-editor-action=\"duplicate\"\n      >\n        <i data-lucide=\"copy\"></i>\n      </button>\n      <button\n        class=\"btn\"\n        data-variant=\"ghost\"\n        data-size=\"icon-sm\"\n        type=\"button\"\n        aria-label=\"Remove the selection\"\n        data-visual-editor-for=\"studio-canvas\"\n        data-visual-editor-action=\"remove\"\n      >\n        <i data-lucide=\"trash-2\"></i>\n      </button>\n      <select\n        class=\"select\"\n        data-size=\"sm\"\n        aria-label=\"Device\"\n        data-visual-editor-for=\"studio-canvas\"\n        data-visual-editor-action=\"device\"\n      >\n        <option value=\"desktop\">Desktop</option>\n        <option value=\"tablet\">Tablet</option>\n        <option value=\"phone\">Phone</option>\n      </select>\n      <div class=\"separator\" data-orientation=\"vertical\" role=\"separator\"></div>\n      <button\n        class=\"btn\"\n        data-variant=\"outline\"\n        data-size=\"sm\"\n        type=\"button\"\n        id=\"studio-preview-toggle\"\n        aria-pressed=\"false\"\n      >\n        <i data-lucide=\"play\"></i> Preview\n      </button>\n      <button\n        class=\"btn\"\n        data-size=\"sm\"\n        type=\"button\"\n        aria-haspopup=\"menu\"\n        aria-expanded=\"false\"\n        aria-controls=\"studio-export\"\n        data-dropdown-trigger=\"studio-export\"\n      >\n        <i data-lucide=\"download\"></i> Export\n      </button>\n      <div id=\"studio-export\" role=\"menu\" popover class=\"dropdown-content\" aria-label=\"Export\">\n        <button role=\"menuitem\" class=\"dropdown-item\" tabindex=\"-1\" type=\"button\" data-export=\"page\"\n          >This page as HTML</button\n        >\n        <button role=\"menuitem\" class=\"dropdown-item\" tabindex=\"-1\" type=\"button\" data-export=\"zip\"\n          >The app as a ZIP</button\n        >\n        <button role=\"menuitem\" class=\"dropdown-item\" tabindex=\"-1\" type=\"button\" data-export=\"json\"\n          >The project as JSON</button\n        >\n        <button role=\"menuitem\" class=\"dropdown-item\" tabindex=\"-1\" type=\"button\" data-export=\"agent\"\n          >Copy for an agent</button\n        >\n        <div class=\"dropdown-separator\" role=\"separator\"></div>\n        <button role=\"menuitem\" class=\"dropdown-item\" tabindex=\"-1\" type=\"button\" data-export=\"open\"\n          >Open a project file...</button\n        >\n        <button role=\"menuitem\" class=\"dropdown-item\" tabindex=\"-1\" type=\"button\" data-export=\"new\">New project</button>\n      </div>\n      <input type=\"file\" id=\"studio-file\" accept=\"application/json,.json\" hidden />\n      <span class=\"badge\" data-variant=\"outline\" id=\"studio-status\" role=\"status\">Ready</span>\n      <button\n        class=\"btn\"\n        data-variant=\"ghost\"\n        data-size=\"icon-sm\"\n        type=\"button\"\n        aria-label=\"Inspector\"\n        aria-pressed=\"true\"\n        data-studio-fold=\"east\"\n        style=\"margin-inline-start: auto\"\n      >\n        <i data-lucide=\"panel-right\"></i>\n      </button>\n    </div>\n  </header>\n  <div class=\"resizer border-layout-west\" data-min=\"200\" data-max=\"520\">\n    <aside\n      class=\"border-layout\"\n      data-frame=\"none\"\n      data-save=\"studio-library\"\n      style=\"width: 15rem\"\n      aria-label=\"Components\"\n    >\n      <section\n        class=\"card panel border-layout-center\"\n        id=\"studio-library-panel\"\n        data-density=\"compact\"\n        aria-labelledby=\"studio-library-title\"\n      >\n        <header class=\"panel-header\">\n          <i data-lucide=\"book-open\" class=\"panel-icon\" aria-hidden=\"true\"></i>\n          <h3 class=\"panel-title\" id=\"studio-library-title\">Components</h3>\n          <div class=\"panel-tools\">\n            <label class=\"swap panel-maximize\">\n              <input type=\"checkbox\" aria-label=\"Maximize Components\" />\n              <span class=\"swap-off\"><i data-lucide=\"maximize-2\"></i></span>\n              <span class=\"swap-on\"><i data-lucide=\"minimize-2\"></i></span>\n            </label>\n          </div>\n        </header>\n        <div class=\"panel-body studio-library-body\">\n          <input\n            class=\"input\"\n            data-size=\"sm\"\n            type=\"search\"\n            id=\"studio-search\"\n            placeholder=\"Search components\"\n            aria-label=\"Search components\"\n          />\n          <nav id=\"studio-library\" aria-label=\"Components by section and page\" data-visual-editor-for=\"studio-canvas\">\n            <p class=\"text-muted-foreground\">Loading the components...</p>\n          </nav>\n        </div>\n      </section>\n      <div class=\"resizer border-layout-south\" data-min=\"96\">\n        <section\n          class=\"card panel\"\n          id=\"studio-example-panel\"\n          data-density=\"compact\"\n          style=\"height: 16rem\"\n          aria-labelledby=\"studio-sample-title\"\n        >\n          <header class=\"panel-header\">\n            <i data-lucide=\"eye\" class=\"panel-icon\" aria-hidden=\"true\"></i>\n            <h3 class=\"panel-title\" id=\"studio-sample-title\">Example</h3>\n            <div class=\"panel-tools\">\n              <label class=\"swap panel-maximize\">\n                <input type=\"checkbox\" aria-label=\"Maximize Example\" />\n                <span class=\"swap-off\"><i data-lucide=\"maximize-2\"></i></span>\n                <span class=\"swap-on\"><i data-lucide=\"minimize-2\"></i></span>\n              </label>\n              <label class=\"swap panel-minimize\">\n                <input type=\"checkbox\" aria-label=\"Minimize Example\" />\n                <span class=\"swap-off\"><i data-lucide=\"chevron-up\"></i></span>\n                <span class=\"swap-on\"><i data-lucide=\"chevron-down\"></i></span>\n              </label>\n            </div>\n          </header>\n          <div class=\"panel-body studio-sample-body\">\n            <p class=\"text-muted-foreground mb-2\">\n              Pick a component or an example above - or drag it from the tree. Drag it onto the page, or click it to\n              insert it at the selection.\n            </p>\n            <div id=\"studio-samples\" data-visual-editor-for=\"studio-canvas\" aria-label=\"The picked entry\"></div>\n          </div>\n        </section>\n      </div>\n    </aside>\n  </div>\n  <main class=\"border-layout-center studio-main\">\n    <div class=\"visual-editor\" id=\"studio-canvas\" aria-label=\"The page\">\n      \n    </div>\n    <div class=\"code-example\" id=\"studio-preview\" aria-label=\"Preview\" hidden><textarea></textarea></div>\n  </main>\n  <div class=\"resizer border-layout-east\" data-min=\"240\" data-max=\"640\">\n    <aside class=\"border-layout\" data-frame=\"none\" style=\"width: 19rem\" aria-label=\"Inspector\">\n      <section\n        class=\"card panel border-layout-north\"\n        id=\"studio-selection-panel\"\n        data-fit\n        data-density=\"compact\"\n        style=\"--border-layout-fit-min: 20cqh\"\n        aria-labelledby=\"studio-selection-title\"\n      >\n        <header class=\"panel-header\">\n          <i data-lucide=\"layers\" class=\"panel-icon\" aria-hidden=\"true\"></i>\n          <h3 class=\"panel-title\" id=\"studio-selection-title\">Selection</h3>\n          <div class=\"panel-tools\">\n            <label class=\"swap panel-maximize\">\n              <input type=\"checkbox\" aria-label=\"Maximize Selection\" />\n              <span class=\"swap-off\"><i data-lucide=\"maximize-2\"></i></span>\n              <span class=\"swap-on\"><i data-lucide=\"minimize-2\"></i></span>\n            </label>\n            <label class=\"swap panel-minimize\">\n              <input type=\"checkbox\" aria-label=\"Minimize Selection\" />\n              <span class=\"swap-off\"><i data-lucide=\"chevron-up\"></i></span>\n              <span class=\"swap-on\"><i data-lucide=\"chevron-down\"></i></span>\n            </label>\n          </div>\n        </header>\n        <div class=\"panel-body\"><div id=\"studio-tree\"></div></div>\n      </section>\n      <div class=\"border-layout border-layout-center\" data-frame=\"none\">\n        <section\n          class=\"card panel border-layout-center\"\n          id=\"studio-props-panel\"\n          data-density=\"compact\"\n          aria-labelledby=\"studio-props-title\"\n        >\n          <header class=\"panel-header\">\n            <i data-lucide=\"sliders-horizontal\" class=\"panel-icon\" aria-hidden=\"true\"></i>\n            <h3 class=\"panel-title\" id=\"studio-props-title\">Properties</h3>\n            <div class=\"panel-tools\">\n              <label class=\"swap panel-maximize\">\n                <input type=\"checkbox\" aria-label=\"Maximize Properties\" />\n                <span class=\"swap-off\"><i data-lucide=\"maximize-2\"></i></span>\n                <span class=\"swap-on\"><i data-lucide=\"minimize-2\"></i></span>\n              </label>\n            </div>\n          </header>\n          <div class=\"panel-body\">\n            <p class=\"text-muted-foreground mb-2\" id=\"studio-inspect-hint\">Select an element in the page.</p>\n            <div class=\"property-grid\" id=\"studio-props\" aria-label=\"The selected element\">\n              \n            </div>\n          </div>\n        </section>\n        <section\n          class=\"card panel border-layout-south\"\n          id=\"studio-state-panel\"\n          data-fit\n          data-density=\"compact\"\n          aria-labelledby=\"studio-state-title\"\n        >\n          <header class=\"panel-header\">\n            <i data-lucide=\"activity\" class=\"panel-icon\" aria-hidden=\"true\"></i>\n            <h3 class=\"panel-title\" id=\"studio-state-title\">State</h3>\n            <div class=\"panel-tools\">\n              <label class=\"swap panel-maximize\">\n                <input type=\"checkbox\" aria-label=\"Maximize State\" />\n                <span class=\"swap-off\"><i data-lucide=\"maximize-2\"></i></span>\n                <span class=\"swap-on\"><i data-lucide=\"minimize-2\"></i></span>\n              </label>\n              <label class=\"swap panel-minimize\">\n                <input type=\"checkbox\" aria-label=\"Minimize State\" />\n                <span class=\"swap-off\"><i data-lucide=\"chevron-up\"></i></span>\n                <span class=\"swap-on\"><i data-lucide=\"chevron-down\"></i></span>\n              </label>\n            </div>\n          </header>\n          <div class=\"panel-body studio-state-body\">\n            <div\n              class=\"data-grid\"\n              id=\"studio-state\"\n              aria-label=\"The state of the selected component\"\n              data-parent-field=\"parent\"\n              data-persist=\"none\"\n              hidden\n            >\n              <div class=\"data-grid-viewport\">\n                <div class=\"data-grid-head\">\n                  <div class=\"data-grid-row\">\n                    <div class=\"data-grid-header\" data-field=\"name\" data-width=\"9rem\">State</div>\n                    <div class=\"data-grid-header\" data-field=\"value\" data-width=\"8rem\">Value</div>\n                  </div>\n                </div>\n                <div class=\"data-grid-body\"></div>\n              </div>\n            </div>\n            <div class=\"card\" id=\"studio-stateless\" data-density=\"compact\">\n              <div class=\"card-header\">\n                <h4 class=\"card-title\">No state</h4>\n                <p class=\"card-description\" id=\"studio-stateless-text\">Select an element in the page.</p>\n              </div>\n            </div>\n          </div>\n        </section>\n      </div>\n    </aside>\n  </div>\n  <!-- the HTML Preview Editor that runs the selected component, out of sight - outside the panels, so a minimized\n       State panel never hides it -->\n  <div class=\"studio-runner\" id=\"studio-runner\" aria-hidden=\"true\" inert></div>\n</div>\n","individual":false}]
