[{"label":"Cyber Matrix","html":"<section\n  class=\"presentation\"\n  id=\"deck-heatmap\"\n  data-anim-in=\"skewIn\"\n  data-anim-out=\"blurOut\"\n  style=\"\n    --presentation-ink: #030410;\n    --presentation-ink-foreground: #ddfbff;\n    --presentation-paper: #07091b;\n    --presentation-paper-foreground: #ddfbff;\n    --presentation-accent: #00f5ff;\n    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"One week of alerts - a security operations deck\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Security alerts per hour over one week as a 7 by 24 heatmap: busy weekday office hours and one burst of 612 alerts on Tuesday at 03:00; then alerts by type and by hour\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Cover\">\n    <svg\n      aria-hidden=\"true\"\n      width=\"620\"\n      height=\"900\"\n      viewBox=\"0 0 620 900\"\n      style=\"position: absolute; right: 40px; top: 0; opacity: 0.55\"\n    >\n      <g fill=\"#00F5FF\" font-family=\"ui-monospace, Menlo, monospace\" font-size=\"26\">\n        <text x=\"40\" y=\"120\">0x3F 0xA1 0x00 0x7C</text>\n        <text x=\"40\" y=\"170\" opacity=\"0.6\">ALERT 03:00 TUE 612</text>\n        <text x=\"40\" y=\"220\" opacity=\"0.4\">0x9B 0x12 0xFF 0x03</text>\n        <text x=\"40\" y=\"270\" opacity=\"0.8\">auth.fail &gt;&gt; burst</text>\n        <text x=\"40\" y=\"320\" opacity=\"0.3\">0x44 0x5E 0x6D 0x21</text>\n        <text x=\"40\" y=\"370\" opacity=\"0.6\">geo=?? asn=?? rate=hi</text>\n      </g>\n      <rect\n        x=\"40\"\n        y=\"420\"\n        width=\"540\"\n        height=\"420\"\n        fill=\"none\"\n        stroke=\"#00F5FF\"\n        stroke-width=\"2\"\n        stroke-dasharray=\"6 10\"\n      />\n    </svg>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\">Heatmap matrix · Cyber Matrix</p>\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        position: relative;\n        max-width: 1250px;\n        font-weight: 700;\n        letter-spacing: -0.01em;\n        font-size: 6.25rem;\n        max-width: 850px;\n      \"\n      >One week of alerts</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >21,216 alerts, 168 hours - the pattern is the working week, the anomaly is 03:00.</p\n    >\n    <p class=\"presentation-note\">The readout is decoration; the heatmap is the evidence.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"week\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Week heatmap\"\n  >\n    <header class=\"presentation-header\"><span>SOC / week 42</span><span>Alerts per hour</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 700;\n        letter-spacing: -0.01em;\n      \"\n      >The alerts keep office hours</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Each cell is one hour. Bright = busy; the texture is the working week.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"burst\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"The burst\"\n  >\n    <header class=\"presentation-header\"><span>SOC / week 42</span><span>Anomaly</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 700;\n        letter-spacing: -0.01em;\n      \"\n      >Tuesday, 03:00 - ten times a normal night hour</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Everything else dims; one cell remains.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"types\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"By type\"\n  >\n    <header class=\"presentation-header\"><span>SOC / by type</span><span>Alerts per day by type</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 700;\n        letter-spacing: -0.01em;\n      \"\n      >It was brute force - 1,190 attempts on one day</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The same matrix, re-cut: rows are alert types now.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Three numbers from the SOC</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-weight: 700;\n            letter-spacing: -0.01em;\n          \"\n          ><span data-count=\"21216\">21216</span></p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">alerts in one week</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #00f5ff;\n            font-weight: 700;\n            letter-spacing: -0.01em;\n          \"\n          ><span data-count=\"612\">612</span></p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">alerts in the single hour Tue 03:00</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-weight: 700;\n            letter-spacing: -0.01em;\n          \"\n          ><span data-count=\"55\">55</span>%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">during weekday office hours</p>\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >Most alerts follow people. The dangerous ones follow nobody.</p\n    >\n    <p class=\"presentation-note\">The line to remember.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Night shift\" style=\"overflow: hidden\">\n    <video\n      autoplay\n      muted\n      loop\n      playsinline\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n        opacity: 0.55;\n        mix-blend-mode: screen;\n      \"\n    >\n      <source src=\"videos/demo.webm\" type=\"video/webm\" />\n      <source src=\"videos/demo.mp4\" type=\"video/mp4\" />\n    </video>\n    <div\n      aria-hidden=\"true\"\n      style=\"position: absolute; inset: 0; background: linear-gradient(90deg, #030410 35%, rgba(0, 245, 255, 0.18))\"\n    ></div>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\">Night shift</p>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"blur\"\n      style=\"position: relative; font-size: 5rem; max-width: 1100px; font-weight: 700; letter-spacing: -0.01em\"\n      >Nobody was watching at 03:00 - the rule was</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 400ms; position: relative; max-width: 900px\"\n      >An automated rate limit blocked the burst after 11 minutes; the analyst read the heatmap at 08:10.</p\n    >\n    <p class=\"presentation-note\">Ambient loop - the automation is the hero.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"north\"\n    data-anim-in-blocks=\"10\"\n    data-anim-in-stagger=\"30\"\n    data-anim-in-color=\"#00F5FF\"\n    aria-label=\"Alerts by type\"\n  >\n    <header class=\"presentation-header\"><span>SELECT type, day</span><span>Alerts per day</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" style=\"font-size: 1.7rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Alerts by type and weekday, week 42 (synthetic).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Type</th><th class=\"table-head\" style=\"text-align: right\">Mon</th\n            ><th class=\"table-head\" style=\"text-align: right\">Tue</th\n            ><th class=\"table-head\" style=\"text-align: right\">Wed</th\n            ><th class=\"table-head\" style=\"text-align: right\">Sat</th\n            ><th class=\"table-head\" style=\"text-align: right\">Week</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Phishing</td><td class=\"table-cell\" style=\"text-align: right\">980</td\n            ><td class=\"table-cell\" style=\"text-align: right\">870</td\n            ><td class=\"table-cell\" style=\"text-align: right\">820</td\n            ><td class=\"table-cell\" style=\"text-align: right\">210</td\n            ><td class=\"table-cell\" style=\"text-align: right\">4,660</td></tr\n          >\n          <tr class=\"table-row\" style=\"font-weight: 700\"\n            ><td class=\"table-cell\">Brute force</td><td class=\"table-cell\" style=\"text-align: right\">510</td\n            ><td class=\"table-cell\" style=\"text-align: right\">1,190</td\n            ><td class=\"table-cell\" style=\"text-align: right\">480</td\n            ><td class=\"table-cell\" style=\"text-align: right\">420</td\n            ><td class=\"table-cell\" style=\"text-align: right\">4,010</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Policy</td><td class=\"table-cell\" style=\"text-align: right\">830</td\n            ><td class=\"table-cell\" style=\"text-align: right\">690</td\n            ><td class=\"table-cell\" style=\"text-align: right\">760</td\n            ><td class=\"table-cell\" style=\"text-align: right\">310</td\n            ><td class=\"table-cell\" style=\"text-align: right\">4,490</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Malware</td><td class=\"table-cell\" style=\"text-align: right\">640</td\n            ><td class=\"table-cell\" style=\"text-align: right\">600</td\n            ><td class=\"table-cell\" style=\"text-align: right\">590</td\n            ><td class=\"table-cell\" style=\"text-align: right\">380</td\n            ><td class=\"table-cell\" style=\"text-align: right\">3,790</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Anomaly</td><td class=\"table-cell\" style=\"text-align: right\">613</td\n            ><td class=\"table-cell\" style=\"text-align: right\">438</td\n            ><td class=\"table-cell\" style=\"text-align: right\">597</td\n            ><td class=\"table-cell\" style=\"text-align: right\">409</td\n            ><td class=\"table-cell\" style=\"text-align: right\">3,611</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Exfiltration</td><td class=\"table-cell\" style=\"text-align: right\">120</td\n            ><td class=\"table-cell\" style=\"text-align: right\">110</td\n            ><td class=\"table-cell\" style=\"text-align: right\">95</td\n            ><td class=\"table-cell\" style=\"text-align: right\">60</td\n            ><td class=\"table-cell\" style=\"text-align: right\">655</td></tr\n          >\n        </tbody>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Selected days; the week column sums all seven.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"font-size: 3.3rem; line-height: 1.22; font-weight: 700; letter-spacing: -0.01em; font-size: 3rem\"\n        >“The heatmap turned a log file into a picture I could explain to the board in one sentence.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #00f5ff; color: #030410\"\n        ><span class=\"avatar-fallback\">NK</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Noor Khalil<br /><span style=\"opacity: 0.7; font-size: 1.4rem\">SOC lead - 3 years of week-42 reviews</span></p\n      >\n    </div>\n    <p class=\"presentation-note\">Texture as communication - the thesis.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"hourly\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Hourly profile\"\n  >\n    <header class=\"presentation-header\"\n      ><span>SOC / by hour</span><span>Alerts per hour of day, whole week</span></header\n    >\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 700;\n        letter-spacing: -0.01em;\n      \"\n      >Collapse the days: the 03:00 spike still stands out</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The matrix folds into 24 bars.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Questions from the board\"\n  >\n    <header class=\"presentation-header\"><span>Q & A</span><span>Risk committee</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"font-size: 3.2rem; margin-block: 5.25rem 1.5rem; font-weight: 700; letter-spacing: -0.01em\"\n      >Questions from the risk committee</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"hm-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Was anything breached?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >No - 1,190 failed logins, zero successful; the rate limit blocked the source range after 11 minutes.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"hm-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Why do alerts follow office hours?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Most are triggered by people: phishing clicks, policy violations, new devices.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"hm-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>What changes now?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Night-time thresholds drop by half, and the heatmap becomes the Monday stand-up slide.</p\n          ></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The breach question comes first - answer it first.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Takeaways</span><span>exit 0</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">></span\n        ><span>Turn tables into texture - patterns appear that rows hide.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">></span\n        ><span>Night-time alerts deserve their own, tighter thresholds.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">></span\n        ><span>Re-cut the same matrix by type to explain an anomaly.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">></span\n        ><span>Automate the first response; review the picture in daylight.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Four rules, terminal-style.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"south\"\n    data-anim-in-blocks=\"10\"\n    data-anim-in-stagger=\"30\"\n    data-anim-in-color=\"#00F5FF\"\n    aria-label=\"Closing\"\n  >\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        font-weight: 700;\n        letter-spacing: -0.01em;\n      \"\n      >Patterns appear when a table becomes texture</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px\"\n      >One synthetic week - the pattern-and-anomaly reading is the real skill.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">Fade to black on the last line.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 12</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"12\" value=\"1\"></progress>\n</section>\n","individual":false}]
