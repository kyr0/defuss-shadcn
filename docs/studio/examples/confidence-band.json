[{"label":"Scientific Journal","html":"<section\n  class=\"presentation\"\n  id=\"deck-band\"\n  data-anim-in=\"fadeIn\"\n  data-anim-out=\"fadeOut\"\n  style=\"\n    --presentation-ink: #17212b;\n    --presentation-ink-foreground: #fafaf8;\n    --presentation-paper: #fafaf8;\n    --presentation-paper-foreground: #17212b;\n    --presentation-accent: #b42025;\n    font-family: Charter, Georgia, 'Times New Roman', serif;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"Forecasting the flu season - a journal deck\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Weekly flu hospital admissions per 100,000: nine observed weeks, a median forecast peaking at 13 in week 13 with 50 and 90 percent bands, and realized values peaking at 15.1\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Cover\">\n    <p\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        right: 112px;\n        bottom: 90px;\n        margin: 0;\n        font-size: 1.35rem;\n        opacity: 0.6;\n        font-style: italic;\n      \"\n      >Fig. 1 - Weekly admissions per 100,000, season 2025/26</p\n    >\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\"\n      >Confidence band · Scientific Journal</p\n    >\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        position: relative;\n        max-width: 1250px;\n        font-weight: 600;\n        letter-spacing: -0.01em;\n        font-size: 5rem;\n        max-width: 1250px;\n      \"\n      >Forecasting the flu season - with the uncertainty drawn in</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >Nine observed weeks, eleven forecast weeks, and an honest check at the end.</p\n    >\n    <p class=\"presentation-note\">Journal register: calm type, one figure, one claim.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"observed\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Observed\"\n  >\n    <header class=\"presentation-header\"><span>Results</span><span>Admissions per 100,000 · weeks 1–9</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 600;\n        letter-spacing: -0.01em;\n      \"\n      >Admissions doubled every three weeks</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Start with what is known - nine weeks of data.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"forecast\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Forecast\"\n  >\n    <header class=\"presentation-header\"><span>Forecast</span><span>Median + 90% interval</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 600;\n        letter-spacing: -0.01em;\n      \"\n      >The model expects a peak around week 13</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The line extends; the band says how sure we are - not very, further out.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"bands\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Nested bands\"\n  >\n    <header class=\"presentation-header\"><span>Forecast</span><span>50% and 90% intervals</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 600;\n        letter-spacing: -0.01em;\n      \"\n      >Half the time, the truth lands in the dark band</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Two bands: the inner one is the coin flip, the outer one the safety margin.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Three numbers from the season</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #b42025;\n            font-weight: 600;\n            letter-spacing: -0.01em;\n          \"\n          ><span data-count=\"15.1\">15.1</span></p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\"\n          >admissions per 100,000 at the actual peak (week 13)</p\n        >\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-weight: 600;\n            letter-spacing: -0.01em;\n          \"\n          ><span data-count=\"11\">11</span>/11</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">forecast weeks inside the 90% band</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-weight: 600;\n            letter-spacing: -0.01em;\n          \"\n          ><span data-count=\"6\">6</span>/11</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\"\n          >inside the 50% band - as a 50% band should be</p\n        >\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >A 50% band that catches every week is too wide. Six of eleven is calibration, not luck.</p\n    >\n    <p class=\"presentation-note\">Calibration is the concept to land.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Surveillance\" style=\"overflow: hidden\">\n    <video\n      autoplay\n      muted\n      loop\n      playsinline\n      aria-hidden=\"true\"\n      style=\"position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.55\"\n    >\n      <source src=\"videos/demo.webm\" type=\"video/webm\" />\n      <source src=\"videos/demo.mp4\" type=\"video/mp4\" />\n    </video>\n    <div\n      aria-hidden=\"true\"\n      style=\"position: absolute; inset: 0; background: linear-gradient(90deg, #17212b 40%, rgba(23, 33, 43, 0.55))\"\n    ></div>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\">Methods</p>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"blur\"\n      style=\"position: relative; font-size: 5rem; max-width: 1100px; font-weight: 600; letter-spacing: -0.01em\"\n      >Every Monday, 142 hospitals report</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 400ms; position: relative; max-width: 900px\"\n      >The forecast is refit weekly on admissions, test positivity and school-holiday calendars.</p\n    >\n    <p class=\"presentation-note\">The loop is ambient - the data pipeline is the point.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"north\"\n    data-anim-in-blocks=\"5\"\n    data-anim-in-color=\"#B42025\"\n    aria-label=\"Forecast table\"\n  >\n    <header class=\"presentation-header\"><span>Table 1</span><span>Forecast vs realized</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" style=\"font-size: 1.45rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Weekly admissions per 100,000 - median forecast, 90% interval and realized value (synthetic).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Week</th><th class=\"table-head\" style=\"text-align: right\">Median</th\n            ><th class=\"table-head\" style=\"text-align: right\">90% interval</th\n            ><th class=\"table-head\" style=\"text-align: right\">Realized</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">10</td><td class=\"table-cell\" style=\"text-align: right\">11.0</td\n            ><td class=\"table-cell\" style=\"text-align: right\">9.7 – 12.3</td\n            ><td class=\"table-cell\" style=\"text-align: right\">10.7</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">11</td><td class=\"table-cell\" style=\"text-align: right\">12.1</td\n            ><td class=\"table-cell\" style=\"text-align: right\">9.9 – 14.3</td\n            ><td class=\"table-cell\" style=\"text-align: right\">13.4</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">12</td><td class=\"table-cell\" style=\"text-align: right\">12.8</td\n            ><td class=\"table-cell\" style=\"text-align: right\">9.7 – 15.9</td\n            ><td class=\"table-cell\" style=\"text-align: right\">13.9</td></tr\n          >\n          <tr class=\"table-row\" style=\"font-weight: 700\"\n            ><td class=\"table-cell\">13</td><td class=\"table-cell\" style=\"text-align: right\">13.0</td\n            ><td class=\"table-cell\" style=\"text-align: right\">9.1 – 16.9</td\n            ><td class=\"table-cell\" style=\"text-align: right\">15.1</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">14</td><td class=\"table-cell\" style=\"text-align: right\">12.6</td\n            ><td class=\"table-cell\" style=\"text-align: right\">8.1 – 17.1</td\n            ><td class=\"table-cell\" style=\"text-align: right\">13.1</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">16</td><td class=\"table-cell\" style=\"text-align: right\">10.4</td\n            ><td class=\"table-cell\" style=\"text-align: right\">5.3 – 15.5</td\n            ><td class=\"table-cell\" style=\"text-align: right\">11.8</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">18</td><td class=\"table-cell\" style=\"text-align: right\">7.4</td\n            ><td class=\"table-cell\" style=\"text-align: right\">2.5 – 12.3</td\n            ><td class=\"table-cell\" style=\"text-align: right\">8.4</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">20</td><td class=\"table-cell\" style=\"text-align: right\">4.8</td\n            ><td class=\"table-cell\" style=\"text-align: right\">0.8 – 8.8</td\n            ><td class=\"table-cell\" style=\"text-align: right\">2.6</td></tr\n          >\n        </tbody>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Selected weeks; the figure has all of them.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"font-size: 3.3rem; line-height: 1.22; font-weight: 600; letter-spacing: -0.01em; font-size: 2.9rem\"\n        >“The band is what let us open the overflow ward in week 11 instead of week 13. The line alone would have said\n        wait.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #b42025; color: #fafaf8\"\n        ><span class=\"avatar-fallback\">HA</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Dr. Hana Aziz<br /><span style=\"opacity: 0.7; font-size: 1.4rem\"\n          >Hospital capacity planning - 9 seasons forecast</span\n        ></p\n      >\n    </div>\n    <p class=\"presentation-note\">Uncertainty as a decision tool - the thesis of the talk.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"check\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Realized\"\n  >\n    <header class=\"presentation-header\"><span>Validation</span><span>Realized weeks over the forecast</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 600;\n        letter-spacing: -0.01em;\n      \"\n      >What actually happened: a higher peak, inside the band</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The realized weeks drop in as red dots.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Questions from reviewers\"\n  >\n    <header class=\"presentation-header\"><span>Peer review</span><span>Reviewer comments</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"font-size: 3.2rem; margin-block: 5.25rem 1.5rem; font-weight: 600; letter-spacing: -0.01em\"\n      >Questions from the reviewers</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"cb-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Why not a single number?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >A point forecast was off by 2.1 at the peak; planners need the range to size wards.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"cb-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Is the band symmetric?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Nearly - admissions cannot go below zero, so the lower edge compresses late in the season.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"cb-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>What drives the width?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Mostly timing: the model is surer about the height of the peak than about its week.</p\n          ></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Reviewers always ask for the point forecast.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Conclusions</span><span>Four findings</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">¶</span\n        ><span>Show uncertainty in the figure, not in a footnote.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">¶</span\n        ><span>Nested bands tell planners what is likely and what is possible.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">¶</span\n        ><span>Check calibration: about half the weeks belong outside a 50% band.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">¶</span\n        ><span>Decide on the band edge when the cost of being late is high.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Conclusions, journal-style.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"south\"\n    data-anim-in-blocks=\"5\"\n    data-anim-in-color=\"#B42025\"\n    aria-label=\"Closing\"\n  >\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        font-weight: 600;\n        letter-spacing: -0.01em;\n      \"\n      >Uncertainty belongs in the graphic</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px\"\n      >Synthetic season, real method - draw the band, then check it.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">Close on the method.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 12</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"12\" value=\"1\"></progress>\n</section>\n","individual":false}]
