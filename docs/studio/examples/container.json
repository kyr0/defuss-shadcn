[{"label":"▼ frame width - the boxes clamp at their caps and center ▼","html":"<div\n  class=\"container\"\n  style=\"\n    --layout-max: 36rem;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-md);\n    background: var(--background);\n  \"\n>\n  <p class=\"text-sm\" style=\"margin: 0; text-align: center\"\n    >Outer container: max-width clamps, gutters keep content off the edge.</p\n  >\n  <div\n    class=\"container\"\n    style=\"\n      --layout-max: 20rem;\n      margin-top: 0.75rem;\n      border: 1px dashed var(--border);\n      border-radius: var(--radius-md);\n      background: var(--background);\n    \"\n  >\n    <p class=\"text-sm text-muted-foreground\" style=\"margin: 0; text-align: center\"\n      >Nested: its own cap and gutter, not the outer ones.</p\n    >\n  </div>\n</div>\n","individual":true},{"label":"inline-size: 14rem - always below the 24rem threshold, stacked","html":"<style>\n  .cq-demo-row {\n    flex-direction: column;\n  }\n  @container layout (inline-size >= 24rem) {\n    .cq-demo-row {\n      flex-direction: row;\n      align-items: center;\n      justify-content: space-between;\n    }\n  }\n  /* the narrow box fixes its own width: a shrink-to-fit query wrapper needs\n     an externally determined inline size (that is the point of the demo) */\n  .cq-demo-narrow {\n    inline-size: 14rem;\n  }\n</style>\n<div class=\"query cq-demo-narrow demo-outline p-3\">\n  <div class=\"flex flex-col gap-2 cq-demo-row\">\n    <strong style=\"font-size: 0.875rem\">Workspace</strong>\n    <div class=\"flex flex-wrap gap-2\">\n      <button class=\"btn\" type=\"button\" data-size=\"sm\">Save</button>\n      <button class=\"btn\" type=\"button\" data-variant=\"outline\" data-size=\"sm\">Cancel</button>\n    </div>\n  </div>\n</div>\n","individual":true},{"label":"fluid - flips to a row at ≥ 24rem; switch the card to Phone to see it stack again","html":"<style>\n  .cq-demo-row {\n    flex-direction: column;\n  }\n  @container layou