[{"label":"Custom labels and a kept view","html":"<div\n  class=\"data-tree\"\n  id=\"dt-files\"\n  aria-label=\"Project files\"\n  data-persist=\"local\"\n  data-persist-key=\"docs:project-files\"\n  style=\"height: 16rem; max-width: 26rem; --data-tree-row-height: 30px\"\n></div>\n","individual":true},{"label":"Custom editors","html":"<div\n  class=\"data-tree\"\n  id=\"dt-labels\"\n  aria-label=\"Labels\"\n  data-editable\n  data-required\n  style=\"height: 15rem; max-width: 26rem\"\n></div>\n","individual":true},{"label":"Inline editing","html":"<div\n  class=\"data-tree\"\n  id=\"dt-rename\"\n  aria-label=\"Folders\"\n  data-editable\n  data-required\n  data-max-length=\"40\"\n  data-pattern=\"[^/]+\"\n  data-message=\"A name without slashes, 1 to 40 characters\"\n  style=\"height: 16rem; max-width: 26rem\"\n></div>\n<p class=\"text-sm\" style=\"margin-block-start: 0.5rem\"\n  ><output id=\"dt-rename-log\">Double-click a folder, or press F2.</output></p\n>\n","individual":false},{"label":"111,110 nodes","html":"<div class=\"flex flex-col gap-2\" style=\"max-width: 26rem\">\n  <input class=\"input\" data-tree-filter=\"dt-geo\" aria-label=\"Filter places\" placeholder=\"Filter places…\" />\n  <div\n    class=\"data-tree\"\n    id=\"dt-geo\"\n    aria-label=\"Places\"\n    data-empty-text=\"No place matches.\"\n    style=\"height: 20rem\"\n  ></div>\n  <p class=\"text-sm text-muted-foreground m-0\" id=\"dt-geo-line\" aria-live=\"polite\"></p>\n</div>\n","individual":false},{"label":"Selection drives a detail pane","html":"<div class=\"flex flex-wrap gap-4\">\n  <div class=\"flex flex-col gap-2\" style=\"flex: 1; min-width: 14rem\">\n    <select class=\"select\" aria-label=\"Sort\" id=\"dt-org-sort\">\n      <option value=\"\">Org chart order</option>\n      <option value=\"name:asc\">Name A–Z</option>\n      <option value=\"reports:desc\">Most reports first</option>\n    </select>\n    <div class=\"data-tree\" id=\"dt-org\" aria-label=\"Organization\" style=\"height: 16rem\"></div>\n  </div>\n  <div class=\"card\" style=\"flex: 1; min-width: 12rem\">\n    <div class=\"card-header\"\n      ><h3 class=\"card-title\" id=\"dt-org-name\">Pick someone</h3\n      ><p class=\"card-description\" id=\"dt-org-role\">Their role shows here.</p></div\n    >\n  </div>\n</div>\n","individual":false},{"label":"One open way","html":"<div class=\"flex flex-col gap-2\" style=\"max-width: 26rem\">\n  <form class=\"flex gap-2\" id=\"dt-way-form\">\n    <input class=\"input\" id=\"dt-way-input\" aria-label=\"A district\" value=\"District 7.4.61.3\" />\n    <button class=\"btn\" data-variant=\"outline\" type=\"submit\">Reveal</button>\n  </form>\n  <div\n    class=\"data-tree\"\n    id=\"dt-way\"\n    aria-label=\"Places, one way open\"\n    data-exclusive\n    data-persist=\"none\"\n    style=\"height: 16rem\"\n  ></div>\n  <p class=\"text-sm text-muted-foreground m-0\" id=\"dt-way-line\" aria-live=\"polite\"></p>\n</div>\n","individual":false},{"label":"Aggregated branches: 250,000 requests","html":"<div class=\"flex flex-col gap-2\" style=\"max-width: 34rem\">\n  <div class=\"flex flex-wrap items-center gap-3\">\n    <div class=\"switch-item flex items-center gap-2\">\n      <input class=\"switch\" type=\"checkbox\" role=\"switch\" id=\"dt-requests-slow\" />\n      <label for=\"dt-requests-slow\">Only slow requests</label>\n    </div>\n    <output class=\"text-sm text-muted-foreground\" id=\"dt-requests-line\" aria-live=\"polite\"\n      >Aggregating 250,000 requests…</output\n    >\n  </div>\n  <div class=\"data-tree\" id=\"dt-requests\" aria-label=\"Requests by service\" style=\"height: 18rem\"></div>\n</div>\n","individual":false},{"label":"Loading and empty","html":"<div class=\"flex flex-wrap gap-4\">\n  <div class=\"data-tree\" aria-label=\"Waiting for data\" style=\"height: 9rem; flex: 1; min-width: 12rem\"></div>\n  <div\n    class=\"data-tree\"\n    id=\"dt-none\"\n    aria-label=\"No matches\"\n    data-empty-text=\"Nothing matches 'zebra'.\"\n    style=\"height: 9rem; flex: 1; min-width: 12rem\"\n  ></div>\n</div>\n","individual":false}]
