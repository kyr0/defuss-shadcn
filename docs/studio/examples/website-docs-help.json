[{"label":"A docs page","html":"<div id=\"site-docs\" data-i18n-component style=\"display: flex; flex-direction: column; gap: 4rem; width: 100%\">\n  <div class=\"flex justify-end\" style=\"margin-block-end: -3rem\">\n    <select\n      class=\"select\"\n      data-size=\"sm\"\n      data-app-locale\n      aria-label=\"Language\"\n      data-i18n-aria-label-en=\"Language\"\n      data-i18n-aria-label-de=\"Sprache\"\n      style=\"width: auto\"\n    >\n      <option value=\"en\" lang=\"en\">English</option>\n      <option value=\"de\" lang=\"de\">Deutsch</option>\n    </select>\n  </div>\n  <div\n    style=\"\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));\n      gap: 2.5rem;\n      align-items: start;\n    \"\n  >\n    <div style=\"max-width: 16rem\">\n      <nav\n        class=\"mk-docs-navigation\"\n        aria-label=\"Documentation\"\n        data-i18n-aria-label-en=\"Documentation\"\n        data-i18n-aria-label-de=\"Dokumentation\"\n      >\n        <div class=\"mk-docs-navigation-top\">\n          <label class=\"sr-only\" for=\"dn-ver\">Version</label>\n          <select class=\"select\" id=\"dn-ver\"\n            ><option data-i18n-target=\"dh-1-1\">v4.0 (latest)</option\n            ><option>v3.9</option></select\n          >\n        </div>\n        <p class=\"mk-docs-navigation-heading\" data-i18n-target=\"dh-2-1\">Getting started</p>\n        <ul>\n          <li><a href=\"#/docs/introduction\" data-router-link>Introduction</a></li>\n          <li><a href=\"#/docs/installation\" data-router-link>Installation</a></li>\n          <li><a href=\"#/docs/quick-start\" data-router-link>Quick start</a></li>\n        </ul>\n        <details open>\n          <summary class=\"mk-docs-navigation-heading\" data-i18n-target=\"dh-3-1\">Guides</summary>\n          <ul>\n            <li><a href=\"#/docs/workspaces\" data-router-link>Workspaces</a></li>\n            <li\n              ><a href=\"#/docs/offline-sync\" data-router-link aria-current=\"page\"\n                >Offline sync\n                <span class=\"badge\" data-variant=\"secondary\" data-size=\"sm\" data-i18n-target=\"dh-19-1\">New</span></a\n              ></li\n            >\n            <li\n              ><a href=\"#/docs/permissions\" data-router-link>Permissions</a>\n              <ul\n                ><li><a href=\"#/docs/roles\" data-router-link>Roles</a></li\n                ><li><a href=\"#/docs/guests\" data-router-link>Guests</a></li></ul\n              >\n            </li>\n          </ul>\n        </details>\n        <details>\n          <summary class=\"mk-docs-navigation-heading\" data-i18n-target=\"dh-4-1\">API reference</summary>\n          <ul\n            ><li><a href=\"#/docs/authentication\" data-router-link>Authentication</a></li\n            ><li><a href=\"#/docs/api-docs\" data-router-link>Docs</a></li\n            ><li><a href=\"#/docs/tasks\" data-router-link>Tasks</a></li></ul\n          >\n        </details>\n      </nav>\n    </div>\n    <div style=\"grid-column: span 2; display: grid; gap: 1.5rem; min-width: 0\">\n      <article class=\"mk-docs-content\" aria-labelledby=\"dc-title\">\n        <nav\n          class=\"breadcrumb\"\n          aria-label=\"Breadcrumb\"\n          data-i18n-aria-label-en=\"Breadcrumb\"\n          data-i18n-aria-label-de=\"Pfad\"\n          ><ol class=\"breadcrumb-list\"\n            ><li class=\"breadcrumb-item\"><a class=\"breadcrumb-link\" href=\"#\">Docs</a></li\n            ><li class=\"breadcrumb-separator\" aria-hidden=\"true\">/</li\n            ><li class=\"breadcrumb-item\"\n              ><a class=\"breadcrumb-link\" href=\"#/\" data-router-link data-docs-crumb-section data-i18n-target=\"dh-3-2\"\n                >Guides</a\n              ></li\n            ><li class=\"breadcrumb-separator\" aria-hidden=\"true\">/</li\n            ><li class=\"breadcrumb-item\"\n              ><span class=\"breadcrumb-page\" aria-current=\"page\" data-docs-crumb>Offline sync</span></li\n            ></ol\n          ></nav\n        >\n        <h1 class=\"mk-docs-content-title\" id=\"dc-title\" data-docs-title>Offline sync</h1>\n        <p class=\"mk-docs-content-lead\" data-docs-article\n          >How Acme keeps working without a connection, and what happens when two people edit the same thing.</p\n        >\n        <div class=\"mk-docs-content-meta\" data-docs-article\n          ><span><span data-i18n-target=\"dh-5-1\">Updated</span> <time datetime=\"2026-09-28\">28 Sep 2026</time></span\n          ><span data-i18n-target=\"dh-6-1\">6 min read</span\n          ><a href=\"#\"><i data-lucide=\"pencil\"></i> <span data-i18n-target=\"dh-7-1\">Edit this page</span></a></div\n        >\n        <p class=\"mk-docs-content-lead\" data-docs-stub data-i18n-target=\"stub\" hidden\n          >This page has no article in this demo - Offline sync has one.</p\n        >\n        <div class=\"mk-docs-content-prose\" data-docs-article>\n          <p\n            >Every change you make is written to your device first. When you are back online, Acme sends the changes in\n            the order you made them - nothing waits for the network.</p\n          >\n          <h2 id=\"dc-enable\">Turn it on</h2>\n          <p\n            >Offline sync is on by default for new workspaces. For older ones, enable it in\n            <code>Settings → Sync</code> or with the CLI:</p\n          >\n          <pre><code>acme workspace sync --offline on</code></pre>\n          <aside class=\"mk-docs-content-callout\" role=\"note\"\n            ><i data-lucide=\"info\"></i\n            ><p\n              ><strong>Note:</strong> the first sync downloads the whole workspace - on a slow connection this can take\n              a few minutes.</p\n            ></aside\n          >\n          <h2 id=\"dc-conflicts\">Conflicts</h2>\n          <p\n            >When two people change the same field offline, the later change wins and the earlier one is kept in the\n            history:</p\n          >\n          <ul\n            ><li>Text merges character by character.</li\n            ><li>Fields like status keep the last value.</li\n            ><li>Deletions always win over edits.</li></ul\n          >\n          <table\n            ><thead\n              ><tr><th>Change</th><th>Resolution</th></tr></thead\n            ><tbody\n              ><tr><td>Both edit a paragraph</td><td>Merged</td></tr\n              ><tr><td>Both set a status</td><td>Latest wins</td></tr\n              ><tr><td>One deletes, one edits</td><td>Deleted</td></tr></tbody\n            ></table\n          >\n          <aside class=\"mk-docs-content-callout\" data-tone=\"warning\" role=\"note\"\n            ><i data-lucide=\"triangle-alert\"></i\n            ><p><strong>Warning:</strong> clearing your browser data before syncing deletes unsynced changes.</p></aside\n          >\n          <aside class=\"mk-docs-content-callout\" data-tone=\"tip\" role=\"note\"\n            ><i data-lucide=\"lightbulb\"></i\n            ><p><strong>Tip:</strong> the cloud icon in the header shows how many changes are waiting.</p></aside\n          >\n        </div>\n        <nav\n          class=\"mk-docs-content-pager\"\n          aria-label=\"Pagination\"\n          data-i18n-aria-label-en=\"Pagination\"\n          data-i18n-aria-label-de=\"Seiten\"\n          ><a href=\"#/docs/workspaces\" data-router-link rel=\"prev\"\n            ><small data-i18n-target=\"pager-prev\">Previous</small\n            ><strong>← <span data-docs-near>Workspaces</span></strong></a\n          ><a href=\"#/docs/permissions\" data-router-link rel=\"next\"\n            ><small data-i18n-target=\"pager-next\">Next</small\n            ><strong><span data-docs-near>Permissions</span> →</strong></a\n          ></nav\n        >\n      </article>\n      <figure class=\"mk-code-block\">\n        <div class=\"mk-code-block-head\">\n          <div class=\"mk-code-block-tabs\" role=\"radiogroup\" aria-label=\"Package manager\">\n            <label><input type=\"radio\" name=\"cb-pm\" value=\"npm\" checked />npm</label\n            ><label><input type=\"radio\" name=\"cb-pm\" value=\"pnpm\" />pnpm</label\n            ><label><input type=\"radio\" name=\"cb-pm\" value=\"bun\" />bun</label>\n          </div>\n          <button class=\"mk-code-block-copy\" type=\"button\" aria-label=\"Copy code\"><i data-lucide=\"copy\"></i></button>\n        </div>\n        <pre data-tab=\"npm\"><code><span>npm install defuss-shadcn</span></code></pre>\n        <pre data-tab=\"pnpm\"><code><span>pnpm add defuss-shadcn</span></code></pre>\n        <pre data-tab=\"bun\"><code><span>bun add defuss-shadcn</span></code></pre>\n        <span class=\"mk-code-block-status\" role=\"status\"></span>\n      </figure>\n    </div>\n  </div>\n  <header class=\"mk-release-header\">\n    <div class=\"mk-release-header-tags\"\n      ><code class=\"mk-release-header-version\">v4.0.0</code\n      ><span class=\"badge\" data-variant=\"default\" data-size=\"sm\" data-i18n-target=\"dh-8-1\">Major</span\n      ><span class=\"badge\" data-variant=\"outline\" data-size=\"sm\" data-i18n-target=\"dh-9-1\">2 breaking changes</span\n      ><time datetime=\"2026-09-28\">28 September 2026</time></div\n    >\n    <h1 class=\"mk-release-header-title\">Acme 4.0: offline sync for everyone</h1>\n    <p class=\"mk-release-header-summary\"\n      >The biggest release in two years: every workspace now works offline, search got three times faster, and the\n      editor learned tables.</p\n    >\n    <ul class=\"mk-release-header-highlights\">\n      <li\n        ><i data-lucide=\"wifi-off\"></i><strong data-i18n-target=\"dh-10-1\">Offline everywhere</strong\n        ><span data-i18n-target=\"dh-11-1\">Sync catches up on its own.</span></li\n      >\n      <li\n        ><i data-lucide=\"zap\"></i><strong data-i18n-target=\"dh-12-1\">3× faster search</strong\n        ><span data-i18n-target=\"dh-13-1\">Results while you type.</span></li\n      >\n      <li\n        ><i data-lucide=\"table\"></i><strong data-i18n-target=\"dh-14-1\">Tables in docs</strong\n        ><span data-i18n-target=\"dh-15-1\">Sort, filter, resize.</span></li\n      >\n    </ul>\n    <div class=\"mk-release-header-links\"\n      ><a class=\"btn\" href=\"#\"><i data-lucide=\"download\"></i> <span data-i18n-target=\"dh-16-1\">Download</span></a\n      ><a class=\"btn\" data-variant=\"outline\" href=\"#\" data-i18n-target=\"dh-17-1\">Full changelog</a\n      ><a class=\"btn\" data-variant=\"ghost\" href=\"#\"\n        ><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\">\n          <path\n            d=\"M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2.1c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5Z\"\n          />\n        </svg>\n        <span data-i18n-target=\"dh-18-1\">Source</span></a\n      ></div\n    >\n  </header>\n  <div style=\"width: 100%; max-width: 44rem\">\n    <article class=\"mk-release-item\">\n      <span class=\"mk-release-item-type\" data-type=\"new\" data-i18n-target=\"dh-19-2\">New</span>\n      <div class=\"mk-release-item-body\">\n        <h3 class=\"mk-release-item-title\" data-i18n-target=\"dh-14-2\">Tables in docs</h3>\n        <p class=\"mk-release-item-desc\"\n          >Insert a table with /table - sort, filter and resize columns. Paste from a spreadsheet and the structure\n          comes along.</p\n        >\n        <img class=\"mk-release-item-media\" src=\"https://picsum.photos/seed/rel-table/1000/500\" alt=\"\" />\n        <p class=\"mk-release-item-meta\"\n          ><a href=\"#\">#4812</a> ·\n          <span class=\"avatar\" data-size=\"xs\"><img class=\"avatar-image\" src=\"images/mk-portrait2.png\" alt=\"\" /></span>\n          by Hannah</p\n        >\n      </div>\n    </article>\n    <article class=\"mk-release-item\">\n      <span class=\"mk-release-item-type\" data-type=\"improved\" data-i18n-target=\"dh-20-1\">Improved</span>\n      <div class=\"mk-release-item-body\">\n        <h3 class=\"mk-release-item-title\">Search is three times faster</h3>\n        <p class=\"mk-release-item-desc\">Results appear while you type, even in workspaces with 100,000 docs.</p>\n        <p class=\"mk-release-item-meta\"\n          ><a href=\"#\">#4790</a> ·\n          <span class=\"avatar\" data-size=\"xs\"><img class=\"avatar-image\" src=\"images/mk-portrait.png\" alt=\"\" /></span> by\n          Sophie</p\n        >\n      </div>\n    </article>\n    <article class=\"mk-release-item\">\n      <span class=\"mk-release-item-type\" data-type=\"fixed\" data-i18n-target=\"dh-21-1\">Fixed</span>\n      <div class=\"mk-release-item-body\">\n        <h3 class=\"mk-release-item-title\">Sync no longer stalls after waking a laptop</h3>\n        <p class=\"mk-release-item-meta\"\n          ><a href=\"#\">#4801</a> ·\n          <span class=\"avatar\" data-size=\"xs\"><img class=\"avatar-image\" src=\"images/mk-portrait.png\" alt=\"\" /></span> by\n          Sophie</p\n        >\n      </div>\n    </article>\n    <article class=\"mk-release-item\">\n      <span class=\"mk-release-item-type\" data-type=\"breaking\" data-i18n-target=\"dh-22-1\">Breaking</span>\n      <div class=\"mk-release-item-body\">\n        <h3 class=\"mk-release-item-title\">API v1 tokens stop working on 1 December</h3>\n        <p class=\"mk-release-item-desc\"\n          >Create a v2 token in Settings → API; the old endpoints answer 410 after that date.</p\n        >\n        <p class=\"mk-release-item-meta\"><a href=\"#\">#4777</a></p>\n      </div>\n    </article>\n  </div>\n  <div class=\"mk-roadmap-board\">\n    <section aria-labelledby=\"rb-planned\"\n      ><h3 id=\"rb-planned\" data-i18n-target=\"dh-23-1\">Planned</h3>\n      <article class=\"mk-roadmap-item\" aria-labelledby=\"rm-1\">\n        <div class=\"mk-roadmap-item-top\"\n          ><span class=\"mk-roadmap-item-status\" data-status=\"planned\" data-i18n-target=\"dh-23-2\">Planned</span\n          ><span class=\"mk-roadmap-item-when\"><i data-lucide=\"calendar\"></i>Q1 2027</span></div\n        >\n        <h3 class=\"mk-roadmap-item-title\" id=\"rm-1\">Calendar view for tasks</h3>\n        <p class=\"mk-roadmap-item-desc\">See deadlines across projects in one month view.</p>\n        <div class=\"mk-roadmap-item-foot\">\n          <ul class=\"mk-roadmap-item-tags\"\n            ><li>Tasks</li></ul\n          >\n          <label class=\"mk-roadmap-item-vote\"\n            ><input type=\"checkbox\" name=\"vote\" value=\"rm-1\" /><i data-lucide=\"chevron-up\"></i><span>214</span\n            ><span class=\"sr-only\"> votes - vote for Calendar view for tasks</span></label\n          >\n        </div>\n      </article>\n      <article class=\"mk-roadmap-item\" aria-labelledby=\"rm-2\">\n        <div class=\"mk-roadmap-item-top\"\n          ><span class=\"mk-roadmap-item-status\" data-status=\"planned\" data-i18n-target=\"dh-23-3\">Planned</span\n          ><span class=\"mk-roadmap-item-when\"><i data-lucide=\"calendar\"></i>Q2 2027</span></div\n        >\n        <h3 class=\"mk-roadmap-item-title\" id=\"rm-2\">Public pages</h3>\n        <p class=\"mk-roadmap-item-desc\">Publish a doc as a website with your domain.</p>\n        <div class=\"mk-roadmap-item-foot\">\n          <ul class=\"mk-roadmap-item-tags\"\n            ><li>Docs</li\n            ><li>Web</li></ul\n          >\n          <label class=\"mk-roadmap-item-vote\"\n            ><input type=\"checkbox\" name=\"vote\" value=\"rm-2\" /><i data-lucide=\"chevron-up\"></i><span>98</span\n            ><span class=\"sr-only\"> votes - vote for Public pages</span></label\n          >\n        </div>\n      </article>\n    </section>\n    <section aria-labelledby=\"rb-progress\"\n      ><h3 id=\"rb-progress\" data-i18n-target=\"dh-24-1\">In progress</h3>\n      <article class=\"mk-roadmap-item\" aria-labelledby=\"rm-3\">\n        <div class=\"mk-roadmap-item-top\"\n          ><span class=\"mk-roadmap-item-status\" data-status=\"progress\" data-i18n-target=\"dh-24-2\">In progress</span\n          ><span class=\"mk-roadmap-item-when\"><i data-lucide=\"calendar\"></i>Nov 2026</span></div\n        >\n        <h3 class=\"mk-roadmap-item-title\" id=\"rm-3\">Acme mobile app</h3>\n        <p class=\"mk-roadmap-item-desc\">Everything on the desk, in your pocket - offline included.</p>\n        <progress class=\"progress\" value=\"60\" max=\"100\" aria-label=\"60% done\">60%</progress>\n        <div class=\"mk-roadmap-item-foot\">\n          <ul class=\"mk-roadmap-item-tags\"\n            ><li>iOS</li\n            ><li>Android</li></ul\n          >\n          <label class=\"mk-roadmap-item-vote\"\n            ><input type=\"checkbox\" name=\"vote\" value=\"rm-3\" checked /><i data-lucide=\"chevron-up\"></i><span>512</span\n            ><span class=\"sr-only\"> votes - vote for Acme mobile app</span></label\n          >\n        </div>\n      </article>\n    </section>\n    <section aria-labelledby=\"rb-shipped\"\n      ><h3 id=\"rb-shipped\" data-i18n-target=\"dh-25-1\">Shipped</h3>\n      <article class=\"mk-roadmap-item\" aria-labelledby=\"rm-4\">\n        <div class=\"mk-roadmap-item-top\"\n          ><span class=\"mk-roadmap-item-status\" data-status=\"shipped\" data-i18n-target=\"dh-25-2\">Shipped</span\n          ><span class=\"mk-roadmap-item-when\"><i data-lucide=\"calendar\"></i>Sep 2026</span></div\n        >\n        <h3 class=\"mk-roadmap-item-title\" id=\"rm-4\">Offline sync</h3>\n        <p class=\"mk-roadmap-item-desc\">Shipped in 4.0 for every workspace.</p>\n        <div class=\"mk-roadmap-item-foot\">\n          <ul class=\"mk-roadmap-item-tags