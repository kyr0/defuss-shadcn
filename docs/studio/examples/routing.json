[{"label":"A mailbox with routes","html":"<div class=\"card\" id=\"mail\" style=\"max-width: 42rem\">\n  <div class=\"card-header\">\n    <h3 class=\"card-title\">Mail</h3>\n    <p class=\"card-description\">Route: <output id=\"mail-route\">inbox · /</output></p>\n  </div>\n  <div class=\"card-content\" style=\"min-height: 15rem\">\n    <nav class=\"nav-menu mb-4\" aria-label=\"Folders\">\n      <ul class=\"nav-menu-list\">\n        <li class=\"nav-menu-item\">\n          <a class=\"nav-menu-link\" href=\"#/\" data-router-link aria-current=\"page\">Inbox</a>\n        </li>\n        <li class=\"nav-menu-item\">\n          <a class=\"nav-menu-link\" href=\"#/archive\" data-router-link>Archive</a>\n        </li>\n      </ul>\n    </nav>\n    <section data-view=\"inbox\">\n      <div class=\"table-container\">\n        <table class=\"table\">\n          <thead>\n            <tr class=\"table-row\">\n              <th class=\"table-head\">From</th>\n              <th class=\"table-head\">Subject</th>\n              <th class=\"table-head\" style=\"text-align: right\">Received</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr class=\"table-row\">\n              <td class=\"table-cell\">Maya Chen</td>\n              <td class=\"table-cell\"><a class=\"link\" href=\"#/messages/1\" data-router-link>Lunch on Friday?</a></td>\n              <td class=\"table-cell\" style=\"text-align: right\">Thu 10:24</td>\n            </tr>\n            <tr class=\"table-row\">\n              <td class=\"table-cell\">Jonas Weber</td>\n              <td class=\"table-cell\"\n                ><a class=\"link\" href=\"#/messages/2\" data-router-link>The Q4 plan, second draft</a></td\n              >\n              <td class=\"table-cell\" style=\"text-align: right\">Wed 16:02</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n    </section>\n    <section data-view=\"archive\" hidden>\n      <div class=\"table-container\">\n        <table class=\"table\">\n          <thead>\n            <tr class=\"table-row\">\n              <th class=\"table-head\">From</th>\n              <th class=\"table-head\">Subject</th>\n              <th class=\"table-head\" style=\"text-align: right\">Received</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr class=\"table-row\">\n              <td class=\"table-cell\">People Team</td>\n              <td class=\"table-cell\"><a class=\"link\" href=\"#/messages/3\" data-router-link>Welcome to the team</a></td>\n              <td class=\"table-cell\" style=\"text-align: right\">Mar 3</td>\n            </tr>\n            <tr class=\"table-row\">\n              <td class=\"table-cell\">Old Newsletter</td>\n              <td class=\"table-cell\"\n                ><a class=\"link\" href=\"#/messages/9\" data-router-link>A message that is gone</a></td\n              >\n              <td class=\"table-cell\" style=\"text-align: right\">Feb 12</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n    </section>\n    <section data-view=\"message\" hidden>\n      <a class=\"btn mb-3\" data-variant=\"ghost\" data-size=\"sm\" href=\"#/\" data-router-link id=\"mail-back\"\n        ><i data-lucide=\"arrow-left\"></i>Back</a\n      >\n      <h4 class=\"h4 m-0\" id=\"mail-subject\"></h4>\n      <p class=\"muted mt-1 mb-4\" id=\"mail-from\"></p>\n      <p class=\"p m-0\" id=\"mail-body\"></p>\n    </section>\n    <section data-view=\"missing\" hidden>\n      <div class=\"alert\" role=\"alert\">\n        <i class=\"alert-icon\" data-lucide=\"mail-x\"></i>\n        <div class=\"alert-content\">\n          <h5 class=\"alert-title\">Not found</h5>\n          <p class=\"alert-description\">\n            No such message - <a class=\"link\" href=\"#/\" data-router-link>back to the inbox</a>.\n          </p>\n        </div>\n      </div>\n    </section>\n  </div>\n</div>\n","individual":false}]
