[{"label":"Ines Duarte, photographer","html":"<style>\n  #pf-photographer {\n    --background: oklch(0.12 0 0);\n    --foreground: oklch(0.95 0 0);\n    --card: oklch(0.17 0 0);\n    --card-foreground: var(--foreground);\n    --muted: oklch(0.2 0 0);\n    --muted-foreground: oklch(0.68 0 0);\n    --border: oklch(0.28 0 0);\n    --input: var(--border);\n    --primary: oklch(0.95 0 0);\n    --primary-foreground: oklch(0.12 0 0);\n    --secondary: oklch(0.22 0 0);\n    --secondary-foreground: var(--foreground);\n    --accent: oklch(0.22 0 0);\n    --accent-foreground: var(--foreground);\n    --ring: oklch(0.8 0.1 70);\n    color-scheme: dark;\n    display: flex;\n    flex-direction: column;\n    container: pf-photographer / inline-size;\n    box-sizing: border-box;\n    width: 100%;\n    background: var(--background);\n    color: var(--foreground);\n    font-family: var(--font-sans);\n  }\n  /* one view at a time: the home view, or the page of a photograph or a series */\n  #pf-photographer [hidden] {\n    display: none !important;\n  }\n  #pf-photographer .pf-home {\n    display: flex;\n    flex-direction: column;\n    gap: clamp(3.5rem, 8vw, 6rem);\n  }\n  #pf-photographer .pf-inner {\n    display: flex;\n    flex-direction: column;\n    gap: clamp(3.5rem, 8vw, 6rem);\n    box-sizing: border-box;\n    width: 100%;\n    max-width: 78rem;\n    margin-inline: auto;\n    padding-inline: clamp(1rem, 4vw, 2.5rem);\n  }\n  /* the header: the Site Header kept quiet - a name, four words, the switch */\n  #pf-photographer .pf-bar {\n    background: var(--background);\n  }\n  #pf-photographer .pf-bar .mk-header-inner {\n    flex-wrap: wrap;\n    gap: 0.5rem 2.5rem;\n    max-width: 78rem;\n    padding: 0.75rem clamp(1rem, 4vw, 2.5rem);\n  }\n  #pf-photographer .mk-header-brand {\n    color: var(--foreground);\n  }\n  #pf-photographer .mk-header-name {\n    color: inherit;\n    font-family: var(--font-serif);\n    font-size: 1.375rem;\n    font-weight: 300;\n    letter-spacing: 0.04em;\n  }\n  #pf-photographer .mk-header-nav {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.25rem 1.75rem;\n    margin-inline-start: auto;\n    font-size: 0.9375rem;\n    letter-spacing: 0.04em;\n  }\n  #pf-photographer .mk-header-nav a {\n    color: var(--muted-foreground);\n    text-decoration: none;\n  }\n  #pf-photographer .mk-header-nav a:is(:hover, :focus-visible, [aria-current]) {\n    color: var(--foreground);\n  }\n  @container pf-photographer (max-width: 40rem) {\n    #pf-photographer .mk-header-nav {\n      order: 3;\n      width: 100%;\n      margin-inline-start: 0;\n    }\n  }\n  #pf-photographer .pf-opening {\n    height: min(88dvh, 44rem);\n    color: #fff;\n  }\n  #pf-photographer .pf-opening img {\n    filter: brightness(0.72) contrast(1.05);\n  }\n  #pf-photographer .pf-opening h1 {\n    margin: 0;\n    font-family: var(--font-serif);\n    font-size: clamp(3rem, 1rem + 10vw, 9rem);\n    font-weight: 300;\n    letter-spacing: 0.04em;\n    line-height: 0.95;\n    text-align: center;\n    text-shadow: 0 4px 40px rgb(0 0 0 / 0.5);\n  }\n  #pf-photographer .pf-opening p {\n    margin: 1.25rem 0 0;\n    font-size: 0.8125rem;\n    letter-spacing: 0.35em;\n    text-align: center;\n    text-transform: uppercase;\n    text-shadow: 0 2px 12px rgb(0 0 0 / 0.6);\n  }\n  #pf-photographer .pf-label {\n    margin: 0 0 1.5rem;\n    font-size: 0.75rem;\n    font-weight: 600;\n    letter-spacing: 0.28em;\n    text-transform: uppercase;\n    color: var(--muted-foreground);\n  }\n  #pf-photographer .mk-resume-header {\n    align-items: center;\n  }\n  #pf-photographer .mk-resume-header-photo {\n    width: clamp(7rem, 18vw, 11rem);\n    height: auto;\n    aspect-ratio: 1;\n    border-radius: 50%;\n  }\n  #pf-photographer .mk-resume-header-role {\n    max-width: 40rem;\n    font-family: var(--font-serif);\n    font-size: clamp(1.375rem, 1rem + 1.5vw, 2rem);\n    font-weight: 300;\n    line-height: 1.3;\n  }\n  #pf-photographer .mk-portfolio-grid-title {\n    font-family: var(--font-serif);\n    font-weight: 400;\n  }\n  #pf-photographer .pf-edit {\n    display: grid;\n    gap: 0.75rem;\n    margin: 0;\n  }\n  #pf-photographer .pf-edit figcaption {\n    color: var(--muted-foreground);\n  }\n  #pf-photographer .pf-clients {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: center;\n    gap: 1rem 2.5rem;\n    margin: 0;\n    padding: 0;\n    list-style: none;\n    font-family: var(--font-serif);\n    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);\n    font-style: italic;\n    color: var(--muted-foreground);\n  }\n  #pf-photographer .pf-contact {\n    padding: 5rem 0 3rem;\n    background: var(--card);\n    --shape-edge: 2rem;\n  }\n  /* a photograph or a series: the picture first, the words beside the facts, then the other frames */\n  #pf-photographer .pf-work {\n    gap: clamp(2rem, 5vw, 3.5rem);\n    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(3rem, 7vw, 5rem);\n  }\n  #pf-photographer .pf-work-top {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: space-between;\n    gap: 0.5rem 1rem;\n    font-size: 0.8125rem;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n    color: var(--muted-foreground);\n  }\n  #pf-photographer .pf-work-top a {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.4rem;\n    color: inherit;\n    text-decoration: none;\n  }\n  #pf-photographer .pf-work-top a:is(:hover, :focus-visible) {\n    color: var(--foreground);\n  }\n  #pf-photographer .pf-work-top svg {\n    width: 0.95rem;\n    height: 0.95rem;\n  }\n  #pf-photographer .pf-work-head {\n    display: grid;\n    gap: 0.75rem;\n    max-width: 48rem;\n  }\n  #pf-photographer .pf-work-head .pf-label {\n    margin: 0;\n  }\n  #pf-photographer .pf-work-head h1 {\n    margin: 0;\n    font-family: var(--font-serif);\n    font-size: clamp(2.5rem, 1.5rem + 4cqi, 5rem);\n    font-weight: 300;\n    line-height: 1;\n    letter-spacing: 0.01em;\n  }\n  #pf-photographer .pf-work-lede {\n    margin: 0;\n    font-family: var(--font-serif);\n    font-size: clamp(1.125rem, 1rem + 0.6cqi, 1.5rem);\n    font-weight: 300;\n    line-height: 1.45;\n    color: var(--muted-foreground);\n  }\n  #pf-photographer .pf-work-cover {\n    margin: 0;\n  }\n  #pf-photographer .pf-work-cover img {\n    display: block;\n    width: 100%;\n    max-height: 80dvh;\n    aspect-ratio: 18 / 11;\n    object-fit: cover;\n  }\n  #pf-photographer .pf-work-body {\n    display: grid;\n    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);\n    gap: 2rem 4rem;\n    align-items: start;\n  }\n  #pf-photographer .pf-work-text p {\n    margin: 0 0 1.25rem;\n    font-size: 1.0625rem;\n    line-height: 1.75;\n    text-wrap: pretty;\n  }\n  #pf-photographer .pf-work-facts {\n    display: grid;\n    grid-template-columns: auto minmax(0, 1fr);\n    gap: 0.75rem 1.5rem;\n    margin: 0;\n    padding-block-start: 1rem;\n    border-block-start: 1px solid var(--border);\n    font-size: 0.9375rem;\n  }\n  #pf-photographer .pf-work-facts dt {\n    color: var(--muted-foreground);\n    font-size: 0.75rem;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n    line-height: 1.6;\n  }\n  #pf-photographer .pf-work-facts dd {\n    margin: 0;\n  }\n  #pf-photographer .pf-frames {\n    columns: 2 16rem;\n    column-gap: 1rem;\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n  /* three frames or more fill three columns; two stay side by side */\n  #pf-photographer .pf-frames:has(> li:nth-child(3)) {\n    columns: 3 16rem;\n  }\n  #pf-photographer .pf-frames li {\n    break-inside: avoid;\n    margin-block-end: 1rem;\n  }\n  #pf-photographer .pf-frames img {\n    display: block;\n    width: 100%;\n    height: auto;\n  }\n  #pf-photographer .mk-article-nav-link {\n    border-radius: 0;\n  }\n  #pf-photographer .mk-article-nav-title {\n    font-family: var(--font-serif);\n    font-size: 1.25rem;\n    font-weight: 400;\n  }\n  @container pf-photographer (max-width: 46rem) {\n    #pf-photographer .pf-work-body {\n      grid-template-columns: minmax(0, 1fr);\n    }\n  }\n  /* the footer: the Site Footer on the contact's wall - the wave runs on into it */\n  #pf-photographer .pf-foot {\n    background: var(--card);\n  }\n  #pf-photographer .pf-foot .mk-footer-inner {\n    max-width: 78rem;\n    padding: 1rem clamp(1rem, 4vw, 2.5rem) 2.5rem;\n  }\n  #pf-photographer .pf-foot .mk-footer-nav {\n    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));\n    gap: 2rem;\n  }\n  #pf-photographer .mk-footer-heading {\n    font-size: 0.75rem;\n    font-weight: 600;\n    letter-spacing: 0.28em;\n    text-transform: uppercase;\n  }\n  #pf-photographer .mk-footer-list {\n    gap: 0.5rem;\n    font-family: var(--font-serif);\n  }\n  #pf-photographer .mk-footer-brand {\n    color: var(--foreground);\n  }\n  #pf-photographer .mk-footer-brand-name {\n    font-family: var(--font-serif);\n    font-size: 1.125rem;\n    font-weight: 300;\n    letter-spacing: 0.04em;\n  }\n  /* light or dark: the Swap writes the page's dark class - every look has a light and a dark palette */\n  #pf-photographer .site-mode {\n    flex: none;\n    border: 1px solid var(--input);\n    border-radius: var(--radius-md);\n    background: var(--background);\n    color: var(--foreground);\n  }\n  #pf-photographer .site-mode:hover {\n    background: var(--accent);\n    color: var(--accent-foreground);\n  }\n  /* -- modes: each look in light and dark, derived from the palettes above (the other mode of each look) -- */\n  .dark #pf-photographer {\n    --accent: oklch(0.24 0 0);\n  }\n  :root:not(.dark) #pf-photographer {\n    color-scheme: light;\n    --background: oklch(0.985 0 0);\n    --foreground: oklch(0.2 0 0);\n    --card: oklch(0.997 0 0);\n    --card-foreground: oklch(0.2 0 0);\n    --muted: oklch(0.95 0 0);\n    --muted-foreground: oklch(0.46 0 0);\n    --border: oklch(0.9 0 0);\n    --input: oklch(0.88 0 0);\n    --primary: oklch(0.2 0 0);\n    --primary-foreground: oklch(0.985 0.005 0);\n    --secondary: oklch(0.955 0 0);\n    --secondary-foreground: oklch(0.25 0 0);\n    --accent: oklch(0.94 0 0);\n    --accent-foreground: oklch(0.2 0 0);\n    --ring: oklch(0.55 0.1 70);\n    --popover: oklch(0.997 0 0);\n    --popover-foreground: oklch(0.2 0 0);\n  }\n  /* -- modes: end -- */\n</style>\n<div id=\"pf-photographer\">\n  <header class=\"mk-header pf-bar\">\n    <div class=\"mk-header-inner\">\n      <a class=\"mk-header-brand\" href=\"#/\" data-router-link><span class=\"mk-header-name\">Ines Duarte</span></a>\n      <nav class=\"mk-header-nav\" aria-label=\"Sections\">\n        <a href=\"#pf-photo-recent\">Recent</a>\n        <a href=\"#pf-photo-series\">Series</a>\n        <a href=\"#pf-photo-edit\">The edit</a>\n        <a href=\"#pf-photo-contact\">Contact</a>\n      </nav>\n      <div class=\"mk-header-actions\">\n        <label class=\"swap site-mode\" data-variant=\"rotate\" data-size=\"sm\">\n          <input type=\"checkbox\" data-site-mode aria-label=\"Dark mode\" />\n          <span class=\"swap-on\" aria-hidden=\"true\"><i data-lucide=\"moon\"></i></span>\n          <span class=\"swap-off\" aria-hidden=\"true\"><i data-lucide=\"sun\"></i></span>\n        </label>\n      </div>\n    </div>\n  </header>\n\n  <!-- the home view: the whole portfolio -->\n  <div class=\"pf-home\" data-pf-view=\"home\">\n    <section class=\"parallax pf-opening\" aria-label=\"Ines Duarte, photographer\">\n      <div class=\"parallax-layer\" data-depth=\"far\"><img src=\"images/photos/1036-1800x1200.webp\" alt=\"\" /></div>\n      <div class=\"parallax-layer\" style=\"--parallax-speed: -12%; z-index: 0\">\n        <div>\n          <h1 data-df-entrance=\"blur\">Ines Duarte</h1>\n          <p data-df-entrance=\"fade\" style=\"--df-motion-delay: 400ms\">Landscape &amp; architecture · Lisbon</p>\n        </div>\n      </div>\n    </section>\n    <div class=\"pf-inner\">\n      <header class=\"mk-resume-header\">\n        <img\n          class=\"mk-resume-header-photo\"\n          src=\"images/photos/1027-500x500.webp\"\n          alt=\"Ines Duarte\"\n          data-df-entrance=\"iris\"\n        />\n        <div class=\"mk-resume-header-body\">\n          <p class=\"mk-resume-header-role\"\n            >I photograph places at the hour nobody is there - and the buildings that wait for people.</p\n          >\n          <ul class=\"mk-resume-header-facts\">\n            <li><i data-lucide=\"camera\"></i> Hasselblad X2D, Leica Q3</li>\n            <li><i data-lucide=\"award\"></i> Sony World Photography Awards, shortlist 2025</li>\n            <li><i data-lucide=\"mail\"></i> <a href=\"mailto:ines@example.com\">ines@example.com</a></li>\n          </ul>\n        </div>\n      </header>\n      <section id=\"pf-photo-recent\" aria-labelledby=\"pf-photo-recent-title\">\n        <h2 class=\"pf-label\" id=\"pf-photo-recent-title\">Recent</h2>\n        <ul class=\"mk-portfolio-grid\" data-variant=\"masonry\">\n          <li class=\"mk-portfolio-grid-item parallax-reveal\" data-reveal=\"zoom\">\n            <a class=\"mk-portfolio-grid-link\" href=\"#/photo/glass-and-fog\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"images/photos/1048-600x840.webp\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Glass and fog</strong>\n                <span class=\"mk-portfolio-grid-meta\">Porto, 2026</span>\n              </span>\n            </a>\n          </li>\n          <li class=\"mk-portfolio-grid-item parallax-reveal\" data-reveal=\"zoom\">\n            <a class=\"mk-portfolio-grid-link\" href=\"#/photo/above-the-fjord\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"images/photos/1015-600x420.webp\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Above the fjord</strong>\n                <span class=\"mk-portfolio-grid-meta\">Lysefjord, 2026</span>\n              </span>\n            </a>\n          </li>\n          <li class=\"mk-portfolio-grid-item parallax-reveal\" data-reveal=\"zoom\">\n            <a class=\"mk-portfolio-grid-link\" href=\"#/photo/white-spiral\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"images/photos/949-600x600.webp\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">White spiral</strong>\n                <span class=\"mk-portfolio-grid-meta\">New York, 2025</span>\n              </span>\n            </a>\n          </li>\n          <li class=\"mk-portfolio-grid-item parallax-reveal\" data-reveal=\"zoom\">\n            <a class=\"mk-portfolio-grid-link\" href=\"#/photo/before-the-tide\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"images/photos/1050-600x440.webp\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Before the tide</strong>\n                <span class=\"mk-portfolio-grid-meta\">Algarve, 2025</span>\n              </span>\n            </a>\n          </li>\n          <li class=\"mk-portfolio-grid-item parallax-reveal\" data-reveal=\"zoom\">\n            <a class=\"mk-portfolio-grid-link\" href=\"#/photo/steps-of-light\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"images/photos/1081-600x780.webp\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Steps of light</strong>\n                <span class=\"mk-portfolio-grid-meta\">Matosinhos, 2024</span>\n              </span>\n            </a>\n          </li>\n          <li class=\"mk-portfolio-grid-item parallax-reveal\" data-reveal=\"zoom\">\n            <a class=\"mk-portfolio-grid-link\" href=\"#/photo/the-green-road\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"images/photos/1018-600x400.webp\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">The green road</strong>\n                <span class=\"mk-portfolio-grid-meta\">Skye, 2024</span>\n              </span>\n            </a>\n          </li>\n        </ul>\n      </section>\n      <section id=\"pf-photo-edit\" aria-labelledby=\"pf-photo-edit-title\">\n        <h2 class=\"pf-label\" id=\"pf-photo-edit-title\">The edit</h2>\n        <figure class=\"pf-edit\">\n          <div class=\"diff\" data-ratio=\"7/4\">\n            <div class=\"diff-item-1\">\n              <img src=\"images/photos/1048-1400x800.webp\" alt=\"After: the graded frame, glass and sky in colour\" />\n              <span class=\"diff-label\">Graded</span>\n            </div>\n            <div class=\"diff-item-2\">\n              <img src=\"images/photos/1048-1400x800-gray.webp\" alt=\"Before: the raw frame, flat and grey\" />\n              <span class=\"diff-label\">Raw</span>\n            </div>\n            <input\n              class=\"diff-range\"\n              type=\"range\"\n              min=\"0\"\n              max=\"100\"\n              value=\"50\"\n              step=\"0.1\"\n              aria-label=\"Divider position: drag to compare the graded and the raw frame\"\n            />\n          </div>\n          <figcaption>Towers, Lisbon - the print and the raw frame, side by side.</figcaption>\n        </figure>\n      </section>\n      <section id=\"pf-photo-series\" aria-labelledby=\"pf-photo-series-title\">\n        <h2 class=\"pf-label\" id=\"pf-photo-series-title\">Series</h2>\n        <ul class=\"mk-portfolio-grid\" data-variant=\"strip\">\n          <li class=\"mk-portfolio-grid-item\">\n            <a class=\"mk-portfolio-grid-link\" href=\"#/series/empty-rooms\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"images/photos/954-640x800.webp\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Empty Rooms</strong>\n                <span class=\"mk-portfolio-grid-meta\">24 photographs</span>\n              </span>\n            </a>\n          </li>\n          <li class=\"mk-portfolio-grid-item\">\n            <a class=\"mk-portfolio-grid-link\" href=\"#/series/red-earth\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"images/photos/1016-640x800.webp\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Red Earth</strong>\n                <span class=\"mk-portfolio-grid-meta\">31 photographs</span>\n              </span>\n            </a>\n          </li>\n          <li class=\"mk-portfolio-grid-item\">\n            <a class=\"mk-portfolio-grid-link\" href=\"#/series/brutal-lisbon\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"images/photos/983-640x800.webp\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Brutal Lisbon</strong>\n                <span class=\"mk-portfolio-grid-meta\">18 photographs</span>\n              </span>\n            </a>\n          </li>\n          <li class=\"mk-portfolio-grid-item\">\n            <a class=\"mk-portfolio-grid-link\" href=\"#/series/night-shift\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"images/photos/1078-640x800.webp\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Night Shift</strong>\n                <span class=\"mk-portfolio-grid-meta\">40 photographs</span>\n              </span>\n            </a>\n          </li>\n        </ul>\n      </section>\n      <section aria-label=\"Published in\">\n        <ul class=\"pf-clients\">\n          <li>Monocle</li>\n          <li>Wallpaper*</li>\n          <li>The New York Times</li>\n          <li>Dezeen</li>\n          <li>Público</li>\n        </ul>\n      </section>\n    </div>\n    <section id=\"pf-photo-contact\" class=\"pf-contact edge-wave-top\" aria-label=\"Contact\">\n      <div class=\"pf-inner\">\n        <aside class=\"mk-availability\" data-variant=\"banner\" aria-labelledby=\"pf-photo-hire\">\n          <p class=\"mk-availability-status\"\n            ><span class=\"indicator-dot\" data-variant=\"success\" aria-hidden=\"true\"></span> Booking 2027</p\n          >\n          <p class=\"mk-availability-title\" id=\"pf-photo-hire\">Commissions, licensing and prints</p>\n          <div class=\"mk-availability-actions\">\n            <a class=\"btn\" data-size=\"sm\" href=\"mailto:ines@example.com\">Request a quote</a>\n          </div>\n        </aside>\n      </div>\n    </section>\n  </div>\n\n  <!-- a photograph or a series: the route picks it from the data block below -->\n  <article class=\"pf-inner pf-work\" data-pf-view=\"work\" aria-labelledby=\"pf-photo-work-title\" hidden>\n    <nav class=\"pf-work-top\" aria-label=\"Back\">\n      <a href=\"#pf-photo-recent\" data-work-back><i data-lucide=\"arrow-left\"></i> <span data-work-list>Recent</span></a>\n      <span data-work-count>1 / 6</span>\n    </nav>\n    <header class=\"pf-work-head\">\n      <p class=\"pf-label\" data-work=\"meta\">Porto, 2026</p>\n      <h1 id=\"pf-photo-work-title\" data-work=\"title\">Glass and fog</h1>\n      <p class=\"pf-work-lede\" data-work=\"lede\"\n        >Porto's new waterfront tower on the one morning the river fog climbed higher than the building.</p\n      >\n    </header>\n    <figure class=\"pf-work-cover\">\n      <img\n        data-work-cover\n        src=\"images/photos/1048-1800x1100.webp\"\n        alt=\"Two glass towers seen from their foot, their tops lost in a white sky\"\n      />\n    </figure>\n    <div class=\"pf-work-body\">\n      <div class=\"pf-work-text\" data-work-text>\n        <p\n          >The architects asked for a picture of the tower for the cover of their monograph - finished, empty, before\n          the tenants moved in. I went back eleven mornings for the fog.</p\n        >\n        <p\n          >On the twelfth it rose off the Douro and swallowed the top floors. I stood at the foot of the glass and let\n          the sky do the rest: one frame on the X2D, then the fog was gone.</p\n        >\n      </div>\n      <dl class=\"pf-work-facts\" data-work-facts>\n        <dt>Camera</dt>\n        <dd>Hasselblad X2D, 21 mm</dd>\n        <dt>Exposure</dt>\n        <dd>1/250 s at f/8</dd>\n        <dt>For</dt>\n        <dd>Atelier Ribeira, architects</dd>\n        <dt>Prints</dt>\n        <dd>60 × 90 cm, edition of 10</dd>\n      </dl>\n    </div>\n    <ul class=\"pf-frames\" data-work-frames aria-label=\"More frames\">\n      <li\n        ><img\n          src=\"images/photos/1048-900x1100.webp\"\n          alt=\"Two glass towers seen from below, meeting the sky\"\n          loading=\"lazy\"\n      /></li>\n      <li\n        ><img\n          src=\"images/photos/1081-900x650.webp\"\n          alt=\"The stepped corner of a white building seen from below\"\n          loading=\"lazy\"\n      /></li>\n    </ul>\n    <nav class=\"mk-article-nav\" data-variant=\"minimal\" aria-label=\"More photographs\">\n      <a class=\"mk-article-nav-link\" href=\"#/photo/the-green-road\" rel=\"prev\" data-router-link\n        ><span class=\"mk-article-nav-dir\"><i data-lucide=\"arrow-left\" aria-hidden=\"true\"></i> Previous</span\n        ><span class=\"mk-article-nav-title\" data-work-prev>The green road</span></a\n      >\n      <a class=\"mk-article-nav-link\" href=\"#/photo/above-the-fjord\" rel=\"next\" data-router-link\n        ><span class=\"mk-article-nav-dir\">Next <i data-lucide=\"arrow-right\" aria-hidden=\"true\"></i></span\n        ><span class=\"mk-article-nav-title\" data-work-next>Above the fjord</span></a\n      >\n    </nav>\n  </article>\n\n  <footer class=\"mk-footer pf-foot\">\n    <div class=\"mk-footer-inner\">\n      <nav class=\"mk-footer-nav\" aria-label=\"Footer\">\n        <div class=\"mk-footer-col\">\n          <h2 class=\"mk-footer-heading\">Recent</h2>\n          <ul class=\"mk-footer-list\">\n            <li><a href=\"#/photo/glass-and-fog\" data-router-link>Glass and fog</a></li>\n            <li><a href=\"#/photo/above-the-fjord\" data-router-link>Above the fjord</a></li>\n            <li><a href=\"#/photo/white-spiral\" data-router-link>White spiral</a></li>\n            <li><a href=\"#/photo/before-the-tide\" data-router-link>Before the tide</a></li>\n            <li><a href=\"#/photo/steps-of-light\" data-router-link>Steps of light</a></li>\n            <li><a href=\"#/photo/the-green-road\" data-router-link>The green road</a></li>\n          </ul>\n        </div>\n        <div class=\"mk-footer-col\">\n          <h2 class=\"mk-footer-heading\">Series</h2>\n          <ul class=\"mk-footer-list\">\n            <li><a href=\"#/series/empty-rooms\" data-router-link>Empty Rooms</a></li>\n            <li><a href=\"#/series/red-earth\" data-router-link>Red Earth</a></li>\n            <li><a href=\"#/series/brutal-lisbon\" data-router-link>Brutal Lisbon</a></li>\n            <li><a href=\"#/series/night-shift\" data-router-link>Night Shift</a></li>\n          </ul>\n        </div>\n        <div class=\"mk-footer-col\">\n          <h2 class=\"mk-footer-heading\">Studio</h2>\n          <ul class=\"mk-footer-list\">\n            <li><a href=\"#pf-photo-edit\">The edit</a></li>\n            <li><a href=\"#pf-photo-contact\">Commissions and prints</a></li>\n            <li><a href=\"mailto:ines@example.com\">ines@example.com</a></li>\n          </ul>\n        </div>\n        <div class=\"mk-footer-col\">\n          <h2 class=\"mk-footer-heading\">Elsewhere</h2>\n          <ul class=\"mk-footer-list\">\n            <li><a href=\"https://www.instagram.com