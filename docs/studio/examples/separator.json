el":"Vertical","html":"<div style=\"display: flex; align-items: center; gap: 1rem; font-size: 0.875rem; height: 1.25rem\">\n  <span>Blog</span>\n  <div class=\"separator\" data-orientation=\"vertical\" role=\"separator\"></div>\n  <span>Docs</span>\n  <div class=\"separator\" data-orientation=\"vertical\" role=\"separator\"></div>\n  <span>Source</span>\n</div>\n","individual":false},{"label":"With text","html":"<div class=\"stack gap-4\" style=\"max-width: 24rem\">\n  <div\n    class=\"grid place-items-center rounded-lg\"\n    style=\"height: 5rem; background: var(--muted); color: var(--muted-foreground); font-size: 0.875rem\"\n    >Sign in with a passkey</div\n  >\n  <div class=\"separator\">OR</div>\n  <div\n    class=\"grid place-items-center rounded-lg\"\n    style=\"height: 5rem; background: var(--muted); color: var(--muted-foreground); font-size: 0.875rem\"\n    >Sign in with email</div\n  >\n</div>\n","individual":false},{"label":"Side by side","html":"<div class=\"flex gap-4\" style=\"max-width: 32rem\">\n  <div\n    class=\"grid place-items-center rounded-lg\"\n    style=\"flex: 1; height: 8rem; background: var(--muted); color: var(--muted-foreground); font-size: 0.875rem\"\n    >Free</div\n  >\n  <div class=\"separator\" data-orientation=\"vertical\">OR</div>\n  <div\n    class=\"grid place-items-center rounded-lg\"\n    style=\"flex: 1; height: 8rem; background: var(--muted); color: var(--muted-foreground); font-size: 0.875rem\"\n    >Pro</div\n  >\n</div>\n","individual":false},{"label":"Responsive","html":"<style>\n  .sep-demo-row {\n    display: flex;\n    flex-direction: column;\n    gap: 1rem;\n  }\n  @media (min-width: 64rem) {\n    .sep-demo-row {\n      flex-direction: row;\n    }\n  }\n</style>\n<div class=\"sep-demo-row\">\n  <div\n    class=\"grid place-items-center rounded-lg\"\n    style=\"\n      flex: 1 1 auto;\n      min-height: 6rem;\n      background: var(--muted);\n      color: var(--muted-foreground);\n      font-size: 0.875rem;\n    \"\n    >Content</div\n  >\n  <div class=\"separator\" data-orientation-lg=\"vertical\">OR</div>\n  <div\n    class=\"grid place-items-center rounded-lg\"\n    style=\"\n      flex: 1 1 auto;\n      min-height: 6rem;\n      background: var(--muted);\n      color: var(--muted-foreground);\n      font-size: 0.875rem;\n    \"\n    >Content</div\n  >\n</div>\n","individual":false},{"label":"Colors","html":"<div class=\"stack gap-3\" style=\"max-width: 28rem\">\n  <div class=\"separator\">Default</div>\n  <div class=\"separator\" data-variant=\"neutral\">Neutral</div>\n  <div class=\"separator\" data-variant=\"primary\">Primary</div>\n  <div class=\"separator\" data-variant=\"secondary\">Secondary</div>\n  <div class=\"separator\" data-variant=\"accent\">Accent</div>\n  <div class=\"separator\" data-variant=\"info\">Info</div>\n  <div class=\"separator\" data-variant=\"success\">Success</div>\n  <div class=\"separator\" data-variant=\"warning\">Warning</div>\n  <div class=\"separator\" data-variant=\"destructive\">Destructive</div>\n</div>\n","individual":false},{"label":"Text position","html":"<div class=\"stack gap-4\" style=\"max-width: 28rem\">\n  <div class=\"separator\" data-align=\"start\">Start</div>\n  <div class=\"separator\">Center</div>\n  <div class=\"separator\" data-align=\"end\">End</div>\n</div>\n","individual":false},{"label":"Text position (vertical)","html":"<div class=\"flex gap-8\" style=\"height: 10rem\">\n  <div class=\"separator\" data-orientation=\"vertical\" data-align=\"start\">Start</div>\n  <div class=\"separator\" data-orientation=\"vertical\">Center</div>\n  <div class=\"separator\" data-orientation=\"vertical\" data-align=\"end\">End</div>\n</div>\n","individual":false},{"label":"Sizes","html":"<div class=\"stack gap-5\" style=\"max-width: 28rem\">\n  <div class=\"separator\" data-size=\"sm\" data-variant=\"primary\">sm</div>\n  <div class=\"separator\" data-size=\"md\" data-variant=\"primary\">md</div>\n  <div class=\"separator\" data-size=\"lg\" data-variant=\"primary\">lg</div>\n  <div class=\"separator\" data-size=\"xl\" data-variant=\"primary\">xl</div>\n  <hr class=\"separator\" data-size=\"lg\" data-variant=\"neutral\" />\n</div>\n","individual":false},{"label":"Gaps","html":"<div class=\"stack gap-4\" style=\"max-width: 28rem\">\n  <div class=\"separator\" data-gap=\"none\">gap none</div>\n  <div class=\"separator\" data-gap=\"sm\">gap sm</div>\n  <div class=\"separator\" data-gap=\"md\">gap md</div>\n  <div class=\"separator\" data-gap=\"lg\">gap lg</div>\n  <div class=\"separator\" data-gap=\"xl\">gap xl</div>\n</div>\n","individual":false},{"label":"With Label","html":"<div class=\"separator-label\">\n  <hr class=\"separator\" />\n  <span>or continue with</span>\n  <hr class=\"separator\" />\n</div>\n","individual":false},{"label":"Menu","html":"<div style=\"display: flex; align-items: stretch\">\n  <div style=\"flex: 1; padding: 1rem\">\n    <p>Settings</p>\n    <p>Manage preferences</p>\n  </div>\n  <div class=\"separator\" data-orientation=\"vertical\" role=\"separator\"></div>\n  <div style=\"flex: 1; padding: 1rem\">\n    <p>Account</p>\n    <p>Profile &amp; security</p>\n  </div>\n  <div class=\"separator\" data-orientation=\"vertical\" role=\"separator\"></div>\n  <div style=\"flex: 1; padding: 1rem\">\n    <p>Help</p>\n    <p>Support &amp; docs</p>\n  </div>\n</div>\n","individual":false},{"label":"List","html":"<div>\n  <div>Item 1 - Value 1</div>\n  <hr class=\"separator\" />\n  <div>Item 2 - Value 2</div>\n  <hr class=\"separator\" />\n  <div>Item 3 - Value 3</div>\n</div>\n","individual":false},{"label":"Decorative","html":"<article style=\"max-width: 30rem; margin-inline: auto; display: grid; gap: 1rem; font-size: 0.875rem; line-height: 1.6\">\n  <p\n    >The tide came in slower than the forecast promised, and the harbour lights were already on when the last boat tied\n    up.</p\n  >\n  <!-- an ornamental section break: hidden from assistive technology, so the glyphs are never read out -->\n  <div class=\"separator\" aria-hidden=\"true\" data-gap=\"lg\">✦ ✦ ✦</div>\n  <p>By morning the fog had lifted. Someone had chalked the new times on the board outside the ferry office.</p>\n  <div\n    class=\"separator\"\n    aria-hidden=\"true\"\n    data-variant=\"accent\"\n    data-size=\"md\"\n    data-gap=\"md\"\n    style=\"font-size: 1.125rem\"\n    >❦</div\n  >\n  <p>Nobody read them. Everyone already knew.</p>\n  <!-- a bare glyph without its lines: data-line=\"none\" (an asterism, a dinkus) -->\n  <div class=\"separator\" aria-hidden=\"true\" data-line=\"none\" style=\"font-size: 1.125rem\">⁂</div>\n  <p>The ferry left at seven, as it always had.</p>\n  <!-- a short accent rule to close the chapter: role=\"none\" drops the <hr>'s separator semantics -->\n  <hr\n    class=\"separator\"\n    role=\"none\"\n    data-variant=\"primary\"\n    data-size=\"lg\"\n    style=\"width: 3rem; margin-inline: auto; border-radius: 999px\"\n  />\n  <p\n    style=\"\n      text-align: center;\n      color: var(--muted-foreground);\n      font-size: 0.75rem;\n      letter-spacing: 0.08em;\n      text-transform: uppercase;\n    \"\n    >End of chapter one</p\n  >\n</article>\n","individual":false}]
