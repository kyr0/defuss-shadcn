[{"label":"Default","html":"<section class=\"mk-registration-form\" aria-labelledby=\"reg-title\">\n  <h2 id=\"reg-title\" class=\"sr-only\">Register for Acme Summit 2026</h2>\n  <form action=\"#\" method=\"post\">\n    <fieldset class=\"mk-registration-form-group\">\n      <legend>Ticket</legend>\n      <div class=\"mk-registration-form-tickets\">\n        <label class=\"mk-registration-form-ticket\" for=\"rg-standard\"\n          ><input class=\"radio\" type=\"radio\" name=\"ticket\" id=\"rg-standard\" value=\"rg-standard\" checked required /><span\n            class=\"mk-registration-form-ticket-name\"\n            >Standard</span\n          ><b>€290</b><small>Both days, lunch, recordings.</small></label\n        >\n        <label class=\"mk-registration-form-ticket\" for=\"rg-workshop\"\n          ><input class=\"radio\" type=\"radio\" name=\"ticket\" id=\"rg-workshop\" value=\"rg-workshop\" required /><span\n            class=\"mk-registration-form-ticket-name\"\n            >Standard + Workshops <span class=\"badge\" data-variant=\"secondary\" data-size=\"sm\">Few left</span></span\n          ><b>€440</b><small>Everything in Standard plus two hands-on workshops.</small></label\n        >\n        <label class=\"mk-registration-form-ticket\" for=\"rg-stream\"\n          ><input class=\"radio\" type=\"radio\" name=\"ticket\" id=\"rg-stream\" value=\"rg-stream\" required /><span\n            class=\"mk-registration-form-ticket-name\"\n            >Online</span\n          ><b>€90</b><small>Live stream, Q&amp;A and recordings.</small></label\n        >\n      </div>\n    </fieldset>\n    <fieldset class=\"mk-registration-form-group\">\n      <legend>Attendee</legend>\n      <div class=\"mk-registration-form-fields\">\n        <div class=\"mk-registration-form-field\"\n          ><label class=\"label\" for=\"rg-name\">Full name</label\n          ><input class=\"input\" id=\"rg-name\" name=\"name\" autocomplete=\"name\" required\n        /></div>\n        <div class=\"mk-registration-form-field\"\n          ><label class=\"label\" for=\"rg-email\">Email</label\n          ><input class=\"input\" id=\"rg-email\" type=\"email\" name=\"email\" autocomplete=\"email\" required\n        /></div>\n        <div class=\"mk-registration-form-field\"\n          ><label class=\"label\" for=\"rg-org\">Company</label\n          ><input class=\"input\" id=\"rg-org\" name=\"organization\" autocomplete=\"organization\"\n        /></div>\n        <div class=\"mk-registration-form-field\"\n          ><label class=\"label\" for=\"rg-role\">Role</label\n          ><input class=\"input\" id=\"rg-role\" name=\"role\" autocomplete=\"organization-title\"\n        /></div>\n      </div>\n    </fieldset>\n    <fieldset class=\"mk-registration-form-group\">\n      <legend\n        >Workshops\n        <small style=\"font-weight: 400; color: var(--muted-foreground)\">(with the workshop ticket)</small></legend\n      >\n      <div class=\"mk-registration-form-choices\">\n        <div class=\"checkbox-item\"\n          ><input class=\"checkbox\" type=\"checkbox\" id=\"rg-w1\" name=\"workshops\" value=\"sync\" /><label for=\"rg-w1\"\n            >Offline-first sync, hands on</label\n          ><small>12 seats left</small></div\n        >\n        <div class=\"checkbox-item\"\n          ><input class=\"checkbox\" type=\"checkbox\" id=\"rg-w2\" name=\"workshops\" value=\"a11y\" checked /><label for=\"rg-w2\"\n            >Accessible components from scratch</label\n          ><small>4 seats left</small></div\n        >\n      </div>\n    </fieldset>\n    <fieldset class=\"mk-registration-form-group\">\n      <legend>Your needs</legend>\n      <div class=\"mk-registration-form-fields\">\n        <div class=\"mk-registration-form-field\"\n          ><label class=\"label\" for=\"rg-diet\">Dietary preference</label\n          ><select class=\"select\" id=\"rg-diet\" name=\"diet\"\n            ><option>No preference</option\n            ><option>Vegetarian</option\n            ><option>Vegan</option\n            ><option>Gluten-free</option></select\n          ></div\n        >\n        <div class=\"mk-registration-form-field\" data-span=\"full\"\n          ><label class=\"label\" for=\"rg-a11y\">Accessibility needs</label><textarea\n            class=\"textarea\"\n            id=\"rg-a11y\"\n            name=\"access\"\n            rows=\"2\"\n            placeholder=\"Step-free access, captions, a quiet room…\"\n          ></textarea>\n        </div>\n      </div>\n    </fieldset>\n    <div class=\"mk-registration-form-total\">\n      <div><span>Total incl. VAT</span><output name=\"total\" for=\"rg-standard rg-workshop rg-stream\">€290</output></div>\n      <button class=\"btn\" data-size=\"lg\" type=\"submit\">Register</button>\n    </div>\n  </form>\n</section>\n","individual":true}]
