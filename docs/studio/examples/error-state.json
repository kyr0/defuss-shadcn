[{"label":"Default","html":"<section class=\"mk-error-state\" role=\"alert\" aria-labelledby=\"er-1\">\n  <span class=\"mk-error-state-icon\" aria-hidden=\"true\"><i data-lucide=\"triangle-alert\"></i></span>\n  <h2 class=\"mk-error-state-title\" id=\"er-1\">We couldn't load your board</h2>\n  <p class=\"mk-error-state-text\">Our servers took too long to answer. Your work is safe - nothing was lost.</p>\n  <div class=\"mk-error-state-actions\"\n    ><a class=\"btn\" href=\"#\"><i data-lucide=\"rotate-cw\"></i> Try again</a\n    ><a class=\"btn\" data-variant=\"outline\" href=\"#\">Go to dashboard</a></div\n  >\n  <details class=\"mk-error-state-details\"><summary>Technical details</summary><pre><code>Error 504 · gateway timeout\nRequest id: req_8f2c41a0 · 2026-10-01 14:32:08 UTC</code></pre></details>\n</section>\n","individual":true},{"label":"Inline","html":"<section class=\"mk-error-state\" data-variant=\"inline\" role=\"alert\" aria-labelledby=\"er-2\">\n  <span class=\"mk-error-state-icon\" aria-hidden=\"true\"><i data-lucide=\"wifi-off\"></i></span>\n  <h2 class=\"mk-error-state-title\" id=\"er-2\">You're offline</h2>\n  <p class=\"mk-error-state-text\">Changes are saved on this device and sync when you're back.</p>\n  <div class=\"mk-error-state-actions\"\n    ><button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\">Retry now</button></div\n  >\n</section>\n","individual":true},{"label":"Page","html":"<section class=\"mk-error-state\" data-variant=\"page\" role=\"alert\" aria-labelledby=\"er-3\">\n  <p class=\"mk-error-state-code\" aria-hidden=\"true\">500</p>\n  <h1 class=\"mk-error-state-title\" id=\"er-3\">Something broke on our side</h1>\n  <p class=\"mk-error-state-text\">We've been notified and are on it. Please try again in a few minutes.</p>\n  <div class=\"mk-error-state-actions\"\n    ><a class=\"btn\" href=\"#\">Reload</a><a class=\"btn\" data-variant=\"ghost\" href=\"#\">Status page</a></div\n  >\n</section>\n","individual":true}]
