[{"label":"Noor Haddad, writer and engineer","html":"<style>\n  @import url('https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500&family=IBM+Plex+Mono:wght@400;500&display=swap');\n  /* still minimal - one narrow column, no boxes - but set like a printed page: Newsreader with its optical\n     sizes, a drop cap, small-caps headings numbered in outline figures, links underlined in the accent, the\n     name in a big italic, its initial again as an outline watermark, ruled paper drifting slowly behind */\n  #pf-minimal {\n    --background: oklch(0.975 0.01 85);\n    --foreground: oklch(0.22 0.02 60);\n    --card: oklch(0.99 0.006 85);\n    --card-foreground: var(--foreground);\n    --muted: oklch(0.94 0.014 85);\n    --muted-foreground: oklch(0.47 0.02 60);\n    --border: oklch(0.22 0.02 60 / 0.14);\n    --primary: oklch(0.52 0.16 32);\n    --primary-foreground: oklch(0.99 0.006 85);\n    --pf-mark: oklch(0.9 0.09 85);\n    --pf-mono: 'IBM Plex Mono', var(--font-mono);\n    color-scheme: light;\n    position: relative;\n    isolation: isolate;\n    box-sizing: border-box;\n    width: 100%;\n    padding: 1rem 1.25rem 3rem;\n    overflow: clip;\n    background: var(--background);\n    color: var(--foreground);\n    font:\n      400 1.125rem/1.7 'Newsreader',\n      Georgia,\n      serif;\n    font-optical-sizing: auto;\n  }\n  .dark #pf-minimal {\n    color-scheme: dark;\n    --background: oklch(0.19 0.012 60);\n    --foreground: oklch(0.93 0.012 85);\n    --card: oklch(0.22 0.014 60);\n    --muted: oklch(0.25 0.014 60);\n    --muted-foreground: oklch(0.74 0.018 80);\n    --border: oklch(0.93 0.012 85 / 0.14);\n    --primary: oklch(0.74 0.14 45);\n    --primary-foreground: oklch(0.19 0.012 60);\n    --pf-mark: oklch(0.42 0.08 70);\n  }\n  /* ruled paper, drifting a line every few seconds; it fades out below the header */\n  #pf-minimal .pf-paper {\n    --surface-size: 30px;\n    --surface-ink: color-mix(in oklch, var(--primary) 16%, transparent);\n    --surface-direction: 270deg;\n    --surface-duration: 24s;\n    mask-image: linear-gradient(#000, transparent 32rem);\n  }\n  /* the initial again, as an outline */\n  #pf-minimal .pf-watermark {\n    position: absolute;\n    z-index: -1;\n    top: clamp(5.5rem, 9vw, 7.5rem);\n    right: max(-2rem, calc(50% - 30rem));\n    margin: 0;\n    color: transparent;\n    -webkit-text-stroke: 1.5px color-mix(in oklch, var(--primary) 45%, transparent);\n    font:\n      italic 500 clamp(12rem, 30vw, 22rem) / 0.8 'Newsreader',\n      Georgia,\n      serif;\n    pointer-events: none;\n    user-select: none;\n  }\n  /* on a phone the sections wrap below the name: the watermark starts under them */\n  @media (max-width: 40rem) {\n    #pf-minimal .pf-watermark {\n      top: 8rem;\n    }\n  }\n  #pf-minimal .pf-column {\n    counter-reset: pf-section;\n    display: flex;\n    flex-direction: column;\n    gap: 3.5rem;\n    max-width: 38rem;\n    margin-inline: auto;\n  }\n  #pf-minimal .mk-resume-header {\n    gap: 1.5rem;\n    padding: 0;\n    border: 0;\n  }\n  #pf-minimal .mk-resume-header-photo {\n    width: 4.5rem;\n    height: 4.5rem;\n    filter: grayscale(1) sepia(0.25);\n  }\n  #pf-minimal .mk-resume-header-status {\n    font: 500 0.75rem/1.4 var(--pf-mono);\n    letter-spacing: 0.02em;\n  }\n  #pf-minimal .mk-resume-header-name {\n    font:\n      italic 500 clamp(2.75rem, 6vw, 3.75rem) / 1 'Newsreader',\n      Georgia,\n      serif;\n    letter-spacing: -0.02em;\n  }\n  #pf-minimal .mk-resume-header-name span {\n    color: var(--primary);\n  }\n  #pf-minimal .mk-resume-header-role {\n    margin: 0.35rem 0 0;\n    color: var(--muted-foreground);\n    font-size: 1.0625rem;\n    font-variant-caps: all-small-caps;\n    letter-spacing: 0.06em;\n  }\n  #pf-minimal p {\n    margin: 0 0 1rem;\n    text-wrap: pretty;\n  }\n  /* the first paragraph opens with a drop cap */\n  #pf-minimal .pf-dropcap::first-letter {\n    float: inline-start;\n    margin: 0.32rem 0.6rem 0 0;\n    color: var(--primary);\n    font:\n      500 4.6rem/0.72 'Newsreader',\n      Georgia,\n      serif;\n  }\n  #pf-minimal .pf-lede {\n    font-size: 1.3125rem;\n    line-height: 1.6;\n  }\n  /* links: an accent underline that thickens into a marker on hover */\n  #pf-minimal a {\n    color: inherit;\n    text-decoration: underline 1.5px var(--primary);\n    text-underline-offset: 0.22em;\n    background: linear-gradient(var(--pf-mark), var(--pf-mark)) 0 100% / 100% 0 no-repeat;\n    transition: background-size 0.25s;\n  }\n  #pf-minimal a:is(:hover, :focus-visible) {\n    background-size: 100% 45%;\n  }\n  /* headings: small caps in the accent, numbered in outline figures */\n  #pf-minimal h2 {\n    counter-increment: pf-section;\n    display: flex;\n    align-items: baseline;\n    gap: 0.85rem;\n    margin: 0 0 1.25rem;\n    color: var(--primary);\n    font-size: 1.0625rem;\n    font-weight: 500;\n    font-variant-caps: all-small-caps;\n    letter-spacing: 0.14em;\n  }\n  #pf-minimal h2::before {\n    content: counter(pf-section, decimal-leading-zero);\n    color: transparent;\n    -webkit-text-stroke: 1px var(--primary);\n    font:\n      italic 500 2.5rem/0.8 'Newsreader',\n      Georgia,\n      serif;\n    letter-spacing: 0;\n  }\n  #pf-minimal .pf-list {\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n  #pf-minimal .pf-list li {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) auto;\n    gap: 0.15rem 1rem;\n    align-items: baseline;\n    padding-block: 0.85rem;\n    border-block-end: 1px solid var(--border);\n  }\n  #pf-minimal .pf-list li:first-child {\n    border-block-start: 1px solid var(--border);\n  }\n  #pf-minimal .pf-list a {\n    font-size: 1.25rem;\n    font-weight: 500;\n    text-decoration-thickness: 1px;\n    text-decoration-color: color-mix(in oklch, var(--primary) 45%, transparent);\n  }\n  #pf-minimal .pf-writing a {\n    font-style: italic;\n    font-weight: 400;\n  }\n  #pf-minimal .pf-list span,\n  #pf-minimal .pf-list time {\n    color: var(--muted-foreground);\n    font: 400 0.8125rem/1.4 var(--pf-mono);\n    font-variant-numeric: tabular-nums;\n  }\n  #pf-minimal .pf-list p {\n    grid-column: 1 / -1;\n    margin: 0;\n    color: var(--muted-foreground);\n    font-size: 1.0625rem;\n  }\n  #pf-minimal .pf-now {\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n  #pf-minimal .pf-now li {\n    position: relative;\n    padding-inline-start: 1.5rem;\n  }\n  #pf-minimal .pf-now li::before {\n    content: '';\n    position: absolute;\n    left: 0;\n    top: 0.75em;\n    width: 0.75rem;\n    height: 1.5px;\n    background: var(--primary);\n  }\n  #pf-minimal .pf-now li + li {\n    margin-block-start: 0.5rem;\n  }\n  #pf-minimal .pf-now mark {\n    padding: 0 0.15em;\n    background: linear-gradient(transparent 55%, var(--pf-mark) 55%);\n    color: inherit;\n  }\n  #pf-minimal .pf-quote {\n    margin: 0;\n    padding: 0.25rem 0 0.25rem 1.5rem;\n    border-inline-start: 2px solid var(--primary);\n    font:\n      italic 400 1.5rem/1.4 'Newsreader',\n      Georgia,\n      serif;\n    text-wrap: balance;\n  }\n  #pf-minimal .mk-resume-entry-title {\n    font-size: 1.1875rem;\n    font-weight: 500;\n  }\n  #pf-minimal :is(.mk-resume-entry-org, .mk-resume-entry-when) {\n    font-size: 1rem;\n  }\n  #pf-minimal .mk-resume-entry-when {\n    font-family: var(--pf-mono);\n    font-size: 0.8125rem;\n  }\n  #pf-minimal [hidden] {\n    display: none !important;\n  }\n  /* the Site Header: the name in italic with its accent stop, three sections in small caps - nothing else */\n  #pf-minimal .mk-header {\n    max-width: 38rem;\n    margin: 0 auto clamp(2.5rem, 8vw, 5.5rem);\n    background: none;\n    color: inherit;\n  }\n  #pf-minimal .mk-header-inner {\n    flex-wrap: wrap;\n    gap: 0.5rem 1rem;\n    min-height: 4.5rem;\n    padding: 0;\n  }\n  #pf-minimal .mk-header a {\n    text-decoration: none;\n  }\n  #pf-minimal .mk-header-brand {\n    color: inherit;\n  }\n  #pf-minimal :is(.mk-header-name, .mk-footer-brand-name) {\n    color: inherit;\n    font:\n      italic 500 1.375rem/1 'Newsreader',\n      Georgia,\n      serif;\n    letter-spacing: -0.01em;\n  }\n  #pf-minimal :is(.mk-header-name, .mk-footer-brand-name) span {\n    color: var(--primary);\n  }\n  #pf-minimal .mk-header-nav {\n    display: flex;\n    margin-inline-start: auto;\n  }\n  #pf-minimal .nav-menu-list {\n    gap: 1.25rem;\n  }\n  #pf-minimal .nav-menu-link {\n    padding: 0.15rem 0;\n    border-radius: 0;\n    color: var(--muted-foreground);\n    font-size: 1.0625rem;\n    font-weight: 500;\n    font-variant-caps: all-small-caps;\n    letter-spacing: 0.1em;\n  }\n  #pf-minimal .nav-menu-link:is(:hover, :focus-visible) {\n    background: linear-gradient(var(--pf-mark), var(--pf-mark)) 0 100% / 100% 45% no-repeat;\n    color: var(--foreground);\n  }\n  #pf-minimal .nav-menu-link[aria-current] {\n    background: none;\n    color: var(--primary);\n    text-decoration: underline 1.5px var(--primary);\n    text-underline-offset: 0.3em;\n  }\n  /* a project or an essay: the same column, the title in the name's big italic, the text set like a book */\n  #pf-minimal .pf-back {\n    margin: 0;\n    font: 400 0.8125rem/1.4 var(--pf-mono);\n  }\n  #pf-minimal .pf-back a {\n    text-decoration: none;\n    color: var(--muted-foreground);\n  }\n  #pf-minimal .pf-meta {\n    margin: 0 0 0.75rem;\n    color: var(--muted-foreground);\n    font: 400 0.8125rem/1.4 var(--pf-mono);\n  }\n  #pf-minimal .pf-page-title {\n    margin: 0 0 1.25rem;\n    font:\n      italic 500 clamp(2.25rem, 5.5vw, 3.25rem) / 1.05 'Newsreader',\n      Georgia,\n      serif;\n    letter-spacing: -0.02em;\n    text-wrap: balance;\n  }\n  #pf-minimal .pf-figure {\n    margin: 0;\n  }\n  #pf-minimal .pf-figure img {\n    display: block;\n    width: 100%;\n    aspect-ratio: 16 / 10;\n    object-fit: cover;\n    filter: grayscale(1) sepia(0.25);\n  }\n  #pf-minimal .pf-facts {\n    display: grid;\n    grid-template-columns: auto minmax(0, 1fr);\n    gap: 0.35rem 1.5rem;\n    margin: 0;\n    padding-block: 0.85rem;\n    border-block: 1px solid var(--border);\n  }\n  #pf-minimal .pf-facts dt {\n    color: var(--primary);\n    font-size: 1rem;\n    font-variant-caps: all-small-caps;\n    letter-spacing: 0.1em;\n  }\n  #pf-minimal .pf-facts dd {\n    margin: 0;\n  }\n  #pf-minimal .pf-essay p {\n    margin: 0 0 1.25rem;\n  }\n  #pf-minimal .pf-essay p:first-child {\n    font-size: 1.3125rem;\n    line-height: 1.6;\n  }\n  #pf-minimal .pf-essay p:first-child::first-letter {\n    float: inline-start;\n    margin: 0.32rem 0.6rem 0 0;\n    color: var(--primary);\n    font:\n      500 4.6rem/0.72 'Newsreader',\n      Georgia,\n      serif;\n  }\n  #pf-minimal .pf-signoff {\n    margin: -1rem 0 0;\n    color: var(--muted-foreground);\n    font-style: italic;\n  }\n  #pf-minimal .pf-pager {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 1.5rem;\n    padding-block-start: 1.25rem;\n    border-block-start: 1px solid var(--border);\n  }\n  #pf-minimal .pf-pager a {\n    display: grid;\n    align-content: start;\n    gap: 0.2rem;\n    text-decoration: none;\n  }\n  #pf-minimal .pf-pager a + a {\n    text-align: end;\n  }\n  #pf-minimal .pf-pager small {\n    color: var(--primary);\n    font-size: 1rem;\n    font-variant-caps: all-small-caps;\n    letter-spacing: 0.1em;\n  }\n  #pf-minimal .pf-pager span {\n    font-size: 1.1875rem;\n    font-style: italic;\n  }\n  /* the Site Footer, simple: one quiet line under the column */\n  #pf-minimal .mk-footer {\n    max-width: 38rem;\n    margin: 4rem auto 0;\n    background: none;\n    color: inherit;\n  }\n  #pf-minimal .mk-footer[data-variant='simple'] .mk-footer-inner {\n    padding: 1.5rem 0 0;\n    border-block-start: 1px solid var(--border);\n  }\n  #pf-minimal .mk-footer-brand {\n    color: inherit;\n    text-decoration: none;\n  }\n  #pf-minimal .mk-footer-links {\n    font-size: 1.0625rem;\n  }\n  #pf-minimal .mk-footer-links a {\n    color: inherit;\n  }\n  #pf-minimal .mk-footer-copy {\n    flex-basis: 100%;\n    color: var(--muted-foreground);\n    font: 400 0.75rem/1.5 var(--pf-mono);\n  }\n  @media (prefers-reduced-motion: reduce) {\n    #pf-minimal a {\n      transition: none;\n    }\n  }\n  /* light or dark: the Swap writes the page's dark class - every look has a light and a dark palette */\n  #pf-minimal .site-mode {\n    flex: none;\n    border: 1px solid var(--input);\n    border-radius: var(--radius-md);\n    background: var(--background);\n    color: var(--foreground);\n  }\n  #pf-minimal .site-mode:hover {\n    background: var(--accent);\n    color: var(--accent-foreground);\n  }\n  /* -- modes: each look in light and dark, derived from the palettes above (the other mode of each look) -- */\n  :root:not(.dark) #pf-minimal {\n    --accent: oklch(0.93 0 85);\n    --accent-foreground: oklch(0.22 0.02 60);\n  }\n  .dark #pf-minimal {\n    --accent: oklch(0.28 0 60);\n    --accent-foreground: oklch(0.93 0.012 85);\n  }\n  /* -- modes: end -- */\n</style>\n<div id=\"pf-minimal\">\n  <div\n    class=\"surface pf-paper\"\n    data-variant=\"background\"\n    data-pattern=\"ruled\"\n    data-motion=\"drift\"\n    aria-hidden=\"true\"\n  ></div>\n  <p class=\"pf-watermark\" aria-hidden=\"true\">N.</p>\n  <header class=\"mk-header\">\n    <div class=\"mk-header-inner\">\n      <a class=\"mk-header-brand\" href=\"#/\" data-router-link\n        ><span class=\"mk-header-name\">Noor Haddad<span>.</span></span></a\n      >\n      <nav class=\"mk-header-nav\" aria-label=\"Main\">\n        <ul class=\"nav-menu-list\">\n          <li class=\"nav-menu-item\"><a class=\"nav-menu-link\" href=\"#/projects\" data-router-link>Projects</a></li>\n          <li class=\"nav-menu-item\"><a class=\"nav-menu-link\" href=\"#/writing\" data-router-link>Writing</a></li>\n          <li class=\"nav-menu-item\"><a class=\"nav-menu-link\" href=\"#/work\" data-router-link>Work</a></li>\n        </ul>\n      </nav>\n      <div class=\"mk-header-actions\">\n        <label class=\"swap site-mode\" data-variant=\"rotate\" data-size=\"sm\">\n          <input type=\"checkbox\" data-site-mode aria-label=\"Dark mode\" />\n          <span class=\"swap-on\" aria-hidden=\"true\"><i data-lucide=\"moon\"></i></span>\n          <span class=\"swap-off\" aria-hidden=\"true\"><i data-lucide=\"sun\"></i></span>\n        </label>\n      </div>\n    </div>\n  </header>\n  <div class=\"pf-column\" data-pf-view=\"home\" data-df-stagger style=\"--df-motion-stagger-step: 120ms\">\n    <div data-df-entrance=\"fade\">\n      <header class=\"mk-resume-header\" data-variant=\"compact\">\n        <img class=\"mk-resume-header-photo shape-circle\" src=\"images/photos/338-200x200-gray.webp\" alt=\"Noor Haddad\" />\n        <div class=\"mk-resume-header-body\">\n          <p class=\"mk-resume-header-status\"\n            ><span class=\"indicator-dot\" data-variant=\"success\" aria-hidden=\"true\"></span> Open to a staff role in\n            2027</p\n          >\n          <h1 class=\"mk-resume-header-name\">Noor Haddad<span>.</span></h1>\n          <p class=\"mk-resume-header-role\">Engineer and writer · Amman and Berlin</p>\n        </div>\n      </header>\n    </div>\n    <section aria-label=\"About\" data-df-entrance=\"fade\">\n      <p class=\"pf-dropcap pf-lede\"\n        >I build tools for people who write - editors, version history, the boring parts of publishing. Right now at\n        <a href=\"#/work\" data-router-link>Ink &amp; Paper</a>, before that at\n        <a href=\"#/work\" data-router-link>Ghostline</a>.</p\n      >\n      <p\n        >I also write about software that respects your attention, in English and Arabic. The\n        <a href=\"#/writing\" data-router-link>essays</a> are below; the code is\n        <a href=\"https://github.com/\" target=\"_blank\" rel=\"noopener\">on GitHub</a>.</p\n      >\n    </section>\n    <section aria-labelledby=\"pf-min-now\" data-df-entrance=\"fade\">\n      <h2 id=\"pf-min-now\">Now</h2>\n      <ul class=\"pf-now\">\n        <li>Rebuilding our editor's <mark>undo on a CRDT</mark>.</li>\n        <li>Reading <i>The Shape of Design</i>, again.</li>\n        <li>Learning to bake ka'ak properly.</li>\n      </ul>\n    </section>\n    <section aria-labelledby=\"pf-min-projects\" data-df-entrance=\"fade\" data-pf-section=\"projects\">\n      <h2 id=\"pf-min-projects\">Projects</h2>\n      <ul class=\"pf-list\">\n        <li>\n          <a href=\"#/projects/quill\" data-router-link>Quill</a>\n          <span>2026</span>\n          <p>A Markdown editor that keeps every version, offline.</p>\n        </li>\n        <li>\n          <a href=\"#/projects/rtl-kit\" data-router-link>rtl-kit</a>\n          <span>2024</span>\n          <p>Bidirectional text, done right, for web components.</p>\n        </li>\n        <li>\n          <a href=\"#/projects/margins\" data-router-link>Margins</a>\n          <span>2022</span>\n          <p>Comments beside any web page, stored in your browser.</p>\n        </li>\n      </ul>\n    </section>\n    <section id=\"writing\" aria-labelledby=\"pf-min-writing\" data-df-entrance=\"fade\" data-pf-section=\"writing\">\n      <h2 id=\"pf-min-writing\">Writing</h2>\n      <ul class=\"pf-list pf-writing\">\n        <li\n          ><a href=\"#/writing/undo\" data-router-link>Undo is a feature, not a stack</a\n          ><time datetime=\"2026-10-02\">Oct 2026</time></li\n        >\n        <li\n          ><a href=\"#/writing/right-to-left\" data-router-link>Right to left is not a mirror</a\n          ><time datetime=\"2026-03-18\">Mar 2026</time></li\n        >\n        <li\n          ><a href=\"#/writing/quiet-notification\" data-router-link>The quiet notification</a\n          ><time datetime=\"2025-08-30\">Aug 2025</time></li\n        >\n        <li\n          ><a href=\"#/writing/ten-years\" data-router-link>Ten years of text editors</a\n          ><time datetime=\"2025-01-12\">Jan 2025</time></li\n        >\n      </ul>\n    </section>\n    <blockquote class=\"pf-quote\" data-df-entrance=\"fade\"\n      >Software should wait for you, not the other way round.</blockquote\n    >\n    <section aria-labelledby=\"pf-min-work\" data-df-entrance=\"fade\" data-pf-section=\"work\">\n      <h2 id=\"pf-min-work\">Work</h2>\n      <ol class=\"mk-resume-entries\">\n        <li class=\"mk-resume-entry\">\n          <div class=\"mk-resume-entry-body\">\n            <div class=\"mk-resume-entry-head\">\n              <h3 class=\"mk-resume-entry-title\">Senior engineer, editor</h3>\n              <p class=\"mk-resume-entry-org\"><span>Ink &amp; Paper, Berlin</span></p>\n              <p class=\"mk-resume-entry-when\"><time datetime=\"2023\">2023</time> - today</p>\n            </div>\n          </div>\n        </li>\n        <li class=\"mk-resume-entry\">\n          <div class=\"mk-resume-entry-body\">\n            <div class=\"mk-resume-entry-head\">\n              <h3 class=\"mk-resume-entry-title\">Engineer</h3>\n              <p class=\"mk-resume-entry-org\"><span>Ghostline, Amman</span></p>\n              <p class=\"mk-resume-entry-when\"><time datetime=\"2019\">2019</time> - <time datetime=\"2023\">2023</time></p>\n            </div>\n          </div>\n        </li>\n      </ol>\n    </section>\n  </div>\n  <article class=\"pf-column pf-page\" data-pf-view=\"projects\" aria-labelledby=\"pf-min-project-title\" hidden>\n    <p class=\"pf-back\"><a href=\"#/projects\" data-router-link>← All projects</a></p>\n    <header class=\"pf-page-head\">\n      <p class=\"pf-meta\"><span data-case=\"kind\">Markdown editor</span> · <span data-case=\"year\">2026</span></p>\n      <h1 class=\"pf-page-title\" id=\"pf-min-project-title\" data-case=\"title\">Quill</h1>\n      <p class=\"pf-lede\" data-case=\"summary\">A Markdown editor that keeps every version, offline.</p>\n    </header>\n    <figure class=\"pf-figure\">\n      <img\n        data-case-img=\"0\"\n        data-w=\"1200\"\n        data-h=\"750\"\n        src=\"images/photos/180-1200x750.webp\"\n        alt=\"A laptop beside an open notebook with wireframe sketches\"\n      />\n    </figure>\n    <dl class=\"pf-facts\">\n      <dt>Built with</dt>\n      <dd data-case=\"stack\">TypeScript, a CRDT, IndexedDB</dd>\n      <dt>Status</dt>\n      <dd data-case=\"status\">Open source, about 2,400 people use it daily</dd>\n    </dl>\n    <section aria-labelledby=\"pf-min-what\">\n      <h2 id=\"pf-min-what\">What it is</h2>\n      <p data-case=\"brief\"\n        >Quill is a plain Markdown editor for people who write long things - theses, books, documentation. It saves\n        every keystroke as history, so there is no Save button and no file you can lose.</p\n      >\n    </section>\n    <section aria-labelledby=\"pf-min-how\">\n      <h2 id=\"pf-min-how\">How it works</h2>\n      <p data-case=\"work\"\n        >The document is a CRDT stored in IndexedDB; the history is the CRDT's own log, so scrolling back through a\n        month of edits is reading, not reconstructing. Sync between devices is optional and goes through a relay that\n        only ever sees encrypted changes.</p\n      >\n    </section>\n    <section aria-labelledby=\"pf-min-now-project\">\n      <h2 id=\"pf-min-now-project\">Where it stands</h2>\n      <p data-case=\"result\"\n        >Version 2 shipped in September. The undo described in my October essay started here, before it moved to\n        work.</p\n      >\n    </section>\n    <nav class=\"pf-pager\" aria-label=\"More projects\">\n      <a href=\"#/projects/margins\" data-router-link data-case-link=\"prev\"\n        ><small>Previous</small><span data-case-title=\"prev\">Margins</span></a\n      >\n      <a href=\"#/projects/rtl-kit\" data-router-link data-case-link=\"next\"\n        ><small>Next</small><span data-case-title=\"next\">rtl-kit</span></a\n      >\n    </nav>\n  </article>\n  <article class=\"pf-column pf-page\" data-pf-view=\"writing\" aria-labelledby=\"pf-min-essay-title\" hidden>\n    <p class=\"pf-back\"><a href=\"#/writing\" data-router-link>← All writing</a></p>\n    <header class=\"pf-page-head\">\n      <p class=\"pf-meta\"><time data-case=\"date\">2 October 2026</time> · <span data-case=\"minutes\">5 min read</span></p>\n      <h1 class=\"pf-page-title\" id=\"pf-min-essay-title\" data-case=\"title\">Undo is a feature, not a stack</h1>\n    </header>\n    <div class=\"pf-essay\" data-case-paras=\"body\">\n      <p\n        >Every editor I have worked on started with the same undo: a stack of the last hundred changes, popped one at a\n        time. It works until two people edit the same document, or one person edits it on two devices - then the stack\n        is a lie about whose change comes next.</p\n      >\n    </div>\n    <p class=\"pf-signoff\">- Noor</p>\n    <nav class=\"pf-pager\" aria-label=\"More writing\">\n      <a href=\"#/writing/ten-years\" data-router-link data-case-link=\"prev\"\n        ><small>Previous</small><span data-case-title=\"prev\">Ten years of text editors</span></a\n      >\n      <a href=\"#/writing/right-to-left\" data-router-link data-case-link=\"next\"\n        ><small>Next</small><span data-case-title=\"next\">Right to left is not a mirror</span></a\n      >\n    </nav>\n  </article>\n  <footer class=\"mk-footer\" data-variant=\"simple\">\n    <div class=\"mk-footer-inner\">\n      <a class=\"mk-footer-brand\" href=\"#/\" data-router-link\n        ><span class=\"mk-footer-brand-name\">Noor Haddad<span>.</span></span></a\n      >\n      <ul class=\"mk-footer-links\">\n        <li><a href=\"#/projects\" data-router-link>Projects</a></li>\n        <li><a href=\"#/writing\" data-router-link>Writing</a></li>\n        <li><a href=\"mailto:noor@example.com\">noor@example.com</a></li>\n        <li><a href=\"https://github.com/\" target=\"_blank\" rel=\"noopener\">GitHub</a></li>\n        <li><a href=\"https://mastodon.social/\" target=\"_blank\" rel=\"noopener\">Mastodon</a></li>\n      </ul>\n      <p class=\"mk-footer-copy\">Last updated November 2026.</p>\n    </div>\n  </footer>\n  <!-- the projects and essays the routes name, in order -->\n  \n</div>\n","individual":false}]
