[{"label":"Onboarding, drawn and driven both ways","html":"<div class=\"flex flex-wrap gap-6 items-start\">\n  <form class=\"questionnaire\" id=\"q-onboard\" aria-label=\"Onboarding\" data-persist=\"none\" style=\"flex: 1 1 18rem\">\n    <div class=\"questionnaire-progress\"></div>\n    <fieldset class=\"questionnaire-step\" data-step=\"role\">\n      <legend class=\"questionnaire-title\">Your role?</legend>\n      <div class=\"questionnaire-choices\">\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"role\" value=\"dev\" required data-goto=\"repo\" /><span\n            class=\"questionnaire-choice-label\"\n            >Engineer</span\n          ></label\n        >\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"role\" value=\"pm\" data-goto=\"size\" /><span class=\"questionnaire-choice-label\"\n            >Manager</span\n          ></label\n        >\n      </div>\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"repo\" data-next=\"size\">\n      <legend class=\"questionnaire-title\">Connect a repository?</legend>\n      <div class=\"questionnaire-choices\">\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"repo\" value=\"github\" required /><span class=\"questionnaire-choice-label\"\n            >GitHub</span\n          ></label\n        >\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"repo\" value=\"later\" /><span class=\"questionnaire-choice-label\">Later</span></label\n        >\n      </div>\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"size\">\n      <legend class=\"questionnaire-title\">Team size?</legend>\n      <input class=\"input\" name=\"size\" type=\"number\" min=\"1\" required aria-label=\"Team size\" style=\"max-width: 8rem\" />\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"sales\" data-next=\"done\">\n      <legend class=\"questionnaire-title\">Talk to sales?</legend>\n      <div class=\"questionnaire-choices\">\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"sales\" value=\"yes\" required /><span class=\"questionnaire-choice-label\"\n            >Yes please</span\n          ></label\n        >\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"sales\" value=\"no\" /><span class=\"questionnaire-choice-label\"\n            >No thanks</span\n          ></label\n        >\n      </div>\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"done\" data-end>\n      <legend class=\"questionnaire-title\">You're set</legend>\n      <div class=\"questionnaire-summary\"></div>\n    </fieldset>\n    <div class=\"questionnaire-actions\">\n      <button class=\"btn\" data-variant=\"ghost\" type=\"button\" data-questionnaire=\"back\">Back</button>\n      <button class=\"btn\" type=\"submit\" data-questionnaire=\"next\">Continue</button>\n      <button class=\"btn\" type=\"submit\" data-questionnaire=\"submit\">Finish</button>\n    </div>\n    <div class=\"questionnaire-complete\"><p>Welcome!</p></div>\n    \n  </form>\n  <figure\n    class=\"diagram\"\n    id=\"q-onboard-graph\"\n    aria-label=\"The onboarding flow\"\n    style=\"flex: 1 1 20rem; margin: 0\"\n  ></figure>\n</div>\n","individual":false},{"label":"A broken flow, explained","html":"<div class=\"flex flex-col gap-3\" style=\"max-width: 40rem\">\n  <form class=\"questionnaire\" id=\"q-broken\" aria-label=\"A broken flow\" data-persist=\"none\" hidden>\n    <fieldset class=\"questionnaire-step\" data-step=\"start\">\n      <legend class=\"questionnaire-title\">Start</legend>\n      <label class=\"questionnaire-choice\"\n        ><input type=\"radio\" name=\"path\" value=\"a\" required data-goto=\"details\" /><span>A</span></label\n      >\n      <label class=\"questionnaire-choice\"\n        ><input type=\"radio\" name=\"path\" value=\"b\" data-goto=\"extra\" /><span>B</span></label\n      >\n      <label class=\"questionnaire-choice\"\n        ><input type=\"radio\" name=\"path\" value=\"c\" data-goto=\"summery\" /><span>C</span></label\n      >\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"extra\" data-next=\"details\"\n      ><legend class=\"questionnaire-title\">Extra</legend><input name=\"coupon\" required aria-label=\"Coupon\"\n    /></fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"details\" data-next=\"confirm\" data-depends-on=\"voucher\"\n      ><legend class=\"questionnaire-title\">Details</legend><input name=\"name\" required aria-label=\"Name\"\n    /></fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"confirm\" data-next=\"details\"\n      ><legend class=\"questionnaire-title\">Confirm</legend><input name=\"ok\" aria-label=\"OK\"\n    /></fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"orphan\" data-next=\"end\"\n      ><legend class=\"questionnaire-title\">Never reached</legend></fieldset\n    >\n    <fieldset class=\"questionnaire-step\" data-step=\"end\" data-end\n      ><legend class=\"questionnaire-title\">End</legend></fieldset\n    >\n    <fieldset class=\"questionnaire-step\" data-step=\"stuck\"\n      ><legend class=\"questionnaire-title\">Leads nowhere</legend></fieldset\n    >\n    \n  </form>\n  <div class=\"card\"\n    ><div class=\"card-content\" style=\"padding-block: 1rem\">\n      <p class=\"text-sm font-medium m-0 mb-2\">Errors</p>\n      <ul class=\"text-sm m-0 mb-3 ps-5\" id=\"q-broken-errors\"></ul>\n      <p class=\"text-sm font-medium m-0 mb-2\">Warnings</p>\n      <ul class=\"text-sm m-0 ps-5\" id=\"q-broken-warnings\"></ul> </div\n  ></div>\n</div>\n","individual":false}]
