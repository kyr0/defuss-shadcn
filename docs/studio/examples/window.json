[{"label":"Window","html":"<div class=\"window-desktop\" style=\"height: 20rem\">\n  <dialog class=\"window\" open data-resizable style=\"--window-x: 2rem; --window-y: 1.5rem; --window-w: 22rem\">\n    <header class=\"window-titlebar\">\n      <i data-lucide=\"notebook-pen\" class=\"window-icon\"></i>\n      <h2 class=\"window-title\">Notes</h2>\n      <form method=\"dialog\" class=\"window-controls\">\n        <button type=\"button\" class=\"window-minimize\" aria-label=\"Minimize\"></button>\n        <button type=\"button\" class=\"window-maximize\" aria-label=\"Maximize\"></button>\n        <button class=\"window-close\" aria-label=\"Close\"></button>\n      </form>\n    </header>\n    <div class=\"window-body\">\n      <p class=\"m-0 text-sm\">Windows are non-modal dialogs: the page and every other window stay usable.</p>\n    </div>\n    <footer class=\"window-statusbar\">1 note</footer>\n  </dialog>\n</div>\n","individual":true},{"label":"Several windows","html":"<div class=\"window-desktop\" style=\"height: 22rem\">\n  <dialog class=\"window\" open style=\"--window-x: 1.5rem; --window-y: 1.5rem; --window-w: 16rem\">\n    <header class=\"window-titlebar\">\n      <i data-lucide=\"folder\" class=\"window-icon\"></i>\n      <h2 class=\"window-title\">Projects</h2>\n      <form method=\"dialog\" class=\"window-controls\">\n        <button type=\"button\" class=\"window-minimize\" aria-label=\"Minimize\"></button>\n        <button type=\"button\" class=\"window-maximize\" aria-label=\"Maximize\"></button>\n        <button class=\"window-close\" aria-label=\"Close\"></button>\n      </form>\n    </header>\n    <div class=\"window-body text-sm\">design-system/<br />marketing-site/<br />prototypes/</div>\n  </dialog>\n  <dialog class=\"window\" open style=\"--window-x: 9rem; --window-y: 4.5rem; --window-w: 17rem\">\n    <header class=\"window-titlebar\">\n      <i data-lucide=\"image\" class=\"window-icon\"></i>\n      <h2 class=\"window-title\">Preview</h2>\n      <form method=\"dialog\" class=\"window-controls\">\n        <button type=\"button\" class=\"window-minimize\" aria-label=\"Minimize\"></button>\n        <button type=\"button\" class=\"window-maximize\" aria-label=\"Maximize\"></button>\n        <button class=\"window-close\" aria-label=\"Close\"></button>\n      </form>\n    </header>\n    <div class=\"window-body text-sm\">hero.png - 1600 × 900</div>\n  </dialog>\n  <dialog class=\"window\" open style=\"--window-x: 17rem; --window-y: 8rem; --window-w: 16rem\">\n    <header class=\"window-titlebar\">\n      <i data-lucide=\"terminal\" class=\"window-icon\"></i>\n      <h2 class=\"window-title\">Terminal</h2>\n      <form method=\"dialog\" class=\"window-controls\">\n        <button type=\"button\" class=\"window-minimize\" aria-label=\"Minimize\"></button>\n        <button type=\"button\" class=\"window-maximize\" aria-label=\"Maximize\"></button>\n        <button class=\"window-close\" aria-label=\"Close\"></button>\n      </form>\n    </header>\n    <div class=\"window-body text-sm\" style=\"font-family: var(--font-mono)\">$ bun run build<br />verify: OK</div>\n  </dialog>\n</div>\n","individual":true},{"label":"Chrome","html":"<div class=\"window-desktop\" style=\"height: 24rem\">\n  <dialog class=\"window\" open style=\"--window-x: 1rem; --window-y: 1rem; --window-w: 19rem\">\n    <header class=\"window-titlebar\">\n      <i data-lucide=\"app-window\" class=\"window-icon\"></i>\n      <h2 class=\"window-title\">Windows</h2>\n      <form method=\"dialog\" class=\"window-controls\">\n        <button type=\"button\" class=\"window-minimize\" aria-label=\"Minimize\"></button>\n        <button type=\"button\" class=\"window-maximize\" aria-label=\"Maximize\"></button>\n        <button class=\"window-close\" aria-label=\"Close\"></button>\n      </form>\n    </header>\n    <div class=\"window-body text-sm\">data-chrome=\"windows\"</div>\n  </dialog>\n  <dialog class=\"window\" open data-chrome=\"mac\" style=\"--window-x: 21rem; --window-y: 1rem; --window-w: 19rem\">\n    <header class=\"window-titlebar\">\n      <i data-lucide=\"apple\" class=\"window-icon\"></i>\n      <h2 class=\"window-title\">macOS</h2>\n      <form method=\"dialog\" class=\"window-controls\">\n        <button type=\"button\" class=\"window-minimize\" aria-label=\"Minimize\"></button>\n        <button type=\"button\" class=\"window-maximize\" aria-label=\"Maximize\"></button>\n        <button class=\"window-close\" aria-label=\"Close\"></button>\n      </form>\n    </header>\n    <div class=\"window-body text-sm\">data-chrome=\"mac\"</div>\n  </dialog>\n  <dialog class=\"window\" open data-chrome=\"linux\" style=\"--window-x: 1rem; --window-y: 12rem; --window-w: 19rem\">\n    <header class=\"window-titlebar\">\n      <i data-lucide=\"terminal-square\" class=\"window-icon\"></i>\n      <h2 class=\"window-title\">Linux</h2>\n      <form method=\"dialog\" class=\"window-controls\">\n        <button type=\"button\" class=\"window-minimize\" aria-label=\"Minimize\"></button>\n        <button type=\"button\" class=\"window-maximize\" aria-label=\"Maximize\"></button>\n        <button class=\"window-close\" aria-label=\"Close\"></button>\n      </form>\n    </header>\n    <div class=\"window-body text-sm\">data-chrome=\"linux\"</div>\n  </dialog>\n  <dialog class=\"window\" open data-chrome=\"retro\" style=\"--window-x: 21rem; --window-y: 12rem; --window-w: 19rem\">\n    <header class=\"window-titlebar\">\n      <i data-lucide=\"monitor\" class=\"window-icon\"></i>\n      <h2 class=\"window-title\">Retro</h2>\n      <form method=\"dialog\" class=\"window-controls\">\n        <button type=\"button\" class=\"window-minimize\" aria-label=\"Minimize\"></button>\n        <button type=\"button\" class=\"window-maximize\" aria-label=\"Maximize\"></button>\n        <button class=\"window-close\" aria-label=\"Close\"></button>\n      </form>\n    </header>\n    <div class=\"window-body text-sm\">data-chrome=\"retro\"</div>\n    <footer class=\"window-statusbar\">Ready</footer>\n  </dialog>\n</div>\n","individual":true},{"label":"Driven from script","html":"<div class=\"flex flex-col gap-3\">\n  <div class=\"flex flex-wrap items-center gap-2\">\n    <button class=\"btn\" data-size=\"sm\" id=\"w-new\"><i data-lucide=\"plus\"></i> New window</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"w-cascade\">Cascade</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"w-tile\">Tile</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"w-close\">Close active</button>\n    <output class=\"text-sm text-muted-foreground\" id=\"w-log\"></output>\n  </div>\n  <div class=\"window-desktop\" id=\"w-desk\" style=\"height: 22rem\"></div>\n</div>\n","individual":false},{"label":"Window states","html":"<div class=\"flex flex-col gap-3\">\n  <div class=\"flex flex-wrap items-center gap-2\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-to=\"default\">default</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-to=\"maximized\">maximized</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-to=\"minimized\">minimized</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-to=\"closed\">closed</button>\n    <output class=\"text-sm text-muted-foreground\" id=\"st-out\">default</output>\n  </div>\n  <div class=\"window-desktop\" style=\"height: 16rem\">\n    <dialog\n      class=\"window\"\n      id=\"st-win\"\n      open\n      data-chrome=\"mac\"\n      style=\"--window-x: 2rem; --window-y: 2rem; --window-w: 20rem\"\n    >\n      <header class=\"window-titlebar\">\n        <i data-lucide=\"settings\" class=\"window-icon\"></i>\n        <h2 class=\"window-title\">Settings</h2>\n        <form method=\"dialog\" class=\"window-controls\">\n          <button type=\"button\" class=\"window-minimize\" aria-label=\"Minimize\"></button>\n          <button type=\"button\" class=\"window-maximize\" aria-label=\"Maximize\"></button>\n          <button class=\"window-close\" aria-label=\"Close\"></button>\n        </form>\n      </header>\n      <div class=\"window-body text-sm\">el.api.setState(name) - or use the traffic lights.</div>\n    </dialog>\n  </div>\n</div>\n","individual":false}]
