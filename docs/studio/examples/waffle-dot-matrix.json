[{"label":"Pixel Arcade","html":"<section\n  class=\"presentation\"\n  id=\"deck-waffle\"\n  data-anim-in=\"popIn\"\n  data-anim-out=\"zoomOut\"\n  style=\"\n    --presentation-ink: #17142f;\n    --presentation-ink-foreground: #fff9d8;\n    --presentation-paper: #fff9d8;\n    --presentation-paper-foreground: #17142f;\n    --presentation-accent: #ff5c8a;\n    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"Player one: where 100 players play\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Main gaming platform of 100 players as a 10 by 10 waffle: mobile 47, console 26, PC 21, handheld 6 in 2025, versus mobile 38, console 31, PC 25, handheld 6 in 2020; then weekly play hours by platform\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Cover\">\n    <svg\n      aria-hidden=\"true\"\n      width=\"520\"\n      height=\"400\"\n      viewBox=\"0 0 13 10\"\n      style=\"position: absolute; right: 150px; top: 220px; image-rendering: pixelated\"\n      shape-rendering=\"crispEdges\"\n    >\n      <g fill=\"#FF5C8A\">\n        <rect x=\"2\" y=\"0\" width=\"1\" height=\"1\" />\n        <rect x=\"8\" y=\"0\" width=\"1\" height=\"1\" />\n        <rect x=\"3\" y=\"1\" width=\"1\" height=\"1\" />\n        <rect x=\"7\" y=\"1\" width=\"1\" height=\"1\" />\n        <rect x=\"2\" y=\"2\" width=\"1\" height=\"1\" />\n        <rect x=\"3\" y=\"2\" width=\"1\" height=\"1\" />\n        <rect x=\"4\" y=\"2\" width=\"1\" height=\"1\" />\n        <rect x=\"5\" y=\"2\" width=\"1\" height=\"1\" />\n        <rect x=\"6\" y=\"2\" width=\"1\" height=\"1\" />\n        <rect x=\"7\" y=\"2\" width=\"1\" height=\"1\" />\n        <rect x=\"8\" y=\"2\" width=\"1\" height=\"1\" />\n        <rect x=\"1\" y=\"3\" width=\"1\" height=\"1\" />\n        <rect x=\"2\" y=\"3\" width=\"1\" height=\"1\" />\n        <rect x=\"4\" y=\"3\" width=\"1\" height=\"1\" />\n        <rect x=\"5\" y=\"3\" width=\"1\" height=\"1\" />\n        <rect x=\"6\" y=\"3\" width=\"1\" height=\"1\" />\n        <rect x=\"8\" y=\"3\" width=\"1\" height=\"1\" />\n        <rect x=\"9\" y=\"3\" width=\"1\" height=\"1\" />\n        <rect x=\"0\" y=\"4\" width=\"1\" height=\"1\" />\n        <rect x=\"1\" y=\"4\" width=\"1\" height=\"1\" />\n        <rect x=\"2\" y=\"4\" width=\"1\" height=\"1\" />\n        <rect x=\"3\" y=\"4\" width=\"1\" height=\"1\" />\n        <rect x=\"4\" y=\"4\" width=\"1\" height=\"1\" />\n        <rect x=\"5\" y=\"4\" width=\"1\" height=\"1\" />\n        <rect x=\"6\" y=\"4\" width=\"1\" height=\"1\" />\n        <rect x=\"7\" y=\"4\" width=\"1\" height=\"1\" />\n        <rect x=\"8\" y=\"4\" width=\"1\" height=\"1\" />\n        <rect x=\"9\" y=\"4\" width=\"1\" height=\"1\" />\n        <rect x=\"10\" y=\"4\" width=\"1\" height=\"1\" />\n        <rect x=\"0\" y=\"5\" width=\"1\" height=\"1\" />\n        <rect x=\"2\" y=\"5\" width=\"1\" height=\"1\" />\n        <rect x=\"3\" y=\"5\" width=\"1\" height=\"1\" />\n        <rect x=\"4\" y=\"5\" width=\"1\" height=\"1\" />\n        <rect x=\"5\" y=\"5\" width=\"1\" height=\"1\" />\n        <rect x=\"6\" y=\"5\" width=\"1\" height=\"1\" />\n        <rect x=\"7\" y=\"5\" width=\"1\" height=\"1\" />\n        <rect x=\"8\" y=\"5\" width=\"1\" height=\"1\" />\n        <rect x=\"10\" y=\"5\" width=\"1\" height=\"1\" />\n        <rect x=\"0\" y=\"6\" width=\"1\" height=\"1\" />\n        <rect x=\"2\" y=\"6\" width=\"1\" height=\"1\" />\n        <rect x=\"8\" y=\"6\" width=\"1\" height=\"1\" />\n        <rect x=\"10\" y=\"6\" width=\"1\" height=\"1\" />\n        <rect x=\"3\" y=\"7\" width=\"1\" height=\"1\" />\n        <rect x=\"4\" y=\"7\" width=\"1\" height=\"1\" />\n        <rect x=\"6\" y=\"7\" width=\"1\" height=\"1\" />\n        <rect x=\"7\" y=\"7\" width=\"1\" height=\"1\" />\n      </g>\n      <rect x=\"0\" y=\"9\" width=\"13\" height=\"1\" fill=\"#FFF9D8\" opacity=\"0.5\" />\n    </svg>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\"\n      >Waffle dot matrix · Pixel Arcade</p\n    >\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        position: relative;\n        max-width: 1250px;\n        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n        font-weight: 800;\n        letter-spacing: -0.02em;\n        text-transform: uppercase;\n        font-size: 4.75rem;\n        max-width: 900px;\n      \"\n      >Player one: where 100 players play</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >One pixel per player, one grid of 100 - and five years of platform shifts.</p\n    >\n    <p class=\"presentation-note\">Insert coin.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"y2025\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Players 2025\"\n  >\n    <header class=\"presentation-header\"><span>Level 1</span><span>Main platform · 2025</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n        font-weight: 800;\n        letter-spacing: -0.02em;\n        text-transform: uppercase;\n        font-size: 3rem;\n      \"\n      >47 of 100 play mostly on mobile</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Count the pixels - percentages become countable.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"y2020\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Players 2020\"\n  >\n    <header class=\"presentation-header\"><span>Level 2</span><span>Main platform · 2020</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n        font-weight: 800;\n        letter-spacing: -0.02em;\n        text-transform: uppercase;\n        font-size: 3rem;\n      \"\n      >Rewind to 2020: mobile had 38</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Nine pixels change colour - from console and PC to mobile.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"bars\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Bars\"\n  >\n    <header class=\"presentation-header\"><span>Level 3</span><span>Share of players · 2025</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n        font-weight: 800;\n        letter-spacing: -0.02em;\n        text-transform: uppercase;\n        font-size: 3rem;\n      \"\n      >Stack the pixels: mobile is almost half</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Each platform’s pixels merge into its bar.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">High score</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #ff5c8a;\n            font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n            font-weight: 800;\n            letter-spacing: -0.02em;\n            text-transform: uppercase;\n          \"\n          ><span data-count=\"47\">47</span>/100</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">play mainly on mobile</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n            font-weight: 800;\n            letter-spacing: -0.02em;\n            text-transform: uppercase;\n          \"\n          >+<span data-count=\"9\">9</span></p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">mobile pixels since 2020</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n            font-weight: 800;\n            letter-spacing: -0.02em;\n            text-transform: uppercase;\n          \"\n          ><span data-count=\"11.2\">11.2</span> h</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\"\n          >weekly play time on PC - the longest sessions</p\n        >\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >Mobile wins the headcount. PC wins the hours.</p\n    >\n    <p class=\"presentation-note\">Headcount versus time - the twist.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"The controller\">\n    <header class=\"presentation-header\"><span>Bonus level</span><span>Console</span></header>\n    <div style=\"display: flex; gap: 4.5rem; align-items: center; margin-top: 3.5rem\">\n      <figure\n        class=\"image\"\n        data-ratio=\"4/3\"\n        data-df-entrance=\"pop\"\n        style=\"--df-motion-delay: 150ms; flex: 0 0 700px; margin: 0\"\n      >\n        <img\n          src=\"https://picsum.photos/id/96/960/720\"\n          alt=\"A game controller lying on a dark surface, lit from behind\"\n          loading=\"lazy\"\n          width=\"960\"\n          height=\"720\"\n          style=\"width: 100%; height: 100%; object-fit: cover\"\n        />\n        <figcaption class=\"image-caption\" style=\"font-size: 1.25rem\">Player two, ready (stock photo).</figcaption>\n      </figure>\n      <div style=\"flex: 1 1 0; min-width: 0\">\n        <h2\n          class=\"presentation-title\"\n          data-df-entrance=\"up\"\n          style=\"\n            font-size: 3.4rem;\n            font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n            font-weight: 800;\n            letter-spacing: -0.02em;\n            text-transform: uppercase;\n            font-size: 3rem;\n          \"\n          >Console players are fewer - but loyal</h2\n        >\n        <p class=\"presentation-lede\" data-df-entrance=\"fade\" style=\"--df-motion-delay: 300ms; font-size: 1.7rem\"\n          >81% of console players still play on the same console family they owned in 2020.</p\n        >\n      </div>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The loyal minority.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"north\"\n    data-anim-in-blocks=\"12\"\n    data-anim-in-stagger=\"25\"\n    data-anim-in-color=\"#FF5C8A\"\n    aria-label=\"Platform table\"\n  >\n    <header class=\"presentation-header\"><span>Scoreboard</span><span>Of 100 players</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" data-density=\"spacious\" style=\"font-size: 1.7rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Main gaming platform per 100 players, and weekly play time (synthetic survey).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Platform</th><th class=\"table-head\" style=\"text-align: right\">2020</th\n            ><th class=\"table-head\" style=\"text-align: right\">2025</th\n            ><th class=\"table-head\" style=\"text-align: right\">Hours / week</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Mobile</td><td class=\"table-cell\" style=\"text-align: right\">38</td\n            ><td class=\"table-cell\" style=\"text-align: right\">47</td\n            ><td class=\"table-cell\" style=\"text-align: right\">5.3</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Console</td><td class=\"table-cell\" style=\"text-align: right\">31</td\n            ><td class=\"table-cell\" style=\"text-align: right\">26</td\n            ><td class=\"table-cell\" style=\"text-align: right\">9.4</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">PC</td><td class=\"table-cell\" style=\"text-align: right\">25</td\n            ><td class=\"table-cell\" style=\"text-align: right\">21</td\n            ><td class=\"table-cell\" style=\"text-align: right\">11.2</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Handheld</td><td class=\"table-cell\" style=\"text-align: right\">6</td\n            ><td class=\"table-cell\" style=\"text-align: right\">6</td\n            ><td class=\"table-cell\" style=\"text-align: right\">6.1</td></tr\n          >\n        </tbody>\n        <tfoot>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">All</td><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">100</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">100</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">7.7</td></tr\n          >\n        </tfoot>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Hours are per player of that platform.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"\n          font-size: 3.3rem;\n          line-height: 1.22;\n          font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n          font-weight: 800;\n          letter-spacing: -0.02em;\n          text-transform: uppercase;\n          font-size: 2.8rem;\n        \"\n        >“Mobile is where people start playing. PC is where they stay up until two.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #ff5c8a; color: #17142f\"\n        ><span class=\"avatar-fallback\">KD</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Kai Dorsey<br /><span style=\"opacity: 0.7; font-size: 1.4rem\"\n          >Games researcher - 6,000 players surveyed</span\n        ></p\n      >\n    </div>\n    <p class=\"presentation-note\">The two-in-the-morning line always gets a laugh.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"hours\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Hours\"\n  >\n    <header class=\"presentation-header\"><span>Final level</span><span>Weekly play time per player</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n        font-weight: 800;\n        letter-spacing: -0.02em;\n        text-transform: uppercase;\n        font-size: 3rem;\n      \"\n      >By time played, the order flips</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The same bars re-sort by hours - PC first, mobile last.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Questions from the studio\"\n  >\n    <header class=\"presentation-header\"><span>Q & A</span><span>Game studio</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.2rem;\n        margin-block: 5.25rem 1.5rem;\n        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n        font-weight: 800;\n        letter-spacing: -0.02em;\n        text-transform: uppercase;\n        font-size: 2.8rem;\n      \"\n      >Questions from the studio</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"wf-qa2\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Should we build mobile first?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\">For reach, yes - for revenue per player, PC and console still lead.</p></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"wf-qa2\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Why is handheld flat?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Six players in 100 in both years: a stable niche, strongly tied to one hardware generation.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"wf-qa2\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>What does “main platform” mean?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >The platform with the most hours in the survey week; many players use two.</p\n          ></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Definitions matter - answer the third one carefully.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Game over</span><span>Continue?</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">▶</span\n        ><span>Waffles make shares countable - 47 pixels, not “47%”.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">▶</span\n        ><span>Mobile gained nine players in five years.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">▶</span\n        ><sp