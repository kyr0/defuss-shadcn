[{"label":"Logon","html":"<div class=\"logon\" id=\"logon-demo\" aria-label=\"Sign in\">\n  <div class=\"logon-main\">\n    <div class=\"logon-brand\">\n      <strong>Workstation</strong>\n      <span class=\"text-sm text-muted-foreground\">Pick your name to begin</span>\n    </div>\n    <ul class=\"logon-users\">\n      <li>\n        <button class=\"logon-user\" type=\"button\" data-user=\"ada\">\n          <span class=\"avatar\"><span class=\"avatar-fallback\">AL</span></span>\n          <span class=\"logon-name\">Ada</span>\n        </button>\n      </li>\n      <li>\n        <button class=\"logon-user\" type=\"button\" data-user=\"guest\" data-no-password=\"\">\n          <span class=\"avatar\"><span class=\"avatar-fallback\">G</span></span>\n          <span class=\"logon-name\">Guest</span>\n        </button>\n      </li>\n    </ul>\n    <form class=\"logon-form\" hidden>\n      <p class=\"logon-for\"></p>\n      <div class=\"logon-field\">\n        <input class=\"input\" type=\"password\" name=\"password\" aria-label=\"Password\" autocomplete=\"current-password\" />\n        <button class=\"btn\" type=\"submit\" aria-label=\"Sign in\"><i data-lucide=\"arrow-right\"></i></button>\n      </div>\n      <p class=\"logon-error\" role=\"alert\" hidden></p>\n    </form>\n  </div>\n  <div class=\"logon-power\">\n    <button class=\"btn\" data-variant=\"ghost\" type=\"button\" data-logon-power=\"shutdown\"\n      ><i data-lucide=\"power\"></i> Turn off</button\n    >\n  </div>\n</div>\n","individual":true},{"label":"Sign in and lock","html":"<div class=\"grid gap-2\">\n  <label class=\"flex items-center gap-2 text-sm\"\n    >Look\n    <select class=\"select\" data-look style=\"width: auto\">\n      <option value=\"\">Modern</option>\n      <option value=\"win7\">7</option>\n      <option value=\"winxp\">XP</option>\n      <option value=\"win98\">98</option>\n      <option value=\"win95\">95</option>\n    </select></label\n  >\n\n  <div class=\"desktop\" style=\"height: 24rem\">\n    <div class=\"window-desktop window-manager grid place-items-center\">\n      <button class=\"btn\" type=\"button\" id=\"logon-lock\"><i data-lucide=\"lock\"></i> Lock</button>\n    </div>\n    <div class=\"logon\" id=\"logon-demo\" data-state-demo aria-label=\"Sign in\">\n      <div class=\"logon-main\">\n        <div class=\"logon-brand\">\n          <strong>Workstation</strong>\n          <span class=\"text-sm text-muted-foreground\">Pick your name to begin</span>\n        </div>\n        <ul class=\"logon-users\">\n          <li>\n            <button class=\"logon-user\" type=\"button\" data-user=\"ada\">\n              <span class=\"avatar\"><img class=\"avatar-image\" src=\"images/avatars/5-96.webp\" alt=\"\" /></span>\n              <span class=\"logon-name\">Ada</span>\n            </button>\n          </li>\n          <li>\n            <button class=\"logon-user\" type=\"button\" data-user=\"guest\" data-no-password>\n              <span class=\"avatar\"><span class=\"avatar-fallback\">G</span></span>\n              <span class=\"logon-name\">Guest</span>\n            </button>\n          </li>\n        </ul>\n        <form class=\"logon-form\" hidden>\n          <p class=\"logon-for\"></p>\n          <div class=\"logon-field\">\n            <input\n              class=\"input\"\n              type=\"password\"\n              name=\"password\"\n              aria-label=\"Password\"\n              autocomplete=\"current-password\"\n            />\n            <button class=\"btn\" type=\"submit\" aria-label=\"Sign in\"><i data-lucide=\"arrow-right\"></i></button>\n          </div>\n          <p class=\"logon-error\" role=\"alert\" hidden></p>\n        </form>\n      </div>\n      <div class=\"logon-power\">\n        <button class=\"btn\" data-variant=\"ghost\" type=\"button\" data-logon-power=\"shutdown\"\n          ><i data-lucide=\"power\"></i> Turn off</button\n        >\n      </div>\n    </div>\n  </div>\n</div>\n","individual":false}]
