[{"label":"10,000 nodes","html":"<div class=\"grid gap-2\">\n  <div class=\"toolbar flex-wrap\" role=\"toolbar\" aria-label=\"Navigate 10,000 nodes\">\n    <button class=\"toggle\" id=\"big-follow\" type=\"button\" aria-pressed=\"true\" data-size=\"sm\">\n      <svg\n        aria-hidden=\"true\"\n        width=\"16\"\n        height=\"16\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n      >\n        <circle cx=\"12\" cy=\"12\" r=\"10\" />\n        <path d=\"M22 12h-4M6 12H2M12 6V2M12 22v-4\" />\n      </svg>\n      Follow\n    </button>\n    <div class=\"separator\" data-orientation=\"vertical\" role=\"separator\"></div>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"big\"\n      data-workflow-action=\"fit\"\n      >Fit</button\n    >\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"big\"\n      data-workflow-action=\"zoom-in\"\n      >Zoom in</button\n    >\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-workflow-for=\"big\"\n      data-workflow-action=\"zoom-out\"\n      >Zoom out</button\n    >\n    <span class=\"text-sm text-muted-foreground\">\n      <span data-workflow-for=\"big\" data-workflow-output=\"nodes\"></span> nodes ·\n      <span data-workflow-for=\"big\" data-workflow-output=\"edges\"></span> connections ·\n      <span data-workflow-for=\"big\" data-workflow-output=\"drawn\"></span> ·\n      <span data-workflow-for=\"big\" data-workflow-output=\"cards\"></span> ·\n      <span data-workflow-for=\"big\" data-workflow-output=\"frame\"></span>\n    </span>\n  </div>\n  <div class=\"grid gap-2\" style=\"grid-template-columns: minmax(11rem, 15rem) minmax(0, 1fr)\">\n    <div class=\"grid gap-2 content-start\">\n      <input class=\"input\" data-tree-filter=\"big-tree\" aria-label=\"Find a node\" placeholder=\"Find a node…\" />\n      <div\n        class=\"data-tree\"\n        id=\"big-tree\"\n        aria-label=\"10,000 nodes in ten groups\"\n        data-label-field=\"title\"\n        data-exclusive\n        data-persist=\"none\"\n        style=\"height: 25rem\"\n      ></div>\n    </div>\n    <div\n      class=\"workflow\"\n      id=\"big\"\n      data-generate=\"10000\"\n      data-edges=\"100000\"\n      data-seed=\"7\"\n      data-stage=\"100\"\n      data-groups=\"10\"\n      aria-label=\"A synthetic workflow of 10,000 nodes in ten groups\"\n      style=\"--workflow-height: 27.75rem\"\n    ></div>\n  </div>\n</div>\n","individual":false},{"label":"Collapsed stages","html":"<div\n  class=\"workflow\"\n  id=\"stages\"\n  data-generate=\"48\"\n  data-edges=\"80\"\n  data-seed=\"3\"\n  data-stage=\"4\"\n  data-groups=\"3\"\n  data-collapsed\n  data-worker=\"none\"\n  aria-label=\"Stages in groups\"\n  style=\"--workflow-height: 26rem\"\n></div>\n","individual":false}]
