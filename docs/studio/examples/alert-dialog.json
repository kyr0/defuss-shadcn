[{"label":"Alert Dialog","html":"<dialog\n  id=\"density-ad-compact\"\n  class=\"alert-dialog\"\n  data-density=\"compact\"\n  role=\"alertdialog\"\n  aria-modal=\"true\"\n  aria-labelledby=\"dac-title\"\n>\n  <div class=\"alert-dialog-content\">\n    <div class=\"alert-dialog-header\">\n      <h2 class=\"alert-dialog-title\" id=\"dac-title\">Compact density</h2>\n      <p class=\"alert-dialog-description\">Content padding is 1rem instead of the default 1.5rem.</p>\n    </div>\n    <div class=\"alert-dialog-footer\"\n      ><button class=\"btn\" data-variant=\"outline\" data-alert-dialog-close=\"\">Close</button></div\n    >\n  </div>\n</dialog>\n","individual":true},{"label":"Basic","html":"<button class=\"btn\" data-variant=\"outline\" data-alert-dialog-trigger=\"demo-alert-dialog-1\">Delete Account</button>\n<dialog\n  id=\"demo-alert-dialog-1\"\n  class=\"alert-dialog\"\n  role=\"alertdialog\"\n  aria-modal=\"true\"\n  aria-labelledby=\"ad1-title\"\n  aria-describedby=\"ad1-desc\"\n>\n  <div class=\"alert-dialog-content\">\n    <div class=\"alert-dialog-header\">\n      <h2 class=\"alert-dialog-title\" id=\"ad1-title\">Are you absolutely sure?</h2>\n      <p class=\"alert-dialog-description\" id=\"ad1-desc\"\n        >This action cannot be undone. This will permanently delete your account and remove your data from our\n        servers.</p\n      >\n    </div>\n    <div class=\"alert-dialog-footer\">\n      <button class=\"btn\" data-variant=\"outline\" data-alert-dialog-close>Cancel</button>\n      <button class=\"btn\" data-variant=\"destructive\" data-alert-dialog-close>Delete</button>\n    </div>\n  </div>\n</dialog>\n","individual":false},{"label":"Confirmation","html":"<button class=\"btn\" data-variant=\"default\" data-alert-dialog-trigger=\"demo-alert-dialog-2\">Publish Post</button>\n<dialog\n  id=\"demo-alert-dialog-2\"\n  class=\"alert-dialog\"\n  role=\"alertdialog\"\n  aria-modal=\"true\"\n  aria-labelledby=\"ad2-title\"\n  aria-describedby=\"ad2-desc\"\n>\n  <div class=\"alert-dialog-content\">\n    <div class=\"alert-dialog-header\">\n      <h2 class=\"alert-dialog-title\" id=\"ad2-title\">Publish this post?</h2>\n      <p class=\"alert-dialog-description\" id=\"ad2-desc\"\n        >Once published, this post will be visible to all users. You can unpublish it later from the dashboard.</p\n      >\n    </div>\n    <div class=\"alert-dialog-footer\">\n      <button class=\"btn\" data-variant=\"outline\" data-alert-dialog-close>Cancel</button>\n      <button class=\"btn\" data-variant=\"default\" data-alert-dialog-close>Publish</button>\n    </div>\n  </div>\n</dialog>\n","individual":false},{"label":"Density","html":"<div class=\"flex flex-wrap gap-2\">\n  <button class=\"btn\" data-variant=\"outline\" data-alert-dialog-trigger=\"density-ad-compact\">Compact</button>\n  <dialog\n    id=\"density-ad-compact\"\n    class=\"alert-dialog\"\n    data-density=\"compact\"\n    role=\"alertdialog\"\n    aria-modal=\"true\"\n    aria-labelledby=\"dac-title\"\n  >\n    <div class=\"alert-dialog-content\">\n      <div class=\"alert-dialog-header\">\n        <h2 class=\"alert-dialog-title\" id=\"dac-title\">Compact density</h2>\n        <p class=\"alert-dialog-description\">Content padding is 1rem instead of the default 1.5rem.</p>\n      </div>\n      <div class=\"alert-dialog-footer\"\n        ><button class=\"btn\" data-variant=\"outline\" data-alert-dialog-close>Close</button></div\n      >\n    </div>\n  </dialog>\n  <button class=\"btn\" data-variant=\"outline\" data-alert-dialog-trigger=\"density-ad-comfortable\">Comfortable</button>\n  <dialog\n    id=\"density-ad-comfortable\"\n    class=\"alert-dialog\"\n    data-density=\"comfortable\"\n    role=\"alertdialog\"\n    aria-modal=\"true\"\n    aria-labelledby=\"dacm-title\"\n  >\n    <div class=\"alert-dialog-content\">\n      <div class=\"alert-dialog-header\">\n        <h2 class=\"alert-dialog-title\" id=\"dacm-title\">Comfortable density</h2>\n        <p class=\"alert-dialog-description\">Identical to the unsized default - 1.5rem content padding.</p>\n      </div>\n      <div class=\"alert-dialog-footer\"\n        ><button class=\"btn\" data-variant=\"outline\" data-alert-dialog-close>Close</button></div\n      >\n    </div>\n  </dialog>\n  <button class=\"btn\" data-variant=\"outline\" data-alert-dialog-trigger=\"density-ad-spacious\">Spacious</button>\n  <dialog\n    id=\"density-ad-spacious\"\n    class=\"alert-dialog\"\n    data-density=\"spacious\"\n    role=\"alertdialog\"\n    aria-modal=\"true\"\n    aria-labelledby=\"das-title\"\n  >\n    <div class=\"alert-dialog-content\">\n      <div class=\"alert-dialog-header\">\n        <h2 class=\"alert-dialog-title\" id=\"das-title\">Spacious density</h2>\n        <p class=\"alert-dialog-description\">Content padding grows to 2rem.</p>\n      </div>\n      <div class=\"alert-dialog-footer\"\n        ><button class=\"btn\" data-variant=\"outline\" data-alert-dialog-close>Close</button></div\n      >\n    </div>\n  </dialog>\n</div>\n","individual":false}]
