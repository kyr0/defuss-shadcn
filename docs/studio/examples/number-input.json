[{"label":"Number Input","html":"<div class=\"number-input\">\n  <button data-action=\"decrement\" aria-label=\"Decrease\">−</button>\n  <input type=\"number\" id=\"d-qty\" value=\"1\" min=\"0\" max=\"99\" step=\"1\" />\n  <button data-action=\"increment\" aria-label=\"Increase\">+</button>\n</div>\n","individual":true},{"label":"Number Input (xs)","html":"<div class=\"number-input\" data-size=\"xs\"\n  ><button data-action=\"decrement\" aria-label=\"Decrease\">−</button\n  ><input type=\"number\" value=\"1\" min=\"0\" max=\"99\" step=\"1\" aria-label=\"Quantity xs\" /><button\n    data-action=\"increment\"\n    aria-label=\"Increase\"\n    >+</button\n  ></div\n>\n","individual":true},{"label":"Number Input (sm)","html":"<div class=\"number-input\" data-size=\"sm\"\n  ><button data-action=\"decrement\" aria-label=\"Decrease\">−</button\n  ><input type=\"number\" value=\"1\" min=\"0\" max=\"99\" step=\"1\" aria-label=\"Quantity sm\" /><button\n    data-action=\"increment\"\n    aria-label=\"Increase\"\n    >+</button\n  ></div\n>\n","individual":true},{"label":"Number Input (md)","html":"<div class=\"number-input\" data-size=\"md\"\n  ><button data-action=\"decrement\" aria-label=\"Decrease\">−</button\n  ><input type=\"number\" value=\"1\" min=\"0\" max=\"99\" step=\"1\" aria-label=\"Quantity md\" /><button\n    data-action=\"increment\"\n    aria-label=\"Increase\"\n    >+</button\n  ></div\n>\n","individual":true},{"label":"Number Input (lg)","html":"<div class=\"number-input\" data-size=\"lg\"\n  ><button data-action=\"decrement\" aria-label=\"Decrease\">−</button\n  ><input type=\"number\" value=\"1\" min=\"0\" max=\"99\" step=\"1\" aria-label=\"Quantity lg\" /><button\n    data-action=\"increment\"\n    aria-label=\"Increase\"\n    >+</button\n  ></div\n>\n","individual":true},{"label":"Number Input (xl)","html":"<div class=\"number-input\" data-size=\"xl\"\n  ><button data-action=\"decrement\" aria-label=\"Decrease\">−</button\n  ><input type=\"number\" value=\"1\" min=\"0\" max=\"99\" step=\"1\" aria-label=\"Quantity xl\" /><button\n    data-action=\"increment\"\n    aria-label=\"Increase\"\n    >+</button\n  ></div\n>\n","individual":true},{"label":"Default","html":"<div>\n  <label class=\"label\" for=\"d-qty\">Quantity</label>\n  <div class=\"number-input\">\n    <button data-action=\"decrement\" aria-label=\"Decrease\">−</button>\n    <input type=\"number\" id=\"d-qty\" value=\"1\" min=\"0\" max=\"99\" step=\"1\" />\n    <button data-action=\"increment\" aria-label=\"Increase\">+</button>\n  </div>\n</div>\n","individual":false},{"label":"Unit and fixed decimals","html":"<div>\n  <label class=\"label\" for=\"d-temp\">Temperature</label>\n  <div class=\"number-input\" data-decimals=\"1\">\n    <button data-action=\"decrement\" aria-label=\"Decrease\">−</button>\n    <input type=\"number\" id=\"d-temp\" value=\"19\" min=\"-40\" max=\"60\" step=\"0.5\" />\n    <label class=\"number-input-unit\" for=\"d-temp\">°C</label>\n    <button data-action=\"increment\" aria-label=\"Increase\">+</button>\n  </div>\n</div>\n","individual":false},{"label":"Units","html":"<div class=\"grid grid-cols-auto gap-4\" style=\"--layout-min: 11rem\">\n  <div>\n    <label class=\"label\" for=\"u-discount\">Discount</label>\n    <div class=\"number-input\">\n      <button data-action=\"decrement\" aria-label=\"Decrease\">−</button>\n      <input type=\"number\" id=\"u-discount\" value=\"15\" min=\"0\" max=\"100\" step=\"5\" />\n      <label class=\"number-input-unit\" for=\"u-discount\">%</label>\n      <button data-action=\"increment\" aria-label=\"Increase\">+</button>\n    </div>\n  </div>\n  <div>\n    <label class=\"label\" for=\"u-weight\">Weight</label>\n    <div class=\"number-input\" data-decimals=\"1\">\n      <button data-action=\"decrement\" aria-label=\"Decrease\">−</button>\n      <input type=\"number\" id=\"u-weight\" value=\"72.5\" min=\"0\" max=\"300\" step=\"0.5\" />\n      <label class=\"number-input-unit\" for=\"u-weight\">kg</label>\n      <button data-action=\"increment\" aria-label=\"Increase\">+</button>\n    </div>\n  </div>\n  <div>\n    <label class=\"label\" for=\"u-hours\">Duration</label>\n    <div class=\"number-input\" data-decimals=\"2\">\n      <button data-action=\"decrement\" aria-label=\"Decrease\">−</button>\n      <input type=\"number\" id=\"u-hours\" value=\"1.5\" min=\"0\" max=\"24\" step=\"0.25\" />\n      <label class=\"number-input-unit\" for=\"u-hours\">h</label>\n      <button data-action=\"increment\" aria-label=\"Increase\">+</button>\n    </div>\n  </div>\n  <div>\n    <label class=\"label\" for=\"u-budget\">Budget</label>\n    <div class=\"number-input\" data-decimals=\"2\">\n      <button data-action=\"decrement\" aria-label=\"Decrease\">−</button>\n      <label class=\"number-input-unit\" for=\"u-budget\">€</label>\n      <input type=\"number\" id=\"u-budget\" value=\"250\" min=\"0\" step=\"10\" />\n      <button data-action=\"increment\" aria-label=\"Increase\">+</button>\n    </div>\n  </div>\n  <div>\n    <label class=\"label\" for=\"u-coffee\">Coffee</label>\n    <div class=\"number-input\">\n      <button data-action=\"decrement\" aria-label=\"Decrease\">−</button>\n      <input type=\"number\" id=\"u-coffee\" value=\"2\" min=\"0\" max=\"12\" step=\"1\" />\n      <label class=\"number-input-unit\" for=\"u-coffee\">☕ cups</label>\n      <button data-action=\"increment\" aria-label=\"Increase\">+</button>\n    </div>\n  </div>\n</div>\n","individual":false},{"label":"Currency","html":"<div class=\"grid grid-cols-auto gap-4\" style=\"--layout-min: 13rem\">\n  <div>\n    <label class=\"label\" for=\"c-price\">Price (de-DE, EUR)</label>\n    <div class=\"number-input w-full\" data-currency=\"EUR\" data-locale=\"de-DE\">\n      <input type=\"text\" id=\"c-price\" value=\"1234.5\" />\n      <input type=\"hidden\" name=\"price\" data-number-output />\n    </div>\n  </div>\n  <div>\n    <label class=\"label\" for=\"c-donation\">Donation (en-US, USD)</label>\n    <div class=\"number-input w-full\" data-currency=\"USD\" data-locale=\"en-US\">\n      <button data-action=\"decrement\" aria-label=\"Decrease by 5\">−</button>\n      <input type=\"text\" id=\"c-donation\" value=\"25\" data-step=\"5\" data-min=\"5\" />\n      <button data-action=\"increment\" aria-label=\"Increase by 5\">+</button>\n    </div>\n  </div>\n  <div>\n    <label class=\"label\" for=\"c-budget\">Budget (ja-JP, JPY)</label>\n    <div class=\"number-input w-full\" data-currency=\"JPY\" data-locale=\"ja-JP\">\n      <input type=\"text\" id=\"c-budget\" value=\"150000\" />\n    </div>\n  </div>\n</div>\n<p class=\"text-sm text-muted-foreground\" style=\"margin: 0.75rem 0 0\"\n  >Price submits <code>price=<output id=\"c-price-out\">1234.5</output></code></p\n>\n","individual":false},{"label":"Currency per locale","html":"<div style=\"display: flex; gap: 1rem; align-items: end; flex-wrap: wrap\">\n  <div>\n    <label class=\"label\" for=\"c-any\">Amount</label>\n    <div class=\"number-input\" data-currency=\"EUR\" data-locale=\"de-DE\" id=\"c-any-field\">\n      <input type=\"text\" id=\"c-any\" value=\"1234567.8\" />\n    </div>\n  </div>\n  <div>\n    <label class=\"label\" for=\"c-any-locale\">Locale · currency</label>\n    <select class=\"select\" id=\"c-any-locale\">\n      <option value=\"de-DE|EUR\">de-DE · EUR</option>\n      <option value=\"en-US|USD\">en-US · USD</option>\n      <option value=\"en-GB|GBP\">en-GB · GBP</option>\n      <option value=\"fr-FR|EUR\">fr-FR · EUR</option>\n      <option value=\"de-CH|CHF\">de-CH · CHF</option>\n      <option value=\"en-IN|INR\">en-IN · INR</option>\n      <option value=\"ja-JP|JPY\">ja-JP · JPY</option>\n    </select>\n  </div>\n</div>\n","individual":false},{"label":"Sizes","html":"<div class=\"flex items-center gap-4 mb-3\">\n  <span class=\"demo-label demo-label-w5\">Extra small</span>\n  <div class=\"number-input\" data-size=\"xs\"\n    ><button data-action=\"decrement\" aria-label=\"Decrease\">−</button\n    ><input type=\"number\" value=\"1\" min=\"0\" max=\"99\" step=\"1\" aria-label=\"Quantity xs\" /><button\n      data-action=\"increment\"\n      aria-label=\"Increase\"\n      >+</button\n    ></div\n  >\n</div>\n<div class=\"flex items-center gap-4 mb-3\">\n  <span class=\"demo-label demo-label-w5\">Small</span>\n  <div class=\"number-input\" data-size=\"sm\"\n    ><button data-action=\"decrement\" aria-label=\"Decrease\">−</button\n    ><input type=\"number\" value=\"1\" min=\"0\" max=\"99\" step=\"1\" aria-label=\"Quantity sm\" /><button\n      data-action=\"increment\"\n      aria-label=\"Increase\"\n      >+</button\n    ></div\n  >\n</div>\n<div class=\"flex items-center gap-4 mb-3\">\n  <span class=\"demo-label demo-label-w5\">Medium</span>\n  <div class=\"number-input\" data-size=\"md\"\n    ><button data-action=\"decrement\" aria-label=\"Decrease\">−</button\n    ><input type=\"number\" value=\"1\" min=\"0\" max=\"99\" step=\"1\" aria-label=\"Quantity md\" /><button\n      data-action=\"increment\"\n      aria-label=\"Increase\"\n      >+</button\n    ></div\n  >\n</div>\n<div class=\"flex items-center gap-4 mb-3\">\n  <span class=\"demo-label demo-label-w5\">Large</span>\n  <div class=\"number-input\" data-size=\"lg\"\n    ><button data-action=\"decrement\" aria-label=\"Decrease\">−</button\n    ><input type=\"number\" value=\"1\" min=\"0\" max=\"99\" step=\"1\" aria-label=\"Quantity lg\" /><button\n      data-action=\"increment\"\n      aria-label=\"Increase\"\n      >+</button\n    ></div\n  >\n</div>\n<div class=\"flex items-center gap-4 mb-3\">\n  <span class=\"demo-label demo-label-w5\">Extra large</span>\n  <div class=\"number-input\" data-size=\"xl\"\n    ><button data-action=\"decrement\" aria-label=\"Decrease\">−</button\n    ><input type=\"number\" value=\"1\" min=\"0\" max=\"99\" step=\"1\" aria-label=\"Quantity xl\" /><button\n      data-action=\"increment\"\n      aria-label=\"Increase\"\n      >+</button\n    ></div\n  >\n</div>