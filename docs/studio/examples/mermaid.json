[{"label":"Flowchart","html":"<figure class=\"mermaid-diagram\" aria-label=\"Release flow\">\n  <pre class=\"mermaid\">\nflowchart LR\n  A[Edit src/] --> B(make build)\n  B --> C{verify green?}\n  C -- yes --> D[Commit and release]\n  C -- no --> A\n  </pre>\n</figure>\n","individual":true},{"label":"Sequence diagram","html":"<figure class=\"mermaid-diagram\" aria-label=\"Loading the renderer\">\n  <pre class=\"mermaid\">\nsequenceDiagram\n  participant Page\n  participant mermaid.js\n  participant jsDelivr\n  Page->>mermaid.js: first .mermaid-diagram appears\n  activate mermaid.js\n  mermaid.js->>jsDelivr: import mermaid@12.0.0 (once)\n  jsDelivr-->>mermaid.js: official ESM build\n  Note right of mermaid.js: themeVariables from the tokens\n  mermaid.js-->>Page: token-themed SVG\n  deactivate mermaid.js\n  </pre>\n</figure>\n","individual":true},{"label":"A malformed diagram","html":"<figure class=\"mermaid-diagram\" aria-label=\"Broken diagram\">\n  <pre class=\"mermaid\">\nflowchart LR\n  A --> B -->\n  </pre>\n</figure>\n","individual":true},{"label":"Accessible diagrams","html":"<figure class=\"mermaid-diagram\" aria-label=\"Checkout flow\">\n  <pre class=\"mermaid\">\nflowchart LR\n  accTitle: Checkout flow\n  accDescr: A cart leads to checkout; paid orders ship, failed payments return to checkout.\n  Cart --> Checkout --> Pay{Payment}\n  Pay -- paid --> Ship\n  Pay -- failed --> Checkout\n  </pre>\n  <figcaption>From cart to shipment</figcaption>\n</figure>\n","individual":true},{"label":"Class and state diagrams","html":"<div class=\"grid grid-cols-auto gap-6\" style=\"--layout-min: 18rem\">\n  <figure class=\"mermaid-diagram\" aria-label=\"Component classes\">\n    <pre class=\"mermaid\">\nclassDiagram\n  class Component {\n    +name\n    +type\n    +setState(name, config)\n  }\n  class Skill {\n    +frontmatter\n    +states\n  }\n  Component \"1\" --> \"1\" Skill : documented by\n    </pre>\n  </figure>\n  <figure class=\"mermaid-diagram\" aria-label=\"Diagram states\">\n    <pre class=\"mermaid\">\nstateDiagram-v2\n  [*] --> Source\n  Source --> SVG : renderer loaded\n  Source --> Failed : invalid syntax\n  Failed --> SVG : source fixed\n  SVG --> SVG : theme changed\n    </pre>\n  </figure>\n</div>\n","individual":false},{"label":"Live from a questionnaire","html":"<div class=\"flex flex-wrap gap-6 items-start\">\n  <form class=\"questionnaire\" id=\"q-onboard\" aria-label=\"Onboarding\" data-persist=\"none\" style=\"flex: 1 1 18rem\">\n    <div class=\"questionnaire-progress\"></div>\n    <fieldset class=\"questionnaire-step\" data-step=\"role\">\n      <legend class=\"questionnaire-title\">Your role?</legend>\n      <div class=\"questionnaire-choices\">\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"role\" value=\"dev\" required data-goto=\"repo\" /><span\n            class=\"questionnaire-choice-label\"\n            >Engineer</span\n          ></label\n        >\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"role\" value=\"pm\" data-goto=\"size\" /><span class=\"questionnaire-choice-label\"\n            >Manager</span\n          ></label\n        >\n      </div>\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"repo\" data-next=\"size\">\n      <legend class=\"questionnaire-title\">Connect a repository?</legend>\n      <div class=\"questionnaire-choices\">\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"repo\" value=\"github\" required /><span class=\"questionnaire-choice-label\"\n            >GitHub</span\n          ></label\n        >\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"repo\" value=\"later\" /><span class=\"questionnaire-choice-label\">Later</span></label\n        >\n      </div>\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"size\">\n      <legend class=\"questionnaire-title\">Team size?</legend>\n      <input class=\"input\" name=\"size\" type=\"number\" min=\"1\" required aria-label=\"Team size\" style=\"max-width: 8rem\" />\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"sales\" data-next=\"done\">\n      <legend class=\"questionnaire-title\">Talk to sales?</legend>\n      <div class=\"questionnaire-choices\">\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"sales\" value=\"yes\" required /><span class=\"questionnaire-choice-label\"\n            >Yes please</span\n          ></label\n        >\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"sales\" value=\"no\" /><span class=\"questionnaire-choice-label\"\n            >No thanks</span\n          ></label\n        >\n      </div>\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"done\" data-end>\n      <legend class=\"questionnaire-title\">You're set</legend>\n      <div class=\"questionnaire-summary\"></div>\n    </fieldset>\n    <div class=\"questionnaire-actions\">\n      <button class=\"btn\" data-variant=\"ghost\" type=\"button\" data-questionnaire=\"back\">Back</button>\n      <button class=\"btn\" type=\"submit\" data-questionnaire=\"next\">Continue</button>\n      <button class=\"btn\" type=\"submit\" data-questionnaire=\"submit\">Finish</button>\n    </div>\n    <div class=\"questionnaire-complete\"><p>Welcome!</p></div>\n    \n  </form>\n  <figure\n    class=\"mermaid-diagram\"\n    id=\"q-onboard-graph\"\n    aria-label=\"The onboarding flow\"\n    style=\"flex: 1 1 18rem; margin: 0\"\n  >\n    <pre class=\"mermaid\">\nflowchart TD\n  start[\"…\"]</pre>\n  </figure>\n</div>\n","individual":false},{"label":"Added at runtime","html":"<button class=\"btn\" data-variant=\"outline\" id=\"mm-add\">Add a diagram</button>\n<div id=\"mm-host\" class=\"stack gap-4 mt-4\"></div>\n","individual":false},{"label":"Light and dark","html":"<div class=\"grid grid-cols-auto gap-4\" style=\"--layout-min: 16rem\">\n  <figure class=\"mermaid-diagram\" aria-label=\"Light\">\n    <pre class=\"mermaid\">\nflowchart TD\n  Tokens[design tokens] --> Hex[hex colors]\n  Hex --> SVG[Mermaid SVG]\n    </pre>\n  </figure>\n  <div class=\"dark p-4 rounded-lg\" style=\"background: var(--background); color: var(--foreground)\">\n    <figure class=\"mermaid-diagram\" aria-label=\"Dark\">\n      <pre class=\"mermaid\">\nflowchart TD\n  Tokens[design tokens] --> Hex[hex colors]\n  Hex --> SVG[Mermaid SVG]\n      </pre>\n    </figure>\n  </div>\n</div>\n","individual":false},{"label":"Mermaid's own markup","html":"<pre class=\"mermaid\">\npie title Where a build spends its time\n  \"Compile + bundle\" : 18\n  \"Screenshots\" : 42\n  \"Verify\" : 11\n  \"Tests\" : 29\n</pre>\n","individual":false}]
