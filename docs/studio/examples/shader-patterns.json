[{"label":"A breathing grid","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"dot-orbit-demo\"\n    data-effect=\"dot-orbit\"\n    data-interactive\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"dot-orbit-demo\"></div>\n</div>\n","individual":false},{"label":"A contour map","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"topography-demo\"\n    data-effect=\"topography\"\n    data-interactive\n    data-colors=\"#a3b18a #588157 #3a5a40\"\n    data-background=\"#f4f1e8\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"topography-demo\"></div>\n</div>\n","individual":false},{"label":"A line of light","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"trails-demo\"\n    data-effect=\"trails\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"trails-demo\"></div>\n</div>\n","individual":false},{"label":"Cells of colored glass","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"voronoi-demo\"\n    data-effect=\"voronoi\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"voronoi-demo\"></div>\n</div>\n","individual":false},{"label":"A photo as dots","html":"<div class=\"grid grid-cols-2 gap-4\">\n  <div class=\"shader\" id=\"halftone-demo\" data-effect=\"halftone\" style=\"border-radius: var(--radius)\">\n    <img\n      src=\"images/photos/1062-800x500.webp\"\n      alt=\"A dog wrapped in a blanket\"\n      crossorigin=\"anonymous\"\n      width=\"800\"\n      height=\"500\"\n    />\n  </div>\n  <div\n    class=\"shader\"\n    data-effect=\"halftone\"\n    data-cell=\"12\"\n    data-angle=\"45\"\n    data-colors=\"#1d3557 #f1faee\"\n    aria-hidden=\"true\"\n    style=\"border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"halftone-demo\"></div>\n</div>\n","individual":false},{"label":"Mirrored wedges","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"kaleidoscope-demo\"\n    data-effect=\"kaleidoscope\"\n    data-segments=\"10\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"kaleidoscope-demo\"></div>\n</div>\n","individual":false},{"label":"Digital rain","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"matrix-demo\"\n    data-effect=\"matrix\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"matrix-demo\"></div>\n</div>\n","individual":false},{"label":"A moire","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"op-art-demo\"\n    data-effect=\"op-art\"\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"op-art-demo\"></div>\n</div>\n","individual":false},{"label":"A broken signal","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\