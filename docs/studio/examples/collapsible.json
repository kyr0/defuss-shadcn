[{"label":"Collapsible (sm)","html":"<details class=\"collapsible\" data-size=\"sm\" data-marker=\"arrow\">\n  <summary class=\"collapsible-trigger\">Small</summary>\n  <div class=\"collapsible-content\"><p class=\"m-0\">For dense panels.</p></div>\n</details>\n","individual":true},{"label":"Collapsible (lg, open)","html":"<details class=\"collapsible\" data-size=\"lg\" data-marker=\"arrow\" open>\n  <summary class=\"collapsible-trigger\">Large, semibold</summary>\n  <div class=\"collapsible-content\"><p class=\"m-0\">The content keeps its size - only the heading scales.</p></div>\n</details>\n","individual":true},{"label":"Collapsible (xl)","html":"<details class=\"collapsible\" data-size=\"xl\" data-marker=\"arrow\">\n  <summary class=\"collapsible-trigger\">Extra large, bold</summary>\n  <div class=\"collapsible-content\"><p class=\"m-0\">For page-level sections.</p></div>\n</details>\n","individual":true},{"label":"Collapsible (ghost)","html":"<details class=\"collapsible\" data-variant=\"ghost\" data-marker=\"arrow\">\n  <summary class=\"collapsible-trigger\">Ghost</summary>\n  <div class=\"collapsible-content\"><p class=\"m-0\">No surface, no border - the hover tint still shows.</p></div>\n</details>\n","individual":true},{"label":"Collapsible (muted)","html":"<details class=\"collapsible\" data-variant=\"muted\" data-marker=\"arrow\">\n  <summary class=\"collapsible-trigger\">Muted</summary>\n  <div class=\"collapsible-content\"><p class=\"m-0\">A soft surface, no border.</p></div>\n</details>\n","individual":true},{"label":"Collapsible (primary, open)","html":"<details class=\"collapsible\" data-variant=\"primary\" data-marker=\"arrow\" open>\n  <summary class=\"collapsible-trigger\">Primary</summary>\n  <div class=\"collapsible-content\"\n    ><p class=\"m-0\">The primary surface - content text is the foreground, softened.</p></div\n  >\n</details>\n","individual":true},{"label":"Collapsible (neutral)","html":"<details class=\"collapsible\" data-variant=\"neutral\" data-marker=\"arrow\">\n  <summary class=\"collapsible-trigger\">Neutral</summary>\n  <div class=\"collapsible-content\"><p class=\"m-0\">A charcoal surface, the same in both modes.</p></div>\n</details>\n","individual":true},{"label":"Collapsible (highlight)","html":"<details class=\"collapsible\" data-variant=\"highlight\" data-marker=\"plus\">\n  <summary class=\"collapsible-trigger\">Highlight when open</summary>\n  <div class=\"collapsible-content\"\n    ><p class=\"m-0\">Plain while closed, primary once open - the color change animates.</p></div\n  >\n</details>\n","individual":true},{"label":"Basic","html":"<details class=\"collapsible\">\n  <summary class=\"collapsible-trigger\">\n    <span>Can I use this?</span>\n    <svg\n      class=\"collapsible-chevron\"\n      aria-hidden=\"true\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n    >\n      <path d=\"m6 9 6 6 6-6\"></path>\n    </svg>\n  </summary>\n  <div class=\"collapsible-content\">\n    <p>Yes, it's free to use.</p>\n  </div>\n</details>\n","individual":true},{"label":"Open by Default","html":"<details class=\"collapsible\" open>\n  <summary class=\"collapsible-trigger\">\n    <span>What is included?</span>\n    <svg\n      class=\"collapsible-chevron\"\n      aria-hidden=\"true\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n    >\n      <path d=\"m6 9 6 6 6-6\"></path>\n    </svg>\n  </summary>\n  <div class=\"collapsible-content\">\n    <p>Every component, the theme presets and the documentation - it starts open because of the open attribute.</p>\n  </div>\n</details>\n","individual":true},{"label":"Multiple Sections","html":"<div style=\"width: 100%; max-width: 24rem; display: flex; flex-direction: column; gap: 0.5rem\">\n  <details class=\"collapsible\">\n    <summary class=\"collapsible-trigger\">\n      <span>Appearance</span>\n      <svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        class=\"collapsible-chevron\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n      >\n        <path d=\"m6 9 6 6 6-6\" />\n      </svg>\n    </summary>\n    <div class=\"collapsible-content\">\n      <p class=\"m-0\">Customize the look and feel of your workspace.</p>\n    </div>\n  </details>\n  <details class=\"collapsible\">\n    <summary class=\"collapsible-trigger\">\n      <span>Notifications</span>\n      <svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        class=\"collapsible-chevron\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n      >\n        <path d=\"m6 9 6 6 6-6\" />\n      </svg>\n    </summary>\n    <div class=\"collapsible-content\">\n      <p class=\"m-0\">Manage your notification preferences.</p>\n    </div>\n  </details>\n  <details class=\"collapsible\">\n    <summary class=\"collapsible-trigger\">\n      <span>Privacy</span>\n      <svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        class=\"collapsible-chevron\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n      >\n        <path d=\"m6 9 6 6 6-6\" />\n      </svg>\n    </summary>\n    <div class=\"collapsible-content\">\n      <p class=\"m-0\">Control your privacy and data sharing settings.</p>\n    </div>\n  </details>\n</div>\n","individual":false},{"label":"Colors","html":"<div class=\"stack gap-2\" style=\"width: 100%; max-width: 26rem\">\n  <details class=\"collapsible\" data-variant=\"muted\" data-marker=\"arrow\">\n    <summary class=\"collapsible-trigger\">Muted</summary>\n    <div class=\"collapsible-content\"><p class=\"m-0\">A soft surface, no border.</p></div>\n  </details>\n  <details class=\"collapsible\" data-variant=\"primary\" data-marker=\"arrow\" open>\n    <summary class=\"collapsible-trigger\">Primary</summary>\n    <div class=\"collapsible-content\"\n      ><p class=\"m-0\">The primary surface - content text is the foreground, softened.</p></div\n    >\n  </details>\n  <details class=\"collapsible\" data-variant=\"neutral\" data-marker=\"arrow\">\n    <summary class=\"collapsible-trigger\">Neutral</summary>\n    <div class=\"collapsible-content\"><p class=\"m-0\">A charcoal surface, the same in both modes.</p></div>\n  </details>\n  <details class=\"collapsible\" data-variant=\"ghost\" data-marker=\"arrow\">\n    <summary class=\"collapsible-trigger\">Ghost</summary>\n    <div class=\"collapsible-content\"><p class=\"m-0\">No surface, no border - the hover tint still shows.</p></div>\n  </details>\n  <details class=\"collapsible\" data-variant=\"highlight\" data-marker=\"plus\">\n    <summary class=\"collapsible-trigger\">Highlight when open</summary>\n    <div class=\"collapsible-content\"\n      ><p class=\"m-0\">Plain while closed, primary once open - the color change animates.</p></div\n    >\n  </details>\n</div>\n","individual":false},{"label":"Custom colors","html":"<div class=\"stack gap-2\" style=\"width: 100%; max-width: 26rem\">\n  <details\n    class=\"collapsible\"\n    data-marker=\"arrow\"\n    style=\"background: oklch(0.93 0.06 190); color: oklch(0.32 0.08 200); border-color: oklch(0.8 0.08 190)\"\n    open\n  >\n    <summary class=\"collapsible-trigger\">Teal</summary>\n    <div class=\"collapsible-content\"><p class=\"m-0\">Every shade of this panel comes from two declarations.</p></div>\n  </details>\n  <details\n    class=\"collapsible\"\n    data-marker=\"plus\"\n    style=\"background: linear-gradient(120deg, oklch(0.55 0.22 300), oklch(0.6 0.2 350)); color: white; border: 0\"\n  >\n    <summary class=\"collapsible-trigger\">Gradient</summary>\n    <div class=\"collapsible-content\"><p class=\"m-0\">A gradient surface with white text.</p></div>\n  </details>\n</div>\n","individual":false},{"label":"Bold headings","html":"<div class=\"stack gap-2\" style=\"width: 100%; max-width: 26rem\">\n  <details class=\"collapsible\" data-size=\"lg\" data-marker=\"arrow\" open>\n    <summary class=\"collapsible-trigger\">Large, semibold</summary>\n    <div class=\"collapsible-content\"><p class=\"m-0\">The content keeps its size - only the heading scales.</p></div>\n  </details>\n  <details class=\"collapsible\" data-size=\"xl\" data-marker=\"arrow\">\n    <summary class=\"collapsible-trigger\">Extra large, bold</summary>\n    <div class=\"collapsible-content\"><p class=\"m-0\">For page-level sections.</p></div>\n  </details>\n  <details class=\"collapsible\" data-size=\"sm\" data-marker=\"arrow\">\n    <summary class=\"collapsible-trigger\">Small</summary>\n    <div class=\"collapsible-content\"><p class=\"m-0\">For dense panels.</p></div>\n  </details>\n</div>\n","individual":false},{"label":"Icons and emojis","html":"<div class=\"stack gap-2\" style=\"width: 100%; max-width: 26rem\">\n  <details class=\"collapsible\" data-marker=\"arrow\">\n    <summary class=\"collapsible-trigger\"\n      ><span class=\"collapsible-icon\" aria-hidden=\"true\"><i data-lucide=\"shield-check\"></i></span>Security</summary\n    >\n    <div class=\"collapsible-content\"><p class=\"m-0\">Two-factor authentication and active sessions.</p></div>\n  </details>\n  <details class=\"collapsible\" data-marker=\"arrow\">\n    <summary class=\"collapsible-trigger\"\n      ><span class=\"collapsible-icon\" aria-hidden=\"true\"><i data-lucide=\"credit-card\"></i></span>Billing</summary\n    >\n    <div class=\"collapsible-content\"><p class=\"m-0\">Plan, invoices and payment methods.</p></div>\n  </details>\n  <details class=\"collapsible\" data-marker=\"arrow\">\n    <summary class=\"collapsible-trigger\"><span class=\"collapsible-icon\" aria-hidden=\"true\">🎨</span>Appearance</summary>\n    <div class=\"collapsible-content\"><p class=\"m-0\">Theme, density and fonts.</p></div>\n  </details>\n  <details class=\"collapsible\" data-marker=\"arrow\">\n    <summary class=\"collapsible-trigger\"\n      ><span class=\"collapsible-icon\" aria-hidden=\"true\">🔔</span>Notifications</summary\n    >\n    <div class=\"collapsible-content\"><p class=\"m-0\">Email, push and in-app.</p></div>\n  </details>\n</div>\n","individual":false},{"label":"Arrow and plus markers","html":"<div class=\"grid gap-2\" style=\"width: 100%; max-width: 34rem; grid-template-columns: 1fr 1fr\">\n  <details class=\"collapsible\" data-marker=\"arrow\" open>\n    <summary class=\"collapsible-trigger\">Arrow</summary>\n    <div class=\"collapsible-content\"><p class=\"m-0\">Open: the arrow points up.</p></div>\n  </details>\n  <details class=\"collapsible\" data-marker=\"plus\" open>\n    <summary class=\"collapsible-trigger\">Plus</summary>\n    <div class=\"collapsible-content\"><p class=\"m-0\">Open: the plus is a minus.</p></div>\n  </details>\n  <details class=\"collapsible\" data-marker=\"arrow\" data-marker-position=\"start\">\n    <summary class=\"collapsible-trigger\">Arrow at the start</summary>\n    <div class=\"collapsible-content\"><p class=\"m-0\">Like a file tree.</p></div>\n  </details>\n  <details class=\"collapsible\" data-marker=\"plus\" data-marker-position=\"start\">\n    <summary class=\"collapsible-trigger\">Plus at the start</summary>\n    <div class=\"collapsible-content\"><p class=\"m-0\">Like a FAQ.</p></div>\n  </details>\n</div>\n","individual":false},{"label":"Custom open/close signs","html":"<div class=\"stack gap-2\" style=\"width: 100%; max-width: 26rem\">\n  <details class=\"collapsible\">\n    <summary class=\"collapsible-trigger\"\n      >Quarter turn <i data-lucide=\"chevron-right\" class=\"collapsible-chevron\" data-turn=\"quarter\"></i\n    ></summary>\n    <div class=\"collapsible-content\"><p class=\"m-0\">A chevron-right that turns down when open.</p></div>\n  </details>\n  <details class=\"collapsible\">\n    <summary class=\"collapsible-trigger\"\n      ><span class=\"collapsible-icon\" aria-hidden=\"true\"\n        ><span class=\"collapsible-when-closed\">📁</span><span class=\"collapsible-when-open\">📂</span></span\n      >Projects</summary\n    >\n    <div class=\"collapsible-content\"><p class=\"m-0\">The folder opens with the panel.</p></div>\n  </details>\n  <details class=\"collapsible\">\n    <summary class=\"collapsible-trigger\"\n      >Release notes <span class=\"collapsible-when-closed text-sm\">Show</span\n      ><span class=\"collapsible-when-open text-sm\">Hide</span></summary\n    >\n    <div class=\"collapsible-content\"><p class=\"m-0\">Words instead of an icon.</p></div>\n  </details>\n</div>\n","individual":false},{"label":"Right to left","html":"<div class=\"stack gap-2\" dir=\"rtl\" lang=\"ar\" style=\"width: 100%; max-width: 26rem\">\n  <details class=\"collapsible\" data-marker=\"arrow\" open>\n    <summary class=\"collapsible-trigger\"\n      ><span class=\"collapsible-icon\" aria-hidden=\"true\"><i data-lucide=\"shield-check\"></i></span>الأمان</summary\n    >\n    <div class=\"collapsible-content\"><p class=\"m-0\">المصادقة الثنائية والجلسات النشطة.</p></div>\n  </details>\n  <details class=\"collapsible\" data-marker=\"plus\" data-variant=\"muted\">\n    <summary class=\"collapsible-trigger\"><span class=\"collapsible-icon\" aria-hidden=\"true\">🎨</span>المظهر</summary>\n    <div class=\"collapsible-content\"><p class=\"m-0\">السمة والكثافة والخطوط.</p></div>\n  </details>\n  <details class=\"collapsible\">\n    <summary class=\"collapsible-trigger\"\n      >ملاحظات الإصدار <i data-lucide=\"chevron-right\" class=\"collapsible-chevron\" data-turn=\"quarter\"></i\n    ></summary>\n    <div class=\"collapsible-content\"><p class=\"m-0\">سهم يدور ربع دورة.</p></div>\n  </details>\n</div>\n","individual":false},{"label":"Density","html":"<div style=\"width: 100%; max-width: 24rem\">\n  <p class=\"demo-label\">Compact</p>\n  <details class=\"collapsible\" open data-density=\"compact\">\n    <summary class=\"collapsible-trigger\"\n      ><span>Trigger padding shrinks</span\n      ><svg\n        class=\"collapsible-chevron\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        aria-hidden=\"true\"\n      >\n        <path d=\"m6 9 6 6 6-6\" /></svg\n    ></summary>\n    <div class=\"collapsible-content\"\n      ><p class=\"m-0\">The trigger and content paddings scale - the copy stays exactly the same.</p></div\n    >\n  </details>\n  <p class=\"demo-label\" style=\"margin-top: 1rem\">Comfortable</p>\n  <details class=\"collapsible\" open data-density=\"comfortable\">\n    <summary class=\"collapsible-trigger\"\n      ><span>Identical to the default</span\n      ><svg\n        class=\"collapsible-chevron\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        aria-hidden=\"true\"\n      >\n        <path d=\"m6 9 6 6 6-6\" /></svg\n    ></summary>\n    <div class=\"collapsible-content\"\n      ><p class=\"m-0\">The trigger and content paddings scale - the copy stays exactly the same.</p></div\n    >\n  </details>\n  <p class=\"demo-label\" style=\"margin-top: 1rem\">Spacious</p>\n  <details class=\"collapsible\" open data-density=\"spacious\">\n    <summary class=\"collapsible-trigger\"\n      ><span>Trigger padding grows</span\n      ><svg\n        class=\"collapsible-chevron\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        aria-hidden=\"true\"\n      >\n        <path d=\"m6 9 6 6 6-6\" /></svg\n    ></summary>\n    <div class=\"collapsible-content\"\n      ><p class=\"m-0\">The trigger and content paddings scale - the copy stays exactly the same.</p></div\n    >\n  </details>\n</div>\n","individual":false}]
