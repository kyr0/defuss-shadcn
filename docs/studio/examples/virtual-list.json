[{"label":"Ten million rows","html":"<div\n  class=\"virtual-list\"\n  id=\"vl-main\"\n  data-empty-text=\"No results found\"\n  aria-label=\"Ten million rows\"\n  style=\"height: 20rem; max-width: 28rem\"\n></div>\n","individual":true},{"label":"Grid","html":"<div\n  class=\"virtual-list\"\n  id=\"vl-grid\"\n  data-columns=\"3\"\n  aria-label=\"Photo grid\"\n  style=\"--virtual-list-row-height: 96px; height: 18rem; max-width: 28rem\"\n></div>\n","individual":true},{"label":"Empty","html":"<div\n  class=\"virtual-list\"\n  data-empty-text=\"No results found\"\n  aria-label=\"Empty list\"\n  style=\"height: 10rem; max-width: 28rem\"\n></div>\n","individual":true},{"label":"Records: filter and sort locally","html":"<div class=\"flex flex-col gap-3\" style=\"max-width: 28rem\">\n  <div class=\"flex flex-wrap gap-2\">\n    <input\n      class=\"input\"\n      style=\"flex: 1; min-width: 9rem\"\n      placeholder=\"Filter by name…\"\n      aria-label=\"Filter by name\"\n      data-virtual-list-filter=\"vl-records\"\n      data-field=\"name\"\n    />\n    <input\n      class=\"input\"\n      style=\"width: 7rem\"\n      placeholder=\"Age > 40\"\n      aria-label=\"Filter by age\"\n      data-virtual-list-filter=\"vl-records\"\n      data-field=\"age\"\n      data-kind=\"number\"\n      inputmode=\"decimal\"\n    />\n    <select class=\"select\" aria-label=\"Sort\" data-virtual-list-sort=\"vl-records\">\n      <option value=\"\">Source order</option>\n      <option value=\"name:asc\">Name A–Z</option>\n      <option value=\"age:desc\">Oldest first</option>\n      <option value=\"city:asc\">City</option>\n    </select>\n  </div>\n  <div\n    class=\"virtual-list\"\n    id=\"vl-records\"\n    data-empty-text=\"Nobody matches\"\n    aria-label=\"People\"\n    style=\"height: 16rem\"\n  ></div>\n  <p class=\"text-sm text-muted-foreground m-0\" id=\"vl-records-count\" aria-live=\"polite\"></p>\n</div>\n","individual":false},{"label":"Row height","html":"<div class=\"flex flex-wrap gap-4\">\n  <div\n    class=\"virtual-list\"\n    id=\"vl-sm\"\n    aria-label=\"Compact rows\"\n    style=\"--virtual-list-row-height: 28px; height: 12rem; width: 13rem\"\n  ></div>\n  <div\n    class=\"virtual-list\"\n    id=\"vl-lg\"\n    aria-label=\"Roomy rows\"\n    style=\"--virtual-list-row-height: 64px; height: 12rem; width: 13rem\"\n  ></div>\n</div>\n","individual":false},{"label":"Jump to a row","html":"<div class=\"flex flex-col gap-3\" style=\"max-width: 28rem\">\n  <div class=\"flex flex-wrap gap-2\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" data-jump=\"0\">First</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" data-jump=\"5000000\">5,000,000</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" data-jump=\"9999999\">Last</button>\n  </div>\n  <div class=\"virtual-list\" id=\"vl-jump\" aria-label=\"Jump demo\" style=\"height: 12rem\"></div>\n</div>\n","individual":false},{"label":"Rich rows and one listener","html":"<div class=\"flex flex-col gap-2\" style=\"max-width: 28rem\">\n  <div\n    class=\"virtual-list\"\n    id=\"vl-people\"\n    aria-label=\"Contacts\"\n    style=\"--virtual-list-row-height: 52px; height: 16rem\"\n  ></div>\n  <p class=\"text-sm text-muted-foreground m-0\" id=\"vl-picked\" aria-live=\"polite\">Click a contact.</p>\n</div>\n","individual":false},{"label":"Loading","html":"<div class=\"flex flex-col gap-3\" style=\"max-width: 28rem\">\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"vl-reload\" style=\"align-self: flex-start\"\n    >Reload</button\n  >\n  <div class=\"virtual-list\" id=\"vl-loading\" aria-label=\"Loading list\" style=\"height: 12rem\"></div>\n</div>\n","individual":false}]
