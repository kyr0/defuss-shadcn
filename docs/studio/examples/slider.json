v class=\"stack gap-4 w-full max-w-80\">\n  <input class=\"slider\" type=\"range\" value=\"70\" data-tone=\"success\" aria-label=\"Success\" />\n  <input class=\"slider\" type=\"range\" value=\"55\" data-tone=\"warning\" aria-label=\"Warning\" />\n  <input class=\"slider\" type=\"range\" value=\"40\" data-tone=\"info\" aria-label=\"Info\" />\n  <input class=\"slider\" type=\"range\" value=\"25\" data-tone=\"destructive\" aria-label=\"Destructive\" />\n  <input\n    class=\"slider\"\n    type=\"range\"\n    value=\"85\"\n    style=\"--slider-color: oklch(0.6 0.22 300)\"\n    aria-label=\"Custom violet\"\n  />\n</div>\n","individual":false},{"label":"Icons and emojis","html":"<div class=\"stack gap-5 w-full max-w-96\">\n  <div class=\"slider-field\">\n    <span class=\"slider-icon\" aria-hidden=\"true\"><i data-lucide=\"volume\"></i></span>\n    <input class=\"slider\" type=\"range\" id=\"sl-vol\" value=\"60\" aria-label=\"Volume\" />\n    <span class=\"slider-icon\" aria-hidden=\"true\"><i data-lucide=\"volume-2\"></i></span>\n  </div>\n  <div class=\"slider-field\">\n    <span class=\"slider-icon\" aria-hidden=\"true\">🌙</span>\n    <input\n      class=\"slider\"\n      type=\"range\"\n      id=\"sl-bright\"\n      value=\"40\"\n      data-tone=\"warning\"\n      data-unit=\"percent\"\n      aria-label=\"Brightness\"\n    />\n    <span class=\"slider-icon\" aria-hidden=\"true\">☀️</span>\n    <output class=\"slider-value\" for=\"sl-bright\">40%</output>\n  </div>\n  <div class=\"slider-field\">\n    <span class=\"slider-icon\" aria-hidden=\"true\">🐢</span>\n    <input class=\"slider\" type=\"range\" min=\"1\" max=\"10\" value=\"7\" data-tone=\"success\" aria-label=\"Speed\" />\n    <span class=\"slider-icon\" aria-hidden=\"true\">🐇</span>\n  </div>\n</div>\n","individual":false},{"label":"Emoji thumb","html":"<div class=\"stack gap-6 w-full max-w-80\">\n  <div>\n    <label class=\"label\" for=\"sl-mood\">How was your day?</label>\n    <input\n      class=\"slider\"\n      type=\"range\"\n      id=\"sl-mood\"\n      min=\"0\"\n      max=\"100\"\n      value=\"70\"\n      data-thumb-emoji=\"😫 😕 😐 🙂 😄\"\n      data-tone=\"warning\"\n    />\n  </div>\n  <div>\n    <label class=\"label\" for=\"sl-rocket\">Launch progress</label>\n    <input\n      class=\"slider\"\n      type=\"range\"\n      id=\"sl-rocket\"\n      value=\"35\"\n      data-thumb-emoji=\"🚀\"\n      style=\"--slider-color: oklch(0.6 0.2 25)\"\n    />\n  </div>\n</div>\n","individual":false},{"label":"Units","html":"<div class=\"stack gap-6 w-full max-w-96\">\n  <div>\n    <div class=\"flex items-center justify-between\"\n      ><label class=\"label m-0\" for=\"sl-temp\">Temperature</label\n      ><output for=\"sl-temp\" class=\"slider-value\">21°C</output></div\n    >\n    <input\n      class=\"slider\"\n      type=\"range\"\n      id=\"sl-temp\"\n      min=\"5\"\n      max=\"30\"\n      step=\"0.5\"\n      value=\"21\"\n      data-unit=\"celsius\"\n      data-tone=\"destructive\"\n    />\n    <div class=\"slider-scale\"><span>5 °C</span><span>30 °C</span></div>\n  </div>\n  <div>\n    <div class=\"flex items-center justify-between\"\n      ><label class=\"label m-0\" for=\"sl-speed\">Speed limit</label\n      ><output for=\"sl-speed\" class=\"slider-value\">80 km/h</output></div\n    >\n    <input\n      class=\"slider\"\n      type=\"range\"\n      id=\"sl-speed\"\n      min=\"30\"\n      max=\"130\"\n      step=\"10\"\n      value=\"80\"\n      data-unit=\"kilometer-per-hour\"\n    />\n    <div class=\"slider-scale\"><span>30</span><span>80</span><span>130</span></div>\n  </div>\n  <div>\n    <div class=\"flex items-center justify-between\"\n      ><label class=\"label m-0\" for=\"sl-tip\">Tip</label><output for=\"sl-tip\" class=\"slider-value\">€5</output></div\n    >\n    <input class=\"slider\" type=\"range\" id=\"sl-tip\" min=\"0\" max=\"20\" value=\"5\" data-currency=\"EUR\" data-tone=\"success\" />\n  </div>\n</div>\n","individual":false},{"label":"Range slider","html":"<div class=\"stack gap-8 w-full max-w-96\">\n  <div>\n    <div class=\"flex items-center justify-between\"\n      ><span class=\"label m-0\" id=\"price-label\">Price</span\n      ><output for=\"pr-min pr-max\" class=\"slider-value\">€200 – €800</output></div\n    >\n    <div class=\"slider-range\" data-currency=\"EUR\" data-min-gap=\"50\" role=\"group\" aria-labelledby=\"price-label\">\n      <input\n        class=\"slider\"\n        type=\"range\"\n        id=\"pr-min\"\n        min=\"0\"\n        max=\"1000\"\n        step=\"10\"\n        value=\"200\"\n        aria-label=\"Minimum price\"\n      />\n      <input\n        class=\"slider\"\n        type=\"range\"\n        id=\"pr-max\"\n        min=\"0\"\n        max=\"1000\"\n        step=\"10\"\n        value=\"800\"\n        aria-label=\"Maximum price\"\n      />\n    </div>\n    <div class=\"slider-scale\"><span>€0</span><span>€1,000</span></div>\n  </div>\n  <div class=\"slider-field\">\n    <span class=\"slider-icon\" aria-hidden=\"true\">🌡️</span>\n    <div\n      class=\"slider-range\"\n      data-unit=\"celsius\"\n      data-tone=\"info\"\n      data-size=\"lg\"\n      role=\"group\"\n      aria-label=\"Comfort zone\"\n    >\n      <input class=\"slider\" type=\"range\" id=\"cz-min\" min=\"10\" max=\"30\" value=\"19\" aria-label=\"Lowest temperature\" />\n      <input class=\"slider\" type=\"range\" id=\"cz-max\" min=\"10\" max=\"30\" value=\"23\" aria-label=\"Highest temperature\" />\n    </div>\n    <output for=\"cz-min cz-max\" class=\"slider-value\" style=\"min-width: 6.5em\">19°C – 23°C</output>\n  </div>\n</div>\n","individual":false},{"label":"Right to left","html":"<div class=\"stack gap-6 w-full max-w-80\" dir=\"rtl\" lang=\"ar\">\n  <input class=\"slider\" type=\"range\" value=\"30\" aria-label=\"مستوى الصوت\" />\n  <div class=\"slider-range\" data-tone=\"success\" role=\"group\" aria-label=\"نطاق\">\n    <input class=\"slider\" type=\"range\" value=\"20\" aria-label=\"الحد الأدنى\" />\n    <input class=\"slider\" type=\"range\" value=\"60\" aria-label=\"الحد الأقصى\" />\n  </div>\n</div>\n","individual":false},{"label":"Sizes","html":"<div class=\"flex items-center gap-4 mb-3\">\n  <span class=\"demo-label demo-label-w5\">Extra small</span>\n  <input class=\"slider flex-1\" type=\"range\" value=\"60\" data-size=\"xs\" aria-label=\"Volume xs\" style=\"max-width: 16rem\" />\n</div>\n<div class=\"flex items-center gap-4 mb-3\">\n  <span class=\"demo-label demo-label-w5\">Small</span>\n  <input class=\"slider flex-1\" type=\"range\" value=\"60\" data-size=\"sm\" aria-label=\"Volume sm\" style=\"max-width: 16rem\" />\n</div>\n<div class=\"flex items-center gap-4 mb-3\">\n  <span class=\"demo-label demo-label-w5\">Medium</span>\n  <input class=\"slider flex-1\" type=\"range\" value=\"60\" data-size=\"md\" aria-label=\"Volume md\" style=\"max-width: 16rem\" />\n</div>\n<div class=\"flex items-center gap-4 mb-3\">\n  <span class=\"demo-label demo-label-w5\">Large</span>\n  <input class=\"slider flex-1\" type=\"range\" value=\"60\" data-size=\"lg\" aria-label=\"Volume lg\" style=\"max-width: 16rem\" />\n</div>\n<div class=\"flex items-center gap-4 mb-3\">\n  <span class=\"demo-label demo-label-w5\">Extra large</span>\n  <input class=\"slider flex-1\" type=\"range\" value=\"60\" data-size=\"xl\" aria-label=\"Volume xl\" style=\"max-width: 16rem\" />\n</div>\n","individual":false}]
