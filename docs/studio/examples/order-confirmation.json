[{"label":"Default","html":"<section class=\"mk-order-confirmation\" role=\"status\" aria-labelledby=\"oc-title\">\n  <svg class=\"mk-order-confirmation-check\" viewBox=\"0 0 48 48\" aria-hidden=\"true\">\n    <circle cx=\"24\" cy=\"24\" r=\"22\" />\n    <path d=\"m14 25 7 7 13-15\" />\n  </svg>\n  <h1 class=\"mk-order-confirmation-title\" id=\"oc-title\">Thank you, Anna!</h1>\n  <p class=\"mk-order-confirmation-lead\"\n    >Your order <code>A-20481</code> is confirmed. We sent the details to anna@example.com.</p\n  >\n  <dl class=\"mk-order-confirmation-details\">\n    <div\n      ><dt>Order date</dt><dd><time datetime=\"2026-10-01T14:32\">1 October 2026, 14:32</time></dd></div\n    >\n    <div><dt>Payment</dt><dd>Visa •••• 4242 · €88.90</dd></div>\n    <div\n      ><dt>Delivery to</dt\n      ><dd\n        ><address>Anna Silva<br />Rua da Prata 120, 2º<br />1100-420 Lisboa</address></dd\n      ></div\n    >\n    <div\n      ><dt>Estimated delivery</dt\n      ><dd><time datetime=\"2026-10-07\">Tue 7</time> – <time datetime=\"2026-10-09\">Thu 9 October</time></dd></div\n    >\n  </dl>\n  <ol class=\"mk-order-confirmation-steps\" aria-label=\"What happens next\">\n    <li\n      ><div>We pack your order <span>- usually within a day.</span></div></li\n    >\n    <li\n      ><div>You get a tracking link <span>by email when it ships.</span></div></li\n    >\n    <li\n      ><div>Not right? <span>Returns are free for 30 days.</span></div></li\n    >\n  </ol>\n  <div class=\"mk-order-confirmation-actions\">\n    <a class=\"btn\" href=\"#\">Track your order</a>\n    <a class=\"btn\" data-variant=\"outline\" href=\"#\">Continue shopping</a>\n  </div>\n</section>\n","individual":true}]
