[{"label":"A desktop's model","html":"<div class=\"grid gap-3\">\n  <label class=\"flex items-center gap-2 text-sm\"\n    >Look\n    <select class=\"select\" data-look style=\"width: auto\">\n      <option value=\"\">Modern</option>\n      <option value=\"win7\">7</option>\n      <option value=\"winxp\">XP</option>\n      <option value=\"win98\">98</option>\n      <option value=\"win95\">95</option>\n    </select></label\n  >\n  <div class=\"desktop\" style=\"height: 18rem\">\n    <div class=\"window-desktop window-manager\" id=\"wm-demo\" data-state-demo>\n      <dialog class=\"window\" id=\"wm-notes\" open style=\"--window-x: 1rem; --window-y: 1rem; --window-w: 15rem\">\n        <header class=\"window-titlebar\">\n          <span class=\"window-icon desktop-glyph\" data-glyph=\"text\"></span>\n          <h2 class=\"window-title\">Notes</h2>\n          <form method=\"dialog\" class=\"window-controls\">\n            <button type=\"button\" class=\"window-minimize\" aria-label=\"Minimize\"></button>\n            <button type=\"button\" class=\"window-maximize\" aria-label=\"Maximize\"></button>\n            <button class=\"window-close\" aria-label=\"Close\"></button>\n          </form>\n        </header>\n        <div class=\"window-body\"><p class=\"m-0\" contenteditable=\"true\">Rename me: edit the title below.</p></div>\n      </dialog>\n      <dialog class=\"window\" id=\"wm-files\" open style=\"--window-x: 9rem; --window-y: 3.5rem; --window-w: 15rem\">\n        <header class=\"window-titlebar\">\n          <span class=\"window-icon desktop-glyph\" data-glyph=\"folder\"></span>\n          <h2 class=\"window-title\">Files</h2>\n          <form method=\"dialog\" class=\"window-controls\">\n            <button type=\"button\" class=\"window-minimize\" aria-label=\"Minimize\"></button>\n            <button type=\"button\" class=\"window-maximize\" aria-label=\"Maximize\"></button>\n            <button class=\"window-close\" aria-label=\"Close\"></button>\n          </form>\n        </header>\n        <div class=\"window-body\">3 files</div>\n      </dialog>\n      <dialog class=\"window\" id=\"wm-calc\" style=\"--window-x: 17rem; --window-y: 1.5rem; --window-w: 12rem\">\n        <header class=\"window-titlebar\">\n          <span class=\"window-icon desktop-glyph\" data-glyph=\"calculator\"></span>\n          <h2 class=\"window-title\">Calculator</h2>\n          <form method=\"dialog\" class=\"window-controls\">\n            <button type=\"button\" class=\"window-minimize\" aria-label=\"Minimize\"></button>\n            <button class=\"window-close\" aria-label=\"Close\"></button>\n          </form>\n        </header>\n        <div class=\"window-body\">0</div>\n      </dialog>\n    </div>\n  </div>\n  <div class=\"flex flex-wrap items-center gap-2\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"wm-open\">Open Calculator</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"wm-show\">Show desktop</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"wm-cascade\">Cascade</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"wm-tile\">Tile</button>\n  </div>\n  <ol class=\"grid gap-1 m-0 ps-5 text-sm\" id=\"wm-model\" aria-label=\"The model\"></ol>\n</div>\n","individual":false},{"label":"Two desktops, two front windows","html":"<div class=\"grid gap-3\" style=\"grid-template-columns: 1fr 1fr\">\n  <div class=\"window-desktop window-manager\" style=\"height: 12rem\">\n    <dialog class=\"window\" open style=\"--window-x: 0.75rem; --window-y: 0.75rem; --window-w: 10rem\">\n      <header class=\"window-titlebar\"><h2 class=\"window-title\">Left one</h2></header>\n      <div class=\"window-body\">Desktop A</div>\n    </dialog>\n    <dialog class=\"window\" open style=\"--window-x: 3rem; --window-y: 3.5rem; --window-w: 10rem\">\n      <header class=\"window-titlebar\"><h2 class=\"window-title\">Left two</h2></header>\n      <div class=\"window-body\">Desktop A</div>\n    </dialog>\n  </div>\n  <div class=\"window-desktop window-manager\" style=\"height: 12rem\">\n    <dialog class=\"window\" open style=\"--window-x: 0.75rem; --window-y: 0.75rem; --window-w: 10rem\">\n      <header class=\"window-titlebar\"><h2 class=\"window-title\">Right one</h2></header>\n      <div class=\"window-body\">Desktop B</div>\n    </dialog>\n    <dialog class=\"window\" open style=\"--window-x: 3rem; --window-y: 3.5rem; --window-w: 10rem\">\n      <header class=\"window-titlebar\"><h2 class=\"window-title\">Right two</h2></header>\n      <div class=\"window-body\">Desktop B</div>\n    </dialog>\n  </div>\n</div>\n","individual":false}]
