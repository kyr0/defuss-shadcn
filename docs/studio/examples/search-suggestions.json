[{"label":"Default","html":"<div class=\"mk-search-suggestions\">\n  <div class=\"mk-search-suggestions-field\"\n    ><i data-lucide=\"search\"></i><label class=\"sr-only\" for=\"ss-q\">Search</label\n    ><input\n      class=\"input\"\n      id=\"ss-q\"\n      type=\"search\"\n      value=\"sync\"\n      role=\"combobox\"\n      aria-expanded=\"true\"\n      aria-controls=\"ss-list\"\n      aria-activedescendant=\"ss-o2\"\n      aria-autocomplete=\"list\"\n      autocomplete=\"off\"\n  /></div>\n  <div class=\"mk-search-suggestions-panel\" id=\"ss-list\" role=\"listbox\" aria-label=\"Suggestions\">\n    <div class=\"mk-search-suggestions-group\" role=\"group\" aria-labelledby=\"ss-g1\"\n      ><span id=\"ss-g1\">Recent</span>\n      <div class=\"mk-search-suggestions-option\" role=\"option\" id=\"ss-o1\"\n        ><i data-lucide=\"history\"></i><span><mark>sync</mark> stuck on phone</span><small></small\n      ></div>\n    </div>\n    <div class=\"mk-search-suggestions-group\" role=\"group\" aria-labelledby=\"ss-g2\"\n      ><span id=\"ss-g2\">Pages</span>\n      <div class=\"mk-search-suggestions-option\" role=\"option\" id=\"ss-o2\" aria-selected=\"true\"\n        ><i data-lucide=\"file-text\"></i><span>Offline <mark>sync</mark></span\n        ><small>Docs · Guides</small></div\n      >\n      <div class=\"mk-search-suggestions-option\" role=\"option\" id=\"ss-o3\"\n        ><i data-lucide=\"file-text\"></i><span><mark>Sync</mark> conflicts explained</span><small>Help</small></div\n      >\n    </div>\n    <div class=\"mk-search-suggestions-group\" role=\"group\" aria-labelledby=\"ss-g3\"\n      ><span id=\"ss-g3\">Tasks</span>\n      <div class=\"mk-search-suggestions-option\" role=\"option\" id=\"ss-o4\"\n        ><i data-lucide=\"square-check\"></i><span><mark>Sync</mark> engine v2 rollout</span\n        ><small>Engineering</small></div\n      >\n    </div>\n    <div class=\"mk-search-suggestions-foot\" aria-hidden=\"true\"\n      ><span><kbd class=\"kbd\">↑</kbd> <kbd class=\"kbd\">↓</kbd> move</span><span><kbd class=\"kbd\">↵</kbd> open</span\n      ><span><kbd class=\"kbd\">esc</kbd> close</span></div\n    >\n  </div>\n</div>\n","individual":true},{"label":"Native","html":"<div class=\"mk-search-suggestions\" data-variant=\"native\">\n  <div class=\"mk-search-suggestions-field\"\n    ><i data-lucide=\"search\"></i><label class=\"sr-only\" for=\"ss-n\">Search help</label\n    ><input class=\"input\" id=\"ss-n\" type=\"search\" name=\"q\" list=\"ss-topics\" placeholder=\"Try: invoice, sync, password\"\n  /></div>\n  <datalist id=\"ss-topics\"\n    ><option value=\"Change your billing email\"></option><option value=\"Download an invoice\"></option\n    ><option value=\"Sync is stuck\"></option><option value=\"Reset your password\"></option\n    ><option value=\"Turn on two-factor\"></option\n  ></datalist>\n  <p class=\"mk-search-suggestions-hint\">Suggestions come from the browser's own list.</p>\n</div>\n","individual":true}]
