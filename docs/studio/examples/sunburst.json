[{"label":"Celestial Observatory","html":"<section\n  class=\"presentation\"\n  id=\"deck-sunburst\"\n  data-anim-in=\"irisIn\"\n  data-anim-out=\"blurOut\"\n  style=\"\n    --presentation-ink: #020617;\n    --presentation-ink-foreground: #eef5ff;\n    --presentation-paper: #eef3fb;\n    --presentation-paper-foreground: #020617;\n    --presentation-accent: #ffb45a;\n    font-family: Palatino, Georgia, serif;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"Where the telescope time went - one year at an observatory\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Science hours at an observatory in one year as a sunburst of five fields and their programmes, 2,200 hours in total, exoplanets the largest at 660 hours; then the same hierarchy as a treemap and the oversubscription per field\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Cover\">\n    <svg\n      aria-hidden=\"true\"\n      width=\"660\"\n      height=\"660\"\n      viewBox=\"0 0 660 660\"\n      style=\"position: absolute; right: 100px; top: 120px\"\n    >\n      <circle cx=\"330\" cy=\"330\" r=\"310\" fill=\"none\" stroke=\"rgba(238,245,255,.14)\" stroke-width=\"2\" />\n      <circle\n        cx=\"330\"\n        cy=\"330\"\n        r=\"230\"\n        fill=\"none\"\n        stroke=\"rgba(238,245,255,.18)\"\n        stroke-width=\"2\"\n        stroke-dasharray=\"4 10\"\n      />\n      <circle cx=\"330\" cy=\"330\" r=\"150\" fill=\"none\" stroke=\"rgba(109,167,255,.35)\" stroke-width=\"2\" />\n      <path d=\"M330 20 A310 310 0 0 1 625 235\" fill=\"none\" stroke=\"#FFB45A\" stroke-width=\"10\" stroke-linecap=\"round\" />\n      <path d=\"M330 100 A230 230 0 0 1 549 400\" fill=\"none\" stroke=\"#6DA7FF\" stroke-width=\"10\" stroke-linecap=\"round\" />\n      <path d=\"M330 180 A150 150 0 0 1 460 405\" fill=\"none\" stroke=\"#59D4C3\" stroke-width=\"10\" stroke-linecap=\"round\" />\n      <circle cx=\"330\" cy=\"330\" r=\"16\" fill=\"#FFE096\" />\n      <circle cx=\"120\" cy=\"90\" r=\"3\" fill=\"#EEF5FF\" opacity=\".7\" />\n      <circle cx=\"560\" cy=\"560\" r=\"3\" fill=\"#EEF5FF\" opacity=\".7\" />\n      <circle cx=\"90\" cy=\"470\" r=\"3\" fill=\"#EEF5FF\" opacity=\".7\" />\n      <circle cx=\"610\" cy=\"140\" r=\"3\" fill=\"#EEF5FF\" opacity=\".7\" />\n      <circle cx=\"470\" cy=\"610\" r=\"3\" fill=\"#EEF5FF\" opacity=\".7\" />\n      <circle cx=\"200\" cy=\"40\" r=\"3\" fill=\"#EEF5FF\" opacity=\".7\" />\n    </svg>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\"\n      >Sunburst · Celestial Observatory</p\n    >\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        position: relative;\n        max-width: 1250px;\n        font-family: Palatino, Georgia, serif;\n        font-weight: 400;\n        letter-spacing: -0.02em;\n        font-size: 6.4rem;\n        max-width: 820px;\n        line-height: 1;\n      \"\n      >Where the telescope time went</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px; max-width: 700px\"\n      >365 nights, 2,920 dark hours, one mirror - and three times more requests than time.</p\n    >\n    <p class=\"presentation-note\">Orbits on the cover; rings of data next.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"rings\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"All fields\"\n  >\n    <header class=\"presentation-header\"><span>Science time</span><span>Hours granted, 2025</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Palatino, Georgia, serif;\n        font-weight: 400;\n        letter-spacing: -0.02em;\n      \"\n      >Five fields, twelve programmes</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Inner ring = field, outer ring = programme; angle = hours.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"exo\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Exoplanets\"\n  >\n    <header class=\"presentation-header\"><span>Science time</span><span>Exoplanets highlighted</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Palatino, Georgia, serif;\n        font-weight: 400;\n        letter-spacing: -0.02em;\n      \"\n      >Exoplanets took 30% of the sky</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The other fields dim - transits alone are 380 hours.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"blocks\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Blocks\"\n  >\n    <header class=\"presentation-header\"><span>Hierarchy</span><span>Same data, as area</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Palatino, Georgia, serif;\n        font-weight: 400;\n        letter-spacing: -0.02em;\n      \"\n      >The same hours as blocks</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The rings morph into a treemap - every programme keeps its identity.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Three numbers for the time-allocation committee</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: Palatino, Georgia, serif;\n            font-weight: 400;\n            letter-spacing: -0.02em;\n          \"\n          ><span data-count=\"2920\">2920</span> h</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">of darkness in one year</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #ffb45a;\n            font-family: Palatino, Georgia, serif;\n            font-weight: 400;\n            letter-spacing: -0.02em;\n          \"\n          ><span data-count=\"2200\">2200</span> h</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">went to science - 75%</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: Palatino, Georgia, serif;\n            font-weight: 400;\n            letter-spacing: -0.02em;\n          \"\n          ><span data-count=\"640\">640</span> h</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">lost to cloud, wind and snow</p>\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >Weather took more hours than cosmology got. Nobody can schedule the sky.</p\n    >\n    <p class=\"presentation-note\">The losses frame the allocation.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Night\" style=\"overflow: hidden\">\n    <video\n      autoplay\n      muted\n      loop\n      playsinline\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n        opacity: 0.55;\n        mix-blend-mode: screen;\n      \"\n    >\n      <source src=\"videos/demo.webm\" type=\"video/webm\" />\n      <source src=\"videos/demo.mp4\" type=\"video/mp4\" />\n    </video>\n    <div\n      aria-hidden=\"true\"\n      style=\"position: absolute; inset: 0; background: linear-gradient(90deg, #020617 40%, rgba(109, 167, 255, 0.12))\"\n    ></div>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\">Between exposures</p>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"blur\"\n      style=\"\n        position: relative;\n        font-size: 5rem;\n        max-width: 1100px;\n        font-family: Palatino, Georgia, serif;\n        font-weight: 400;\n        letter-spacing: -0.02em;\n      \"\n      >A night is eight hours long</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 400ms; position: relative; max-width: 900px\"\n      >A transit lasts three of them; a supernova follow-up needs twenty minutes - every night is a puzzle.</p\n    >\n    <p class=\"presentation-note\">Ambient loop - the dome at work.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"north\"\n    data-anim-in-blocks=\"5\"\n    data-anim-in-color=\"#6DA7FF\"\n    aria-label=\"Allocation table\"\n  >\n    <header class=\"presentation-header\"><span>Allocation</span><span>Hours, 2025</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" data-density=\"spacious\" style=\"font-size: 1.7rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Observing hours granted and requested per field (synthetic).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Field</th><th class=\"table-head\" style=\"text-align: right\">Granted</th\n            ><th class=\"table-head\" style=\"text-align: right\">Share</th\n            ><th class=\"table-head\" style=\"text-align: right\">Requested</th\n            ><th class=\"table-head\" style=\"text-align: right\">Pressure</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\" style=\"font-weight: 700\"\n            ><td class=\"table-cell\">Exoplanets</td><td class=\"table-cell\" style=\"text-align: right\">660</td\n            ><td class=\"table-cell\" style=\"text-align: right\">30%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">2,706</td\n            ><td class=\"table-cell\" style=\"text-align: right\">4.1×</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Galaxies</td><td class=\"table-cell\" style=\"text-align: right\">550</td\n            ><td class=\"table-cell\" style=\"text-align: right\">25%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">1,540</td\n            ><td class=\"table-cell\" style=\"text-align: right\">2.8×</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Stars</td><td class=\"table-cell\" style=\"text-align: right\">440</td\n            ><td class=\"table-cell\" style=\"text-align: right\">20%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">836</td\n            ><td class=\"table-cell\" style=\"text-align: right\">1.9×</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Cosmology</td><td class=\"table-cell\" style=\"text-align: right\">330</td\n            ><td class=\"table-cell\" style=\"text-align: right\">15%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">1,122</td\n            ><td class=\"table-cell\" style=\"text-align: right\">3.4×</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Solar system</td><td class=\"table-cell\" style=\"text-align: right\">220</td\n            ><td class=\"table-cell\" style=\"text-align: right\">10%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">330</td\n            ><td class=\"table-cell\" style=\"text-align: right\">1.5×</td></tr\n          >\n        </tbody>\n        <tfoot>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Total</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">2,200</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">100%</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">6,534</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">3.0×</td></tr\n          >\n        </tfoot>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Pressure = hours requested per hour granted.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"\n          font-size: 3.3rem;\n          line-height: 1.22;\n          font-family: Palatino, Georgia, serif;\n          font-weight: 400;\n          letter-spacing: -0.02em;\n          font-size: 3rem;\n        \"\n        >“The sunburst ended the “my field is starving” debate. Everyone could see their slice - and how big the sky\n        actually is.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #020617; color: #ffb45a\"\n        ><span class=\"avatar-fallback\">TO</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Tomás Okafor<br /><span style=\"opacity: 0.7; font-size: 1.4rem\"\n          >Chair, time-allocation committee - fictional</span\n        ></p\n      >\n    </div>\n    <p class=\"presentation-note\">Shared picture, calmer committee.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"demand\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Demand\"\n  >\n    <header class=\"presentation-header\"><span>Demand</span><span>Hours requested per hour granted</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Palatino, Georgia, serif;\n        font-weight: 400;\n        letter-spacing: -0.02em;\n      \"\n      >Exoplanets are the most oversubscribed</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The blocks unroll into one bar per field.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Questions from the committee\"\n  >\n    <header class=\"presentation-header\"><span>Q & A</span><span>Time allocation</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.2rem;\n        margin-block: 5.25rem 1.5rem;\n        font-family: Palatino, Georgia, serif;\n        font-weight: 400;\n        letter-spacing: -0.02em;\n      \"\n      >Questions from the committee</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"sb-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Why not give exoplanets more?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Their 660 hours already exceed any other field; a 4.1× pressure means even doubling would reject half the\n            requests.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"sb-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>What counts as a lost hour?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Any scheduled dark hour with the dome closed - cloud, wind above 60 km/h, snow or ice.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"sb-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Could a second instrument help?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Only for bright targets: galaxies and cosmology need the full mirror and the darkest nights.</p\n          ></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Pressure is the number that matters.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Takeaways</span><span>For the next call for proposals</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">✦</span\n        ><span>A sunburst works when the path - field → programme - is the story.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">✦</span\n        ><span>Exoplanets hold 30% of the time and still 4.1× the demand.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">✦</span\n        ><span>Weather took 22% of the year; plan for it.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">✦</span\n        ><span>Morph the rings into blocks when areas need comparing.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Quiet and orbital.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"south\"\n    data-anim-in-blocks=\"5\"\n    data-anim-in-color=\"#6DA7FF\"\n    aria-label=\"Closing\"\n  >\n    <svg\n      aria-hidden=\"true\"\n      width=\"660\"\n      height=\"660\"\n      viewBox=\"0 0 660 660\"\n      style=\"position: absolute; right: 100px; top: 120px\"\n    >\n      <circle cx=\"330\" cy=\"330\" r=\"310\" fill=\"none\" stroke=\"rgba(238,245,255,.14)\" stroke-width=\"2\" />\n      <circle\n        cx=\"330\"\n        cy=\"330\"\n        r=\"230\"\n        fill=\"none\"\n        stroke=\"rgba(238,245,255,.18)\"\n        stroke-width=\"2\"\n        stroke-dasharray=\"4 10\"\n      />\n      <circle cx=\"330\" cy=\"330\" r=\"150\" fill=\"none\" stroke=\"rgba(109,167,255,.35)\" stroke-width=\"2\" />\n      <path d=\"M330 20 A310 310 0 0 1 625 235\" fill=\"none\" stroke=\"#FFB45A\" stroke-width=\"10\" stroke-linecap=\"round\" />\n      <path d=\"M330 100 A230 230 0 0 1 549 400\" fill=\"none\" stroke=\"#6DA7FF\" stroke-width=\"10\" stroke-linecap=\"round\" />\n      <path d=\"M330 180 A150 150 0 0 1 460 405\" fill=\"none\" stroke=\"#59D4C3\" stroke-width=\"10\" stroke-linecap=\"round\" />\n      <circle cx=\"330\" cy=\"330\" r=\"16\" fill=\"#FFE096\" />\n      <circle cx=\"120\" cy=\"90\" r=\"3\" fill=\"#EEF5FF\" opacity=\".7\" />\n      <circle cx=\"560\" cy=\"560\" r=\"3\" fill=\"#EEF5FF\" opacity=\".7\" />\n      <circle cx=\"90\" cy=\"470\" r=\"3\" fill=\"#EEF5FF\" opacity=\".7\" />\n      <circle cx=\"610\" cy=\"140\" r=\"3\" fill=\"#EEF5FF\" opacity=\".7\" />\n      <circle cx=\"470\" cy=\"610\" r=\"3\" fill=\"#EEF5FF\" opacity=\".7\" />\n      <circle cx=\"200\" cy=\"40\" r=\"3\" fill=\"#EEF5FF\" opacity=\".7\" />\n    </svg>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        font-family: Palatino, Georgia, serif;\n        font-weight: 400;\n        letter-spacing: -0.02em;\n      \"\n      >Every hour of dark, accounted for</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px; max-width: 700px\"\n      >Synthetic hours at a fictional observatory - the sunburst is the real way to show a path through a hierarchy.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">End under the stars.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 12</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"12\" value=\"1\"></progress>\n</section>\n","individual":false}]
