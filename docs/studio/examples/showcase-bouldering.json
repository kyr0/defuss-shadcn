[{"label":"Grip, bouldering in Bochum","html":"<style>\n  @import url('https://fonts.googleapis.com/css2?family=Rubik+Mono+One&family=Rubik:wght@400;500;700&display=swap');\n  /* Grip: a bouldering gym in an old wire factory. Layout: the hero over contour lines with holds stuck around the\n     title, the new problems as tape strips by grade, the setter's beta in a bubble, a day pass ticket and the hours. */\n  #sc-bouldering {\n    --background: oklch(0.975 0.004 90);\n    --foreground: oklch(0.2 0.01 260);\n    --card: oklch(1 0 0);\n    --card-foreground: var(--foreground);\n    --muted: oklch(0.94 0.006 90);\n    --muted-foreground: oklch(0.45 0.012 260);\n    --border: oklch(0.2 0.01 260 / 0.15);\n    --input: var(--border);\n    --primary: oklch(0.2 0.01 260);\n    --primary-foreground: oklch(0.975 0.004 90);\n    --secondary: oklch(0.94 0.006 90);\n    --secondary-foreground: var(--foreground);\n    --accent: oklch(0.72 0.19 45);\n    --accent-foreground: oklch(0.2 0.01 260);\n    --ring: oklch(0.72 0.19 45);\n    --radius: 1rem;\n    --radius-sm: max(0px, calc(var(--radius) - 4px));\n    --radius-md: max(0px, calc(var(--radius) - 2px));\n    --radius-lg: var(--radius);\n    --radius-xl: calc(var(--radius) + 4px);\n    --gr-contour: oklch(0.2 0.01 260 / 0.12);\n    --gr-topo-1: oklch(0.93 0.008 90);\n    --gr-topo-2: oklch(0.86 0.03 55);\n    --gr-contour-line: oklch(0.72 0.02 260);\n    --gr-glow: 0;\n    color-scheme: light;\n    box-sizing: border-box;\n    width: 100%;\n    overflow-x: clip;\n    padding: 0 0 clamp(2rem, 5vw, 4rem);\n    background: var(--background);\n    color: var(--foreground);\n    font-family: 'Rubik', var(--font-sans);\n  }\n  #sc-bouldering[data-look='night'] {\n    color-scheme: dark;\n    --background: oklch(0.17 0.02 280);\n    --foreground: oklch(0.96 0.01 280);\n    --card: oklch(0.21 0.025 280);\n    --muted: oklch(0.24 0.03 280);\n    --muted-foreground: oklch(0.76 0.03 280);\n    --border: oklch(0.96 0.01 280 / 0.15);\n    --primary: oklch(0.88 0.2 130);\n    --primary-foreground: oklch(0.17 0.02 280);\n    --secondary: oklch(0.24 0.03 280);\n    --secondary-foreground: var(--foreground);\n    --accent: oklch(0.88 0.2 130);\n    --accent-foreground: oklch(0.17 0.02 280);\n    --gr-contour: oklch(0.88 0.2 130 / 0.18);\n    --gr-topo-1: oklch(0.3 0.06 285);\n    --gr-topo-2: oklch(0.38 0.1 300);\n    --gr-contour-line: oklch(0.55 0.15 135);\n    --gr-glow: 1;\n  }\n  #sc-bouldering[data-look='granite'] {\n    --background: oklch(0.82 0.008 80);\n    --foreground: oklch(0.22 0.01 60);\n    --card: oklch(0.88 0.008 80);\n    --muted: oklch(0.78 0.01 80);\n    --muted-foreground: oklch(0.38 0.012 60);\n    --border: oklch(0.22 0.01 60 / 0.25);\n    --primary: oklch(0.22 0.01 60);\n    --primary-foreground: oklch(0.88 0.008 80);\n    --secondary: oklch(0.78 0.01 80);\n    --accent: oklch(0.55 0.12 40);\n    --accent-foreground: oklch(0.95 0.01 80);\n    --radius: 0.25rem;\n    --gr-contour: oklch(0.22 0.01 60 / 0.2);\n    --gr-topo-1: oklch(0.8 0.006 60);\n    --gr-topo-2: oklch(0.7 0.01 60);\n    --gr-contour-line: oklch(0.5 0.01 60);\n  }\n  #sc-bouldering .gr-page {\n    position: relative;\n    isolation: isolate;\n    display: flex;\n    flex-direction: column;\n    gap: clamp(3.5rem, 8vw, 6rem);\n    box-sizing: content-box;\n    max-width: 72rem;\n    margin: clamp(3rem, 7vw, 5rem) auto 0;\n    padding-inline: clamp(1rem, 3vw, 2.5rem);\n  }\n  #sc-bouldering .gr-grain {\n    display: none;\n    --surface-size: 6px;\n    --surface-ink: oklch(0.22 0.01 60 / 0.18);\n  }\n  #sc-bouldering[data-look='granite'] .gr-grain {\n    display: block;\n  }\n  #sc-bouldering [hidden] {\n    display: none !important;\n  }\n  /* the Site Header: the name in Rubik Mono with a dab of hold colour, the sections - a strip of tape under the\n     one you point at -, the look and the mode */\n  #sc-bouldering .gr-bar {\n    background: none;\n    color: inherit;\n  }\n  #sc-bouldering .mk-header-inner {\n    flex-wrap: wrap;\n    gap: 0.75rem 1.5rem;\n    max-width: none;\n    min-height: 4.5rem;\n    padding: 0;\n  }\n  #sc-bouldering :is(.mk-header-brand, .mk-footer-brand) {\n    color: inherit;\n  }\n  #sc-bouldering :is(.mk-header-name, .mk-footer-brand-name) {\n    color: inherit;\n    font:\n      400 1.4rem/1 'Rubik Mono One',\n      sans-serif;\n  }\n  #sc-bouldering :is(.mk-header-name, .mk-footer-brand-name)::after {\n    content: '';\n    display: inline-block;\n    width: 0.4em;\n    height: 0.4em;\n    margin-inline-start: 0.1em;\n    border-radius: 40% 60% 55% 45%;\n    background: oklch(0.72 0.19 45);\n  }\n  #sc-bouldering .mk-header-nav {\n    display: flex;\n    margin-inline-start: auto;\n  }\n  #sc-bouldering .nav-menu-list {\n    flex-wrap: wrap;\n  }\n  #sc-bouldering .nav-menu-link {\n    color: inherit;\n    font-size: 0.9375rem;\n    font-weight: 500;\n    white-space: nowrap;\n  }\n  #sc-bouldering .nav-menu-link:is(:hover, :focus-visible) {\n    background: linear-gradient(transparent 62%, color-mix(in oklch, oklch(0.72 0.19 45) 55%, transparent) 0) no-repeat\n      center / calc(100% - 1.5rem) 100%;\n    color: inherit;\n  }\n  #sc-bouldering .mk-header-actions {\n    gap: 0.5rem;\n  }\n  /* the hero over contour lines, holds stuck around the title */\n  #sc-bouldering .gr-hero {\n    position: relative;\n    isolation: isolate;\n    display: flex;\n    flex-direction: column;\n    align-items: flex-start;\n    min-height: 38rem;\n    padding: 1.25rem max(clamp(1rem, 3vw, 2.5rem), calc((100% - 72rem) / 2)) clamp(3rem, 7vw, 5rem);\n  }\n  #sc-bouldering .gr-hero > .gr-bar {\n    align-self: stretch;\n    margin-block-end: auto;\n  }\n  #sc-bouldering .gr-hero > h1 {\n    margin-block-start: clamp(3rem, 8vw, 6rem);\n  }\n  /* the contour lines drift slowly: the topography shader, coloured by the look, edge to edge */\n  #sc-bouldering .gr-hero > .gr-topo {\n    inset: 0;\n    border-radius: 0;\n    mask-image: linear-gradient(to bottom, #000 75%, transparent);\n  }\n  #sc-bouldering .gr-hero h1 {\n    position: relative;\n    margin: 0;\n    font:\n      400 clamp(2.8rem, 9vw, 7rem)/0.9 'Rubik Mono One',\n      sans-serif;\n    letter-spacing: -0.04em;\n    text-transform: uppercase;\n  }\n  #sc-bouldering .gr-hero p {\n    max-width: 32rem;\n    font-size: 1.125rem;\n    line-height: 1.55;\n    color: var(--muted-foreground);\n  }\n  #sc-bouldering .gr-hold {\n    position: absolute;\n    z-index: -1;\n    width: var(--s, 4rem);\n    aspect-ratio: 1;\n    background: var(--c);\n    box-shadow:\n      inset -0.4rem -0.5rem 0 oklch(0 0 0 / 0.18),\n      0 0 calc(var(--gr-glow) * 1.5rem) var(--c);\n    rotate: var(--r, 0deg);\n  }\n  #sc-bouldering .gr-hold::after {\n    content: '';\n    position: absolute;\n    inset: 40%;\n    border-radius: 50%;\n    background: oklch(0 0 0 / 0.35);\n  }\n  /* the new problems: strips of tape in the problem's colour, the grade on it */\n  #sc-bouldering .gr-head {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: baseline;\n    justify-content: space-between;\n    gap: 0.5rem 2rem;\n    margin-block-end: 1.5rem;\n  }\n  #sc-bouldering .gr-head h2 {\n    margin: 0;\n    font:\n      400 clamp(1.5rem, 3.5vw, 2.4rem)/1 'Rubik Mono One',\n      sans-serif;\n    text-transform: uppercase;\n    letter-spacing: -0.03em;\n  }\n  #sc-bouldering .gr-head p {\n    margin: 0;\n    color: var(--muted-foreground);\n  }\n  #sc-bouldering .gr-problems {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));\n    gap: 1.25rem;\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n  #sc-bouldering .gr-problem {\n    display: grid;\n    gap: 0.4rem;\n    padding: 1.1rem 1.25rem 1.25rem;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    background: var(--card);\n  }\n  #sc-bouldering .gr-tape {\n    justify-self: start;\n    padding: 0.3rem 0.9rem;\n    background: var(--c);\n    color: oklch(0.15 0 0);\n    font:\n      700 1.1rem/1 'Rubik',\n      sans-serif;\n    rotate: -3deg;\n    clip-path: polygon(2% 0, 100% 6%, 97% 100%, 0 94%);\n    box-shadow: 0 0 calc(var(--gr-glow) * 1rem) var(--c);\n  }\n  #sc-bouldering .gr-problem h3 {\n    margin: 0.35rem 0 0;\n    font-size: 1.15rem;\n  }\n  #sc-bouldering .gr-problem p {\n    margin: 0;\n    color: var(--muted-foreground);\n    font-size: 0.875rem;\n  }\n  /* the setter's beta, said */\n  #sc-bouldering .gr-beta {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n    align-items: center;\n    gap: clamp(2rem, 5vw, 4rem);\n  }\n  #sc-bouldering .gr-beta img {\n    width: 100%;\n    aspect-ratio: 4 / 3;\n    object-fit: cover;\n    border-radius: var(--radius-xl);\n    rotate: 2deg;\n    box-shadow: 0 1.5rem 2.5rem -1.5rem oklch(0 0 0 / 0.5);\n  }\n  #sc-bouldering .gr-bubble {\n    position: relative;\n    margin: 0 0 1rem;\n    padding: 1.25rem 1.5rem;\n    border-radius: 1.5rem;\n    background: var(--accent);\n    color: var(--accent-foreground);\n    font-size: 1.2rem;\n    font-weight: 500;\n    line-height: 1.35;\n    rotate: -1.5deg;\n  }\n  #sc-bouldering .gr-bubble::after {\n    content: '';\n    position: absolute;\n    right: -0.9rem;\n    bottom: 1.4rem;\n    width: 1.2rem;\n    height: 1.2rem;\n    background: inherit;\n    clip-path: polygon(0 0, 100% 60%, 0 100%);\n  }\n  #sc-bouldering .gr-who {\n    display: flex;\n    align-items: center;\n    gap: 0.75rem;\n    color: var(--muted-foreground);\n  }\n  /* the day pass and the hours */\n  #sc-bouldering .gr-visit {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);\n    gap: 2rem;\n    align-items: start;\n  }\n  #sc-bouldering .gr-pass {\n    --shape-cut: 0.9rem;\n    display: grid;\n    gap: 0.5rem;\n    padding: 1.5rem 2rem;\n    background: var(--primary);\n    color: var(--primary-foreground);\n    rotate: -2deg;\n  }\n  #sc-bouldering .gr-pass b {\n    font:\n      400 2.6rem/0.95 'Rubik Mono One',\n      sans-serif;\n  }\n  #sc-bouldering .gr-pass .btn {\n    justify-self: start;\n    background: var(--accent);\n    color: var(--accent-foreground);\n  }\n  #sc-bouldering .gr-hours {\n    width: 100%;\n    border-collapse: collapse;\n  }\n  #sc-bouldering .gr-hours td {\n    padding: 0.6rem 0;\n    border-block-end: 1px dashed var(--border);\n    font-variant-numeric: tabular-nums;\n  }\n  #sc-bouldering .gr-hours td:last-child {\n    text-align: end;\n    font-weight: 500;\n  }\n  /* the Site Footer: the factory door, the hours, the walls, how to reach the crew and the legal notes */\n  #sc-bouldering .mk-footer {\n    background: none;\n    color: inherit;\n  }\n  #sc-bouldering .mk-footer-inner {\n    max-width: none;\n    padding: 2rem 0 0;\n    border-block-start: 2px dashed var(--border);\n  }\n  #sc-bouldering .mk-footer-heading {\n    color: inherit;\n    font:\n      400 0.8125rem/1.2 'Rubik Mono One',\n      sans-serif;\n  }\n  #sc-bouldering .mk-footer address {\n    font-style: normal;\n    line-height: 1.5;\n  }\n  #sc-bouldering .gr-note {\n    margin: 0;\n    color: var(--muted-foreground);\n    font-size: 0.875rem;\n    line-height: 1.5;\n  }\n  #sc-bouldering .gr-open {\n    display: grid;\n    grid-template-columns: auto 1fr;\n    gap: 0.35rem 1rem;\n    margin: 0;\n    font-size: 0.9375rem;\n    font-variant-numeric: tabular-nums;\n  }\n  #sc-bouldering .gr-open dt {\n    color: var(--muted-foreground);\n  }\n  #sc-bouldering .gr-open dd {\n    margin: 0;\n    font-weight: 500;\n  }\n  #sc-bouldering .mk-footer-list :is(a, button) {\n    padding: 0;\n    border: 0;\n    background: none;\n    color: inherit;\n    font: inherit;\n    text-align: start;\n    cursor: pointer;\n  }\n  #sc-bouldering .mk-footer-list :is(a, button):is(:hover, :focus-visible) {\n    text-decoration: underline;\n    text-decoration-color: oklch(0.72 0.19 45);\n    text-decoration-thickness: 0.2em;\n    text-underline-offset: 0.25em;\n  }\n  #sc-bouldering .mk-footer-rule {\n    margin: 0;\n    background: var(--border);\n  }\n  #sc-bouldering .mk-footer-copy {\n    color: var(--muted-foreground);\n  }\n  /* the dialogs: the slot booking and the legal notes, on the look's card */\n  #sc-bouldering .sc-dialog {\n    border: 1px solid var(--border);\n    background: var(--card);\n    color: var(--card-foreground);\n  }\n  #sc-bouldering .sc-dialog .dialog-title {\n    font:\n      400 1.35rem/1.15 'Rubik Mono One',\n      sans-serif;\n  }\n  #sc-bouldering .sc-dialog .dialog-description {\n    color: var(--muted-foreground);\n  }\n  #sc-bouldering :is(.sc-form, .sc-done) {\n    display: grid;\n    gap: 1rem;\n  }\n  #sc-bouldering .sc-row {\n    display: grid;\n    gap: 0.4rem;\n  }\n  #sc-bouldering .sc-pair {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));\n    gap: 1rem;\n  }\n  #sc-bouldering .sc-checks {\n    display: grid;\n    gap: 0.6rem;\n  }\n  #sc-bouldering .sc-checks .label {\n    display: flex;\n    align-items: center;\n    gap: 0.6rem;\n    font-weight: 400;\n  }\n  #sc-bouldering .sc-dialog:not([data-sent]) .sc-done,\n  #sc-bouldering .sc-dialog[data-sent] .sc-form {\n    display: none;\n  }\n  #sc-bouldering .sc-legal {\n    display: grid;\n    gap: 0.75rem;\n    font-size: 0.9375rem;\n    line-height: 1.55;\n  }\n  #sc-bouldering .sc-legal :is(p, address) {\n    margin: 0;\n    font-style: normal;\n  }\n  #sc-bouldering .sc-legal a {\n    color: inherit;\n  }\n  @media (max-width: 48rem) {\n    #sc-bouldering :is(.gr-beta, .gr-visit) {\n      grid-template-columns: 1fr;\n    }\n    #sc-bouldering .mk-header-nav {\n      order: 3;\n      width: 100%;\n      margin-inline-start: -0.75rem;\n    }\n    #sc-bouldering .mk-header-actions {\n      margin-inline-start: auto;\n    }\n    #sc-bouldering .gr-hold {\n      display: none;\n    }\n  }\n  /* light or dark: the Swap writes the page's dark class - every look has a light and a dark palette */\n  #sc-bouldering .site-mode {\n    flex: none;\n    border: 1px solid var(--input);\n    border-radius: var(--radius-md);\n    background: var(--background);\n    color: var(--foreground);\n  }\n  #sc-bouldering .site-mode:hover {\n    background: var(--accent);\n    color: var(--accent-foreground);\n  }\n  /* -- modes: each look in light and dark, derived from the palettes above (the other mode of each look) -- */\n  :root:not(.dark) #sc-bouldering[data-look='chalk'] {\n    --accent: oklch(0.93 0.045 45);\n  }\n  .dark #sc-bouldering[data-look='chalk'] {\n    color-scheme: dark;\n    --background: oklch(0.17 0.004 90);\n    --foreground: oklch(0.94 0.01 260);\n    --card: oklch(0.205 0 0);\n    --card-foreground: oklch(0.94 0.01 260);\n    --muted: oklch(0.24 0.006 90);\n    --muted-foreground: oklch(0.74 0.012 260);\n    --border: oklch(0.95 0.01 260 / 0.14);\n    --input: oklch(0.95 0.01 260 / 0.14);\n    --primary: oklch(0.93 0.01 260);\n    --primary-foreground: oklch(0.17 0.01 260);\n    --secondary: oklch(0.25 0.006 90);\n    --secondary-foreground: oklch(0.9 0.01 260);\n    --accent: oklch(0.26 0.05 45);\n    --accent-foreground: oklch(0.94 0.01 260);\n    --ring: oklch(0.72 0.18 45);\n    --gr-contour: oklch(0.922 0.01 260 / 0.12);\n    --gr-topo-1: oklch(0.255 0.008 90);\n    --gr-topo-2: oklch(0.36 0.03 55);\n    --gr-contour-line: oklch(0.72 0.02 260);\n    --popover: oklch(0.215 0 0);\n    --popover-foreground: oklch(0.94 0 0);\n  }\n  .dark #sc-bouldering[data-look='night'] {\n    --accent: oklch(0.26 0.05 130);\n    --accent-foreground: oklch(0.96 0.01 280);\n  }\n  :root:not(.dark) #sc-bouldering[data-look='night'] {\n    color-scheme: light;\n    --background: oklch(0.985 0.02 280);\n    --foreground: oklch(0.2 0.01 280);\n    --card: oklch(0.997 0.025 280);\n    --card-foreground: oklch(0.2 0.01 280);\n    --muted: oklch(0.95 0.025 280);\n    --muted-foreground: oklch(0.46 0.03 280);\n    --border: oklch(0.2 0.01 280 / 0.12);\n    --input: oklch(0.2 0.01 280 / 0.12);\n    --primary: oklch(0.58 0.2 130);\n    --primary-foreground: oklch(0.17 0.03 130);\n    --secondary: oklch(0.955 0.025 280);\n    --secondary-foreground: oklch(0.25 0.01 280);\n    --accent: oklch(0.94 0.025 130);\n    --accent-foreground: oklch(0.2 0.01 280);\n    --ring: oklch(0.47 0.19 45);\n    --gr-contour: oklch(0.58 0.2 130 / 0.18);\n    --gr-topo-1: oklch(0.906 0.03 285);\n    --gr-topo-2: oklch(0.863 0.03 300);\n    --gr-contour-line: oklch(0.55 0.15 135);\n    --popover: oklch(0.997 0 0);\n    --popover-foreground: oklch(0.2 0 0);\n  }\n  :root:not(.dark) #sc-bouldering[data-look='granite'] {\n    --accent: oklch(0.86 0.045 40);\n    --accent-foreground: oklch(0.22 0.01 60);\n  }\n  .dark #sc-bouldering[data-look='granite'] {\n    color-scheme: dark;\n    --background: oklch(0.17 0.008 80);\n    --foreground: oklch(0.94 0.01 60);\n    --card: oklch(0.205 0.008 80);\n    --card-foreground: oklch(0.94 0.01 60);\n    --muted: oklch(0.24 0.01 80);\n    --muted-foreground: oklch(0.74 0.012 60);\n    --border: oklch(0.95 0.01 60 / 0.14);\n    --input: oklch(0.95 0.01 60 / 0.14);\n    --primary: oklch(0.93 0.01 60);\n    --primary-foreground: oklch(0.17 0.01 60);\n    --secondary: oklch(0.25 0.01 80);\n    --secondary-foreground: oklch(0.9 0.01 60);\n    --accent: oklch(0.26 0.042 40);\n    --accent-foreground: oklch(0.94 0.01 60);\n    --ring: oklch(0.72 0.18 45);\n    --gr-contour: oklch(0.907 0.01 60 / 0.2);\n    --gr-topo-1: oklch(0.8 0.006 60);\n    --gr-topo-2: oklch(0.7 0.01 60);\n    --gr-contour-line: oklch(0.5 0.01 60);\n    --popover: oklch(0.215 0 0);\n    --popover-foreground: oklch(0.94 0 0);\n  }\n  /* -- modes: end -- */\n</style>\n<div id=\"sc-bouldering\" data-look=\"chalk\">\n  <section class=\"gr-hero\" aria-labelledby=\"gr-title\">\n    <div\n      class=\"shader gr-topo\"\n      data-variant=\"background\"\n      data-effect=\"topography\"\n      data-speed=\"0.5\"\n      data-lines=\"9\"\n      data-relief=\"0.5\"\n      data-zoom=\"0.8\"\n      data-fps=\"30\"\n      data-colors=\"var(--gr-topo-1), var(--gr-topo-2), var(--gr-contour-line)\"\n      data-background=\"var(--background)\"\n      aria-hidden=\"true\"\n    ></div>\n    <header class=\"mk-header gr-bar\">\n      <div class=\"mk-header-inner\">\n        <a class=\"mk-header-brand\" href=\"#sc-bouldering\"><span class=\"mk-header-name\">Grip</span></a>\n        <nav class=\"mk-header-nav\" aria-label=\"Site\">\n          <ul class=\"nav-menu-list\">\n            <li class=\"nav-menu-item\"><a class=\"nav-menu-link\" href=\"#gr-new\">New problems</a></li>\n            <li class=\"nav-menu-item\"><a class=\"nav-menu-link\" href=\"#gr-beta\">Beta</a></li>\n            <li class=\"nav-menu-item\"><a class=\"nav-menu-link\" href=\"#gr-visit\">Day pass</a></li>\n            <li class=\"nav-menu-item\"><a class=\"nav-menu-link\" href=\"#gr-find\">Find us</a></li>\n          </ul>\n        </nav>\n        <div class=\"mk-header-actions\">\n          <select class=\"select\" data-size=\"sm\" data-site-look aria-label=\"Look\" style=\"width: auto\">\n            <option value=\"chalk\">Chalk</option>\n            <option value=\"night\">Night session</option>\n            <option value=\"granite\">Granite</option>\n          </select>\n          <label class=\"swap site-mode\" data-variant=\"rotate\" data-size=\"sm\">\n            <input type=\"checkbox\" data-site-mode aria-label=\"Dark mode\" />\n            <span class=\"swap-on\" aria-hidden=\"true\"><i data-lucide=\"moon\"></i></span>\n            <span class=\"swap-off\" aria-hidden=\"true\"><i data-lucide=\"sun\"></i></span>\n          </label>\n        </div>\n      </div>\n    </header>\n    <span\n      class=\"gr-hold corner-blob\"\n      style=\"--c: oklch(0.72 0.19 45); --s: 5rem; top: 20%; right: 12%; --r: 20deg\"\n      aria-hidden=\"true\"\n    ></span>\n    <span\n      class=\"gr-hold corner-blob-3\"\n      style=\"--c: oklch(0.78 0.16 200); --s: 3.25rem; top: 52%; right: 30%; --r: -35deg\"\n      aria-hidden=\"true\"\n    ></span>\n    <span\n      class=\"gr-hold corner-blob-2\"\n      style=\"--c: oklch(0.86 0.18 100); --s: 2.5rem; bottom: 10%; right: 8%\"\n      aria-hidden=\"true\"\n    ></span>\n    <span\n      class=\"gr-hold corner-blob-4\"\n      style=\"--c: oklch(0.7 0.2 340); --s: 3.75rem; top: 28%; right: 48%; --r: 60deg\"\n      aria-hidden=\"true\"\n    ></span>\n    <h1 id=\"gr-title\">320 problems.<br />No ropes.</h1>\n    <p\n      >1,400 m² of wall in an old wire factory, reset every week. Shoes to rent, chalk to share, coffee at the\n      counter.</p\n    >\n    <a class=\"btn\" data-size=\"lg\" href=\"#gr-visit\">Get a day pass</a>\n  </section>\n  <!-- the Granite look's grain: on the whole site, edge to edge -->\n  <div class=\"surface gr-grain\" data-variant=\"background\" data-pattern=\"grain\" aria-hidden=\"true\"></div>\n  <div class=\"gr-page\">\n    <section id=\"gr-new\" aria-labelledby=\"gr-new-title\">\n      <div class=\"gr-head\">\n        <h2 id=\"gr-new-title\">New this week</h2>\n        <p>Set Monday, 10 November · Fontainebleau grades</p>\n      </div>\n      <ul class=\"gr-problems\">\n        <li class=\"gr-problem\" style=\"--c: oklch(0.86 0.18 100)\"\n          ><span class=\"gr-tape\">5a</span><h3>Butter side up</h3><p>Wall 2 · slab · big feet, small faith</p></li\n        >\n        <li class=\"gr-problem\" style=\"--c: oklch(0.78 0.16 200)\"\n          ><span class=\"gr-tape\">6a+</span><h3>Wire cutter</h3><p>Wall 5 · 30° overhang · two heel hooks</p></li\n        >\n        <li class=\"gr-problem\" style=\"--c: oklch(0.72 0.19 45)\"\n          ><span class=\"gr-tape\">6c</span><h3>Factory reset</h3><p>The cave · compression · the top is a pinch</p></li\n        >\n        <li class=\"gr-problem\" style=\"--c: oklch(0.7 0.2 340)\"\n          ><span class=\"gr-tape\">7a</span><h3>Night shift</h3><p>Wall 7 · dyno to a sloper · stick it</p></li\n        >\n      </ul>\n    </section>\n    <section id=\"gr-beta\" class=\"gr-beta\" aria-labelledby=\"gr-beta-title\">\n      <img src=\"images/photos/177-900x675.webp\" alt=\"A hiker standing in a rocky canyon\" />\n      <div>\n        <p class=\"gr-bubble\"\n          >On Factory reset, don't pull - squeeze. Left toe hooks the volume, then the pinch comes to you.</p\n        >\n        <p class=\"gr-who\"\n          ><span class=\"avatar\" data-size=\"sm\"><img class=\"avatar-image\" src=\"images/avatars/59-96.webp\" alt=\"\" /></span\n          >Kemal, head setter</p\n        >\n        <h2 id=\"gr-beta-title\" class=\"gr-head\" style=\"margin: 0\"\n          ><span\n            style=\"\n              font:\n                400 clamp(1.5rem, 3.5vw, 2.4rem)/1 'Rubik Mono One',\n                sans-serif;\n              text-transform: uppercase;\n              letter-spacing: -0.03em;\n            \"\n            >Beta from the setters</span\n          ></h2\n        >\n      </div>\n    </section>\n    <section id=\"gr-visit\" class=\"gr-visit\" aria-labelledby=\"gr-visit-title\">\n      <div class=\"gr-pass ticket\">\n        <span>Day pass</span>\n        <b id=\"gr-visit-title\">€14</b>\n        <span>Students €11 · shoes €4 · first time? A 20-minute intro is free.</span>\n        <button class=\"btn\" type=\"button\" commandfor=\"gr-book\" command=\"show-modal\">Book a slot</button>\n      </div>\n      <table class=\"gr-hours\">\n        <caption class=\"sr-only\">Opening hours</caption>\n        <tbody>\n          <tr><td>Monday - Friday</td><td>10:00 - 23:00</td></tr>\n          <tr><td>Saturday, Sunday</td><td>09:00 - 22:00</td></tr>\n          <tr><td>Night session (Thursday)</td><td>until 01:00</td></tr>\n          <tr><td>Route setting (Monday)</td><td>wall 1 - 4 closed until 14:00</td></tr>\n        </tbody>\n      </table>\n    </section>\n    <footer id=\"gr-find\" class=\"mk-footer\">\n      <div class=\"mk-footer-inner\">\n        <nav class=\"mk-footer-nav\" aria-label=\"Footer\">\n          <div class=\"mk-footer-col\">\n            <h3 class=\"mk-footer-heading\">Find us</h3>\n            <address>Grip bouldering<br />Drahtwerkstraße 9<br />Bochum</address>\n            <p class=\"gr-note\">Tram 302 to Drahtwerk - the door with the chalk handprints.</p>\n          </div>\n          <div class=\"mk-footer-col\">\n            <h3 class=\"mk-footer-heading\">Open</h3>\n            <dl class=\"gr-open\">\n              <dt>Mon - Fri</dt>\n              <dd>10:00 - 23:00</dd>\n              <dt>Sat, Sun</dt>\n              <dd>09:00 - 22:00</dd>\n              <dt>Thursday</dt>\n              <dd>until 01:00</dd>\n            </dl>\n          </div>\n          <div class=\"mk-footer-col\">\n            <h3 class=\"mk-footer-heading\">The walls</h3>\n            <ul class=\"mk-footer-list\">\n              <li><a href=\"#gr-new\">New this week</a></li>\n              <li><a href=\"#gr-beta\">Beta from the setters</a></li>\n              <li><a href=\"#gr-visit\">Day pass and prices</a></li>\n              <li><button type=\"button\" commandfor=\"gr-book\" command=\"show-modal\">Book a slot</button></li>\n            </ul>\n          </div>\n          <div class=\"mk-footer-col\">\n            <h3 class=\"mk-footer-heading\">Say hi</h3>\n            <ul class=\"mk-footer-list\">\n              <li><a href=\"mailto:hello@example.com\">hello@example.com</a></li>\n              <li><a href=\"https://www.instagram.com/\" target=\"_blank\" rel=\"noopener\">Instagram</a></li>\n              <li><button type=\"button\" commandfor=\"gr-imprint\" command=\"show-modal\">Imprint</button></li>\n              <li><button type=\"button\" commandfor=\"gr-privacy\" command=\"show-modal\">Privacy</button></li>\n            </ul>\n          </div>\n        </nav>\n        <hr class=\"separator mk-footer-rule\" />\n        <div class=\"mk-footer-bottom\">\n          <a class=\"mk-footer-brand\" href=\"#sc-bouldering\"><span class=\"mk-footer-brand-name\">Grip</span></a>\n          <div class=\"mk-footer-meta\">\n            <p class=\"mk-footer-copy\">Brush your holds. Spot your friends. Fall well.</p>\n          </div>\n        </div>\n      </div>\n    </footer>\n  </div>\n  <dialog class=\"dialog sc-dialog\" id=\"gr-book\" aria-labelledby=\"gr-book-title\">\n    <div class=\"dialog-content\">\n      <form class=\"sc-form\" data-sc-form>\n        <div class=\"dialog-header\">\n          <h2 class=\"dialog-title\" id=\"gr-book-title\">Book a slot</h2>\n          <p class=\"dialog-description\">Two hours on the wall. Pay at the counter - €14, students €11.</p>\n        </div>\n        <div class=\"sc-pair\">\n          <div class=\"sc-row\">\n            <label class=\"label\" for=\"gr-book-day\">Day</label>\n            <input class=\"input\" id=\"gr-book-day\" name=\"day\" type=\"date\" required />\n          </div>\n          <div class=\"sc-row\">\n            <label class=\"label\" for=\"gr-book-time\">From</label>\n            <select class=\"select\" id=\"gr-book-time\" name=\"time\">\n              <option>10:00</option>\n              <option>12:00</option>\n              <option>14:00</option>\n              <option>16:00</option>\n              <option selected>18:00</option>\n              <option>20:00</option>\n            </select>\n          </div>\n        </div>\n        <div class=\"sc-row\">\n          <label class=\"label\" for=\"gr-book-people\">Climbers</label>\n          <input\n            class=\"input\"\n            id=\"gr-book-people\"\n            name=\"people\"\n            type=\"number\"\n            min=\"1\"\n            max=\"8\"\n            value=\"1\"\n            inputmode=\"numeric\"\n            required\n          />\n        </div>\n        <div class=\"sc-checks\">\n          <label class=\"label\"\n            ><input class=\"checkbox\" type=\"checkbox\" name=\"intro\" /> First time - add the free 20-minute intro</label\n          >\n          <label class=\"label\"><input class=\"checkbox\" type=\"checkbox\" name=\"shoes\" /> Rent shoes (€4)</label>\n        </div>\n        <div class=\"sc-row\">\n          <label class=\"label\" for=\"gr-book-mail\">Email</label>\n          <input class=\"input\" id=\"gr-book-mail\" name=\"email\" type=\"email\" autocomplete=\"email\" required />\n        </div>\n        <div class=\"dialog-footer\">\n          <button class=\"btn\" data-variant=\"outline\" type=\"button\" commandfor=\"gr-book\" command=\"close\">Cancel</button>\n          <button class=\"btn\" type=\"submit\">Hold my slot</button>\n        </div>\n      </form>\n      <div class=\"sc-done\" tabindex=\"-1\">\n        <h2 class=\"dialog-title\">Slot held</h2>\n        <p class=\"dialog-description\"\n          >Show the email at the counter. Come ten minutes early if you are new - the intro starts on the hour, and the\n          chalk is on us.</p\n        >\n        <div class=\"dialog-footer\">\n          <button class=\"btn\" type=\"button\" commandfor=\"gr-book\" command=\"close\">Close</button>\n        </div>\n      </div>\n    </div>\n  </dialog>\n  <dialog class=\"dialog sc-dialog\" id=\"gr-imprint\" aria-labelledby=\"gr-imprint-title\">\n    <div class=\"dialog-content\">\n      <div class=\"dialog-header\">\n        <h2 class=\"dialog-title\" id=\"gr-imprint-title\">Imprint</h2>\n        <p class=\"dialog-description\">Who runs this site</p>\n      </div>\n      <div class=\"sc-legal\">\n        <address>Grip Boulderhalle GmbH<br />Drahtwerkstraße 9<br />Bochum, Germany</address>\n        <p>Managing directors: Kemal Aydın, Sanne Vos<br />Commercial register: Bochum, HRB 00000</p>\n        <p>Contact: <a href=\"mailto:hello@example.com\">hello@example.com</a></p>\n      </div>\n      <div class=\"dialog-footer\">\n        <button class=\"btn\" type=\"button\" commandfor=\"gr-imprint\" command=\"close\">Close</button>\n      </div>\n    </div>\n  </dialog>\n  <dialog class=\"dialog sc-dialog\" id=\"gr-privacy\" aria-labelledby=\"gr-privacy-title\">\n    <div class=\"dialog-content\">\n      <div class=\"dialog-header\">\n        <h2 class=\"dialog-title\" id=\"gr-privacy-title\">Privacy</h2>\n        <p class=\"dialog-description\">What we keep, and why</p>\n      </div>\n      <div class=\"sc-legal\">\n        <p\n          >This site sets no cookies and runs no trackers. The fonts come from Google Fonts; the photos are served with\n          the site.</p\n        >\n        <p\n          >For a slot we keep your email until the day after your visit, to send the booking and nothing else. The\n          waiver you sign at the counter stays on paper, in the office.</p\n        >\n        <p>Questions or a request to delete: <a href=\"mailto:privacy@example.com\">privacy@example.com</a></p>\n      </div>\n      <div class=\"dialog-footer\">\n        <button class=\"btn\" type=\"button\" commandfor=\"gr-privacy\" command=\"close\">Close</button>\n      </div>\n    </div>\n  </dialog>\n</div>\n","individual":false}]
