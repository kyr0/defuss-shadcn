[{"label":"Default","html":"<header class=\"mk-blog-header\">\n  <div class=\"mk-blog-header-copy\">\n    <span class=\"mk-blog-header-eyebrow\">The Acme Blog</span>\n    <h1 class=\"mk-blog-header-title\">Notes on building calm software</h1>\n    <p class=\"mk-blog-header-desc\"\n      >Essays on product, engineering and design from the team behind Acme - one post a week, no hot takes.</p\n    >\n  </div>\n  <div class=\"mk-blog-header-actions\">\n    <a class=\"btn\" data-size=\"sm\" href=\"#\"><i data-lucide=\"mail\"></i> Subscribe</a>\n    <a class=\"btn\" data-variant=\"outline\" data-size=\"sm\" href=\"#\" type=\"application/rss+xml\"\n      ><i data-lucide=\"rss\"></i> RSS</a\n    >\n  </div>\n  <nav class=\"mk-blog-header-categories\" aria-label=\"Categories\">\n    <a href=\"#\" aria-current=\"page\">All posts</a>\n    <a href=\"#\">Engineering</a>\n    <a href=\"#\">Design</a>\n    <a href=\"#\">Product</a>\n    <a href=\"#\">Company</a>\n  </nav>\n</header>\n","individual":true},{"label":"Centered banner","html":"<header class=\"mk-blog-header\" data-variant=\"banner\" data-align=\"center\">\n  <div class=\"mk-blog-header-copy\">\n    <span class=\"mk-blog-header-eyebrow\">Engineering</span>\n    <h1 class=\"mk-blog-header-title\">How we build Acme</h1>\n    <p class=\"mk-blog-header-desc\">Architecture notes, post-mortems and the tools we wrote along the way.</p>\n  </div>\n  <nav class=\"mk-blog-header-categories\" aria-label=\"Categories\">\n    <a href=\"#\">All posts</a>\n    <a href=\"#\" aria-current=\"page\">Engineering</a>\n    <a href=\"#\">Design</a>\n    <a href=\"#\">Product</a>\n  </nav>\n</header>\n","individual":true},{"label":"Split with subscribe","html":"<header class=\"mk-blog-header\" data-variant=\"split\">\n  <div class=\"mk-blog-header-copy\">\n    <span class=\"mk-blog-header-eyebrow\">The Acme Blog</span>\n    <h1 class=\"mk-blog-header-title\">Notes on building calm software</h1>\n    <p class=\"mk-blog-header-desc\"\n      >One essay a week on product, engineering and design. No hot takes, no growth hacks.</p\n    >\n    <form class=\"mk-blog-header-subscribe\" aria-label=\"Subscribe\">\n      <input\n        class=\"input\"\n        type=\"email\"\n        name=\"email\"\n        placeholder=\"you@company.com\"\n        autocomplete=\"email\"\n        required\n        aria-label=\"Email\"\n      />\n      <button class=\"btn\" type=\"submit\">Subscribe</button>\n    </form>\n  </div>\n  <figure class=\"mk-blog-header-media\"><img src=\"images/mk-wide3.png\" alt=\"The Acme team writing together\" /></figure>\n</header>\n","individual":true},{"label":"Search, view and sort","html":"<header class=\"mk-blog-header\">\n  <div class=\"mk-blog-header-copy\">\n    <h1 class=\"mk-blog-header-title\">All posts</h1>\n  </div>\n  <nav class=\"mk-blog-header-categories\" aria-label=\"Categories\">\n    <a href=\"#\" aria-current=\"page\">All <span class=\"mk-blog-header-count\">128</span></a>\n    <a href=\"#\">Engineering <span class=\"mk-blog-header-count\">54</span></a>\n    <a href=\"#\">Design <span class=\"mk-blog-header-count\">31</span></a>\n    <a href=\"#\">Product <span class=\"mk-blog-header-count\">28</span></a>\n    <a href=\"#\">Company <span class=\"mk-blog-header-count\">15</span></a>\n  </nav>\n  <div class=\"mk-blog-header-toolbar\">\n    <input class=\"input\" type=\"search\" placeholder=\"Search posts…\" aria-label=\"Search posts\" style=\"max-width: 18rem\" />\n    <div class=\"flex items-center gap-2\">\n      <div class=\"toggle-group\" role=\"group\" aria-label=\"View\" data-type=\"single\" data-size=\"sm\">\n        <button class=\"toggle\" aria-pressed=\"true\" value=\"grid\" aria-label=\"Grid\"\n          ><i data-lucide=\"layout-grid\"></i\n        ></button>\n        <button class=\"toggle\" aria-pressed=\"false\" value=\"list\" aria-label=\"List\"><i data-lucide=\"list\"></i></button>\n      </div>\n      <select class=\"select\" data-size=\"sm\" aria-label=\"Sort posts\"\n        ><option>Newest</option\n        ><option>Most read</option\n        ><option>Oldest</option></select\n      >\n    </div>\n  </div>\n</header>\n","individual":true},{"label":"Editorial","html":"<header class=\"mk-blog-header\" data-variant=\"editorial\">\n  <div class=\"mk-blog-header-copy\">\n    <span class=\"mk-blog-header-eyebrow\">Est. 2016</span>\n    <h1 class=\"mk-blog-header-title\">The Quiet Quarterly</h1>\n    <p class=\"mk-blog-header-desc\">Long reads on work, tools and attention.</p>\n  </div>\n  <nav class=\"mk-blog-header-categories\" aria-label=\"Sections\">\n    <a href=\"#\" aria-current=\"page\">Essays</a>\n    <a href=\"#\">Interviews</a>\n    <a href=\"#\">Field notes</a>\n    <a href=\"#\">Letters</a>\n  </nav>\n</header>\n","individual":true}]
