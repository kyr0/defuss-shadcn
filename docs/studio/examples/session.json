[{"label":"Session","html":"<section\n  class=\"session\"\n  id=\"chat\"\n  aria-label=\"Chat with Sofia\"\n  data-drop\n  data-drop-accept=\"image/*\"\n  data-drop-label=\"Drop images to attach\"\n  data-animate\n  style=\"height: 32rem\"\n>\n  <div class=\"session-viewport\" aria-label=\"Messages\">\n    <div class=\"session-content\">\n      <div class=\"session-item\"\n        ><div class=\"marker\" data-variant=\"separator\"><span class=\"marker-content\">Yesterday</span></div></div\n      >\n      <div class=\"session-item\" data-message-id=\"s1\">\n        <div class=\"message\"\n          ><div class=\"message-avatar\"\n            ><span class=\"avatar\" data-size=\"sm\"\n              ><img class=\"avatar-image\" src=\"https://github.com/evilrabbit.png\" alt=\"Sofia Davis\" /><span\n                class=\"avatar-fallback\"\n                >SD</span\n              ></span\n            ></div\n          ><div class=\"message-content\"\n            ><div class=\"message-header\"\n              ><span class=\"message-name\">Sofia Davis</span><time class=\"message-time\">17:02</time></div\n            ><div class=\"bubble\" data-variant=\"secondary\"\n              ><div class=\"bubble-content\">Hey! Are we still on for the release review tomorrow?</div></div\n            ></div\n          ></div\n        >\n      </div>\n      <div class=\"session-item\" data-message-id=\"s2\">\n        <div class=\"message\" data-align=\"end\"\n          ><div class=\"message-avatar\"\n            ><span class=\"avatar\" data-size=\"sm\"\n              ><img class=\"avatar-image\" src=\"https://github.com/kyr0.png\" alt=\"You\" /><span class=\"avatar-fallback\"\n                >AH</span\n              ></span\n            ></div\n          ><div class=\"message-content\"\n            ><div class=\"bubble\"><div class=\"bubble-content\">Yes - constantly shipping.</div></div></div\n          ></div\n        >\n      </div>\n      <div class=\"session-item\" data-message-id=\