currentColor\"\n    stroke-width=\"2\"\n    stroke-linecap=\"round\"\n    stroke-linejoin=\"round\"\n  >\n    <rect width=\"20\" height=\"16\" x=\"2\" y=\"4\" rx=\"2\" />\n    <path d=\"m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7\" />\n  </svg>\n</div>\n","individual":false},{"label":"Clear button","html":"<div class=\"input-group\" style=\"max-width: 24rem\">\n  <svg\n    class=\"input-group-icon\"\n    aria-hidden=\"true\"\n    width=\"16\"\n    height=\"16\"\n    viewBox=\"0 0 24 24\"\n    fill=\"none\"\n    stroke=\"currentColor\"\n    stroke-width=\"2\"\n    stroke-linecap=\"round\"\n    stroke-linejoin=\"round\"\n  >\n    <circle cx=\"11\" cy=\"11\" r=\"8\" />\n    <path d=\"m21 21-4.3-4.3\" />\n  </svg>\n  <input data-example-root class=\"input\" type=\"text\" id=\"clear-demo\" value=\"design tokens\" aria-label=\"Search\" />\n  <button type=\"button\" class=\"input-group-button\" id=\"clear-demo-btn\" aria-label=\"Clear search\"\n    ><svg\n      aria-hidden=\"true\"\n      width=\"16\"\n      height=\"16\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n    >\n      <path d=\"M18 6 6 18\" />\n      <path d=\"m6 6 12 12\" /></svg\n  ></button>\n</div>\n","individual":false},{"label":"Password with show / hide","html":"<label class=\"label\" for=\"pw-demo\">Password</label>\n<div class=\"input-group\" style=\"max-width: 24rem\">\n  <input\n    data-example-root\n    class=\"input\"\n    type=\"password\"\n    id=\"pw-demo\"\n    value=\"correct horse battery\"\n    autocomplete=\"current-password\"\n  />\n  <button type=\"button\" class=\"input-group-button\" id=\"pw-demo-btn\" aria-label=\"Show password\" aria-pressed=\"false\">\n    <svg\n      data-icon=\"show\"\n      aria-hidden=\"true\"\n      width=\"16\"\n      height=\"16\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n    >\n      <path d=\"M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0\" />\n      <circle cx=\"12\" cy=\"12\" r=\"3\" />\n    </svg>\n    <svg\n      data-icon=\"hide\"\n      hidden\n      aria-hidden=\"true\"\n      width=\"16\"\n      height=\"16\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n    >\n      <path d=\"M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49\" />\n      <path d=\"M14.084 14.158a3 3 0 0 1-4.242-4.242\" />\n      <path d=\"M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143\" />\n      <path d=\"m2 2 20 20\" />\n    </svg>\n  </button>\n</div>\n","individual":false},{"label":"Text addons","html":"<div class=\"input-group\" style=\"max-width: 24rem\">\n  <span class=\"input-group-text\">https://</span>\n  <input data-example-root class=\"input\" type=\"text\" value=\"defuss\" aria-label=\"Subdomain\" />\n  <span class=\"input-group-text\">.example.com</span>\n</div>\n","individual":false},{"label":"File","html":"<label class=\"label\" for=\"picture\">Picture</label>\n<input data-example-root class=\"input\" type=\"file\" id=\"picture\" aria-describedby=\"picture-desc\" />\n<p class=\"field-description\" id=\"picture-desc\">Select a picture to upload.</p>\n","individual":false},{"label":"Textarea","html":"<label class=\"label\" for=\"message\">Message</label>\n<textarea data-example-root class=\"input\" id=\"message\" placeholder=\"Your message...\"></textarea>\n","individual":false},{"label":"Readonly","html":"<label class=\"label\" for=\"api-key\">API Key</label>\n<div class=\"input-group\" style=\"max-width: 24rem\">\n  <input\n    data-example-root\n    class=\"input\"\n    type=\"text\"\n    id=\"api-key\"\n    readonly\n    value=\"sk-1234567890abcdef\"\n    aria-describedby=\"api-key-desc\"\n  />\n  <button type=\"button\" class=\"input-group-button\" id=\"api-key-copy\" aria-label=\"Copy API key\">\n    <svg\n      data-icon=\"copy\"\n      aria-hidden=\"true\"\n      width=\"16\"\n      height=\"16\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n    >\n      <rect width=\"14\" height=\"14\" x=\"8\" y=\"8\" rx=\"2\" />\n      <path d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\" />\n    </svg>\n    <svg\n      data-icon=\"done\"\n      hidden\n      aria-hidden=\"true\"\n      width=\"16\"\n      height=\"16\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n    >\n      <path d=\"M20 6 9 17l-5-5\" />\n    </svg>\n  </button>\n</div>\n<p class=\"field-description\" id=\"api-key-desc\">Your API key is read-only.</p>\n","individual":false},{"label":"With button","html":"<div style=\"display: flex; gap: 0.5rem; max-width: 24rem\">\n  <input data-example-root class=\"input\" type=\"search\" placeholder=\"Search...\" />\n  <button class=\"btn\" data-variant=\"default\">Search</button>\n</div>\n","individual":false},{"label":"Form composition","html":"<form\n  id=\"compose-form\"\n  data-validate=\"submit\"\n  style=\"max-width: 24rem; display: flex; flex-direction: column; gap: 1.25rem\"\n>\n  <div>\n    <label class=\"label\" for=\"f-name\">Name</label>\n    <input class=\"input\" type=\"text\" id=\"f-name\" required placeholder=\"Jane Doe\" />\n  </div>\n  <div>\n    <label class=\"label\" for=\"f-email\">Email</label>\n    <input\n      data-example-root\n      class=\"input\"\n      type=\"email\"\n      id=\"f-email\"\n      required\n      placeholder=\"jane@example.com\"\n      aria-describedby=\"f-email-desc\"\n    />\n    <p class=\"field-description\" id=\"f-email-desc\">We'll never share your email with anyone.</p>\n  </div>\n  <div>\n    <label class=\"label\" for=\"f-bio\">Bio</label>\n    <textarea class=\"input\" id=\"f-bio\" placeholder=\"Tell us about yourself...\"></textarea>\n  </div>\n  <div style=\"display: flex; gap: 0.5rem; justify-content: flex-end\">\n    <button class=\"btn\" data-variant=\"outline\" type=\"reset\">Cancel</button>\n    <button class=\"btn\" data-variant=\"default\" type=\"submit\">Submit</button>\n  </div>\n</form>\n","individual":false},{"label":"Custom validation","html":"<form\n  id=\"signup\"\n  data-validate=\"submit\"\n  novalidate\n  style=\"max-width: 24rem; display: flex; flex-direction: column; gap: 1.25rem\"\n>\n  <div>\n    <label class=\"label\" for=\"su-user\">Username</label>\n    <input\n      class=\"input\"\n      type=\"text\"\n      id=\"su-user\"\n      name=\"username\"\n      autocomplete=\"username\"\n      aria-describedby=\"su-user-err\"\n    />\n    <p class=\"field-error\" id=\"su-user-err\" hidden></p>\n  </div>\n  <div>\n    <label class=\"label\" for=\"su-code\">Invite code</label>\n    <input\n      class=\"input\"\n      type=\"text\"\n      id=\"su-code\"\n      name=\"code\"\n      placeholder=\"ABC-1234\"\n      autocomplete=\"off\"\n      aria-describedby=\"su-code-hint su-code-err\"\n    />\n    <p class=\"field-description\" id=\"su-code-hint\">Three letters, a dash, four digits.</p>\n    <p class=\"field-error\" id=\"su-code-err\" hidden></p>\n  </div>\n  <div>\n    <label class=\"label\" for=\"su-pw\">Password</label>\n    <input\n      class=\"input\"\n      type=\"password\"\n      id=\"su-pw\"\n      name=\"password\"\n      autocomplete=\"new-password\"\n      aria-describedby=\"su-pw-err\"\n    />\n    <p class=\"field-error\" id=\"su-pw-err\" hidden></p>\n  </div>\n  <div>\n    <label class=\"label\" for=\"su-pw2\">Repeat password</label>\n    <input\n      class=\"input\"\n      type=\"password\"\n      id=\"su-pw2\"\n      name=\"password2\"\n      autocomplete=\"new-password\"\n      aria-describedby=\"su-pw2-err\"\n    />\n    <p class=\"field-error\" id=\"su-pw2-err\" hidden></p>\n  </div>\n  <div style=\"display: flex; gap: 0.75rem; align-items: center; justify-content: flex-end\">\n    <output id=\"su-done\" class=\"text-sm text-muted-foreground\"></output>\n    <button class=\"btn\" data-variant=\"default\" type=\"submit\">Create account</button>\n  </div>\n</form>\n","individual":false}]
