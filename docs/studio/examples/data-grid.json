[{"label":"Pages","html":"<div\n  class=\"data-grid\"\n  id=\"dg-pages\"\n  aria-label=\"Paged customers\"\n  data-paging=\"pages\"\n  data-page-size=\"20\"\n  style=\"height: 24rem; max-width: 36rem\"\n>\n  <div class=\"data-grid-viewport\">\n    <div class=\"data-grid-head\">\n      <div class=\"data-grid-row\">\n        <div class=\"data-grid-header\" data-field=\"id\" data-type=\"number\" data-format=\"\" data-width=\"5rem\">#</div>\n        <div class=\"data-grid-header\" data-field=\"name\" data-width=\"minmax(10rem, 1fr)\" data-filter=\"text\">Name</div>\n        <div\n          class=\"data-grid-header\"\n          data-field=\"plan\"\n          data-width=\"7rem\"\n          data-filter=\"select\"\n          data-options=\"Free,Pro,Team\"\n          >Plan</div\n        >\n        <div class=\"data-grid-header\" data-field=\"seats\" data-type=\"number\" data-width=\"6rem\">Seats</div>\n      </div>\n    </div>\n    <div class=\"data-grid-body\"></div>\n  </div>\n</div>\n","individual":true},{"label":"Infinite scrolling","html":"<div\n  class=\"data-grid\"\n  id=\"dg-feed\"\n  aria-label=\"Event log\"\n  data-paging=\"infinite\"\n  data-page-size=\"50\"\n  style=\"height: 20rem; max-width: 36rem\"\n>\n  <div class=\"data-grid-viewport\">\n    <div class=\"data-grid-head\">\n      <div class=\"data-grid-row\">\n        <div\n          class=\"data-grid-header\"\n          data-field=\"id\"\n          data-type=\"number\"\n          data-format=\"\"\n          data-width=\"5rem\"\n          data-sortable=\"false\"\n          >#</div\n        >\n        <div class=\"data-grid-header\" data-field=\"level\" data-width=\"6rem\" data-sortable=\"false\">Level</div>\n        <div class=\"data-grid-header\" data-field=\"message\" data-width=\"minmax(14rem, 1fr)\" data-sortable=\"false\"\n          >Message</div\n        >\n      </div>\n    </div>\n    <div class=\"data-grid-body\"></div>\n  </div>\n</div>\n","individual":true},{"label":"Custom cells","html":"<div class=\"data-grid\" id=\"dg-cells\" aria-label=\"Deployments\" style=\"height: 16rem; max-width: 40rem\">\n  <div class=\"data-grid-viewport\">\n    <div class=\"data-grid-head\">\n      <div class=\"data-grid-row\">\n        <div class=\"data-grid-header\" data-field=\"service\" data-width=\"minmax(9rem, 1fr)\">Service</div>\n        <div class=\"data-grid-header\" data-field=\"status\" data-width=\"8rem\">Status</div>\n        <div class=\"data-grid-header\" data-field=\"coverage\" data-type=\"number\" data-width=\"10rem\">Coverage</div>\n      </div>\n    </div>\n    <div class=\"data-grid-body\"></div>\n  </div>\n</div>\n","individual":true},{"label":"100,000 orders","html":"<div class=\"flex flex-col gap-2\">\n  <div\n    class=\"data-grid\"\n    id=\"dg-orders\"\n    aria-label=\"Orders\"\n    data-select=\"multiple\"\n    data-empty-text=\"No orders match.\"\n    style=\"height: 24rem\"\n  >\n    <div class=\"data-grid-viewport\">\n      <div class=\"data-grid-head\">\n        <div class=\"data-grid-row\">\n          <div\n            class=\"data-grid-header\"\n            data-field=\"id\"\n            data-type=\"number\"\n            data-format=\"\"\n            data-width=\"6rem\"\n            data-filter=\"number\"\n            data-locked\n            >Order</div\n          >\n          <div class=\"data-grid-header\" data-field=\"customer\" data-width=\"11rem\" data-filter=\"text\">Customer</div>\n          <div class=\"data-grid-header\" data-field=\"country\" data-width=\"9rem\" data-filter=\"select\">Country</div>\n          <div class=\"data-grid-header\" data-field=\"product\" data-width=\"10rem\" data-filter=\"text\">Product</div>\n          <div class=\"data-grid-header\" data-field=\"quantity\" data-type=\"number\" data-width=\"6rem\" data-filter=\"number\"\n            >Qty</div\n          >\n          <div\n            class=\"data-grid-header\"\n            data-field=\"total\"\n            data-type=\"number\"\n            data-format=\"currency:EUR\"\n            data-width=\"8rem\"\n            data-filter=\"number\"\n            >Total</div\n          >\n          <div class=\"data-grid-header\" data-field=\"status\" data-width=\"8rem\" data-filter=\"select\">Status</div>\n          <div class=\"data-grid-header\" data-field=\"date\" data-format=\"date\" data-width=\"8rem\">Date</div>\n        </div>\n      </div>\n      <div class=\"data-grid-body\"></div>\n    </div>\n  </div>\n  <p class=\"text-sm text-muted-foreground m-0\" id=\"dg-orders-query\" aria-live=\"polite\"></p>\n</div>\n","individual":false},{"label":"The store is the query","html":"<div class=\"flex flex-col gap-3\">\n  <div class=\"flex flex-wrap gap-2\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" data-q=\"top\">Top revenue</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" data-q=\"eu\">EU only</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" data-q=\"lock\">Lock name + region</button>\n    <button class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" type=\"button\" data-q=\"reset\">Reset</button>\n  </div>\n  <div class=\"data-grid\" id=\"dg-driven\" aria-label=\"Accounts\" style=\"height: 16rem\">\n    <div class=\"data-grid-viewport\">\n      <div class=\"data-grid-head\">\n        <div class=\"data-grid-row\">\n          <div class=\"data-grid-header\" data-field=\"name\" data-width=\"11rem\">Account</div>\n          <div class=\"data-grid-header\" data-field=\"region\" data-width=\"7rem\">Region</div>\n          <div\n            class=\"data-grid-header\"\n            data-field=\"revenue\"\n            data-type=\"number\"\n            data-format=\"currency:USD\"\n            data-width=\"9rem\"\n            >Revenue</div\n          >\n          <div class=\"data-grid-header\" data-field=\"growth\" data-type=\"number\" data-format=\"percent\" data-width=\"7rem\"\n            >Growth</div\n          >\n          <div class=\"data-grid-header\" data-field=\"owner\" data-width=\"9rem\">Owner</div>\n        </div>\n      </div>\n      <div class=\"data-grid-body\"></div>\n    </div>\n  </div>\n  <pre\n    class=\"text-xs m-0 overflow-x-auto\"\n    id=\"dg-driven-json\"\n    style=\"padding: 0.75rem; border-radius: var(--radius-md); background: var(--muted)\"\n  ></pre>\n</div>\n","individual":false},{"label":"A kept view","html":"<div class=\"flex flex-col gap-3\" style=\"max-width: 36rem\">\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"dg-remount\" style=\"align-self: flex-start\"\n    >Mount a fresh grid</button\n  >\n  <div id=\"dg-kept-host\"></div>\n</div>\n<template id=\"dg-kept-template\">\n  <div\n    class=\"data-grid\"\n    id=\"dg-kept\"\n    aria-label=\"Cities\"\n    data-persist=\"local\"\n    data-persist-key=\"docs:cities-grid\"\n    style=\"height: 14rem\"\n  >\n    <div class=\"data-grid-viewport\">\n      <div class=\"data-grid-head\">\n        <div class=\"data-grid-row\">\n          <div class=\"data-grid-header\" data-field=\"city\" data-width=\"minmax(9rem, 1fr)\" data-filter=\"text\">City</div>\n          <div class=\"data-grid-header\" data-field=\"country\" data-width=\"8rem\" data-filter=\"select\">Country</div>\n          <div class=\"data-grid-header\" data-field=\"population\" data-type=\"number\" data-width=\"9rem\" data-sort=\"desc\"\n            >Population</div\n          >\n        </div>\n      </div>\n      <div class=\"data-grid-body\"></div>\n    </div>\n  </div>\n</template>\n","individual":false},{"label":"Loading and empty","html":"<div class=\"flex flex-wrap gap-4\">\n  <div class=\"data-grid\" aria-label=\"Waiting for data\" style=\"height: 11rem; flex: 1; min-width: 14rem\">\n    <div class=\"data-grid-viewport\">\n      <div class=\"data-grid-head\">\n        <div class=\"data-grid-row\">\n          <div class=\"data-grid-header\" data-field=\"name\" data-width=\"minmax(8rem, 1fr)\">Name</div>\n        </div>\n      </div>\n      <div class=\"data-grid-body\"></div>\n    </div>\n  </div>\n  <div\n    class=\"data-grid\"\n    id=\"dg-empty\"\n    aria-label=\"No matches\"\n    data-empty-text=\"Nothing matches 'zebra'.\"\n    style=\"height: 11rem; flex: 1; min-width: 14rem\"\n  >\n    <div class=\"data-grid-viewport\">\n      <div class=\"data-grid-head\">\n        <div class=\"data-grid-row\">\n          <div class=\"data-grid-header\" data-field=\"name\" data-width=\"minmax(8rem, 1fr)\">Name</div>\n        </div>\n      </div>\n      <div class=\"data-grid-body\"></div>\n    </div>\n  </div>\n</div>\n","individual":false}]
