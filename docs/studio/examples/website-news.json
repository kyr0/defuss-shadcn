[{"label":"A news front","html":"<div style=\"display: flex; flex-direction: column; gap: 1.5rem; width: 100%\">\n  <header class=\"mk-news-header\" data-variant=\"masthead\">\n    <div class=\"mk-news-header-top\">\n      <span class=\"mk-news-header-kicker\">Vol. 12 · No. 274</span>\n      <time class=\"mk-news-header-date\" datetime=\"2026-10-01\">Thursday, 1 October 2026</time>\n    </div>\n    <h1 class=\"mk-news-header-title\">The Acme Times</h1>\n    <nav class=\"mk-news-header-topics\" aria-label=\"Sections\">\n      <a href=\"#\" aria-current=\"page\">Front page</a>\n      <a href=\"#\">Product</a>\n      <a href=\"#\">Company</a>\n      <a href=\"#\">Engineering</a>\n    </nav>\n  </header>\n  <section class=\"mk-news-ticker\" data-variant=\"breaking\" aria-label=\"Breaking news\">\n    <span class=\"mk-news-ticker-label\">Breaking</span>\n    <div class=\"mk-news-ticker-viewport\">\n      <div class=\"mk-news-ticker-track\">\n        <ul class=\"mk-news-ticker-items\">\n          <li\n            ><a href=\"#\"><time>09:41</time> Acme 4.0 ships with offline sync</a></li\n          >\n          <li\n            ><a href=\"#\"><time>09:12</time> Shared spaces open to every team</a></li\n          >\n          <li\n            ><a href=\"#\"><time>08:30</time> Passkeys become the default sign-in</a></li\n          >\n        </ul>\n        <ul class=\"mk-news-ticker-items\" aria-hidden=\"true\" inert>\n          <li\n            ><a href=\"#\"><time>09:41</time> Acme 4.0 ships with offline sync</a></li\n          >\n          <li\n            ><a href=\"#\"><time>09:12</time> Shared spaces open to every team</a></li\n          >\n          <li\n            ><a href=\"#\"><time>08:30</time> Passkeys become the default sign-in</a></li\n          >\n        </ul>\n      </div>\n    </div>\n  </section>\n  <div\n    style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 2rem; align-items: start\"\n  >\n    <article class=\"mk-news-item\" data-variant=\"lead\">\n      <div class=\"mk-news-item-body\">\n        <div class=\"mk-news-item-meta\">\n          <span class=\"mk-news-item-category\">Product</span>\n          <time datetime=\"2026-10-01\">1 Oct 2026</time>\n        </div>\n        <h3 class=\"mk-news-item-title\"><a href=\"#\">Acme 4.0: the calmest release we have ever shipped</a></h3>\n        <p class=\"mk-news-item-summary\"\n          >Offline sync, a faster editor and shared spaces for small teams: what is new in the biggest release since\n          launch.</p\n        >\n      </div>\n      <figure class=\"mk-news-item-media\"><img src=\"images/mk-wide3.png\" alt=\"The new shared spaces view\" /></figure>\n    </article>\n    <section aria-labelledby=\"latest-title\">\n      <h2\n        id=\"latest-title\"\n        style=\"margin: 0 0 0.25rem; font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase\"\n        >Latest</h2\n      >\n      <article class=\"mk-news-item\" data-variant=\"compact\">\n        <div class=\"mk-news-item-body\">\n          <div class=\"mk-news-item-meta\">\n            <span class=\"mk-news-item-category\">Product</span>\n            <time datetime=\"2026-10-01T09:41\">09:41</time>\n          </div>\n          <h3 class=\"mk-news-item-title\"><a href=\"#\">Offline sync rolls out to every workspace</a></h3>\n        </div>\n      </article>\n      <article class=\"mk-news-item\" data-variant=\"compact\">\n        <div class=\"mk-news-item-body\">\n          <div class=\"mk-news-item-meta\">\n            <span class=\"mk-news-item-category\">Company</span>\n            <time datetime=\"2026-10-01T08:15\">08:15</time>\n          </div>\n          <h3 class=\"mk-news-item-title\"><a href=\"#\">Acme opens an office in Lisbon</a></h3>\n        </div>\n      </article>\n      <article class=\"mk-news-item\" data-variant=\"compact\">\n        <div class=\"mk-news-item-body\">\n          <div class=\"mk-news-item-meta\">\n            <span class=\"mk-news-item-category\">Security</span>\n            <time datetime=\"2026-09-30\">Yesterday</time>\n          </div>\n          <h3 class=\"mk-news-item-title\"><a href=\"#\">Passkeys are now the default sign-in</a></h3>\n        </div>\n      </article>\n      <article class=\"mk-news-item\" data-variant=\"compact\">\n        <div class=\"mk-news-item-body\">\n          <div class=\"mk-news-item-meta\">\n            <span class=\"mk-news-item-category\">Engineering</span>\n            <time datetime=\"2026-09-30\">Yesterday</time>\n          </div>\n          <h3 class=\"mk-news-item-title\"><a href=\"#\">Status: eu-west sync delays resolved</a></h3>\n        </div>\n      </article>\n    </section>\n  </div>\n  <div>\n    <article class=\"mk-news-item\">\n      <div class=\"mk-news-item-body\">\n        <div class=\"mk-news-item-meta\">\n          <span class=\"mk-news-item-category\">Company</span>\n          <time datetime=\"2026-09-28\">28 Sep 2026</time>\n        </div>\n        <h3 class=\"mk-news-item-title\"><a href=\"#\">A million weekly users, still forty people</a></h3>\n        <p class=\"mk-news-item-summary\"\n          >The company crossed a million weekly users this summer - and kept its team at forty people.</p\n        >\n      </div>\n      <figure class=\"mk-news-item-media\"><img src=\"images/mk-wide2.png\" alt=\"The Acme team at their offsite\" /></figure>\n    </article>\n    <article class=\"mk-news-item\">\n      <div class=\"mk-news-item-body\">\n        <div class=\"mk-news-item-meta\">\n          <span class=\"mk-news-item-category\">Engineering</span>\n          <time datetime=\"2026-09-27\">27 Sep 2026</time>\n        </div>\n        <h3 class=\"mk-news-item-title\"><a href=\"#\">What Tuesday's outage taught us</a></h3>\n        <p class=\"mk-news-item-summary\">A post-mortem of Tuesday's 42-minute outage and the three changes it led to.</p>\n      </div>\n      <figure class=\"mk-news-item-media\"\n        ><img src=\"images/mk-wide.png\" alt=\"A whiteboard with the incident timeline\"\n      /></figure>\n    </article>\n  </div>\n</div>\n","individual":false}]
