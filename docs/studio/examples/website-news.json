[{"label":"A news front","html":"<div id=\"site-news\" data-i18n-component style=\"display: flex; flex-direction: column; gap: 1.5rem; width: 100%\">\n  <div class=\"flex justify-end\">\n    <select\n      class=\"select\"\n      data-size=\"sm\"\n      data-app-locale\n      aria-label=\"Language\"\n      data-i18n-aria-label-en=\"Language\"\n      data-i18n-aria-label-de=\"Sprache\"\n      style=\"width: auto\"\n    >\n      <option value=\"en\" lang=\"en\">English</option>\n      <option value=\"de\" lang=\"de\">Deutsch</option>\n    </select>\n  </div>\n  <header class=\"mk-news-header\" data-variant=\"masthead\">\n    <div class=\"mk-news-header-top\">\n      <span class=\"mk-news-header-kicker\" data-i18n-target=\"kicker\">Vol. 12 · No. 274</span>\n      <time class=\"mk-news-header-date\" datetime=\"2026-10-01\" data-i18n-target=\"today\"\n        ><span data-i18n-value=\"today\">Thursday, 1 October 2026</span></time\n      >\n    </div>\n    <h1 class=\"mk-news-header-title\">The Acme Times</h1>\n    <nav\n      class=\"mk-news-header-topics\"\n      aria-label=\"Sections\"\n      data-i18n-aria-label-en=\"Sections\"\n      data-i18n-aria-label-de=\"Ressorts\"\n    >\n      <a href=\"#/\" data-router-link aria-current=\"page\"><span data-i18n-target=\"nav-front\">Front page</span></a>\n      <a href=\"#/section/product\" data-router-link><span data-i18n-target=\"nav-product\">Product</span></a>\n      <a href=\"#/section/company\" data-router-link><span data-i18n-target=\"nav-company\">Company</span></a>\n      <a href=\"#/section/engineering\" data-router-link><span data-i18n-target=\"nav-engineering\">Engineering</span></a>\n    </nav>\n  </header>\n  <section\n    class=\"mk-news-ticker\"\n    data-variant=\"breaking\"\n    aria-label=\"Breaking news\"\n    data-i18n-aria-label-en=\"Breaking news\"\n    data-i18n-aria-label-de=\"Eilmeldungen\"\n  >\n    <span class=\"mk-news-ticker-label\" data-i18n-target=\"breaking\">Breaking</span>\n    <div class=\"mk-news-ticker-viewport\">\n      <div class=\"mk-news-ticker-track\">\n        <ul class=\"mk-news-ticker-items\">\n          <li\n            ><a href=\"#\"><time>09:41</time> Acme 4.0 ships with offline sync</a></li\n          >\n          <li\n            ><a href=\"#\"><time>09:12</time> Shared spaces open to every team</a></li\n          >\n          <li\n            ><a href=\"#\"><time>08:30</time> Passkeys become the default sign-in</a></li\n          >\n        </ul>\n        <ul class=\"mk-news-ticker-items\" aria-hidden=\"true\" inert>\n          <li\n            ><a href=\"#\"><time>09:41</time> Acme 4.0 ships with offline sync</a></li\n          >\n          <li\n            ><a href=\"#\"><time>09:12</time> Shared spaces open to every team</a></li\n          >\n          <li\n            ><a href=\"#\"><time>08:30</time> Passkeys become the default sign-in</a></li\n          >\n        </ul>\n      </div>\n    </div>\n  </section>\n  <div\n    style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 2rem; align-items: start\"\n  >\n    <article class=\"mk-news-item\" data-topic=\"product\" data-variant=\"lead\">\n      <div class=\"mk-news-item-body\">\n        <div class=\"mk-news-item-meta\">\n          <span class=\"mk-news-item-category\" data-i18n-target=\"story-1-cat\">Product</span>\n          <time datetime=\"2026-10-01\" data-i18n-target=\"story-1-date\"\n            ><span data-i18n-value=\"d1001\">1 Oct 2026</span></time\n          >\n        </div>\n        <h3 class=\"mk-news-item-title\"><a href=\"#\">Acme 4.0: the calmest release we have ever shipped</a></h3>\n        <p class=\"mk-news-item-summary\"\n          >Offline sync, a faster editor and shared spaces for small teams: what is new in the biggest release since\n          launch.</p\n        >\n      </div>\n      <figure class=\"mk-news-item-media\"><img src=\"images/mk-wide3.png\" alt=\"The new shared spaces view\" /></figure>\n    </article>\n    <section aria-labelledby=\"latest-title\">\n      <h2\n        id=\"latest-title\"\n        style=\"margin: 0 0 0.25rem; font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase\"\n        data-i18n-target=\"latest\"\n        >Latest</h2\n      >\n      <article class=\"mk-news-item\" data-topic=\"product\" data-variant=\"compact\">\n        <div class=\"mk-news-item-body\">\n          <div class=\"mk-news-item-meta\">\n            <span class=\"mk-news-item-category\" data-i18n-target=\"story-2-cat\">Product</span>\n            <time datetime=\"2026-10-01T09:41\">09:41</time>\n          </div>\n          <h3 class=\"mk-news-item-title\"><a href=\"#\">Offline sync rolls out to every workspace</a></h3>\n        </div>\n      </article>\n      <article class=\"mk-news-item\" data-topic=\"company\" data-variant=\"compact\">\n        <div class=\"mk-news-item-body\">\n          <div class=\"mk-news-item-meta\">\n            <span class=\"mk-news-item-category\" data-i18n-target=\"story-3-cat\">Company</span>\n            <time datetime=\"2026-10-01T08:15\">08:15</time>\n          </div>\n          <h3 class=\"mk-news-item-title\"><a href=\"#\">Acme opens an office in Lisbon</a></h3>\n        </div>\n      </article>\n      <article class=\"mk-news-item\" data-topic=\"security\" data-variant=\"compact\">\n        <div class=\"mk-news-item-body\">\n          <div class=\"mk-news-item-meta\">\n            <span class=\"mk-news-item-category\" data-i18n-target=\"story-4-cat\">Security</span>\n            <time datetime=\"2026-09-30\" data-i18n-target=\"story-4-when\">Yesterday</time>\n          </div>\n          <h3 class=\"mk-news-item-title\"><a href=\"#\">Passkeys are now the default sign-in</a></h3>\n        </div>\n      </article>\n      <article class=\"mk-news-item\" data-topic=\"engineering\" data-variant=\"compact\">\n        <div class=\"mk-news-item-body\">\n          <div class=\"mk-news-item-meta\">\n            <span class=\"mk-news-item-category\" data-i18n-target=\"story-5-cat\">Engineering</span>\n            <time datetime=\"2026-09-30\" data-i18n-target=\"story-5-when\">Yesterday</time>\n          </div>\n          <h3 class=\"mk-news-item-title\"><a href=\"#\">Status: eu-west sync delays resolved</a></h3>\n        </div>\n      </article>\n    </section>\n  </div>\n  <div>\n    <article class=\"mk-news-item\" data-topic=\"company\">\n      <div class=\"mk-news-item-body\">\n        <div class=\"mk-news-item-meta\">\n          <span class=\"mk-news-item-category\" data-i18n-target=\"story-6-cat\">Company</span>\n          <time datetime=\"2026-09-28\" data-i18n-target=\"story-6-date\"\n            ><span data-i18n-value=\"d0928\">28 Sep 2026</span></time\n          >\n        </div>\n        <h3 class=\"mk-news-item-title\"><a href=\"#\">A million weekly users, still forty people</a></h3>\n        <p class=\"mk-news-item-summary\"\n          >The company crossed a million weekly users this summer - and kept its team at forty people.</p\n        >\n      </div>\n      <figure class=\"mk-news-item-media\"><img src=\"images/mk-wide2.png\" alt=\"The Acme team at their offsite\" /></figure>\n    </article>\n    <article class=\"mk-news-item\" data-topic=\"engineering\">\n      <div class=\"mk-news-item-body\">\n        <div class=\"mk-news-item-meta\">\n          <span class=\"mk-news-item-category\" data-i18n-target=\"story-7-cat\">Engineering</span>\n          <time datetime=\"2026-09-27\" data-i18n-target=\"story-7-date\"\n            ><span data-i18n-value=\"d0927\">27 Sep 2026</span></time\n          >\n        </div>\n        <h3 class=\"mk-news-item-title\"><a href=\"#\">What Tuesday's outage taught us</a></h3>\n        <p class=\"mk-news-item-summary\">A post-mortem of Tuesday's 42-minute outage and the three changes it led to.</p>\n      </div>\n      <figure class=\"mk-news-item-media\"\n        ><img src=\"images/mk-wide.png\" alt=\"A whiteboard with the incident timeline\"\n      /></figure>\n   