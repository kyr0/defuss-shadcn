[{"label":"In / out, directions and lifecycle","html":"<style>\n  #anim-wipe-target {\n    width: 160px;\n    height: 100px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    background: var(--card);\n    color: var(--card-foreground);\n    font-weight: 600;\n  }\n</style>\n<div id=\"anim-wipe-target\">Wipe</div>\n<div style=\"display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-top: 0.75rem\">\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-wipe-in\">In</button>\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-wipe-out\">Out</button>\n  <span\n    id=\"anim-wipe-dirs\"\n    role=\"group\"\n    aria-label=\"Direction\"\n    style=\"display: inline-flex; gap: 0.25rem; margin-inline: 0.5rem\"\n  >\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-dir=\"north\" aria-pressed=\"false\">N</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-dir=\"south\" aria-pressed=\"false\">S</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-dir=\"west\" aria-pressed=\"true\">W</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-dir=\"east\" aria-pressed=\"false\">E</button>\n  </span>\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-wipe-pause\">Pause</button>\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-wipe-resume\">Resume</button>\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-wipe-finish\">Finish</button>\n  <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-wipe-reset\">Reset</button>\n  <input\n    class=\"input\"\n    id=\"anim-wipe-duration\"\n    type=\"number\"\n    min=\"50\"\n    step=\"50\"\n    value=\"1500\"\n    aria-label=\"Duration in milliseconds\"\n    style=\"width: 6rem\"\n  />\n  <select class=\"select\" id=\"anim-wipe-easing\" aria-label=\"Easing\">\n    <option value=\"cubic-bezier(0.16, 1, 0.3, 1)\" selected>default ease-out</option>\n    <option value=\"ease\">ease</option>\n    <option value=\"ease-in-out\">ease-in-out</option>\n    <option value=\"linear\">linear</option>\n    <option value=\"cubic-bezier(0.34, 1.56, 0.64, 1)\">spring</option>\n  </select>\n</div>\n","individual":false},{"label":"Scroll-driven wipe","html":"<div\n  id=\"anim-wipe-scroller\"\n  style=\"\n    height: 220px;\n    overflow-y: auto;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    padding: 1rem;\n  \"\n>\n  <div style=\"height: 600px; display: flex; align-items: flex-start; color: var(--muted-foreground); font-size: 0.85rem\"\n    >Scroll down - the reveal below is scrubbed by this box's scroll position ↓</div\n  >\n  <div\n    id=\"anim-wipe-scroll-target\"\n    style=\"\n      width: 160px;\n      height: 100px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      border: 1px solid var(--border);\n      border-radius: var(--radius-lg);\n      background: var(--card);\n      color: var(--card-foreground);\n      font-weight: 600;\n    \"\n    >Wipe</div\n  >\n  <div style=\"height: 80px\"></div>\n</div>\n","individual":false}]
