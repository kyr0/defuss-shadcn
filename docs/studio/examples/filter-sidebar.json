[{"label":"Default","html":"<aside class=\"mk-filter-sidebar\" aria-labelledby=\"fs-title\">\n  <form action=\"#\" method=\"get\">\n    <div class=\"mk-filter-sidebar-head\"><h2 id=\"fs-title\">Filters</h2><a href=\"#\">Clear all</a></div>\n    <details class=\"mk-filter-sidebar-group\" open\n      ><summary>Category</summary\n      ><div\n        ><fieldset\n          ><legend>Category</legend>\n          <label class=\"mk-filter-sidebar-option\"\n            ><input class=\"checkbox\" type=\"checkbox\" name=\"cat\" value=\"shirts\" checked />Shirts<small>24</small></label\n          >\n          <label class=\"mk-filter-sidebar-option\"\n            ><input class=\"checkbox\" type=\"checkbox\" name=\"cat\" value=\"knitwear\" />Knitwear<small>18</small></label\n          >\n          <label class=\"mk-filter-sidebar-option\"\n            ><input class=\"checkbox\" type=\"checkbox\" name=\"cat\" value=\"trousers\" />Trousers<small>12</small></label\n          >\n          <label class=\"mk-filter-sidebar-option\"\n            ><input class=\"checkbox\" type=\"checkbox\" name=\"cat\" value=\"accessories\" />Accessories<small>9</small></label\n          >\n        </fieldset></div\n      ></details\n    >\n    <details class=\"mk-filter-sidebar-group\" open\n      ><summary>Price</summary\n      ><div\n        ><div class=\"mk-filter-sidebar-range\"\n          ><label class=\"sr-only\" for=\"fs-min\">Minimum price</label\n          ><input class=\"input\" id=\"fs-min\" name=\"min\" inputmode=\"numeric\" placeholder=\"€ min\" /><span>–</span\n          ><label class=\"sr-only\" for=\"fs-max\">Maximum price</label\n          ><input class=\"input\" id=\"fs-max\" name=\"max\" inputmode=\"numeric\" placeholder=\"€ max\" /></div></div\n    ></details>\n    <details class=\"mk-filter-sidebar-group\" open\n      ><summary>Color</summary\n      ><div\n        ><fieldset\n          ><legend>Color</legend\n          ><div class=\"mk-filter-sidebar-swatches\"\n            ><label class=\"mk-filter-sidebar-swatch\" style=\"--mk-swatch: #d8c9a9\"\n              ><input type=\"checkbox\" name=\"color\" value=\"sand\" checked /><span class=\"sr-only\">Sand</span></label\n            ><label class=\"mk-filter-sidebar-swatch\" style=\"--mk-swatch: #2f3b4a\"\n              ><input type=\"checkbox\" name=\"color\" value=\"navy\" /><span class=\"sr-only\">Navy</span></label\n            ><label class=\"mk-filter-sidebar-swatch\" style=\"--mk-swatch: #f2efe8\"\n              ><input type=\"checkbox\" name=\"color\" value=\"off-white\" /><span class=\"sr-only\">Off-white</span></label\n            ><label class=\"mk-filter-sidebar-swatch\" style=\"--mk-swatch: #5a6b5d\"\n              ><input type=\"checkbox\" name=\"color\" value=\"moss\" /><span class=\"sr-only\">Moss</span></label\n            ><label class=\"mk-filter-sidebar-swatch\" style=\"--mk-swatch: #8c3b2f\"\n              ><input type=\"checkbox\" name=\"color\" value=\"rust\" /><span class=\"sr-only\">Rust</span></label\n            ></div\n          ></fieldset\n        ></div\n      ></details\n    >\n    <details class=\"mk-filter-sidebar-group\"\n      ><summary>Rating</summary\n      ><div\n        ><fieldset\n          ><legend>Minimum rating</legend>\n          <label class=\"mk-filter-sidebar-option\"\n            ><input class=\"radio\" type=\"radio\" name=\"rating\" value=\"4\" /><span\n              class=\"mk-filter-sidebar-stars\"\n              aria-hidden=\"true\"\n              >★★★★☆</span\n            >4 & up</label\n          >\n          <label class=\"mk-filter-sidebar-option\"\n            ><input class=\"radio\" type=\"radio\" name=\"rating\" value=\"3\" /><span\n              class=\"mk-filter-sidebar-stars\"\n              aria-hidden=\"true\"\n              >★★★☆☆</span\n            >3 & up</label\n          >\n        </fieldset></div\n      ></details\n    >\n    <div class=\"mk-filter-sidebar-group\"\n      ><label class=\"mk-filter-sidebar-option\" for=\"fs-stock\"\n        >In stock only<input\n          class=\"switch\"\n          type=\"checkbox\"\n          role=\"switch\"\n          id=\"fs-stock\"\n          name=\"stock\"\n          style=\"margin-inline-start: auto\"\n          checked /></label\n    ></div>\n    <button class=\"btn mk-filter-sidebar-apply\" type=\"submit\">Show 24 products</button>\n  </form>\n</aside>\n","individual":true}]
