[{"label":"111,110 nodes","html":"<div class=\"flex flex-col gap-3\">\n  <div class=\"flex flex-wrap gap-2\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"tg-open\">Expand all</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"tg-close\">Collapse all</button>\n  </div>\n  <div\n    class=\"data-grid\"\n    id=\"tg-geo\"\n    aria-label=\"Regions\"\n    data-parent-field=\"parentId\"\n    data-select=\"single\"\n    data-empty-text=\"No place matches.\"\n    style=\"height: 26rem\"\n  >\n    <div class=\"data-grid-viewport\">\n      <div class=\"data-grid-head\">\n        <div class=\"data-grid-row\">\n          <div class=\"data-grid-header\" data-field=\"name\" data-width=\"18rem\" data-filter=\"text\" data-locked>Name</div>\n          <div\n            class=\"data-grid-header\"\n            data-field=\"kind\"\n            data-width=\"7rem\"\n            data-filter=\"select\"\n            data-options=\"region,country,city,district\"\n            >Kind</div\n          >\n          <div\n            class=\"data-grid-header\"\n            data-field=\"population\"\n            data-type=\"number\"\n            data-width=\"9rem\"\n            data-filter=\"number\"\n            >Population</div\n          >\n          <div class=\"data-grid-header\" data-field=\"area\" data-type=\"number\" data-width=\"8rem\">Area km²</div>\n          <div class=\"data-grid-header\" data-field=\"growth\" data-type=\"number\" data-format=\"percent\" data-width=\"7rem\"\n            >Growth</div\n          >\n        </div>\n      </div>\n      <div class=\"data-grid-body\"></div>\n    </div>\n  </div>\n</div>\n","individual":false},{"label":"Checkbox selection","html":"<div\n  class=\"data-grid\"\n  id=\"tg-checks\"\n  aria-label=\"Project plan\"\n  data-parent-field=\"parentId\"\n  data-select=\"multiple\"\n  data-select-model=\"checkbox\"\n  data-persist=\"none\"\n  style=\"height: 20rem\"\n>\n  <div class=\"data-grid-viewport\">\n    <div class=\"data-grid-head\">\n      <div class=\"data-grid-row\">\n        <div class=\"data-grid-header\" data-field=\"name\" data-width=\"minmax(11rem, 1fr)\">Task</div>\n        <div class=\"data-grid-header\" data-field=\"owner\" data-width=\"7rem\">Owner</div>\n        <div class=\"data-grid-header\" data-field=\"days\" data-type=\"number\" data-format=\"\" data-width=\"5rem\">Days</div>\n      </div>\n    </div>\n    <div class=\"data-grid-body\"></div>\n  </div>\n</div>\n<p class=\"text-sm\" style=\"margin-block-start: 0.5rem\"><output id=\"tg-checks-log\">Nothing is selected.</output></p>\n","individual":false},{"label":"Checkboxes and drag into a branch","html":"<div class=\"grid gap-3\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"data-grid\"\n    id=\"tg-files\"\n    aria-label=\"Files\"\n    data-parent-field=\"parentId\"\n    data-select=\"multiple\"\n    data-select-model=\"checkbox\"\n    data-drag\n    data-drop\n    data-persist=\"none\"\n    style=\"height: 20rem\"\n  >\n    <div class=\"data-grid-viewport\">\n      <div class=\"data-grid-head\">\n        <div class=\"data-grid-row\">\n          <div class=\"data-grid-header\" data-field=\"name\" data-width=\"minmax(10rem, 1fr)\">Name</div>\n          <div class=\"data-grid-header\" data-field=\"size\" data-type=\"number\" data-width=\"5.5rem\">KB</div>\n        </div>\n      </div>\n      <div class=\"data-grid-body\"></div>\n    </div>\n  </div>\n  <div\n    class=\"data-tree\"\n    id=\"tg-archive\"\n    aria-label=\"Archive\"\n    data-drag\n    data-drop\n    data-persist=\"none\"\n    style=\"height: 20rem\"\n  ></div>\n</div>\n","individual":false},{"label":"Paged tree","html":"<div\n  class=\"data-grid\"\n  id=\"tg-pages\"\n  aria-label=\"Departments\"\n  data-parent-field=\"parentId\"\n  data-paging=\"pages\"\n  data-page-size=\"15\"\n  style=\"height: 24rem; max-width: 40rem\"\n>\n  <div class=\"data-grid-viewport\">\n    <div class=\"data-grid-head\">\n      <div class=\"data-grid-row\">\n        <div class=\"data-grid-header\" data-field=\"name\" data-width=\"minmax(14rem, 1fr)\" data-filter=\"text\">Team</div>\n        <div class=\"data-grid-header\" data-field=\"headcount\" data-type=\"number\" data-width=\"7rem\">People</div>\n        <div\n          class=\"data-grid-header\"\n          data-field=\"budget\"\n          data-type=\"number\"\n          data-format=\"currency:EUR\"\n          data-width=\"9rem\"\n          >Budget</div\n        >\n      </div>\n    </div>\n    <div class=\"data-grid-body\"></div>\n  </div>\n</div>\n","individual":false},{"label":"Totals per branch: an aggregated tree","html":"<div class=\"flex flex-col gap-2\" style=\"max-width: 48rem\">\n  <div class=\"flex flex-wrap items-center gap-2\">\n    <label class=\"label\" for=\"tg-sales-year\">Year</label>\n    <select class=\"select w-auto\" id=\"tg-sales-year\">\n      <option value=\"\" selected>All years</option>\n      <option value=\"2024\">2024</option>\n      <option value=\"2025\">2025</option>\n    </select>\n    <output class=\"text-sm text-muted-foreground\" id=\"tg-sales-line\" aria-live=\"polite\"\n      >Aggregating 200,000 sales…</output\n    >\n  </div>\n  <div class=\"data-grid\" id=\"tg-sales\" aria-label=\"Sales by region\" data-parent-field=\"parentId\" style=\"height: 22rem\">\n    <div class=\"data-grid-viewport\">\n      <div class=\"data-grid-head\">\n        <div class=\"data-grid-row\">\n          <div class=\"data-grid-header\" data-field=\"name\" data-width=\"minmax(12rem, 1fr)\" data-filter=\"text\"\n            >Market</div\n          >\n          <div class=\"data-grid-header\" data-field=\"orders\" data-type=\"number\" data-width=\"6rem\">Orders</div>\n          <div class=\"data-grid-header\" data-field=\"units\" data-type=\"number\" data-width=\"6rem\">Units</div>\n          <div\n            class=\"data-grid-header\"\n            data-field=\"revenue\"\n            data-type=\"number\"\n            data-format=\"currency:EUR\"\n            data-width=\"9rem\"\n            data-sort=\"desc\"\n            >Revenue</div\n          >\n          <div\n            class=\"data-grid-header\"\n            data-field=\"average\"\n            data-type=\"number\"\n            data-format=\"currency:EUR\"\n            data-width=\"7rem\"\n            >Avg order</div\n          >\n          <div class=\"data-grid-header\" data-field=\"returns\" data-type=\"number\" data-width=\"6rem\">Returns</div>\n        </div>\n      </div>\n      <div class=\"data-grid-body\"></div>\n    </div>\n  </div>\n</div>\n","individual":false},{"label":"Driven through the store","html":"<div class=\"flex flex-col gap-3\" style=\"max-width: 36rem\">\n  <div class=\"flex flex-wrap gap-2\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" data-open=\"src\">Open src</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" data-open=\"src,src/components\"\n      >Open src/components</button\n    >\n    <button class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" type=\"button\" data-open=\"\">Close all</button>\n  </div>\n  <div class=\"data-grid\" id=\"tg-files\" aria-label=\"Repository\" data-parent-field=\"parentId\" style=\"height: 16rem\">\n    <div class=\"data-grid-viewport\">\n      <div class=\"data-grid-head\">\n        <div class=\"data-grid-row\">\n          <div class=\"data-grid-header\" data-field=\"name\" data-width=\"minmax(12rem, 1fr)\">Path</div>\n          <div class=\"data-grid-header\" data-field=\"size\" data-type=\"number\" data-width=\"7rem\">Bytes</div>\n        </div>\n      </div>\n      <div class=\"data-grid-body\"></div>\n    </div>\n  </div>\n  <p class=\"text-sm text-muted-foreground m-0\" id=\"tg-files-open\" aria-live=\"polite\"></p>\n</div>\n","individual":false}]
