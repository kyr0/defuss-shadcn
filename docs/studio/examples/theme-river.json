[{"label":"Aurora Gradient","html":"<section\n  class=\"presentation\"\n  id=\"deck-river\"\n  data-anim-in=\"blurIn\"\n  data-anim-out=\"fadeOut\"\n  style=\"\n    --presentation-ink: #071a28;\n    --presentation-ink-foreground: #e8fbff;\n    --presentation-paper: #e6fbf5;\n    --presentation-paper-foreground: #071a28;\n    --presentation-accent: #5af2c8;\n    font-family: Inter, system-ui, sans-serif;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"What a library lends - three years of loans by format\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Monthly library loans by format from January 2023 to December 2025 as a theme river: print shrinks from 612 to 541 thousand a year while audiobooks grow from 74 to 182 thousand; then yearly totals and growth per format\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Cover\">\n    <div\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        inset: 0;\n        background:\n          radial-gradient(circle at 18% 0, rgba(90, 242, 200, 0.2), transparent 38%),\n          radial-gradient(circle at 85% 100%, rgba(185, 131, 255, 0.22), transparent 40%);\n      \"\n    ></div>\n    <svg\n      aria-hidden=\"true\"\n      width=\"1600\"\n      height=\"420\"\n      viewBox=\"0 0 1600 420\"\n      style=\"position: absolute; left: 0; bottom: 0\"\n    >\n      <path\n        d=\"M0 250 C 260 170, 460 330, 760 250 S 1260 150, 1600 230 L1600 420 L0 420 Z\"\n        fill=\"rgba(91,140,255,.16)\"\n      />\n      <path\n        d=\"M0 300 C 300 240, 520 360, 820 300 S 1300 230, 1600 290 L1600 420 L0 420 Z\"\n        fill=\"rgba(90,242,200,.16)\"\n      />\n      <path\n        d=\"M0 350 C 280 320, 560 400, 860 350 S 1320 310, 1600 345 L1600 420 L0 420 Z\"\n        fill=\"rgba(246,211,101,.16)\"\n      />\n    </svg>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\">Theme river · Aurora Gradient</p>\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        position: relative;\n        max-width: 1250px;\n        font-family: Inter, system-ui, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.03em;\n        font-size: 7rem;\n        max-width: 1000px;\n        line-height: 0.92;\n      \"\n      ><span\n        style=\"\n          background: linear-gradient(90deg, #5af2c8, #5b8cff, #b983ff);\n          -webkit-background-clip: text;\n          background-clip: text;\n          color: transparent;\n        \"\n        >What a library lends</span\n      ></h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >2.8 million loans in three years - and the mix is flowing away from paper.</p\n    >\n    <p class=\"presentation-note\">The three currents on the cover are the three formats that grow.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"river\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"All formats\"\n  >\n    <header class=\"presentation-header\"><span>Loans</span><span>Loans per month, 2023–2025</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Inter, system-ui, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.03em;\n      \"\n      >Four formats, one river</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Stream width = loans that month; the river’s total width is the whole library.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"audio\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Audiobooks\"\n  >\n    <header class=\"presentation-header\"><span>Loans</span><span>Audiobooks highlighted</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Inter, system-ui, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.03em;\n      \"\n      >The audiobook stream more than doubled</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The other streams dim - watch the gold one widen every summer.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"yearly\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Per year\"\n  >\n    <header class=\"presentation-header\"><span>Totals</span><span>Loans per year, thousands</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Inter, system-ui, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.03em;\n      \"\n      >Total loans still rise - by 12%</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The river collapses into three yearly stacks.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Three numbers for the library board</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: Inter, system-ui, sans-serif;\n            font-weight: 700;\n            letter-spacing: -0.03em;\n          \"\n          ><span data-count=\"998\">998</span> k</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\"\n          >loans in 2025 - the first year near a million</p\n        >\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #f6d365;\n            font-family: Inter, system-ui, sans-serif;\n            font-weight: 700;\n            letter-spacing: -0.03em;\n          \"\n          >+<span data-count=\"146\">146</span>%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">audiobook loans since 2023</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: Inter, system-ui, sans-serif;\n            font-weight: 700;\n            letter-spacing: -0.03em;\n          \"\n          ><span data-count=\"18\">18</span>%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\"\n          >of all loans are now audiobooks (8% in 2023)</p\n        >\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >Print is still the widest stream - but it is the only one that thins.</p\n    >\n    <p class=\"presentation-note\">Growth and share tell the same story from two sides.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Listening\" style=\"overflow: hidden\">\n    <video\n      autoplay\n      muted\n      loop\n      playsinline\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n        opacity: 0.55;\n        mix-blend-mode: screen;\n      \"\n    >\n      <source src=\"videos/demo.webm\" type=\"video/webm\" />\n      <source src=\"videos/demo.mp4\" type=\"video/mp4\" />\n    </video>\n    <div\n      aria-hidden=\"true\"\n      style=\"position: absolute; inset: 0; background: linear-gradient(90deg, #071a28 38%, rgba(90, 242, 200, 0.14))\"\n    ></div>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\">The summer peak</p>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"blur\"\n      style=\"\n        position: relative;\n        font-size: 5rem;\n        max-width: 1100px;\n        font-family: Inter, system-ui, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.03em;\n      \"\n      >Listening follows the holidays</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 400ms; position: relative; max-width: 900px\"\n      >Audiobook loans peak every July and August - commutes end, road trips begin.</p\n    >\n    <p class=\"presentation-note\">Ambient loop between the chart states.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"north\"\n    data-anim-in-blocks=\"6\"\n    data-anim-in-color=\"#B983FF\"\n    aria-label=\"Loans table\"\n  >\n    <header class=\"presentation-header\"><span>Loans</span><span>Thousands of loans per year</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" data-density=\"spacious\" style=\"font-size: 1.7rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Loans by format at a city library, 2023–2025 (synthetic).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Format</th><th class=\"table-head\" style=\"text-align: right\">2023</th\n            ><th class=\"table-head\" style=\"text-align: right\">2024</th\n            ><th class=\"table-head\" style=\"text-align: right\">2025</th\n            ><th class=\"table-head\" style=\"text-align: right\">Change</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Print</td><td class=\"table-cell\" style=\"text-align: right\">612</td\n            ><td class=\"table-cell\" style=\"text-align: right\">574</td\n            ><td class=\"table-cell\" style=\"text-align: right\">541</td\n            ><td class=\"table-cell\" style=\"text-align: right\">−12%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">E-books</td><td class=\"table-cell\" style=\"text-align: right\">188</td\n            ><td class=\"table-cell\" style=\"text-align: right\">214</td\n            ><td class=\"table-cell\" style=\"text-align: right\">236</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+26%</td></tr\n          >\n          <tr class=\"table-row\" style=\"font-weight: 700\"\n            ><td class=\"table-cell\">Audiobooks</td><td class=\"table-cell\" style=\"text-align: right\">74</td\n            ><td class=\"table-cell\" style=\"text-align: right\">121</td\n            ><td class=\"table-cell\" style=\"text-align: right\">182</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+146%</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Board games</td><td class=\"table-cell\" style=\"text-align: right\">18</td\n            ><td class=\"table-cell\" style=\"text-align: right\">27</td\n            ><td class=\"table-cell\" style=\"text-align: right\">39</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+117%</td></tr\n          >\n        </tbody>\n        <tfoot>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Total</td><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">892</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">936</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">998</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">+12%</td></tr\n          >\n        </tfoot>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Every digital format grows; the total grows with them.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"\n          font-size: 3.3rem;\n          line-height: 1.22;\n          font-family: Inter, system-ui, sans-serif;\n          font-weight: 700;\n          letter-spacing: -0.03em;\n          font-size: 2.9rem;\n          letter-spacing: -0.03em;\n        \"\n        >“We stopped arguing about print versus digital the day we saw the river. It is one library - the water just\n        moves.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #071a28; color: #5af2c8\"\n        ><span class=\"avatar-fallback\">IM</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Ines Marek<br /><span style=\"opacity: 0.7; font-size: 1.4rem\">Head of collections - fictional</span></p\n      >\n    </div>\n    <p class=\"presentation-note\">The metaphor did the persuading.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"growth\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Growth\"\n  >\n    <header class=\"presentation-header\"><span>Change</span><span>Loans 2025 vs 2023</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: Inter, system-ui, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.03em;\n      \"\n      >Everything grows - except print</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The same four formats, re-sorted by growth.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Questions from the board\"\n  >\n    <header class=\"presentation-header\"><span>Q & A</span><span>Library board</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.2rem;\n        margin-block: 5.25rem 1.5rem;\n        font-family: Inter, system-ui, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.03em;\n      \"\n      >Questions from the board</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"tr-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Should we cut the print budget?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >No - print still carries 54% of all loans. Shift new spending, not the base.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"tr-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Why do board games peak in December?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Holidays: families borrow games for the break; loans rise by more than half between September and\n            December.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"tr-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>What is a “loan” for an e-book?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\">One checkout of one title for up to 21 days - the same rule as print.</p></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The print question always comes first.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Takeaways</span><span>For the collections plan</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">≈</span\n        ><span>A theme river shows shifting prominence, not exact values.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">≈</span\n        ><span>Audiobooks went from 8% to 18% of loans in three years.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">≈</span\n        ><span>Print thins slowly - it still carries half the library.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">≈</span\n        ><span>Buy for the summer peak: that is when listeners arrive.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Calm and fluid.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"south\"\n    data-anim-in-blocks=\"6\"\n    data-anim-in-color=\"#B983FF\"\n    aria-label=\"Closing\"\n  >\n    <div\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        inset: 0;\n        background:\n          radial-gradient(circle at 18% 0, rgba(90, 242, 200, 0.2), transparent 38%),\n          radial-gradient(circle at 85% 100%, rgba(185, 131, 255, 0.22), transparent 40%);\n      \"\n    ></div>\n    <svg\n      aria-hidden=\"true\"\n      width=\"1600\"\n      height=\"420\"\n      viewBox=\"0 0 1600 420\"\n      style=\"position: absolute; left: 0; bottom: 0\"\n    >\n      <path\n        d=\"M0 250 C 260 170, 460 330, 760 250 S 1260 150, 1600 230 L1600 420 L0 420 Z\"\n        fill=\"rgba(91,140,255,.16)\"\n      />\n      <path\n        d=\"M0 300 C 300 240, 520 360, 820 300 S 1300 230, 1600 290 L1600 420 L0 420 Z\"\n        fill=\"rgba(90,242,200,.16)\"\n      />\n      <path\n        d=\"M0 350 C 280 320, 560 400, 860 350 S 1320 310, 1600 345 L1600 420 L0 420 Z\"\n        fill=\"rgba(246,211,101,.16)\"\n      />\n    </svg>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        font-family: Inter, system-ui, sans-serif;\n        font-weight: 700;\n        letter-spacing: -0.03em;\n      \"\n      ><span\n        style=\"\n          background: linear-gradient(90deg, #5af2c8, #5b8cff, #b983ff);\n          -webkit-background-clip: text;\n          background-clip: text;\n          color: transparent;\n        \"\n        >One library, four currents</span\n      ></h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px\"\n      >Synthetic loans at a fictional library - the river is the real way to show a changing mix.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">End on the currents.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 12</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"12\" value=\"1\"></progress>\n</section>\n","individual":false}]
