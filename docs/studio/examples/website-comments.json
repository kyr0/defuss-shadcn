[{"label":"A discussion","html":"<style>\n  @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap');\n  /* The discussion under an engineering article: the site bar, the article it belongs to, then a 46rem column -\n     header and sort, a composer card, the thread with replies along a line. The author of the article wears a\n     badge, a permalinked comment is lit. Looks: Thread (white and indigo, follows light / dark), Late night (slate\n     and teal) and Paper (warm paper, a serif for what people wrote, rust for actions, a grain under it). */\n  #site-comments {\n    --background: oklch(0.99 0.002 260);\n    --foreground: oklch(0.21 0.02 265);\n    --card: oklch(1 0 0);\n    --card-foreground: var(--foreground);\n    --muted: oklch(0.965 0.006 265);\n    --muted-foreground: oklch(0.48 0.02 265);\n    --border: oklch(0.21 0.02 265 / 0.11);\n    --input: oklch(0.21 0.02 265 / 0.2);\n    --primary: oklch(0.5 0.19 272);\n    --primary-foreground: oklch(0.99 0.002 260);\n    --secondary: oklch(0.96 0.012 272);\n    --secondary-foreground: oklch(0.36 0.13 272);\n    --accent: oklch(0.955 0.02 272);\n    --accent-foreground: oklch(0.36 0.13 272);\n    --ring: var(--primary);\n    --radius: 0.625rem;\n    --radius-sm: max(0px, calc(var(--radius) - 4px));\n    --radius-md: max(0px, calc(var(--radius) - 2px));\n    --radius-lg: var(--radius);\n    --radius-xl: calc(var(--radius) + 4px);\n    --comments-said: 'Manrope', var(--font-sans);\n    color-scheme: light;\n    position: relative;\n    isolation: isolate;\n    box-sizing: border-box;\n    display: flex;\n    flex-direction: column;\n    gap: 1.5rem;\n    width: 100%;\n    padding-block-end: clamp(3rem, 7vw, 5rem);\n    background: var(--background);\n    color: var(--foreground);\n    font:\n      400 1rem/1.55 'Manrope',\n      var(--font-sans);\n  }\n  #site-comments > :not(.surface, .comments-bar) {\n    box-sizing: border-box;\n    width: 100%;\n    max-width: 46rem;\n    margin-inline: auto;\n    padding-inline: clamp(1rem, 4vw, 1.5rem);\n  }\n  .dark #site-comments[data-look='thread'] {\n    color-scheme: dark;\n    --background: oklch(0.18 0.012 265);\n    --foreground: oklch(0.94 0.006 265);\n    --card: oklch(0.215 0.014 265);\n    --muted: oklch(0.24 0.014 265);\n    --muted-foreground: oklch(0.74 0.014 265);\n    --border: oklch(0.94 0.006 265 / 0.11);\n    --input: oklch(0.94 0.006 265 / 0.2);\n    --primary: oklch(0.72 0.14 272);\n    --primary-foreground: oklch(0.18 0.012 265);\n    --secondary: oklch(0.28 0.05 272);\n    --secondary-foreground: oklch(0.88 0.06 272);\n    --accent: oklch(0.26 0.04 272);\n    --accent-foreground: oklch(0.88 0.06 272);\n  }\n  #site-comments[data-look='night'] {\n    color-scheme: dark;\n    --background: oklch(0.2 0.018 235);\n    --foreground: oklch(0.94 0.008 220);\n    --card: oklch(0.235 0.02 235);\n    --muted: oklch(0.26 0.02 235);\n    --muted-foreground: oklch(0.76 0.016 225);\n    --border: oklch(0.94 0.008 220 / 0.12);\n    --input: oklch(0.94 0.008 220 / 0.22);\n    --primary: oklch(0.8 0.11 180);\n    --primary-foreground: oklch(0.2 0.03 220);\n    --secondary: oklch(0.3 0.04 185);\n    --secondary-foreground: oklch(0.88 0.08 180);\n    --accent: oklch(0.27 0.03 190);\n    --accent-foreground: oklch(0.88 0.08 180);\n  }\n  #site-comments[data-look='paper'] {\n    color-scheme: light;\n    --background: oklch(0.965 0.014 82);\n    --foreground: oklch(0.25 0.025 50);\n    --card: oklch(0.985 0.01 82);\n    --muted: oklch(0.935 0.016 80);\n    --muted-foreground: oklch(0.45 0.03 55);\n    --border: oklch(0.25 0.025 50 / 0.14);\n    --input: oklch(0.25 0.025 50 / 0.26);\n    --primary: oklch(0.47 0.13 40);\n    --primary-foreground: oklch(0.985 0.01 82);\n    --secondary: oklch(0.92 0.03 55);\n    --secondary-foreground: oklch(0.4 0.11 40);\n    --accent: oklch(0.93 0.03 60);\n    --accent-foreground: oklch(0.4 0.11 40);\n    --radius: 0.25rem;\n    --comments-said: 'Source Serif 4', Georgia, serif;\n  }\n  #site-comments .comments-look-only {\n    display: none;\n  }\n  #site-comments[data-look='paper'] .comments-look-only[data-for='paper'] {\n    display: block;\n  }\n  #site-comments .comments-grain {\n    --surface-size: 180px;\n    --surface-ink: oklch(0.3 0.03 50 / 0.03);\n    --surface-bg: transparent;\n  }\n  /* the site bar - the same publication as the article */\n  #site-comments .comments-bar {\n    box-sizing: border-box;\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    justify-content: space-between;\n    gap: 0.75rem 1.5rem;\n    width: 100%;\n    min-height: 4.5rem;\n    padding: 0.75rem clamp(1rem, 4vw, 2.5rem);\n    border-block-end: 1px solid var(--border);\n  }\n  #site-comments .comments-brand {\n    color: var(--foreground);\n    text-decoration: none;\n    font-weight: 800;\n    font-size: 1.0625rem;\n    letter-spacing: -0.02em;\n  }\n  #site-comments .comments-brand span {\n    color: var(--muted-foreground);\n    font-weight: 600;\n  }\n  #site-comments .comments-bar-controls {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.5rem;\n  }\n  #site-comments .comments-bar .select {\n    min-width: 8.5rem;\n  }\n  /* the article this discussion belongs to */\n  #site-comments .comments-context {\n    display: grid;\n    gap: 0.25rem;\n    margin-block-start: clamp(1.5rem, 4vw, 2.5rem);\n  }\n  #site-comments .comments-context span {\n    color: var(--muted-foreground);\n    font-size: 0.75rem;\n    font-weight: 700;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n  }\n  #site-comments .comments-context a {\n    color: var(--foreground);\n    font:\n      700 clamp(1.5rem, 3vw, 2rem)/1.15 'Source Serif 4',\n      Georgia,\n      serif;\n    letter-spacing: -0.015em;\n    text-decoration: none;\n  }\n  #site-comments .comments-context a:hover {\n    color: var(--primary);\n  }\n  /* the header and the sort */\n  #site-comments .mk-comment-header {\n    padding-block-start: 1.5rem;\n    border-block-start: 1px solid var(--border);\n  }\n  #site-comments .mk-comment-header-title {\n    font-size: 1.25rem;\n    font-weight: 800;\n    letter-spacing: -0.02em;\n  }\n  #site-comments .mk-comment-header-title .badge {\n    border: 0;\n    background: var(--secondary);\n    color: var(--secondary-foreground);\n    font-weight: 700;\n  }\n  #site-comments .mk-comment-header-sort {\n    color: var(--muted-foreground);\n    font-size: 0.875rem;\n  }\n  /* the composer: a card with the textarea inside it */\n  #site-comments > .mk-comment-form {\n    padding: 1.25rem clamp(1rem, 4vw, 1.5rem);\n  }\n  #site-comments .mk-comment-form-main {\n    padding: 0.75rem;\n    border: 1px solid var(--input);\n    border-radius: var(--radius-xl);\n    background: var(--card);\n    box-shadow: 0 1px 2px oklch(0 0 0 / 0.04);\n  }\n  #site-comments .mk-comment-form-main:focus-within {\n    border-color: var(--ring);\n    box-shadow: 0 0 0 3px color-mix(in oklch, var(--ring) 18%, transparent);\n  }\n  #site-comments .mk-comment-form-main .textarea {\n    min-height: 4.5rem;\n    padding: 0.25rem;\n    border: 0;\n    background: transparent;\n    box-shadow: none;\n    font: inherit;\n    font-family: var(--comments-said);\n  }\n  #site-comments .mk-comment-form-main .textarea:focus-visible {\n    outline: none;\n    box-shadow: none;\n  }\n  #site-comments .mk-comment-form-hint {\n    color: var(--muted-foreground);\n    font-size: 0.8125rem;\n  }\n  /* the thread */\n  #site-comments [data-comments-thread] {\n    display: flex;\n    flex-direction: column;\n    gap: 0.5rem;\n  }\n  #site-comments .mk-comment-item {\n    gap: 0.875rem;\n    padding: 1rem;\n    border-radius: var(--radius-xl);\n    transition: background-color 0.3s;\n  }\n  #site-comments [data-comments-thread] > .mk-comment-item + .mk-comment-item {\n    border-block-start: 1px solid var(--border);\n    border-start-start-radius: 0;\n    border-start-end-radius: 0;\n  }\n  #site-comments .mk-comment-item .avatar {\n    width: 2.5rem;\n    height: 2.5rem;\n  }\n  #site-comments .mk-comment-item-author {\n    color: var(--foreground);\n    font-weight: 700;\n    text-decoration: none;\n  }\n  #site-comments .mk-comment-item-time {\n    color: var(--muted-foreground);\n    font-size: 0.8125rem;\n    text-decoration: none;\n  }\n  #site-comments .mk-comment-item-time:hover {\n    color: var(--primary);\n    text-decoration: underline;\n  }\n  #site-comments .mk-comment-item-body {\n    margin-block: 0.25rem 0.375rem;\n    font-family: var(--comments-said);\n    font-size: 1rem;\n    line-height: 1.6;\n  }\n  #site-comments[data-look='paper'] .mk-comment-item-body {\n    font-size: 1.0625rem;\n  }\n  #site-comments .mk-comment-item-actions .btn {\n    color: var(--muted-foreground);\n    font-weight: 600;\n  }\n  #site-comments .mk-comment-item-actions .btn:hover {\n    color: var(--foreground);\n  }\n  #site-comments .mk-comment-item-replies {\n    margin-inline-start: 1.25rem;\n    padding-inline-start: 1.5rem;\n    border-inline-start: 2px solid var(--border);\n  }\n  #site-comments .mk-comment-item-replies .mk-comment-item {\n    padding-inline: 0.75rem;\n  }\n  /* the article's author: a badge in the accent */\n  #site-comments .badge[data-i18n-target='author'] {\n    height: 1.25rem;\n    border: 0;\n    background: var(--primary);\n    color: var(--primary-foreground);\n    font-size: 0.6875rem;\n    font-weight: 800;\n    letter-spacing: 0.04em;\n  }\n  /* a permalinked comment is lit, with a bar in the accent */\n  #site-comments .mk-comment-item[data-highlighted] {\n    background: var(--accent);\n    box-shadow: inset 3px 0 0 var(--primary);\n  }\n  @media (prefers-reduced-motion: reduce) {\n    #site-comments .mk-comment-item {\n      transition: none;\n    }\n  }\n  /* light or dark: the Swap writes the page's dark class - every look has a light and a dark palette */\n  #site-comments .site-mode {\n    flex: none;\n    border: 1px solid var(--input);\n    border-radius: var(--radius-md);\n    background: var(--background);\n    color: var(--foreground);\n  }\n  #site-comments .site-mode:hover {\n    background: var(--accent);\n    color: var(--accent-foreground);\n  }\n  /* -- modes: each look in light and dark, derived from the palettes above (the other mode of each look) -- */\n  :root:not(.dark) #site-comments[data-look='thread'] {\n    --accent: oklch(0.945 0.02 260);\n    --accent-foreground: oklch(0.21 0.02 265);\n  }\n  .dark #site-comments[data-look='thread'] {\n    --accent: oklch(0.27 0.04 272);\n    --accent-foreground: oklch(0.94 0.006 265);\n  }\n  .dark #site-comments[data-look='night'] {\n    --accent: oklch(0.29 0.03 190);\n    --accent-foreground: oklch(0.94 0.008 220);\n  }\n  :root:not(.dark) #site-comments[data-look='night'] {\n    color-scheme: light;\n    --background: oklch(0.985 0.018 235);\n    --foreground: oklch(0.2 0.008 220);\n    --card: oklch(0.997 0.02 235);\n    --card-foreground: oklch(0.2 0.008 220);\n    --muted: oklch(0.95 0.02 235);\n    --muted-foreground: oklch(0.46 0.016 225);\n    --border: oklch(0.2 0.008 220 / 0.12);\n    --input: oklch(0.2 0.008 220 / 0.12);\n    --primary: oklch(0.53 0.11 180);\n    --primary-foreground: oklch(0.985 0.005 180);\n    --secondary: oklch(0.955 0.025 185);\n    --secondary-foreground: oklch(0.25 0.03 180);\n    --accent: oklch(0.94 0.025 190);\n    --accent-foreground: oklch(0.2 0.008 220);\n    --ring: oklch(0.55 0.11 180);\n    --popover: oklch(0.997 0 0);\n    --popover-foreground: oklch(0.2 0 0);\n  }\n  :root:not(.dark) #site-comments[data-look='paper'] {\n    --accent: oklch(0.92 0.03 60);\n    --accent-foreground: oklch(0.25 0.025 50);\n  }\n  .dark #site-comments[data-look='paper'] {\n    color-scheme: dark;\n    --background: oklch(0.17 0.014 82);\n    --foreground: oklch(0.94 0.025 50);\n    --card: oklch(0.205 0.01 82);\n    --card-foreground: oklch(0.94 0.025 50);\n    --muted: oklch(0.24 0.016 80);\n    --muted-foreground: oklch(0.74 0.03 55);\n    --border: oklch(0.95 0.02 50 / 0.14);\n    --input: oklch(0.95 0.02 50 / 0.14);\n    --primary: oklch(0.71 0.13 40);\n    --primary-foreground: oklch(0.17 0.03 40);\n    --secondary: oklch(0.25 0.03 55);\n    --secondary-foreground: oklch(0.9 0.03 40);\n    --accent: oklch(0.26 0.03 60);\n    --accent-foreground: oklch(0.94 0.025 50);\n    --ring: oklch(0.71 0.13 40);\n    --popover: oklch(0.215 0 0);\n    --popover-foreground: oklch(0.94 0 0);\n  }\n  /* -- modes: end -- */\n</style>\n<section id=\"site-comments\" data-look=\"thread\" data-i18n-component aria-labelledby=\"discussion-title\">\n  <div\n    class=\"surface comments-grain comments-look-only\"\n    data-for=\"paper\"\n    data-variant=\"background\"\n    data-pattern=\"grain\"\n    aria-hidden=\"true\"\n  ></div>\n  <div class=\"comments-bar\">\n    <a class=\"comments-brand\" href=\"#/\">Acme <span>Engineering</span></a>\n    <div class=\"comments-bar-controls\">\n      <select\n        class=\"select\"\n        data-size=\"sm\"\n        data-site-look\n        aria-label=\"Look\"\n        data-i18n-aria-label-en=\"Look\"\n        data-i18n-aria-label-de=\"Stil\"\n        style=\"width: auto\"\n      >\n        <option value=\"thread\" data-i18n-target=\"look-thread\">Thread</option>\n        <option value=\"night\" data-i18n-target=\"look-night\">Late night</option>\n        <option value=\"paper\" data-i18n-target=\"look-paper\">Paper</option>\n      </select>\n      <select\n        class=\"select\"\n        data-size=\"sm\"\n        data-app-locale\n        aria-label=\"Language\"\n        data-i18n-aria-label-en=\"Language\"\n        data-i18n-aria-label-de=\"Sprache\"\n        style=\"width: auto\"\n      >\n        <option value=\"en\" lang=\"en\">English</option>\n        <option value=\"de\" lang=\"de\">Deutsch</option>\n      </select>\n      <label class=\"swap site-mode\" data-variant=\"rotate\" data-size=\"sm\">\n        <input\n          type=\"checkbox\"\n          data-site-mode\n          aria-label=\"Dark mode\"\n          data-i18n-aria-label-en=\"Dark mode\"\n          data-i18n-aria-label-de=\"Dunkler Modus\"\n        />\n        <span class=\"swap-on\" aria-hidden=\"true\"><i data-lucide=\"moon\"></i></span>\n        <span class=\"swap-off\" aria-hidden=\"true\"><i data-lucide=\"sun\"></i></span>\n      </label>\n    </div>\n  </div>\n  <p class=\"comments-context\"\n    ><span data-i18n-target=\"on\">The discussion of</span> <a href=\"#\">How offline sync works in Acme 4.0</a></p\n  >\n  <header class=\"mk-comment-header\">\n    <h2 class=\"mk-comment-header-title\" id=\"discussion-title\"\n      ><span data-i18n-target=\"title\">Comments</span> <span class=\"badge\" data-variant=\"secondary\">3</span></h2\n    >\n    <div class=\"mk-comment-header-actions\">\n      <label class=\"mk-comment-header-sort\"\n        ><span data-i18n-target=\"sort\">Sort by</span>\n        <select class=\"select\" data-size=\"sm\" name=\"sort\" data-comments-sort>\n          <option value=\"top\" data-i18n-target=\"sort-top\">Top</option>\n          <option value=\"newest\" data-i18n-target=\"sort-newest\">Newest</option>\n          <option value=\"oldest\" data-i18n-target=\"sort-oldest\">Oldest</option>\n        </select>\n      </label>\n    </div>\n  </header>\n  <form\n    class=\"mk-comment-form\"\n    aria-label=\"Add a comment\"\n    data-i18n-aria-label-en=\"Add a comment\"\n    data-i18n-aria-label-de=\"Einen Kommentar schreiben\"\n  >\n    <span class=\"avatar\"><img class=\"avatar-image\" src=\"https://i.pravatar.cc/96?img=12\" alt=\"\" /></span>\n    <div class=\"mk-comment-form-main\">\n      <textarea\n        class=\"textarea\"\n        name=\"comment\"\n        rows=\"2\"\n        required\n        minlength=\"2\"\n        placeholder=\"Join the discussion…\" data-i18n-placeholder-en=\"Join the discussion…\" data-i18n-placeholder-de=\"Diskutiere mit…\"\n        aria-label=\"Comment\" data-i18n-aria-label-en=\"Comment\" data-i18n-aria-label-de=\"Kommentar\"\n      ></textarea>\n      <div class=\"mk-comment-form-footer\">\n        <p class=\"mk-comment-form-hint\" data-i18n-target=\"hint\">Markdown works. Be kind.</p>\n        <button type=\"submit\" class=\"btn\" data-i18n-target=\"post\">Post comment</button>\n      </div>\n    </div>\n  </form>\n  <div data-comments-thread>\n    <article class=\"mk-comment-item\" id=\"d-1\" data-likes=\"24\">\n      <span class=\"avatar\"><img class=\"avatar-image\" src=\"https://i.pravatar.cc/96?img=32\" alt=\"\" /></span>\n      <div class=\"mk-comment-item-main\">\n        <header class=\"mk-comment-item-head\">\n          <a class=\"mk-comment-item-author\" href=\"#\">Hannah Lee</a>\n          <a class=\"mk-comment-item-time\" href=\"#/comments/d-1\" data-router-link\n            ><time datetime=\"2026-10-01T08:12\" data-i18n-target=\"time-d-1\"\n              ><span data-i18n-value=\"ago1\">2 hours ago</span></time\n            ></a\n          >\n        </header>\n        <div class=\"mk-comment-item-body\"\n          ><p\n            >The write-ahead log section finally made CRDTs click for me. Would love a follow-up on how you\n            garbage-collect old operations.</p\n          ></div\n        >\n        <footer class=\"mk-comment-item-actions\">\n          <button\n            type=\"button\"\n            class=\"btn\"\n            data-variant=\"ghost\"\n            data-size=\"xs\"\n            aria-label=\"Like (24)\"\n            data-i18n-aria-label-en=\"Like (24)\"\n            data-i18n-aria-label-de=\"Gefällt mir (24)\"\n            ><i data-lucide=\"thumbs-up\"></i> 24</button\n          >\n          <button type=\"button\" class=\"btn\" data-variant=\"ghost\" data-size=\"xs\"\n            ><i data-lucide=\"reply\"></i> <span data-i18n-target=\"reply-1\">Reply</span></button\n          >\n        </footer>\n      </div>\n      <ol class=\"mk-comment-it