x-width: 20rem; width: 100%\">\n  <img\n    src=\"https://images.unsplash.com/photo-1588345921523-c2dcdb7f1dcd?w=600&h=300&fit=crop\"\n    alt=\"Abstract shapes\"\n    style=\"width: 100%; aspect-ratio: 16/9; object-fit: cover; display: block\"\n  />\n  <div class=\"card-header\">\n    <h3 class=\"card-title\">Modern Design</h3>\n    <p class=\"card-description\">Exploring minimal aesthetics through form and color.</p>\n  </div>\n  <div class=\"card-content\" style=\"padding-top: 0\">\n    <p style=\"margin: 0; font-size: 0.875rem; color: var(--muted-foreground); line-height: 1.6\"\n      >A deep dive into the principles that guide contemporary visual design.</p\n    >\n  </div>\n  <div class=\"card-footer\">\n    <button class=\"btn\" data-variant=\"default\" data-size=\"sm\">Read more</button>\n    <button class=\"btn\" data-variant=\"ghost\" data-size=\"sm\">Bookmark</button>\n  </div>\n</article>\n","individual":true},{"label":"Header Action","html":"<div class=\"card\" style=\"max-width: 20rem; width: 100%\">\n  <div class=\"card-header\" style=\"flex-direction: row; align-items: center; justify-content: space-between\">\n    <div>\n      <h3 class=\"card-title\">Team Members</h3>\n      <p class=\"card-description\">Manage who has access.</p>\n    </div>\n    <button class=\"btn\" data-variant=\"ghost\" data-size=\"icon\" aria-label=\"More options\">\n      <svg\n        aria-hidden=\"true\"\n        width=\"16\"\n        height=\"16\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n      >\n        <circle cx=\"12\" cy=\"5\" r=\"1\" />\n        <circle cx=\"12\" cy=\"12\" r=\"1\" />\n        <circle cx=\"12\" cy=\"19\" r=\"1\" />\n      </svg>\n    </button>\n  </div>\n  <div class=\"card-content\" style=\"display: flex; flex-direction: column; gap: 0.75rem\">\n    <div style=\"display: flex; align-items: center; gap: 0.75rem\">\n      <div\n        style=\"\n          width: 2rem;\n          height: 2rem;\n          border-radius: 9999px;\n          background: var(--primary);\n          display: flex;\n          align-items: center;\n          justify-content: center;\n          font-size: 0.75rem;\n          font-weight: 600;\n          color: var(--primary-foreground);\n          flex-shrink: 0;\n        \"\n        >CL</div\n      >\n      <div>\n        <p style=\"margin: 0; font-size: 0.875rem; font-weight: 500\">Aron Homberg</p>\n        <p style=\"margin: 0; font-size: 0.75rem; color: var(--muted-foreground)\">Owner</p>\n      </div>\n    </div>\n    <div style=\"display: flex; align-items: center; gap: 0.75rem\">\n      <div\n        style=\"\n          width: 2rem;\n          height: 2rem;\n          border-radius: 9999px;\n          background: var(--secondary);\n          display: flex;\n          align-items: center;\n          justify-content: center;\n          font-size: 0.75rem;\n          font-weight: 600;\n          color: var(--secondary-foreground);\n          flex-shrink: 0;\n        \"\n        >JD</div\n      >\n      <div>\n        <p style=\"margin: 0; font-size: 0.875rem; font-weight: 500\">Jane Doe</p>\n        <p style=\"margin: 0; font-size: 0.75rem; color: var(--muted-foreground)\">Editor</p>\n      </div>\n    </div>\n  </div>\n  <div class=\"card-footer\" style=\"padding-top: 1rem; border-top: 1px solid var(--border)\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" style=\"width: 100%\"\n      ><svg\n        aria-hidden=\"true\"\n        width=\"14\"\n        height=\"14\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n      >\n        <path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\" />\n        <circle cx=\"9\" cy=\"7\" r=\"4\" />\n        <line x1=\"19\" x2=\"19\" y1=\"8\" y2=\"14\" />\n        <line x1=\"22\" x2=\"16\" y1=\"11\" y2=\"11\" />\n      </svg>\n      Invite member\n    </button>\n  </div>\n</div>\n","individual":true},{"label":"Header Only","html":"<div class=\"card\" style=\"width: 100%; max-width: 24rem\">\n  <div class=\"card-header\">\n    <h3 class=\"card-title\">Notifications</h3>\n    <p class=\"card-description\">You have 3 unread messages.</p>\n  </div>\n</div>\n","individual":true},{"label":"Image overlay","html":"<article class=\"card\" data-layout=\"overlay\" style=\"max-width: 26rem\">\n  <figure class=\"card-media\"\n    ><img\n      src=\"https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=800&amp;h=600&amp;fit=crop\"\n      alt=\"Mountain range at dawn\"\n  /></figure>\n  <div class=\"card-body\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Sunrise hike</h3>\n      <p class=\"card-description\">Leave at 4:30, summit by 6:10.</p>\n    </div>\n    <div class=\"card-footer\"><button class=\"btn\" data-variant=\"secondary\" data-size=\"sm\">Join</button></div>\n  </div>\n</article>\n","individual":true},{"label":"Variants","html":"<div class=\"grid grid-cols-auto gap-4 p-4 rounded-xl pattern-mesh\" style=\"--layout-min: 13rem\">\n  <div class=\"card\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Default</h3>\n      <p class=\"card-description\">Card surface, border.</p>\n    </div>\n  </div>\n  <div class=\"card\" data-variant=\"outline\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Outline</h3>\n      <p class=\"card-description\">Border only, no fill.</p>\n    </div>\n  </div>\n  <div class=\"card\" data-variant=\"dashed\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Dashed</h3>\n      <p class=\"card-description\">A drop zone or a placeholder.</p>\n    </div>\n  </div>\n  <div class=\"card\" data-variant=\"ghost\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Ghost</h3>\n      <p class=\"card-description\">No border, no fill.</p>\n    </div>\n  </div>\n  <div class=\"card\" data-variant=\"muted\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Muted</h3>\n      <p class=\"card-description\">A soft, borderless surface.</p>\n    </div>\n  </div>\n  <div class=\"card\" data-variant=\"elevated\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Elevated</h3>\n      <p class=\"card-description\">A shadow instead of a border.</p>\n    </div>\n  </div>\n  <div class=\"card\" data-variant=\"primary\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Primary</h3>\n      <p class=\"card-description\">The brand surface.</p>\n    </div>\n  </div>\n  <div class=\"card\" data-variant=\"neutral\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Neutral</h3>\n      <p class=\"card-description\">The inverse surface.</p>\n    </div>\n  </div>\n  <div class=\"card\" data-variant=\"glass\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Glass</h3>\n      <p class=\"card-description\">Frosted over the pattern behind it.</p>\n    </div>\n  </div>\n</div>\n","individual":false},{"label":"Sizes","html":"<div class=\"flex flex-wrap items-start gap-4\">\n  <div class=\"card\" data-size=\"xs\" style=\"width: 10rem\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Size xs</h3>\n      <p class=\"card-description\">Padding and type scale together.</p>\n    </div>\n    <div class=\"card-footer\"><button class=\"btn\" data-size=\"xs\">Action</button></div>\n  </div>\n  <div class=\"card\" data-size=\"sm\" style=\"width: 12rem\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Size sm</h3>\n      <p class=\"card-description\">Padding and type scale together.</p>\n    </div>\n    <div class=\"card-footer\"><button class=\"btn\" data-size=\"sm\">Action</button></div>\n  </div>\n  <div class=\"card\" data-size=\"md\" style=\"width: 15rem\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Size md</h3>\n      <p class=\"card-description\">Padding and type scale together.</p>\n    </div>\n    <div class=\"card-footer\"><button class=\"btn\" data-size=\"sm\">Action</button></div>\n  </div>\n  <div class=\"card\" data-size=\"lg\" style=\"width: 18rem\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Size lg</h3>\n      <p class=\"card-description\">Padding and type scale together.</p>\n    </div>\n    <div class=\"card-footer\"><button class=\"btn\" data-size=\"sm\">Action</button></div>\n  </div>\n  <div class=\"card\" data-size=\"xl\" style=\"width: 21rem\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Size xl</h3>\n      <p class=\"card-description\">Padding and type scale together.</p>\n    </div>\n    <div class=\"card-footer\"><button class=\"btn\" data-size=\"lg\">Action</button></div>\n  </div>\n</div>\n","individual":false},{"label":"Media","html":"<div class=\"grid grid-cols-auto gap-4\" style=\"--layout-min: 15rem\">\n  <article class=\"card\">\n    <figure class=\"card-media\"\n      ><img\n        src=\"https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=600&amp;h=400&amp;fit=crop\"\n        alt=\"Mountain range at dawn\"\n    /></figure>\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Image on top</h3>\n      <p class=\"card-description\">The first child, edge to edge.</p>\n    </div>\n    <div class=\"card-footer\"><button class=\"btn\" data-size=\"sm\">Explore</button></div>\n  </article>\n  <article class=\"card\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Image at the bottom</h3>\n      <p class=\"card-description\">The last child - content first.</p>\n    </div>\n    <div class=\"card-content\" style=\"padding-bottom: 1rem\"\n      ><p class=\"text-sm m-0\">Place the figure after the body.</p></div\n    >\n    <figure class=\"card-media\"\n      ><img\n        src=\"https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=600&amp;h=400&amp;fit=crop\"\n        alt=\"A lake between mountains\"\n    /></figure>\n  </article>\n  <article class=\"card\" data-align=\"center\">\n    <figure class=\"card-media\" data-inset\n      ><img\n        src=\"https://images.unsplash.com/photo-1494548162494-384bba4ab999?w=600&amp;h=400&amp;fit=crop\"\n        alt=\"Desert dunes\"\n    /></figure>\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Centered</h3>\n      <p class=\"card-description\">Inset media, centered content.</p>\n    </div>\n    <div class=\"card-footer\"><button class=\"btn\" data-size=\"sm\">Buy now</button></div>\n  </article>\n</div>\n","individual":false},{"label":"Image on the side","html":"<div class=\"stack gap-4\" style=\"max-width: 36rem\">\n  <article class=\"card\" data-layout=\"side\">\n    <figure class=\"card-media\"\n      ><img\n        src=\"https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=600&amp;h=400&amp;fit=crop\"\n        alt=\"Sunlit forest\"\n    /></figure>\n    <div class=\"card-body\">\n      <div class=\"card-header\">\n        <h3 class=\"card-title\">New album is released</h3>\n        <p class=\"card-description\">Click the button to listen on the app.</p>\n      </div>\n      <div class=\"card-footer\"><button class=\"btn\" data-size=\"sm\">Listen</button></div>\n    </div>\n  </article>\n  <article class=\"card\" data-layout=\"side\">\n    <div class=\"card-body\">\n      <div class=\"card-header\">\n        <h3 class=\"card-title\">Image on the right</h3>\n        <p class=\"card-description\">The figure comes after the body.</p>\n      </div>\n      <div class=\"card-footer\"><button class=\"btn\" data-variant=\"outline\" data-size=\"sm\">Details</button></div>\n    </div>\n    <figure class=\"card-media\"\n      ><img\n        src=\"https://images.unsplash.com/photo-1518837695005-2083093ee35b?w=600&amp;h=400&amp;fit=crop\"\n        alt=\"Waves on a beach\"\n    /></figure>\n  </article>\n</div>\n","individual":false},{"label":"Responsive by its own width","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: minmax(0, 16rem) minmax(0, 1fr)\">\n  <article class=\"card\" data-layout=\"auto\">\n    <figure class=\"card-media\"\n      ><img\n        src=\"https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=600&amp;h=400&amp;fit=crop\"\n        alt=\"A green valley\"\n    /></figure>\n    <div class=\"card-body\">\n      <div class=\"card-header\">\n        <h3 class=\"card-title\">Weekend trip</h3>\n        <p class=\"card-description\">Two nights in the valley, trails and a lake.</p>\n      </div>\n      <div class=\"card-footer\"><button class=\"btn\" data-size=\"sm\">Book</button></div>\n    </div>\n  </article>\n  <article class=\"card\" data-layout=\"auto\">\n    <figure class=\"card-media\"\n      ><img\n        src=\"https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=600&amp;h=400&amp;fit=crop\"\n        alt=\"A green valley\"\n    /></figure>\n    <div class=\"card-body\">\n      <div class=\"card-header\">\n        <h3 class=\"card-title\">Weekend trip</h3>\n        <p class=\"card-description\">Two nights in the valley, trails and a lake.</p>\n      </div>\n      <div class=\"card-footer\"><button class=\"btn\" data-size=\"sm\">Book</button></div>\n    </div>\n  </article>\n</div>\n","individual":false},{"label":"Badges and indicators","html":"<div class=\"indicator\" style=\"width: 20rem; max-width: 100%\">\n  <span class=\"indicator-item badge\" data-variant=\"default\">New</span>\n  <article class=\"card\">\n    <figure class=\"card-media\"\n      ><img\n        src=\"https://images.unsplash.com/photo-1588345921523-c2dcdb7f1dcd?w=600&amp;h=400&amp;fit=crop\"\n        alt=\"Abstract shapes\"\n    /></figure>\n    <div class=\"card-header\">\n      <h3 class=\"card-title flex items-center gap-2\"\n        >Design system <span class=\"badge\" data-variant=\"secondary\">v2</span></h3\n      >\n      <p class=\"card-description\">Tokens, components and a verifier that never sleeps.</p>\n    </div>\n    <div class=\"card-footer\" style=\"justify-content: flex-end\">\n      <span class=\"badge\" data-variant=\"outline\">CSS</span>\n      <span class=\"badge\" data-variant=\"outline\">Tokens</span>\n    </div>\n  </article>\n</div>\n","individual":false},{"label":"Pricing with an aura","html":"<div class=\"flex flex-wrap items-start justify-center gap-6 p-4\">\n  <div class=\"card\" style=\"width: 17rem\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Starter</h3>\n      <p class=\"card-description\"\n        ><span style=\"font-size: 1.75rem; font-weight: 700; color: var(--card-foreground)\">€0</span> / month</p\n      >\n    </div>\n    <div class=\"card-content\" style=\"padding-top: 1rem\">\n      <ul class=\"stack gap-2 m-0 p-0 text-sm\" style=\"list-style: none\">\n        <li class=\"flex items-center gap-2\"><i data-lucide=\"check\"></i> 3 projects</li>\n        <li class=\"flex items-center gap-2\"><i data-lucide=\"check\"></i> Community support</li>\n        <li class=\"flex items-center gap-2 text-muted-foreground\" style=\"text-decoration: line-through\"\n          ><i data-lucide=\"x\"></i> Custom domains</li\n        >\n        <li class=\"flex items-center gap-2 text-muted-foreground\" style=\"text-decoration: line-through\"\n          ><i data-lucide=\"x\"></i> Priority support</li\n        >\n      </ul>\n    </div>\n    <div class=\"card-footer\"><button class=\"btn w-full\" data-variant=\"outline\">Start free</button></div>\n  </div>\n  <div class=\"aura aura-rainbow aura-lg\" style=\"width: 17rem\">\n    <div class=\"card\">\n      <div class=\"card-header\">\n        <span class=\"badge\" data-variant=\"default\" style=\"width: fit-content\">Most popular</span>\n        <h3 class=\"card-title\">Pro</h3>\n        <p class=\"card-description\"\n          ><span style=\"font-size: 1.75rem; font-weight: 700; color: var(--card-foreground)\">€19</span> / month</p\n        >\n      </div>\n      <div class=\"card-content\" style=\"padding-top: 1rem\">\n        <ul class=\"stack gap-2 m-0 p-0 text-sm\" style=\"list-style: none\">\n          <li class=\"flex items-center gap-2\"><i data-lucide=\"check\"></i> Unlimited projects</li>\n          <li class=\"flex items-center gap-2\"><i data-lucide=\"check\"></i> Priority support</li>\n          <li class=\"flex items-center gap-2\"><i data-lucide=\"check\"></i> Custom domains</li>\n          <li class=\"flex items-center gap-2\"><i data-lucide=\"check\"></i> Team roles</li>\n        </ul>\n      </div>\n      <div class=\"card-footer\"><button class=\"btn w-full\">Upgrade to Pro</button></div>\n    </div>\n  </div>\n</div>\n","individual":false},{"label":"Selectable cards","html":"<div class=\"stack gap-4\" style=\"max-width: 36rem\">\n  <fieldset class=\"grid grid-cols-auto gap-3 m-0 p-0\" style=\"border: 0; --layout-min: 10rem\">\n    <legend class=\"text-sm font-medium mb-2\">Plan</legend>\n    <label class=\"card\" data-size=\"sm\">\n      <div class=\"card-header\">\n        <span class=\"flex items-center justify-between\"\n          ><span class=\"card-title\">Hobby</span><input type=\"radio\" class=\"radio\" name=\"card-plan\" value=\"hobby\"\n        /></span>\n        <p class=\"card-description\">€0 / month</p>\n      </div>\n    </label>\n    <label class=\"card\" data-size=\"sm\">\n      <div class=\"card-header\">\n        <span class=\"flex items-center justify-between\"\n          ><span class=\"card-title\">Pro</span><input type=\"radio\" class=\"radio\" name=\"card-plan\" value=\"pro\" checked\n        /></span>\n        <p class=\"card-description\">€19 / month</p>\n      </div>\n    </label>\n    <label class=\"card\" data-size=\"sm\">\n      <div class=\"card-header\">\n        <span class=\"flex items-center justify-between\"\n          ><span class=\"card-title\">Team</span><input type=\"radio\" class=\"radio\" name=\"card-plan\" value=\"team\"\n        /></span>\n        <p class=\"card-description\">€49 / month</p>\n      </div>\n    </label>\n  </fieldset>\n  <fieldset class=\"grid grid-cols-auto gap-3 m-0 p-0\" style=\"border: 0; --layout-min: 10rem\">\n    <legend class=\"text-sm font-medium mb-2\">Add-ons</legend>\n    <label class=\"card\" data-size=\"sm\">\n      <div class=\"card-header\">\n        <span class=\"flex items-center justify-between\"\n          ><span class=\"card-title\">Backups</span\n          ><input type=\"checkbox\" class=\"checkbox\" name=\"card-addon\" value=\"backups\" checked\n        /></span>\n        <p class=\"card-description\">Daily, 30 days</p>\n      </div>\n    </label>\n    <label class=\"card\" data-size=\"sm\">\n      <div class=\"card-header\">\n        <span class=\"flex items-center justify-between\"\n          ><span class=\"card-title\">Analytics</span\n          ><input type=\"checkbox\" class=\"checkbox\" name=\"card-addon\" value=\"analytics\"\n        /></span>\n        <p class=\"card-description\">Privacy-first</p>\n      </div>\n    </label>\n    <label class=\"card\" data-size=\"sm\">\n      <div class=\"card-header\">\n        <span class=\"flex items-center justify-between\"\n          ><span class=\"card-title\">SSO</span\n          ><input type=\"checkbox\" class=\"checkbox\" name=\"card-addon\" value=\"sso\" disabled\n        /></span>\n        <p class=\"card-description\">Enterprise login</p>\n      </div>\n    </label>\n  </fieldset>\n</div>\n","individual":false},{"label":"Link cards","html":"<div class=\"grid grid-cols-auto gap-4\" style=\"--layout-min: 14rem\">\n  <a class=\"card\" href=\"#card-link-1\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Getting started →</h3>\n      <p class=\"card-description\">Install and render your first component.</p>\n    </div>\n  </a>\n  <a class=\"card\" href=\"#card-link-2\" data-layout=\"side\">\n    <figure class=\"card-media\"\n      ><img src=\"https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=300&amp;h=300&amp;fit=crop\" alt=\"\"\n    /></figure>\n    <div class=\"card-body\"\n      ><div class=\"card-header\">\n        <h3 class=\"card-title\">Guides →</h3>\n        <p class=\"card-description\">Theming, layout, shapes.</p>\n      </div></div\n    >\n  </a>\n</div>\n","individual":false},{"label":"Colors","html":"<div class=\"grid grid-cols-auto gap-4\" style=\"--layout-min: 15rem\">\n  <div class=\"card\" data-variant=\"primary\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Primary</h3>\n      <p class=\"card-description\">Ship the release notes today.</p>\n    </div>\n    <div class=\"card-footer\"><button class=\"btn\" data-variant=\"secondary\" data-size=\"sm\">Publish</button></div>\n  </div>\n  <div class=\"card\" data-variant=\"neutral\" data-align=\"center\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Cookies</h3>\n      <p class=\"card-description\">We use cookies to keep you signed in.</p>\n    </div>\n    <div class=\"card-footer\"\n      ><button class=\"btn\" data-variant=\"secondary\" data-size=\"sm\">Accept</button\n      ><button class=\"btn\" data-variant=\"ghost\" data-size=\"sm\">Deny</button></div\n    >\n  </div>\n  <div\n    class=\"card\"\n    style=\"\n      --card: oklch(0.93 0.06 160);\n      --card-foreground: oklch(0.3 0.08 160);\n      --border: oklch(0.8 0.08 160);\n      --muted-foreground: oklch(0.42 0.07 160);\n    \"\n  >\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Your own colors</h3>\n      <p class=\"card-description\">Three tokens, set on the card.</p>\n    </div>\n    <div class=\"card-footer\"><button class=\"btn\" data-variant=\"outline\" data-size=\"sm\">Nice</button></div>\n  </div>\n</div>\n","individual":false},{"label":"Shapes, frames and stacks","html":"<div class=\"grid grid-cols-auto items-start gap-10 p-6\" style=\"--layout-min: 13rem\">\n  <div class=\"card cut-corners\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Cut corners</h3>\n      <p class=\"card-description\">cut-corners</p>\n    </div>\n  </div>\n  <div class=\"card scoop-corners\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Scooped</h3>\n      <p class=\"card-description\">scoop-corners</p>\n    </div>\n  </div>\n  <div class=\"card corner-leaf\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Leaf</h3>\n      <p class=\"card-description\">corner-leaf</p>\n    </div>\n  </div>\n  <div class=\"card frame-tape\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Taped</h3>\n      <p class=\"card-description\">frame-tape</p>\n    </div>\n  </div>\n  <div class=\"card frame-window\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Window</h3>\n      <p class=\"card-description\">frame-window</p>\n    </div>\n  </div>\n  <div class=\"card shadow-hard\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Hard shadow</h3>\n      <p class=\"card-description\">shadow-hard</p>\n    </div>\n  </div>\n  <div class=\"card stack-bottom\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">A pile</h3>\n      <p class=\"card-description\">stack-bottom</p>\n    </div>\n  </div>\n  <div class=\"card stack-bottom-right stack-outline\">\n    <div class=\"card-header\">\n      <h3 class=\"card-title\">Outlined sheets</h3>\n      <p class=\"card-description\">stack-bottom-right stack-outline</p>\n    </div>\n  </div>\n  <figure class=\"card frame-polaroid m-0\" style=\"max-width: 13rem\">\n    <img\n      src=\"https://images.unsplash.com/photo-1518837695005-2083093ee35b?w=400&amp;h=400&amp;fit=crop\"\n      alt=\"Waves\"\n      style=\"display: block; width: 100%; aspect-ratio: 1; object-fit: cover\"\n    />\n    <figcaption class=\"text-sm\" style=\"padding: 0.75rem 0 0; text-align: center\">frame-polaroid</figcaption>\n  </figure>\n</div>\n","individual":false},{"label":"With an aura","html":"<div class=\"grid grid-cols-auto gap-8 p-6\" style=\"--layout-min: 14rem\">\n  <div class=\"aura\">\n    <div class=\"card\"\n      ><div class=\"card-header\">\n        <h3 class=\"card-title\">aura</h3>\n        <p class=\"card-description\">A light runs around it.</p>\n      </div></div\n    >\n  </div>\n  <div class=\"aura aura-glow aura-rainbow\">\n    <div class=\"card\"\n      ><div class=\"card-header\">\n        <h3 class=\"card-title\">aura-glow</h3>\n        <p class=\"card-description\">A turning halo behind it.</p>\n      </div></div\n    >\n  </div>\n  <div class=\"aura aura-gold aura-lg\">\n    <div class=\"card\" data-variant=\"neutral\"\n      ><div class=\"card-header\">\n        <h3 class=\"card-title\">aura-gold</h3>\n        <p class=\"card-description\">On a neutral card.</p>\n      </div></div\n    >\n  </div>\n</div>\n","individual":false},{"label":"Density","html":"<div class=\"flex flex-wrap gap-4\">\n  <div class=\"flex-1 min-w-48\">\n    <p class=\"demo-label\">Compact</p>\n    <div class=\"card\" data-density=\"compact\"\n      ><div class=\"card-header\"\n        ><h3 class=\"card-title\">Density</h3><p class=\"card-description\">Section padding scales.</p></div\n      ><div class=\"card-content\"><p>Body copy stays put - only whitespace changes.</p></div\n      ><div class=\"card-footer\"><span>Footer</span></div></div\n    >\n  </div>\n  <div class=\"flex-1 min-w-48\">\n    <p class=\"demo-label\">Comfortable</p>\n    <div class=\"card\" data-density=\"comfortable\"\n      ><div class=\"card-header\"\n        ><h3 class=\"card-title\">Density</h3><p class=\"card-description\">Section padding scales.</p></div\n      ><div class=\"card-content\"><p>Body copy stays put - only whitespace changes.</p></div\n      ><div class=\"card-footer\"><span>Footer</span></div></div\n    >\n  </div>\n  <div class=\"flex-1 min-w-48\">\n    <p class=\"demo-label\">Spacious</p>\n    <div class=\"card\" data-density=\"spacious\"\n      ><div class=\"card-header\"\n        ><h3 class=\"card-title\">Density</h3><p class=\"card-description\">Section padding scales.</p></div\n      ><div class=\"card-content\"><p>Body copy stays put - only whitespace changes.</p></div\n      ><div class=\"card-footer\"><span>Footer</span></div></div\n    >\n  </div>\n</div>\n","individual":false}]
