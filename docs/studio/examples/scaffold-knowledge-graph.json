[{"label":"Knowledge graph","html":"<style>\n  /* Atlas: the scaffold's own glue. Every control is a shipped component (Border Layout, Panel, Resizer, Graph\n     Explorer, Button, Separator, Select, Swap); the details the plugins draw compose Chart, Geo Map, Avatar,\n     Timeline, Progress, Table, Badge and Statistic */\n  .kg {\n    block-size: var(--scaffold-height, 46rem);\n  }\n  .kg-brand {\n    display: flex;\n    align-items: center;\n    gap: 0.5rem;\n    font-weight: 650;\n    white-space: nowrap;\n  }\n  .kg-brand-mark {\n    display: grid;\n    place-items: center;\n    inline-size: 1.75rem;\n    block-size: 1.75rem;\n    border-radius: var(--radius-md);\n    background: var(--primary);\n    color: var(--primary-foreground);\n  }\n  .kg-brand-sub {\n    color: var(--muted-foreground);\n    font-weight: 400;\n  }\n  .kg-title-sub {\n    color: var(--muted-foreground);\n    font-weight: 400;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n    &:not(:empty)::before {\n      content: '· ';\n    }\n  }\n  /* the search trigger: an input's look, the palette behind it */\n  .kg-search {\n    inline-size: min(100%, 20rem);\n    justify-content: flex-start;\n    color: var(--muted-foreground);\n    font-weight: 400;\n    & .kbd {\n      margin-inline-start: auto;\n    }\n  }\n  .kg-search-text {\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n  /* the Hierarchy Explorer: the filter, the graph as a tree of any depth */\n  .kg-tree {\n    display: flex;\n    flex-direction: column;\n    min-block-size: 0;\n  }\n  .kg-tree-filter {\n    padding: 0.375rem;\n  }\n  /* two columns that always fit the panel: the name gives way (an ellipsis), the size stays */\n  #kg-tree :is(.data-grid-head, .data-grid-row) {\n    width: 100%;\n  }\n  #kg-tree {\n    flex: 1;\n    min-block-size: 0;\n    border-inline: 0;\n    border-block-end: 0;\n    border-radius: 0;\n  }\n  .kg-tree-more {\n    color: var(--muted-foreground);\n    font-style: italic;\n  }\n  .kg-tree-label {\n    display: flex;\n    align-items: center;\n    gap: 0.375rem;\n    min-inline-size: 0;\n    & > span:last-child {\n      overflow: hidden;\n      text-overflow: ellipsis;\n      white-space: nowrap;\n    }\n  }\n  .kg-tree-dot {\n    flex: none;\n    inline-size: 0.5rem;\n    block-size: 0.5rem;\n    border-radius: 50%;\n    background: var(--chart-1);\n    &[data-kind='Domain'] {\n      background: var(--chart-2);\n    }\n    &[data-kind='system'] {\n      background: var(--chart-3);\n    }\n    &[data-kind='entity'] {\n      background: var(--chart-4);\n    }\n  }\n  /* the palette's hits: the name, then what and where */\n  .kg-hit {\n    display: grid;\n    gap: 0.0625rem;\n    text-align: start;\n  }\n  .kg-hit-path {\n    color: var(--muted-foreground);\n    font-size: 0.75rem;\n  }\n  .kg-palette-status {\n    margin: 0;\n    padding: 0.375rem 0.75rem;\n    border-block-start: 1px solid var(--border);\n    color: var(--muted-foreground);\n    font-size: 0.75rem;\n    &:empty {\n      display: none;\n    }\n  }\n  /* the graph's header: Back to the previous selection and Out, a divider, then the title */\n  .kg-graph-nav {\n    display: flex;\n    flex: none;\n    align-items: center;\n    gap: 0.125rem;\n    & .separator {\n      block-size: 1.25rem;\n      margin-inline: 0.375rem 0.125rem;\n    }\n  }\n  /* the Owners layer: avatars, overlapping a little */\n  .kg-owners {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.25rem;\n    & .graph-explorer-avatar + .graph-explorer-avatar {\n      margin-inline-start: -0.375rem;\n    }\n  }\n  p.kg-owners {\n    display: flex;\n  }\n  .kg .panel-title {\n    display: flex;\n    gap: 0.375rem;\n    min-inline-size: 0;\n  }\n  .kg-endpoint {\n    display: flex;\n    align-items: center;\n    gap: 0.5rem;\n    font-family: var(--font-mono);\n    font-size: 0.75rem;\n  }\n  .kg-note {\n    margin: 0;\n    font-size: 0.75rem;\n    color: var(--muted-foreground);\n  }\n  .kg-team {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 0.75rem;\n  }\n  .kg-checks {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.375rem;\n  }\n  .kg-details .geo-map {\n    --geo-map-height: 15rem;\n  }\n  .kg-records {\n    display: grid;\n    gap: 0.75rem;\n    min-inline-size: 0;\n  }\n  .kg-records-count {\n    margin: 0;\n    font-size: 0.8125rem;\n    font-variant-numeric: tabular-nums;\n  }\n  .kg-records-charts {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));\n    gap: 1rem;\n  }\n  .kg-records-chart {\n    margin: 0;\n    min-inline-size: 0;\n    & figcaption {\n      font-size: 0.75rem;\n      color: var(--muted-foreground);\n    }\n  }\n  .kg-records .data-grid {\n    --data-grid-row-height: 30px;\n    font-size: 0.8125rem;\n  }\n  .kg-theme[aria-pressed='true'] .kg-theme-light,\n  .kg-theme[aria-pressed='false'] .kg-theme-dark {\n    display: none;\n  }\n  .kg-theme > span {\n    display: contents;\n  }\n</style>\n<div class=\"kg\" data-kg data-i18n-component>\n  <div class=\"border-layout\" id=\"kg-app\" data-frame=\"none\" data-center-min=\"360\" style=\"block-size: 100%\">\n    <header class=\"border-layout-north flex items-center gap-3 px-3 py-2\">\n      <span class=\"kg-brand\"\n        ><span class=\"kg-brand-mark\"><i data-lucide=\"waypoints\"></i></span><span>Atlas</span\n        ><span class=\"kg-brand-sub\" data-i18n-target=\"kg-brand-sub\">knowledge graph</span></span\n      >\n      <div class=\"flex-1 min-w-0\" data-graph-explorer-for=\"kg\" data-graph-explorer-outlet=\"breadcrumb\"></div>\n      <button\n        class=\"btn kg-search\"\n        data-variant=\"outline\"\n        data-size=\"sm\"\n        type=\"button\"\n        data-command-trigger=\"kg-palette\"\n        aria-keyshortcuts=\"Meta+K Control+K\"\n      >\n        <i data-lucide=\"search\"></i> <span class=\"kg-search-text\" data-i18n-target=\"kg-search\">Search the graph</span>\n        <kbd class=\"kbd\">⌘K</kbd>\n      </button>\n      <div class=\"flex items-center gap-2\">\n        <button\n          class=\"btn\"\n          data-variant=\"outline\"\n          data-size=\"sm\"\n          type=\"button\"\n          title=\"Fit the view (0)\"\n          data-i18n-title-en=\"Fit the view (0)\"\n          data-i18n-title-de=\"Ansicht einpassen (0)\"\n          data-graph-explorer-for=\"kg\"\n          data-graph-explorer-action=\"fit\"\n        >\n          <i data-lucide=\"scan\"></i> <span data-i18n-target=\"kg-fit\">Fit</span>\n        </button>\n        <button\n          class=\"btn\"\n          data-variant=\"outline\"\n          data-size=\"sm\"\n          type=\"button\"\n          aria-pressed=\"false\"\n          title=\"Live mode: changes arrive as they happen - a dot on a changed node, a flash on a changed link, a row in Updates\"\n          data-i18n-title-en=\"Live mode: changes arrive as they happen - a dot on a changed node, a flash on a changed link, a row in Updates\"\n          data-i18n-title-de=\"Live-Modus: Änderungen kommen, sobald sie passieren - ein Punkt am geänderten Knoten, ein Aufleuchten der geänderten Verbindung, eine Zeile in Aktualisierungen\"\n          data-graph-explorer-for=\"kg\"\n          data-graph-explorer-action=\"live\"\n        >\n          <i data-lucide=\"radio-tower\"></i> <span data-i18n-target=\"kg-live\">Live mode</span>\n        </button>\n        <button\n          class=\"btn kg-theme\"\n          data-variant=\"ghost\"\n          data-size=\"icon-sm\"\n          type=\"button\"\n          aria-pressed=\"false\"\n          aria-label=\"Dark mode\"\n          title=\"Dark mode\"\n          data-i18n-aria-label-en=\"Dark mode\"\n          data-i18n-aria-label-de=\"Dunkelmodus\"\n          data-i18n-title-en=\"Dark mode\"\n          data-i18n-title-de=\"Dunkelmodus\"\n          data-kg-theme\n        >\n          <span class=\"kg-theme-light\"><i data-lucide=\"moon\"></i></span\n          ><span class=\"kg-theme-dark\"><i data-lucide=\"sun\"></i></span>\n        </button>\n        <div\n          class=\"language-switcher\"\n          data-app-locale\n          role=\"group\"\n          aria-label=\"Language\"\n          data-i18n-aria-label-en=\"Language\"\n          data-i18n-aria-label-de=\"Sprache\"\n          data-languages=\"en de\"\n          data-value=\"en\"\n          data-size=\"sm\"\n          data-display=\"icon\"\n          data-flag-shape=\"circle\"\n          data-flag-style=\"ring\"\n          data-align=\"end\"\n        ></div>\n        <button\n          class=\"btn\"\n          data-variant=\"ghost\"\n          data-size=\"icon-sm\"\n          type=\"button\"\n          aria-label=\"Keyboard map (?)\"\n          title=\"Keyboard map (?)\"\n          data-i18n-aria-label-en=\"Keyboard map (?)\"\n          data-i18n-aria-label-de=\"Tastaturbelegung (?)\"\n          data-i18n-title-en=\"Keyboard map (?)\"\n          data-i18n-title-de=\"Tastaturbelegung (?)\"\n          data-graph-explorer-for=\"kg\"\n          data-graph-explorer-action=\"help\"\n        >\n          <i data-lucide=\"keyboard\"></i>\n        </button>\n      </div>\n    </header>\n    <div class=\"resizer border-layout-west\" data-min=\"160\" data-max=\"420\">\n      <div\n        class=\"border-layout-stack\"\n        style=\"width: 15rem\"\n        aria-label=\"Hierarchy and updates\"\n        data-i18n-aria-label-en=\"Hierarchy and updates\"\n        data-i18n-aria-label-de=\"Hierarchie und Aktualisierungen\"\n      >\n        <section\n          class=\"card panel\"\n          id=\"kg-outline\"\n          style=\"--border-layout-share: 3\"\n          aria-labelledby=\"kg-outline-title\"\n          data-density=\"compact\"\n        >\n          <header class=\"panel-header\">\n            <i data-lucide=\"list-tree\" class=\"panel-icon\" aria-hidden=\"true\"></i>\n            <h3 class=\"panel-title\" id=\"kg-outline-title\">\n              <span data-i18n-target=\"kg-t-outline\">Hierarchy Explorer</span>\n            </h3>\n            <div class=\"panel-tools\">\n              <label class=\"swap panel-minimize\">\n                <input\n                  type=\"checkbox\"\n                  aria-label=\"Minimize Hierarchy Explorer\"\n                  data-i18n-aria-label-en=\"Minimize Hierarchy Explorer\"\n                  data-i18n-aria-label-de=\"Hierarchie-Explorer einklappen\"\n                />\n                <span class=\"swap-off\"><i data-lucide=\"chevron-up\"></i></span>\n                <span class=\"swap-on\"><i data-lucide=\"chevron-down\"></i></span>\n              </label>\n            </div>\n          </header>\n          <div class=\"panel-body kg-tree\" data-flush>\n            <div class=\"kg-tree-filter\">\n              <input\n                class=\"input\"\n                data-size=\"sm\"\n                type=\"search\"\n                placeholder=\"Filter the open branches\"\n                aria-label=\"Filter the hierarchy\"\n                data-i18n-placeholder-en=\"Filter the open branches\"\n                data-i18n-placeholder-de=\"Die offenen Zweige filtern\"\n                data-i18n-aria-label-en=\"Filter the hierarchy\"\n                data-i18n-aria-label-de=\"Die Hierarchie filtern\"\n                data-kg-tree-filter\n              />\n            </div>\n            <div\n              class=\"data-grid\"\n              id=\"kg-tree\"\n              aria-label=\"The graph as a hierarchy\"\n              data-i18n-aria-label-en=\"The graph as a hierarchy\"\n              data-i18n-aria-label-de=\"Der Graph als Hierarchie\"\n              data-parent-field=\"parent\"\n              data-select=\"single\"\n              data-persist=\"none\"\n              data-density=\"compact\"\n              data-empty-text=\"Nothing in the open branches matches.\"\n            >\n              <div class=\"data-grid-viewport\">\n                <div class=\"data-grid-head\">\n                  <div class=\"data-grid-row\">\n                    <div class=\"data-grid-header\" data-field=\"label\" data-width=\"minmax(0, 1fr)\"\n                      ><span data-i18n-target=\"kg-tree-name\">Name</span></div\n                    >\n                    <div class=\"data-grid-header\" data-field=\"count\" data-type=\"number\" data-width=\"5.75rem\"\n                      ><span data-i18n-target=\"kg-tree-count\">Size</span></div\n                    >\n                  </div>\n                </div>\n                <div class=\"data-grid-body\"></div>\n              </div>\n            </div>\n          </div>\n        </section>\n        <section\n          class=\"card panel\"\n          id=\"kg-updates\"\n          style=\"--border-layout-share: 2\"\n          aria-labelledby=\"kg-updates-title\"\n          data-density=\"compact\"\n        >\n          <header class=\"panel-header\">\n            <i data-lucide=\"activity\" class=\"panel-icon\" aria-hidden=\"true\"></i>\n            <h3 class=\"panel-title\" id=\"kg-updates-title\">\n              <span data-i18n-target=\"kg-t-updates\">Updates</span>\n            </h3>\n            <div class=\"panel-tools\">\n              <label class=\"swap panel-minimize\">\n                <input\n                  type=\"checkbox\"\n                  aria-label=\"Minimize Updates\"\n                  data-i18n-aria-label-en=\"Minimize Updates\"\n                  data-i18n-aria-label-de=\"Aktualisierungen einklappen\"\n                />\n                <span class=\"swap-off\"><i data-lucide=\"chevron-up\"></i></span>\n                <span class=\"swap-on\"><i data-lucide=\"chevron-down\"></i></span>\n              </label>\n            </div>\n          </header>\n          <div class=\"panel-body\" data-flush data-graph-explorer-for=\"kg\" data-graph-explorer-outlet=\"updates\"></div>\n        </section>\n      </div>\n    </div>\n    <section\n      class=\"card panel border-layout-center\"\n      id=\"kg-graph\"\n      aria-labelledby=\"kg-graph-title\"\n      data-density=\"compact\"\n      data-title-collapse=\"false\"\n    >\n      <header class=\"panel-header\">\n        <div class=\"kg-graph-nav\">\n          <button\n            class=\"btn\"\n            data-variant=\"ghost\"\n            data-size=\"xs\"\n            type=\"button\"\n            data-kg-back\n            disabled\n            title=\"Back to the previous selection\"\n          >\n            <i data-lucide=\"arrow-left\"></i> <span data-i18n-target=\"kg-back\">Back</span>\n          </button>\n          <button\n            class=\"btn\"\n            data-variant=\"ghost\"\n            data-size=\"xs\"\n            type=\"button\"\n            title=\"Move out (Backspace)\"\n            data-i18n-title-en=\"Move out (Backspace)\"\n            data-i18n-title-de=\"Hinaus (Rücktaste)\"\n            data-graph-explorer-for=\"kg\"\n            data-graph-explorer-action=\"up\"\n          >\n            <i data-lucide=\"arrow-up\"></i> <span data-i18n-target=\"kg-out\">Out</span>\n          </button>\n          <div class=\"separator\" data-orientation=\"vertical\" role=\"separator\"></div>\n        </div>\n        <i data-lucide=\"waypoints\" class=\"panel-icon\" aria-hidden=\"true\"></i>\n        <h3 class=\"panel-title\" id=\"kg-graph-title\">\n          <span data-i18n-target=\"kg-t-graph\">Graph</span\n          ><span class=\"kg-title-sub\" data-graph-explorer-for=\"kg\" data-graph-explorer-output=\"view\"></span>\n        </h3>\n        <div class=\"panel-tools\">\n          <div data-graph-explorer-for=\"kg\" data-graph-explorer-outlet=\"layers\"></div>\n          <label class=\"swap panel-maximize\">\n            <input\n              type=\"checkbox\"\n              aria-label=\"Maximize Graph\"\n              data-i18n-aria-label-en=\"Maximize Graph\"\n              data-i18n-aria-label-de=\"Graph maximieren\"\n            />\n            <span class=\"swap-off\"><i data-lucide=\"maximize-2\"></i></span>\n            <span class=\"swap-on\"><i data-lucide=\"minimize-2\"></i></span>\n          </label>\n        </div>\n      </header>\n      <div class=\"panel-body\" data-flush>\n        <div\n          class=\"graph-explorer\"\n          id=\"kg\"\n          data-nodes=\"1000000\"\n          data-seed=\"7\"\n          aria-label=\"A knowledge graph of a million services, datasets and people\"\n        ></div>\n      </div>\n    </section>\n    <div class=\"resizer border-layout-east\" data-min=\"260\" data-max=\"680\">\n      <section\n        class=\"card panel kg-details\"\n        id=\"kg-details\"\n        style=\"width: 24rem\"\n        aria-labelledby=\"kg-details-title\"\n        data-density=\"compact\"\n      >\n        <header class=\"panel-header\">\n          <i data-lucide=\"panel-right\" class=\"panel-icon\" aria-hidden=\"true\"></i>\n          <h3 class=\"panel-title\" id=\"kg-details-title\">\n            <span data-i18n-target=\"kg-t-details\">Details</span\n            ><span\n              class=\"kg-title-sub\"\n              id=\"kg-details-sub\"\n              data-graph-explorer-for=\"kg\"\n              data-graph-explorer-output=\"details-title\"\n            ></span>\n          </h3>\n          <div class=\"panel-tools\">\n            <label class=\"swap panel-maximize\">\n              <input\n                type=\"checkbox\"\n                aria-label=\"Maximize Details\"\n                data-i18n-aria-label-en=\"Maximize Details\"\n                data-i18n-aria-label-de=\"Details maximieren\"\n              />\n              <span class=\"swap-off\"><i data-lucide=\"maximize-2\"></i></span>\n              <span class=\"swap-on\"><i data-lucide=\"minimize-2\"></i></span>\n            </label>\n            <label class=\"swap panel-minimize\">\n              <input\n                type=\"checkbox\"\n                aria-label=\"Minimize Details\"\n                data-i18n-aria-label-en=\"Minimize Details\"\n                data-i18n-aria-label-de=\"Details einklappen\"\n              />\n              <span class=\"swap-off\"><i data-lucide=\"chevron-up\"></i></span>\n              <span class=\"swap-on\"><i data-lucide=\"chevron-down\"></i></span>\n            </label>\n          </div>\n        </header>\n        <div class=\"panel-body\" data-graph-explorer-for=\"kg\" data-graph-explorer-outlet=\"details\"></div>\n      </section>\n    </div>\n    <div class=\"resizer border-layout-south\" data-min=\"96\" data-max=\"520\">\n      <section\n        class=\"card panel\"\n        id=\"kg-relations\"\n        style=\"height: 13rem\"\n        aria-labelledby=\"kg-relations-title\"\n        data-density=\"compact\"\n        data-minimized\n      >\n        <header class=\"panel-header\">\n          <i data-lucide=\"table\" class=\"panel-icon\" aria-hidden=\"true\"></i>\n          <h3 class=\"panel-title\" id=\"kg-relations-title\">\n            <span data-i18n-target=\"kg-t-relations\">Relations</span\n            ><span\n              class=\"kg-title-sub\"\n              id=\"kg-relations-sub\"\n              data-graph-explorer-for=\"kg\"\n              data-graph-explorer-output=\"relations-title\"\n            ></span>\n          </h3>\n          <div class=\"panel-tools\">\n            <label class=\"swap panel-maximize\">\n              <input\n                type=\"checkbox\"\n                aria-label=\"Maximize Relations\"\n                data-i18n-aria-label-en=\"Maximize Relations\"\n                data-i18n-aria-label-de=\"Beziehungen maximieren\"\n              />\n              <span class=\"swap-off\"><i data-lucide=\"maximize-2\"></i></span>\n              <span class=\"swap-on\"><i data-lucide=\"minimize-2\"></i></span>\n            </label>\n            <label class=\"swap panel-minimize\">\n              <input\n                type=\"checkbox\"\n                aria-label=\"Minimize Relations\"\n                data-i18n-aria-label-en=\"Minimize Relations\"\n                data-i18n-aria-label-de=\"Beziehungen einklappen\"\n              />\n              <span class=\"swap-off\"><i data-lucide=\"chevron-up\"></i></span>\n              <span class=\"swap-on\"><i data-lucide=\"chevron-down\"></i></span>\n            </label>\n          </div>\n        </header>\n        <div class=\"panel-body\" data-flush data-graph-explorer-for=\"kg\" data-graph-explorer-outlet=\"relations\"></div>\n      </section>\n    </div>\n  </div>\n  <dialog\n    id=\"kg-palette\"\n    class=\"command\"\n    aria-label=\"Search the graph\"\n    data-i18n-aria-label-en=\"Search the graph\"\n    data-i18n-aria-label-de=\"Den Graphen durchsuchen\"\n    data-density=\"compact\"\n  >\n    <div class=\"command-content\">\n      <div class=\"command-input-wrapper\">\n        <i data-lucide=\"search\" aria-hidden=\"true\"></i>\n        <input\n          class=\"command-input\"\n          type=\"text\"\n          placeholder=\"Domains, systems or entities - or #4711\"\n          aria-label=\"Search\"\n          data-i18n-placeholder-en=\"Domains, systems or entities - or #4711\"\n          data-i18n-placeholder-de=\"Domänen, Systeme oder Entitäten - oder #4711\"\n          data-i18n-aria-label-en=\"Search\"\n          data-i18n-aria-label-de=\"Suchen\"\n          autocomplete=\"off\"\n          autocorrect=\"off\"\n          spellcheck=\"false\"\n          data-kg-find\n        />\n      </div>\n      <div class=\"command-list\">\n        <div class=\"command-group\" data-kg-hits hidden>\n          <p class=\"command-group-heading\" data-i18n-target=\"kg-p-nodes\">Nodes</p>\n        </div>\n        <div class=\"command-separator\"></div>\n        <div class=\"command-group\">\n          <p class=\"command-group-heading\" data-i18n-target=\"kg-p-actions\">Actions</p>\n          <button class=\"command-item\" type=\"button\" data-graph-explorer-for=\"kg\" data-graph-explorer-action=\"fit\">\n            <i data-lucide=\"scan\"></i> <span data-i18n-target=\"kg-p-fit\">Fit the view</span>\n            <span class=\"command-shortcut\">0</span>\n          </button>\n          <button class=\"command-item\" type=\"button\" data-graph-explorer-for=\"kg\" data-graph-explorer-action=\"up\">\n            <i data-lucide=\"arrow-up\"></i> <span data-i18n-target=\"kg-p-out\">Move out</span>\n            <span class=\"command-shortcut\">⌫</span>\n          </button>\n          <button class=\"command-item\" type=\"button\" data-kg-do=\"live\">\n            <i data-lucide=\"radio-tower\"></i> <span data-i18n-target=\"kg-p-live\">Live mode on or off</span>\n          </button>\n          <button class=\"command-item\" type=\"button\" data-kg-do=\"theme\">\n            <i data-lucide=\"sun-moon\"></i> <span data-i18n-target=\"kg-p-theme\">Light or dark</span>\n          </button>\n          <button class=\"command-item\" type=\"button\" data-graph-explorer-for=\"kg\" data-graph-explorer-action=\"help\">\n            <i data-lucide=\"keyboard\"></i> <span data-i18n-target=\"kg-p-help\">Keyboard map</span>\n            <span class=\"command-shortcut\">?</span>\n          </button>\n        </div>\n      </div>\n      <div class=\"command-empty\" hidden data-i18n-target=\"kg-p-empty\">No node or action matches.</div>\n      <p class=\"kg-palette-status\" aria-live=\"polite\" data-kg-find-status></p>\n    </div>\n  </dialog>\n  <template data-i18n-for=\"kg-brand-sub\" data-i18n-locale=\"en\">knowledge graph</template>\n  <template data-i18n-for=\"kg-brand-sub\" data-i18n-locale=\"de\">Wissensgraph</template>\n  <template data-i18n-for=\"kg-out\" data-i18n-locale=\"en\">Out</template>\n  <template data-i18n-for=\"kg-out\" data-i18n-locale=\"de\">Hinaus</template>\n  <template data-i18n-for=\"kg-fit\" data-i18n-locale=\"en\">Fit</template>\n  <template data-i18n-for=\"kg-fit\" data-i18n-locale=\"de\">Einpassen</template>\n  <template data-i18n-for=\"kg-live\" data-i18n-locale=\"en\">Live mode<