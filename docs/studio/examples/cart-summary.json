[{"label":"Default","html":"<aside class=\"mk-cart-summary\" aria-labelledby=\"cs-title\" style=\"max-width: 24rem\">\n  <h2 class=\"mk-cart-summary-title\" id=\"cs-title\">Order summary</h2>\n  <div class=\"mk-cart-summary-shipping\"\n    ><label for=\"cs-free\">Add <strong>€16.00</strong> more for free shipping</label\n    ><progress class=\"progress\" id=\"cs-free\" value=\"84\" max=\"100\">84%</progress></div\n  >\n  <dl class=\"mk-cart-summary-lines\">\n    <div><dt>Subtotal (3 items)</dt><dd>€108.00</dd></div>\n    <div data-discount><dt>Discount · AUTUMN30</dt><dd>−€24.00</dd></div>\n    <div><dt>Shipping</dt><dd>€4.90</dd></div>\n    <div><dt>VAT (included)</dt><dd>€16.62</dd></div>\n  </dl>\n  <div class=\"mk-cart-summary-total\"\n    ><span>Total<small>incl. VAT</small></span\n    ><output aria-live=\"polite\">€88.90</output></div\n  >\n  <a class=\"btn mk-cart-summary-checkout\" data-size=\"lg\" href=\"#\">Checkout <i data-lucide=\"arrow-right\"></i></a>\n  <ul class=\"mk-cart-summary-pay\" aria-label=\"We accept\"\n    ><li>VISA</li\n    ><li>MASTERCARD</li\n    ><li>PAYPAL</li\n    ><li>APPLE PAY</li\n    ><li>KLARNA</li></ul\n  >\n  <p class=\"mk-cart-summary-note\"><i data-lucide=\"lock\"></i> Secure checkout · 30-day returns</p>\n</aside>\n","individual":true},{"label":"Compact","html":"<aside class=\"mk-cart-summary\" data-variant=\"compact\" aria-label=\"Cart total\" style=\"max-width: 22rem\">\n  <div class=\"mk-cart-summary-total\"\n    ><span>Subtotal<small>Shipping at checkout</small></span\n    ><output aria-live=\"polite\">€108.00</output></div\n  >\n  <a class=\"btn mk-cart-summary-checkout\" href=\"#\">Checkout</a>\n</aside>\n","individual":true}]
