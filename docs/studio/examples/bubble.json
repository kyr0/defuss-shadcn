ass=\"bubble-content\">Oh, no worries!</div></div>\n    <div class=\"bubble\"><div class=\"bubble-content\">Can you tell me what's the issue exactly?</div></div>\n    <div class=\"bubble\"><div class=\"bubble-content\">A screenshot helps too.</div></div>\n  </div>\n</div>\n","individual":false},{"label":"Links and buttons","html":"<div class=\"flex flex-col gap-2\" style=\"max-width: 28rem\">\n  <div class=\"bubble\" data-variant=\"secondary\" data-tail\n    ><div class=\"bubble-content\">How can I help you today?</div></div\n  >\n  <div class=\"bubble\" data-variant=\"outline\" data-align=\"end\"\n    ><button class=\"bubble-content\" type=\"button\">I forgot my password</button></div\n  >\n  <div class=\"bubble\" data-variant=\"outline\" data-align=\"end\"\n    ><button class=\"bubble-content\" type=\"button\">I need help with my subscription</button></div\n  >\n  <div class=\"bubble\" data-variant=\"outline\" data-align=\"end\"\n    ><a class=\"bubble-content\" href=\"#contact\">Something else →</a></div\n  >\n</div>\n","individual":false},{"label":"Reactions","html":"<div class=\"flex flex-col gap-5\" style=\"max-width: 28rem\">\n  <div class=\"bubble\" data-variant=\"secondary\">\n    <div class=\"bubble-content\">We hit 10,000 users this morning!</div>\n    <div class=\"bubble-reactions\" role=\"img\" aria-label=\"Reactions: party popper, clapping hands\"\n      ><span>🎉</span><span>👏</span></div\n    >\n  </div>\n  <div class=\"bubble\" data-align=\"end\">\n    <div class=\"bubble-content\">Wow - that was quick.</div>\n    <div class=\"bubble-reactions\" data-align=\"start\" role=\"img\" aria-label=\"Reactions: eyes, rocket and 2 more\"\n      ><span>👀</span><span>🚀</span><span class=\"bubble-reactions-count\">+2</span></div\n    >\n  </div>\n  <div class=\"bubble\" data-variant=\"secondary\">\n    <div class=\"bubble-reactions\" data-side=\"top\" role=\"img\" aria-label=\"Reactions: thumbs up, surprised face\"\n      ><span>👍</span><span>😮</span></div\n    >\n    <div class=\"bubble-content\">Launch party on Friday?</div>\n  </div>\n</div>\n","individual":false},{"label":"With a tooltip","html":"<div class=\"flex flex-col gap-3\" style=\"max-width: 28rem\">\n  <div class=\"bubble\" data-align=\"end\">\n    <button class=\"bubble-content\" type=\"button\" data-tooltip-trigger=\"bubble-read\"\n      >Did you remove the stale route?</button\n    >\n  </div>\n  <div class=\"tooltip\" id=\"bubble-read\" popover=\"hint\" role=\"tooltip\">Read · 10:42</div>\n</div>\n","individual":false},{"label":"With a popover","html":"<div class=\"flex flex-col gap-3\" style=\"max-width: 28rem; min-height: 15rem\">\n  <div class=\"bubble\" data-variant=\"secondary\"><div class=\"bubble-content\">Run the build script, please.</div></div>\n  <div class=\"bubble\" data-variant=\"destructive\">\n    <button class=\"bubble-content\" type=\"button\" popovertarget=\"bubble-error\">Build failed - show details</button>\n  </div>\n  <div class=\"popover\" id=\"bubble-error\" popover>\n    <div class=\"popover-header\">\n      <p class=\"popover-title\">Exit code 1</p>\n      <p class=\"popover-description\">src/app.ts:42 - Cannot find module './routes/stale'</p>\n    </div>\n  </div>\n</div>\n","individual":false},{"label":"Media","html":"<div class=\"flex flex-col gap-3\" style=\"max-width: 28rem\">\n  <div class=\"bubble\" data-align=\"end\">\n    <div class=\"bubble-content\" data-media style=\"width: 16rem\">\n      <img\n        src=\"https://picsum.photos/id/1015/640/400\"\n        alt=\"A river running through a green valley\"\n        width=\"640\"\n        height=\"400\"\n        loading=\"lazy\"\n      />\n      <p class=\"bubble-caption\">The view from today's hike 🏞️</p>\n    </div>\n  </div>\n  <div class=\"bubble\" data-variant=\"secondary\"><div class=\"bubble-content\">Wow, where is that?</div></div>\n</div>\n","individual":false},{"label":"Typing","html":"<div class=\"flex flex-col gap-3\" style=\"max-width: 28rem\">\n  <div class=\