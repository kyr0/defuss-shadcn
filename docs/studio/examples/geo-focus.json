[{"label":"Search a region","html":"<div class=\"grid gap-3\">\n  <div class=\"flex flex-wrap items-center gap-2\">\n    <input\n      class=\"input max-w-72\"\n      type=\"search\"\n      data-geo-for=\"finder\"\n      data-geo-action=\"search\"\n      placeholder=\"A continent, a country or a state\"\n      aria-label=\"Search a region\"\n    />\n    <button class=\"btn\" data-variant=\"outline\" type=\"button\" data-geo-for=\"finder\" data-geo-action=\"up\">Up</button>\n    <button class=\"btn\" data-variant=\"ghost\" type=\"button\" data-geo-for=\"finder\" data-geo-action=\"reset\">World</button>\n  </div>\n  <div class=\"geo-map\" id=\"finder\" aria-label=\"Find a region\" data-highlight=\"outline\"></div>\n  <p class=\"text-sm m-0\">\n    Framed: <output data-geo-for=\"finder\" data-geo-output=\"focus\"></output> - showing its\n    <output data-geo-for=\"finder\" data-geo-output=\"level\"></output> regions\n  </p>\n</div>\n","individual":false},{"label":"Europe, then Germany, then one state","html":"<div class=\"grid gap-3\">\n  <div class=\"flex flex-wrap gap-2\">\n    <button\n      class=\"btn\"\n      data-variant=\"outline\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-geo-for=\"drill\"\n      data-geo-action=\"focus\"\n      data-value=\"continent:Europe\"\n      >Europe</button\n    >\n    <button\n      class=\"btn\"\n      data-variant=\"outline\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-geo-for=\"drill\"\n      data-geo-action=\"focus\"\n      data-value=\"country:DEU\"\n      >Germany</button\n    >\n    <button\n      class=\"btn\"\n      data-variant=\"outline\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-geo-for=\"drill\"\n      data-geo-action=\"focus\"\n      data-value=\"Bavaria\"\n      >Bavaria</button\n    >\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" data-geo-for=\"drill\" data-geo-action=\"focus\"\n      >Frame the picked region</button\n    >\n    <button class=\"btn\" data-variant=\"ghost\" data-size=\"sm\" type=\"button\" data-geo-for=\"drill\" data-geo-action=\"up\"\n      >Up</button\n    >\n  </div>\n  <div class=\"geo-map\" id=\"drill\" aria-label=\"Drill down\" data-highlight=\"lift\"></div>\n</div>\n","individual":false},{"label":"Opened on a focus","html":"<div class=\"grid gap-3\" style=\"grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); --geo-map-height: 18rem\">\n  <div class=\"geo-map\" aria-label=\"France\" data-focus=\"country:FRA\" data-palette=\"sunset\"></div>\n  <div class=\"geo-map\" aria-label=\"Japan\" data-focus=\"country:JPN\" data-palette=\"ocean\"></div>\n</div>\n","individual":false},{"label":"A guided flight","html":"<div class=\"grid gap-3\">\n  <button class=\"btn\" data-size=\"sm\" type=\"button\" id=\"fly\" style=\"justify-self: start\">Fly</button>\n  <div class=\"geo-map\" id=\"guided\" aria-label=\"A guided flight\" data-palette=\"forest\"></div>\n  <ol class=\"text-sm m-0\" id=\"guided-log\"></ol>\n</div>\n","individual":false}]
