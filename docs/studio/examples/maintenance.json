[{"label":"Default","html":"<section class=\"mk-maintenance\" role=\"status\" aria-labelledby=\"mt-title\">\n  <span class=\"mk-maintenance-icon\" aria-hidden=\"true\"><i data-lucide=\"wrench\"></i></span>\n  <h1 class=\"mk-maintenance-title\" id=\"mt-title\">We're upgrading Acme</h1>\n  <p class=\"mk-maintenance-text\"\n    >Our database moves to faster servers. Your data is safe and nothing is lost - you just can't sign in for a little\n    while.</p\n  >\n  <div class=\"mk-maintenance-eta\"\n    ><span\n      >Back by <strong><time datetime=\"2026-10-05T03:00Z\">03:00 UTC</time></strong> (in about 40 minutes)</span\n    ><progress class=\"progress\" max=\"100\" aria-label=\"Work in progress\"></progress\n  ></div>\n  <div class=\"mk-maintenance-links\"\n    ><a class=\"btn\" data-variant=\"outline\" href=\"#\"><i data-lucide=\"activity\"></i> Status page</a\n    ><a class=\"btn\" data-variant=\"ghost\" href=\"#\">Contact support</a></div\n  >\n</section>\n","individual":true},{"label":"Banner","html":"<section class=\"mk-maintenance\" data-variant=\"banner\" role=\"status\" aria-label=\"Scheduled maintenance\">\n  <span class=\"mk-maintenance-icon\" aria-hidden=\"true\"><i data-lucide=\"calendar-clock\"></i></span>\n  <p class=\"mk-maintenance-text\"\n    >Scheduled maintenance <time datetime=\"2026-10-05T02:00Z\">Sunday 5 October, 02:00–03:00 UTC</time> - sync pauses for\n    up to 10 minutes.</p\n  >\n  <a href=\"#\">Details</a>\n</section>\n","individual":true}]
