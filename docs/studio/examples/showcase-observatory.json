[{"label":"Hill Observatory, public nights","html":"<style>\n  @import url('https://fonts.googleapis.com/css2?family=Unbounded:wght@500;800&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap');\n  /* Hill Observatory: a hill outside town with a 60 cm telescope and public nights on Fridays. Layout: the sky as\n     the hero with tonight's conditions beside the title, a table of what is up by brightness, a constellation card\n     with a hint, the next public night as a ticket. */\n  #sc-observatory {\n    --background: oklch(0.16 0.04 265);\n    --foreground: oklch(0.95 0.015 250);\n    --card: oklch(0.21 0.045 265);\n    --card-foreground: var(--foreground);\n    --muted: oklch(0.24 0.045 265);\n    --muted-foreground: oklch(0.76 0.03 255);\n    --border: oklch(0.34 0.05 265);\n    --input: var(--border);\n    --primary: oklch(0.86 0.1 85);\n    --primary-foreground: oklch(0.16 0.04 265);\n    --secondary: oklch(0.26 0.05 265);\n    --secondary-foreground: var(--foreground);\n    --accent: oklch(0.86 0.1 85);\n    --accent-foreground: oklch(0.16 0.04 265);\n    --ring: var(--primary);\n    --radius: 0.75rem;\n    --radius-sm: max(0px, calc(var(--radius) - 4px));\n    --radius-md: max(0px, calc(var(--radius) - 2px));\n    --radius-lg: var(--radius);\n    --radius-xl: calc(var(--radius) + 4px);\n    --ob-moon: oklch(0.95 0.02 90);\n    --ob-shadow: oklch(0.16 0.04 265);\n    --ob-star: oklch(0.95 0.03 90);\n    color-scheme: dark;\n    box-sizing: border-box;\n    width: 100%;\n    overflow-x: clip;\n    padding: 0 0 clamp(2rem, 5vw, 4rem);\n    background: var(--background);\n    color: var(--foreground);\n    font-family: 'IBM Plex Sans', var(--font-sans);\n  }\n  #sc-observatory[data-look='red'] {\n    --background: oklch(0.12 0.03 25);\n    --foreground: oklch(0.62 0.21 27);\n    --card: oklch(0.16 0.05 25);\n    --muted: oklch(0.18 0.05 25);\n    --muted-foreground: oklch(0.5 0.17 27);\n    --border: oklch(0.3 0.09 27);\n    --primary: oklch(0.62 0.21 27);\n    --primary-foreground: oklch(0.12 0.03 25);\n    --secondary: oklch(0.2 0.06 25);\n    --secondary-foreground: oklch(0.62 0.21 27);\n    --accent: oklch(0.62 0.21 27);\n    --accent-foreground: oklch(0.12 0.03 25);\n    --ob-moon: oklch(0.62 0.21 27);\n    --ob-shadow: oklch(0.12 0.03 25);\n    --ob-star: oklch(0.62 0.21 27);\n  }\n  #sc-observatory[data-look='day'] {\n    color-scheme: light;\n    --background: oklch(0.88 0.06 235);\n    --foreground: oklch(0.24 0.07 260);\n    --card: oklch(0.97 0.015 235);\n    --muted: oklch(0.92 0.03 235);\n    --muted-foreground: oklch(0.42 0.06 255);\n    --border: oklch(0.24 0.07 260 / 0.2);\n    --primary: oklch(0.42 0.14 260);\n    --primary-foreground: oklch(0.97 0.015 235);\n    --secondary: oklch(0.92 0.03 235);\n    --secondary-foreground: oklch(0.24 0.07 260);\n    --accent: oklch(0.82 0.13 80);\n    --accent-foreground: oklch(0.24 0.07 260);\n    --ob-moon: oklch(0.99 0.01 90);\n    --ob-shadow: oklch(0.8 0.05 235);\n    --ob-star: oklch(0.42 0.14 260);\n  }\n  #sc-observatory .ob-only {\n    display: none;\n  }\n  #sc-observatory:not([data-look='day']) .ob-only[data-for='night'],\n  #sc-observatory[data-look='day'] .ob-only[data-for='day'] {\n    display: block;\n  }\n  #sc-observatory[data-look='red'] .ob-only[data-for='night'] {\n    filter: grayscale(1) sepia(1) hue-rotate(-50deg) saturate(6) brightness(0.7);\n  }\n  #sc-observatory .ob-page {\n    display: flex;\n    flex-direction: column;\n    gap: clamp(3.5rem, 8vw, 6rem);\n    box-sizing: content-box;\n    max-width: 72rem;\n    margin: clamp(3.5rem, 8vw, 6rem) auto 0;\n    padding-inline: clamp(1rem, 3vw, 2.5rem);\n  }\n  #sc-observatory [hidden] {\n    display: none !important;\n  }\n  /* the Site Header: over the sky - the telescope and the name in Unbounded, the sections, the look and the mode */\n  #sc-observatory .ob-bar {\n    grid-column: 1 / -1;\n    align-self: start;\n    background: none;\n    color: inherit;\n  }\n  #sc-observatory .mk-header-inner {\n    flex-wrap: wrap;\n    gap: 0.75rem 1.5rem;\n    max-width: none;\n    min-height: 4.5rem;\n    padding: 0;\n  }\n  #sc-observatory :is(.mk-header-brand, .mk-footer-brand) {\n    gap: 0.6rem;\n    color: inherit;\n  }\n  #sc-observatory :is(.mk-header-brand, .mk-footer-brand) svg {\n    width: 1.25rem;\n    height: 1.25rem;\n    color: var(--primary);\n  }\n  #sc-observatory :is(.mk-header-name, .mk-footer-brand-name) {\n    color: inherit;\n    font:\n      800 1.05rem/1 'Unbounded',\n      sans-serif;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n  }\n  #sc-observatory .mk-header-nav {\n    display: flex;\n    margin-inline-start: auto;\n  }\n  #sc-observatory .nav-menu-link {\n    color: inherit;\n    font-size: 0.9375rem;\n  }\n  #sc-observatory .mk-header-actions {\n    gap: 0.5rem;\n  }\n  /* the sky */\n  #sc-observatory .ob-hero {\n    position: relative;\n    isolation: isolate;\n    display: grid;\n    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);\n    grid-template-rows: auto 1fr;\n    align-items: end;\n    gap: 2rem;\n    min-height: 40rem;\n    padding: 1.25rem max(clamp(1rem, 3vw, 2.5rem), calc((100% - 72rem) / 2)) clamp(2.5rem, 6vw, 4.5rem);\n    overflow: clip;\n  }\n  /* the sky fades into the page below it */\n  #sc-observatory .ob-hero > .shader {\n    mask-image: linear-gradient(#000 72%, transparent);\n  }\n  #sc-observatory .ob-hero h1 {\n    margin: 0;\n    font:\n      800 clamp(2.8rem, 7.5vw, 5.75rem)/0.92 'Unbounded',\n      sans-serif;\n    letter-spacing: -0.03em;\n    text-wrap: balance;\n  }\n  #sc-observatory .ob-hero p {\n    max-width: 30rem;\n    font-size: 1.125rem;\n    line-height: 1.55;\n    color: var(--muted-foreground);\n  }\n  /* the day sky stays bright in dark mode: the light text there sits on a pane of the night ground */\n  .dark #sc-observatory[data-look='day'] .ob-hero p {\n    width: fit-content;\n    padding: 0.625rem 0.875rem;\n    border-radius: var(--radius-md);\n    background: color-mix(in oklch, var(--background) 62%, transparent);\n    backdrop-filter: blur(8px);\n    color: var(--foreground);\n  }\n  /* tonight: the moon, the seeing, the times */\n  #sc-observatory .ob-tonight {\n    display: grid;\n    gap: 1rem;\n    padding: 1.25rem;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    background: color-mix(in oklch, var(--card) 80%, transparent);\n    backdrop-filter: blur(6px);\n    font-family: 'IBM Plex Mono', monospace;\n    font-size: 0.8125rem;\n    rotate: 1.5deg;\n  }\n  #sc-observatory .ob-tonight h2 {\n    margin: 0;\n    font:\n      500 0.75rem/1 'IBM Plex Mono',\n      monospace;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    color: var(--muted-foreground);\n  }\n  #sc-observatory .ob-moon {\n    display: flex;\n    align-items: center;\n    gap: 1rem;\n  }\n  #sc-observatory .ob-moon-disc {\n    flex: none;\n    width: 3.5rem;\n    aspect-ratio: 1;\n    border-radius: 50%;\n    background:\n      radial-gradient(circle at 22% 50%, var(--ob-shadow) 0 38%, transparent 39%),\n      radial-gradient(circle at 60% 35%, color-mix(in oklch, var(--ob-moon) 85%, black) 0 8%, transparent 9%),\n      radial-gradient(circle at 45% 70%, color-mix(in oklch, var(--ob-moon) 88%, black) 0 6%, transparent 7%),\n      var(--ob-moon);\n    box-shadow: 0 0 1.5rem color-mix(in oklch, var(--ob-moon) 40%, transparent);\n  }\n  #sc-observatory .ob-tonight dl {\n    display: grid;\n    grid-template-columns: auto 1fr;\n    gap: 0.35rem 1rem;\n    margin: 0;\n  }\n  #sc-observatory .ob-tonight dt {\n    color: var(--muted-foreground);\n  }\n  #sc-observatory .ob-tonight dd {\n    margin: 0;\n    text-align: end;\n    font-variant-numeric: tabular-nums;\n  }\n  /* what is up, by brightness: the smaller the magnitude, the bigger the dot */\n  #sc-observatory .ob-head {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: baseline;\n    justify-content: space-between;\n    gap: 0.5rem 2rem;\n    margin-block-end: 1.25rem;\n  }\n  #sc-observatory .ob-head h2 {\n    margin: 0;\n    font:\n      800 clamp(1.6rem, 3.5vw, 2.4rem)/1 'Unbounded',\n      sans-serif;\n    letter-spacing: -0.02em;\n  }\n  #sc-observatory .ob-head p {\n    margin: 0;\n    color: var(--muted-foreground);\n  }\n  #sc-observatory .ob-up {\n    width: 100%;\n    border-collapse: collapse;\n    font-size: 0.9375rem;\n  }\n  #sc-observatory .ob-up th {\n    padding: 0.5rem 0.75rem;\n    border-block-end: 1px solid var(--border);\n    text-align: start;\n    font:\n      500 0.6875rem/1 'IBM Plex Mono',\n      monospace;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    color: var(--muted-foreground);\n  }\n  #sc-observatory .ob-up td {\n    padding: 0.8rem 0.75rem;\n    border-block-end: 1px solid var(--border);\n  }\n  #sc-observatory .ob-up td:nth-child(n + 3) {\n    font-family: 'IBM Plex Mono', monospace;\n    font-variant-numeric: tabular-nums;\n  }\n  #sc-observatory .ob-dot {\n    display: inline-block;\n    width: calc((6 - var(--mag)) * 0.32rem);\n    aspect-ratio: 1;\n    margin-inline-end: 0.6rem;\n    border-radius: 50%;\n    background: var(--ob-star);\n    box-shadow: 0 0 0.6rem var(--ob-star);\n    vertical-align: middle;\n  }\n  /* the constellation, pinned up, and how to find it */\n  #sc-observatory .ob-find {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n    align-items: center;\n    gap: clamp(2rem, 5vw, 4rem);\n  }\n  #sc-observatory .ob-chart {\n    position: relative;\n    padding: 1.5rem;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    background: var(--card);\n    rotate: -2deg;\n    box-shadow: 0 1.5rem 2.5rem -1.5rem oklch(0 0 0 / 0.6);\n  }\n  #sc-observatory .ob-chart::before {\n    content: '';\n    position: absolute;\n    top: -0.5rem;\n    left: calc(50% - 0.5rem);\n    width: 1rem;\n    aspect-ratio: 1;\n    border-radius: 50%;\n    background: var(--primary);\n    box-shadow: 0 2px 3px oklch(0 0 0 / 0.5);\n  }\n  #sc-observatory .ob-chart svg {\n    display: block;\n    width: 100%;\n    height: auto;\n    color: var(--ob-star);\n  }\n  #sc-observatory .ob-chart figcaption {\n    margin-block-start: 0.5rem;\n    font:\n      500 0.75rem/1 'IBM Plex Mono',\n      monospace;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    color: var(--muted-foreground);\n  }\n  #sc-observatory .ob-bubble {\n    position: relative;\n    margin: 0 0 2rem;\n    padding: 1.25rem 1.5rem;\n    border-radius: 1.5rem;\n    background: var(--primary);\n    color: var(--primary-foreground);\n    font-size: 1.15rem;\n    line-height: 1.4;\n    rotate: 1.5deg;\n  }\n  #sc-observatory .ob-bubble::after {\n    content: '';\n    position: absolute;\n    left: -1rem;\n    top: 1.6rem;\n    width: 1.3rem;\n    height: 1.3rem;\n    background: inherit;\n    clip-path: polygon(100% 0, 100% 100%, 0 30%);\n  }\n  /* the next public night */\n  #sc-observatory .ob-ticket {\n    --shape-cut: 0.9rem;\n    display: grid;\n    grid-template-columns: auto minmax(0, 1fr) auto;\n    align-items: center;\n    gap: 1rem 1.75rem;\n    padding: 1.5rem 2.25rem;\n    background: var(--primary);\n    color: var(--primary-foreground);\n    rotate: -1.2deg;\n  }\n  #sc-observatory .ob-ticket b {\n    font:\n      800 clamp(1.8rem, 4vw, 2.8rem)/0.95 'Unbounded',\n      sans-serif;\n  }\n  #sc-observatory .ob-ticket small {\n    display: block;\n    font:\n      500 0.75rem/1.4 'IBM Plex Mono',\n      monospace;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n  }\n  #sc-observatory .ob-ticket .btn {\n    background: var(--primary-foreground);\n    color: var(--primary);\n  }\n  /* the Site Footer: how to get up the hill, when the dome opens, tonight's sky, the club and its legal notes */\n  #sc-observatory .mk-footer {\n    background: none;\n    color: inherit;\n  }\n  #sc-observatory .mk-footer-inner {\n    max-width: none;\n    padding: 2rem 0 0;\n    border-block-start: 1px solid var(--border);\n  }\n  #sc-observatory .mk-footer-heading {\n    color: inherit;\n    font:\n      500 0.75rem/1.3 'IBM Plex Mono',\n      monospace;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n  }\n  #sc-observatory .mk-footer address {\n    font-style: normal;\n    line-height: 1.5;\n  }\n  #sc-observatory .ob-note {\n    margin: 0;\n    color: var(--muted-foreground);\n    font-size: 0.875rem;\n    line-height: 1.5;\n  }\n  #sc-observatory .ob-hours {\n    display: grid;\n    gap: 0.15rem;\n    margin: 0;\n    font-size: 0.9375rem;\n  }\n  #sc-observatory .ob-hours dt {\n    color: var(--muted-foreground);\n    font:\n      500 0.75rem/1.4 'IBM Plex Mono',\n      monospace;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n  }\n  #sc-observatory .ob-hours dt:not(:first-child) {\n    margin-block-start: 0.5rem;\n  }\n  #sc-observatory .ob-hours dd {\n    margin: 0;\n  }\n  #sc-observatory .mk-footer-list :is(a, button) {\n    padding: 0;\n    border: 0;\n    background: none;\n    color: inherit;\n    font: inherit;\n    text-align: start;\n    cursor: pointer;\n  }\n  #sc-observatory .mk-footer-list :is(a, button):is(:hover, :focus-visible) {\n    color: var(--primary);\n  }\n  #sc-observatory .mk-footer-rule {\n    margin: 0;\n    background: var(--border);\n  }\n  #sc-observatory .mk-footer-copy {\n    color: var(--muted-foreground);\n  }\n  /* the dialogs: the booking and the legal notes, on the look's card */\n  #sc-observatory .sc-dialog {\n    border: 1px solid var(--border);\n    background: var(--card);\n    color: var(--card-foreground);\n  }\n  #sc-observatory .sc-dialog .dialog-title {\n    font:\n      800 1.35rem/1.15 'Unbounded',\n      sans-serif;\n    letter-spacing: -0.01em;\n  }\n  #sc-observatory .sc-dialog .dialog-description {\n    color: var(--muted-foreground);\n  }\n  #sc-observatory :is(.sc-form, .sc-done) {\n    display: grid;\n    gap: 1rem;\n  }\n  #sc-observatory .sc-row {\n    display: grid;\n    gap: 0.4rem;\n  }\n  #sc-observatory .sc-dialog:not([data-sent]) .sc-done,\n  #sc-observatory .sc-dialog[data-sent] .sc-form {\n    display: none;\n  }\n  #sc-observatory .sc-legal {\n    display: grid;\n    gap: 0.75rem;\n    font-size: 0.9375rem;\n    line-height: 1.55;\n  }\n  #sc-observatory .sc-legal :is(p, address) {\n    margin: 0;\n    font-style: normal;\n  }\n  #sc-observatory .sc-legal a {\n    color: inherit;\n  }\n  @media (max-width: 48rem) {\n    #sc-observatory :is(.ob-hero, .ob-find) {\n      grid-template-columns: 1fr;\n    }\n    #sc-observatory .mk-header-inner {\n      column-gap: 0.75rem;\n    }\n    #sc-observatory .mk-header-name {\n      font-size: 0.8125rem;\n    }\n    #sc-observatory .mk-header-nav {\n      order: 3;\n      width: 100%;\n      margin-inline-start: -0.75rem;\n    }\n    #sc-observatory .mk-header-actions {\n      margin-inline-start: auto;\n    }\n    #sc-observatory .ob-ticket {\n      grid-template-columns: 1fr;\n    }\n    #sc-observatory .ob-up th:nth-child(4),\n    #sc-observatory .ob-up td:nth-child(4) {\n      display: none;\n    }\n  }\n  /* light or dark: the Swap writes the page's dark class - every look has a light and a dark palette */\n  #sc-observatory .site-mode {\n    flex: none;\n    border: 1px solid var(--input);\n    border-radius: var(--radius-md);\n    background: var(--background);\n    color: var(--foreground);\n  }\n  #sc-observatory .site-mode:hover {\n    background: var(--accent);\n    color: var(--accent-foreground);\n  }\n  /* -- modes: each look in light and dark, derived from the palettes above (the other mode of each look) -- */\n  .dark #sc-observatory[data-look='night'] {\n    --accent: oklch(0.25 0.05 85);\n    --accent-foreground: oklch(0.95 0.015 250);\n  }\n  :root:not(.dark) #sc-observatory[data-look='night'] {\n    color-scheme: light;\n    --background: oklch(0.985 0.025 265);\n    --foreground: oklch(0.2 0.015 250);\n    --card: oklch(0.997 0.025 265);\n    --card-foreground: oklch(0.2 0.015 250);\n    --muted: oklch(0.95 0.025 265);\n    --muted-foreground: oklch(0.46 0.03 255);\n    --border: oklch(0.9 0.025 265);\n    --input: oklch(0.88 0.025 265);\n    --primary: oklch(0.54 0.1 85);\n    --primary-foreground: oklch(0.985 0.005 85);\n    --secondary: oklch(0.955 0.025 265);\n    --secondary-foreground: oklch(0.25 0.015 250);\n    --accent: oklch(0.94 0.025 85);\n    --accent-foreground: oklch(0.2 0.015 250);\n    --ring: oklch(0.58 0.1 85);\n    --ob-moon: oklch(0.205 0.02 90);\n    --ob-shadow: oklch(0.984 0.03 265);\n    --ob-star: oklch(0.205 0.03 90);\n    --popover: oklch(0.997 0 0);\n    --popover-foreground: oklch(0.2 0 0);\n  }\n  .dark #sc-observatory[data-look='red'] {\n    --muted-foreground: oklch(0.62 0.17 27);\n    --secondary-foreground: oklch(0.635 0.21 27);\n    --accent: oklch(0.24 0.05 27);\n    --accent-foreground: oklch(0.65 0.21 27);\n  }\n  :root:not(.dark) #sc-observatory[data-look='red'] {\n    color-scheme: light;\n    --background: oklch(0.985 0.025 25);\n    --foreground: oklch(0.2 0.03 27);\n    --card: oklch(0.997 0.025 25);\n    --card-foreground: oklch(0.2 0.03 27);\n    --muted: oklch(0.95 0.025 25);\n    --muted-foreground: oklch(0.46 0.03 27);\n    --border: oklch(0.9 0.025 27);\n    --input: oklch(0.88 0.025 27);\n    --primary: oklch(0.42 0.21 27);\n    --primary-foreground: oklch(0.985 0.005 27);\n    --secondary: oklch(0.955 0.025 25);\n    --secondary-foreground: oklch(0.25 0.03 27);\n    --accent: oklch(0.94 0.025 27);\n    --accent-foreground: oklch(0.2 0.03 27);\n    --ring: oklch(0.42 0.21 27);\n    --ob-moon: oklch(0.42 0.21 27);\n    --ob-shadow: oklch(0.993 0.03 25);\n    --ob-star: oklch(0.42 0.21 27);\n    --popover: oklch(0.997 0 0);\n    --popover-foreground: oklch(0.2 0 0);\n  }\n  :root:not(.dark) #sc-observatory[data-look='day'] {\n    --accent: oklch(0.86 0.045 80);\n  }\n  .dark #sc-observatory[data-look='day'] {\n    color-scheme: dark;\n    --background: oklch(0.17 0.035 235);\n    --foreground: oklch(0.94 0.03 260);\n    --card: oklch(0.205 0.015 235);\n    --card-foreground: oklch(0.94 0.03 260);\n    --muted: oklch(0.24 0.03 235);\n    --muted-foreground: oklch(0.74 0.03 255);\n    --border: oklch(0.95 0.02 260 / 0.14);\n    --input: oklch(0.95 0.02 260 / 0.14);\n    --primary: oklch(0.66 0.14 260);\n    --primary-foreground: oklch(0.17 0.03 260);\n    --secondary: oklch(0.25 0.03 235);\n    --secondary-foreground: oklch(0.9 0.03 260);\n    --accent: oklch(0.26 0.045 80);\n    --accent-foreground: oklch(0.94 0.03 260);\n    --ring: oklch(0.66 0.14 260);\n    --ob-moon: oklch(0.165 0.01 90);\n    --ob-shadow: oklch(0.8 0.05 235);\n    --ob-star: oklch(0.66 0.14 260);\n    --popover: oklch(0.215 0 0);\n    --popover-foreground: oklch(0.94 0 0);\n  }\n  /* -- modes: end -- */\n  /* the hero is the night sky in both modes: in light mode it keeps the look's dark palette, the page below turns light */\n  :root:not(.dark) #sc-observatory:is([data-look='night'], [data-look='red']) .ob-hero {\n    color-scheme: dark;\n    --background: oklch(0.16 0.04 265);\n    --foreground: oklch(0.95 0.015 250);\n    --card: oklch(0.21 0.045 265);\n    --card-foreground: var(--foreground);\n    --muted: oklch(0.24 0.045 265);\n    --muted-foreground: oklch(0.76 0.03 255);\n    --border: oklch(0.34 0.05 265);\n    --input: var(--border);\n    --primary: oklch(0.86 0.1 85);\n    --primary-foreground: oklch(0.16 0.04 265);\n    --accent: oklch(0.27 0.05 265);\n    --accent-foreground: var(--foreground);\n    background: var(--background);\n    color: var(--foreground);\n  }\n  :root:not(.dark) #sc-observatory[data-look='red'] .ob-hero {\n    --background: oklch(0.12 0.03 25);\n    --foreground: oklch(0.66 0.21 27);\n    --card: oklch(0.16 0.05 25);\n    --muted: oklch(0.18 0.05 25);\n    --muted-foreground: oklch(0.62 0.17 27);\n    --border: oklch(0.3 0.09 27);\n    --primary: oklch(0.62 0.21 27);\n    --primary-foreground: oklch(0.12 0.03 25);\n    --accent: oklch(0.22 0.06 25);\n  }\n</style>\n<div id=\"sc-observatory\" data-look=\"night\">\n  <section class=\"ob-hero\" aria-labelledby=\"ob-title\">\n    <div\n      class=\"shader ob-only\"\n      data-for=\"night\"\n      data-variant=\"background\"\n      data-effect=\"starfield\"\n      data-speed=\"0.25\"\n      data-warp=\"0.08\"\n      data-twinkle=\"0.8\"\n      data-density=\"0.5\"\n      data-fps=\"30\"\n      aria-hidden=\"true\"\n    ></div>\n    <div\n      class=\"shader ob-only\"\n      data-for=\"day\"\n      data-variant=\"background\"\n      data-effect=\"clouds\"\n      data-speed=\"0.3\"\n      data-fps=\"30\"\n      aria-hidden=\"true\"\n    ></div>\n    <header class=\"mk-header ob-bar\">\n      <div class=\"mk-header-inner\">\n        <a class=\"mk-header-brand\" href=\"#sc-observatory\"\n          ><i data-lucide=\"telescope\"></i><span class=\"mk-header-name\">Hill Observatory</span></a\n        >\n        <nav class=\"mk-header-nav\" aria-label=\"Site\">\n          <ul class=\"nav-menu-list\">\n            <li class=\"nav-menu-item\"><a class=\"nav-menu-link\" href=\"#ob-up\">Tonight</a></li>\n            <li class=\"nav-menu-item\"><a class=\"nav-menu-link\" href=\"#ob-find\">Find it</a></li>\n            <li class=\"nav-menu-item\"><a class=\"nav-menu-link\" href=\"#ob-night\">Public nights</a></li>\n            <li class=\"nav-menu-item\"><a class=\"nav-menu-link\" href=\"#ob-visit\">Visit</a></li>\n          </ul>\n        </nav>\n        <div class=\"mk-header-actions\">\n          <select class=\"select\" data-size=\"sm\" data-site-look aria-label=\"Look\" style=\"width: auto\">\n            <option value=\"night\">Night sky</option>\n            <option value=\"red\">Red light</option>\n            <option value=\"day\">Day visit</option>\n          </select>\n          <label class=\"swap site-mode\" data-variant=\"rotate\" data-size=\"sm\">\n            <input type=\"checkbox\" data-site-mode aria-label=\"Dark mode\" />\n            <span class=\"swap-on\" aria-hidden=\"true\"><i data-lucide=\"moon\"></i></span>\n            <span class=\"swap-off\" aria-hidden=\"true\"><i data-lucide=\"sun\"></i></span>\n          </label>\n        </div>\n      </div>\n    </header>\n    <div>\n      <h1 id=\"ob-title\">Clear skies from nine tonight</h1>\n      <p\n        >A 60 cm telescope on the hill above town, and an astronomer who will point it at whatever you ask - every\n        Friday after dark.</p\n      >\n      <button class=\"btn\" data-size=\"lg\" type=\"button\" commandfor=\"ob-book\" command=\"show-modal\"\n        >Book a public night</button\n      >\n    </div>\n    <aside class=\"ob-tonight\" aria-labelledby=\"ob-tonight-title\">\n      <h2 id=\"ob-tonight-title\">Tonight · Fri 14 Nov</h2>\n      <div class=\"ob-moon\"\n        ><span class=\"ob-moon-disc\" role=\"img\" aria-label=\"The moon, waxing gibbous\"></span\n        ><span>Waxing gibbous<br />78 % lit, sets 03:12</span></div\n      >\n      <dl>\n        <dt>Sunset</dt>\n        <dd>16:38</dd>\n        <dt>Astronomical dusk</dt>\n        <dd>18:34</dd>\n        <dt>Seeing</dt>\n        <dd>1.8″</dd>\n        <dt>Cloud cover after 21:00</dt>\n        <dd>10 %</dd>\n      </dl>\n    </aside>\n  </section>\n  <div class=\"ob-page\">\n    <section id=\"ob-up\" aria-labelledby=\"ob-up-title\">\n      <div class=\"ob-head\">\n        <h2 id=\"ob-up-title\">What is up</h2>\n        <p>Brightest first - a smaller magnitude is a brighter object</p>\n      </div>\n      <div class=\"overflow-x-auto\">\n        <table class=\"ob-up\">\n          <thead>\n            <tr\n              ><th scope=\"col\">Object</th><th scope=\"col\">Type</th><th scope=\"col\">Magnitude</th\n              ><th scope=\"col\">Best seen</th></tr\n            >\n          </thead>\n          <tbody>\n            <tr\n              ><td><span class=\"ob-dot\" style=\"--mag: 0.9\" aria-hidden=\"true\"></span>Saturn</td><td>Planet</td\n              ><td>0.9</td><td>19:30, south, 32°</td></tr\n            >\n            <tr\n              ><td><span class=\"ob-dot\" style=\"--mag: 1.6\" aria-hidden=\"true\"></span>Pleiades (M45)</td\n              ><td>Open cluster</td><td>1.6</td><td>22:00, east, 48°</td></tr\n            >\n            <tr\n              ><td><span class=\"ob-dot\" style=\"--mag: 3.4\" aria-hidden=\"true\"></span>Andromeda Galaxy (M31)</td\n              ><td>Galaxy</td><td>3.4</td><td>20:00, overhead, 78°</td></tr\n            >\n            <tr\n              ><td><span class=\"ob-dot\" style=\"--mag: 4\" aria-hidden=\"true\"></span>Orion Nebula (M42)</td><td>Nebula</td\n              ><td>4.0</td><td>after 23:30, south-east</td></tr\n            >\n          </tbody>\n        </table>\n      </div>\n    </section>\n    <section id=\"ob-find\" class=\"ob-find\" aria-labelledby=\"ob-find-title\">\n      <figure class=\"ob-chart\" style=\"margin: 0\">\n        <svg viewBox=\"0 0 320 180\" role=\"img\" aria-label=\"Cassiopeia: five stars in the shape of a W\">\n          <polyline\n            points=\"30,60 95,120 160,80 225,130 290,50\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.2\"\n            stroke-dasharray=\"4 5\"\n            opacity=\"0.6\"\n          />\n          <circle cx=\"30\" cy=\"60\" r=\"5\" fill=\"currentColor\" />\n          <circle cx=\"95\" cy=\"120\" r=\"6\" fill=\"currentColor\" />\n          <circle cx=\"160\" cy=\"80\" r=\"7\" fill=\"currentColor\" />\n          <circle cx=\"225\" cy=\"130\" r=\"5.5\" fill=\"currentColor\" />\n          <circle cx=\"290\" cy=\"50\" r=\"4.5\" fill=\"currentColor\" />\n          <circle cx=\"70\" cy=\"25\" r=\"1.5\" fill=\"currentColor\" opacity=\"0.6\" />\n          <circle cx=\"200\" cy=\"30\" r=\"1.2\" fill=\"currentColor\" opacity=\"0.6\" />\n          <circle cx=\"260\" cy=\"160\" r=\"1.4\" fill=\"currentColor\" opacity=\"0.6\" />\n        </svg>\n        <figcaption>Cassiopeia · high in the north-east</figcaption>\n      </figure>\n      <div>\n        <p class=\"ob-bubble\"\n          >Find the W first. Follow its second V down and to the right - the faint smudge there is the Andromeda Galaxy,\n          2.5 million light-years away.</p\n        >\n        <h2 id=\"ob-find-title\" class=\"ob-head\" style=\"margin: 0\"\n          ><span\n            style=\"\n              font:\n                800 clamp(1.6rem, 3.5vw, 2.4rem)/1 'Unbounded',\n                sans-serif;\n              letter-spacing: -0.02em;\n            \"\n            >Find it yourself</span\n          ></h2\n        >\n      </div>\n    </section>\n    <section id=\"ob-night\" class=\"ob-ticket ticket\" aria-labelledby=\"ob-night-title\">\n      <b id=\"ob-night-title\">Fri 14 Nov</b>\n      <span\n        ><small>Public night · doors 19:30 · 2 hours</small>Up to 24 visitors, warm clothes, no telescope needed.\n        Cancelled if it is cloudy - we email at 17:00.</span\n      >\n      <button class=\"btn\" type=\"button\" commandfor=\"ob-book\" command=\"show-modal\">€6 · Book</button>\n    </section>\n    <footer id=\"ob-visit\" class=\"mk-footer\">\n      <div class=\"mk-footer-inner\">\n        <nav class=\"mk-footer-nav\" aria-label=\"Footer\">\n          <div class=\"mk-footer-col\">\n            <h3 class=\"mk-footer-heading\">Find the hill</h3>\n            <address>Hill Observatory<br />Sternwartenweg 3<br />412 m above sea level</address>\n            <p class=\"ob-note\">Bus 7 to Sternwarte, then ten minutes uphill on foot.</p>\n          </div>\n          <div class=\"mk-footer-col\">\n            <h3 class=\"mk-footer-heading\">When we open</h3>\n            <dl class=\"ob-hours\">\n              <dt>Public nights</dt>\n              <dd>Fridays, doors 19:30</dd>\n              <dt>Sun telescope</dt>\n              <dd>Sundays 14:00 - 16:00</dd>\n              <dt>Cloudy?</dt>\n              <dd>We email at 17:00</dd>\n            </dl>\n          </div>\n          <div class=\"mk-footer-col\">\n            <h3 class=\"mk-footer-heading\">Tonight</h3>\n            <ul class=\"mk-footer-list\">\n              <li><a href=\"#ob-up\">What is up</a></li>\n              <li><a href=\"#ob-find\">Find it yourself</a></li>\n              <li><a href=\"#ob-night\">The next public night</a></li>\n              <li><button type=\"button\" commandfor=\"ob-book\" command=\"show-modal\">Book a night</button></li>\n            </ul>\n          </div>\n          <div class=\"mk-footer-col\">\n            <h3 class=\"mk-footer-heading\">The club</h3>\n            <ul class=\"mk-footer-list\">\n              <li><a href=\"mailto:night@example.com\">night@example.com</a></li>\n              <li><button type=\"button\" commandfor=\"ob-imprint\" command=\"show-modal\">Imprint</button></li>\n              <li><button type=\"button\" commandfor=\"ob-privacy\" command=\"show-modal\">Privacy</button></li>\n            </ul>\n          </div>\n        </nav>\n        <hr class=\"separator mk-footer-rule\" />\n        <div class=\"mk-footer-bottom\">\n          <a class=\"mk-footer-brand\" href=\"#sc-observatory\"\n            ><i data-lucide=\"telescope\"></i><span class=\"mk-footer-brand-name\">Hill Observatory</span></a\n          >\n          <div class=\"mk-footer-meta\">\n            <p class=\"mk-footer-copy\">Bring a torch with a red filter - white light ruins everyone's night vision.</p>\n          </div>\n        </div>\n      </div>\n    </footer>\n  </div>\n  <dialog class=\"dialog sc-dialog\" id=\"ob-book\" aria-labelledby=\"ob-book-title\">\n    <div class=\"dialog-content\">\n      <form class=\"sc-form\" data-sc-form>\n        <div class=\"dialog-header\">\n          <h2 class=\"dialog-title\" id=\"ob-book-title\">Book a public night</h2>\n          <p class=\"dialog-description\"\n            >Two hours at the 60 cm telescope with an astronomer. €6 a person, paid at the door.</p\n          >\n        </div>\n        <div class=\"sc-row\">\n          <label class=\"label\" for=\"ob-book-night\">Which Friday?</label>\n          <select class=\"select\" id=\"ob-book-night\" name=\"night\">\n            <option>Fri 14 Nov - 6 places left</option>\n            <option>Fri 21 Nov - 15 places left</option>\n            <option>Fri 28 Nov - 22 places left</option>\n          </select>\n        </div>\n        <div class=\"sc-row\">\n          <label class=\"label\" for=\"ob-book-people\">How many of you?</label>\n          <input\n            class=\"input\"\n            id=\"ob-book-people\"\n            name=\"people\"\n            type=\"number\"\n            min=\"1\"\n            max=\"6\"\n            value=\"2\"\n            inputmode=\"numeric\"\n            required\n          />\n        </div>\n        <div class=\"sc-row\">\n          <label class=\"label\" for=\"ob-book-name\">Name</label>\n          <input class=\"input\" id=\"ob-book-name\" name=\"name\" autocomplete=\"name\" required />\n        </div>\n        <div class=\"sc-row\">\n          <label class=\"label\" for=\"ob-book-mail\">Email - for the cloud warning</label>\n          <input class=\"input\" id=\"ob-book-mail\" name=\"email\" type=\"email\" autocomplete=\"email\" required />\n        </div>\n        <div class=\"dialog-footer\">\n          <button class=\"btn\" data-variant=\"outline\" type=\"button\" commandfor=\"ob-book\" command=\"close\">Cancel</button>\n          <button class=\"btn\" type=\"submit\">Book my places</button>\n        </div>\n      </form>\n      <div class=\"sc-done\" tabindex=\"-1\">\n        <h2 class=\"dialog-title\">See you on the hill</h2>\n        <p class=\"dialog-description\"\n          >Doors open at 19:30. If the sky closes, we email you at 17:00 and your places move to the next clear Friday.\n          Dress for a cold dome.</p\n        >\n        <div class=\"dialog-footer\">\n          <button class=\"btn\" type=\"button\" commandfor=\"ob-book\" command=\"close\">Close</button>\n        </div>\n      </div>\n    </div>\n  </dialog>\n  <dialog class=\"dialog sc-dialog\" id=\"ob-imprint\" aria-labelledby=\"ob-imprint-title\">\n    <div class=\"dialog-content\">\n      <div class=\"dialog-header\">\n        <h2 class=\"dialog-title\" id=\"ob-imprint-title\">Imprint</h2>\n        <p class=\"dialog-description\">Who runs this site</p>\n      </div>\n      <div class=\"sc-legal\">\n        <address>Hill Observatory, a registered club<br />Sternwartenweg 3<br />412 m above sea level</address>\n        <p>Chair of the board: Dr. Lea Brandt<br />Register of associations: VR 0000</p>\n        <p>Contact: <a href=\"mailto:night@example.com\">night@example.com</a></p>\n      </div>\n      <div class=\"dialog-footer\">\n        <button class=\"btn\" type=\"button\" commandfor=\"ob-imprint\" command=\"close\">Close</button>\n      </div>\n    </div>\n  </dialog>\n  <dialog class=\"dialog sc-dialog\" id=\"ob-privacy\" aria-labelledby=\"ob-privacy-title\">\n    <div class=\"dialog-content\">\n      <div class=\"dialog-header\">\n        <h2 class=\"dialog-title\" id=\"ob-privacy-title\">Privacy</h2>\n        <p class=\"dialog-description\">What we keep, and why</p>\n      </div>\n      <div class=\"sc-legal\">\n        <p>This site sets no cookies and runs no trackers. The fonts come from Google Fonts.</p>\n        <p\n          >For a booking we keep your name and email until the night is over - to send the cloud warning at 17:00 - and\n          delete them the week after. We never pass them on.</p\n        >\n        <p>Questions or a request to delete: <a href=\"mailto:privacy@example.com\">privacy@example.com</a></p>\n      </div>\n      <div class=\"dialog-footer\">\n        <button class=\"btn\" type=\"button\" commandfor=\"ob-privacy\" command=\"close\">Close</button>\n      </div>\n    </div>\n  </dialog>\n</div>\n","individual":false}]
