[{"label":"QR Code (sm)","html":"<figure class=\"qr-code\" data-value=\"https://example.com\" data-ecc=\"L\" data-size=\"sm\">\n  <div class=\"qr-code-symbol\" role=\"img\" aria-label=\"QR code with error correction L\"></div>\n  <output class=\"qr-code-status\" hidden></output>\n  <figcaption class=\"qr-code-caption\">L</figcaption>\n</figure>\n","individual":true},{"label":"QR Code (outline, lg)","html":"<figure class=\"qr-code\" data-value=\"https://example.com\" data-size=\"lg\" data-variant=\"outline\">\n  <div class=\"qr-code-symbol\" role=\"img\" aria-label=\"Large QR code for example.com\"></div>\n  <output class=\"qr-code-status\" hidden></output>\n  <figcaption class=\"qr-code-caption\">Large · outline</figcaption>\n</figure>\n","individual":true},{"label":"QR Code (outline, md)","html":"<figure class=\"qr-code\" data-value=\"https://example.com\" data-size=\"md\" data-variant=\"outline\">\n  <div class=\"qr-code-symbol\" role=\"img\" aria-label=\"Medium QR code for example.com\"></div>\n  <output class=\"qr-code-status\" hidden></output>\n  <figcaption class=\"qr-code-caption\">Medium · outline</figcaption>\n</figure>\n","individual":true},{"label":"QR Code (plain, sm)","html":"<figure class=\"qr-code\" data-value=\"https://example.com\" data-size=\"sm\" data-variant=\"plain\">\n  <div class=\"qr-code-symbol\" role=\"img\" aria-label=\"Small QR code for example.com\"></div>\n  <output class=\"qr-code-status\" hidden></output>\n  <figcaption class=\"qr-code-caption\">Small · plain</figcaption>\n</figure>\n","individual":true},{"label":"Unicode","html":"<figure class=\"qr-code\" data-value=\"Grüße, Мир, 漢字, é, 😀\" data-ecc=\"Q\" data-variant=\"outline\">\n  <div class=\"qr-code-symbol\" role=\"img\" aria-label=\"QR code with multilingual example text\"></div>\n  <output class=\"qr-code-status\" hidden></output>\n  <figcaption class=\"qr-code-caption\">Grüße, Мир, 漢字, é, 😀</figcaption>\n</figure>\n","individual":true},{"label":"Fixed version and custom size","html":"<figure\n  class=\"qr-code\"\n  data-value=\"Longer payloads need a larger printed or displayed square. Version 10 keeps a fixed matrix size for this example.\"\n  data-version=\"10\"\n  data-ecc=\"M\"\n  data-variant=\"outline\"\n  style=\"--qr-code-size: 360px\"\n>\n  <div class=\"qr-code-symbol\" role=\"img\" aria-label=\"Version 10 QR code with sizing guidance\"></div>\n  <output class=\"qr-code-status\" hidden></output>\n  <figcaption class=\"qr-code-caption\">Version 10 · 360px</figcaption>\n</figure>\n","individual":true},{"label":"Empty input","html":"<figure class=\"qr-code\" data-value=\"\" data-variant=\"outline\">\n  <div class=\"qr-code-symbol\" role=\"img\" aria-label=\"QR code awaiting data\"></div>\n  <output class=\"qr-code-status\" hidden></output>\n  <figcaption class=\"qr-code-caption\">Empty input</figcaption>\n</figure>\n","individual":true},{"label":"Capacity error","html":"<figure\n  class=\"qr-code\"\n  data-value=\"https://example.com/this-payload-is-too-long-for-version-one-high-error-correction\"\n  data-version=\"1\"\n  data-ecc=\"H\"\n  data-variant=\"outline\"\n>\n  <div class=\"qr-code-symbol\" role=\"img\" aria-label=\"QR code with insufficient capacity\"></div>\n  <output class=\"qr-code-status\" hidden></output>\n  <figcaption class=\"qr-code-caption\">Capacity exceeded</figcaption>\n</figure>\n","individual":true},{"label":"Project link","html":"<div class=\"flex flex-col items-start gap-3\">\n  <figure\n    id=\"project-qr\"\n    class=\"qr-code\"\n    data-value=\"https://shadcn.defuss.org/\"\n    data-ecc=\"M\"\n    data-version=\"auto\"\n    data-size=\"md\"\n    data-variant=\"outline\"\n    data-state-demo\n  >\n    <div class=\"qr-code-symbol\" role=\"img\" aria-label=\"QR code for defuss-shadcn documentation\"></div>\n    <output class=\"qr-code-status\" hidden></output>\n    <figcaption class=\"qr-code-caption\">Project documentation</figcaption>\n  </figure>\n  <a href=\"https://shadcn.defuss.org/\">Open documentation</a>\n</div>\n","individual":false},{"label":"Sizes and variants","html":"<div class=\"flex flex-wrap items-start gap-4\">\n  <figure class=\"qr-code\" data-value=\"https://example.com\" data-size=\"sm\" data-variant=\"plain\">\n    <div class=\"qr-code-symbol\" role=\"img\" aria-label=\"Small QR code for example.com\"></div>\n    <output class=\"qr-code-status\" hidden></output>\n    <figcaption class=\"qr-code-caption\">Small · plain</figcaption>\n  </figure>\n  <figure class=\"qr-code\" data-value=\"https://example.com\" data-size=\"md\" data-variant=\"outline\">\n    <div class=\"qr-code-symbol\" role=\"img\" aria-label=\"Medium QR code for example.com\"></div>\n    <output class=\"qr-code-status\" hidden></output>\n    <figcaption class=\"qr-code-caption\">Medium · outline</figcaption>\n  </figure>\n  <figure class=\"qr-code\" data-value=\"https://example.com\" data-size=\"lg\" data-variant=\"outline\">\n    <div class=\"qr-code-symbol\" role=\"img\" aria-label=\"Large QR code for example.com\"></div>\n    <output class=\"qr-code-status\" hidden></output>\n    <figcaption class=\"qr-code-caption\">Large · outline</figcaption>\n  </figure>\n</div>\n","individual":false},{"label":"Error correction","html":"<div class=\"flex flex-wrap items-start gap-4\">\n  <figure class=\"qr-code\" data-value=\"https://example.com\" data-ecc=\"L\" data-size=\"sm\">\n    <div class=\"qr-code-symbol\" role=\"img\" aria-label=\"QR code with error correction L\"></div>\n    <output class=\"qr-code-status\" hidden></output>\n    <figcaption class=\"qr-code-caption\">L</figcaption>\n  </figure>\n  <figure class=\"qr-code\" data-value=\"https://example.com\" data-ecc=\"M\" data-size=\"sm\">\n    <div class=\"qr-code-symbol\" role=\"img\" aria-label=\"QR code with error correction M\"></div>\n    <output class=\"qr-code-status\" hidden></output>\n    <figcaption class=\"qr-code-caption\">M · default</figcaption>\n  </figure>\n  <figure class=\"qr-code\" data-value=\"https://example.com\" data-ecc=\"Q\" data-size=\"sm\">\n    <div class=\"qr-code-symbol\" role=\"img\" aria-label=\"QR code with error correction Q\"></div>\n    <output class=\"qr-code-status\" hidden></output>\n    <figcaption class=\"qr-code-caption\">Q</figcaption>\n  </figure>\n  <figure class=\"qr-code\" data-value=\"https://example.com\" data-ecc=\"H\" data-size=\"sm\">\n    <div class=\"qr-code-symbol\" role=\"img\" aria-label=\"QR code with error correction H\"></div>\n    <output class=\"qr-code-status\" hidden></output>\n    <figcaption class=\"qr-code-caption\">H</figcaption>\n  </figure>\n</div>\n","individual":false},{"label":"Dark surface","html":"<div\n  class=\"dark flex flex-col items-start gap-3 p-4\"\n  style=\"background: var(--background); color: var(--foreground); border-radius: var(--radius-lg)\"\n>\n  <figure class=\"qr-code\" data-value=\"https://example.com\" data-variant=\"outline\">\n    <div class=\"qr-code-symbol\" role=\"img\" aria-label=\"QR code for example.com\"></div>\n    <output class=\"qr-code-status\" hidden></output>\n    <figcaption class=\"qr-code-caption\">Continue on another device</figcaption>\n  </figure>\n  <a href=\"https://example.com\">Open example.com</a>\n</div>\n","individual":false},{"label":"Live value, feedback and recovery","html":"<div class=\"flex flex-col items-start gap-3\">\n  <label class=\"label\" for=\"qr-live-value\">Text to encode</label>\n  <input class=\"input\" id=\"qr-live-value\" value=\"https://example.com/live\" style=\"max-width: 28rem\" />\n  <div class=\"flex flex-wrap gap-2\">\n    <button class=\"btn\" type=\"button\" id=\"qr-live-render\">Render</button>\n    <button class=\"btn\" type=\"button\" data-variant=\"outline\" id=\"qr-live-empty\">Empty</button>\n    <button class=\"btn\" type=\"button\" data-variant=\"outline\" id=\"qr-live-error\">Error</button>\n  </div>\n  <figure id=\"qr-live\" class=\"qr-code\" data-value=\"https://example.com/live\" data-variant=\"outline\">\n    <div class=\"qr-code-symbol\" role=\"img\" aria-label=\"QR code for the entered text\"></div>\n    <output class=\"qr-code-status\" hidden></output>\n    <figcaption class=\"qr-code-caption\">Live text</figcaption>\n  </figure>\n</div>\n","individual":false},{"label":"Store and markup replay","html":"<div class=\"flex flex-col items-start gap-3\">\n  <div class=\"flex flex-wrap gap-2\">\n    <button class=\"btn\" type=\"button\" id=\"qr-store-change\">Change payload</button>\n    <button class=\"btn\" type=\"button\" data-variant=\"outline\" id=\"qr-store-restore\">Restore snapshot</button>\n    <button class=\"btn\" type=\"button\" data-variant=\"outline\" id=\"qr-store-render\">Render markup</button>\n  </div>\n  <figure id=\"qr-store\" class=\"qr-code\" data-value=\"https://example.com/original\" data-variant=\"outline\">\n    <div class=\"qr-code-symbol\" role=\"img\" aria-label=\"QR code for the original page\"></div>\n    <output class=\"qr-code-status\" hidden></output>\n    <figcaption class=\"qr-code-caption\">Observable state</figcaption>\n  </figure>\n  <output id=\"qr-store-summary\"></output>\n  <label class=\"label\" for=\"qr-store-markup\">Rendered snapshot markup</label>\n  <textarea class=\"textarea\" id=\"qr-store-markup\" rows=\"5\" readonly style=\"font-family: var(--font-mono)\"></textarea>\n</div>\n","individual":false}]
