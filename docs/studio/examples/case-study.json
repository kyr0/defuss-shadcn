[{"label":"Default","html":"<article class=\"mk-case-study\" aria-labelledby=\"cs-title\">\n  <header class=\"mk-case-study-head\">\n    <div class=\"mk-case-study-client\"\n      ><strong>Northwind</strong><span class=\"badge\" data-variant=\"outline\">Logistics</span\n      ><span>· 1,200 employees</span></div\n    >\n    <h1 class=\"mk-case-study-title\" id=\"cs-title\">How Northwind cut planning meetings in half</h1>\n    <figure class=\"mk-case-study-cover\"\n      ><img src=\"https://picsum.photos/seed/case-study-cover/1600/700\" alt=\"Northwind's operations floor\"\n    /></figure>\n  </header>\n  <dl class=\"mk-case-study-results\">\n    <div><dt>less time in planning meetings</dt><dd>−52%</dd></div>\n    <div><dt>teams onboarded in 6 weeks</dt><dd>38</dd></div>\n    <div><dt>tools replaced</dt><dd>4</dd></div>\n  </dl>\n  <div class=\"mk-case-study-layout\">\n    <div class=\"mk-case-study-body\">\n      <section aria-labelledby=\"cs-challenge\"\n        ><h2 id=\"cs-challenge\">The challenge</h2\n        ><p\n          >Northwind's 38 regional teams planned routes in spreadsheets, discussed them in email and decided in a weekly\n          two-hour call. Nobody trusted the latest version.</p\n        ></section\n      >\n      <section aria-labelledby=\"cs-approach\"\n        ><h2 id=\"cs-approach\">The approach</h2>\n        <ol class=\"mk-case-study-steps\">\n          <li><strong>One planning board per region</strong><span>Imported from the spreadsheets in a day.</span></li>\n          <li><strong>Decisions written down</strong><span>Every change has an owner and a reason.</span></li>\n          <li><strong>The weekly call became async</strong><span>A 15-minute review of open questions only.</span></li>\n        </ol>\n      </section>\n      <section aria-labelledby=\"cs-results\"\n        ><h2 id=\"cs-results\">The results</h2\n        ><p\n          >Six weeks later every region planned on Acme. Meetings shrank by half, and route changes reached drivers a\n          day earlier.</p\n        >\n        <figure class=\"mk-case-study-quote\">\n          <blockquote\n            ><p\n              >We stopped arguing about which spreadsheet was right. Now we argue about routes - which is the job.</p\n            ></blockquote\n          >\n          <figcaption\n            ><span class=\"avatar\"><img class=\"avatar-image\" src=\"images/mk-portrait2.png\" alt=\"\" /></span\n            ><div><strong>Hannah Lee</strong><br /><span>Head of Operations, Northwind</span></div></figcaption\n          >\n        </figure>\n      </section>\n    </div>\n    <dl class=\"mk-case-study-facts\">\n      <div><dt>Client</dt><dd>Northwind Logistics</dd></div>\n      <div><dt>Industry</dt><dd>Transport &amp; logistics</dd></div>\n      <div><dt>Plan</dt><dd>Enterprise</dd></div>\n      <div><dt>Timeline</dt><dd>6 weeks</dd></div>\n    </dl>\n  </div>\n</article>\n","individual":true}]
