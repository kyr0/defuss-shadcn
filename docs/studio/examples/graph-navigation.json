[{"label":"From domains to entities","html":"<div class=\"grid gap-2\">\n  <div class=\"flex flex-wrap items-center gap-2\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"zoom-dive\">Dive into c3</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"zoom-deep\">Fly to entity n4242</button>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-graph-explorer-for=\"zoom\"\n      data-graph-explorer-action=\"up\"\n    >\n      Out\n    </button>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"sm\"\n      type=\"button\"\n      data-graph-explorer-for=\"zoom\"\n      data-graph-explorer-action=\"fit\"\n    >\n      Fit\n    </button>\n    <div class=\"flex-1 min-w-0\" data-graph-explorer-for=\"zoom\" data-graph-explorer-outlet=\"breadcrumb\"></div>\n  </div>\n  <div\n    class=\"graph-explorer\"\n    id=\"zoom\"\n    data-nodes=\"100000\"\n    data-frame\n    aria-label=\"Zoom\"\n    style=\"block-size: 26rem\"\n  ></div>\n</div>\n","individual":false},{"label":"Search and outline","html":"<div class=\"grid gap-2\" style=\"grid-template-columns: 14rem minmax(0, 1fr); block-size: 28rem\">\n  <div class=\"card overflow-hidden grid\" style=\"grid-template-rows: auto minmax(0, 1fr)\">\n    <div class=\"p-2\" data-graph-explorer-for=\"find\" data-graph-explorer-outlet=\"search\"></div>\n    <div class=\"overflow-hidden\" data-graph-explorer-for=\"find\" data-graph-explorer-outlet=\"outline\"></div>\n  </div>\n  <div\n    class=\"graph-explorer\"\n    id=\"find\"\n    data-nodes=\"100000\"\n    data-seed=\"21\"\n    data-frame\n    aria-label=\"Search and outline\"\n  ></div>\n</div>\n","individual":false},{"label":"Jump to a neighbour","html":"<div\n  class=\"graph-explorer\"\n  id=\"bring\"\n  data-nodes=\"100000\"\n  data-seed=\"5\"\n  data-frame\n  data-selected=\"c2\"\n  aria-label=\"Jump to a neighbour\"\n  style=\"block-size: 26rem\"\n></div>\n","individual":false}]
