[{"label":"Knut Berg, creative developer","html":"<style>\n  @import url('https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Mono:wght@400;700&display=swap');\n  #pf-brutalist {\n    --background: oklch(0.94 0.2 118);\n    --foreground: oklch(0.13 0 0);\n    --card: oklch(0.99 0 0);\n    --card-foreground: var(--foreground);\n    --muted: oklch(0.9 0.18 118);\n    --muted-foreground: oklch(0.3 0 0);\n    --border: var(--foreground);\n    --input: var(--foreground);\n    --primary: var(--foreground);\n    --primary-foreground: var(--background);\n    --secondary: var(--card);\n    --secondary-foreground: var(--foreground);\n    --accent: oklch(0.7 0.24 340);\n    --accent-foreground: var(--card);\n    --ring: oklch(0.7 0.24 340);\n    --radius: 0px;\n    --radius-sm: max(0px, calc(var(--radius) - 4px));\n    --radius-md: max(0px, calc(var(--radius) - 2px));\n    --radius-lg: var(--radius);\n    --radius-xl: calc(var(--radius) + 4px);\n    --font-sans: 'Space Mono', ui-monospace, monospace;\n    --font-mono: 'Space Mono', ui-monospace, monospace;\n    --shape-ink: var(--foreground);\n    container: pf-brutalist / inline-size;\n    box-sizing: border-box;\n    width: 100%;\n    overflow: clip;\n    background: var(--background);\n    color: var(--foreground);\n    font-family: var(--font-sans);\n  }\n  .dark #pf-brutalist {\n    --background: oklch(0.13 0 0);\n    --foreground: oklch(0.94 0.2 118);\n    --card: oklch(0.19 0 0);\n    --muted: oklch(0.22 0.03 118);\n    --muted-foreground: oklch(0.85 0.12 118);\n  }\n  /* one view at a time: the home view, a project or the CV */\n  #pf-brutalist [hidden] {\n    display: none !important;\n  }\n  #pf-brutalist .pf-page {\n    display: flex;\n    flex-direction: column;\n    gap: clamp(3rem, 7vw, 5rem);\n    max-width: 76rem;\n    margin-inline: auto;\n    padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 4vw, 2.5rem) 3rem;\n  }\n  #pf-brutalist .pf-display,\n  #pf-brutalist .mk-resume-header-name,\n  #pf-brutalist .mk-availability-title,\n  #pf-brutalist .mk-process-step-title {\n    font-family: 'Archivo Black', var(--font-sans);\n    font-weight: 400;\n    letter-spacing: -0.02em;\n  }\n  /* the header: the Site Header on the yellow, under a thick rule */\n  #pf-brutalist .pf-bar {\n    border-block-end: 3px solid var(--foreground);\n    background: var(--background);\n  }\n  #pf-brutalist .pf-bar .mk-header-inner {\n    flex-wrap: wrap;\n    gap: 0.75rem 2rem;\n    max-width: 76rem;\n    padding: 0.75rem clamp(1rem, 4vw, 2.5rem);\n  }\n  #pf-brutalist .mk-header-brand {\n    color: var(--foreground);\n  }\n  #pf-brutalist .mk-header-name {\n    color: inherit;\n    font-family: 'Archivo Black', var(--font-sans);\n    font-size: 1.375rem;\n    font-weight: 400;\n    letter-spacing: -0.02em;\n    text-transform: uppercase;\n  }\n  #pf-brutalist .mk-header-nav {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.25rem 1.5rem;\n    margin-inline-end: auto;\n    font-size: 0.9375rem;\n    font-weight: 700;\n    text-transform: uppercase;\n  }\n  #pf-brutalist .mk-header-nav a {\n    padding-block: 0.15rem;\n    border-block-end: 3px solid transparent;\n    color: inherit;\n    text-decoration: none;\n  }\n  #pf-brutalist .mk-header-nav a:is(:hover, :focus-visible, [aria-current]) {\n    border-color: currentColor;\n  }\n  #pf-brutalist .mk-header-actions {\n    gap: 1rem;\n  }\n  @container pf-brutalist (max-width: 40rem) {\n    #pf-brutalist .mk-header-nav {\n      order: 3;\n      width: 100%;\n    }\n  }\n  #pf-brutalist .mk-news-ticker {\n    border-block-end: 3px solid var(--foreground);\n  }\n  #pf-brutalist .mk-news-ticker-label {\n    background: var(--accent);\n    color: var(--accent-foreground);\n  }\n  #pf-brutalist .mk-portfolio-grid-caption {\n    padding: 0.75rem 0.85rem 0.9rem;\n  }\n  #pf-brutalist .mk-resume-header {\n    position: relative;\n  }\n  #pf-brutalist .mk-resume-header-name {\n    line-height: 0.82;\n  }\n  #pf-brutalist .mk-resume-header-photo {\n    filter: grayscale(1) contrast(1.35);\n    --shape-ink: var(--accent);\n  }\n  #pf-brutalist .pf-sticker {\n    position: absolute;\n    inset-block-end: -4rem;\n    inset-inline-end: -1rem;\n    z-index: 2;\n    display: grid;\n    place-items: center;\n    width: 16rem;\n    aspect-ratio: 1;\n    background: var(--accent);\n    color: var(--accent-foreground);\n    font-family: 'Archivo Black', var(--font-sans);\n    font-size: 2rem;\n    line-height: 1;\n    text-align: center;\n    text-transform: uppercase;\n    animation: pf-brutalist-spin 12s linear infinite;\n  }\n  @keyframes pf-brutalist-spin {\n    to {\n      rotate: 360deg;\n    }\n  }\n  #pf-brutalist .btn {\n    border: 3px solid var(--foreground);\n    box-shadow: 4px 4px 0 var(--foreground);\n    font-weight: 700;\n    text-transform: uppercase;\n    transition:\n      translate 0.1s,\n      box-shadow 0.1s;\n  }\n  #pf-brutalist .btn:is(:hover, :focus-visible) {\n    translate: 2px 2px;\n    box-shadow: 2px 2px 0 var(--foreground);\n  }\n  #pf-brutalist .mk-resume-header-actions {\n    gap: 1.25rem 1.5rem;\n    margin-block-start: 1rem;\n  }\n  #pf-brutalist .mk-resume-header-actions .btn {\n    height: 3rem;\n    padding-inline: 1.5rem;\n    font-size: 0.9375rem;\n  }\n  #pf-brutalist .pf-h2 {\n    display: flex;\n    align-items: baseline;\n    gap: 1rem;\n    margin: 0 0 1.5rem;\n    padding-block-end: 0.5rem;\n    border-block-end: 3px solid var(--foreground);\n    font-family: 'Archivo Black', var(--font-sans);\n    font-size: clamp(2.25rem, 1rem + 5cqi, 4.5rem);\n    font-weight: 400;\n    line-height: 0.95;\n    text-transform: uppercase;\n  }\n  #pf-brutalist .pf-h2 span {\n    font-family: var(--font-mono);\n    font-size: 1rem;\n  }\n  #pf-brutalist .mk-portfolio-grid-link {\n    background: var(--card);\n  }\n  #pf-brutalist .mk-portfolio-grid-media {\n    filter: grayscale(1) contrast(1.2);\n    transition: filter 0.2s;\n  }\n  #pf-brutalist .mk-portfolio-grid-link:is(:hover, :focus-visible) .mk-portfolio-grid-media {\n    filter: none;\n  }\n  #pf-brutalist .mk-portfolio-grid-title {\n    text-transform: uppercase;\n  }\n  #pf-brutalist .mk-process-steps {\n    gap: 1.5rem;\n  }\n  #pf-brutalist .mk-process-step {\n    padding: 1.25rem;\n    border: 3px solid var(--foreground);\n    background: var(--card);\n    box-shadow: 6px 6px 0 var(--foreground);\n  }\n  #pf-brutalist .mk-process-step::before {\n    display: none;\n  }\n  #pf-brutalist .mk-process-step-number {\n    font-family: 'Archivo Black', var(--font-sans);\n    color: var(--pf-pink);\n  }\n  #pf-brutalist .pf-rates {\n    width: 100%;\n    border-collapse: collapse;\n    border: 3px solid var(--foreground);\n    background: var(--card);\n    font-size: 1rem;\n  }\n  #pf-brutalist .pf-rates :is(th, td) {\n    padding: 0.85rem 1rem;\n    border-block-end: 3px solid var(--foreground);\n    text-align: start;\n  }\n  #pf-brutalist .pf-rates td:last-child {\n    font-family: 'Archivo Black', var(--font-sans);\n    font-size: 1.5rem;\n    text-align: end;\n  }\n  #pf-brutalist .pf-two {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));\n    gap: 2.5rem 3rem;\n    align-items: start;\n  }\n  #pf-brutalist .mk-availability[data-variant='spotlight'] {\n    --shape-cut: 2.5rem;\n    border: 0;\n  }\n  /* a project: the Project Details block in thick frames, a number as big as the title */\n  #pf-brutalist .pf-back {\n    align-self: flex-start;\n    margin-block-end: -1.5rem;\n    color: inherit;\n    font-weight: 700;\n    text-transform: uppercase;\n    text-decoration: none;\n    border-block-end: 3px solid currentColor;\n  }\n  #pf-brutalist .pf-back svg {\n    width: 1rem;\n    height: 1rem;\n    vertical-align: -0.15em;\n  }\n  #pf-brutalist .pf-kicker {\n    justify-self: start;\n    margin: 0;\n    padding: 0.2rem 0.6rem;\n    background: var(--foreground);\n    color: var(--background);\n    font-weight: 700;\n    text-transform: uppercase;\n  }\n  #pf-brutalist .mk-project-details-title {\n    font-family: 'Archivo Black', var(--font-sans);\n    font-size: clamp(2.5rem, 1rem + 7cqi, 6rem);\n    font-weight: 400;\n    line-height: 0.9;\n    text-transform: uppercase;\n    overflow-wrap: anywhere;\n  }\n  #pf-brutalist .mk-project-details-summary {\n    color: inherit;\n    font-size: 1.125rem;\n  }\n  #pf-brutalist .mk-project-details-cover,\n  #pf-brutalist .pf-shots figure {\n    border: 4px solid var(--foreground);\n    box-shadow: 8px 8px 0 var(--foreground);\n  }\n  #pf-brutalist .mk-project-details-cover img,\n  #pf-brutalist .pf-shots img {\n    filter: grayscale(1) contrast(1.2);\n  }\n  #pf-brutalist .mk-project-details-facts {\n    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr));\n    border-block: 3px solid var(--foreground);\n  }\n  #pf-brutalist .mk-project-details-facts dt {\n    color: inherit;\n    font-weight: 700;\n  }\n  #pf-brutalist :is(.mk-project-details-brief, .pf-result) h2 {\n    margin: 0 0 0.75rem;\n    font-family: 'Archivo Black', var(--font-sans);\n    font-size: 1.5rem;\n    font-weight: 400;\n    text-transform: uppercase;\n  }\n  #pf-brutalist :is(.mk-project-details-brief, .pf-result) p {\n    margin: 0;\n    color: inherit;\n    line-height: 1.7;\n  }\n  #pf-brutalist .pf-result {\n    display: grid;\n    grid-template-columns: minmax(0, auto) minmax(0, 1fr);\n    gap: 0.5rem 2rem;\n    align-items: end;\n    padding: 1.5rem;\n    background: var(--foreground);\n    color: var(--background);\n  }\n  #pf-brutalist .pf-result h2 {\n    grid-column: 1 / -1;\n  }\n  #pf-brutalist .pf-result .pf-big {\n    font-family: 'Archivo Black', var(--font-sans);\n    font-size: clamp(3rem, 2rem + 6cqi, 6rem);\n    line-height: 0.85;\n  }\n  #pf-brutalist .pf-result .pf-big small {\n    display: block;\n    margin-block-start: 0.75rem;\n    font-family: var(--font-mono);\n    font-size: 0.875rem;\n    line-height: 1.3;\n    text-transform: uppercase;\n  }\n  @container pf-brutalist (max-width: 40rem) {\n    #pf-brutalist .pf-result {\n      grid-template-columns: minmax(0, 1fr);\n    }\n  }\n  #pf-brutalist .pf-shots {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));\n    gap: 2rem;\n  }\n  #pf-brutalist .pf-shots figure {\n    margin: 0;\n    background: var(--card);\n  }\n  #pf-brutalist .pf-shots img {\n    display: block;\n    width: 100%;\n    aspect-ratio: 4 / 3;\n    object-fit: cover;\n  }\n  #pf-brutalist .pf-shots figcaption {\n    padding: 0.6rem 0.8rem;\n    border-block-start: 3px solid var(--foreground);\n    font-size: 0.875rem;\n    font-weight: 700;\n    text-transform: uppercase;\n  }\n  #pf-brutalist .mk-article-nav-link {\n    border: 3px solid var(--foreground);\n    background: var(--card);\n    box-shadow: 6px 6px 0 var(--foreground);\n  }\n  #pf-brutalist .mk-article-nav-link:hover {\n    background: var(--accent);\n    color: var(--accent-foreground);\n  }\n  #pf-brutalist .mk-article-nav-dir {\n    color: inherit;\n    font-weight: 700;\n    text-transform: uppercase;\n  }\n  #pf-brutalist .mk-article-nav-title {\n    font-family: 'Archivo Black', var(--font-sans);\n    font-weight: 400;\n    text-transform: uppercase;\n  }\n  /* the CV: rows under thick rules; it prints */\n  #pf-brutalist .pf-cv-head {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: end;\n    justify-content: space-between;\n    gap: 1rem 2rem;\n  }\n  #pf-brutalist .pf-cv-head h1 {\n    margin: 0;\n    font-family: 'Archivo Black', var(--font-sans);\n    font-size: clamp(3rem, 1.5rem + 8cqi, 7rem);\n    font-weight: 400;\n    line-height: 0.85;\n    text-transform: uppercase;\n  }\n  #pf-brutalist .pf-cv-head p {\n    margin: 0.75rem 0 0;\n    font-weight: 700;\n  }\n  #pf-brutalist .pf-cv-actions {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 1rem;\n  }\n  #pf-brutalist .pf-cv-rows {\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n  #pf-brutalist .pf-cv-rows li {\n    display: grid;\n    grid-template-columns: 9rem minmax(0, 1fr) auto;\n    gap: 0.25rem 1.5rem;\n    padding-block: 0.85rem;\n    border-block-end: 3px solid var(--foreground);\n  }\n  #pf-brutalist .pf-cv-rows strong {\n    font-family: 'Archivo Black', var(--font-sans);\n    font-weight: 400;\n    text-transform: uppercase;\n  }\n  #pf-brutalist .pf-cv-rows a {\n    color: inherit;\n  }\n  @container pf-brutalist (max-width: 40rem) {\n    #pf-brutalist .pf-cv-rows li {\n      grid-template-columns: minmax(0, 1fr);\n    }\n  }\n  /* the footer: the Site Footer inverted, closing on the name */\n  #pf-brutalist .mk-footer {\n    border-block-start: 3px solid var(--foreground);\n  }\n  #pf-brutalist .mk-footer-inner {\n    max-width: 76rem;\n    padding-inline: clamp(1rem, 4vw, 2.5rem);\n  }\n  #pf-brutalist .mk-footer-nav {\n    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));\n  }\n  #pf-brutalist .mk-footer[data-variant='dark'] .mk-footer-heading {\n    color: inherit;\n    font-family: 'Archivo Black', var(--font-sans);\n    font-size: 1rem;\n    text-transform: uppercase;\n  }\n  #pf-brutalist .mk-footer-list {\n    gap: 0.5rem;\n    font-weight: 700;\n    text-transform: uppercase;\n  }\n  #pf-brutalist .mk-footer-wordmark {\n    color: inherit;\n    font-family: 'Archivo Black', var(--font-sans);\n    font-size: min(11cqi, 9.5rem);\n    font-weight: 400;\n    text-transform: uppercase;\n  }\n  #pf-brutalist .mk-footer-brand-name {\n    font-weight: 700;\n    text-transform: uppercase;\n  }\n  @container pf-brutalist (max-width: 40rem) {\n    #pf-brutalist .pf-sticker {\n      inset: 0 auto auto 0;\n      width: 9rem;\n      font-size: 1.25rem;\n    }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    #pf-brutalist .pf-sticker {\n      animation: none;\n    }\n    #pf-brutalist .btn,\n    #pf-brutalist .mk-portfolio-grid-media {\n      transition: none;\n    }\n  }\n  /* printed, the CV is the page */\n  @media print {\n    #pf-brutalist :is(.mk-header, .mk-footer, .pf-cv-actions) {\n      display: none;\n    }\n  }\n  /* light or dark: the Swap writes the page's dark class - every look has a light and a dark palette */\n  #pf-brutalist .site-mode {\n    flex: none;\n    border: 1px solid var(--input);\n    border-radius: var(--radius-md);\n    background: var(--background);\n    color: var(--foreground);\n  }\n  #pf-brutalist .site-mode:hover {\n    background: var(--accent);\n    color: var(--accent-foreground);\n  }\n  /* -- modes: each look in light and dark, derived from the palettes above (the other mode of each look) -- */\n  :root:not(.dark) #pf-brutalist {\n    --accent: oklch(0.895 0.045 340);\n    --accent-foreground: oklch(0.13 0 0);\n  }\n  .dark #pf-brutalist {\n    --accent: oklch(0.24 0.05 340);\n    --accent-foreground: oklch(0.94 0.2 118);\n  }\n  /* -- modes: end -- */\n  /* the pink for text on the cards (--accent is the hover surface, a tint too faint for text) */\n  :root:not(.dark) #pf-brutalist {\n    --pf-pink: oklch(0.58 0.24 340);\n  }\n  .dark #pf-brutalist {\n    --pf-pink: oklch(0.74 0.2 340);\n  }\n</style>\n<div id=\"pf-brutalist\">\n  <header class=\"mk-header pf-bar\">\n    <div class=\"mk-header-inner\">\n      <a class=\"mk-header-brand\" href=\"#/\" data-router-link><span class=\"mk-header-name\">Knut Berg</span></a>\n      <nav class=\"mk-header-nav\" aria-label=\"Sections\">\n        <a href=\"#pf-br-work\">Work</a>\n        <a href=\"#pf-br-how\">How</a>\n        <a href=\"#pf-br-rates\">Rates</a>\n        <a href=\"#/cv\" data-router-link>CV</a>\n      </nav>\n      <div class=\"mk-header-actions\">\n        <a class=\"btn\" data-size=\"sm\" href=\"#pf-br-hire\">Hire me</a>\n        <label class=\"swap site-mode\" data-variant=\"rotate\" data-size=\"sm\">\n          <input type=\"checkbox\" data-site-mode aria-label=\"Dark mode\" />\n          <span class=\"swap-on\" aria-hidden=\"true\"><i data-lucide=\"moon\"></i></span>\n          <span class=\"swap-off\" aria-hidden=\"true\"><i data-lucide=\"sun\"></i></span>\n        </label>\n      </div>\n    </div>\n  </header>\n\n  <!-- the home view: the whole portfolio -->\n  <div data-pf-view=\"home\">\n    <section class=\"mk-news-ticker\" data-variant=\"inverse\" aria-label=\"News\">\n      <span class=\"mk-news-ticker-label\">Now</span>\n      <div class=\"mk-news-ticker-viewport\">\n        <div class=\"mk-news-ticker-track\">\n          <ul class=\"mk-news-ticker-items\">\n            <li><a href=\"mailto:knut@example.com\">Available for work</a></li>\n            <li><a href=\"#pf-br-work\">Creative developer</a></li>\n            <li><a href=\"#pf-br-skills\">WebGL · Canvas · CSS</a></li>\n            <li><a href=\"#/cv\" data-router-link>Bergen, Norway</a></li>\n            <li><a href=\"mailto:knut@example.com\">Say hei</a></li>\n          </ul>\n          <ul class=\"mk-news-ticker-items\" aria-hidden=\"true\" inert>\n            <li><a href=\"mailto:knut@example.com\">Available for work</a></li>\n            <li><a href=\"#pf-br-work\">Creative developer</a></li>\n            <li><a href=\"#pf-br-skills\">WebGL · Canvas · CSS</a></li>\n            <li><a href=\"#/cv\" data-router-link>Bergen, Norway</a></li>\n            <li><a href=\"mailto:knut@example.com\">Say hei</a></li>\n          </ul>\n        </div>\n      </div>\n    </section>\n    <div class=\"pf-page\">\n      <header class=\"mk-resume-header\" data-variant=\"poster\">\n        <img\n          class=\"mk-resume-header-photo frame-thick shadow-retro rounded-none\"\n          src=\"https://picsum.photos/id/91/700/700\"\n          alt=\"Knut Berg\"\n          data-df-entrance=\"flip\"\n        />\n        <div class=\"mk-resume-header-body\">\n          <h1 class=\"mk-resume-header-name\" data-df-entrance=\"left\">Knut<br />Berg</h1>\n          <p class=\"mk-resume-header-role\" data-df-entrance=\"skew\" style=\"--df-motion-delay: 200ms\"\n            >Creative developer - sites that move</p\n          >\n          <p class=\"mk-resume-header-summary\" data-df-entrance=\"up\" style=\"--df-motion-delay: 300ms\"\n            >Ten years of WebGL, scroll stories and type that does things. No templates. No carousels. No regrets.</p\n          >\n          <div class=\"mk-resume-header-actions\" data-df-entrance=\"up\" style=\"--df-motion-delay: 400ms\">\n            <a class=\"btn\" href=\"mailto:knut@example.com\">knut@example.com</a>\n            <a class=\"btn\" data-variant=\"secondary\" href=\"#/cv\" data-router-link>Read the CV</a>\n          </div>\n        </div>\n        <span class=\"pf-sticker shape-burst\" aria-hidden=\"true\">Hire<br />me!</span>\n      </header>\n      <section aria-labelledby=\"pf-br-work\">\n        <h2 class=\"pf-h2\" id=\"pf-br-work\">Work <span>(04)</span></h2>\n        <ul class=\"mk-portfolio-grid\" data-variant=\"strip\">\n          <li class=\"mk-portfolio-grid-item\">\n            <a\n              class=\"mk-portfolio-grid-link frame-thick shadow-hard\"\n              href=\"#/work/northern-lights-live\"\n              data-router-link\n            >\n              <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/1079/640/800\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Northern Lights Live</strong>\n                <span class=\"mk-portfolio-grid-meta\">WebGL · 2026</span>\n              </span>\n            </a>\n          </li>\n          <li class=\"mk-portfolio-grid-item\">\n            <a\n              class=\"mk-portfolio-grid-link frame-thick shadow-hard\"\n              href=\"#/work/fjord-typeface-site\"\n              data-router-link\n            >\n              <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/942/640/800\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Fjord Typeface Site</strong>\n                <span class=\"mk-portfolio-grid-meta\">Variable fonts · 2025</span>\n              </span>\n            </a>\n          </li>\n          <li class=\"mk-portfolio-grid-item\">\n            <a class=\"mk-portfolio-grid-link frame-thick shadow-hard\" href=\"#/work/synth-in-a-tab\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/1082/640/800\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Synth in a Tab</strong>\n                <span class=\"mk-portfolio-grid-meta\">Web Audio · 2024</span>\n              </span>\n            </a>\n          </li>\n          <li class=\"mk-portfolio-grid-item\">\n            <a class=\"mk-portfolio-grid-link frame-thick shadow-hard\" href=\"#/work/metro-night-map\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/1033/640/800\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Metro Night Map</strong>\n                <span class=\"mk-portfolio-grid-meta\">D3 · 2023</span>\n              </span>\n            </a>\n          </li>\n        </ul>\n      </section>\n      <section aria-labelledby=\"pf-br-how\">\n        <h2 class=\"pf-h2\" id=\"pf-br-how\">How <span>(04)</span></h2>\n        <ol class=\"mk-process-steps\" data-variant=\"horizontal\">\n          <li class=\"mk-process-step\">\n            <span class=\"mk-process-step-number\" aria-hidden=\"true\">01</span>\n            <div class=\"mk-process-step-body\">\n              <h3 class=\"mk-process-step-title\">Brief</h3>\n              <p class=\"mk-process-step-desc\">One call. What must people feel?</p>\n            </div>\n          </li>\n          <li class=\"mk-process-step\">\n            <span class=\"mk-process-step-number\" aria-hidden=\"true\">02</span>\n            <div class=\"mk-process-step-body\">\n              <h3 class=\"mk-process-step-title\">Sketch</h3>\n              <p class=\"mk-process-step-desc\">Three wild prototypes in a week.</p>\n            </div>\n          </li>\n          <li class=\"mk-process-step\">\n            <span class=\"mk-process-step-number\" aria-hidden=\"true\">03</span>\n            <div class=\"mk-process-step-body\">\n              <h3 class=\"mk-process-step-title\">Build</h3>\n              <p class=\"mk-process-step-desc\">Fast on old phones. Always.</p>\n            </div>\n          </li>\n          <li class=\"mk-process-step\">\n            <span class=\"mk-process-step-number\" aria-hidden=\"true\">04</span>\n            <div class=\"mk-process-step-body\">\n              <h3 class=\"mk-process-step-title\">Ship</h3>\n              <p class=\"mk-process-step-desc\">Launch, then a month of fixes for free.</p>\n            </div>\n          </li>\n        </ol>\n      </section>\n      <div class=\"pf-two\">\n        <section aria-labelledby=\"pf-br-rates\">\n          <h2 class=\"pf-h2\" id=\"pf-br-rates\">Rates</h2>\n          <table class=\"pf-rates\">\n            <tbody>\n              <tr>\n                <th scope=\"row\">Day</th>\n                <td>€850</td>\n              </tr>\n              <tr>\n                <th scope=\"row\">Week</th>\n                <td>€3,900</td>\n              </tr>\n              <tr>\n                <th scope=\"row\">Retainer</th>\n                <td>Ask</td>\n              </tr>\n            </tbody>\n          </table>\n        </section>\n        <section aria-labelledby=\"pf-br-skills\">\n          <h2 class=\"pf-h2\" id=\"pf-br-skills\">Can do</h2>\n          <div class=\"mk-skill-matrix\" data-variant=\"dots\">\n            <section class=\"mk-skill-matrix-group\" aria-label=\"Techniques\">\n              <ul class=\"mk-skill-matrix-list\">\n                <li class=\"mk-skill-matrix-skill\">\n                  <label class=\"mk-skill-matrix-name\" for=\"pf-br-webgl\">WebGL / three.js</label>\n                  <meter class=\"mk-skill-matrix-level\" id=\"pf-br-webgl\" min=\"0\" max=\"5\" value=\"5\">5 of 5</meter>\n                </li>\n                <li class=\"mk-skill-matrix-skill\">\n                  <label class=\"mk-skill-matrix-name\" for=\"pf-br-glsl\">GLSL</label>\n                  <meter class=\"mk-skill-matrix-level\" id=\"pf-br-glsl\" min=\"0\" max=\"5\" value=\"4\">4 of 5</meter>\n                </li>\n                <li class=\"mk-skill-matrix-skill\">\n                  <label class=\"mk-skill-matrix-name\" for=\"pf-br-css\">CSS animation</label>\n                  <meter class=\"mk-skill-matrix-level\" id=\"pf-br-css\" min=\"0\" max=\"5\" value=\"5\">5 of 5</meter>\n                </li>\n                <li class=\"mk-skill-matrix-skill\">\n                  <label class=\"mk-skill-matrix-name\" for=\"pf-br-audio\">Web Audio</label>\n                  <meter class=\"mk-skill-matrix-level\" id=\"pf-br-audio\" min=\"0\" max=\"5\" value=\"4\">4 of 5</meter>\n                </li>\n              </ul>\n            </section>\n          </div>\n        </section>\n      </div>\n      <aside class=\"mk-availability cut-corners\" data-variant=\"spotlight\" aria-labelledby=\"pf-br-hire\">\n        <p class=\"mk-availability-status\"\n          ><span class=\"indicator-dot\" data-variant=\"success\" aria-hidden=\"true\"></span> Available now</p\n        >\n        <h2 class=\"mk-availability-title\" id=\"pf-br-hire\">Let's make the web weird again</h2>\n        <div class=\"mk-availability-actions\">\n          <a class=\"btn\" data-variant=\"secondary\" href=\"mailto:knut@example.com\">knut@example.com</a>\n        </div>\n      </aside>\n    </div>\n  </div>\n\n  <!-- a project: the route's slug picks it from the data block below -->\n  <div class=\"pf-page\" data-pf-view=\"project\" hidden>\n    <a class=\"pf-back\" href=\"#pf-br-work\"><i data-lucide=\"arrow-left\"></i> All work</a>\n    <article class=\"mk-project-details\" aria-labelledby=\"pf-br-p-title\">\n      <header class=\"mk-project-details-head\">\n        <p class=\"pf-kicker\" data-p=\"kicker\">WebGL · 2026</p>\n        <h1 class=\"mk-project-details-title\" id=\"pf-br-p-title\" data-p=\"title\">Northern Lights Live</h1>\n        <p class=\"mk-project-details-summary\" data-p=\"summary\"\n          >The aurora over Tromsø, live in the browser - a WebGL sky that moves with the magnetometer readings, minute\n          by minute.</p\n        >\n      </header>\n      <figure class=\"mk-project-details-cover\" data-p-shot=\"0\" data-p-size=\"1600/800\">\n        <img\n          src=\"https://picsum.photos/id/1079/1600/800\"\n          alt=\"A ring of sparks spun in the dark, a long exposure in black and white\"\n        />\n      </figure>\n      <dl class=\"mk-project-details-facts\">\n        <div><dt>Client</dt><dd data-p=\"client\">Tromsø Sky Station</dd></div>\n        <div><dt>Year</dt><dd data-p=\"year\">2026</dd></div>\n        <div><dt>Role</dt><dd data-p=\"role\">Concept, WebGL, sound</dd></div>\n        <div><dt>Stack</dt><dd data-p=\"stack\">WebGL, GLSL, Web Audio</dd></div>\n      </dl>\n      <div class=\"mk-project-details-brief\">\n        <section aria-labelledby=\"pf-br-p-brief\">\n          <h2 id=\"pf-br-p-brief\">The brief</h2>\n          <p data-p=\"brief\"\n            >The station streamed its magnetometer data as a table nobody read. They wanted people who will never stand\n            under the aurora to feel when it starts.</p\n          >\n        </section>\n        <section aria-labelledby=\"pf-br-p-part\">\n          <h2 id=\"pf-br-p-part\">What I did</h2>\n          <p data-p=\"part\"\n            >A shader that turns the readings into curtains of light: the stronger the storm, the faster and greener the\n            sky. A low drone follows the field, so the page can run on a second screen all night.</p\n          >\n        </section>\n      </div>\n      <section class=\"pf-result\" aria-labelledby=\"pf-br-p-result\">\n        <h2 id=\"pf-br-p-result\">The result</h2>\n        <p class=\"pf-big\"><span data-p=\"stat\">1.2M</span><small data-p=\"unit\">visits in the first storm week</small></p>\n        <p data-p=\"result\"\n          >People stayed fourteen minutes on average - most of them with the sound on. Two schools now use the sky in\n          their physics lessons.</p\n        >\n      </section>\n      <div class=\"pf-shots\">\n        <figure data-p-shot=\"1\" data-p-size=\"900/675\">\n          <img\n            src=\"https://picsum.photos/id/1022/900/675\"\n            alt=\"Green northern lights over a single pine tree\"\n            loading=\"lazy\"\n          />\n          <figcaption>The real sky, for the colours</figcaption>\n        </figure>\n        <figure data-p-shot=\"2\" data-p-size=\"900/675\">\n          <img src=\"https://picsum.photos/id/903/900/675\" alt=\"A person under the Milky Way at night\" loading=\"lazy\" />\n          <figcaption>The second-screen mode</figcaption>\n        </figure>\n      </div>\n      <nav class=\"mk-article-nav\" aria-label=\"More work\">\n        <a class=\"mk-article-nav-link\" href=\"#/work/metro-night-map\" rel=\"prev\" data-router-link\n          ><span class=\"mk-article-nav-dir\"><i data-lucide=\"arrow-left\" aria-hidden=\"true\"></i> Previous</span\n          ><span class=\"mk-article-nav-title\" data-p-prev>Metro Night Map</span></a\n        >\n        <a class=\"mk-article-nav-link\" href=\"#/work/fjord-typeface-site\" rel=\"next\" data-router-link\n          ><span class=\"mk-article-nav-dir\">Next <i data-lucide=\"arrow-right\" aria-hidden=\"true\"></i></span\n          ><span class=\"mk-article-nav-title\" data-p-next>Fjord Typeface Site</span></a\n        >\n      </nav>\n    </article>\n  </div>\n\n  <!-- the CV: a page of its own that prints -->\n  <div class=\"pf-page\" data-pf-view=\"cv\" hidden>\n    <a class=\"pf-back\" href=\"#/\" data-router-link><i data-lucide=\"arrow-left\"></i> Back</a>\n    <header class=\"pf-cv-head\">\n      <div>\n        <h1>Knut Berg</h1>\n        <p>Creative developer · Bergen, Norway · knut@example.com</p>\n      </div>\n      <div class=\"pf-cv-actions\">\n        <button class=\"btn\" data-variant=\"secondary\" type=\"button\" data-pf-print>\n          <i data-lucide=\"printer\"></i> Print the CV\n        </button>\n        <a class=\"btn\" href=\"mailto:knut@example.com\">Write me</a>\n      </div>\n    </header>\n    <section aria-labelledby=\"pf-br-cv-work\">\n      <h2 class=\"pf-h2\" id=\"pf-br-cv-work\">Experience</h2>\n      <ol class=\"pf-cv-rows\">\n        <li><span>2019 - today</span><strong>Creative developer</strong><span>Own studio, Bergen</span></li>\n        <li><span>2015 - 2019</span><strong>Interactive developer</strong><span>Lysverk, Oslo</span></li>\n        <li><span>2013 - 2015</span><strong>Front-end developer</strong><span>Vind Digital, Bergen</span></li>\n      </ol>\n    </section>\n    <section aria-labelledby=\"pf-br-cv-projects\">\n      <h2 class=\"pf-h2\" id=\"pf-br-cv-projects\">Selected projects</h2>\n      <ol class=\"pf-cv-rows\">\n        <li\n          ><span>2026</span\n          ><strong><a href=\"#/work/northern-lights-live\" data-router-link>Northern Lights Live</a></strong\n          ><span>Tromsø Sky Station</span></li\n        >\n        <li\n          ><span>2025</span\n          ><strong><a href=\"#/work/fjord-typeface-site\" data-router-link>Fjord Typeface Site</a></strong\n          ><span>Fjord Type Foundry</span></li\n        >\n        <li\n          ><span>2024</span><strong><a href=\"#/work/synth-in-a-tab\" data-router-link>Synth in a Tab</a></strong\n          ><span>Open source</span></li\n        >\n        <li\n          ><span>2023</span><strong><a href=\"#/work/metro-night-map\" data-router-link>Metro Night Map</a></strong\n          ><span>Nattlinjer, Oslo</span></li\n        >\n   