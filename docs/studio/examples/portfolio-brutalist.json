[{"label":"Knut Berg, creative developer","html":"<style>\n  @import url('https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Mono:wght@400;700&display=swap');\n  #pf-brutalist {\n    --background: oklch(0.94 0.2 118);\n    --foreground: oklch(0.13 0 0);\n    --card: oklch(0.99 0 0);\n    --card-foreground: var(--foreground);\n    --muted: oklch(0.9 0.18 118);\n    --muted-foreground: oklch(0.3 0 0);\n    --border: var(--foreground);\n    --input: var(--foreground);\n    --primary: var(--foreground);\n    --primary-foreground: var(--background);\n    --secondary: var(--card);\n    --secondary-foreground: var(--foreground);\n    --accent: oklch(0.7 0.24 340);\n    --accent-foreground: var(--card);\n    --ring: oklch(0.7 0.24 340);\n    --radius: 0px;\n    --radius-sm: max(0px, calc(var(--radius) - 4px));\n    --radius-md: max(0px, calc(var(--radius) - 2px));\n    --radius-lg: var(--radius);\n    --radius-xl: calc(var(--radius) + 4px);\n    --font-sans: 'Space Mono', ui-monospace, monospace;\n    --font-mono: 'Space Mono', ui-monospace, monospace;\n    --shape-ink: var(--foreground);\n    container: pf-brutalist / inline-size;\n    box-sizing: border-box;\n    width: 100%;\n    overflow: clip;\n    background: var(--background);\n    color: var(--foreground);\n    font-family: var(--font-sans);\n  }\n  .dark #pf-brutalist {\n    --background: oklch(0.13 0 0);\n    --foreground: oklch(0.94 0.2 118);\n    --card: oklch(0.19 0 0);\n    --muted: oklch(0.22 0.03 118);\n    --muted-foreground: oklch(0.85 0.12 118);\n  }\n  #pf-brutalist .pf-page {\n    display: flex;\n    flex-direction: column;\n    gap: clamp(3rem, 7vw, 5rem);\n    max-width: 76rem;\n    margin-inline: auto;\n    padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 4vw, 2.5rem) 3rem;\n  }\n  #pf-brutalist .pf-display,\n  #pf-brutalist .mk-resume-header-name,\n  #pf-brutalist .mk-availability-title,\n  #pf-brutalist .mk-process-step-title {\n    font-family: 'Archivo Black', var(--font-sans);\n    font-weight: 400;\n    letter-spacing: -0.02em;\n  }\n  #pf-brutalist .mk-news-ticker {\n    border-block-end: 3px solid var(--foreground);\n  }\n  #pf-brutalist .mk-news-ticker-label {\n    background: var(--accent);\n    color: var(--accent-foreground);\n  }\n  #pf-brutalist .mk-portfolio-grid-caption {\n    padding: 0.75rem 0.85rem 0.9rem;\n  }\n  #pf-brutalist .mk-resume-header {\n    position: relative;\n  }\n  #pf-brutalist .mk-resume-header-name {\n    line-height: 0.82;\n  }\n  #pf-brutalist .mk-resume-header-photo {\n    filter: grayscale(1) contrast(1.35);\n    --shape-ink: var(--accent);\n  }\n  #pf-brutalist .pf-sticker {\n    position: absolute;\n    inset-block-end: -4rem;\n    inset-inline-end: -1rem;\n    z-index: 2;\n    display: grid;\n    place-items: center;\n    width: 16rem;\n    aspect-ratio: 1;\n    background: var(--accent);\n    color: var(--accent-foreground);\n    font-family: 'Archivo Black', var(--font-sans);\n    font-size: 2rem;\n    line-height: 1;\n    text-align: center;\n    text-transform: uppercase;\n    animation: pf-brutalist-spin 12s linear infinite;\n  }\n  @keyframes pf-brutalist-spin {\n    to {\n      rotate: 360deg;\n    }\n  }\n  #pf-brutalist .btn {\n    border: 3px solid var(--foreground);\n    box-shadow: 4px 4px 0 var(--foreground);\n    font-weight: 700;\n    text-transform: uppercase;\n    transition:\n      translate 0.1s,\n      box-shadow 0.1s;\n  }\n  #pf-brutalist .btn:is(:hover, :focus-visible) {\n    translate: 2px 2px;\n    box-shadow: 2px 2px 0 var(--foreground);\n  }\n  #pf-brutalist .mk-resume-header-actions {\n    gap: 1.25rem 1.5rem;\n    margin-block-start: 1rem;\n  }\n  #pf-brutalist .mk-resume-header-actions .btn {\n    height: 3rem;\n    padding-inline: 1.5rem;\n    font-size: 0.9375rem;\n  }\n  #pf-brutalist .pf-h2 {\n    display: flex;\n    align-items: baseline;\n    gap: 1rem;\n    margin: 0 0 1.5rem;\n    padding-block-end: 0.5rem;\n    border-block-end: 3px solid var(--foreground);\n    font-family: 'Archivo Black', var(--font-sans);\n    font-size: clamp(2.25rem, 1rem + 5cqi, 4.5rem);\n    font-weight: 400;\n    line-height: 0.95;\n    text-transform: uppercase;\n  }\n  #pf-brutalist .pf-h2 span {\n    font-family: var(--font-mono);\n    font-size: 1rem;\n  }\n  #pf-brutalist .mk-portfolio-grid-link {\n    background: var(--card);\n  }\n  #pf-brutalist .mk-portfolio-grid-media {\n    filter: grayscale(1) contrast(1.2);\n    transition: filter 0.2s;\n  }\n  #pf-brutalist .mk-portfolio-grid-link:is(:hover, :focus-visible) .mk-portfolio-grid-media {\n    filter: none;\n  }\n  #pf-brutalist .mk-portfolio-grid-title {\n    text-transform: uppercase;\n  }\n  #pf-brutalist .mk-process-steps {\n    gap: 1.5rem;\n  }\n  #pf-brutalist .mk-process-step {\n    padding: 1.25rem;\n    border: 3px solid var(--foreground);\n    background: var(--card);\n    box-shadow: 6px 6px 0 var(--foreground);\n  }\n  #pf-brutalist .mk-process-step::before {\n    display: none;\n  }\n  #pf-brutalist .mk-process-step-number {\n    font-family: 'Archivo Black', var(--font-sans);\n    color: var(--accent);\n  }\n  #pf-brutalist .pf-rates {\n    width: 100%;\n    border-collapse: collapse;\n    border: 3px solid var(--foreground);\n    background: var(--card);\n    font-size: 1rem;\n  }\n  #pf-brutalist .pf-rates :is(th, td) {\n    padding: 0.85rem 1rem;\n    border-block-end: 3px solid var(--foreground);\n    text-align: start;\n  }\n  #pf-brutalist .pf-rates td:last-child {\n    font-family: 'Archivo Black', var(--font-sans);\n    font-size: 1.5rem;\n    text-align: end;\n  }\n  #pf-brutalist .pf-two {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));\n    gap: 2.5rem 3rem;\n    align-items: start;\n  }\n  #pf-brutalist .mk-availability[data-variant='spotlight'] {\n    --shape-cut: 2.5rem;\n    border: 0;\n  }\n  @container pf-brutalist (max-width: 40rem) {\n    #pf-brutalist .pf-sticker {\n      inset: 0 auto auto 0;\n      width: 9rem;\n      font-size: 1.25rem;\n    }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    #pf-brutalist .pf-sticker {\n      animation: none;\n    }\n    #pf-brutalist .btn,\n    #pf-brutalist .mk-portfolio-grid-media {\n      transition: none;\n    }\n  }\n  /* light or dark: the Swap writes the page's dark class - every look has a light and a dark palette */\n  #pf-brutalist .site-mode {\n    flex: none;\n    border: 1px solid var(--input);\n    border-radius: var(--radius-md);\n    background: var(--background);\n    color: var(--foreground);\n  }\n  #pf-brutalist .site-mode:hover {\n    background: var(--accent);\n    color: var(--accent-foreground);\n  }\n  #pf-brutalist {\n    position: relative;\n  }\n  #pf-brutalist > .site-mode {\n    position: absolute;\n    z-index: 20;\n    inset: var(--site-mode-top, 0.75rem) clamp(0.75rem, 2vw, 1.25rem) auto auto;\n  }\n  /* -- modes: each look in light and dark, derived from the palettes above (the other mode of each look) -- */\n  :root:not(.dark) #pf-brutalist {\n    --accent: oklch(0.895 0.045 340);\n    --accent-foreground: oklch(0.13 0 0);\n  }\n  .dark #pf-brutalist {\n    --accent: oklch(0.24 0.05 340);\n    --accent-foreground: oklch(0.94 0.2 118);\n  }\n  /* -- modes: end -- */\n</style>\n<div id=\"pf-brutalist\">\n  <label class=\"swap site-mode\" data-variant=\"rotate\" data-size=\"sm\">\n    <input type=\"checkbox\" data-site-mode aria-label=\"Dark mode\" />\n    <span class=\"swap-on\" aria-hidden=\"true\"><i data-lucide=\"moon\"></i></span>\n    <span class=\"swap-off\" aria-hidden=\"true\"><i data-lucide=\"sun\"></i></span>\n  </label>\n  <section class=\"mk-news-ticker\" data-variant=\"inverse\" aria-label=\"News\">\n    <span class=\"mk-news-ticker-label\">Now</span>\n    <div class=\"mk-news-ticker-viewport\">\n      <div class=\"mk-news-ticker-track\">\n        <ul class=\"mk-news-ticker-items\">\n          <li><a href=\"mailto:knut@example.com\">Available for work</a></li>\n          <li><a href=\"#\">Creative developer</a></li>\n          <li><a href=\"#\">WebGL · Canvas · CSS</a></li>\n          <li><a href=\"#\">Bergen, Norway</a></li>\n          <li><a href=\"mailto:knut@example.com\">Say hei</a></li>\n        </ul>\n        <ul class=\"mk-news-ticker-items\" aria-hidden=\"true\" inert>\n          <li><a href=\"mailto:knut@example.com\">Available for work</a></li>\n          <li><a href=\"#\">Creative developer</a></li>\n          <li><a href=\"#\">WebGL · Canvas · CSS</a></li>\n          <li><a href=\"#\">Bergen, Norway</a></li>\n          <li><a href=\"mailto:knut@example.com\">Say hei</a></li>\n        </ul>\n      </div>\n    </div>\n  </section>\n  <div class=\"pf-page\">\n    <header class=\"mk-resume-header\" data-variant=\"poster\">\n      <img\n        class=\"mk-resume-header-photo frame-thick shadow-retro rounded-none\"\n        src=\"https://picsum.photos/id/91/700/700\"\n        alt=\"Knut Berg\"\n        data-df-entrance=\"flip\"\n      />\n      <div class=\"mk-resume-header-body\">\n        <h1 class=\"mk-resume-header-name\" data-df-entrance=\"left\">Knut<br />Berg</h1>\n        <p class=\"mk-resume-header-role\" data-df-entrance=\"skew\" style=\"--df-motion-delay: 200ms\"\n          >Creative developer - sites that move</p\n        >\n        <p class=\"mk-resume-header-summary\" data-df-entrance=\"up\" style=\"--df-motion-delay: 300ms\"\n          >Ten years of WebGL, scroll stories and type that does things. No templates. No carousels. No regrets.</p\n        >\n        <div class=\"mk-resume-header-actions\" data-df-entrance=\"up\" style=\"--df-motion-delay: 400ms\">\n          <a class=\"btn\" href=\"mailto:knut@example.com\">knut@example.com</a>\n          <a class=\"btn\" data-variant=\"secondary\" href=\"#\">CV.pdf</a>\n        </div>\n      </div>\n      <span class=\"pf-sticker shape-burst\" aria-hidden=\"true\">Hire<br />me!</span>\n    </header>\n    <section aria-labelledby=\"pf-br-work\">\n      <h2 class=\"pf-h2\" id=\"pf-br-work\">Work <span>(04)</span></h2>\n      <ul class=\"mk-portfolio-grid\" data-variant=\"strip\">\n        <li class=\"mk-portfolio-grid-item\">\n          <a class=\"mk-portfolio-grid-link frame-thick shadow-hard\" href=\"#\">\n            <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/1079/640/800\" alt=\"\" />\n            <span class=\"mk-portfolio-grid-caption\">\n              <strong class=\"mk-portfolio-grid-title\">Northern Lights Live</strong>\n              <span class=\"mk-portfolio-grid-meta\">WebGL · 2026</span>\n            </span>\n          </a>\n        </li>\n        <li class=\"mk-portfolio-grid-item\">\n          <a class=\"mk-portfolio-grid-link frame-thick shadow-hard\" href=\"#\">\n            <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/942/640/800\" alt=\"\" />\n            <span class=\"mk-portfolio-grid-caption\">\n              <strong class=\"mk-portfolio-grid-title\">Fjord Typeface Site</strong>\n              <span class=\"mk-portfolio-grid-meta\">Variable fonts · 2025</span>\n            </span>\n          </a>\n        </li>\n        <li class=\"mk-portfolio-grid-item\">\n          <a class=\"mk-portfolio-grid-link frame-thick shadow-hard\" href=\"#\">\n            <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/1082/640/800\" alt=\"\" />\n            <span class=\"mk-portfolio-grid-caption\">\n              <strong class=\"mk-portfolio-grid-title\">Synth in a Tab</strong>\n              <span class=\"mk-portfolio-grid-meta\">Web Audio · 2024</span>\n            </span>\n          </a>\n        </li>\n        <li class=\"mk-portfolio-grid-item\">\n          <a class=\"mk-portfolio-grid-link frame-thick shadow-hard\" href=\"#\">\n            <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/1033/640/800\" alt=\"\" />\n            <span class=\"mk-portfolio-grid-caption\">\n              <strong class=\"mk-portfolio-grid-title\">Metro Night Map</strong>\n              <span class=\"mk-portfolio-grid-meta\">D3 · 2023</span>\n            </span>\n          </a>\n        </li>\n      </ul>\n    </section>\n    <section aria-labelledby=\"pf-br-how\">\n      <h2 class=\"pf-h2\" id=\"pf-br-how\">How <span>(04)</span></h2>\n      <ol class=\"mk-process-steps\" data-variant=\"horizontal\">\n        <li class=\"mk-process-step\">\n          <span class=\"mk-process-step-number\" aria-hidden=\"true\">01</span>\n          <div class=\"mk-process-step-body\">\n            <h3 class=\"mk-process-step-title\">Brief</h3>\n            <p class=\"mk-process-step-desc\">One call. What must people feel?</p>\n          </div>\n        </li>\n        <li class=\"mk-process-step\">\n          <span class=\"mk-process-step-number\" aria-hidden=\"true\">02</span>\n          <div class=\"mk-process-step-body\">\n            <h3 class=\"mk-process-step-title\">Sketch</h3>\n            <p class=\"mk-process-step-desc\">Three wild prototypes in a week.</p>\n          </div>\n        </li>\n        <li class=\"mk-process-step\">\n          <span class=\"mk-process-step-number\" aria-hidden=\"true\">03</span>\n          <div class=\"mk-process-step-body\">\n            <h3 class=\"mk-process-step-title\">Build</h3>\n            <p class=\"mk-process-step-desc\">Fast on old phones. Always.</p>\n          </div>\n        </li>\n        <li class=\"mk-process-step\">\n          <span class=\"mk-process-step-number\" aria-hidden=\"true\">04</span>\n          <div class=\"mk-process-step-body\">\n            <h3 class=\"mk-process-step-title\">Ship</h3>\n            <p class=\"mk-process-step-desc\">Launch, then a month of fixes for free.</p>\n          </div>\n        </li>\n      </ol>\n    </section>\n    <div class=\"pf-two\">\n      <section aria-labelledby=\"pf-br-rates\">\n        <h2 class=\"pf-h2\" id=\"pf-br-rates\">Rates</h2>\n        <table class=\"pf-rates\">\n          <tbody>\n            <tr>\n              <th scope=\"row\">Day</th>\n              <td>€850</td>\n            </tr>\n            <tr>\n              <th scope=\"row\">Week</th>\n              <td>€3,900</td>\n            </tr>\n            <tr>\n              <th scope=\"row\">Retainer</th>\n              <td>Ask</td>\n            </tr>\n          </tbody>\n        </table>\n      </section>\n      <section aria-labelledby=\"pf-br-skills\">\n        <h2 class=\"pf-h2\" id=\"pf-br-skills\">Can do</h2>\n        <div class=\"mk-skill-matrix\" data-variant=\"dots\">\n          <section class=\"mk-skill-matrix-group\" aria-label=\"Techniques\">\n            <ul class=\"mk-skill-matrix-list\">\n              <li class=\"mk-skill-matrix-skill\">\n                <label class=\"mk-skill-matrix-name\" for=\"pf-br-webgl\">WebGL / three.js</label>\n                <meter class=\"mk-skill-matrix-level\" id=\"pf-br-webgl\" min=\"0\" max=\"5\" value=\"5\">5 of 5</meter>\n              </li>\n              <li class=\"mk-skill-matrix-skill\">\n                <label class=\"mk-skill-matrix-name\" for=\"pf-br-glsl\">GLSL</label>\n                <meter class=\"mk-skill-matrix-level\" id=\"pf-br-glsl\" min=\"0\" max=\"5\" value=\"4\">4 of 5</meter>\n              </li>\n              <li class=\"mk-skill-matrix-skill\">\n                <label class=\"mk-skill-matrix-name\" for=\"pf-br-css\">CSS animation</label>\n                <meter class=\"mk-skill-matrix-level\" id=\"pf-br-css\" min=\"0\" max=\"5\" value=\"5\">5 of 5</meter>\n              </li>\n              <li class=\"mk-skill-matrix-skill\">\n                <label class=\"mk-skill-matrix-name\" for=\"pf-br-audio\">Web Audio</label>\n                <meter class=\"mk-skill-matrix-level\" id=\"pf-br-audio\" min=\"0\" max=\"5\" value=\"4\">4 of 5</meter>\n              </li>\n            </ul>\n          </section>\n        </div>\n      </section>\n    </div>\n    <aside class=\"mk-availability cut-corners\" data-variant=\"spotlight\" aria-labelledby=\"pf-br-hire\">\n      <p class=\"mk-availability-status\"\n        ><span class=\"indicator-dot\" data-variant=\"success\" aria-hidden=\"true\"></span> Available now</p\n      >\n      <h2 class=\"mk-availability-title\" id=\"pf-br-hire\">Let's make the web weird again</h2>\n      <div class=\"mk-availability-actions\">\n        <a class=\"btn\" data-variant=\"secondary\" href=\"mailto:knut@example.com\">knut@example.com</a>\n      </div>\n    </aside>\n  </div>\n</div>\n","individual":false}]
