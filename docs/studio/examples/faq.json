            width=\"14\"\n            height=\"14\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            aria-hidden=\"true\"\n          >\n            <path d=\"M5 12h14\"></path>\n            <path d=\"m12 5 7 7-7 7\"></path></svg></a\n      ></div>\n    </article>\n    <article class=\"mk-faq-item\">\n      <span class=\"mk-faq-icon\"\n        ><svg\n          viewBox=\"0 0 24 24\"\n          width=\"24\"\n          height=\"24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"2\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          aria-hidden=\"true\"\n        >\n          <polyline points=\"16 18 22 12 16 6\"></polyline>\n          <polyline points=\"8 6 2 12 8 18\"></polyline></svg\n      ></span>\n      <div class=\"mk-faq-text\"\n        ><h3 class=\"mk-faq-question\">Do I need technical skills?</h3\n        ><p class=\"mk-faq-answer\">No. It works out of the box with minimal setup.</p\n        ><a class=\"mk-faq-link\" href=\"#faq-the-setup-guide\"\n          >The setup guide<svg\n            viewBox=\"0 0 24 24\"\n            width=\"14\"\n            height=\"14\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            aria-hidden=\"true\"\n          >\n            <path d=\"M5 12h14\"></path>\n            <path d=\"m12 5 7 7-7 7\"></path></svg></a\n      ></div>\n    </article>\n    <article class=\"mk-faq-item\">\n      <span class=\"mk-faq-icon\"\n        ><svg\n          viewBox=\"0 0 24 24\"\n          width=\"24\"\n          height=\"24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"2\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          aria-hidden=\"true\"\n        >\n          <path d=\"M18 11V6a2 2 0 0 0-4 0v5\"></path>\n          <path d=\"M14 10V4a2 2 0 0 0-4 0v2\"></path>\n          <path d=\"M10 10.5V6a2 2 0 0 0-4 0v8\"></path>\n          <path\n            d=\"M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15\"\n          ></path></svg\n      ></span>\n      <div class=\"mk-faq-text\"\n        ><h3 class=\"mk-faq-question\">Can I try it before I buy?</h3\n        ><p class=\"mk-faq-answer\">Yes - we offer a demo so you can see how it fits your workflow.</p\n        ><a class=\"mk-faq-link\" href=\"#faq-book-a-demo\"\n          >Book a demo<svg\n            viewBox=\"0 0 24 24\"\n            width=\"14\"\n            height=\"14\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            aria-hidden=\"true\"\n          >\n            <path d=\"M5 12h14\"></path>\n            <path d=\"m12 5 7 7-7 7\"></path></svg></a\n      ></div>\n    </article>\n    <article class=\"mk-faq-item\">\n      <span class=\"mk-faq-icon\"\n        ><svg\n          viewBox=\"0 0 24 24\"\n          width=\"24\"\n          height=\"24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"2\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          aria-hidden=\"true\"\n        >\n          <rect width=\"18\" height=\"11\" x=\"3\" y=\"11\" rx=\"2\" ry=\"2\"></rect>\n          <path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path></svg\n      ></span>\n      <div class=\"mk-faq-text\"\n        ><h3 class=\"mk-faq-question\">How does Acme handle my data?</h3\n        ><p class=\"mk-faq-answer\">All data is encrypted and never shared with third parties.</p\n        ><a class=\"mk-faq-link\" href=\"#faq-security-privacy\"\n          >Security & privacy<svg\n            viewBox=\"0 0 24 24\"\n            width=\"14\"\n            height=\"14\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            aria-hidden=\"true\"\n          >\n            <path d=\"M5 12h14\"></path>\n            <path d=\"m12 5 7 7-7 7\"></path></svg></a\n      ></div>\n    </article>\n  </div>\n</section>\n","individual":true},{"label":"Accordion","html":"<section class=\"mk-faq\" data-variant=\"accordion\" style=\"width: 100%\">\n  <div class=\"mk-faq-head\">\n    <span class=\"mk-faq-eyebrow\">FAQ</span>\n    <h2 class=\"mk-faq-title\">Questions, answered</h2>\n    <p class=\"mk-faq-desc\">Everything you need to know about plans, data and getting started.</p>\n  </div>\n  <div class=\"mk-faq-accordion\">\n    <div class=\"accordion\">\n      <details class=\"accordion-item\" name=\"faq-acc\" open>\n        <summary class=\"accordion-trigger\"\n          ><span>What is Acme?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"16\"\n            height=\"16\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\"\n          ><p\n            >A calm workspace where your team plans, writes and ships - roadmaps, docs and tasks on one surface.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"faq-acc\">\n        <summary class=\"accordion-trigger\"\n          ><span>Is there a free plan?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"16\"\n            height=\"16\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\"\n          ><p>Yes. The Starter plan is free for up to three people, forever. Upgrade when your team grows.</p></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"faq-acc\">\n        <summary class=\"accordion-trigger\"\n          ><span>Can I import from other tools?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"16\"\n            height=\"16\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\"\n          ><p\n            >One-click importers move your projects from Notion, Jira, Linear and Asana - comments and attachments\n            included.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"faq-acc\">\n        <summary class=\"accordion-trigger\"\n          ><span>How does Acme handle my data?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"16\"\n            height=\"16\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\"\n          ><p>Everything is encrypted in transit and at rest, hosted in the EU, and never used to train models.</p></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"faq-acc\">\n        <summary class=\"accordion-trigger\"\n          ><span>Do you offer discounts for nonprofits?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"16\"\n            height=\"16\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\"\n          ><p>Nonprofits and schools get 50% off any paid plan - write to us from your organization's address.</p></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"faq-acc\">\n        <summary class=\"accordion-trigger\"\n          ><span>Can I cancel any time?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"16\"\n            height=\"16\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\"\n          ><p>Yes - plans are monthly or yearly, and you can export everything before you leave.</p></div\n        >\n      </details>\n    </div>\n  </div>\n  <div class=\"mk-faq-contact\">\n    <div class=\"avatar-group\"\n      ><span class=\"avatar\" data-size=\"sm\"><img class=\"avatar-image\" src=\"images/mk-portrait.png\" alt=\"\" /></span\n      ><span class=\"avatar\" data-size=\"sm\"><img class=\"avatar-image\" src=\"images/mk-portrait2.png\" alt=\"\" /></span\n      ><span class=\"avatar\" data-size=\"sm\"><img class=\"avatar-image\" src=\"images/mk-portrait.png\" alt=\"\" /></span\n    ></div>\n    <div><strong>Still have questions?</strong><p>Our team answers within a few hours.</p></div>\n    <a class=\"btn\" href=\"#\">Get in touch</a>\n  </div>\n</section>\n","individual":true},{"label":"Split","html":"<section class=\"mk-faq\" style=\"width: 100%\">\n  <div class=\"mk-faq-split\">\n    <div>\n      <div class=\"mk-faq-head\">\n        <span class=\"mk-faq-eyebrow\">S