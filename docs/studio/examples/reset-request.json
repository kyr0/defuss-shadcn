[{"label":"Default","html":"<section class=\"mk-reset-request\" aria-labelledby=\"rr-title\">\n  <div class=\"mk-reset-request-head\"\n    ><span class=\"mk-reset-request-icon\"><i data-lucide=\"key-round\"></i></span\n    ><h1 id=\"rr-title\">Forgot your password?</h1><p>Enter your email and we'll send you a link to reset it.</p></div\n  >\n  <form action=\"#\" method=\"post\">\n    <div class=\"mk-auth-field\"\n      ><label class=\"label\" for=\"rr-email\">Email</label\n      ><input class=\"input\" id=\"rr-email\" type=\"email\" name=\"email\" autocomplete=\"email\" required\n    /></div>\n    <button class=\"btn\" type=\"submit\">Send reset link</button>\n  </form>\n  <a class=\"mk-reset-request-back\" href=\"#\"><i data-lucide=\"arrow-left\"></i> Back to sign in</a>\n</section>\n","individual":true},{"label":"Sent","html":"<section class=\"mk-reset-request\" data-variant=\"sent\" role=\"status\" aria-labelledby=\"rr2-title\">\n  <div class=\"mk-reset-request-head\"\n    ><span class=\"mk-reset-request-icon\"><i data-lucide=\"mail-check\"></i></span><h1 id=\"rr2-title\">Check your inbox</h1\n    ><p\n      >If an account exists for <strong>anna@example.com</strong>, a reset link is on its way. It expires in 30\n      minutes.</p\n    ></div\n  >\n  <a class=\"btn\" href=\"#\">Open email app</a>\n  <p class=\"mk-reset-request-foot\">Nothing arrived? <a href=\"#\">Send it again</a></p>\n</section>\n","individual":true}]
