[{"label":"Default","html":"<section class=\"mk-application-form\" aria-labelledby=\"apply-title\">\n  <h2 id=\"apply-title\" class=\"sr-only\">Apply for Senior Sync Engineer</h2>\n  <form action=\"#\" method=\"post\">\n    <fieldset class=\"mk-application-form-section\">\n      <legend class=\"mk-application-form-legend\"\n        ><strong>Personal details</strong><span>How we reach you.</span></legend\n      >\n      <div class=\"mk-application-form-fields\">\n        <div class=\"mk-application-form-field\"\n          ><label class=\"label\" for=\"ap-name\">Full name</label\n          ><input class=\"input\" id=\"ap-name\" name=\"name\" autocomplete=\"name\" required\n        /></div>\n        <div class=\"mk-application-form-field\"\n          ><label class=\"label\" for=\"ap-email\">Email</label\n          ><input class=\"input\" id=\"ap-email\" type=\"email\" name=\"email\" autocomplete=\"email\" required\n        /></div>\n        <div class=\"mk-application-form-field\"\n          ><label class=\"label\" for=\"ap-phone\">Phone <span class=\"mk-application-form-hint\">(optional)</span></label\n          ><input class=\"input\" id=\"ap-phone\" type=\"tel\" name=\"phone\" autocomplete=\"tel\" inputmode=\"tel\"\n        /></div>\n        <div class=\"mk-application-form-field\"\n          ><label class=\"label\" for=\"ap-where\">Where are you based?</label\n          ><select class=\"select\" id=\"ap-where\" name=\"location\"\n            ><option>Portugal</option\n            ><option>Germany</option\n            ><option>Elsewhere in the EU</option></select\n          ></div\n        >\n      </div>\n    </fieldset>\n    <fieldset class=\"mk-application-form-section\">\n      <legend class=\"mk-application-form-legend\"\n        ><strong>Documents</strong><span>PDF or DOCX, up to 10 MB.</span></legend\n      >\n      <div class=\"mk-application-form-fields\">\n        <div class=\"mk-application-form-field\" data-span=\"full\">\n          <label class=\"mk-application-form-upload\" for=\"ap-cv\"\n            ><i data-lucide=\"upload\"></i><strong>Upload your résumé</strong><span>or drop it here</span>\n            <input id=\"ap-cv\" type=\"file\" name=\"cv\" accept=\".pdf,.docx\" required aria-describedby=\"ap-cv-hint\" />\n          </label>\n          <span class=\"mk-application-form-hint\" id=\"ap-cv-hint\">Required - PDF or DOCX.</span>\n        </div>\n        <div class=\"mk-application-form-field\" data-span=\"full\"\n          ><label class=\"label\" for=\"ap-note\"\n            >Why Acme? <span class=\"mk-application-form-hint\">(a few sentences)</span></label\n          ><textarea class=\"textarea\" id=\"ap-note\" name=\"note\" rows=\"4\"></textarea>\n        </div>\n      </div>\n    </fieldset>\n    <fieldset class=\"mk-application-form-section\">\n      <legend class=\"mk-application-form-legend\"\n        ><strong>Links</strong><span>Anything that shows your work.</span></legend\n      >\n      <div class=\"mk-application-form-fields\">\n        <div class=\"mk-application-form-field\"\n          ><label class=\"label\" for=\"ap-in\">LinkedIn</label\n          ><input class=\"input\" id=\"ap-in\" type=\"url\" name=\"linkedin\" placeholder=\"https://linkedin.com/in/…\"\n        /></div>\n        <div class=\"mk-application-form-field\"\n          ><label class=\"label\" for=\"ap-gh\">GitHub or portfolio</label\n          ><input class=\"input\" id=\"ap-gh\" type=\"url\" name=\"portfolio\" placeholder=\"https://…\"\n        /></div>\n      </div>\n    </fieldset>\n    <div class=\"mk-application-form-actions\">\n      <label class=\"mk-application-form-consent\"\n        ><input class=\"checkbox\" type=\"checkbox\" name=\"consent\" required />I agree that Acme stores my application for\n        12 months.</label\n      >\n      <button class=\"btn\" type=\"submit\">Submit application</button>\n    </div>\n  </form>\n</section>\n","individual":true},{"label":"Card","html":"<section class=\"mk-application-form\" data-variant=\"card\" aria-labelledby=\"apply-quick\">\n  <form action=\"#\" method=\"post\">\n    <fieldset class=\"mk-application-form-section\">\n      <legend class=\"mk-application-form-legend\"\n        ><strong id=\"apply-quick\">Quick apply</strong><span>Two minutes, no cover letter.</span></legend\n      >\n      <div class=\"mk-application-form-fields\">\n        <div class=\"mk-application-form-field\"\n          ><label class=\"label\" for=\"aq-name\">Full name</label\n          ><input class=\"input\" id=\"aq-name\" name=\"name\" autocomplete=\"name\" required\n        /></div>\n        <div class=\"mk-application-form-field\"\n          ><label class=\"label\" for=\"aq-email\">Email</label\n          ><input class=\"input\" id=\"aq-email\" type=\"email\" name=\"email\" autocomplete=\"email\" required\n        /></div>\n        <div class=\"mk-application-form-field\"\n          ><label class=\"mk-application-form-upload\" for=\"aq-cv\"\n            ><i data-lucide=\"file-text\"></i><strong>Attach résumé</strong\n            ><input id=\"aq-cv\" type=\"file\" name=\"cv\" accept=\".pdf,.docx\" required /></label\n        ></div>\n      </div>\n    </fieldset>\n    <button class=\"btn\" type=\"submit\">Apply</button>\n  </form>\n</section>\n","individual":true}]
