[{"label":"Table of Contents","html":"<nav class=\"toc\" aria-label=\"On this page\" style=\"align-self: start\">\n  <p class=\"toc-title\">On This Page</p>\n  <a class=\"toc-link\" href=\"#tl-install\" aria-current=\"location\">Installation</a>\n  <a class=\"toc-link\" href=\"#tl-usage\">Usage</a>\n  <a class=\"toc-link\" href=\"#tl-api\">API</a>\n  <a class=\"toc-link\" href=\"#tl-faq\">FAQ</a>\n</nav>\n","individual":true},{"label":"Default","html":"<div\n  id=\"toc-left\"\n  style=\"display: grid; grid-template-columns: 11rem 1fr; gap: 1.5rem; height: 18rem; width: 100%; max-width: 42rem\"\n>\n  <nav class=\"toc\" aria-label=\"On this page\" style=\"align-self: start\">\n    <p class=\"toc-title\">On This Page</p>\n    <a class=\"toc-link\" href=\"#tl-install\" aria-current=\"location\">Installation</a>\n    <a class=\"toc-link\" href=\"#tl-usage\">Usage</a>\n    <a class=\"toc-link\" href=\"#tl-api\">API</a>\n    <a class=\"toc-link\" href=\"#tl-faq\">FAQ</a>\n  </nav>\n  <main style=\"overflow-y: auto; padding-inline: 1.5rem 0.5rem; border-left: 1px solid var(--border)\">\n    <section id=\"tl-install\"\n      ><h3 style=\"margin: 0 0 0.5rem\">Installation</h3\n      ><p class=\"text-sm text-muted-foreground\" style=\"margin: 0 0 7rem\"\n        >Copy the stylesheet into your project, or load the bundle from the CDN. No build step.</p\n      ></section\n    >\n    <section id=\"tl-usage\"\n      ><h3 style=\"margin: 0 0 0.5rem\">Usage</h3\n      ><p class=\"text-sm text-muted-foreground\" style=\"margin: 0 0 7rem\"\n        >Render one link per heading. Keep the list short - it is a map, not the page.</p\n      ></section\n    >\n    <section id=\"tl-api\"\n      ><h3 style=\"margin: 0 0 0.5rem\">API</h3\n      ><p class=\"text-sm text-muted-foreground\" style=\"margin: 0 0 7rem\"\n        >Three classes and one attribute: .toc, .toc-title, .toc-link and aria-current=\"location\".</p\n      ></section\n    >\n    <section id=\"tl-faq\"\n      ><h3 style=\"margin: 0 0 0.5rem\">FAQ</h3\n      ><p class=\"text-sm text-muted-foreground\" style=\"margin: 0 0 12rem\"\n        >Does it scroll the page? Native fragment links do - the component only styles them.</p\n      ></section\n    >\n  </main>\n</div>\n","individual":false},{"label":"Docs rail","html":"<div\n  id=\"toc-right\"\n  style=\"\n    height: 20rem;\n    width: 100%;\n    max-width: 46rem;\n    overflow-y: auto;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n  \"\n>\n  <div style=\"display: grid; grid-template-columns: 1fr 11rem; gap: 2rem; padding: 1.25rem 1.5rem\">\n    <article>\n      <h2 style=\"margin: 0 0 0.25rem; font-size: 1.5rem\">Getting started</h2>\n      <p class=\"text-sm text-muted-foreground\" style=\"margin: 0 0 1.5rem\"\n        >Everything you need to ship your first page.</p\n      >\n      <section id=\"tr-install\"\n        ><h3 style=\"margin: 0 0 0.5rem\">Installation</h3\n        ><p class=\"text-sm text-muted-foreground\" style=\"margin: 0 0 6rem\"\n          >Link the token file and the bundle. Every component works the moment its markup is on the page.</p\n        ></section\n      >\n      <section id=\"tr-theme\"\n        ><h3 style=\"margin: 0 0 0.5rem\">Theming</h3\n        ><p class=\"text-sm text-muted-foreground\" style=\"margin: 0 0 6rem\"\n          >Swap one tweakcn preset for another - components only read tokens, so the whole page follows.</p\n        ></section\n      >\n      <section id=\"tr-dark\"\n        ><h3 style=\"margin: 0 0 0.5rem\">Dark mode</h3\n        ><p class=\"text-sm text-muted-foreground\" style=\"margin: 0 0 6rem\"\n          >Toggle the .dark class on the root; every token pair flips with it.</p\n        ></section\n      >\n      <section id=\"tr-deploy\"\n        ><h3 style=\"margin: 0 0 0.5rem\">Deploy</h3\n        ><p class=\"text-sm text-muted-foreground\" style=\"margin: 0 0 12rem\"\n          >It is static HTML and CSS - any file host will do.</p\n        ></section\n      >\n    </article>\n    <nav class=\"toc\" aria-label=\"On this page\" style=\"position: sticky; top: 0; align-self: start\">\n      <p class=\"toc-title\">On This Page</p>\n      <a class=\"toc-link\" href=\"#tr-install\" aria-current=\"location\">Installation</a>\n      <a class=\"toc-link\" href=\"#tr-theme\">Theming</a>\n      <a class=\"toc-link\" href=\"#tr-dark\">Dark mode</a>\n      <a class=\"toc-link\" href=\"#tr-deploy\">Deploy</a>\n    </nav>\n  </div>\n</div>\n","individual":false},{"label":"Density","html":"<div class=\"flex flex-wrap gap-4\" style=\"align-items: flex-start\">\n  <div class=\"card\" style=\"padding: 1rem; width: 14rem\">\n    <p class=\"demo-label\">Compact</p>\n    <nav class=\"toc\" aria-label=\"Compact density\" data-density=\"compact\">\n      <p class=\"toc-title\">On This Page</p>\n      <a class=\"toc-link\" href=\"#\">Installation</a>\n      <a class=\"toc-link\" href=\"#\">Usage</a>\n      <a class=\"toc-link\" href=\"#\">API</a>\n    </nav>\n  </div>\n  <div class=\"card\" style=\"padding: 1rem; width: 14rem\">\n    <p class=\"demo-label\">Comfortable</p>\n    <nav class=\"toc\" aria-label=\"Comfortable density\" data-density=\"comfortable\">\n      <p class=\"toc-title\">On This Page</p>\n      <a class=\"toc-link\" href=\"#\">Installation</a>\n      <a class=\"toc-link\" href=\"#\">Usage</a>\n      <a class=\"toc-link\" href=\"#\">API</a>\n    </nav>\n  </div>\n  <div class=\"card\" style=\"padding: 1rem; width: 14rem\">\n    <p class=\"demo-label\">Spacious</p>\n    <nav class=\"toc\" aria-label=\"Spacious density\" data-density=\"spacious\">\n      <p class=\"toc-title\">On This Page</p>\n      <a class=\"toc-link\" href=\"#\">Installation</a>\n      <a class=\"toc-link\" href=\"#\">Usage</a>\n      <a class=\"toc-link\" href=\"#\">API</a>\n    </nav>\n  </div>\n</div>\n","individual":false}]
