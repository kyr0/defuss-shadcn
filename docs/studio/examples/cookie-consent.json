reen\n      data-cookie-consent=\"youtube\"\n      data-consent-placeholder=\"none\"\n      data-consent-src=\"https://www.youtube-nocookie.com/embed/aqz-KE-bpKQ?rel=0\"\n    ></iframe>\n    <button type=\"button\" class=\"mk-showcase-play\" aria-label=\"Play video\"\n      ><svg\n        viewBox=\"0 0 24 24\"\n        width=\"24\"\n        height=\"24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        aria-hidden=\"true\"\n      >\n        <polygon points=\"6 3 20 12 6 21 6 3\"></polygon></svg\n    ></button>\n  </figure>\n  <output class=\"text-sm\" id=\"gate-measure\">Measurement has not run.</output>\n</div>\n<div id=\"gate-demo\" class=\"cookie-consent\">\n  \n</div>\n","individual":false},{"label":"Your texts, any language","html":"<button type=\"button\" class=\"btn\" data-variant=\"outline\" data-cookie-consent-open=\"i18n-demo\" aria-haspopup=\"dialog\"\n  >Privacy settings</button\n>\n<div id=\"i18n-demo\" class=\"cookie-consent\">\n  \n</div>\n","individual":false},{"label":"Small / compact","html":"<button type=\"button\" class=\"btn\" data-variant=\"outline\" data-cookie-consent-open=\"privacy-small\" aria-haspopup=\"dialog\"\n  >Open small</button\n>\n<div id=\"privacy-small\" class=\"cookie-consent\" data-size=\"sm\" data-density=\"compact\">\n  \n</div>\n","individual":false},{"label":"Medium / comfortable","html":"<button\n  type=\"button\"\n  class=\"btn\"\n  data-variant=\"outline\"\n  data-cookie-consent-open=\"privacy-medium\"\n  aria-haspopup=\"dialog\"\n  >Open medium</button\n>\n<div id=\"privacy-medium\" class=\"cookie-consent\" data-size=\"md\" data-density=\"comfortable\">\n  \n</div>\n","individual":false},{"label":"Large / spacious","html":"<button type=\"button\" class=\"btn\" data-variant=\"outline\" data-cookie-consent-open=\"privacy-large\" aria-haspopup=\"dialog\"\n  >Open large</button\n>\n<div id=\"privacy-large\" class=\"cookie-consent\" data-size=\"lg\" data-density=\"spacious\">\n  \n</div>\n","individual":false},{"label":"Banner (first visit)","html":"<div style=\"display: grid; gap: 1rem; max-width: 40rem; padding-block-end: 12rem\">\n  <h2 style=\"margin: 0; font-size: 1.5rem\">Welcome to Acme</h2>\n  <p style=\"margin: 0; color: var(--muted-foreground)\"\n    >The page stays usable while the banner waits at the bottom - it is not a modal. Choose Settings and it becomes the\n    full dialog.</p\n  >\n  <button\n    type=\"button\"\n    class=\"btn\"\n    data-variant=\"outline\"\n    style=\"justify-self: start\"\n    data-cookie-consent-open=\"banner-demo\"\n    >Show the banner again</button\n  >\n</div>\n<div id=\"banner-demo\" class=\"cookie-consent\" data-variant=\"banner\">\n  \n</div>\n","individual":false},{"label":"Corner / German","html":"<button\n  type=\"button\"\n  class=\"btn\"\n  data-variant=\"outline\"\n  data-cookie-consent-open=\"privacy-corner\"\n  aria-haspopup=\"dialog\"\n  >Einstellungen</button\n>\n<div id=\"privacy-corner\" class=\"cookie-consent\" data-variant=\"corner\">\n  \n</div>\n","individual":false}]
