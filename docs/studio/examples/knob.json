nes</label>\n    <output class=\"knob-value\" for=\"kn-semi\">+7 st</output>\n  </div>\n</div>\n","individual":false},{"label":"Steps","html":"<div class=\"flex flex-wrap items-start gap-6\">\n  <div class=\"knob\" data-format=\"signed\" data-origin=\"0\" data-ticks>\n    <input class=\"knob-input\" type=\"range\" id=\"kn-octave\" min=\"-3\" max=\"3\" step=\"1\" value=\"1\" />\n    <label class=\"knob-label\" for=\"kn-octave\">Octave</label>\n    <output class=\"knob-value\" for=\"kn-octave\">+1</output>\n  </div>\n  <div class=\"knob\" data-format=\"signed\" data-unit=\"st\" data-origin=\"0\" data-ticks>\n    <input class=\"knob-input\" type=\"range\" id=\"kn-st\" min=\"-12\" max=\"12\" step=\"1\" value=\"7\" />\n    <label class=\"knob-label\" for=\"kn-st\">Semitones</label>\n    <output class=\"knob-value\" for=\"kn-st\">+7 st</output>\n  </div>\n  <div class=\"knob\" data-ticks>\n    <input class=\"knob-input\" type=\"range\" id=\"kn-voices\" min=\"1\" max=\"16\" step=\"1\" value=\"4\" />\n    <label class=\"knob-label\" for=\"kn-voices\">Voices</label>\n    <output class=\"knob-value\" for=\"kn-voices\">4</output>\n  </div>\n  <div class=\"knob\" data-format=\"wave\" data-ticks>\n    <input class=\"knob-input\" type=\"range\" id=\"kn-wave\" min=\"0\" max=\"3\" step=\"1\" value=\"2\" />\n    <label class=\"knob-label\" for=\"kn-wave\">Waveform</label>\n    <output class=\"knob-value\" for=\"kn-wave\">Saw</output>\n  </div>\n  <div class=\"knob\" data-format=\"percent\" data-ticks=\"5\">\n    <input class=\"knob-input\" type=\"range\" id=\"kn-steps-mix\" min=\"0\" max=\"1\" step=\"0.05\" value=\"0.5\" />\n    <label class=\"knob-label\" for=\"kn-steps-mix\">Mix</label>\n    <output class=\"knob-value\" for=\"kn-steps-mix\">50%</output>\n  </div>\n  <div class=\"knob\" data-scale=\"exponential\" data-format=\"time\" data-ticks=\"4\">\n    <input class=\"knob-input\" type=\"range\" id=\"kn-delay\" min=\"0.001\" max=\"1\" step=\"0.001\" value=\"0.1\" />\n    <label class=\"knob-label\" for=\"kn-delay\">Delay</label>\n    <output class=\"knob-value\" for=\"kn-delay\">100 ms</output>\n  </div>\n</div>\n","individual":false},{"label":"Automation rings","html":"<div class=\"grid gap-3\">\n  <div class=\"knob\" data-size=\"lg\" data-scale=\"exponential\" data-format=\"si\" data-unit=\"Hz\">\n    <input class=\"knob-input\" type=\"range\" id=\"kn-mod\" min=\"20\" max=\"20000\" step=\"any\" value=\"800\" />\n    <label class=\"knob-label\" for=\"kn-mod\">Cutoff</label>\n    <output class=\"knob-value\" for=\"kn-mod\">800 Hz</output>\n    \n  </div>\n  <div class=\"flex flex-wrap items-center gap-3\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"kn-mod-run\" aria-pressed=\"false\"\n      >Run the sources</button\n    >\n    <span class=\"text-sm text-muted-foreground\">Effective: <output id=\"kn-mod-effective\">-</output></span>\n  </div>\n</div>\n","individual":false},{"label":"Sizes, colours and states","html":"<div class=\"flex flex-wrap items-start gap-6\">\n  <div class=\"knob\" data-size=\"sm\" data-color=\"chart-1\">\n    <input class=\"knob-input\" type=\"range\" id=\"kn-sm\" min=\"0\" max=\"100\" step=\"any\" value=\"30\" />\n    <label class=\"knob-label\" for=\"kn-sm\">Small</label>\n    <output class=\"knob-value\" for=\"kn-sm\">30</output>\n  </div>\n  <div class=\"knob\" data-color=\"chart-2\">\n    <input class=\"knob-input\" type=\"range\" id=\"kn-md\" min=\"0\" max=\"100\" step=\"any\" value=\"50\" />\n    <label class=\"knob-label\" for=\"kn-md\">Default</label>\n    <output class=\"knob-value\" for=\"kn-md\">50</output>\n  </div>\n  <div class=\"knob\" data-size=\"lg\" data-color=\"chart-3\">\n    <input class=\"knob-input\" type=\"range\" id=\"kn-lg\" min=\"0\" max=\"100\" step=\"any\" value=\"70\" />\n    <label class=\"knob-label\" for=\"kn-lg\">Large</label>\n    <output class=\"knob-value\" for=\"kn-lg\">70</output>\n  </div>\n  <div class=\"knob\" data-variant=\"flat\" data-color=\"chart-4\">\n    <input class=\"knob-input\" type=\"range\" id=\"kn-flat\" min=\"0\" max=\"100\" step=\"any\" value=\"60\" />\n    <label class=\"knob-label\" for=\"kn-flat\">Flat</label>\n    <output class=\"knob-value\" for=\"kn-flat\">60</output>\n  </div>\n  <div class=\"knob\" data-color=\"destructive\">\n    <input class=\"knob-input\" type=\"range\" id=\"kn-danger\" min=\"0\" max=\"100\" step=\"any\" value=\"85\" />\n    <label class=\"knob-label\" for=\"kn-danger\">Drive</label>\n    <output class=\"knob-value\" for=\"kn-danger\">85</output>\n  </div>\n  <div class=\"knob\">\n    <input class=\"knob-input\" type=\"range\" id=\"kn-off\" min=\"0\" max=\"100\" step=\"any\" value=\"40\" disabled />\n    <label class=\"knob-label\" for=\"kn-off\">Disabled</label>\n    <output class=\"knob-value\" for=\"kn-off\">40</output>\n  </div>\n</div>\n","individual":false},{"label":"Custom scales and formats","html":"<div class=\"flex flex-wrap items-start gap-6\">\n  <div class=\"knob\" data-scale=\"smooth\" data-unit=\"%\">\n    <input class=\"knob-input\" type=\"range\" id=\"kn-xfade\" min=\"0\" max=\"100\" step=\"any\" value=\"50\" />\n    <label class=\"knob-label\" for=\"kn-xfade\">Crossfade</label>\n    <output class=\"knob-value\" for=\"kn-xfade\">50 %</output>\n  </div>\n  <div class=\"knob\" data-format=\"pan\" data-origin=\"0\">\n    <input class=\"knob-input\" type=\"range\" id=\"kn-pan\" min=\"-50\" max=\"50\" step=\"1\" value=\"-20\" />\n    <label class=\"knob-label\" for=\"kn-pan\">Pan</label>\n    <output class=\"knob-value\" for=\"kn-pan\">L20</output>\n  </div>\n</div>\n","individual":false},{"label":"A synth panel","html":"<div class=\"card\" style=\"max-inline-size: 40rem\">\n  <div class=\"card-header\">\n    <h3 class=\"card-title\">Oscillator A</h3>\n    <p class=\"card-description\">Wavetable - Basic Shapes</p>\n  </div>\n  <div class=\"card-content\">\n    <div class=\"flex flex-wrap items-start gap-4\" style=\"--knob-reserve: 1\">\n      <div class=\"knob\" data-size=\"sm\" data-format=\"signed\" data-origin=\"0\" data-ticks>\n        <input class=\"knob-input\" type=\"range\" id=\"kn-oct\" min=\"-4\" max=\"4\" step=\"1\" value=\"0\" />\n        <label class=\"knob-label\" for=\"kn-oct\">Octave</label>\n        <output class=\"knob-value\" for=\"kn-oct\">0</output>\n      </div>\n      <div class=\"knob\" data-size=\"sm\" data-format=\"signed\" data-unit=\"st\" data-origin=\"0\">\n        <input class=\"knob-input\" type=\"range\" id=\"kn-osc-semi\" min=\"-12\" max=\"12\" step=\"1\" value=\"0\" />\n        <label class=\"knob-label\" for=\"kn-osc-semi\">Semi</label>\n        <output class=\"knob-value\" for=\"kn-osc-semi\">0 st</output>\n      </div>\n      <div class=\"knob\" data-size=\"sm\" data-format=\"signed\" data-unit=\"ct\" data-decimals=\"0\" data-origin=\"0\">\n        <input class=\"knob-input\" type=\"range\" id=\"kn-osc-fine\" min=\"-100\" max=\"100\" step=\"any\" value=\"0\" />\n        <label class=\"knob-label\" for=\"kn-osc-fine\">Fine</label>\n        <output class=\"knob-value\" for=\"kn-osc-fine\">0 ct</output>\n      </div>\n      <div class=\"knob\" data-size=\"sm\" data-ticks>\n        <input class=\"knob-input\" type=\"range\" id=\"kn-unison\" min=\"1\" max=\"16\" step=\"1\" value=\"4\" />\n        <label class=\"knob-label\" for=\"kn-unison\">Unison</label>\n        <output class=\"knob-value\" for=\"kn-unison\">4</output>\n      </div>\n      <div class=\"knob\" data-size=\"sm\" data-color=\"chart-2\" data-format=\"percent\">\n        <input class=\"knob-input\" type=\"range\" id=\"kn-detune\" min=\"0\" max=\"1\" step=\"any\" value=\"0.25\" />\n        <label class=\"knob-label\" for=\"kn-detune\">Detune</label>\n        <output class=\"knob-value\" for=\"kn-detune\">25%</output>\n        \n      </div>\n      <div class=\"knob\" data-size=\"sm\" data-color=\"chart-2\" data-unit=\"%\">\n        <input class=\"knob-input\" type=\"range\" id=\"kn-blend\" min=\"0\" max=\"100\" step=\"any\" value=\"75\" />\n        <label class=\"knob-label\" for=\"kn-blend\">Blend</label>\n        <output class=\"knob-value\" for=\"kn-blend\">75 %</output>\n      </div>\n      <div class=\"knob\" data-size=\"sm\" data-format=\"signed\" data-origin=\"0\">\n        <input class=\"knob-input\" type=\"range\" id=\"kn-osc-pan\" min=\"-50\" max=\"50\" step=\"1\" value=\"0\" />\n        <label class=\"knob-label\" for=\"kn-osc-pan\">Pan</label>\n        <output class=\"knob-value\" for=\"kn-osc-pan\">0</output>\n        \n      </div>\n      <div class=\"knob\" data-size=\"sm\" data-scale=\"decibel\" data-format=\"signed\" data-unit=\"dB\" data-decimals=\"1\">\n        <input class=\"knob-input\" type=\"range\" id=\"kn-level\" min=\"-60\" max=\"6\" step=\"any\" value=\"-6\" />\n        <label class=\"knob-label\" for=\"kn-level\">Level</label>\n        <output class=\"knob-value\" for=\"kn-level\">-6.0 dB</output>\n        \n      </div>\n    </div>\n  </div>\n  <div class=\"card-footer\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"kn-osc-run\" aria-pressed=\"false\"\n      >Run LFO 2 and Envelope 1</button\n    >\n  </div>\n</div>\n","individual":false},{"label":"In a form","html":"<form class=\"grid gap-3\" id=\"kn-form\">\n  <div class=\"flex flex-wrap items-start gap-6\">\n    <div class=\"knob\" data-scale=\"decibel\" data-format=\"signed\" data-unit=\"dB\" data-decimals=\"1\">\n      <input class=\"knob-input\" type=\"range\" id=\"kn-form-gain\" name=\"gain\" min=\"-60\" max=\"6\" step=\"0.5\" value=\"0\" />\n      <label class=\"knob-label\" for=\"kn-form-gain\">Gain</label>\n      <output class=\"knob-value\" for=\"kn-form-gain\">0.0 dB</output>\n    </div>\n    <div class=\"knob\" data-format=\"percent\">\n      <input class=\"knob-input\" type=\"range\" id=\"kn-form-mix\" name=\"mix\" min=\"0\" max=\"1\" step=\"0.01\" value=\"0.5\" />\n      <label class=\"knob-label\" for=\"kn-form-mix\">Mix</label>\n      <output class=\"knob-value\" for=\"kn-form-mix\">50%</output>\n    </div>\n  </div>\n  <div class=\"flex gap-2\">\n    <button class=\"btn\" type=\"submit\" data-size=\"sm\">Submit</button>\n    <button class=\"btn\" type=\"reset\" data-variant=\"outline\" data-size=\"sm\">Reset</button>\n  </div>\n  <output class=\"text-sm text-muted-foreground\" id=\"kn-form-data\">gain=0&amp;mix=0.5</output>\n</form>\n","individual":false}]
