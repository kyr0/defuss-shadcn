[{"label":"Video","html":"<figure class=\"video\" id=\"video-basic\" data-state-demo style=\"max-inline-size: 40rem\">\n  <div class=\"video-frame\">\n    <video preload=\"metadata\" playsinline poster=\"videos/harbour-poster.jpg\">\n      <source src=\"videos/harbour.webm\" type=\"video/webm\" />\n      <source src=\"videos/harbour.mp4\" type=\"video/mp4\" />\n    </video>\n    <div class=\"video-captions\"></div>\n  </div>\n  <div class=\"video-controls\">\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"icon-sm\"\n      data-video-action=\"toggle\"\n      aria-pressed=\"false\"\n      aria-label=\"Play\"\n    >\n      <i data-lucide=\"play\"></i><i data-lucide=\"pause\"></i>\n    </button>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"icon-sm\"\n      data-video-action=\"skip\"\n      data-value=\"-5\"\n      aria-label=\"Back 5 seconds\"\n    >\n      <i data-lucide=\"rotate-ccw\"></i>\n    </button>\n    <output class=\"video-time\" data-video-output=\"time\">0:00</output>\n    <input\n      class=\"slider\"\n      data-size=\"sm\"\n      type=\"range\"\n      min=\"0\"\n      max=\"24\"\n      step=\"0.1\"\n      value=\"0\"\n      data-video-action=\"seek\"\n      aria-label=\"Seek\"\n    />\n    <output class=\"video-time\" data-video-output=\"duration\">0:24</output>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"icon-sm\"\n      data-video-action=\"mute\"\n      aria-pressed=\"false\"\n      aria-label=\"Mute\"\n    >\n      <i data-lucide=\"volume-2\"></i><i data-lucide=\"volume-x\"></i>\n    </button>\n    <input\n      class=\"slider\"\n      data-size=\"xs\"\n      type=\"range\"\n      min=\"0\"\n      max=\"1\"\n      step=\"0.05\"\n      value=\"1\"\n      data-video-action=\"volume\"\n      aria-label=\"Volume\"\n    />\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"icon-sm\"\n      data-video-action=\"captions\"\n      aria-pressed=\"true\"\n      aria-label=\"Captions\"\n    >\n      <i data-lucide=\"captions-off\"></i><i data-lucide=\"captions\"></i>\n    </button>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"icon-sm\"\n      data-video-action=\"fullscreen\"\n      aria-pressed=\"false\"\n      aria-label=\"Full screen\"\n    >\n      <i data-lucide=\"maximize\"></i><i data-lucide=\"minimize\"></i>\n    </button>\n  </div>\n  \n</figure>\n","individual":true},{"label":"Overlay controls","html":"<figure class=\"video\" id=\"video-overlay\" data-variant=\"overlay\" style=\"max-inline-size: 40rem\">\n  <div class=\"video-frame\">\n    <video preload=\"metadata\" playsinline poster=\"videos/harbour-poster.jpg\">\n      <source src=\"videos/harbour.webm\" type=\"video/webm\" />\n      <source src=\"videos/harbour.mp4\" type=\"video/mp4\" />\n    </video>\n    <div class=\"video-captions\"></div>\n  </div>\n  <div class=\"video-controls\">\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"icon-sm\"\n      data-video-action=\"toggle\"\n      aria-pressed=\"false\"\n      aria-label=\"Play\"\n    >\n      <i data-lucide=\"play\"></i><i data-lucide=\"pause\"></i>\n    </button>\n    <output class=\"video-time\" data-video-output=\"time\">0:00</output>\n    <input\n      class=\"slider\"\n      data-size=\"sm\"\n      type=\"range\"\n      min=\"0\"\n      max=\"24\"\n      step=\"0.1\"\n      value=\"0\"\n      data-video-action=\"seek\"\n      aria-label=\"Seek\"\n    />\n    <output class=\"video-time\" data-video-output=\"remaining\">-0:24</output>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"icon-sm\"\n      data-video-action=\"mute\"\n      aria-pressed=\"false\"\n      aria-label=\"Mute\"\n    >\n      <i data-lucide=\"volume-2\"></i><i data-lucide=\"volume-x\"></i>\n    </button>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"icon-sm\"\n      data-video-action=\"fullscreen\"\n      aria-pressed=\"false\"\n      aria-label=\"Full screen\"\n    >\n      <i data-lucide=\"maximize\"></i><i data-lucide=\"minimize\"></i>\n    </button>\n  </div>\n</figure>\n","individual":true},{"label":"Native controls","html":"<figure class=\"video\" id=\"video-native\" style=\"max-inline-size: 40rem\">\n  <div class=\"video-frame\">\n    <video controls preload=\"metadata\" playsinline poster=\"videos/harbour-poster.jpg\">\n      <source src=\"videos/harbour.webm\" type=\"video/webm\" />\n      <source src=\"videos/harbour.mp4\" type=\"video/mp4\" />\n    </video>\n  </div>\n</figure>\n","individual":true},{"label":"Subtitles and video captions","html":"<figure class=\"video\" id=\"video-tracks\" style=\"max-inline-size: 40rem\">\n  <div class=\"video-frame\">\n    <video preload=\"metadata\" playsinline poster=\"videos/harbour-poster.jpg\">\n      <source src=\"videos/harbour.webm\" type=\"video/webm\" />\n      <source src=\"videos/harbour.mp4\" type=\"video/mp4\" />\n    </video>\n    <div class=\"video-captions\"></div>\n  </div>\n  <div class=\"video-controls\">\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"icon-sm\"\n      data-video-action=\"toggle\"\n      aria-pressed=\"false\"\n      aria-label=\"Play\"\n    >\n      <i data-lucide=\"play\"></i><i data-lucide=\"pause\"></i>\n    </button>\n    <output class=\"video-time\" data-video-output=\"time\">0:00</output>\n    <input\n      class=\"slider\"\n      data-size=\"sm\"\n      type=\"range\"\n      min=\"0\"\n      max=\"24\"\n      step=\"0.1\"\n      value=\"0\"\n      data-video-action=\"seek\"\n      aria-label=\"Seek\"\n    />\n    <output class=\"video-time\" data-video-output=\"duration\">0:24</output>\n    <div class=\"video-volume\">\n      <button\n        class=\"btn\"\n        data-variant=\"ghost\"\n        data-size=\"icon-sm\"\n        data-video-action=\"mute\"\n        aria-pressed=\"false\"\n        aria-label=\"Mute\"\n      >\n        <i data-lucide=\"volume-2\"></i><i data-lucide=\"volume-x\"></i>\n      </button>\n      <div class=\"video-volume-panel\">\n        <input\n          class=\"slider\"\n          data-orientation=\"vertical\"\n          data-size=\"xs\"\n          type=\"range\"\n          min=\"0\"\n          max=\"1\"\n          step=\"0.05\"\n          value=\"1\"\n          data-video-action=\"volume\"\n          aria-label=\"Volume\"\n        />\n      </div>\n    </div>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"icon-sm\"\n      data-video-action=\"captions\"\n      aria-pressed=\"true\"\n      aria-label=\"Captions\"\n    >\n      <i data-lucide=\"captions-off\"></i><i data-lucide=\"captions\"></i>\n    </button>\n    <button\n      class=\"btn\"\n      data-variant=\"ghost\"\n      data-size=\"icon-sm\"\n      data-video-action=\"fullscreen\"\n      aria-pressed=\"false\"\n      aria-label=\"Full screen\"\n    >\n      <i data-lucide=\"maximize\"></i><i data-lucide=\"minimize\"></i>\n    </button>\n  </div>\n  \n</figure>\n","individual":true},{"label":"Controls anywhere on the page","html":"<div class=\"grid gap-3\" style=\"max-inline-size: 40rem\">\n  <figure class=\"video\" id=\"video-remote\">\n    <div class=\"video-frame\">\n      <video preload=\"metadata\" playsinline poster=\"videos/harbour-poster.jpg\">\n        <source src=\"videos/harbour.webm\" type=\"video/webm\" />\n        <source src=\"videos/harbour.mp4\" type=\"video/mp4\" />\n      </video>\n    </div>\n  </figure>\n  <div class=\"flex flex-wrap items-center gap-2\" data-video-for=\"video-remote\">\n    <button\n      class=\"btn\"\n      data-variant=\"outline\"\n      data-size=\"icon-sm\"\n      data-video-action=\"toggle\"\n      aria-pressed=\"false\"\n      aria-label=\"Play\"\n    >\n      <i data-lucide=\"play\"></i><i data-lucide=\"pause\"></i>\n    </button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-video-action=\"skip\" data-value=\"-5\">-5 s</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-video-action=\"skip\" data-value=\"5\">+5 s</button>\n    <select class=\"select\" data-size=\"sm\" data-video-action=\"rate\" aria-label=\"Speed\">\n      <option value=\"0.5\">0.5×</option>\n      <option value=\"1\" selected>1×</option>\n      <option value=\"1.5\">1.5×</option>\n      <option value=\"2\">2×</option>\n    </select>\n    <span class=\"text-sm text-muted-foreground\"\n      ><output data-video-output=\"time\">0:00</output> / <output data-video-output=\"duration\">0:24</output></span\n    >\n  </div>\n</div>\n","individual":false},{"label":"The API and the store","html":"<div class=\"grid gap-3\" style=\"max-inline-size: 40rem\">\n  <figure class=\"video\" id=\"video-api\">\n    <div class=\"video-frame\">\n      <video preload=\"metadata\" playsinline muted poster=\"videos/harbour-poster.jpg\">\n        <source src=\"videos/harbour.webm\" type=\"video/webm\" />\n        <source src=\"videos/harbour.mp4\" type=\"video/mp4\" />\n      </video>\n      <div class=\"video-captions\"></div>\n    </div>\n  </figure>\n  <div class=\"flex flex-wrap gap-2\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"video-api-play\">play()</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"video-api-pause\">pause()</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"video-api-noon\">seek(12)</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"video-api-rate\">rate(2)</button>\n  </div>\n  <output class=\"text-sm text-muted-foreground\" id=\"video-api-state\">default</output>\n</div>\n","individual":false},{"label":"A track changes while it plays","html":"<div class=\"grid gap-3\" style=\"max-inline-size: 40rem\">\n  <figure class=\"video\" id=\"video-live\">\n    <div class=\"video-frame\">\n      <video preload=\"metadata\" playsinline muted poster=\"videos/harbour-poster.jpg\">\n        <source src=\"videos/harbour.webm\" type=\"video/webm\" />\n        <source src=\"videos/harbour.mp4\" type=\"video/mp4\" />\n      </video>\n      <div class=\"video-captions\"></div>\n    </div>\n    <div class=\"video-controls\">\n      <button\n        class=\"btn\"\n        data-variant=\"ghost\"\n        data-size=\"icon-sm\"\n        data-video-action=\"toggle\"\n        aria-pressed=\"false\"\n        aria-label=\"Play\"\n      >\n        <i data-lucide=\"play\"></i><i data-lucide=\"pause\"></i>\n      </button>\n      <output class=\"video-time\" data-video-output=\"time\">0:00</output>\n      <input\n        class=\"slider\"\n        data-size=\"sm\"\n        type=\"range\"\n        min=\"0\"\n        max=\"24\"\n        step=\"0.1\"\n        value=\"0\"\n        data-video-action=\"seek\"\n        aria-label=\"Seek\"\n      />\n      <button\n        class=\"btn\"\n        data-variant=\"ghost\"\n        data-size=\"icon-sm\"\n        data-video-action=\"captions\"\n        aria-pressed=\"true\"\n        aria-label=\"Captions\"\n      >\n        <i data-lucide=\"captions-off\"></i><i data-lucide=\"captions\"></i>\n      </button>\n    </div>\n    \n  </figure>\n  <div class=\"flex flex-wrap gap-2\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"video-live-notes\">Rewrite the notes</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"video-live-fr\">Add French subtitles</button>\n  </div>\n  <output class=\"text-sm text-muted-foreground\" id=\"video-live-keys\">notes</output>\n</div>\n","individual":false}]
