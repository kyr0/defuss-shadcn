[{"label":"Default","html":"<section class=\"mk-media-gallery\" aria-labelledby=\"mg-title\">\n  <header class=\"mk-media-gallery-head\">\n    <h2 id=\"mg-title\">Lisbon, autumn 2026</h2>\n    <span>8 photos</span>\n    <div class=\"mk-media-gallery-tools\">\n      <div class=\"mk-media-gallery-views\" role=\"radiogroup\" aria-label=\"Layout\">\n        <label\n          ><input type=\"radio\" name=\"mg-view\" value=\"grid\" checked /><i data-lucide=\"layout-grid\"></i\n          ><span class=\"sr-only\">Grid</span></label\n        >\n        <label\n          ><input type=\"radio\" name=\"mg-view\" value=\"masonry\" /><i data-lucide=\"layout-dashboard\"></i\n          ><span class=\"sr-only\">Masonry</span></label\n        >\n        <label\n          ><input type=\"radio\" name=\"mg-view\" value=\"strip\" /><i data-lucide=\"gallery-horizontal\"></i\n          ><span class=\"sr-only\">Filmstrip</span></label\n        >\n      </div>\n      <button\n        class=\"btn\"\n        data-variant=\"outline\"\n        data-size=\"sm\"\n        type=\"button\"\n        commandfor=\"mg-viewer\"\n        command=\"show-modal\"\n        ><i data-lucide=\"play\"></i> Slideshow</button\n      >\n    </div>\n  </header>\n  <ul class=\"mk-media-gallery-grid\">\n    <li\n      ><figure><img src=\"images/photos/s-mg-1-800x600.webp\" alt=\"Harbour at dawn\" /></figure\n    ></li>\n    <li\n      ><figure><img src=\"images/photos/s-mg-2-600x800.webp\" alt=\"Stairs in Alfama\" /></figure\n    ></li>\n    <li\n      ><figure><img src=\"images/photos/s-mg-3-800x500.webp\" alt=\"River light\" /></figure\n    ></li>\n    <li\n      ><figure><img src=\"images/photos/s-mg-4-600x600.webp\" alt=\"Tiles\" /></figure\n    ></li>\n    <li\n      ><figure><img src=\"images/photos/s-mg-5-800x600.webp\" alt=\"Market morning\" /></figure\n    ></li>\n    <li\n      ><figure><img src=\"images/photos/s-mg-6-600x900.webp\" alt=\"Old tram\" /></figure\n    ></li>\n    <li\n      ><figure><img src=\"ima