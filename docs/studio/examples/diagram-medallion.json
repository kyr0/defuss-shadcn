span></li>\n          </ul>\n        </div>\n        <div class=\"diagram-node\" data-node=\"gold\" data-tone=\"gold\" data-badge=\"focal\" style=\"--col: 4; --row: 2\">\n          <span class=\"diagram-node-eyebrow\">gold-bucket</span>\n          <span class=\"diagram-node-name\">Gold · indicators</span>\n          <ul class=\"diagram-node-fields\">\n            <li data-field=\"tool\"><span>tool</span><span>dbt · Trino</span></li>\n            <li data-field=\"format\"><span>format</span><span>Iceberg</span></li>\n            <li data-field=\"writer\"><span>writer</span><span>scientist</span></li>\n          </ul>\n        </div>\n        <div class=\"diagram-node\" data-node=\"archive\" data-shape=\"store\" data-tone=\"muted\" style=\"--col: 2; --row: 3\">\n          <span class=\"diagram-node-name\">Archive</span>\n          <span class=\"diagram-node-meta\">Glacier · 7 years</span>\n        </div>\n        <div class=\"diagram-node\" data-node=\"bi\" style=\"--col: 4; --row: 3\">\n          <span class=\"diagram-node-name\">Dashboards</span>\n          <span class=\"diagram-node-meta\">unemployment rate</span>\n        </div>\n      </div>\n      <ol class=\"diagram-edges\">\n        <li class=\"diagram-edge\" data-from=\"capi\" data-to=\"bronze\">land</li>\n        <li class=\"diagram-edge\" data-from=\"bronze\" data-to=\"silver\">clean</li>\n        <li class=\"diagram-edge\" data-from=\"silver\" data-to=\"gold\" data-tone=\"accent\">sum</li>\n        <li class=\"diagram-edge\" data-from=\"bronze\" data-to=\"archive\" data-line=\"dashed\">after 90 days</li>\n        <li class=\"diagram-edge\" data-from=\"gold\" data-to=\"bi\">SQL</li>\n      </ol>\n    </figure>\n  </div>\n  <section class=\"card panel\" id=\"dg-medallion-edit-panel\" aria-labelledby=\"dg-medallion-edit-title\" style=\"\">\n    <header class=\"panel-header\">\n      <i data-lucide=\"sliders-horizontal\" class=\"panel-icon\" aria-hidden=\"true\"></i>\n      <h3 class=\"panel-title\" id=\"dg-medallion-edit-title\">Inspector</h3>\n      <div class=\"panel-tools\">\n        <button\n          type=\"button\"\n          class=\"btn panel-close\"\n          data-variant=\"ghost\"\n          data-size=\"icon-sm\"\n          aria-label=\"Close Inspector\"\n          ><i data-lucide=\"x\"></i\n        ></button>\n      </div>\n    </header>\n    <div class=\"panel-body\" data-flush>\n      <div\n        class=\"property-grid\"\n        id=\"dg-medallion-edit-grid\"\n        data-frame=\"none\"\n        data-empty-text=\"Click a box or an arrow.\"\n        aria-label=\"Selection properties\"\n      ></div>\n    </div>\n  </section>\n</div>\n","individual":false}]
