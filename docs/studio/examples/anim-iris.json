[{"label":"In / out, origins and lifecycle","html":"<style>\n  #anim-iris-target {\n    width: 160px;\n    height: 100px;\n    display: grid;\n    place-items: center;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    background: var(--card);\n    color: var(--card-foreground);\n    font-size: 0.85rem;\n    font-weight: 600;\n  }\n</style>\n<div style=\"display: flex; flex-direction: column; gap: 0.85rem\">\n  <div id=\"anim-iris-target\">Iris me</div>\n  <div style=\"display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem\">\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-iris-in\">In</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-iris-out\">Out</button>\n    <span style=\"width: 1px; height: 1.25rem; background: var(--border)\"></span>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-anim-iris-origin=\"50% 50%\" aria-pressed=\"true\"\n      >Center</button\n    >\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-anim-iris-origin=\"0% 0%\" aria-pressed=\"false\"\n      >Top-left</button\n    >\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-anim-iris-origin=\"100% 100%\" aria-pressed=\"false\"\n      >Bottom-right</button\n    >\n    <span style=\"width: 1px; height: 1.25rem; background: var(--border)\"></span>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-anim-iris-lifecycle=\"pause\">Pause</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-anim-iris-lifecycle=\"resume\">Resume</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-anim-iris-lifecycle=\"finish\">Finish</button>\n    <button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" data-anim-iris-lifecycle=\"reset\">Reset</button>\n  </div>\n  <div style=\"display: flex; align-items: center; gap: 0.75rem\">\n    <label for=\"anim-iris-duration\" class=\"text-sm\">Duration</label>\n    <input class=\"input\" id=\"anim-iris-duration\" type=\"number\" min=\"50\" step=\"50\" value=\"1500\" style=\"width: 6rem\" />\n    <label for=\"anim-iris-easing\" class=\"text-sm\">Easing</label>\n    <select class=\"select\" id=\"anim-iris-easing\">\n      <option value=\"cubic-bezier(0.16, 1, 0.3, 1)\" selected>ease-out</option>\n      <option value=\"linear\">linear</option>\n      <option value=\"ease-in-out\">ease-in-out</option>\n      <option value=\"cubic-bezier(0.34, 1.56, 0.64, 1)\">spring</option>\n    </select>\n  </div>\n</div>\n","individual":false},{"label":"Scroll-bound iris","html":"<div\n  id=\"anim-iris-scroll-stage\"\n  style=\"height: 220px; overflow-y: auto; border: 1px solid var(--border); border-radius: var(--radius-lg)\"\n>\n  <div style=\"height: 600px; display: grid; place-items: center\">\n    <div\n      id=\"anim-iris-scroll-target\"\n      style=\"\n        width: 160px;\n        height: 100px;\n        display: grid;\n        place-items: center;\n        border: 1px solid var(--border);\n        border-radius: var(--radius-lg);\n        background: var(--card);\n        color: var(--card-foreground);\n        font-size: 0.85rem;\n        font-weight: 600;\n      \"\n    >\n      Scroll me open\n    </div>\n  </div>\n</div>\n<button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" id=\"anim-iris-scroll-bind\" style=\"margin-top: 0.75rem\"\n  >Bind to scroll</button\n>\n","individual":false}]
