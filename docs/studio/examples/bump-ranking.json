[{"label":"Neo Tokyo Neon","html":"<section\n  class=\"presentation\"\n  id=\"deck-bump\"\n  data-anim-in=\"blurIn\"\n  data-anim-out=\"zoomOut\"\n  style=\"\n    --presentation-ink: #090716;\n    --presentation-ink-foreground: #f6f0ff;\n    --presentation-paper: #14102b;\n    --presentation-paper-foreground: #f6f0ff;\n    --presentation-accent: #ff2dd1;\n    font-family: Arial, Helvetica, sans-serif;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"Genre charts 2019 to 2025 - a neon deck\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Rank of six music genres by streams from 2019 to 2025: K-pop climbs from sixth to first, Latin from fifth to second, Rock falls to last; then 2025 streams and growth\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Cover\">\n    <div\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        right: -160px;\n        top: -120px;\n        width: 760px;\n        height: 760px;\n        border-radius: 50%;\n        background: radial-gradient(circle, rgba(255, 45, 209, 0.55), rgba(0, 229, 255, 0.18) 45%, transparent 70%);\n        filter: blur(8px);\n      \"\n    ></div>\n    <div\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        inset-inline: 0;\n        bottom: 120px;\n        height: 3px;\n        background: linear-gradient(90deg, transparent, #00e5ff, #ff2dd1, transparent);\n      \"\n    ></div>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\">Bump ranking · Neo Tokyo Neon</p>\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"position: relative; max-width: 1250px; font-weight: 800; letter-spacing: -0.03em; font-size: 7rem\"\n      >Sixth to first</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >Seven years of genre charts on one streaming platform - and the climb nobody forecast.</p\n    >\n    <p class=\"presentation-note\">Glow first, numbers later.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"bump\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Ranks\"\n  >\n    <header class=\"presentation-header\"><span>The chart</span><span>Rank by streams · 2019 → 2025</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 800;\n        letter-spacing: -0.03em;\n      \"\n      >Six genres, seven years, four different number ones</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Ranks crossing is the story - follow any line.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"climb\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Climbers\"\n  >\n    <header class=\"presentation-header\"><span>The chart</span><span>Climbers only</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 800;\n        letter-spacing: -0.03em;\n      \"\n      >K-pop and Latin climbed together</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The other lines dim; two climbs remain lit.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"streams\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"2025 streams\"\n  >\n    <header class=\"presentation-header\"><span>Volume</span><span>Streams in 2025, billions</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 800;\n        letter-spacing: -0.03em;\n      \"\n      >At the top, it is close: 9.8 B vs 9.1 B</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Ranks hide margins - the bars show how tight the top four are.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Three numbers from the charts</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #ff2dd1;\n            font-weight: 800;\n            letter-spacing: -0.03em;\n          \"\n          >#<span data-count=\"6\">6</span> → #1</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">K-pop, 2019 to 2025</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-weight: 800;\n            letter-spacing: -0.03em;\n          \"\n          ><span data-count=\"9.8\">9.8</span> B</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">K-pop streams in 2025</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #00e5ff;\n            font-weight: 800;\n            letter-spacing: -0.03em;\n          \"\n          >+<span data-count=\"410\">410</span>%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">K-pop growth since 2019</p>\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >Rock did not collapse - it grew slower than everyone else, and that is enough to fall.</p\n    >\n    <p class=\"presentation-note\">The rock line is the surprising one to explain.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Listening\">\n    <header class=\"presentation-header\"><span>Listening</span><span>How people play</span></header>\n    <div style=\"display: flex; gap: 4.5rem; align-items: center; margin-top: 3.5rem\">\n      <figure\n        class=\"image\"\n        data-ratio=\"4/3\"\n        data-df-entrance=\"blur\"\n        style=\"--df-motion-delay: 150ms; flex: 0 0 700px; margin: 0\"\n      >\n        <img\n          src=\"https://picsum.photos/id/39/960/720\"\n          alt=\"A vinyl record on a turntable, the tonearm resting on the groove, in soft focus\"\n          loading=\"lazy\"\n          width=\"960\"\n          height=\"720\"\n          style=\"width: 100%; height: 100%; object-fit: cover\"\n        />\n        <figcaption class=\"image-caption\" style=\"font-size: 1.25rem\">The analogue way (stock photo).</figcaption>\n      </figure>\n      <div style=\"flex: 1 1 0; min-width: 0\">\n        <h2\n          class=\"presentation-title\"\n          data-df-entrance=\"up\"\n          style=\"font-size: 3.4rem; font-weight: 800; letter-spacing: -0.03em\"\n          >Playlists, not albums</h2\n        >\n        <p class=\"presentation-lede\" data-df-entrance=\"fade\" style=\"--df-motion-delay: 300ms; font-size: 1.7rem\"\n          >68% of 2025 streams started from a playlist. Genres that travel well in playlists climbed fastest.</p\n        >\n      </div>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The irony of a turntable photo is intended.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"north\"\n    data-anim-in-blocks=\"7\"\n    data-anim-in-stagger=\"50\"\n    data-anim-in-color=\"#FF2DD1\"\n    aria-label=\"Rank table\"\n  >\n    <header class=\"presentation-header\"><span>The ranks</span><span>1 = most streamed</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" style=\"font-size: 1.7rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Genre rank by annual streams on one platform (synthetic).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Genre</th><th class=\"table-head\" style=\"text-align: right\">2019</th\n            ><th class=\"table-head\" style=\"text-align: right\">2021</th\n            ><th class=\"table-head\" style=\"text-align: right\">2023</th\n            ><th class=\"table-head\" style=\"text-align: right\">2025</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\" style=\"font-weight: 700\"\n            ><td class=\"table-cell\">K-pop</td><td class=\"table-cell\" style=\"text-align: right\">6</td\n            ><td class=\"table-cell\" style=\"text-align: right\">4</td\n            ><td class=\"table-cell\" style=\"text-align: right\">3</td\n            ><td class=\"table-cell\" style=\"text-align: right\">1</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Latin</td><td class=\"table-cell\" style=\"text-align: right\">5</td\n            ><td class=\"table-cell\" style=\"text-align: right\">3</td\n            ><td class=\"table-cell\" style=\"text-align: right\">1</td\n            ><td class=\"table-cell\" style=\"text-align: right\">2</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Hip-hop</td><td class=\"table-cell\" style=\"text-align: right\">2</td\n            ><td class=\"table-cell\" style=\"text-align: right\">1</td\n            ><td class=\"table-cell\" style=\"text-align: right\">2</td\n            ><td class=\"table-cell\" style=\"text-align: right\">3</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Pop</td><td class=\"table-cell\" style=\"text-align: right\">1</td\n            ><td class=\"table-cell\" style=\"text-align: right\">2</td\n            ><td class=\"table-cell\" style=\"text-align: right\">4</td\n            ><td class=\"table-cell\" style=\"text-align: right\">4</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">EDM</td><td class=\"table-cell\" style=\"text-align: right\">4</td\n            ><td class=\"table-cell\" style=\"text-align: right\">6</td\n            ><td class=\"table-cell\" style=\"text-align: right\">6</td\n            ><td class=\"table-cell\" style=\"text-align: right\">5</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Rock</td><td class=\"table-cell\" style=\"text-align: right\">3</td\n            ><td class=\"table-cell\" style=\"text-align: right\">5</td\n            ><td class=\"table-cell\" style=\"text-align: right\">5</td\n            ><td class=\"table-cell\" style=\"text-align: right\">6</td></tr\n          >\n        </tbody>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Odd years only - the chart has all seven.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"font-size: 3.3rem; line-height: 1.22; font-weight: 800; letter-spacing: -0.03em; font-size: 3rem\"\n        >“We added K-pop to the Monday playlists as an experiment. By Friday it was the playlist.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #ff2dd1; color: #090716\"\n        ><span class=\"avatar-fallback\">YM</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Yuna Morita<br /><span style=\"opacity: 0.7; font-size: 1.4rem\"\n          >Playlist editor - 212 playlists curated</span\n        ></p\n      >\n    </div>\n    <p class=\"presentation-note\">A human voice behind the algorithmic climb.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"growth\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Growth\"\n  >\n    <header class=\"presentation-header\"><span>Growth</span><span>Streams 2025 vs 2019</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 800;\n        letter-spacing: -0.03em;\n      \"\n      >Everyone grew - except rock</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The same bars re-sort by growth since 2019.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Questions from the label\"\n  >\n    <header class=\"presentation-header\"><span>Q & A</span><span>Label meeting</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"font-size: 3.2rem; margin-block: 5.25rem 1.5rem; font-weight: 800; letter-spacing: -0.03em\"\n      >Questions from the label</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"bu-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Is this one market or global?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >One market, one platform - the pattern matches public charts, the numbers are synthetic.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"bu-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Did rock lose listeners?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\">Streams fell 22%, listeners only 6%: fans play fewer, longer albums.</p></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"bu-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Will K-pop hold number one?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\">Latin is 7% behind and growing faster in the last two quarters.</p></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The Latin answer sets up the next meeting.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-dg-slide\n    data-theme=\"ink\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"How a track climbs\"\n  >\n    <header class=\"presentation-header\"><span>Lifecycle</span><span>How a track climbs</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 4.5rem 1.75rem;\n        max-width: 1300px;\n        font-weight: 800;\n        letter-spacing: -0.03em;\n      \"\n      >Release to catalog, one state at a time</h2\n    >\n    <div style=\"width: 1000px; transform: scale(1.35); transform-origin: 0 0\">\n      <figure\n        class=\"diagram\"\n        id=\"track-state\"\n        data-type=\"state\"\n        data-steps\n        data-interactive\n        data-autoplay=\"900\"\n        aria-label=\"States of a track on a streaming platform\"\n      >\n        <div\n          class=\"diagram-canvas\"\n          style=\"\n            --cols: 5;\n            grid-template-columns: 2.5rem repeat(4, minmax(7.5rem, 1fr));\n            --diagram-node-w: 8rem;\n            --diagram-gap-x: 3.25rem;\n            --diagram-gap-y: 3rem;\n          \"\n        >\n          <div class=\"diagram-node\" data-node=\"s0\" data-shape=\"start\" data-step=\"1\" style=\"--col: 1; --row: 1\"\n            ><span class=\"diagram-node-name\">release</span></div\n          >\n          <div class=\"diagram-node\" data-node=\"new\" data-step=\"1\" style=\"--col: 2; --row: 1\"\n            ><span class=\"diagram-node-name\">New release</span></div\n          >\n          <div class=\"diagram-node\" data-node=\"discovery\" data-step=\"2\" style=\"--col: 3; --row: 1\">\n            <span class=\"diagram-node-name\">Discovery</span>\n            <span class=\"diagram-node-meta\">algorithmic mixes</span>\n          </div>\n          <div class=\"diagram-node\" data-node=\"editorial\" data-step=\"3\" style=\"--col: 4; --row: 1\">\n            <span class=\"diagram-node-name\">Editorial</span>\n            <span class=\"diagram-node-meta\">curated playlists</span>\n          </div>\n          <div class=\"diagram-node\" data-node=\"charts\" data-tone=\"accent\" data-step=\"4\" style=\"--col: 5; --row: 1\"\n            ><span class=\"diagram-node-name\">Charting</span></div\n          >\n          <div class=\"diagram-node\" data-node=\"catalog\" data-tone=\"muted\" data-step=\"5\" style=\"--col: 4; --row: 2\"\n            ><span class=\"diagram-node-name\">Catalog</span></div\n          >\n          <div class=\"diagram-node\" data-node=\"s1\" data-shape=\"end\" data-step=\"5\" style=\"--col: 5; --row: 2\"\n            ><span class=\"diagram-node-name\">archived</span></div\n          >\n        </div>\n        <ol class=\"diagram-edges\">\n          <li class=\"diagram-edge\" data-from=\"s0\" data-to=\"new\" data-step=\"1\"></li>\n          <li class=\"diagram-edge\" data-from=\"new\" data-to=\"discovery\" data-step=\"2\">first plays</li>\n          <li class=\"diagram-edge\" data-from=\"discovery\" data-to=\"editorial\" data-step=\"3\">saves rise</li>\n          <li class=\"diagram-edge\" data-from=\"editorial\" data-to=\"charts\" data-step=\"4\">top 200</li>\n          <li class=\"diagram-edge\" data-from=\"charts\" data-to=\"catalog\" data-step=\"5\">falls out</li>\n          <li class=\"diagram-edge\" data-from=\"discovery\" data-to=\"catalog\" data-step=\"5\">never picked</li>\n          <li class=\"diagram-edge\" data-from=\"catalog\" data-to=\"s1\" data-step=\"5\"></li>\n        </ol>\n      </figure>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\"\n      >The path behind the ranks as a state machine - most tracks fall back from the charts into discovery; click a\n      state.</p\n    >\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Takeaways</span><span>For the roster</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">✦</span\n        ><span>Ranks exaggerate: the top four are within 20% of each other.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">✦</span\n        ><span>Playlist fit predicted the climbers better than radio did.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">✦</span\n        ><span>Rock needs albums-first formats, not more singles.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">✦</span\n        ><span>Watch Latin - the next swap at the top is close.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Four lines, then the neon closing.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"south\"\n    data-anim-in-blocks=\"7\"\n    data-anim-in-stagger=\"50\"\n    data-anim-in-color=\"#00E5FF\"\n    aria-label=\"Closing\"\n  >\n    <div\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        right: -160px;\n        top: -120px;\n        width: 760px;\n        height: 760px;\n        border-radius: 50%;\n        background: radial-gradient(circle, rgba(255, 45, 209, 0.55), rgba(0, 229, 255, 0.18) 45%, transparent 70%);\n        filter: blur(8px);\n      \"\n    ></div>\n    <div\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        inset-inline: 0;\n        bottom: 120px;\n        height: 3px;\n        background: linear-gradient(90deg, transparent, #00e5ff, #ff2dd1, transparent);\n      \"\n    ></div>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        font-weight: 800;\n        letter-spacing: -0.03em;\n      \"\n      >Ranks cross. Watch the lines.</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px\"\n      >Six genres, seven years - synthetic streams, very real crossings.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">Leave the glow on the screen.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 13</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"13\" value=\"1\"></progress>\n</section>\n","individual":false}]
