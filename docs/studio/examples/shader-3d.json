[{"label":"A glass orb","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"orb-demo\"\n    data-effect=\"orb\"\n    data-interactive\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"orb-demo\"></div>\n</div>\n","individual":false},{"label":"A spiral galaxy","html":"<div class=\"grid gap-4\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div\n    class=\"shader\"\n    id=\"galaxy-demo\"\n    data-effect=\"galaxy\"\n    data-interactive\n    aria-hidden=\"true\"\n    style=\"--shader-aspect: 16 / 10; border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"galaxy-demo\"></div>\n</div>\n","individual":false},{"label":"Sunset and moonlight","html":"<div class=\"grid gap-3\" style=\"grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))\">\n  <div class=\"shader\" data-effect=\"waves\" aria-hidden=\"true\" style=\"border-radius: var(--radius)\"></div>\n  <div\n    class=\"shader\"\n    id=\"waves-demo\"\n    data-effect=\"waves\"\n    data-height=\"1.6\"\n    data-choppy=\"1.4\"\n    data-colors=\"#020b16 #0b3b5c #2c4a7a #070d24 #cfe3ff\"\n    aria-hidden=\"true\"\n    style=\"border-radius: var(--radius)\"\n  ></div>\n  <div class=\"shader-controls\" data-shader-for=\"waves-demo\"></div>\n</div>\n","individual":false}]
