[{"label":"Aviation Cockpit","html":"<section\n  class=\"presentation\"\n  id=\"deck-gauge\"\n  data-anim-in=\"wipeIn\"\n  data-anim-in-direction=\"east\"\n  data-anim-out=\"blurOut\"\n  style=\"\n    --presentation-ink: #08110e;\n    --presentation-ink-foreground: #d8fbe7;\n    --presentation-paper: #e8f4ec;\n    --presentation-paper-foreground: #08110e;\n    --presentation-accent: #ffb000;\n    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"On time - summer punctuality at a regional airport\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Gauge of on-time departures: 71.3 percent last summer, 82.4 percent this summer against an 80 percent target; then delay causes and the monthly trend from May to September\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Cover\">\n    <svg\n      aria-hidden=\"true\"\n      width=\"600\"\n      height=\"600\"\n      viewBox=\"0 0 600 600\"\n      style=\"position: absolute; right: 120px; top: 150px\"\n    >\n      <circle cx=\"300\" cy=\"300\" r=\"250\" fill=\"none\" stroke=\"#1E3A2F\" stroke-width=\"30\" />\n      <path\n        d=\"M 123 477 A 250 250 0 1 1 477 477\"\n        fill=\"none\"\n        stroke=\"#FFB000\"\n        stroke-width=\"30\"\n        stroke-linecap=\"round\"\n        stroke-dasharray=\"1180 1600\"\n      />\n      <g stroke=\"#D8FBE7\" stroke-width=\"4\" opacity=\"0.6\">\n        <line x1=\"158.57864376269046\" y1=\"441.4213562373095\" x2=\"172.7207793864214\" y2=\"427.27922061357856\" />\n        <line x1=\"109.7886967409693\" y1=\"361.80339887498957\" x2=\"128.80982706687237\" y2=\"355.6230589874906\" />\n        <line x1=\"102.46233188097247\" y1=\"268.7131069919538\" x2=\"122.21609869287522\" y2=\"271.84179629275843\" />\n        <line x1=\"138.19660112501055\" y1=\"182.44294954150536\" x2=\"154.3769410125095\" y2=\"194.1986545873548\" />\n        <line x1=\"209.20190005209065\" y1=\"121.79869516232642\" x2=\"218.28171004688159\" y2=\"139.61882564609377\" />\n        <line x1=\"300\" y1=\"100\" x2=\"300\" y2=\"120\" />\n        <line x1=\"390.79809994790935\" y1=\"121.79869516232642\" x2=\"381.7182899531184\" y2=\"139.61882564609377\" />\n        <line x1=\"461.8033988749895\" y1=\"182.44294954150536\" x2=\"445.62305898749054\" y2=\"194.19865458735484\" />\n        <line x1=\"497.53766811902756\" y1=\"268.71310699195385\" x2=\"477.7839013071248\" y2=\"271.84179629275843\" />\n        <line x1=\"490.21130325903073\" y1=\"361.80339887498945\" x2=\"471.19017293312766\" y2=\"355.62305898749054\" />\n        <line x1=\"441.4213562373095\" y1=\"441.4213562373095\" x2=\"427.27922061357856\" y2=\"427.27922061357856\" />\n      </g>\n      <text\n        x=\"300\"\n        y=\"320\"\n        text-anchor=\"middle\"\n        fill=\"#FFB000\"\n        font-family=\"ui-monospace, Menlo, monospace\"\n        font-size=\"72\"\n        font-weight=\"700\"\n      >\n        82.4\n      </text>\n    </svg>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\"\n      >Editorial gauge · Aviation Cockpit</p\n    >\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        position: relative;\n        max-width: 1250px;\n        font-weight: 700;\n        letter-spacing: 0.02em;\n        text-transform: uppercase;\n        font-size: 8rem;\n      \"\n      >On time</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >One number for one summer: the share of departures that left within 15 minutes.</p\n    >\n    <p class=\"presentation-note\">The HUD previews the gauge.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"last\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Last summer\"\n  >\n    <header class=\"presentation-header\"><span>SUMMER 2024</span><span>On-time departures</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 700;\n        letter-spacing: 0.02em;\n        text-transform: uppercase;\n      \"\n      >Last summer: 71.3%</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Below the amber target mark - the reason for the programme.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"now\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"This summer\"\n  >\n    <header class=\"presentation-header\"><span>SUMMER 2025</span><span>On-time departures</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 700;\n        letter-spacing: 0.02em;\n        text-transform: uppercase;\n      \"\n      >This summer: 82.4% - above target</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Watch the needle swing: eleven points in one year.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"causes\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Delay causes\"\n  >\n    <header class=\"presentation-header\"><span>DELAY CAUSES</span><span>Share of delay minutes</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 700;\n        letter-spacing: 0.02em;\n        text-transform: uppercase;\n      \"\n      >Late inbound aircraft still cause 38% of delay minutes</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The dial gives way to what is left to fix.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Three numbers from the tower</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #ffb000;\n            font-weight: 700;\n            letter-spacing: 0.02em;\n            text-transform: uppercase;\n          \"\n          ><span data-count=\"82.4\">82.4</span>%</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">on-time departures, summer 2025</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-weight: 700;\n            letter-spacing: 0.02em;\n            text-transform: uppercase;\n          \"\n          >+<span data-count=\"11.1\">11.1</span> pts</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">versus summer 2024</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-weight: 700;\n            letter-spacing: 0.02em;\n            text-transform: uppercase;\n          \"\n          ><span data-count=\"4.6\">4.6</span> min</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">average turnaround saved per flight</p>\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >Most of the gain came from the ground: faster turnarounds, not faster aircraft.</p\n    >\n    <p class=\"presentation-note\">The turnaround number is the operational win.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"On the apron\" style=\"overflow: hidden\">\n    <video\n      autoplay\n      muted\n      loop\n      playsinline\n      aria-hidden=\"true\"\n      style=\"\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n        opacity: 0.55;\n        mix-blend-mode: luminosity;\n      \"\n    >\n      <source src=\"videos/demo.webm\" type=\"video/webm\" />\n      <source src=\"videos/demo.mp4\" type=\"video/mp4\" />\n    </video>\n    <div\n      aria-hidden=\"true\"\n      style=\"position: absolute; inset: 0; background: linear-gradient(90deg, #08110e 38%, rgba(255, 176, 0, 0.2))\"\n    ></div>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\">ON THE APRON</p>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"blur\"\n      style=\"\n        position: relative;\n        font-size: 5rem;\n        max-width: 1100px;\n        font-weight: 700;\n        letter-spacing: 0.02em;\n        text-transform: uppercase;\n      \"\n      >Four and a half minutes per turn</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 400ms; position: relative; max-width: 900px\"\n      >Parallel boarding, fuel-while-boarding and one more baggage team at peak - 610 departures a week, each a little\n      faster.</p\n    >\n    <p class=\"presentation-note\">Ambient loop - the operations story in words.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"east\"\n    data-anim-in-blocks=\"7\"\n    data-anim-in-stagger=\"40\"\n    data-anim-in-color=\"#FFB000\"\n    aria-label=\"Monthly table\"\n  >\n    <header class=\"presentation-header\"><span>LOG</span><span>On-time %, departures</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" data-density=\"spacious\" style=\"font-size: 1.7rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >On-time departures (within 15 min), summer 2025 vs 2024 (synthetic).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Month</th><th class=\"table-head\" style=\"text-align: right\">2024</th\n            ><th class=\"table-head\" style=\"text-align: right\">2025</th\n            ><th class=\"table-head\" style=\"text-align: right\">Δ</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">May</td><td class=\"table-cell\" style=\"text-align: right\">69.8%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">76.1%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+6.3</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">June</td><td class=\"table-cell\" style=\"text-align: right\">70.4%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">80.2%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+9.8</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">July</td><td class=\"table-cell\" style=\"text-align: right\">71.9%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">83.5%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+11.6</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">August</td><td class=\"table-cell\" style=\"text-align: right\">72.6%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">84.9%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+12.3</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">September</td><td class=\"table-cell\" style=\"text-align: right\">71.8%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">87.3%</td\n            ><td class=\"table-cell\" style=\"text-align: right\">+15.5</td></tr\n          >\n        </tbody>\n        <tfoot>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Summer</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">71.3%</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">82.4%</td\n            ><td class=\"table-cell\" style=\"text-align: right; font-weight: 700\">+11.1</td></tr\n          >\n        </tfoot>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The gain grew every month - the programme compounded.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"\n          font-size: 3.3rem;\n          line-height: 1.22;\n          font-weight: 700;\n          letter-spacing: 0.02em;\n          text-transform: uppercase;\n          font-size: 3.2rem;\n        \"\n        >“Punctuality is a ground sport. The aircraft only reports what the apron did.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #ffb000; color: #08110e\"\n        ><span class=\"avatar-fallback\">TB</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Tomás Barros<br /><span style=\"opacity: 0.7; font-size: 1.4rem\"\n          >Head of ground operations - 22 summers</span\n        ></p\n      >\n    </div>\n    <p class=\"presentation-note\">The line people will quote back.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-chart-state=\"months\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Monthly trend\"\n  >\n    <header class=\"presentation-header\"><span>TREND</span><span>On-time % by month</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-weight: 700;\n        letter-spacing: 0.02em;\n        text-transform: uppercase;\n      \"\n      >Every month better than the last</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Two lines, one gap - widening all summer.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Questions from the airlines\"\n  >\n    <header class=\"presentation-header\"><span>Q & A</span><span>Airline operators committee</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.2rem;\n        margin-block: 5.25rem 1.5rem;\n        font-weight: 700;\n        letter-spacing: 0.02em;\n        text-transform: uppercase;\n      \"\n      >Questions from the airlines</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"eg-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Why 15 minutes?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >It is the industry convention for “on time”; within 5 minutes the rate is 61%.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"eg-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Did cancellations flatter the number?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\">No - cancellations fell too, from 1.9% to 1.2% of departures.</p></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"eg-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>What is next?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Inbound delays: a slot-swap scheme with the two largest carriers from winter.</p\n          ></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The 15-minute question is always first.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>CHECKLIST</span><span>For winter</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">▸</span\n        ><span>Keep the headline number big - and the target visible on the dial.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">▸</span\n        ><span>Ground processes moved the needle; protect them in winter staffing.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">▸</span\n        ><span>Attack inbound delays next: 38% of the remaining minutes.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">▸</span\n        ><span>Report the monthly trend, not just the season.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">A checklist, cockpit style.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"ink\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"west\"\n    data-anim-in-blocks=\"7\"\n    data-anim-in-stagger=\"40\"\n    data-anim-in-color=\"#FFB000\"\n    aria-label=\"Closing\"\n  >\n    <svg\n      aria-hidden=\"true\"\n      width=\"600\"\n      height=\"600\"\n      viewBox=\"0 0 600 600\"\n      style=\"position: absolute; right: 120px; top: 150px\"\n    >\n      <circle cx=\"300\" cy=\"300\" r=\"250\" fill=\"none\" stroke=\"#1E3A2F\" stroke-width=\"30\" />\n      <path\n        d=\"M 123 477 A 250 250 0 1 1 477 477\"\n        fill=\"none\"\n        stroke=\"#FFB000\"\n        stroke-width=\"30\"\n        stroke-linecap=\"round\"\n        stroke-dasharray=\"1180 1600\"\n      />\n      <g stroke=\"#D8FBE7\" stroke-width=\"4\" opacity=\"0.6\">\n        <line x1=\"158.57864376269046\" y1=\"441.4213562373095\" x2=\"172.7207793864214\" y2=\"427.27922061357856\" />\n        <line x1=\"109.7886967409693\" y1=\"361.80339887498957\" x2=\"128.80982706687237\" y2=\"355.6230589874906\" />\n        <line x1=\"102.46233188097247\" 