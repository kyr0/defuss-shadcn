[{"label":"Grouped","html":"<div class=\"otp-input\" data-group-size=\"3\">\n  <input name=\"grouped\" type=\"text\" aria-label=\"Grouped code\" />\n</div>\n","individual":true},{"label":"Letters allowed","html":"<div class=\"otp-input\" data-length=\"4\" data-pattern=\"alphanumeric\">\n  <input name=\"alpha\" type=\"text\" aria-label=\"Alphanumeric code\" />\n</div>\n","individual":true},{"label":"Masked PIN","html":"<div class=\"otp-input\" data-length=\"4\" data-mask>\n  <input name=\"pin\" type=\"text\" aria-label=\"PIN\" />\n</div>\n","individual":true},{"label":"Disabled","html":"<div class=\"otp-input\" data-length=\"4\">\n  <input name=\"disabled-code\" type=\"text\" value=\"1234\" aria-label=\"Disabled code\" disabled />\n</div>\n","individual":true},{"label":"Verification code","html":"<div class=\"flex flex-col gap-2 items-start\">\n  <label class=\"label\" for=\"otp-code\">Verification code</label>\n  <div class=\"otp-input\">\n    <input id=\"otp-code\" name=\"code\" type=\"text\" aria-describedby=\"otp-code-hint\" />\n  </div>\n  <p class=\"field-description\" id=\"otp-code-hint\">We sent a code to your phone.</p>\n</div>\n","individual":false},{"label":"Verify on complete","html":"<form class=\"flex flex-col gap-2 items-start\" id=\"otp-form\" onsubmit=\"event.preventDefault()\">\n  <label class=\"label\" for=\"otp-verify\">Enter the code - hint: 424242</label>\n  <div class=\"otp-input\" id=\"otp-verify-wrap\" data-group-size=\"3\">\n    <input id=\"otp-verify\" name=\"code\" type=\"text\" aria-describedby=\"otp-verify-msg\" />\n  </div>\n  <p class=\"field-description\" id=\"otp-verify-msg\" aria-live=\"polite\">6 digits</p>\n</form>\n","individual":false},{"label":"Slot size","html":"<div class=\"flex flex-col gap-4 items-start\">\n  <div class=\"otp-input\" data-length=\"4\" style=\"--otp-input-slot-size: 3.5rem\">\n    <input name=\"large\" type=\"text\" aria-label=\"Large PIN\" />\n  </div>\n  <div class=\"otp-input\" data-length=\"6\" style=\"--otp-input-slot-size: 2.25rem\">\n    <input name=\"compact\" type=\"text\" aria-label=\"Compact code\" />\n  </div>\n</div>\n","individual":false}]
