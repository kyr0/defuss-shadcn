[{"label":"Trust zones","html":"<figure class=\"diagram\" id=\"dg-nested\" data-type=\"nested\" aria-label=\"Trust zones from the internet to the database\">\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Nested containment</span>\n    <span class=\"diagram-title\">Where a request is trusted</span>\n    <span class=\"diagram-dek\">Outer is broader, inner is more specific: each boundary drops a class of caller.</span>\n  </figcaption>\n  <div class=\"diagram-canvas\">\n    <div class=\"diagram-group\" data-node=\"internet\">\n      <span class=\"diagram-group-label\">Internet · untrusted</span>\n      <div class=\"diagram-node\" data-node=\"user\">\n        <span class=\"diagram-node-name\">Browser</span>\n        <span class=\"diagram-node-meta\">anyone</span>\n      </div>\n      <div class=\"diagram-group\" data-node=\"edge\">\n        <span class=\"diagram-group-label\">Edge · CDN + WAF</span>\n        <div class=\"diagram-node\" data-node=\"waf\">\n          <span class=\"diagram-node-name\">WAF rules</span>\n          <span class=\"diagram-node-meta\">OWASP set · bot score</span>\n        </div>\n        <div class=\"diagram-group\" data-node=\"vpc\">\n          <span class=\"diagram-group-label\">VPC · private network</span>\n          <div class=\"diagram-node\" data-node=\"app\">\n            <span class=\"diagram-node-name\">App servers</span>\n            <span class=\"diagram-node-meta\">mTLS between services</span>\n          </div>\n          <div class=\"diagram-group\" data-node=\"data\" data-tone=\"accent\">\n            <span class=\"diagram-group-label\">Data subnet · no egress</span>\n            <div class=\"diagram-node\" data-node=\"db\" data-shape=\"store\">\n              <span class=\"diagram-node-name\">Customer database</span>\n              <span class=\"diagram-node-meta\">encrypted · audited</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n  <ol class=\"diagram-edges\">\n    <li class=\"diagram-edge\" data-from=\"user\" data-to=\"waf\">HTTPS</li>\n    <li class=\"diagram-edge\" data-from=\"waf\" data-to=\"app\">allowed</li>\n    <li class=\"diagram-edge\" data-from=\"app\" data-to=\"db\" data-tone=\"accent\">SQL · TLS</li>\n  </ol>\n</figure>\n","individual":true},{"label":"Trust zones, step by step","html":"<figure\n  class=\"diagram\"\n  id=\"dg-nested-steps\"\n  data-type=\"nested\"\n  data-steps\n  data-autoplay\n  aria-label=\"Trust zones from the internet to the database\"\n>\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Nested containment</span>\n    <span class=\"diagram-title\">Where a request is trusted</span>\n    <span class=\"diagram-dek\">Outer is broader, inner is more specific: each boundary drops a class of caller.</span>\n  </figcaption>\n  <div class=\"diagram-canvas\">\n    <div class=\"diagram-group\" data-node=\"internet\" data-step=\"1\">\n      <span class=\"diagram-group-label\">Internet · untrusted</span>\n      <div class=\"diagram-node\" data-node=\"user\" data-step=\"1\">\n        <span class=\"diagram-node-name\">Browser</span>\n        <span class=\"diagram-node-meta\">anyone</span>\n      </div>\n      <div class=\"diagram-group\" data-node=\"edge\" data-step=\"2\">\n        <span class=\"diagram-group-label\">Edge · CDN + WAF</span>\n        <div class=\"diagram-node\" data-node=\"waf\" data-step=\"2\">\n          <span class=\"diagram-node-name\">WAF rules</span>\n          <span class=\"diagram-node-meta\">OWASP set · bot score</span>\n        </div>\n        <div class=\"diagram-group\" data-node=\"vpc\" data-step=\"3\">\n          <span class=\"diagram-group-label\">VPC · private network</span>\n          <div class=\"diagram-node\" data-node=\"app\" data-step=\"3\">\n            <span class=\"diagram-node-name\">App servers</span>\n            <span class=\"diagram-node-meta\">mTLS between services</span>\n          </div>\n          <div class=\"diagram-group\" data-node=\"data\" data-tone=\"accent\" data-step=\"4\">\n            <span class=\"diagram-group-label\">Data subnet · no egress</span>\n            <div class=\"diagram-node\" data-node=\"db\" data-shape=\"store\" data-step=\"4\">\n              <span class=\"diagram-node-name\">Customer database</span>\n              <span class=\"diagram-node-meta\">encrypted · audited</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n  <ol class=\"diagram-edges\">\n    <li class=\"diagram-edge\" data-from=\"user\" data-to=\"waf\">HTTPS</li>\n    <li class=\"diagram-edge\" data-from=\"waf\" data-to=\"app\">allowed</li>\n    <li class=\"diagram-edge\" data-from=\"app\" data-to=\"db\" data-tone=\"accent\">SQL · TLS</li>\n  </ol>\n</figure>\n","individual":true},{"label":"The mesh becomes a boundary","html":"<figure class=\"diagram\" id=\"dg-nested-delta\" data-type=\"nested\" data-delta aria-label=\"A service mesh boundary appears\">\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Zero trust</span>\n    <span class=\"diagram-title\">The mesh becomes its own boundary</span>\n  </figcaption>\n  <div class=\"diagram-canvas\">\n    <div class=\"diagram-group\" data-node=\"vpc\">\n      <span class=\"diagram-group-label\">VPC · private network</span>\n      <div class=\"diagram-node\" data-node=\"lb\">\n        <span class=\"diagram-node-name\">Load balancer</span>\n        <span class=\"diagram-node-meta\">internal</span>\n      </div>\n      <div class=\"diagram-group\" data-node=\"mesh\" data-tone=\"accent\" data-change=\"added\">\n        <span class=\"diagram-group-label\">Service mesh · mTLS</span>\n        <div class=\"diagram-node\" data-node=\"app\" data-change=\"changed\">\n          <span class=\"diagram-node-name\">App servers</span>\n          <span class=\"diagram-node-meta\" data-before=\"shared credentials\">identity per pod</span>\n        </div>\n      </div>\n      <div clas