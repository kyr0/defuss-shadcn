[{"label":"Default","html":"<div\n  class=\"scroll-area\"\n  style=\"\n    height: 12rem;\n    max-width: 20rem;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    padding: 1rem;\n  \"\n>\n  <div style=\"font-size: 0.8125rem; color: var(--foreground)\">\n    <p style=\"margin: 0 0 0.75rem; font-weight: 500\">Release history</p>\n    <p style=\"margin: 0 0 0.5rem\">v1.0.0-alpha</p><p style=\"margin: 0 0 0.5rem\">v0.9.0</p\n    ><p style=\"margin: 0 0 0.5rem\">v0.8.2</p><p style=\"margin: 0 0 0.5rem\">v0.8.1</p\n    ><p style=\"margin: 0 0 0.5rem\">v0.8.0</p><p style=\"margin: 0 0 0.5rem\">v0.7.0</p\n    ><p style=\"margin: 0 0 0.5rem\">v0.6.0</p><p style=\"margin: 0 0 0.5rem\">v0.5.0</p\n    ><p style=\"margin: 0 0 0.5rem\">v0.4.0</p><p style=\"margin: 0 0 0.5rem\">v0.3.0</p>\n  </div>\n</div>\n","individual":true},{"label":"Density","html":"<div class=\"flex flex-wrap gap-4\" style=\"align-items: flex-start\">\n  <div>\n    <p class=\"demo-label\">Compact</p>\n    <div\n      class=\"scroll-area\"\n      data-density=\"compact\"\n      style=\"\n        height: 9rem;\n        width: 14rem;\n        border: 1px solid var(--border);\n        border-radius: var(--radius-lg);\n        padding: 0.75rem;\n      \"\n    >\n      <p class=\"m-0\" style=\"width: 28rem\">Overflowing content - the 4px thumb keeps the gutter minimal.</p>\n    </div>\n  </div>\n  <div>\n    <p class=\"demo-label\">Comfortable</p>\n    <div\n      class=\"scroll-area\"\n      data-density=\"comfortable\"\n      style=\"\n        height: 9rem;\n        width: 14rem;\n        border: 1px solid var(--border);\n        border-radius: var(--radius-lg);\n        padding: 0.75rem;\n      \"\n    >\n      <p class=\"m-0\" style=\"width: 28rem\">Overflowing content - the default 6px thumb.</p>\n    </div>\n  </div>\n  <div>\n    <p class=\"demo-label\">Spacious</p>\n    <div\n      class=\"scroll-area\"\n      data-density=\"spacious\"\n      style=\"\n        height: 9rem;\n        width: 14rem;\n        border: 1px solid var(--border);\n        border-radius: var(--radius-lg);\n        padding: 0.75rem;\n      \"\n    >\n      <p class=\"m-0\" style=\"width: 28rem\">Overflowing content - an 8px thumb, easier to grab.</p>\n    </div>\n  </div>\n</div>\n","individual":false}]
