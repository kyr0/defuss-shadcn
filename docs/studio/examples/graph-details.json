[{"label":"Details beside the graph","html":"<div class=\"border-layout\" data-frame=\"none\" style=\"block-size: 34rem\">\n  <section class=\"card panel border-layout-center\" aria-label=\"Graph\">\n    <div class=\"panel-body\" data-flush>\n      <div\n        class=\"graph-explorer\"\n        id=\"details\"\n        data-nodes=\"100000\"\n        data-selected=\"c2\"\n        aria-label=\"A service graph\"\n      ></div>\n    </div>\n  </section>\n  <div class=\"resizer border-layout-east\" data-min=\"220\" data-max=\"560\">\n    <section class=\"card panel\" style=\"width: 20rem\" aria-labelledby=\"details-title\" data-density=\"compact\">\n      <header class=\"panel-header\">\n        <h3 class=\"panel-title\" id=\"details-title\">\n          Details\n          <span\n            class=\"text-muted-foreground\"\n            data-graph-explorer-for=\"details\"\n            data-graph-explorer-output=\"details-title\"\n          ></span>\n        </h3>\n        <div class=\"panel-tools\">\n          <label class=\"swap panel-maximize\">\n            <input type=\"checkbox\" aria-label=\"Maximize Details\" />\n            <span class=\"swap-off\"><i data-lucide=\"maximize-2\"></i></span>\n            <span class=\"swap-on\"><i data-lucide=\"minimize-2\"></i></span>\n          </label>\n        </div>\n      </header>\n      <div class=\"panel-body\" data-graph-explorer-for=\"details\" data-graph-explorer-outlet=\"details\"></div>\n    </section>\n  </div>\n  <div class=\"resizer border-layout-south\" data-min=\"96\" data-max=\"400\">\n    <section class=\"card panel\" style=\"height: 11rem\" aria-labelledby=\"relations-title\" data-density=\"compact\">\n      <header class=\"panel-header\">\n        <h3 class=\"panel-title\" id=\"relations-title\">\n          Relations\n          <span\n            class=\"text-muted-foreground\"\n            data-graph-explorer-for=\"details\"\n            data-graph-explorer-output=\"relations-title\"\n          ></span>\n        </h3>\n      </header>\n      <div class=\"panel-body\" data-flush data-graph-explorer-for=\"details\" data-graph-explorer-outlet=\"relations\"></div>\n    </section>\n  </div>\n</div>\n","individual":false},{"label":"API systems with their metrics","html":"<div class=\"border-layout\" data-frame=\"none\" style=\"block-size: 36rem\">\n  <section class=\"card panel border-layout-center\" aria-label=\"Graph\">\n    <div class=\"panel-body\" data-flush>\n      <div class=\"graph-explorer\" id=\"metrics\" data-nodes=\"100000\" data-focus=\"c1\" aria-label=\"A service graph\"></div>\n    </div>\n  </section>\n  <div class=\"resizer border-layout-east\" data-min=\"240\" data-max=\"560\">\n    <section class=\"card panel\" style=\"width: 22rem\" aria-labelledby=\"metrics-title\" data-density=\"compact\">\n      <header class=\"panel-header\">\n        <h3 class=\"panel-title\" id=\"metrics-title\">\n          Details\n          <span\n            class=\"text-muted-foreground\"\n            data-graph-explorer-for=\"metrics\"\n            data-graph-explorer-output=\"details-title\"\n          ></span>\n        </h3>\n        <div class=\"panel-tools\">\n          <label class=\"swap panel-maximize\">\n            <input type=\"checkbox\" aria-label=\"Maximize Details\" />\n            <span class=\"swap-off\"><i data-lucide=\"maximize-2\"></i></span>\n            <span class=\"swap-on\"><i data-lucide=\"minimize-2\"></i></span>\n          </label>\n        </div>\n      </header>\n      <div class=\"panel-body\" data-graph-explorer-for=\"metrics\" data-graph-explorer-outlet=\"details\"></div>\n    </section>\n  </div>\n</div>\n","individual":false}]
