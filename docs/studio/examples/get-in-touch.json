[{"label":"Default","html":"<section class=\"mk-contact\" style=\"width: 100%\">\n  <div class=\"mk-contact-avatars\"\n    ><span class=\"avatar\"><span class=\"avatar-fallback\">AM</span></span\n    ><span class=\"avatar\"><span class=\"avatar-fallback\">ST</span></span\n    ><span class=\"avatar\"><span class=\"avatar-fallback\">HL</span></span></div\n  >\n  <div class=\"mk-contact-copy\">\n    <h2 class=\"mk-contact-title\">Want to know more?</h2>\n    <p class=\"mk-contact-desc\">Our team is here to help you get the answers you need.</p>\n  </div>\n  <button type=\"button\" class=\"btn mk-contact-cta\">Get in touch</button>\n</section>\n","individual":true},{"label":"Contact form","html":"<section class=\"mk-contact\" data-variant=\"split\" style=\"width: 100%\">\n  <div class=\"mk-contact-split\">\n    <div>\n      <div class=\"mk-contact-copy\"\n        ><h2 class=\"mk-contact-title\">Get in touch</h2\n        ><p class=\"mk-contact-desc\">We answer within one business day.</p></div\n      >\n      <ul class=\"mk-contact-info\">\n        <li\n          ><svg\n            viewBox=\"0 0 24 24\"\n            width=\"24\"\n            height=\"24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            aria-hidden=\"true\"\n          >\n            <rect width=\"20\" height=\"16\" x=\"2\" y=\"4\" rx=\"2\" />\n            <path d=\"m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7\" /></svg\n          ><div><strong>Email</strong><a href=\"mailto:hello@acme.example\">hello@acme.example</a></div></li\n        >\n        <li\n          ><svg\n            viewBox=\"0 0 24 24\"\n            width=\"24\"\n            height=\"24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            aria-hidden=\"true\"\n          >\n            <path\n              d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z\"\n            /></svg\n          ><div><strong>Phone</strong><a href=\"tel:+491234567890\">+49 123 456 7890</a></div></li\n        >\n        <li\n          ><svg\n            viewBox=\"0 0 24 24\"\n            width=\"24\"\n            height=\"24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            aria-hidden=\"true\"\n          >\n            <path d=\"M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z\" />\n            <circle cx=\"12\" cy=\"10\" r=\"3\" /></svg\n          ><div><strong>Office</strong><span>Lisbon · Berlin · remote</span></div></li\n        >\n      </ul>\n    </div>\n    <form action=\"#\" method=\"post\">\n      <div class=\"mk-contact-fields\">\n        <div class=\"mk-contact-field\"\n          ><label class=\"label\" for=\"ct-name\">Name</label\n          ><input class=\"input\" id=\"ct-name\" name=\"name\" autocomplete=\"name\" required\n        /></div>\n        <div class=\"mk-contact-field\"\n          ><label class=\"label\" for=\"ct-email\">Email</label\n          ><input class=\"input\" id=\"ct-email\" name=\"email\" type=\"email\" autocomplete=\"email\" required\n        /></div>\n      </div>\n      <div class=\"mk-contact-field\"\n        ><label class=\"label\" for=\"ct-topic\">Topic</label\n        ><select class=\"select\" id=\"ct-topic\" name=\"topic\"\n          ><option>Sales</option\n          ><option>Support</option\n          ><option>Press</option></select\n        ></div\n      >\n      <div class=\"mk-contact-field\"><label class=\"label\" for=\"ct-msg\">Message</label><textarea\n          class=\"textarea\"\n          id=\"ct-msg\"\n          name=\"message\"\n          rows=\"4\"\n          required\n          minlength=\"10\"\n          placeholder=\"How can we help?\"\n        ></textarea> </div>\n      <button class=\"btn\" type=\"submit\">Send message</button>\n    </form>\n  </div>\n</section>\n","individual":true},{"label":"Channels","html":"<section class=\"mk-contact\" style=\"width: 100%; border: 0; padding: 0\">\n  <div class=\"mk-contact-copy\"><h2 class=\"mk-contact-title\">How can we help?</h2></div>\n  <div class=\"mk-contact-channels\">\n    <article class=\"mk-contact-channel\"\n      ><i data-lucide=\"briefcase\"></i><h3>Sales</h3><p>Plans, volume pricing and a demo for your team.</p\n      ><a class=\"btn\" data-variant=\"outline\" data-size=\"sm\" href=\"#\">Talk to sales</a></article\n    >\n    <article class=\"mk-contact-channel\"\n      ><i data-lucide=\"life-buoy\"></i><h3>Support</h3><p>Stuck? Our engineers answer within hours.</p\n      ><a class=\"btn\" data-variant=\"outline\" data-size=\"sm\" href=\"#\">Open a ticket</a></article\n    >\n    <article class=\"mk-contact-channel\"\n      ><i data-lucide=\"newspaper\"></i><h3>Press</h3><p>Logos, screenshots and interviews.</p\n      ><a class=\"btn\" data-variant=\"outline\" data-size=\"sm\" href=\"#\">Press kit</a></article\n    >\n  </div>\n</section>\n","individual":true},{"label":"Talk to a human","html":"<section class=\"mk-contact\" data-variant=\"band\" style=\"width: 100%\">\n  <div class=\"mk-contact-copy\">\n    <div class=\"mk-contact-avatars\"\n      ><span class=\"avatar\"><img class=\"avatar-image\" src=\"images/mk-portrait.png\" alt=\"\" /></span\n      ><span class=\"avatar\"><img class=\"avatar-image\" src=\"images/mk-portrait2.png\" alt=\"\" /></span\n      ><span class=\"avatar\"><img class=\"avatar-image\" src=\"images/mk-portrait.png\" alt=\"\" /></span\n    ></div>\n    <h2 class=\"mk-contact-title\">Talk to a human</h2>\n    <p class=\"mk-contact-desc\">Real people, real answers - usually in under five minutes.</p>\n    <span class=\"mk-contact-online\"\n      ><span class=\"indicator-dot\" data-variant=\"success\" data-animate=\"ping\" role=\"img\" aria-label=\"Online\"></span>3\n      people online now</span\n    >\n  </div>\n  <div class=\"mk-contact-actions\"\n    ><a class=\"btn\" data-variant=\"secondary\" href=\"#\">Start a chat</a\n    ><a class=\"btn\" data-variant=\"ghost\" href=\"#\" style=\"color: inherit\">Book a call</a></div\n  >\n</section>\n","individual":true}]
