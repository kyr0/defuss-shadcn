[{"label":"Plan picker","html":"<div class=\"flex flex-col gap-3\" style=\"max-width: 34rem\">\n  <form class=\"questionnaire\" id=\"q-plan\" aria-label=\"Plan picker\" data-persist=\"none\">\n    <div class=\"questionnaire-progress\"></div>\n    <fieldset class=\"questionnaire-step\" data-step=\"who\">\n      <legend class=\"questionnaire-title\">Who is it for?</legend>\n      <div class=\"questionnaire-choices\">\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"who\" value=\"personal\" required data-goto=\"devices\" /><span\n            class=\"questionnaire-choice-label\"\n            >Just me</span\n          ></label\n        >\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"who\" value=\"team\" data-goto=\"seats\" /><span class=\"questionnaire-choice-label\"\n            >A team</span\n          ></label\n        >\n      </div>\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"seats\">\n      <legend class=\"questionnaire-title\">How many seats?</legend>\n      <input class=\"input\" name=\"seats\" type=\"number\" min=\"2\" required aria-label=\"Seats\" style=\"max-width: 8rem\" />\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"sso\">\n      <legend class=\"questionnaire-title\">Single sign-on?</legend>\n      <div class=\"questionnaire-choices\">\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"sso\" value=\"yes\" required /><span class=\"questionnaire-choice-label\"\n            >Yes</span\n          ></label\n        >\n        <label class=\"questionnaire-choice\"\n          ><input type=\"radio\" name=\"sso\" value=\"no\" /><span class=\"questionnaire-choice-label\">No</span></label\n        >\n      </div>\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"devices\">\n      <legend class=\"questionnaire-title\">On which devices?</legend>\n      <div class=\"questionnaire-choices\" data-columns=\"2\">\n        <label class=\"questionnaire-choice\"\n          ><input type=\"checkbox\" name=\"devices\" value=\"mac\" /><span class=\"questionnaire-choice-label\"\n            >Mac</span\n          ></label\n        >\n        <label class=\"questionnaire-choice\"\n          ><input type=\"checkbox\" name=\"devices\" value=\"win\" /><span class=\"questionnaire-choice-label\"\n            >Windows</span\n          ></label\n        >\n        <label class=\"questionnaire-choice\"\n          ><input type=\"checkbox\" name=\"devices\" value=\"ios\" /><span class=\"questionnaire-choice-label\"\n            >iPhone</span\n          ></label\n        >\n        <label class=\"questionnaire-choice\"\n          ><input type=\"checkbox\" name=\"devices\" value=\"android\" /><span class=\"questionnaire-choice-label\"\n            >Android</span\n          ></label\n        >\n      </div>\n    </fieldset>\n    <fieldset class=\"questionnaire-step\" data-step=\"review\" data-end>\n      <legend class=\"questionnaire-title\">Your plan</legend>\n      <div class=\"questionnaire-summary\"></div>\n    </fieldset>\n    <div class=\"questionnaire-actions\">\n      <button class=\"btn\" data-variant=\"ghost\" type=\"button\" data-questionnaire=\"back\">Back</button>\n      <button class=\"btn\" type=\"submit\" data-questionnaire=\"next\">Continue</button>\n      <button class=\"btn\" type=\"submit\" data-questionnaire=\"submit\">Choose plan</button>\n    </div>\n    <div class=\"questionnaire-complete\"><p>Plan chosen.</p></div>\n  </form>\n  <ol class=\"text-sm text-muted-foreground m-0 ps-5\" id=\"q-plan-log\" aria-live=\"polite\"></ol>\n</div>\n","individual":false},{"label":"Shipping address","html":"<form class=\"questionnaire\" id=\"q-ship\" aria-label=\"Shipping\" data-persist=\"none\" style=\"max-width: 32rem\">\n  <div class=\"questionnaire-progress\"></div>\n  <fieldset class=\"questionnaire-step\" data-step=\"country\">\n    <legend class=\"questionnaire-title\">Ship to which country?</legend>\n    <div class=\"questionnaire-choices\">\n      <label class=\"questionnaire-choice\"\n        ><input type=\"radio\" name=\"country\" value=\"DE\" required /><span class=\"questionnaire-choice-label\"\n          >Germany</span\n        ></label\n      >\n      <label class=\"questionnaire-choice\"\n        ><input type=\"radio\" name=\"country\" value=\"CA\" /><span class=\"questionnaire-choice-label\">Canada</span></label\n      >\n    </div>\n  </fieldset>\n  <fieldset class=\"questionnaire-step\" data-step=\"region\" data-depends-on=\"country\">\n    <legend class=\"questionnaire-title\">Which region?</legend>\n    <select class=\"select\" name=\"region\" required aria-label=\"Region\" id=\"q-region\"\n      ><option value=\"\">Choose…</option></select\n    >\n  </fieldset>\n  <fieldset class=\"questionnaire-step\" data-step=\"speed\">\n    <legend class=\"questionnaire-title\">How fast?</legend>\n    <div class=\"questionnaire-choices\">\n      <label class=\"questionnaire-choice\"\n        ><input type=\"radio\" name=\"speed\" value=\"standard\" required /><span class=\"questionnaire-choice-label\"\n          >Standard</span\n        ></label\n      >\n      <label class=\"questionnaire-choice\"\n        ><input type=\"radio\" name=\"speed\" value=\"express\" /><span class=\"questionnaire-choice-label\"\n          >Express</span\n        ></label\n      >\n    </div>\n  </fieldset>\n  <fieldset class=\"questionnaire-step\" data-step=\"ok\" data-end>\n    <legend class=\"questionnaire-title\">Ship it?</legend>\n    <div class=\"questionnaire-summary\"></div>\n  </fieldset>\n  <div class=\"questionnaire-actions\">\n    <button class=\"btn\" data-variant=\"ghost\" type=\"button\" data-questionnaire=\"back\">Back</button>\n    <button class=\"btn\" type=\"submit\" data-questionnaire=\"next\">Continue</button>\n    <button class=\"btn\" type=\"submit\" data-questionnaire=\"submit\">Ship</button>\n  </div>\n  <div class=\"questionnaire-complete\"><p>On its way.</p></div>\n</form>\n","individual":false}]
