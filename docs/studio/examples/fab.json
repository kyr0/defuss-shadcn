tton popovertarget=\"fab-7b\" popovertargetaction=\"hide\" class=\"fab-action\"\n      ><i data-lucide=\"bookmark\"></i><span class=\"fab-label\">Save</span></button\n    >\n  </div>\n</div>\n<div class=\"fab\" data-position=\"bottom-start\" data-size=\"sm\">\n  <button class=\"btn fab-trigger\" popovertarget=\"fab-7c\" aria-label=\"Actions\"\n    ><span class=\"fab-icon\" aria-hidden=\"true\"><i data-lucide=\"plus\"></i></span\n  ></button>\n  <div class=\"fab-menu\" id=\"fab-7c\" popover>\n    <button popovertarget=\"fab-7c\" popovertargetaction=\"hide\" class=\"fab-action\"\n      ><i data-lucide=\"sun\"></i><span class=\"fab-label\">Light</span></button\n    >\n    <button popovertarget=\"fab-7c\" popovertargetaction=\"hide\" class=\"fab-action\"\n      ><i data-lucide=\"moon\"></i><span class=\"fab-label\">Dark</span></button\n    >\n  </div>\n</div>\n<div class=\"fab\" data-position=\"bottom-end\" data-layout=\"flower\" data-size=\"sm\">\n  <button class=\"btn fab-trigger\" popovertarget=\"fab-7d\" aria-label=\"Actions\"\n    ><span class=\"fab-icon\" aria-hidden=\"true\"><i data-lucide=\"plus\"></i></span\n  ></button>\n  <div class=\"fab-menu\" id=\"fab-7d\" popover>\n    <button popovertarget=\"fab-7d\" popovertargetaction=\"hide\" class=\"fab-action\"\n      ><i data-lucide=\"camera\"></i><span class=\"fab-label\">Camera</span></button\n    >\n    <button popovertarget=\"fab-7d\" popovertargetaction=\"hide\" class=\"fab-action\"\n      ><i data-lucide=\"image\"></i><span class=\"fab-label\">Photos</span></button\n    >\n    <button popovertarget=\"fab-7d\" popovertargetaction=\"hide\" class=\"fab-action\"\n      ><i data-lucide=\"mic\"></i><span class=\"fab-label\">Voice</span></button\n    >\n  </div>\n</div>\n<div class=\"fab\" data-position=\"bottom-center\" data-direction=\"right\" data-size=\"sm\">\n  <button class=\"btn fab-trigger\" popovertarget=\"fab-7e\" aria-label=\"Actions\"\n    ><span class=\"fab-icon\" aria-hidden=\"true\"><i data-lucide=\"p