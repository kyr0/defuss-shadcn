"plus\"></i></span\n      ></button>\n      <div class=\"fab-menu\" id=\"fab-9b\" popover\n        ><button popovertarget=\"fab-9b\" popovertargetaction=\"hide\" class=\"fab-action\" aria-label=\"Done\"\n          ><i data-lucide=\"check\"></i></button\n        ><button popovertarget=\"fab-9b\" popovertargetaction=\"hide\" class=\"fab-action\" aria-label=\"Later\"\n          ><i data-lucide=\"clock\"></i></button\n      ></div>\n    </div>\n  </div>\n  <div class=\"card\" style=\"position: relative; height: 13rem\">\n    <div class=\"card-header\"><h3 class=\"card-title card-title-sm\">Large · custom</h3></div>\n    <div class=\"fab\" data-attach=\"container\" data-size=\"lg\">\n      <button\n        class=\"btn fab-trigger\"\n        data-tone=\"custom\"\n        style=\"--btn-color: oklch(0.6 0.22 300)\"\n        popovertarget=\"fab-9c\"\n        aria-label=\"Actions\"\n        ><span class=\"fab-icon\" aria-hidden=\"true\"><i data-lucide=\"plus\"></i></span\n      ></button>\n      <div class=\"fab-menu\" id=\"fab-9c\" popover\n        ><button popovertarget=\"fab-9c\" popovertargetaction=\"hide\" class=\"fab-action\" aria-label=\"Done\"\n          ><i data-lucide=\"check\"></i></button\n        ><button popovertarget=\"fab-9c\" popovertargetaction=\"hide\" class=\"fab-action\" aria-label=\"Later\"\n          ><i data-lucide=\"clock\"></i></button\n      ></div>\n    </div>\n  </div>\n</div>\n","individual":false},{"label":"Backdrop","html":"<div class=\"fab\" data-backdrop>\n  <button class=\"btn fab-trigger\" popovertarget=\"fab-10\" aria-label=\"Actions\"\n    ><span class=\"fab-icon\" aria-hidden=\"true\"><i data-lucide=\"plus\"></i></span\n  ></button>\n  <div class=\"fab-menu\" id=\"fab-10\" popover>\n    <button popovertarget=\"fab-10\" popovertargetaction=\"hide\" class=\"fab-action\"\n      ><i data-lucide=\"camera\"></i><span class=\"fab-label\">Camera</span></button\n    >\n    <button popovertarget=\"fab-10\" popovertargetaction=\"hide\" class=\"fab-action\"\n      ><i data-lucide=\"image\"></i><span class=\"fab-label\">Photos</span></button\n    >\n    <button popovertarget=\"fab-10\" popovertargetaction=\"hide\" class=\"fab-action\"\n      ><i data-lucide=\"file-text\"></i><span class=\"fab-label\">Document</span></button\n    >\n  </div>\n</div>\n<p class=\"text-sm text-muted-foreground\">Page content behind the dial.</p>\n","individual":false},{"label":"Extended, shrinks on scroll","html":"<div\n  style=\"\n    position: relative;\n    height: 18rem;\n    timeline-scope: --inbox;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    overflow: hidden;\n  \"\n>\n  <div\n    style=\"\n      display: grid;\n      grid-auto-rows: max-content;\n      gap: 0.75rem;\n      height: 100%;\n      overflow-y: auto;\n      padding: 1rem;\n      scroll-timeline: --inbox;\n    \"\n  >\n    <p class=\"text-sm text-muted-foreground m-0\">Scroll down - Compose shrinks to its icon.</p>\n    <div class=\"card\" data-size=\"sm\"\n      ><div class=\"card-content\"><p class=\"m-0\">Message 1</p></div></div\n    >\n    <div class=\"card\" data-size=\"sm\"\n      ><div class=\"card-content\"><p class=\"m-0\">Message 2</p></div></div\n    >\n    <div class=\"card\" data-size=\"sm\"\n      ><div class=\"card-content\"><p class=\"m-0\">Message 3</p></div></div\n    >\n    <div class=\"card\" data-size=\"sm\"\n      ><div class=\"card-content\"><p class=\"m-0\">Message 4</p></div></div\n    >\n    <div class=\"card\" data-size=\"sm\"\n      ><div class=\"card-content\"><p class=\"m-0\">Message 5</p></div></div\n    >\n    <div class=\"card\" data-size=\"sm\"\n      ><div class=\"card-content\"><p class=\"m-0\">Message 6</p></div></div\n    >\n    <div class=\"card\" data-size=\"sm\"\n      ><div class=\"card-content\"><p class=\"m-0\">Message 7</p></div></div\n    >\n    <div class=\"card\" data-size=\"sm\"\n      ><div class=\"card-content\"><p class=\"m-0\">Message 8</p></div></div\n    >\n    <div class=\"card\" data-size=\"sm\"\n      ><div class=\"card-content\"><p class=\"m-0\">Message 9</p></div></div\n    >\n    <div class=\"card\" data-size=\"sm\"\n      ><div class=\"card-content\"><p class=\"m-0\">Message 10</p></div></div\n    >\n    <div class=\"card\" data-size=\"sm\"\n      ><div class=\"card-content\"><p class=\"m-0\">Message 11</p></div></div\n    >\n    <div class=\"card\" data-size=\"sm\"\n      ><div class=\"card-content\"><p class=\"m-0\">Message 12</p></div></div\n    >\n  </div>\n  <div class=\"fab\" data-attach=\"container\" data-shrink=\"scroll\" style=\"--fab-timeline: --inbox\">\n    <button class=\"btn fab-trigger\" aria-label=\"Compose\"\n      ><span class=\"fab-icon\" aria-hidden=\"true\"><i data-lucide=\"pencil\"></i></span\n      ><span class=\"fab-text\">Compose</span></button\n    >\n  </div>\n</div>\n","individual":false},{"label":"Back to top","html":"<div\n  style=\"\n    position: relative;\n    height: 18rem;\n    timeline-scope: --feed;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    overflow: hidden;\n  \"\n>\n  <div\n    style=\"\n      display: grid;\n      grid-auto-rows: max-content;\n      gap: 0.75rem;\n      height: 100%;\n      overflow-y: auto;\n      padding: 1rem;\n      scroll-timeline: --feed;\n      scroll-behavior: smooth;\n    \"\n  >\n    <p class=\"text-sm text-muted-foreground m-0\" id=\"feed-top\"\n      >Scroll down - the arrow appears; click it and the list glides back here.</p\n    >\n    <div class=\"card\" data-size=\"sm\"\n      ><div class=\"card-content\"><p class=\"m-0\">Story 1</p></div></div\n    >\n    <div class=\"card\" data-size=\"sm\"\n      ><div class=\"card-content\"><p class=\"m-0\">Story 2</p></div></div\n    >\n    <div class=\"card\" data-size=\"sm\"\n      ><div class=\"card-content\"><p class=\"m-0\">Story 3</p></div></div\n    >\n    <div class=\"card\" data-size=\"sm\"\n      ><div class=\"card-content\"><p class=\"m-0\">Story 4</p></div></div\n    