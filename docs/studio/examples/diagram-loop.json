   <div class=\"diagram-node\" data-node=\"measure\" style=\"--i: 4\">\n          <span class=\"diagram-node-name\">Measure</span>\n          <span class=\"diagram-node-meta\">outcomes logged</span>\n        </div>\n        <div class=\"diagram-node\" data-node=\"learn\" style=\"--i: 5\">\n          <span class=\"diagram-node-name\">Learn</span>\n          <span class=\"diagram-node-meta\">playbook updated</span>\n        </div>\n      </div>\n      <ol class=\"diagram-edges\">\n        <li class=\"diagram-edge\" data-from=\"capture\" data-to=\"research\" data-curve=\"curve\"></li>\n        <li class=\"diagram-edge\" data-from=\"research\" data-to=\"decide\" data-curve=\"curve\"></li>\n        <li class=\"diagram-edge\" data-from=\"decide\" data-to=\"build\" data-curve=\"curve\" data-tone=\"accent\"></li>\n        <li class=\"diagram-edge\" data-from=\"build\" data-to=\"measure\" data-curve=\"curve\"></li>\n        <li class=\"diagram-edge\" data-from=\"measure\" data-to=\"learn\" data-curve=\"curve\"></li>\n        <li class=\"diagram-edge\" data-from=\"learn\" data-to=\"capture\" data-curve=\"curve\" data-flow=\"3200\"></li>\n        <li class=\"diagram-edge\" data-from=\"capture\" data-to=\"hub\" data-curve=\"straight\" data-line=\"dashed\">signals</li>\n        <li class=\"diagram-edge\" data-from=\"measure\" data-to=\"hub\" data-curve=\"straight\" data-line=\"dashed\"\n          >outcomes</li\n        >\n      </ol>\n    </figure>\n  </div>\n  <section class=\"card panel\" id=\"dg-loop-edit-panel\" aria-labelledby=\"dg-loop-edit-title\" style=\"\">\n    <header class=\"panel-header\">\n      <i data-lucide=\"sliders-horizontal\" class=\"panel-icon\" aria-hidden=\"true\"></i>\n      <h3 class=\"panel-title\" id=\"dg-loop-edit-title\">Inspector</h3>\n      <div class=\"panel-tools\">\n        <button\n          type=\"button\"\n          class=\"btn panel-close\"\n          data-variant=\"ghost\"\n          data-size=\"icon-sm\"\n          aria-label=\"Close Insp