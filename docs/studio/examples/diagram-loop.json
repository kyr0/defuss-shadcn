i class=\"diagram-edge\" data-from=\"capture\" data-to=\"research\" data-curve=\"curve\"></li>\n    <li class=\"diagram-edge\" data-from=\"research\" data-to=\"decide\" data-curve=\"curve\"></li>\n    <li class=\"diagram-edge\" data-from=\"decide\" data-to=\"build\" data-curve=\"curve\" data-tone=\"accent\"></li>\n    <li class=\"diagram-edge\" data-from=\"build\" data-to=\"measure\" data-curve=\"curve\"></li>\n    <li class=\"diagram-edge\" data-from=\"measure\" data-to=\"learn\" data-curve=\"curve\"></li>\n    <li class=\"diagram-edge\" data-from=\"learn\" data-to=\"capture\" data-curve=\"curve\" data-flow=\"3200\"></li>\n    <li class=\"diagram-edge\" data-from=\"capture\" data-to=\"hub\" data-curve=\"straight\" data-line=\"dashed\">signals</li>\n    <li class=\"diagram-edge\" data-from=\"measure\" data-to=\"hub\" data-curve=\"straight\" data-line=\"dashed\">outcomes</li>\n  </ol>\n</figure>\n","individual":true},{"label":"The loop, one station at a time","html":"<figure\n  class=\"diagram\"\n  id=\"dg-loop-steps\"\n  data-type=\"loop\"\n  data-steps\n  data-autoplay\n  aria-label=\"The product learning loop\"\n>\n  <figcaption class=\"diagram-caption\">\n    <span class=\"diagram-eyebrow\">Loop</span>\n    <span class=\"diagram-title\">Every pass improves the shared record</span>\n    <span class=\"diagram-dek\">Work goes clockwise; each station writes back to the hub (dashed).</span>\n  </figcaption>\n  <div class=\"diagram-canvas\" style=\"--n: 6\">\n    <div class=\"diagram-node\" data-node=\"hub\" data-tone=\"muted\" data-step=\"0\" data-hub>\n      <span class=\"diagram-node-name\">Product memory</span>\n      <span class=\"diagram-node-meta\">one record · every loop</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"capture\" data-step=\"1\" style=\"--i: 0\">\n      <span class=\"diagram-node-name\">Capture</span>\n      <span class=\"diagram-node-meta\">signals in</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"research\" data-step=\"2\" style=\"--i: 1\">\n      <span class=\"diagram-node-name\">Research</span>\n      <span class=\"diagram-node-meta\">evidence pulled</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"decide\" data-tone=\"accent\" data-step=\"3\" style=\"--i: 2\">\n      <span class=\"diagram-node-name\">Decide</span>\n      <span class=\"diagram-node-meta\">human approves</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"build\" data-step=\"4\" style=\"--i: 3\">\n      <span class=\"diagram-node-name\">Build</span>\n      <span class=\"diagram-node-meta\">work ships</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"measure\" data-step=\"5\" style=\"--i: 4\">\n      <span class=\"diagram-node-name\">Measure</span>\n      <span class=\"diagram-node-meta\">outcomes logged</span>\n    </div>\n    <div class=\"diagram-node\" data-node=\"learn\" data-step=\"6\" style=\"--i: 5\">\n      <span class=\"diagram-node-name\">Learn</span>\n      <span class=\"diagram-node-meta\">playbook updated</span>\n    </div>\n  </div>\n  <ol class=\"diagram-edges\">\n    <li class=\"diagram-edge\" data-from=\"capture\" data-to=\"research\" data-curve=\"curve\"></li>\n    <li class=\"diagram-edge\" data-from=\"research\" data-to=\"decide\" data-curve=\"curve\"></li>\n    <li class=\"diagram-edge\" data-from=\"decide\" data-to=\"build\" data-curve=\"curve\" data-tone=\"accent\"></li>\n    <li class=\"diagram-edge\" data-from=\"build\" data-to=\"measure\" data-curve=\"curve\"></li>\n    <li class=\"diagram-edge\" data-from=\"measure\" data-to=\"learn\" data-curve=\"curve\"></li>\n    <li class=\"diagram-edge\" data-from=\"learn\" data-to=\"capture\" data-curve=\"curve\" data-flow=\"3200\"></li>\n    <li class=\"diagram-edge\" data-from=\"capture\" data-to=\"hub\" data-curve=\"straight\" data-line=\"dashed\">signals</li>\n    <li class=\"diagram-edge\" data-from=\"measure\" data-to=\"hub\" data-curve=\"straight\" data-line=\"dashed\">outcomes</li>\n  </ol>\n