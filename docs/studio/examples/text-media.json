[{"label":"Default","html":"<section class=\"mk-text-media\" aria-labelledby=\"tm-1\">\n  <div class=\"mk-text-media-layout\">\n    <div class=\"mk-text-media-copy\">\n      <span class=\"mk-text-media-eyebrow\">Offline first</span>\n      <h2 class=\"mk-text-media-title\" id=\"tm-1\">Your work travels with you</h2>\n      <p class=\"mk-text-media-text\"\n        >Every change is saved on your device first and synced when you are back online - on a plane, in a tunnel, at\n        the cabin.</p\n      >\n      <ul class=\"mk-text-media-list\"\n        ><li><i data-lucide=\"check\"></i>Edits never wait for the network</li\n        ><li><i data-lucide=\"check\"></i>Conflicts resolve themselves</li\n        ><li><i data-lucide=\"check\"></i>Works on every device</li></ul\n      >\n      <a class=\"mk-text-media-link\" href=\"#\">How sync works <i data-lucide=\"arrow-right\"></i></a>\n    </div>\n    <figure class=\"mk-text-media-media\"\n      ><img src=\"https://picsum.photos/seed/tm-cabin/1000/750\" alt=\"A laptop on a table in a mountain cabin\"\n    /></figure>\n  </div>\n</section>\n","individual":true},{"label":"Reverse with video","html":"<section class=\"mk-text-media\" data-variant=\"reverse\" aria-labelledby=\"tm-2\">\n  <div class=\"mk-text-media-layout\">\n    <div class=\"mk-text-media-copy\">\n      <span class=\"mk-text-media-eyebrow\">In 60 seconds</span>\n      <h2 class=\"mk-text-media-title\" id=\"tm-2\">From idea to shipped, on one board</h2>\n      <p class=\"mk-text-media-text\">Watch a feature go from a rough note to release notes - without leaving Acme.</p>\n    </div>\n    <figure class=\"mk-text-media-media\"\n      ><video controls preload=\"metadata\" playsinline poster=\"images/mk-wide2.png\"\n        ><source src=\"videos/demo.webm\" type=\"video/webm\" /><source src=\"videos/demo.mp4\" type=\"video/mp4\" />Your\n        browser does not support video.</video\n      ></figure\n    >\n  </div>\n</section>\n","individual":true},{"label":"Overlap","html":"<section class=\"mk-text-media\" data-variant=\"overlap\" aria-labelledby=\"tm-3\">\n  <div class=\"mk-text-media-layout\">\n    <figure class=\"mk-text-media-media\"><img src=\"https://picsum.photos/seed/tm-office/1400/800\" alt=\"\" /></figure>\n    <div class=\"mk-text-media-copy\">\n      <span class=\"mk-text-media-eyebrow\">Our office</span>\n      <h2 class=\"mk-text-media-title\" id=\"tm-3\">A quiet place to think</h2>\n      <p class=\"mk-text-media-text\"\n        >No open-plan noise: our Lisbon office has more library than meeting rooms. Visit us any Friday.</p\n      >\n      <a class=\"mk-text-media-link\" href=\"#\">Plan a visit <i data-lucide=\"arrow-right\"></i></a>\n    </div>\n  </div>\n</section>\n","individual":true}]
