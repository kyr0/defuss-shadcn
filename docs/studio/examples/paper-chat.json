[{"label":"A session, replayed","html":"<article class=\"paper\" data-variant=\"minimal\" aria-labelledby=\"pr-title\">\n  <header class=\"paper-hero\">\n    <p class=\"paper-venue\"\n      ><span class=\"badge\" data-variant=\"secondary\">Short paper</span\n      ><span>defuss-shadcn · <time datetime=\"2026-10\">October 2026</time></span></p\n    >\n    <h1 class=\"paper-title\" id=\"pr-title\"\n      >A Session, Replayed<span class=\"paper-title-sub\">Three requests and what an agent measured</span></h1\n    >\n    <ul class=\"paper-authors\"\n      ><li>Aron Homberg</li\n      ><li>Claude</li></ul\n    >\n  </header>\n\n  <section class=\"paper-abstract\" aria-labelledby=\"pr-abstract\">\n    <h2 id=\"pr-abstract\">Abstract</h2>\n    <p\n      >A transcript is the most direct record of agentic work, and the hardest to read as a wall of text. We replay\n      three turns of one working session - a type-error sweep, a guideline, a set of skills - at reading speed, so the\n      reader sees the request, then the measured answer, in the order they happened.</p\n    >\n  </section>\n\n  <nav class=\"paper-toc\" aria-labelledby=\"pr-toc\">\n    <h2 id=\"pr-toc\">Contents</h2>\n    <ol>\n      <li\n        ><a href=\"#pr-s1\"><span class=\"paper-num\">1&nbsp;</span>Why replay</a></li\n      >\n      <li\n        ><a href=\"#pr-cite\"><span class=\"paper-num\">·&nbsp;</span>Citation and references</a></li\n      >\n    </ol>\n  </nav>\n\n  <section\n    class=\"session paper-wide\"\n    id=\"pr-chat\"\n    aria-label=\"The replayed session\"\n    data-animate=\"slide\"\n    style=\"height: 24rem\"\n  >\n    <div class=\"session-viewport\" aria-label=\"Conversation\">\n      <div class=\"session-content\"></div>\n      <button\n        type=\"button\"\n        class=\"session-scroll-button\"\n        data-to=\"end\"\n        aria-label=\"Scroll to the latest message\"\n      ></button>\n    </div>\n  </section>\n  <p class=\"flex items-center gap-3\"\n    ><button class=\"btn\" data-variant=\"outline\" data-size=\"sm\" type=\"button\" id=\"pr-replay\">Replay</button\n    ><output id=\"pr-status\" class=\"text-sm text-muted-foreground\">Replaying...</output></p\n  >\n\n  <section class=\"paper-section\" aria-labelledby=\"pr-s1\">\n    <h2 id=\"pr-s1\"><span class=\"paper-num\">1&nbsp;</span>Why replay</h2>\n    <p\n      >Each reply in the replay states a measurement - minutes, tokens, files - not an impression. Replayed at reading\n      speed, the order matters: the request is visible before the claim that answers it, as it was in the session.</p\n    >\n  </section>\n  <section class=\"paper-bibtex\" aria-labelledby=\"pr-cite\">\n    <h2 id=\"pr-cite\">Citation and references</h2>\n    <figure class=\"bibtex\" data-formats=\"bibtex apa mla ieee\" aria-label=\"Cite this paper\">\n      <figcaption>Cite this paper</figcaption>\n      <pre><code class=\"bibtex-source\">@techreport{homberg2026replay,\n  title = {A Session, Replayed: Three Requests and What an Agent Measured},\n  author = {Homberg, Aron and Claude},\n  institution = {defuss},\n  year = {2026},\n  month = oct,\n  url = {https://shadcn.defuss.org/papers/paper-chat.html}\n}</code></pre>\n    </figure>\n    <figure class=\"bibtex\" data-formats=\"ieee apa bibtex\" data-format=\"ieee\" aria-label=\"References\">\n      <figcaption>References</figcaption>\n      <pre><code class=\"bibtex-source\">@techreport{homberg2026vaepractice,\n  title = {Verified Agentic Engineering in Practice: A Component System Grown in One Month},\n  author = {Homberg, Aron},\n  institution = {defuss},\n  year = {2026},\n  month = oct,\n  url = {https://shadcn.defuss.org/papers/paper.html}\n}\n\n@misc{homberg2026defussvae,\n  author = {Homberg, Aron},\n  title = {defuss-vae: Verified Agentic Engineering},\n  year = {2026},\n  howpublished = {GitHub},\n  url = {https://github.com/kyr0/defuss-vae}\n}\n\n@misc{homberg2026defussshadcn,\n  author = {Homberg, Aron},\n  title = {defuss-shadcn: shadcn-style components as semantic HTML},\n  year = {2026},\n  howpublished = {GitHub},\n  url = {https://github.com/kyr0/defuss-shadcn}\n}</code></pre>\n    </figure>\n  </section>\n</article>\n","individual":false}]
