[{"label":"Bauhaus Primary Poster","html":"<section\n  class=\"presentation\"\n  id=\"deck-lollipop\"\n  data-anim-in=\"slideIn\"\n  data-anim-in-distance=\"220px\"\n  data-anim-out=\"slideOut\"\n  data-anim-out-distance=\"220px\"\n  style=\"\n    --presentation-ink: #151515;\n    --presentation-ink-foreground: #f3eadb;\n    --presentation-paper: #f3eadb;\n    --presentation-paper-foreground: #151515;\n    --presentation-accent: #e33124;\n    font-family: Arial, Helvetica, sans-serif;\n  \"\n  tabindex=\"-1\"\n  aria-label=\"Caffeine by brew method - a Bauhaus deck\"\n>\n  <!-- ONE chart for the whole deck: slides name the state they show via\n       data-chart-state, and df$.shadcn.chart.deck() morphs between them -->\n  <div\n    class=\"chart presentation-stage\"\n    role=\"img\"\n    aria-label=\"Caffeine by coffee brew method: per serving cold brew leads with 205 milligrams, per 100 milliliters espresso leads with 210, shown as lollipops, a scatter and office cup counts\"\n  ></div>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Cover\">\n    <svg\n      aria-hidden=\"true\"\n      width=\"900\"\n      height=\"900\"\n      viewBox=\"0 0 900 900\"\n      style=\"position: absolute; right: -220px; top: -250px\"\n    >\n      <circle cx=\"450\" cy=\"450\" r=\"330\" fill=\"#E33124\" />\n    </svg>\n    <svg\n      aria-hidden=\"true\"\n      width=\"520\"\n      height=\"520\"\n      viewBox=\"0 0 520 520\"\n      style=\"position: absolute; left: -150px; bottom: -180px; rotate: 18deg\"\n    >\n      <rect x=\"70\" y=\"70\" width=\"380\" height=\"380\" fill=\"#1B4CA1\" />\n    </svg>\n    <svg\n      aria-hidden=\"true\"\n      width=\"260\"\n      height=\"230\"\n      viewBox=\"0 0 260 230\"\n      style=\"position: absolute; right: 180px; bottom: 90px\"\n    >\n      <polygon points=\"130,0 260,230 0,230\" fill=\"#F2B705\" />\n    </svg>\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\" style=\"position: relative\"\n      >Lollipop ranking · Bauhaus Primary Poster</p\n    >\n    <h1\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        position: relative;\n        max-width: 1250px;\n        font-family: 'Arial Black', Arial, sans-serif;\n        text-transform: uppercase;\n        letter-spacing: -0.03em;\n        font-size: 6.5rem;\n        max-width: 1000px;\n      \"\n      >Which cup hits hardest?</h1\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 200ms; position: relative; max-width: 1050px\"\n      >Seven brew methods, one question - and two honest answers, depending on how you measure.</p\n    >\n    <p class=\"presentation-note\">The shapes are the grammar: circle, square, triangle, one red decision.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"serving\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Per serving\"\n  >\n    <header class=\"presentation-header\"><span>Per serving</span><span>mg caffeine per typical cup</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Arial Black', Arial, sans-serif;\n        text-transform: uppercase;\n        letter-spacing: -0.03em;\n      \"\n      >Per cup, cold brew wins: 205 mg</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Dots instead of bars: the baseline is not the point, the endpoints are.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"density\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Per 100 ml\"\n  >\n    <header class=\"presentation-header\"><span>Per 100 ml</span><span>mg caffeine per 100 ml</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Arial Black', Arial, sans-serif;\n        text-transform: uppercase;\n        letter-spacing: -0.03em;\n      \"\n      >Per sip, espresso is 3.5× stronger</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Same seven dots - watch them re-rank when the measure changes.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"scatter\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Size vs strength\"\n  >\n    <header class=\"presentation-header\"><span>Why they disagree</span><span>serving size × caffeine</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Arial Black', Arial, sans-serif;\n        text-transform: uppercase;\n        letter-spacing: -0.03em;\n      \"\n      >Big cups hide weak coffee</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The heads leave their stems: x is the cup size, y the caffeine per cup.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Key figures\">\n    <p class=\"presentation-eyebrow\" data-df-entrance=\"fade\">Three numbers to remember</p>\n    <div\n      data-df-stagger\n      style=\"--df-motion-stagger-step: 220ms; display: flex; gap: 5.5rem; align-items: flex-start; margin-top: 1.5rem\"\n    >\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #e33124;\n            font-family: 'Arial Black', Arial, sans-serif;\n            text-transform: uppercase;\n            letter-spacing: -0.03em;\n          \"\n          ><span data-count=\"210\">210</span> mg</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">per 100 ml in an espresso</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            color: #1b4ca1;\n            font-family: 'Arial Black', Arial, sans-serif;\n            text-transform: uppercase;\n            letter-spacing: -0.03em;\n          \"\n          ><span data-count=\"205\">205</span> mg</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">in one large cold brew</p>\n      </div>\n      <div data-df-entrance=\"up\">\n        <p\n          class=\"presentation-title\"\n          style=\"\n            font-size: 6.25rem;\n            margin: 0 0 0.5rem;\n            font-variant-numeric: tabular-nums;\n            font-family: 'Arial Black', Arial, sans-serif;\n            text-transform: uppercase;\n            letter-spacing: -0.03em;\n          \"\n          ><span data-count=\"400\">400</span> mg</p\n        >\n        <p class=\"presentation-lede\" style=\"font-size: 1.6rem; max-width: 22rem\">a common daily guideline for adults</p>\n      </div>\n    </div>\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 800ms; font-size: 1.8rem; margin-top: 3.25rem; max-width: 1200px\"\n      >Two cold brews and you are at the line - two espressos and you are barely a third of the way.</p\n    >\n    <p class=\"presentation-note\">Guideline figure is the commonly cited adult reference; the cups are synthetic.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"The small cup\">\n    <header class=\"presentation-header\"><span>The small cup</span><span>30 ml · 63 mg</span></header>\n    <div style=\"display: flex; gap: 4.5rem; align-items: center; margin-top: 3.5rem\">\n      <div style=\"flex: 1 1 0; min-width: 0\">\n        <h2\n          class=\"presentation-title\"\n          data-df-entrance=\"up\"\n          style=\"\n            font-size: 3.4rem;\n            font-family: 'Arial Black', Arial, sans-serif;\n            text-transform: uppercase;\n            letter-spacing: -0.03em;\n          \"\n          >Small cup, dense dose</h2\n        >\n        <p class=\"presentation-lede\" data-df-entrance=\"fade\" style=\"--df-motion-delay: 300ms; font-size: 1.7rem\"\n          >A single espresso holds less caffeine than a mug of drip - but every millilitre of it is three and a half\n          times stronger.</p\n        >\n      </div>\n      <figure\n        class=\"image\"\n        data-ratio=\"4/3\"\n        data-df-entrance=\"pop\"\n        style=\"--df-motion-delay: 150ms; flex: 0 0 700px; margin: 0\"\n      >\n        <img\n          src=\"https://picsum.photos/id/63/960/720\"\n          alt=\"A cup of coffee with milk on a bright red surface, seen from above\"\n          loading=\"lazy\"\n          width=\"960\"\n          height=\"720\"\n          style=\"width: 100%; height: 100%; object-fit: cover\"\n        />\n        <figcaption class=\"image-caption\" style=\"font-size: 1.25rem\">One cup, red ground (stock photo).</figcaption>\n      </figure>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Red again - the photo is the poster.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"north\"\n    data-anim-in-blocks=\"3\"\n    data-anim-in-color=\"#1B4CA1\"\n    aria-label=\"The numbers\"\n  >\n    <header class=\"presentation-header\"><span>The data</span><span>Typical values</span></header>\n    <div class=\"table-container\" data-df-entrance=\"up\" style=\"margin-top: 3rem\">\n      <table class=\"table\" style=\"font-size: 1.45rem\">\n        <caption class=\"table-caption\" style=\"font-size: 1.35rem\"\n          >Caffeine by brew method - illustrative typical values (synthetic).</caption\n        >\n        <thead>\n          <tr class=\"table-row\"\n            ><th class=\"table-head\">Method</th><th class=\"table-head\" style=\"text-align: right\">Serving</th\n            ><th class=\"table-head\" style=\"text-align: right\">Caffeine</th\n            ><th class=\"table-head\" style=\"text-align: right\">Per 100 ml</th></tr\n          >\n        </thead>\n        <tbody>\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Cold brew</td><td class=\"table-cell\" style=\"text-align: right\">350 ml</td\n            ><td class=\"table-cell\" style=\"text-align: right\">205 mg</td\n            ><td class=\"table-cell\" style=\"text-align: right\">59 mg</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Drip</td><td class=\"table-cell\" style=\"text-align: right\">240 ml</td\n            ><td class=\"table-cell\" style=\"text-align: right\">145 mg</td\n            ><td class=\"table-cell\" style=\"text-align: right\">60 mg</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Pour-over</td><td class=\"table-cell\" style=\"text-align: right\">240 ml</td\n            ><td class=\"table-cell\" style=\"text-align: right\">120 mg</td\n            ><td class=\"table-cell\" style=\"text-align: right\">50 mg</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">French press</td><td class=\"table-cell\" style=\"text-align: right\">240 ml</td\n            ><td class=\"table-cell\" style=\"text-align: right\">107 mg</td\n            ><td class=\"table-cell\" style=\"text-align: right\">45 mg</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Moka pot</td><td class=\"table-cell\" style=\"text-align: right\">60 ml</td\n            ><td class=\"table-cell\" style=\"text-align: right\">105 mg</td\n            ><td class=\"table-cell\" style=\"text-align: right\">175 mg</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Espresso</td><td class=\"table-cell\" style=\"text-align: right\">30 ml</td\n            ><td class=\"table-cell\" style=\"text-align: right\">63 mg</td\n            ><td class=\"table-cell\" style=\"text-align: right\">210 mg</td></tr\n          >\n          <tr class=\"table-row\"\n            ><td class=\"table-cell\">Instant</td><td class=\"table-cell\" style=\"text-align: right\">240 ml</td\n            ><td class=\"table-cell\" style=\"text-align: right\">62 mg</td\n            ><td class=\"table-cell\" style=\"text-align: right\">26 mg</td></tr\n          >\n        </tbody>\n      </table>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\"\n      >Brew time, grind and bean change these a lot - the ranking is robust, the digits are not.</p\n    >\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"ink\" aria-label=\"Field note\">\n    <blockquote data-df-entrance=\"iris\" style=\"margin: 0; max-width: 1250px\">\n      <p\n        class=\"presentation-title\"\n        style=\"\n          font-size: 3.3rem;\n          line-height: 1.22;\n          font-family: 'Arial Black', Arial, sans-serif;\n          text-transform: uppercase;\n          letter-spacing: -0.03em;\n          font-size: 2.9rem;\n        \"\n        >“Customers ask for a double espresso to wake up, then order a cold brew to relax. It is exactly backwards.”</p\n      >\n    </blockquote>\n    <div\n      data-df-entrance=\"fade\"\n      style=\"--df-motion-delay: 600ms; display: flex; align-items: center; gap: 1.75rem; margin-top: 2.75rem\"\n    >\n      <span\n        class=\"avatar\"\n        data-size=\"xl\"\n        style=\"width: 6.5rem; height: 6.5rem; font-size: 2.25rem; background: #f2b705; color: #151515\"\n        ><span class=\"avatar-fallback\">JK</span></span\n      >\n      <p class=\"presentation-lede\" style=\"font-size: 1.7rem\"\n        >Jonas Keller<br /><span style=\"opacity: 0.7; font-size: 1.4rem\">Head barista - 60,000 shots pulled</span></p\n      >\n    </div>\n    <p class=\"presentation-note\">A laugh here is fine; it makes the next chart land.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-chart-state=\"cups\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Office cups\"\n  >\n    <header class=\"presentation-header\"><span>In practice</span><span>Cups per day · 120-person office</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.4rem;\n        margin-block: 5.25rem 0.75rem;\n        max-width: 1300px;\n        font-family: 'Arial Black', Arial, sans-serif;\n        text-transform: uppercase;\n        letter-spacing: -0.03em;\n      \"\n      >What the office actually drinks</h2\n    >\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The dots regroup as columns: drip is the workhorse, espresso the ritual.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    style=\"justify-content: flex-start\"\n    aria-label=\"Questions at the counter\"\n  >\n    <header class=\"presentation-header\"><span>Q & A</span><span>Asked at the counter</span></header>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"up\"\n      style=\"\n        font-size: 3.2rem;\n        margin-block: 5.25rem 1.5rem;\n        font-family: 'Arial Black', Arial, sans-serif;\n        text-transform: uppercase;\n        letter-spacing: -0.03em;\n      \"\n      >Questions at the counter</h2\n    >\n    <div class=\"accordion\" data-df-stagger style=\"--df-motion-stagger-step: 160ms; max-width: 1300px\">\n      <details class=\"accordion-item\" name=\"lp-qa\" open data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Does a darker roast mean more caffeine?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >No - by weight, light roasts carry slightly more; dark roasts only taste stronger.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"lp-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Why is cold brew so strong per cup?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >A long steep at a high coffee-to-water ratio, then served in a big glass: the dose is the size.</p\n          ></div\n        >\n      </details>\n      <details class=\"accordion-item\" name=\"lp-qa\" data-df-entrance=\"up\">\n        <summary class=\"accordion-trigger\" style=\"font-size: 1.9rem; padding-block: 1.4rem\"\n          ><span>Is decaf caffeine-free?</span\n          ><svg\n            class=\"accordion-chevron\"\n            aria-hidden=\"true\"\n            width=\"28\"\n            height=\"28\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n          >\n            <path d=\"m6 9 6 6 6-6\" /></svg\n        ></summary>\n        <div class=\"accordion-content\" style=\"font-size: 1.6rem; line-height: 1.5\"\n          ><p style=\"margin: 0 0 1.4rem\"\n            >Not quite - around 2–5 mg per cup, which is why it is not on the chart.</p\n          ></div\n        >\n      </details>\n    </div>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">The roast question always comes - have the answer ready.</p>\n  </section>\n  <section class=\"slide\" data-slide data-theme=\"paper\" aria-label=\"Takeaways\">\n    <header class=\"presentation-header\"><span>Takeaways</span><span>Before your next cup</span></header>\n    <ul\n      data-df-stagger\n      style=\"\n        --df-motion-stagger-step: 180ms;\n        margin: 3rem 0 0;\n        padding: 0;\n        list-style: none;\n        font-size: 2.1rem;\n        line-height: 1.5;\n        max-width: 1300px;\n        display: grid;\n        gap: 1.1rem;\n      \"\n    >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">●</span\n        ><span>Ask “per what?” before you trust a caffeine ranking.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">●</span\n        ><span>Cup size beats brew method: a large cold brew outdoses three espressos.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">●</span\n        ><span>Moka pots are the quiet heavyweight - espresso strength in double size.</span></li\n      >\n      <li data-df-entrance=\"up\" style=\"display: flex; gap: 1.25rem\"\n        ><span aria-hidden=\"true\" style=\"color: var(--presentation-accent); flex: none\">●</span\n        ><span>Instant is the gentlest cup on the list.</span></li\n      >\n    </ul>\n    <span class=\"presentation-slide-number\"></span>\n    <p class=\"presentation-note\">Four rules - the room will remember the cold brew one.</p>\n  </section>\n  <section\n    class=\"slide\"\n    data-slide\n    data-theme=\"paper\"\n    data-anim-in=\"blocksIn\"\n    data-anim-in-direction=\"east\"\n    data-anim-in-blocks=\"3\"\n    data-anim-in-color=\"#E33124\"\n    aria-label=\"Closing\"\n  >\n    <svg\n      aria-hidden=\"true\"\n      width=\"420\"\n      height=\"420\"\n      viewBox=\"0 0 420 420\"\n      style=\"position: absolute; right: 120px; top: 120px\"\n    >\n      <circle cx=\"210\" cy=\"210\" r=\"200\" fill=\"#E33124\" />\n    </svg>\n    <h2\n      class=\"presentation-title\"\n      data-df-entrance=\"pop\"\n      style=\"\n        --df-motion-ease: var(--presentation-spring);\n        position: relative;\n        max-width: 1250px;\n        font-family: 'Arial Black', Arial, sans-serif;\n        text-transform: uppercase;\n        letter-spacing: -0.03em;\n      \"\n      >Measure the dose, not the drama</h2\n    >\n    <p\n      class=\"presentation-lede\"\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 300ms; position: relative; max-width: 1100px\"\n      >Seven cups, two rankings, one lollipop chart - synthetic data, real pattern.</p\n    >\n    <p\n      data-df-entrance=\"up\"\n      style=\"--df-motion-delay: 550ms; position: relative; display: flex; gap: 1rem; margin: 2.5rem 0 0\"\n    >\n      <button type=\"button\" class=\"btn\">Copy the deck</button>\n      <button type=\"button\" class=\"btn\" data-variant=\"outline\">Read the chart contract</button>\n    </p>\n    <p class=\"presentation-note\">Close on the method question.</p>\n  </section>\n  <div class=\"presentation-controls\">\n    <button class=\"presentation-control\" data-presentation-action=\"prev\" aria-label=\"Previous slide\">←</button>\n    <span class=\"presentation-counter\" aria-live=\"polite\">1 / 12</span>\n    <button class=\"presentation-control\" data-presentation-action=\"next\" aria-label=\"Next slide\">→</button>\n  </div>\n  <progress class=\"presentation-progress\" max=\"12\" value=\"1\"></progress>\n</section>\n","individual":false}]
