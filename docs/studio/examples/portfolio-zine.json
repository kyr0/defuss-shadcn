[{"label":"Ama Owusu, collage artist","html":"<style>\n  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Special+Elite&family=Archivo+Black&display=swap');\n  #pf-zine {\n    --background: oklch(0.95 0.022 85);\n    --foreground: oklch(0.2 0.02 40);\n    --card: oklch(0.985 0.01 85);\n    --card-foreground: var(--foreground);\n    --muted: oklch(0.91 0.03 85);\n    --muted-foreground: oklch(0.42 0.03 50);\n    --border: oklch(0.2 0.02 40);\n    --input: var(--border);\n    --primary: oklch(0.6 0.22 30);\n    --primary-foreground: oklch(0.985 0.01 85);\n    --secondary: oklch(0.92 0.17 102);\n    --secondary-foreground: var(--foreground);\n    --accent: oklch(0.92 0.17 102);\n    --accent-foreground: var(--foreground);\n    --ring: var(--primary);\n    --chart-2: oklch(0.55 0.17 255);\n    --chart-3: oklch(0.62 0.14 155);\n    --radius: 0.25rem;\n    --radius-sm: max(0px, calc(var(--radius) - 4px));\n    --radius-md: max(0px, calc(var(--radius) - 2px));\n    --radius-lg: var(--radius);\n    --radius-xl: calc(var(--radius) + 4px);\n    --font-sans: 'Special Elite', 'Courier New', monospace;\n    --pf-hand: 'Caveat', cursive;\n    container: pf-zine / inline-size;\n    position: relative;\n    box-sizing: border-box;\n    width: 100%;\n    overflow: clip;\n    background-color: var(--background);\n    color: var(--foreground);\n    font-family: var(--font-sans);\n  }\n  .dark #pf-zine {\n    --background: oklch(0.24 0.025 60);\n    --foreground: oklch(0.93 0.025 85);\n    --card: oklch(0.29 0.025 60);\n    --muted: oklch(0.31 0.025 60);\n    --muted-foreground: oklch(0.78 0.03 80);\n    --border: oklch(0.93 0.025 85);\n    --primary: oklch(0.7 0.19 32);\n    --secondary: oklch(0.55 0.12 102);\n    --accent: oklch(0.55 0.12 102);\n  }\n  #pf-zine .pf-page {\n    display: flex;\n    flex-direction: column;\n    gap: clamp(3.5rem, 8vw, 6rem);\n    max-width: 70rem;\n    margin-inline: auto;\n    padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 4vw, 2.5rem) 3rem;\n  }\n  #pf-zine .pf-hero {\n    position: relative;\n    display: grid;\n    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);\n    align-items: center;\n    gap: clamp(2rem, 5vw, 4rem);\n  }\n  #pf-zine .pf-ransom {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.35rem 0.25rem;\n    margin: 0;\n    font-size: clamp(2.5rem, 1rem + 6cqi, 5.5rem);\n    line-height: 1;\n  }\n  #pf-zine .pf-ransom b {\n    display: inline-block;\n    padding: 0.08em 0.14em 0.04em;\n    font-weight: 400;\n    box-shadow: 2px 3px 0 color-mix(in oklch, var(--foreground) 25%, transparent);\n  }\n  #pf-zine .pf-ransom .pf-gap {\n    flex-basis: 100%;\n    height: 0;\n  }\n  #pf-zine .pf-ransom b:nth-of-type(4n + 1) {\n    background: var(--foreground);\n    color: var(--background);\n    font-family: 'Archivo Black', sans-serif;\n    rotate: -4deg;\n  }\n  #pf-zine .pf-ransom b:nth-of-type(4n + 2) {\n    background: var(--accent);\n    color: oklch(0.2 0.02 40);\n    font-family: var(--font-sans);\n    rotate: 3deg;\n  }\n  #pf-zine .pf-ransom b:nth-of-type(4n + 3) {\n    background: var(--card);\n    font-family: Georgia, 'Times New Roman', serif;\n    font-style: italic;\n    rotate: -2deg;\n  }\n  #pf-zine .pf-ransom b:nth-of-type(4n) {\n    background: var(--primary);\n    color: var(--primary-foreground);\n    font-family: 'Archivo Black', sans-serif;\n    rotate: 5deg;\n  }\n  #pf-zine .pf-note {\n    max-width: 30rem;\n    margin: 1.5rem 0 0;\n    font-size: 1.125rem;\n    line-height: 1.6;\n  }\n  #pf-zine mark {\n    padding-inline: 0.15em;\n    background: linear-gradient(100deg, transparent 2%, var(--accent) 4% 96%, transparent 98%);\n    color: inherit;\n  }\n  #pf-zine .pf-hand {\n    display: inline-block;\n    margin-block-start: 1rem;\n    color: var(--primary);\n    font-family: var(--pf-hand);\n    font-size: 1.75rem;\n    rotate: -3deg;\n  }\n  #pf-zine .pf-photo {\n    position: relative;\n    justify-self: center;\n    width: min(100%, 20rem);\n    rotate: 4deg;\n  }\n  #pf-zine .pf-photo img {\n    display: block;\n    width: 100%;\n    aspect-ratio: 4 / 5;\n    object-fit: cover;\n    filter: contrast(1.05) saturate(1.1);\n  }\n  #pf-zine .pf-photo figcaption {\n    position: absolute;\n    inset-block-end: -2.4rem;\n    inset-inline: 0;\n    font-family: var(--pf-hand);\n    font-size: 1.375rem;\n    text-align: center;\n    color: oklch(0.2 0.02 40);\n  }\n  #pf-zine .pf-stamp {\n    position: absolute;\n    inset-block-start: -1.5rem;\n    inset-inline-start: -2rem;\n    display: grid;\n    place-items: center;\n    width: 6.5rem;\n    aspect-ratio: 1;\n    background: var(--chart-2);\n    color: oklch(0.98 0 0);\n    font-size: 0.8125rem;\n    line-height: 1.2;\n    text-align: center;\n    rotate: -12deg;\n  }\n  #pf-zine .pf-star {\n    position: absolute;\n    width: 3rem;\n    aspect-ratio: 1;\n    background: var(--primary);\n    animation: pf-zine-wiggle 2.4s ease-in-out infinite alternate;\n  }\n  @keyframes pf-zine-wiggle {\n    to {\n      rotate: 25deg;\n      scale: 1.1;\n    }\n  }\n  #pf-zine h2 {\n    display: inline-block;\n    margin: 0 0 2rem;\n    padding: 0.2em 0.5em;\n    background: var(--foreground);\n    color: var(--background);\n    font-family: 'Archivo Black', sans-serif;\n    font-size: clamp(1.5rem, 1rem + 2cqi, 2.5rem);\n    font-weight: 400;\n    text-transform: uppercase;\n    rotate: -1.5deg;\n  }\n  #pf-zine .mk-portfolio-grid-title {\n    font-family: var(--pf-hand);\n    font-size: 1.5rem;\n    font-style: normal;\n  }\n  #pf-zine .pf-band {\n    position: relative;\n    margin-inline: calc(-1 * clamp(1rem, 4vw, 2.5rem));\n    padding: 4.5rem clamp(1rem, 4vw, 2.5rem);\n    background: var(--foreground);\n    color: var(--background);\n    --shape-edge: 1.75rem;\n  }\n  #pf-zine .pf-band h2 {\n    background: var(--accent);\n    color: oklch(0.2 0.02 40);\n  }\n  #pf-zine .pf-tickets {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));\n    gap: 1.5rem;\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n  #pf-zine .pf-tickets li {\n    display: grid;\n    grid-template-columns: auto 1fr;\n    align-items: center;\n    gap: 1.25rem;\n    padding: 1.25rem 2rem;\n    background: var(--background);\n    color: var(--foreground);\n    --shape-cut: 0.9rem;\n  }\n  #pf-zine .pf-tickets li:nth-child(2) {\n    rotate: 1.5deg;\n  }\n  #pf-zine .pf-tickets li:nth-child(3) {\n    rotate: -1deg;\n  }\n  #pf-zine .pf-date {\n    padding-inline-end: 1.25rem;\n    border-inline-end: 2px dashed var(--muted-foreground);\n    font-family: 'Archivo Black', sans-serif;\n    font-size: 1.75rem;\n    line-height: 1;\n    text-align: center;\n  }\n  #pf-zine .pf-date small {\n    display: block;\n    font-family: var(--font-sans);\n    font-size: 0.75rem;\n  }\n  #pf-zine .pf-tickets p {\n    margin: 0;\n  }\n  #pf-zine .pf-tickets strong {\n    display: block;\n    font-size: 1.0625rem;\n  }\n  /* the paper letter: the card variant's centred column, framed like a pasted-up sheet */\n  #pf-zine .mk-newsletter[data-variant='card'] .mk-newsletter-layout {\n    max-width: 40rem;\n    padding: 2.75rem clamp(1.25rem, 4vw, 2.5rem) 2.25rem;\n    border: 2px solid var(--foreground);\n    border-radius: 0;\n    background: var(--card);\n    box-shadow: 6px 6px 0 var(--foreground);\n    rotate: -0.6deg;\n  }\n  #pf-zine .mk-newsletter-title {\n    font-family: 'Archivo Black', sans-serif;\n    font-weight: 400;\n  }\n  #pf-zine .mk-newsletter-desc {\n    color: var(--foreground);\n    font-size: 1.0625rem;\n  }\n  #pf-zine .mk-newsletter-form .input {\n    border: 2px solid var(--foreground);\n    border-radius: 0;\n    background: #fff;\n    color: oklch(0.2 0.02 50);\n  }\n  #pf-zine .mk-newsletter-form .input::placeholder {\n    color: oklch(0.5 0.02 50);\n  }\n  @container pf-zine (max-width: 44rem) {\n    #pf-zine .pf-hero {\n      grid-template-columns: minmax(0, 1fr);\n    }\n    #pf-zine .pf-stamp {\n      inset-inline-start: -0.5rem;\n    }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    #pf-zine .pf-star {\n      animation: none;\n    }\n  }\n  /* light or dark: the Swap writes the page's dark class - every look has a light and a dark palette */\n  #pf-zine .site-mode {\n    flex: none;\n    border: 1px solid var(--input);\n    border-radius: var(--radius-md);\n    background: var(--background);\n    color: var(--foreground);\n  }\n  #pf-zine .site-mode:hover {\n    background: var(--accent);\n    color: var(--accent-foreground);\n  }\n  #pf-zine [hidden] {\n    display: none !important;\n  }\n  #pf-zine .pf-home {\n    display: flex;\n    flex-direction: column;\n    gap: clamp(3.5rem, 8vw, 6rem);\n  }\n  /* the Site Header: the name on a strip of black tape, the sections typed, the current one circled in red pen */\n  #pf-zine .mk-header {\n    background: none;\n    color: inherit;\n  }\n  #pf-zine .mk-header-inner {\n    flex-wrap: wrap;\n    max-width: none;\n    min-height: 4.5rem;\n    padding: 0 0 0.75rem;\n    border-block-end: 2px dashed var(--foreground);\n  }\n  #pf-zine .mk-header-brand {\n    padding: 0.3rem 0.7rem 0.2rem;\n    background: var(--foreground);\n    color: var(--background);\n    rotate: -2deg;\n    box-shadow: 3px 3px 0 var(--primary);\n  }\n  #pf-zine .mk-header-name,\n  #pf-zine .mk-footer-brand-name {\n    color: inherit;\n    font-family: 'Archivo Black', sans-serif;\n    font-size: 1.125rem;\n    font-weight: 400;\n    letter-spacing: 0.02em;\n  }\n  #pf-zine .mk-header-nav {\n    display: flex;\n    margin-inline-start: auto;\n  }\n  #pf-zine .nav-menu-list {\n    gap: 0.5rem;\n  }\n  #pf-zine .nav-menu-link {\n    padding: 0.35rem 0.75rem;\n    border-radius: 50%;\n    color: inherit;\n    font-size: 1rem;\n    font-weight: 400;\n  }\n  #pf-zine .nav-menu-link:is(:hover, :focus-visible) {\n    background: var(--accent);\n    color: var(--accent-foreground);\n    border-radius: var(--radius);\n  }\n  #pf-zine .nav-menu-link[aria-current] {\n    background: none;\n    color: inherit;\n    box-shadow: 0 0 0 2px var(--primary);\n    rotate: -3deg;\n  }\n  /* a zine's page: a pasted-up spread - the title on black tape, the cover as a polaroid, the facts on a ticket */\n  #pf-zine .pf-case {\n    display: flex;\n    flex-direction: column;\n    gap: clamp(2.5rem, 6vw, 4rem);\n  }\n  #pf-zine .pf-case-back {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: space-between;\n    gap: 1rem;\n    margin: 0;\n    font-family: var(--pf-hand);\n    font-size: 1.5rem;\n  }\n  #pf-zine .pf-case-back a {\n    color: var(--primary);\n    text-decoration: none;\n  }\n  #pf-zine .pf-case-back a:is(:hover, :focus-visible) {\n    text-decoration: underline wavy;\n  }\n  #pf-zine .pf-case-head {\n    display: grid;\n    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);\n    align-items: center;\n    gap: clamp(2rem, 5vw, 4rem);\n  }\n  #pf-zine .pf-case-kind {\n    margin: 0 0 1rem;\n    color: var(--muted-foreground);\n  }\n  #pf-zine .pf-case-title {\n    display: inline-block;\n    margin: 0;\n    padding: 0.15em 0.4em;\n    background: var(--foreground);\n    color: var(--background);\n    font-family: 'Archivo Black', sans-serif;\n    font-size: clamp(2.25rem, 1rem + 5cqi, 4.5rem);\n    font-weight: 400;\n    line-height: 1.05;\n    rotate: -1.5deg;\n    box-shadow: 5px 5px 0 var(--primary);\n  }\n  #pf-zine .pf-case-lede {\n    max-width: 32rem;\n    margin: 2rem 0 0;\n    font-size: 1.1875rem;\n    line-height: 1.6;\n  }\n  #pf-zine .pf-case-cover {\n    justify-self: center;\n    width: min(100%, 22rem);\n    margin: 0;\n    rotate: 3deg;\n  }\n  #pf-zine .pf-case-cover img {\n    display: block;\n    width: 100%;\n    aspect-ratio: 1;\n    object-fit: cover;\n  }\n  #pf-zine .pf-case-cover figcaption {\n    padding-block-start: 0.6rem;\n    color: oklch(0.2 0.02 40);\n    font-family: var(--pf-hand);\n    font-size: 1.375rem;\n    text-align: center;\n  }\n  #pf-zine .pf-case-facts {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 1rem 2rem;\n    margin: 0;\n    padding: 1.5rem 2.25rem;\n    background: var(--accent);\n    color: var(--accent-foreground);\n    rotate: -0.6deg;\n    --shape-cut: 0.9rem;\n  }\n  #pf-zine .pf-case-facts dt {\n    font-family: 'Archivo Black', sans-serif;\n    font-size: 0.8125rem;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n  }\n  #pf-zine .pf-case-facts dd {\n    margin: 0.25rem 0 0;\n  }\n  #pf-zine .pf-case section p {\n    max-width: 40rem;\n    margin: 0;\n    font-size: 1.125rem;\n    line-height: 1.7;\n  }\n  #pf-zine .pf-case-pair {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 2rem;\n    margin-block-start: 2.5rem;\n  }\n  #pf-zine .pf-case-pair img {\n    width: 100%;\n    aspect-ratio: 5 / 4;\n    object-fit: cover;\n    border: 6px solid var(--card);\n    box-shadow: 4px 5px 0 color-mix(in oklch, var(--foreground) 25%, transparent);\n    rotate: -2deg;\n  }\n  #pf-zine .pf-case-pair img + img {\n    rotate: 2.5deg;\n    translate: 0 1.5rem;\n  }\n  #pf-zine .pf-case-pager {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 1.5rem;\n    padding-block-start: 1rem;\n  }\n  #pf-zine .pf-case-pager a {\n    display: grid;\n    gap: 0.25rem;\n    padding: 1.1rem 2rem;\n    background: var(--foreground);\n    color: var(--background);\n    text-decoration: none;\n    --shape-cut: 0.9rem;\n    transition: rotate 0.2s;\n  }\n  #pf-zine .pf-case-pager a + a {\n    text-align: end;\n  }\n  #pf-zine .pf-case-pager a:is(:hover, :focus-visible) {\n    rotate: -1.5deg;\n  }\n  #pf-zine .pf-case-pager small {\n    font-family: var(--pf-hand);\n    font-size: 1.25rem;\n  }\n  #pf-zine .pf-case-pager strong {\n    font-family: 'Archivo Black', sans-serif;\n    font-size: clamp(1.1rem, 1rem + 1cqi, 1.6rem);\n    font-weight: 400;\n  }\n  /* the letter's thank-you, in pen */\n  #pf-zine .pf-thanks {\n    margin: 1rem 0 0;\n    color: var(--primary);\n    font-family: var(--pf-hand);\n    font-size: 1.5rem;\n    rotate: -1.5deg;\n  }\n  /* the Site Footer: a sheet pinned under the page - typed columns, the studio's address, the name on tape */\n  #pf-zine .mk-footer {\n    background: none;\n    color: inherit;\n  }\n  #pf-zine .mk-footer-inner {\n    max-width: none;\n    padding: 2rem 0 0;\n    border-block-start: 2px dashed var(--foreground);\n  }\n  #pf-zine .mk-footer-heading {\n    color: var(--primary);\n    font-family: var(--pf-hand);\n    font-size: 1.5rem;\n    font-weight: 700;\n  }\n  #pf-zine .mk-footer-list {\n    gap: 0.4rem;\n  }\n  #pf-zine .mk-footer-list a:is(:hover, :focus-visible) {\n    background: var(--accent);\n    color: var(--accent-foreground);\n    text-decoration: none;\n  }\n  #pf-zine .mk-footer address {\n    font-style: normal;\n    line-height: 1.6;\n  }\n  #pf-zine .mk-footer-rule {\n    display: none;\n  }\n  #pf-zine .mk-footer-brand {\n    padding: 0.3rem 0.7rem 0.2rem;\n    background: var(--foreground);\n    color: var(--background);\n    rotate: 2deg;\n  }\n  #pf-zine .mk-footer-copy {\n    color: var(--muted-foreground);\n    font-size: 0.9375rem;\n  }\n  @container pf-zine (max-width: 44rem) {\n    #pf-zine .pf-case-head {\n      grid-template-columns: minmax(0, 1fr);\n    }\n    #pf-zine :is(.pf-case-facts, .pf-case-pager) {\n      grid-template-columns: minmax(0, 1fr);\n    }\n    #pf-zine .mk-header-nav {\n      order: 3;\n      width: 100%;\n    }\n    #pf-zine .mk-header-actions {\n      margin-inline-start: auto;\n    }\n  }\n  /* -- modes: each look in light and dark, derived from the palettes above (the other mode of each look) -- */\n  :root:not(.dark) #pf-zine {\n    --primary: oklch(0.62 0.22 30);\n    --primary-foreground: oklch(0.17 0.03 30);\n    --accent: oklch(0.905 0.045 102);\n  }\n  .dark #pf-zine {\n    --primary-foreground: oklch(0.17 0.03 32);\n    --secondary-foreground: oklch(0.99 0.025 85);\n    --accent: oklch(0.33 0.05 102);\n  }\n  /* -- modes: end -- */\n</style>\n<div id=\"pf-zine\" class=\"pattern-grain\">\n  <div class=\"pf-page\">\n    <header class=\"mk-header\">\n      <div class=\"mk-header-inner\">\n        <a class=\"mk-header-brand\" href=\"#/\" data-router-link><span class=\"mk-header-name\">ama owusu</span></a>\n        <nav class=\"mk-header-nav\" aria-label=\"Main\">\n          <ul class=\"nav-menu-list\">\n            <li class=\"nav-menu-item\"><a class=\"nav-menu-link\" href=\"#/work\" data-router-link>zines</a></li>\n            <li class=\"nav-menu-item\"><a class=\"nav-menu-link\" href=\"#/fairs\" data-router-link>fairs</a></li>\n            <li class=\"nav-menu-item\"><a class=\"nav-menu-link\" href=\"#/letter\" data-router-link>the letter</a></li>\n          </ul>\n        </nav>\n        <div class=\"mk-header-actions\">\n          <label class=\"swap site-mode\" data-variant=\"rotate\" data-size=\"sm\">\n            <input type=\"checkbox\" data-site-mode aria-label=\"Dark mode\" />\n            <span class=\"swap-on\" aria-hidden=\"true\"><i data-lucide=\"moon\"></i></span>\n            <span class=\"swap-off\" aria-hidden=\"true\"><i data-lucide=\"sun\"></i></span>\n          </label>\n        </div>\n      </div>\n    </header>\n    <div class=\"pf-home\" data-pf-view=\"home\">\n      <section class=\"pf-hero\" aria-labelledby=\"pf-zine-name\">\n        <div>\n          <h1\n            class=\"pf-ransom\"\n            id=\"pf-zine-name\"\n            aria-label=\"Ama Owusu\"\n            data-df-stagger\n            style=\"--df-motion-stagger-step: 60ms\"\n          >\n            <b data-df-entrance=\"pop\" aria-hidden=\"true\">A</b><b data-df-entrance=\"pop\" aria-hidden=\"true\">M</b\n            ><b data-df-entrance=\"pop\" aria-hidden=\"true\">A</b><span class=\"pf-gap\"></span\n            ><b data-df-entrance=\"pop\" aria-hidden=\"true\">O</b><b data-df-entrance=\"pop\" aria-hidden=\"true\">W</b\n            ><b data-df-entrance=\"pop\" aria-hidden=\"true\">U</b><b data-df-entrance=\"pop\" aria-hidden=\"true\">S</b\n            ><b data-df-entrance=\"pop\" aria-hidden=\"true\">U</b>\n          </h1>\n          <p class=\"pf-note\" data-df-entrance=\"up\" style=\"--df-motion-delay: 500ms\"\n            >Collage artist and zine maker in London. I cut up <mark>old magazines</mark>, glue them back together and\n            print the result on a <mark>risograph</mark> that is older than me.</p\n          >\n          <span class=\"pf-hand\" data-df-entrance=\"skew\" style=\"--df-motion-delay: 700ms\"\n            >- scissors, glue &amp; noise</span\n          >\n        </div>\n        <figure class=\"pf-photo frame-polaroid frame-tape\" data-df-entrance=\"zoom\" style=\"--df-motion-delay: 300ms\">\n          <img src=\"https://picsum.photos/id/836/600/750\" alt=\"Ama Owusu with a guitar\" />\n          <figcaption>me, 2026</figcaption>\n          <span class=\"pf-stamp stamp\" aria-hidden=\"true\">EST.<br />2014<br />LDN</span>\n        </figure>\n        <span class=\"pf-star shape-star\" style=\"inset: -0.5rem 42% auto auto\" aria-hidden=\"true\"></span>\n        <span\n          class=\"pf-star shape-star-4\"\n          style=\"inset: auto 2% -1.5rem auto; background: var(--chart-2); animation-delay: -1.2s\"\n          aria-hidden=\"true\"\n        ></span>\n      </section>\n      <section aria-labelledby=\"pf-zine-recent\" data-pf-section=\"work\">\n        <h2 id=\"pf-zine-recent\">Hot off the press</h2>\n        <ul class=\"mk-portfolio-grid\" data-variant=\"scatter\">\n          <li class=\"mk-portfolio-grid-item\" data-df-entrance=\"pop\">\n            <a class=\"mk-portfolio-grid-link frame-tape\" href=\"#/work/paper-cuts-12\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/1073/600/600\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Paper Cuts #12</strong>\n                <span class=\"mk-portfolio-grid-meta\">Riso zine, 40 pages</span>\n              </span>\n            </a>\n          </li>\n          <li class=\"mk-portfolio-grid-item\" data-df-entrance=\"pop\" style=\"--df-motion-delay: 100ms\">\n            <a class=\"mk-portfolio-grid-link\" href=\"#/work/stripes\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/951/600/600\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Stripes</strong>\n                <span class=\"mk-portfolio-grid-meta\">Poster series</span>\n              </span>\n            </a>\n          </li>\n          <li class=\"mk-portfolio-grid-item\" data-df-entrance=\"pop\" style=\"--df-motion-delay: 200ms\">\n            <a class=\"mk-portfolio-grid-link frame-tape\" href=\"#/work/typewriter-tales\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/403/600/600\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Typewriter Tales</strong>\n                <span class=\"mk-portfolio-grid-meta\">Short stories</span>\n              </span>\n            </a>\n          </li>\n          <li class=\"mk-portfolio-grid-item\" data-df-entrance=\"pop\" style=\"--df-motion-delay: 300ms\">\n            <a class=\"mk-portfolio-grid-link\" href=\"#/work/strawberry-riot\" data-router-link>\n              <img class=\"mk-portfolio-grid-media\" src=\"https://picsum.photos/id/1080/600/600\" alt=\"\" />\n              <span class=\"mk-portfolio-grid-caption\">\n                <strong class=\"mk-portfolio-grid-title\">Strawberry Riot</strong>\n                <span class=\"mk-portfolio-grid-meta\">Album art</span>\n              </span>\n            </a>\n          </li>\n        </ul>\n      </section>\n      <section class=\"pf-band edge-torn-top\" aria-labelledby=\"pf-zine-fairs\" data-pf-section=\"fairs\">\n        <h2 id=\"pf-zine-fairs\">Find me at</h2>\n        <ul class=\"pf-tickets\">\n          <li class=\"ticket\">\n            <span class=\"pf-date\">14<small>Nov</small></span>\n            <p><strong>Small Press Fair</strong> Hackney, table 23</p>\n          </li>\n          <li class=\"ticket\">\n            <span class=\"pf-date\">06<small>Dec</small></span>\n            <p><strong>Riso Club Xmas Market</strong> Peckham Levels</p>\n          </li>\n          <li class=\"ticket\">\n            <span class=\"pf-date\">21<small>Feb</small></span>\n            <p><strong>Zine Library Talk</strong> Whitechapel Gallery</p>\n          </li>\n        </ul>\n      </section>\n      <section class=\"mk-newsletter\" data-variant=\"card\" aria-labelledby=\"pf-zine-letter\" data-pf-section=\"letter\">\n        <div class=\"mk-newsletter-layout\">\n          <div class=\"mk-newsletter-copy\">\n            <h2 class=\"mk-newsletter-title\" id=\"pf-zine-letter\">The paper letter</h2>\n            <p class=\"mk-newsletter-desc\"\n              >Four times a year: new zines, fair dates and one collage only subscribers see.</p\n            >\n          </div>\n          <div class=\"mk-newsletter-form-col\">\n            <form class=\"mk-newsletter-form\" data-pf-letter>\n              <label class=\"sr-only\" for=\"pf-zine-email\">Email address</label>\n              <input\n                class=\"input\"\n                id=\"pf-zine-email\"\n                type=\"email\"\n                name=\"email\"\n                placeholder=\"you@example.com\"\n                required\n                autocomplete=\"email\"\n                enterkeyhint=\"send\"\n              />\n              <button class=\"btn\" type=\"submit\"><i data-lucide=\"mail\"></i> Sign me up</button>\n            </form>\n            <span class=\"mk-newsletter-note\" role=\"note\">No spam. Just paper.</span>\n            <p class=\"pf-thanks\" data-pf-thanks role=\"status\" hidden\n              >You're on the list - the next letter goes out with the spring fairs.</p\n            >\n          </div>\n        </div>\n      </section>\n    </div>\n    <article class=\"pf-case\" data-pf-view=\"work\" aria-labelledby=\"pf-zine-case-title\" hidden>\n      <p class=\"pf-case-back\">\n        <a href=\"#/work\" data-router-link>← back to the pile</a>\n        <span class=\"pf-case-no\">no. <span data-case=\"no\">01</span> of 04</span>\n      </p>\n      <div class=\"pf-case-head\">\n        <div>\n          <p class=\"pf-case-kind\"\n            ><span data-case=\"kind\">Riso zine, 40 pages</span> · <span data-case=\"year\">2026</span></p\n          >\n          <h1 class=\"pf-case-title\" id=\"pf-zine-case-title\" data-case=\"title\">Paper Cuts #12</h1>\n          <p class=\"pf-case-lede\" data-case=\"summary\"\n            >Forty pages cut from a decade of library-sale magazines - the twelfth issue of a zine that started as a\n            birthday present.</p\n          >\n        </div>\n        <figure class=\"pf-case-cover frame-polaroid frame-tape\">\n          <img\n            data-case-img=\"0\"\n            data-w=\"900\"\n            data-h=\"900\"\n            src=\"https://picsum.photos/id/1073/900/900\"\n            alt=\"Open books laid out page by page\"\n          />\n          <figcaption data-case=\"title\">Paper Cuts #12</figcaption>\n        </figure>\n      </div>\n      <dl class=\"pf-case-facts ticket\">\n        <div><dt>Edition</dt><dd data-case=\"edition\">300 copies, fluorescent pink and blue</dd></div>\n        <div><dt>Paper</dt><dd data-case=\"paper\">Recycled 90 g, hand-stapled</dd></div>\n        <div><dt>Find it</dt><dd data-case=\"where\">Small Press Fair, two shops in Hackney, and by email</dd></div>\n      </dl>\n      <section aria-labelledby=\"pf-zine-brief\">\n        <h2 id=\"pf-zine-brief\">The idea</h2>\n        <p data-case=\"brief\"\n          >Every issue of Paper Cuts starts with a box of magazines from a library sale and one rule for the year. For\n          #12 the rule was: nothing new, only what other people threw away.</p\n        >\n      </section>\n      <section class=\"pf-case-making\" aria-labelledby=\"pf-zine-making\">\n        <h2 id=\"pf-zine-making\">Cut, glue, print</h2>\n        <p data-case=\"work\"\n          >I cut for three months and glued for two weeks, then printed each spread on the risograph in two passes -\n          fluorescent pink first, blue on top - so that the colours shift wherever the drum slipped. Every copy is\n          folded and stapled at the kitchen table.</p\n        >\n        <div class=\"pf-case-pair\">\n          <img\n            class=\"frame-tape\"\n            data-case-img=\"1\"\n            data-w=\"700\"\n            data-h=\"560\"\n            src=\"https://picsum.photos/id/4/700/560\"\n            alt=\"Hands writing in a notebook beside a laptop\"\n          />\n          <img\n            data-case-img=\"2\"\n            data-w=\"700\"\n            data-h=\"560\"\n            src=\"https://picsum.photos/id/252/700/560\"\n            alt=\"Hand tools laid out in rows on white\"\n          />\n        </div>\n      </section>\n      <section aria-labelledby=\"pf-zine-result\">\n        <h2 id=\"pf-zine-result\">What happened</h2>\n        <p data-case=\"result\"\n          >The first 300 sold out in two fairs. A second run is printing now, and three of the spreads go up as posters\n          at the Zine Library in February.</p\n        >\n      </section>\n      <nav class=\"pf-case-pager\" aria-label=\"More from the pile\">\n        <a class=\"ticket\" href=\"#/work/strawberry-riot\" data-router-link data-case-link=\"prev\"\n          ><small>← previous</small><strong data-case-title=\"prev\">Strawberry Riot</strong></a\n        >\n        <a class=\"ticket\" href=\"#/work/stripes\" data-router-link data-case-link=\"next\"\n          ><small>next →</small><strong data-case-title=\"next\">Stripes</strong></a\n        >\n      </nav>\n    </article>\n    <footer class=\"mk-footer\">\n      <div class=\"mk-footer-inner\">\n        <nav class=\"mk-footer-nav\" aria-label=\"Footer\">\n          <div class=\"mk-footer-col\">\n            <h3 class=\"mk-footer-heading\">zines &amp; prints</h3>\n            <ul class=\"mk-footer-list\">\n              <li><a href=\"#/work/paper-cuts-12\" data-router-link>Paper Cuts #12</a></li>\n              <li><a href=\"#/work/stripes\" data-router-link>Stripes</a></li>\n              <li><a href=\"#/work/typewriter-tales\" data-router-link>Typewriter Tales</a></li>\n              <li><a href=\"#/work/strawberry-riot\" data-router-link>Strawberry Riot</a></li>\n            </ul>\n          </div>\n          <div class=\"mk-footer-col\">\n            <h3 class=\"mk-footer-heading\">around here</h3>\n            <ul class=\"mk-footer-list\">\n              <li><a href=\"#/work\" data-router-link>Hot off the press</a></li>\n              <li><a href=\"#/fairs\" data-router-link>Find me at</a></li>\n              <li><a href=\"#/letter\" data-router-link>The paper letter</a></li>\n            </ul>\n          </div>\n          <div class=\"mk-footer-col\">\n            <h3 class=\"mk-footer-heading\">elsewhere</h3>\n            <ul class=\"mk-footer-list\">\n              <li><a href=\"https://www.instagram.com/\" target=\"_blank\" rel=\"noopener\">Instagram</a></li>\n              <li><a href=\"https://www.etsy.com/\" target=\"_blank\" rel=\"noopener\">Shop on Etsy</a></li>\n              <li><a href=\"mailto:ama@example.com\">ama@example.com</a></li>\n            </ul>\n          </div>\n          <div class=\"mk-footer-col\">\n            <h3 class=\"mk-footer-heading\">the studio</h3>\n            <address>Unit 4, Print Yard<br />Hackney Wick, London<br />Open studio every first Saturday</address>\n          </div>\n        </nav>\n        <hr class=\"separator mk-footer-rule\" />\n        <div class=\"mk-footer-bottom\">\n          <a class=\"mk-footer-brand\" href=\"#/\" data-router-link><span class=\"mk-footer-brand-name\">ama owusu</span></a>\n          <div class=\"mk-footer-meta\">\n            <p class=\"mk-footer-copy\">© 2026 Ama Owusu - cut by hand, printed on recycled paper</p>\n          </div>\n        </div>\n      </div>\n    </footer>\n  </div>\n  <!-- the zines and prints the routes name, in order -->\n  \n</div>\n","individual":false}]
