{
  // Dead-simple TS7 pipeline: strip types from src/**/*.ts into dist/**/*.js,
  // 1:1 layout. Everything else in src/ (html, css, md, fonts, …) is copied
  // verbatim by scripts/build.ts — tsc only ever sees TypeScript.
  //
  // noCheck: the component sources are plain JS renamed to .ts — all of them
  // declare a global `function init()`, so full type-checking reports
  // duplicate identifiers until the files get real types/modules. Flip to
  // false once they're properly typed.
  //
  // scripts/ is intentionally NOT included: rootDir/outDir here define the
  // build output tree, so tooling TS must compile via tsconfig.scripts.json.
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "rootDir": "src",
    "outDir": "dist",
    "noCheck": true,
    "removeComments": false,
    "skipLibCheck": true,
    // .js.map for the readable build; the minified twin's map is generated by
    // scripts/minify.ts (oxc) on top of these compiled files.
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  // the docs SSG authoring tree is compiled by defuss-ssg (lib/) or the
  // build-docs runtime pre-step (runtime/), never by this pipeline
  "exclude": ["src/documentation/lib", "src/documentation/runtime"]
}
