{
  // Editor-only project for the docs SSG authoring tree (pages, lib components,
  // runtime). The build never reads this file: runtime/*.ts compiles via
  // tsconfig.docs-runtime.json and the .tsx pages/components are compiled by
  // defuss-ssg's vite pipeline (which itself sets jsxImportSource: "defuss").
  //
  // Why it exists: these files match no other tsconfig (the root one globs
  // src/**/*.ts only, with rootDir→dist), so the TS language server would
  // otherwise fall back to its inferred project and assume the React JSX
  // runtime — erroring ts(2875) on every .tsx. Pointing the JSX factory at
  // defuss (which ships its own ./jsx-runtime types) matches the real build.
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "defuss",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    // Same strip-types policy as the root build configs: this tree is
    // JS-style code that has never been type-checked — full checking would
    // only flood the editor with pre-existing noise.
    "noCheck": true
  },
  "include": ["**/*.ts", "**/*.tsx", "../types/**/*.d.ts"]
}
