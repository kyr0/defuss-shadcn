# Every environment variable the code reads. None is a secret, and none needs a value to build.

# The repository root the docs build's components read files from (component sources, skills,
# dist/stats.json). scripts/build-docs.ts sets it itself, because defuss-ssg renders from a temporary
# copy of src/documentation; src/documentation/lib/repo.ts falls back to the path relative to itself.
DEFUSS_SHADCN_ROOT=

# 1 = tests/e2e/run.ts runs every e2e file, changed or not (deploy.sh sets it for a release).
E2E_ALL=

# How many pages scripts/create-screenshots.ts shoots at once (default: a quarter of the cores, 1-4).
SCREENSHOT_CONCURRENCY=
