{
  "name": "defuss-shadcn",
  "version": "0.8.3",
  "type": "module",
  "description": "A modular, fully static, semantic shadcn design token library with extremely low complexity, easy debuggability and tiny bundle size for agentic engineering and AI agents.",
  "packageManager": "bun@1.3.9",
  "scripts": {
    "dev": "vite",
    "build": "bun scripts/build.ts && bun scripts/bundle.ts && bun scripts/minify.ts && bun scripts/stats.ts && bun scripts/verify.ts",
    "docs": "bun scripts/build.ts && bun scripts/bundle.ts && bun scripts/minify.ts && bun scripts/stats.ts && bun scripts/sync-docs.ts",
    "minify": "bun scripts/minify.ts",
    "stats": "bun scripts/stats.ts",
    "lint": "oxlint src tests scripts",
    "verify": "bun scripts/verify.ts",
    "screenshots": "bun scripts/create-screenshots.ts",
    "sync-snippets": "bun scripts/sync-css-snippets.ts && bun scripts/sync-js-snippets.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "bun tests/e2e/run.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "setup": "bun install && bunx playwright install",
    "purge-cdn": "bun scripts/purge-cdn.ts",
    "push": "./scripts/push.sh",
    "deploy": "./scripts/deploy.sh",
    "deploy:minor": "./scripts/deploy.sh minor",
    "deploy:major": "./scripts/deploy.sh major",
    "deploy:beta": "./scripts/deploy.sh patch beta",
    "deploy:rc": "./scripts/deploy.sh patch rc",
    "deploy:release": "./scripts/deploy.sh patch release"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "@types/node": "^26.4.1",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "lightningcss": "^1.33.0",
    "linkedom": "^0.18.13",
    "oxc-minify": "^0.149.0",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "simple-icons": "^16.30.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
